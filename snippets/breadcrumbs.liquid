{% doc %}
  The visible breadcrumb trail.

  @param {string} [policy]
  @param {string} [separator] - slash | chevron. Default slash.

  @example
    {% render 'breadcrumbs' %}
{% enddoc %}

{%- unless request.page_type == 'index' -%}
  <nav class="breadcrumbs breadcrumbs--{{ separator | default: 'slash' }}" aria-label="{{ 'general.breadcrumbs.label' | t }}">
    <ol class="breadcrumbs__list" role="list">
      <li class="breadcrumbs__item">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
      </li>

      {%- case request.page_type -%}
        {%- when 'product' -%}
          {%- if collection.url != blank -%}
            <li class="breadcrumbs__item">
              <a href="{{ collection.url }}">{{ collection.title }}</a>
            </li>
          {%- else -%}
            <li class="breadcrumbs__item">
              <a href="{{ routes.all_products_collection_url }}">{{ 'general.breadcrumbs.shop' | t }}</a>
            </li>
          {%- endif -%}
          <li class="breadcrumbs__item" aria-current="page">{{ product.title }}</li>

        {%- when 'collection' -%}
          {%- if current_tags -%}
            <li class="breadcrumbs__item">
              <a href="{{ collection.url }}">{{ collection.title }}</a>
            </li>
            <li class="breadcrumbs__item" aria-current="page">{{ current_tags | join: ', ' }}</li>
          {%- else -%}
            <li class="breadcrumbs__item" aria-current="page">{{ collection.title }}</li>
          {%- endif -%}

        {%- when 'blog' -%}
          <li class="breadcrumbs__item" aria-current="page">{{ blog.title }}</li>

        {%- when 'article' -%}
          <li class="breadcrumbs__item">
            <a href="{{ blog.url }}">{{ blog.title }}</a>
          </li>
          <li class="breadcrumbs__item" aria-current="page">{{ article.title }}</li>

        {%- when 'page' -%}
          <li class="breadcrumbs__item" aria-current="page">{{ page.title }}</li>

        {%- when 'policy' -%}
          <li class="breadcrumbs__item" aria-current="page">{{ policy.title }}</li>

        {%- when 'search' -%}
          <li class="breadcrumbs__item" aria-current="page">{{ 'search.title' | t }}</li>

        {%- when 'list-collections' -%}
          <li class="breadcrumbs__item" aria-current="page">{{ 'collections.list.title' | t }}</li>

        {%- else -%}
          <li class="breadcrumbs__item" aria-current="page">{{ page_title }}</li>
      {%- endcase -%}
    </ol>
  </nav>
{%- endunless -%}

{% stylesheet %}
/* The chevron separator style. */
@layer components {
  .breadcrumbs--chevron .breadcrumbs__list {
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.8rem;
    color: var(--color-heading);
  }

  .breadcrumbs--chevron .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .breadcrumbs--chevron .breadcrumbs__item + .breadcrumbs__item::before {
    content: '';
    inline-size: 0.7rem;
    block-size: 0.7rem;
    margin: 0;
    border-block-start: 1.5px solid currentColor;
    border-inline-end: 1.5px solid currentColor;
    transform: rotate(45deg);
  }

  html[dir='rtl'] .breadcrumbs--chevron .breadcrumbs__item + .breadcrumbs__item::before { transform: rotate(-135deg); }

  .breadcrumbs--chevron .breadcrumbs__item a { text-decoration: none; }
  .breadcrumbs--chevron .breadcrumbs__item[aria-current='page'] { color: var(--color-heading); }
}
{% endstylesheet %}
