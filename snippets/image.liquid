{% doc %}
  Renders a responsive image, optionally with a different image on mobile.

  @param {image} image - Shopify image or media preview
  @param {image} [mobile_image] - Shown at 767px and below
  @param {string} [alt] - Overrides the image's own alt text
  @param {string} [class] - Classes for the `<img>`
  @param {string} [wrapper_class] - Classes for `<responsive-image>`
  @param {string} [sizes] - Defaults to a full-width hint
  @param {string} [mobile_sizes] - Defaults to 100vw
  @param {string} [widths] - Comma separated. Defaults to a standard ladder
  @param {string} [ratio] - Ratio keyword, resolved by `snippets/aspect-ratio.liquid`. Default: aspect-ratio
  @param {string} [mobile_ratio] - Defaults to `ratio`
  @param {boolean} [priority] - Eager load, high fetch priority. Hero images only
  @param {boolean} [preload] - Emits a preload hint. Requires `priority`. Art directed when a mobile image is set, which is why the hints are written by hand rather than through `image_tag`
  @param {string} [id] - id for the `<img>`
  @param {string} [placeholder]

  @example
    {% render 'image', image: section.settings.image, ratio: '16-9',
       mobile_image: section.settings.image_mobile, mobile_ratio: '9-16',
       priority: true, preload: true %}

  @example
    {% render 'image', image: product.featured_media.preview_image,
       ratio: settings.card_image_ratio,
       sizes: '(min-width: 990px) 25vw, 50vw' %}
{% enddoc %}

{%- liquid
  assign default_widths = '160,240,320,420,540,640,840,1080,1280,1540,1920'
  assign width_list = widths | default: default_widths | split: ','

  # ---- desktop srcset, capped at the source width --------------------------
  assign source_width = image.width | default: 1920
  assign usable = ''

  for candidate in width_list
    assign candidate_width = candidate | strip | times: 1
    if candidate_width <= source_width
      assign usable = usable | append: candidate_width | append: ','
    endif
  endfor

  if usable == blank
    assign usable = source_width | append: ','
  endif

  assign usable = usable | split: ','
  assign largest = usable | last

  # ---- mobile srcset -------------------------------------------------------
  if mobile_image != blank
    assign mobile_source_width = mobile_image.width | default: 1080
    assign mobile_usable = ''

    for candidate in width_list
      assign candidate_width = candidate | strip | times: 1
      if candidate_width <= mobile_source_width and candidate_width <= 1080
        assign mobile_usable = mobile_usable | append: candidate_width | append: ','
      endif
    endfor

    if mobile_usable == blank
      assign mobile_usable = mobile_source_width | append: ','
    endif

    assign mobile_usable = mobile_usable | split: ','
  endif

  assign resolved_sizes = sizes | default: '(min-width: 1440px) 1440px, 100vw'
  assign resolved_mobile_sizes = mobile_sizes | default: '100vw'
  assign resolved_alt = alt | default: image.alt | escape

  # ---- aspect ratios -------------------------------------------------------
  #
  # The names resolve in `snippets/aspect-ratio.liquid`. They used to
  # resolve here, in two case blocks, which was fine while an `<img>` was the
  # only thing in the theme with a shape — `blocks/image-card.liquid` gives the
  # ratio to a card whose picture is a background, and a second copy of the
  # numbers is the copy that drifts.
  assign ratio_key = ratio | default: 'aspect-ratio'
  assign mobile_ratio_key = mobile_ratio | default: ratio_key

  capture aspect
    render 'aspect-ratio', ratio: ratio_key, image: image
  endcapture

  # The mobile fallback is the desktop image, so a mobile-only `aspect-ratio` with no
  # second upload keeps the shape the first one had.
  capture mobile_aspect
    render 'aspect-ratio', ratio: mobile_ratio_key, image: mobile_image, fallback: image.aspect_ratio
  endcapture

  assign loading_attr = 'lazy'
  assign decoding_attr = 'async'
  if priority
    assign loading_attr = 'eager'
    assign decoding_attr = 'sync'
  endif
-%}

{%- if image == blank -%}

  <responsive-image
    class="responsive-image responsive-image--placeholder {{ wrapper_class }}"
    style="--aspect-ratio: {{ aspect }}; --aspect-ratio-mobile: {{ mobile_aspect }};"
    data-loaded
  >

    {{- placeholder | default: 'hero-apparel-1' | placeholder_svg_tag: 'responsive-image__placeholder' -}}
  </responsive-image>
{%- else -%}

  {%- if preload and priority -%}
    {% # theme-check-disable AssetPreload %}
    <link
      rel="preload"
      as="image"
      href="{{ image | image_url: width: largest }}"
      imagesrcset="
        {%- for w in usable -%}
          {{ image | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}"
      imagesizes="{{ resolved_sizes }}"
      fetchpriority="high"
      {% if mobile_image != blank %}media="(min-width: 768px)"{% endif %}
    >
    {%- if mobile_image != blank -%}
      <link
        rel="preload"
        as="image"
        href="{{ mobile_image | image_url: width: mobile_usable | last }}"
        imagesrcset="
          {%- for w in mobile_usable -%}
            {{ mobile_image | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}"
        imagesizes="{{ resolved_mobile_sizes }}"
        fetchpriority="high"
        media="(max-width: 767px)"
      >
    {%- endif -%}
    {% # theme-check-enable AssetPreload %}
  {%- endif -%}

  <responsive-image
    class="responsive-image {{ wrapper_class }}"
    style="--aspect-ratio: {{ aspect }}; --aspect-ratio-mobile: {{ mobile_aspect }};"
    {% if mobile_image != blank %}data-art-directed{% endif %}
  >
    <picture class="responsive-image__picture">
      {%- if mobile_image != blank -%}

        <source
          media="(max-width: 767px)"
          srcset="
            {%- for w in mobile_usable -%}
              {{ mobile_image | image_url: width: w }} {{ w }}w
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}"
          sizes="{{ resolved_mobile_sizes }}"
          width="{{ mobile_image.width }}"
          height="{{ mobile_image.height }}"
        >
      {%- endif -%}

      <img
        {% if id != blank %}id="{{ id }}"{% endif %}
        src="{{ image | image_url: width: largest }}"
        srcset="
          {%- for w in usable -%}
            {{ image | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}"
        sizes="{{ resolved_sizes }}"
        alt="{{ resolved_alt }}"
        width="{{ image.width }}"
        height="{{ image.height }}"
        loading="{{ loading_attr }}"
        decoding="{{ decoding_attr }}"
        {% if priority %}fetchpriority="high"{% endif %}
        class="responsive-image__img {{ class }}"
      >
    </picture>
  </responsive-image>
{%- endif -%}
