{% doc %}
  The `role="tab"` button for one panel of a `tab-group`. Render it directly
  before the panel: the markers around it are what `tab-group` splits on.

  @param {string} panel_id - The id of the panel it opens
  @param {string} content - The button's inner markup
  @param {boolean} [selected] - Open this panel on load

  @example
    {% render 'tab-button', panel_id: panel_id, content: tab_content, selected: s.selected %}
{% enddoc %}
<!--tab--><button
  type="button"
  class="tabs__tab"
  role="tab"
  id="{{ panel_id }}-tab"
  aria-controls="{{ panel_id }}"
  aria-selected="false" tabindex="-1"
  {% if selected %}data-tab-selected{% endif %}
>
  {{- content -}}
</button><!--tab-panel-->
