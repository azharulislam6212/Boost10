{% doc %}
  A menu drawer link label. Collection links lead with a round thumbnail: the
  collection image, or its first product's image when it has none.

  @param {object} link - A menu link

  @example
    {% render 'drawer-nav-label', link: child %}
{% enddoc %}

{%- liquid
  assign thumb = blank
  if link.type == 'collection_link'
    assign thumb = link.object.featured_image
  endif
-%}

<span class="drawer-nav__label">
  {%- if thumb != blank -%}
    <span class="drawer-nav__thumb" aria-hidden="true">
      {%- render 'image',
        image: thumb,
        alt: '',
        ratio: '1-1',
        sizes: '40px',
        widths: '40,80,120',
        wrapper_class: 'drawer-nav__thumb-image'
      -%}
    </span>
  {%- endif -%}
  <span class="drawer-nav__text">{{ link.title }}</span>
</span>
