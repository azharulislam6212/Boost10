{% doc %}
  The header's search trigger.

  @param {boolean} [show_label] - Print the visible "Search" label
  @param {string} [modifier] - Extra class, e.g. 'site-header__action--search-placed'

  @example
    {% render 'header-search-button', show_label: false %}
{% enddoc %}

<button
  type="button"
  class="site-header__action site-header__action--search {{ modifier }}"
  data-overlay-open="SearchDrawer"
  aria-expanded="false"
  aria-controls="SearchDrawer"
  aria-label="{{ 'accessibility.open_search' | t }}"
>
  {% render 'icon', icon: 'search', size: 20 %}
  {%- if show_label -%}
    <span class="site-header__action-label">{{ 'general.search.title' | t }}</span>
  {%- endif -%}
</button>
