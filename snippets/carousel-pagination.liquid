{% doc %}
  The mount point `<carousel-slider>` renders its pagination into.

  @param {string} [style] - dots | numbers | progress. Anything else, including nothing, renders no pagination
  @param {string} [align] - start | center | end. Default center.
  @param {string} [carousel] - Carousel element id. Omit when nested inside it.

  @example
    {% render 'carousel-pagination', style: 'dots', align: 'start' %}
    {% render 'carousel-pagination', style: 'dots', carousel: carousel_id %}
{% enddoc %}

{%- liquid
  assign style = style | default: 'none'
  assign placement = align | default: 'center'

  case style
    when 'dots'
      assign class = 'carousel-shell__dots'
    when 'numbers'
      assign class = 'carousel-shell__counter'
    when 'progress'
      assign class = 'carousel-shell__progress'
    else
      assign class = blank
  endcase

  if class != blank
    assign class = class | append: ' carousel-pagination--' | append: placement
  endif
-%}

{%- if class != blank -%}

  <div
    class="{{ class }}"
    data-ref="pagination"
    {% if carousel != blank %}data-carousel-for="{{ carousel }}"{% endif %}
    {% unless style == 'dots' %}aria-hidden="true"{% endunless %}
  ></div>
{%- endif -%}
