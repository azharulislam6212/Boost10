{% doc %}
  One ratio keyword, resolved to a CSS `aspect-ratio` value.

  @param {string} [ratio] - A ratio keyword from the `case` below, or a raw `aspect-ratio` value
  @param {image} [image] - Read for its own ratio when `ratio` is `aspect-ratio`
  @param {string} [fallback] - Used for `aspect-ratio` when the image has no ratio. Default: 1

  @example
    {%- liquid
      capture aspect
        render 'aspect-ratio', ratio: s.ratio, image: s.image
      endcapture
    -%}
{% enddoc %}

{%- liquid
  assign key = ratio | default: 'aspect-ratio'

  case key
    when '9-16'
      assign value = '9 / 16'
    when '2-3'
      assign value = '2 / 3'
    when '3-4'
      assign value = '3 / 4'
    when 'portrait'
      assign value = '4 / 5'
    when '1-1'
      assign value = '1 / 1'
    when '5-4'
      assign value = '5 / 4'
    when '4-3'
      assign value = '4 / 3'
    when '3-2'
      assign value = '3 / 2'
    when '16-9'
      assign value = '16 / 9'
    when 'aspect-ratio'
      assign value = image.aspect_ratio | default: fallback | default: 1

    when 'adapt'
      assign value = image.aspect_ratio | default: fallback | default: 1
    when 'square'
      assign value = '1 / 1'
    when 'landscape'
      assign value = '4 / 3'
    when 'wide'
      assign value = '16 / 9'
    when 'tall'
      assign value = '2 / 3'
    when 'long'
      assign value = '9 / 16'
    else
      assign value = key
  endcase
-%}
{{- value -}}
