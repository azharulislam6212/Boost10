{% doc %}
  The shop logo, in up to two versions.

  @param {boolean} [inverse] - The template is using the inverse logo
  @param {object} [section]

  @example
    {% render 'header-logo', inverse: true %}
{% enddoc %}

{%- liquid
  assign st = section.settings
  assign has_inverse = false
  if st.logo_inverse != blank
    assign has_inverse = true
  endif
-%}

{%- capture logo_content -%}
  <a class="site-header__logo-link" href="{{ routes.root_url }}">
    {%- if st.logo != blank -%}
      {% render 'image', image: st.logo, alt: shop.name, ratio: 'aspect-ratio', priority: true, widths: '120,160,240,320,480,640', sizes: st.logo_width, append: 'px', wrapper_class: 'site-header__logo-image site-header__logo-image--solid', class: 'site-header__logo-img' %}

      {%- if has_inverse -%}
        {% render 'image', image: st.logo_inverse, alt: '', ratio: 'aspect-ratio', priority: true, widths: '120,160,240,320,480,640', sizes: st.logo_width, append: 'px', wrapper_class: 'site-header__logo-image site-header__logo-image--inverse', class: 'site-header__logo-img' %}
      {%- endif -%}
    {%- else -%}
      <span class="site-header__logo-text">{{ shop.name }}</span>
    {%- endif -%}
  </a>
{%- endcapture -%}

<div
  class="site-header__logo{% if has_inverse %} site-header__logo--has-inverse{% endif %}{% if inverse %} site-header__logo--prefers-inverse{% endif %}"
  style="--logo-width: {{ st.logo_width }}px; --logo-width-mobile: {{ st.logo_width_mobile }}px;"
>
  {%- if request.page_type == 'index' -%}
    <h1 class="site-header__logo-heading">{{ logo_content }}</h1>
  {%- else -%}
    {{ logo_content }}
  {%- endif -%}
</div>
