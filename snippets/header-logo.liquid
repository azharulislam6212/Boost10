{% doc %}
  Renders the shop logo or name.

  On the home page the logo is wrapped in an `<h1>`, and everywhere else in a
  plain `<div>`. A site-wide logo marked up as the page's only level-one heading
  makes every page announce itself as the shop name rather than as its own
  content.

  Parameters:
    section (object, required)

  @example
    {% render 'header-logo', section: section %}
{% enddoc %}

{%- capture logo_content -%}
  <a class="header__logo-link" href="{{ routes.root_url }}">
    {%- if section.settings.logo != blank -%}
      {% render 'image',
         image: section.settings.logo,
         alt: shop.name,
         ratio: 'adapt',
         priority: true,
         sizes: section.settings.logo_width | append: 'px',
         wrapper_class: 'header__logo-image',
         class: 'header__logo-img' %}
    {%- else -%}
      <span class="header__logo-text">{{ shop.name }}</span>
    {%- endif -%}
  </a>
{%- endcapture -%}

<div class="header__logo" style="--logo-width: {{ section.settings.logo_width }}px;">
  {%- if request.page_type == 'index' -%}
    <h1 class="header__logo-heading">{{ logo_content }}</h1>
  {%- else -%}
    {{ logo_content }}
  {%- endif -%}
</div>
