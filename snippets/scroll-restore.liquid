{% doc %}
  Reload and back/forward open on the section the visitor was on, without
  first painting the top of the page and then jumping down.


  @param {string} [position] - 'head' (default) or 'end'

  @example
    {% render 'scroll-restore' %}
    {% render 'scroll-restore', position: 'end' %}
{% enddoc %}

{%- unless request.design_mode -%}
  {%- if position == 'end' -%}
    <script>window.Theme && Theme.placeRestoredScroll && Theme.placeRestoredScroll();</script>
  {%- else -%}
    <script>
      (function () {
        var here = location.pathname + location.search;
        var key = 'theme:scroll:' + here;
        var root = document.documentElement;

        function pinned(element) {
          for (var el = element; el && el !== document.body; el = el.parentElement) {
            var position = getComputedStyle(el).position;
            if (position === 'sticky' || position === 'fixed') return true;
          }
          return false;
        }

        try {
          addEventListener('pagehide', function () {
            var entry = { y: Math.round(scrollY), id: null, offset: 0 };
            var sections = document.querySelectorAll('.shopify-section');
            for (var i = 0; i < sections.length; i++) {
              var rect = sections[i].getBoundingClientRect();
              if (rect.bottom > 0 && rect.height > 0 && sections[i].id && !pinned(sections[i])) {
                entry.id = sections[i].id;
                entry.offset = rect.top;
                break;
              }
            }
            sessionStorage.setItem(key, JSON.stringify(entry));
          });
          var saved = JSON.parse(sessionStorage.getItem(key));
        } catch (error) {
          return;
        }

        var navigation = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var type = navigation ? navigation.type : '';
        if (!saved || !(saved.y > 0) || location.hash || !('scrollRestoration' in history) ||
            (type !== 'reload' && type !== 'back_forward')) return;

        history.scrollRestoration = 'manual';
        root.setAttribute('data-scroll-restoring', '');

        var shown = false;
        var holding = true;

        function target() {
          var anchor = saved.id ? document.getElementById(saved.id) : null;
          if (!anchor) return saved.y;
          return anchor.getBoundingClientRect().top + scrollY - saved.offset;
        }

        // Always instant: html has scroll-behavior: smooth, which would turn
        // each correction into a visible scroll down the page.
        function place() {
          var top = Math.max(0, Math.round(target()));
          if (Math.abs(scrollY - top) > 1) scrollTo({ top: top, left: 0, behavior: 'instant' });
        }

        function show() {
          if (shown) return;
          shown = true;
          root.removeAttribute('data-scroll-restoring');
          document.dispatchEvent(new CustomEvent('theme:scroll-restored'));
        }

        function placeAndShow() {
          if (shown) return;
          place();
          show();
          if (typeof ResizeObserver === 'function' && document.body) {
            var observer = new ResizeObserver(function () {
              if (holding) place();
              else observer.disconnect();
            });
            observer.observe(document.body);
          }
        }

        window.Theme = window.Theme || {};
        Theme.placeRestoredScroll = placeAndShow;

        document.addEventListener('DOMContentLoaded', placeAndShow, { once: true });

        addEventListener('load', function () {
          if (holding) place();
          setTimeout(function () {
            if (holding) place();
            holding = false;
          }, 800);
        }, { once: true });

        ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach(function (name) {
          addEventListener(name, function () { holding = false; }, { once: true, passive: true, capture: true });
        });

        // Never leave the page hidden; place first so it does not show the top.
        setTimeout(placeAndShow, 3000);
      })();
    </script>
  {%- endif -%}
{%- endunless -%}
