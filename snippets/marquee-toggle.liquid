{% doc %}
  Pause/Play for a marquee. Moving content that runs longer than five seconds
  needs a way to stop it (WCAG 2.2.2). `<motion-effect>` binds it by id.

  @param {string} controls - The marquee `<motion-effect>` id.
  @param {string} [class] - Extra classes.

  @example
    {% render 'marquee-toggle', controls: marquee_id %}
{% enddoc %}

<button
  type="button"
  class="marquee-toggle {{ class }}"
  data-marquee-toggle
  aria-controls="{{ controls }}"
  aria-pressed="false"
>
  <span class="marquee-toggle__glyph marquee-toggle__glyph--pause" aria-hidden="true">
    {%- render 'icon', icon: 'pause', size: 12 -%}
  </span>
  <span class="marquee-toggle__glyph marquee-toggle__glyph--play" aria-hidden="true">
    {%- render 'icon', icon: 'play', size: 12 -%}
  </span>
  <span class="visually-hidden">{{ 'accessibility.pause_animation' | t }}</span>
</button>
