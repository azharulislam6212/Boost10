{% doc %}
  @param {object} [options] - The static block that owns these options. Defaults to the section.
  The mobile menu drawer.

  @param {linklist} menu
  @param {object} [section]

  @example
    {% render 'header-drawer', menu: section.settings.menu %}
{% enddoc %}

{%- liquid
  assign st = section.settings
  assign opt = options | default: st
  assign mode = opt.mobile_submenu_style | default: 'accordion'
-%}

<drawer-component id="MenuDrawer" class="nav-drawer drawer color-{{ st.color_scheme }}" data-placement="start">
  <dialog class="drawer__dialog" data-ref="dialog" aria-label="{{ 'sections.header.menu' | t }}">
    <div class="drawer__panel" data-ref="panel">
      <header class="nav-drawer__header">
        {%- if opt.mobile_drawer_logo -%}
          <a class="nav-drawer__logo" href="{{ routes.root_url }}">
            {%- if st.logo != blank -%}
              {% render 'image',
                image: st.logo,
                alt: shop.name,
                ratio: 'aspect-ratio',
                sizes: '140px',
                widths: '120,160,240,320',
                wrapper_class: 'nav-drawer__logo-image',
                class: 'nav-drawer__logo-img'
              %}
            {%- else -%}
              <span class="nav-drawer__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        {%- else -%}
          <h2 class="nav-drawer__title">{{ 'sections.header.menu' | t }}</h2>
        {%- endif -%}

        {%- liquid
          assign menu_drawer_close_label = 'accessibility.close_menu' | t
        -%}
        {% render 'button',
           label: menu_drawer_close_label,
           id: 'MenuDrawerClose',
           class: 'close-menu-drawer',
           icon: 'close',
           variant: 'primary',
           size: 'small',
           icon_only: true,
           attributes: 'data-overlay-close' %}
      </header>

      <div class="drawer__body" data-ref="body" data-lenis-prevent>
        <mobile-nav
          class="drawer-nav drawer-nav--{{ mode }}"
          data-mode="{{ mode }}"
          {% if opt.mobile_dividers %}data-dividers="true"{% endif %}
        >
          {%- if mode == 'accordion' -%}

            <ul class="drawer-nav__list" role="list">
              {%- for link in menu.links -%}
                <li class="drawer-nav__item">
                  {%- if link.links.size > 0 -%}
                    <details class="drawer-nav__details" data-mobile-details>
                      <summary class="drawer-nav__link" aria-expanded="false">
                        <span>{{ link.title }}</span>
                        <span class="drawer-nav__sign" aria-hidden="true"></span>
                      </summary>

                      <div class="drawer-nav__panel" data-mobile-panel>
                        <div class="drawer-nav__panel-inner">
                          <div data-mobile-mega="{{ link.title | strip | escape }}"></div>

                          <ul class="drawer-nav__list drawer-nav__list--nested" role="list">
                            <li class="drawer-nav__item">
                              <a class="drawer-nav__link drawer-nav__link--all" href="{{ link.url }}">
                                {{ 'sections.header.view_all' | t: title: link.title }}
                              </a>
                            </li>

                            {%- for child in link.links -%}
                              <li class="drawer-nav__item">
                                {%- if child.links.size > 0 -%}
                                  <details class="drawer-nav__details" data-mobile-details>
                                    <summary class="drawer-nav__link" aria-expanded="false">
                                      <span>{{ child.title }}</span>
                                      <span class="drawer-nav__sign" aria-hidden="true"></span>
                                    </summary>

                                    <div class="drawer-nav__panel" data-mobile-panel>
                                      <div class="drawer-nav__panel-inner">
                                        <ul class="drawer-nav__list drawer-nav__list--nested" role="list">
                                          {%- for grandchild in child.links -%}
                                            <li class="drawer-nav__item">
                                              <a class="drawer-nav__link" href="{{ grandchild.url }}">
                                                {{- grandchild.title -}}
                                              </a>
                                            </li>
                                          {%- endfor -%}
                                        </ul>
                                      </div>
                                    </div>
                                  </details>
                                {%- else -%}
                                  <a class="drawer-nav__link" href="{{ child.url }}">{{ child.title }}</a>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a class="drawer-nav__link" href="{{ link.url }}">{{ link.title }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}

            <div class="drawer-nav__screen" data-menu-panel="root" data-menu-root data-active>
              <ul class="drawer-nav__list" role="list">
                {%- for link in menu.links -%}
                  <li class="drawer-nav__item">
                    {%- if link.links.size > 0 -%}
                      <button type="button" class="drawer-nav__link" data-menu-open="level-{{ forloop.index }}">
                        <span>{{ link.title }}</span>
                        {% render 'icon', icon: 'chevron-right', size: 14 %}
                      </button>
                    {%- else -%}
                      <a class="drawer-nav__link" href="{{ link.url }}">{{ link.title }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>

            {%- for link in menu.links -%}
              {%- if link.links.size > 0 -%}
                {%- assign parent_index = forloop.index -%}

                <div class="drawer-nav__screen" data-menu-panel="level-{{ parent_index }}" inert>
                  <button type="button" class="drawer-nav__back" data-menu-back>
                    {% render 'icon', icon: 'chevron-left', size: 14 %}
                    {{ 'sections.header.back' | t }}
                  </button>

                  <a class="drawer-nav__heading" href="{{ link.url }}">{{ link.title }}</a>

                  <div data-mobile-mega="{{ link.title | strip | escape }}"></div>

                  <ul class="drawer-nav__list" role="list">
                    {%- for child in link.links -%}
                      <li class="drawer-nav__item">
                        {%- if child.links.size > 0 -%}
                          <button
                            type="button"
                            class="drawer-nav__link"
                            data-menu-open="level-{{ parent_index }}-{{ forloop.index }}"
                          >
                            <span>{{ child.title }}</span>
                            {% render 'icon', icon: 'chevron-right', size: 14 %}
                          </button>
                        {%- else -%}
                          <a class="drawer-nav__link" href="{{ child.url }}">{{ child.title }}</a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>

                {%- for child in link.links -%}
                  {%- if child.links.size > 0 -%}
                    <div
                      class="drawer-nav__screen"
                      data-menu-panel="level-{{ parent_index }}-{{ forloop.index }}"
                      inert
                    >
                      <button type="button" class="drawer-nav__back" data-menu-back>
                        {% render 'icon', icon: 'chevron-left', size: 14 %}
                        {{ 'sections.header.back' | t }}
                      </button>

                      <a class="drawer-nav__heading" href="{{ child.url }}">{{ child.title }}</a>

                      <ul class="drawer-nav__list" role="list">
                        {%- for grandchild in child.links -%}
                          <li class="drawer-nav__item">
                            <a class="drawer-nav__link" href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </mobile-nav>
      </div>

      <footer class="nav-drawer__footer">

        {%- if opt.mobile_show_account and st.show_account and shop.customer_accounts_enabled -%}
          <a
            class="nav-drawer__account"
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          >
            {% render 'icon', icon: 'account', size: 18 %}
            <span>
              {%- if customer -%}
                {{ 'sections.header.account' | t }}
              {%- else -%}
                {{ 'customer.login.title' | t }}
              {%- endif -%}
            </span>
          </a>
        {%- endif -%}

        {%- if opt.mobile_show_localization -%}
          {% render 'header-localization', context: 'drawer' %}
        {%- endif -%}
      </footer>
    </div>
  </dialog>
</drawer-component>
