{% doc %}
  The mobile menu drawer.

  Rendered from the header section so that it re-renders with it: a merchant
  changing the menu in the theme editor sees the drawer update in the same
  repaint as the navigation, rather than after a reload.

  ## Two submenu styles, and only one of them is in the DOM

  **Accordion** nests `<details>` in place. It keeps the customer's position in
  the list, which is what someone scanning a long menu wants, and it needs no
  JavaScript at all to open.

  **Slide** moves sideways through panels, one level per screen. It suits deep
  menus, where a three-level accordion pushes the third level below the fold
  before it has finished opening.

  Rendering only the chosen one is deliberate. Emitting both and hiding one with
  CSS doubles the markup of the largest single component on a phone, and every
  link in the hidden copy is still in the accessibility tree and still found by
  in-page search.

  ## Mega panels are cloned, not re-rendered

  `{% content_for 'blocks' %}` can only run once, so a mega menu panel cannot
  also be rendered here. `<mobile-nav>` clones the desktop panel into the
  placeholder below instead. One source of truth: a merchant editing a panel
  edits it once and both breakpoints follow.

  Parameters:
    menu (linklist, required)

  @example
    {% render 'header-drawer', menu: section.settings.menu %}
{% enddoc %}

{%- liquid
  assign st = section.settings
  assign mode = st.mobile_submenu_style | default: 'accordion'
-%}

<drawer-component id="MenuDrawer" class="nav-drawer drawer color-{{ st.color_scheme }}" data-placement="start">
  <dialog class="drawer__dialog" data-ref="dialog" aria-label="{{ 'sections.header.menu' | t }}">
    <div class="drawer__panel" data-ref="panel">
      <header class="nav-drawer__header">
        {%- if st.mobile_drawer_logo -%}
          <a class="nav-drawer__logo" href="{{ routes.root_url }}">
            {%- if st.logo != blank -%}
              {% render 'image',
                image: st.logo,
                alt: shop.name,
                ratio: 'adapt',
                sizes: '140px',
                widths: '120,160,240,320',
                wrapper_class: 'nav-drawer__logo-image',
                class: 'nav-drawer__logo-img'
              %}
            {%- else -%}
              <span class="nav-drawer__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        {%- else -%}
          <h2 class="nav-drawer__title">{{ 'sections.header.menu' | t }}</h2>
        {%- endif -%}

        {%- comment -%}
          The theme's own button, not a hand-rolled one. It inherits the shared
          focus ring, the hover behaviour and the icon sizing, so the close
          control here is the same control as the one in the cart drawer rather
          than a lookalike that drifts the first time either is restyled.
        {%- endcomment -%}
        <button
          type="button"
          class="nav-drawer__close"
          data-overlay-close
          aria-label="{{ 'accessibility.close_menu' | t }}"
        >
          {% render 'icon', icon: 'close', size: 18 %}
        </button>
      </header>

      <div class="drawer__body" data-ref="body" data-lenis-prevent>
        <mobile-nav
          class="drawer-nav drawer-nav--{{ mode }}"
          data-mode="{{ mode }}"
          {% if st.mobile_dividers %}data-dividers="true"{% endif %}
        >
          {%- if mode == 'accordion' -%}
            {%- comment -%} ---------------- accordion ---------------- {%- endcomment -%}
            <ul class="drawer-nav__list" role="list">
              {%- for link in menu.links -%}
                <li class="drawer-nav__item">
                  {%- if link.links.size > 0 -%}
                    <details class="drawer-nav__details" data-mobile-details>
                      <summary class="drawer-nav__link" aria-expanded="false">
                        <span>{{ link.title }}</span>
                        <span class="drawer-nav__sign" aria-hidden="true"></span>
                      </summary>

                      <div class="drawer-nav__panel" data-mobile-panel>
                        <div class="drawer-nav__panel-inner">
                          <div data-mobile-mega="{{ link.title | strip | escape }}"></div>

                          <ul class="drawer-nav__list drawer-nav__list--nested" role="list">
                            <li class="drawer-nav__item">
                              <a class="drawer-nav__link drawer-nav__link--all" href="{{ link.url }}">
                                {{ 'sections.header.view_all' | t: title: link.title }}
                              </a>
                            </li>

                            {%- for child in link.links -%}
                              <li class="drawer-nav__item">
                                {%- if child.links.size > 0 -%}
                                  <details class="drawer-nav__details" data-mobile-details>
                                    <summary class="drawer-nav__link" aria-expanded="false">
                                      <span>{{ child.title }}</span>
                                      <span class="drawer-nav__sign" aria-hidden="true"></span>
                                    </summary>

                                    <div class="drawer-nav__panel" data-mobile-panel>
                                      <div class="drawer-nav__panel-inner">
                                        <ul class="drawer-nav__list drawer-nav__list--nested" role="list">
                                          {%- for grandchild in child.links -%}
                                            <li class="drawer-nav__item">
                                              <a class="drawer-nav__link" href="{{ grandchild.url }}">
                                                {{- grandchild.title -}}
                                              </a>
                                            </li>
                                          {%- endfor -%}
                                        </ul>
                                      </div>
                                    </div>
                                  </details>
                                {%- else -%}
                                  <a class="drawer-nav__link" href="{{ child.url }}">{{ child.title }}</a>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a class="drawer-nav__link" href="{{ link.url }}">{{ link.title }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            {%- comment -%} ------------------ slide ------------------ {%- endcomment -%}
            <div class="drawer-nav__screen" data-menu-panel="root" data-menu-root data-active>
              <ul class="drawer-nav__list" role="list">
                {%- for link in menu.links -%}
                  <li class="drawer-nav__item">
                    {%- if link.links.size > 0 -%}
                      <button type="button" class="drawer-nav__link" data-menu-open="level-{{ forloop.index }}">
                        <span>{{ link.title }}</span>
                        {% render 'icon', icon: 'chevron-right', size: 14 %}
                      </button>
                    {%- else -%}
                      <a class="drawer-nav__link" href="{{ link.url }}">{{ link.title }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>

            {%- for link in menu.links -%}
              {%- if link.links.size > 0 -%}
                {%- assign parent_index = forloop.index -%}

                <div class="drawer-nav__screen" data-menu-panel="level-{{ parent_index }}" inert>
                  <button type="button" class="drawer-nav__back" data-menu-back>
                    {% render 'icon', icon: 'chevron-left', size: 14 %}
                    {{ 'sections.header.back' | t }}
                  </button>

                  <a class="drawer-nav__heading" href="{{ link.url }}">{{ link.title }}</a>

                  <div data-mobile-mega="{{ link.title | strip | escape }}"></div>

                  <ul class="drawer-nav__list" role="list">
                    {%- for child in link.links -%}
                      <li class="drawer-nav__item">
                        {%- if child.links.size > 0 -%}
                          <button
                            type="button"
                            class="drawer-nav__link"
                            data-menu-open="level-{{ parent_index }}-{{ forloop.index }}"
                          >
                            <span>{{ child.title }}</span>
                            {% render 'icon', icon: 'chevron-right', size: 14 %}
                          </button>
                        {%- else -%}
                          <a class="drawer-nav__link" href="{{ child.url }}">{{ child.title }}</a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>

                {%- for child in link.links -%}
                  {%- if child.links.size > 0 -%}
                    <div
                      class="drawer-nav__screen"
                      data-menu-panel="level-{{ parent_index }}-{{ forloop.index }}"
                      inert
                    >
                      <button type="button" class="drawer-nav__back" data-menu-back>
                        {% render 'icon', icon: 'chevron-left', size: 14 %}
                        {{ 'sections.header.back' | t }}
                      </button>

                      <a class="drawer-nav__heading" href="{{ child.url }}">{{ child.title }}</a>

                      <ul class="drawer-nav__list" role="list">
                        {%- for grandchild in child.links -%}
                          <li class="drawer-nav__item">
                            <a class="drawer-nav__link" href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </mobile-nav>
      </div>

      <footer class="nav-drawer__footer">
        {%- if st.mobile_show_account and st.show_account -%}
          <a
            class="nav-drawer__account"
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          >
            {% render 'icon', icon: 'account', size: 18 %}
            <span>
              {%- if customer -%}
                {{ 'sections.header.account' | t }}
              {%- else -%}
                {{ 'customer.login.title' | t }}
              {%- endif -%}
            </span>
          </a>
        {%- endif -%}

        {%- if st.mobile_show_localization -%}
          {% render 'header-localization', context: 'drawer' %}
        {%- endif -%}

        {%- if st.mobile_show_social -%}
          {% render 'social-icons' %}
        {%- endif -%}
      </footer>
    </div>
  </dialog>
</drawer-component>
