{% doc %}
  Renders an inline SVG icon.

  Icons are inlined rather than sprited or served as files, for three reasons:
  they inherit `currentColor` so a scheme change recolours them for free, there
  is no extra request on a store where the header alone needs five of them, and
  no icon can ever fail to load and leave an empty box in the navigation.

  Every icon is `aria-hidden` and `focusable="false"`. An icon never carries the
  accessible name — the button around it does, through a translated
  `aria-label` or visually hidden text. An icon that labels itself produces
  duplicate announcements as soon as the button has text too.

  @param {string} icon - Icon name. See the list below.
  @param {string} [class] - Extra classes
  @param {number} [size] - Pixel size. Defaults to 16, applied as an inline custom property so CSS can still override it.

  Available: account, arrow-left, arrow-right, bag, cart, check, chevron-down,
  chevron-left, chevron-right, chevron-up, close, compare, copy, edit, external,
  filter, grid, heart, heart-filled, info, list, lock, menu, minus, note, pause,
  play, plus, refresh, search, share, sort, star, star-half, tag, trash, truck,
  warning, zoom-in

  Brand marks: facebook, instagram, linkedin, pinterest, snapchat, threads,
  tiktok, x, youtube

  @example
    <button type="button" aria-label="{{ 'accessibility.open_cart' | t }}">
      {% render 'icon', icon: 'cart' %}
    </button>
{% enddoc %}

{%- liquid
  assign resolved_size = size | default: 16
-%}

<svg
  class="icon icon--{{ icon }} {{ class }}"
  style="--icon-size: {{ resolved_size }}px;"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4" />
      <path d="M4 21c0-4 3.6-6.5 8-6.5S20 17 20 21" />

    {%- when 'arrow-left' -%}
      <path d="M20 12H4M4 12l6-6M4 12l6 6" />

    {%- when 'arrow-right' -%}
      <path d="M4 12h16M20 12l-6-6M20 12l-6 6" />

    {%- when 'bag' -%}
      <path d="M5 8h14l-1 12H6L5 8Z" />
      <path d="M9 8V6a3 3 0 0 1 6 0v2" />

    {%- when 'cart' -%}
      <circle cx="9" cy="20" r="1.4" fill="currentColor" stroke="none" />
      <circle cx="18" cy="20" r="1.4" fill="currentColor" stroke="none" />
      <path d="M2 3h2.5l2.6 12.2a1.5 1.5 0 0 0 1.5 1.2h9.1a1.5 1.5 0 0 0 1.5-1.2L21 7H6" />

    {%- when 'check' -%}
      <path d="M4 12.5 9.5 18 20 6.5" />

    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6" />

    {%- when 'chevron-left' -%}
      <path d="m15 6-6 6 6 6" />

    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6" />

    {%- when 'chevron-up' -%}
      <path d="m6 15 6-6 6 6" />

    {%- when 'close' -%}
      <path d="M6 6 18 18M18 6 6 18" />

    {%- when 'compare' -%}
      <path d="M12 3v18M7 8 3 12l4 4M17 8l4 4-4 4" />

    {%- when 'copy' -%}
      <rect x="9" y="9" width="12" height="12" rx="2" />
      <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />

    {%- when 'edit' -%}
      <path d="M4 20h4L20 8l-4-4L4 16v4Z" />
      <path d="m14 6 4 4" />

    {%- when 'external' -%}
      <path d="M14 4h6v6" />
      <path d="M20 4 10 14" />
      <path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />

    {%- when 'filter' -%}
      <path d="M3 6h18M6 12h12M10 18h4" />

    {%- when 'grid' -%}
      <rect x="3" y="3" width="7" height="7" rx="1" />
      <rect x="14" y="3" width="7" height="7" rx="1" />
      <rect x="3" y="14" width="7" height="7" rx="1" />
      <rect x="14" y="14" width="7" height="7" rx="1" />

    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-9.4A4.1 4.1 0 0 1 12 7.6a4.1 4.1 0 0 1 7.5 3C19.5 15.4 12 20 12 20Z" />

    {%- when 'heart-filled' -%}
      <path
        d="M12 20s-7.5-4.6-7.5-9.4A4.1 4.1 0 0 1 12 7.6a4.1 4.1 0 0 1 7.5 3C19.5 15.4 12 20 12 20Z"
        fill="currentColor"
      />

    {%- when 'info' -%}
      <circle cx="12" cy="12" r="9" />
      <path d="M12 11v5M12 8h.01" />

    {%- when 'list' -%}
      <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />

    {%- when 'lock' -%}
      <rect x="4" y="10" width="16" height="11" rx="2" />
      <path d="M8 10V7a4 4 0 0 1 8 0v3" />

    {%- when 'menu' -%}
      <path d="M3 6h18M3 12h18M3 18h18" />

    {%- when 'minus' -%}
      <path d="M5 12h14" />

    {%- when 'pause' -%}
      <path d="M9 5v14M15 5v14" />

    {%- when 'play' -%}
      <path d="M7 4.5v15l13-7.5-13-7.5Z" fill="currentColor" stroke="none" />

    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14" />

    {%- when 'refresh' -%}
      <path d="M20 12a8 8 0 1 1-2.3-5.6" />
      <path d="M20 4v5h-5" />

    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-3.6-3.6" />

    {%- when 'share' -%}
      <path d="M12 3v13" />
      <path d="m7 8 5-5 5 5" />
      <path d="M5 14v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5" />

    {%- when 'sort' -%}
      <path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3" />

    {%- when 'star' -%}
      <path d="m12 3.5 2.7 5.6 6.1.9-4.4 4.3 1 6.2-5.4-2.9-5.4 2.9 1-6.2L3.2 10l6.1-.9L12 3.5Z" />

    {%- when 'star-half' -%}
      <path d="m12 3.5 2.7 5.6 6.1.9-4.4 4.3 1 6.2-5.4-2.9-5.4 2.9 1-6.2L3.2 10l6.1-.9L12 3.5Z" />
      <path
        d="M12 3.5v13.1l-5.4 2.9 1-6.2L3.2 10l6.1-.9L12 3.5Z"
        fill="currentColor"
        stroke="none"
      />

    {%- when 'trash' -%}
      <path d="M4 7h16M10 7V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2" />
      <path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13" />
      <path d="M10 11v6M14 11v6" />

    {%- when 'truck' -%}
      <path d="M3 6h11v10H3z" />
      <path d="M14 9h4l3 3v4h-7z" />
      <circle cx="7" cy="18" r="2" />
      <circle cx="17.5" cy="18" r="2" />

    {%- when 'warning' -%}
      <path d="M12 4 2.5 20h19L12 4Z" />
      <path d="M12 10v4M12 17h.01" />

    {%- when 'zoom-in' -%}
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-3.6-3.6M11 8v6M8 11h6" />

    {%- when 'note' -%}
      <path d="M4 4h16v12l-4 4H4z"/><path d="M20 16h-4v4"/>

    {%- when 'tag' -%}
      <path d="M3 3h8l10 10-8 8L3 11z"/><circle cx="7.5" cy="7.5" r="1.5"/>

    {%- comment -%}
      Brand marks are drawn as fills rather than strokes. A brand glyph outlined
      at 1.5px reads as a different mark, and these are the one case where the
      shape is not ours to reinterpret. `stroke="none"` is set per path so the
      shared wrapper still works for every other icon.
    {%- endcomment -%}

    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17" cy="7" r="1.2" fill="currentColor" stroke="none" />

    {%- when 'facebook' -%}
      <path fill="currentColor" stroke="none" d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H16.7V3.6A21 21 0 0 0 14.28 3.5C11.9 3.5 10.3 4.95 10.3 7.6v2.3H7.6V13h2.7v8Z" />

    {%- when 'x' -%}
      <path fill="currentColor" stroke="none" d="M17.2 3h3.3l-7.2 8.2L21.7 21h-6.6l-4.3-5.6L5.9 21H2.6l7.7-8.8L2.6 3h6.8l3.9 5.2Zm-1.2 16h1.8L8.1 4.9H6.1Z" />

    {%- when 'tiktok' -%}
      <path fill="currentColor" stroke="none" d="M16.1 2h-3v13.1a2.4 2.4 0 1 1-2.4-2.4c.24 0 .47.03.7.1v-3a5.4 5.4 0 1 0 4.7 5.35V9a6.6 6.6 0 0 0 4 1.35v-3A3.7 3.7 0 0 1 16.1 4Z" />

    {%- when 'youtube' -%}
      <path fill="currentColor" stroke="none" d="M22.5 8.2a2.8 2.8 0 0 0-1.95-2C18.8 5.75 12 5.75 12 5.75s-6.8 0-8.55.45A2.8 2.8 0 0 0 1.5 8.2 29 29 0 0 0 1.05 12a29 29 0 0 0 .45 3.8 2.8 2.8 0 0 0 1.95 2c1.75.45 8.55.45 8.55.45s6.8 0 8.55-.45a2.8 2.8 0 0 0 1.95-2A29 29 0 0 0 22.95 12a29 29 0 0 0-.45-3.8ZM9.9 15.3V8.7l5.6 3.3Z" />

    {%- when 'pinterest' -%}
      <path fill="currentColor" stroke="none" d="M12 2a10 10 0 0 0-3.65 19.3 9.6 9.6 0 0 1 .04-2.87c.18-.78 1.18-5 1.18-5a3.6 3.6 0 0 1-.3-1.48c0-1.39.8-2.42 1.8-2.42.85 0 1.26.64 1.26 1.4 0 .86-.54 2.14-.83 3.33a1.45 1.45 0 0 0 1.48 1.81c1.78 0 3.14-1.87 3.14-4.58 0-2.4-1.72-4.07-4.18-4.07a4.33 4.33 0 0 0-4.52 4.34 3.9 3.9 0 0 0 .74 2.28.3.3 0 0 1 .07.29l-.28 1.13c-.04.18-.15.22-.34.13-1.26-.59-2.05-2.43-2.05-3.9 0-3.18 2.3-6.1 6.65-6.1 3.49 0 6.2 2.49 6.2 5.81 0 3.47-2.18 6.26-5.22 6.26a2.69 2.69 0 0 1-2.3-1.15l-.63 2.39a11.2 11.2 0 0 1-1.25 2.63A10 10 0 1 0 12 2Z" />

    {%- when 'linkedin' -%}
      <path fill="currentColor" stroke="none" d="M6.94 8.5v11.5H3.5V8.5ZM5.22 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM20.5 20h-3.44v-5.6c0-1.34-.03-3.06-1.87-3.06-1.87 0-2.16 1.45-2.16 2.96V20H9.6V8.5h3.3v1.57h.05a3.62 3.62 0 0 1 3.25-1.78c3.48 0 4.12 2.28 4.12 5.25Z" />

    {%- when 'threads' -%}
      <path fill="currentColor" stroke="none" d="M12.2 2c-5.5 0-8.7 3.4-8.7 10s3.2 10 8.7 10c3.9 0 6.2-1.6 7.2-4.1l-2.5-.9c-.7 1.7-2.2 2.5-4.7 2.5-3.6 0-5.7-2.2-5.9-6.8h.02C6.5 6.6 8.6 4.5 12.2 4.5c2.6 0 4.2.9 4.9 2.8l2.5-.8C18.6 3.7 16.2 2 12.2 2Zm.5 7.3c-2.6 0-4.3 1.3-4.3 3.3 0 1.9 1.6 3.2 3.8 3.2 2.7 0 4.4-1.7 4.6-4.7a7.1 7.1 0 0 0-4.1-1.13Zm-.1 2.1c1 0 1.9.2 2.6.5-.2 1.6-1.1 2.4-2.6 2.4-1 0-1.7-.5-1.7-1.3 0-.9.7-1.4 1.7-1.6Z" />

    {%- when 'snapchat' -%}
      <path fill="currentColor" stroke="none" d="M12 2.5c2.7 0 4.6 2 4.7 4.7 0 .7-.05 1.4-.08 2 .3.15.7.2 1.05.05.25-.1.5-.15.75-.15.5 0 .95.35.95.85 0 .55-.6.8-1.15 1-.55.2-1.1.4-1.1.85 0 .9 2.35 3.4 3.9 3.65.3.05.5.3.5.6 0 .7-1.6 1.05-2.45 1.2-.15.25-.2.75-.35 1.05-.1.2-.3.3-.5.3h-.1c-.35-.05-.75-.1-1.2-.1-.85 0-1.35.15-1.95.6-.75.55-1.6 1.2-3 1.2s-2.25-.65-3-1.2c-.6-.45-1.1-.6-1.95-.6-.45 0-.85.05-1.2.1h-.1c-.2 0-.4-.1-.5-.3-.15-.3-.2-.8-.35-1.05C3.1 17.1 1.5 16.75 1.5 16.05c0-.3.2-.55.5-.6 1.55-.25 3.9-2.75 3.9-3.65 0-.45-.55-.65-1.1-.85-.55-.2-1.15-.45-1.15-1 0-.5.45-.85.95-.85.25 0 .5.05.75.15.35.15.75.1 1.05-.05-.03-.6-.08-1.3-.08-2C6.4 4.5 8.3 2.5 11 2.5Z" />

    {%- else -%}
      {%- comment -%}
        An unknown name renders nothing rather than a fallback glyph. A visible
        placeholder in production is worse than a missing decoration, and the
        button around it still carries the accessible name.
      {%- endcomment -%}
  {%- endcase -%}
</svg>
