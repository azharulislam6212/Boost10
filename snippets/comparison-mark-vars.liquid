{% doc %}
  The tick or cross palette for one comparison cell, plus that cell's own overrides.

  @param {string} palette - 'yes' for a tick, 'no' for a cross.
  @param {object} block - The comparison cell's settings.
{% enddoc %}
--ct-mark-size: var(--ct-mark-{{ palette }}-size);
--ct-mark-size-mobile: var(--ct-mark-{{ palette }}-size-mobile);
--ct-mark-fill: var(--ct-mark-{{ palette }}-fill);
--ct-mark-ring-color: var(--ct-mark-{{ palette }}-ring-color);
--ct-mark-ring-width: var(--ct-mark-{{ palette }}-ring-width);
--ct-mark-color: var(--ct-mark-{{ palette }}-color);
--ct-mark-icon-size: var(--ct-mark-{{ palette }}-icon-size);
{%- if block.mark_size > 0 -%}--ct-mark-size: {{ block.mark_size }}px;{%- endif -%}
{%- if block.icon_size > 0 -%}--ct-mark-icon-size: {{ block.icon_size }}px;{%- endif -%}
{%- if block.mark_fill != blank -%}--ct-mark-fill: {{ block.mark_fill }};{%- endif -%}
{%- if block.mark_ring_color != blank -%}--ct-mark-ring-color: {{ block.mark_ring_color }};{%- endif -%}
{%- if block.mark_color != blank -%}--ct-mark-color: {{ block.mark_color }};{%- endif -%}
