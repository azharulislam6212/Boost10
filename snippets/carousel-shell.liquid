{% doc %}
  One responsive layout for every section that can be a grid or a carousel.

  ## Structure

  Swiper needs container → wrapper → slides, which is the shape this theme
  already had, so nothing was rebuilt to adopt it:

    <swiper-carousel>            container
      .carousel-shell__track     wrapper
        .carousel-shell__item    slides   ← rendered by the calling section

  Neither `swiper-wrapper` nor `swiper-slide` appears in this markup.
  `assets/carousel.js` adds both at init and removes them on destroy, because
  `swiper.css` is unlayered and its `.swiper-wrapper { display: flex }` would
  beat the `display: grid` a section's own stylesheet gives the track — so a
  section set to Grid on desktop rendered as a flex row. The class arrives with
  Swiper and leaves with it, and at a grid breakpoint there is nothing to
  override.

  That matters beyond tidiness. `swiper.css` styles `.swiper-slide` by name —
  `position: relative`, and every effect rule including
  `.swiper-fade .swiper-slide`. A renamed slide class silently disables all of
  it, which is what made `fade` render a clickable, unanimated stack.

  ## Why the carousel element wraps the grid too

  The component checks whether the current breakpoint is a carousel before
  touching Swiper, so a grid-at-every-width section costs one `matchMedia` and
  then stays inert — Swiper is never constructed.

  That is also what makes the responsive case work. A section set to grid on
  desktop and carousel on mobile needs the *same* nodes to be a grid at one
  width and a Swiper track at another. Two Liquid branches can only ship both
  and hide one.

  ## Controls outside the carousel

  Pass `nav: false` and render `carousel-controls` or `carousel-nav` wherever
  you want, with `carousel:` set to the same `id` you pass here:

    {%- assign carousel_id = 'carousel-' | append: section.id -%}

    <div class="section-header">
      <h2>{{ section.settings.heading }}</h2>
      {% render 'carousel-controls', carousel: carousel_id, align: 'inline', settings: section.settings %}
    </div>

    {% render 'carousel-shell', id: carousel_id, nav: false, ... %}

  ## Parameters

    children      (string, required)  Captured slide/grid items
    id            (string)  Element id. Required only when controls sit outside.
    layout        (string)  grid | carousel — desktop, default 'grid'
    layout_mobile (string)  grid | carousel — default 'carousel'
    tag           (string)  'ul' or 'div' for the track. Default 'div'.
    label         (string, required)  Accessible name for the track
    classes       (string)  Extra classes for the outer element
    track_classes (string)  Extra classes for the track
    columns_desktop / columns_tablet / columns_mobile (number)
    count         (number)  Slide count. Enables the loop guard in
                            `carousel-options`. Omit when the caller passes
                            `{% content_for 'blocks' %}` and cannot count.
    nav           (boolean) Render controls inside. Default true.
    settings      (object, required)  Section settings

  @example
    {% render 'carousel-shell',
       children: children,
       layout: section.settings.layout,
       layout_mobile: section.settings.layout_mobile,
       tag: 'ul',
       label: collection.title,
       settings: section.settings %}
{% enddoc %}

{%- liquid
  assign layout_desktop = layout | default: 'grid'
  assign layout_mob = layout_mobile | default: 'carousel'
  assign track_tag = tag | default: 'div'
  assign cols_desktop = columns_desktop | default: 4
  assign cols_tablet = columns_tablet | default: 2
  assign cols_mobile = columns_mobile | default: 1

  # `false == blank` is true in Liquid, so a plain blank check treats "off" as
  # "not set" and turns the arrows back on. Unchecking Show arrows did nothing.
  # `nil` is the only value that means "the caller said nothing".
  assign show_nav = settings.carousel_navigation
  if show_nav == nil
    assign show_nav = true
  endif
  unless nav == nil
    assign show_nav = nav
  endunless

  assign pagination = settings.carousel_pagination | default: 'none'
  assign nav_place = settings.carousel_nav_position | default: 'outside'

  # `count` arrives from the caller and is passed straight through to
  # `carousel-options`, where it decides whether the merchant's loop setting is
  # achievable. Swiper silently disables looping below twice `slidesPerView`,
  # which reads as the setting doing nothing.

  # Controls and pagination are only ever reachable when at least one
  # breakpoint is actually a carousel. Rendering them for a grid-at-every-width
  # section would put focusable buttons in the tab order that do nothing.
  assign is_carousel = false
  if layout_desktop == 'carousel' or layout_mob == 'carousel'
    assign is_carousel = true
  endif

  # `controls` carries its own arrows, so the bare pair would be a duplicate.
  assign use_controls = false
  if pagination == 'controls'
    assign use_controls = true
  endif

  assign inline_style = '--columns-desktop: ' | append: cols_desktop
  assign inline_style = inline_style | append: '; --columns-tablet: ' | append: cols_tablet
  assign inline_style = inline_style | append: '; --columns-mobile: ' | append: cols_mobile | append: ';'
-%}
<swiper-carousel
  {% if id %}id="{{ id }}"{% endif %}
  class="carousel-shell swiper carousel-shell--nav-{{ nav_place }} {{ classes }}"
  data-layout="{{ layout_desktop }}"
  data-layout-mobile="{{ layout_mob }}"
  data-options="
    {%- render 'carousel-options',
        settings: settings,
        count: count,
        columns_desktop: cols_desktop,
        columns_tablet: cols_tablet,
        columns_mobile: cols_mobile,
        pagination: pagination -%}
  "
  style="{{ inline_style }}{% render 'carousel-vars',
      settings: settings,
      columns_desktop: cols_desktop,
      columns_tablet: cols_tablet,
      columns_mobile: cols_mobile %}{% render 'carousel-style', settings: settings %}"
>
  <{{ track_tag }}
    class="carousel-shell__track {{ track_classes }}"
    data-ref="track"
    {% if track_tag == 'ul' %}role="list"{% endif %}
    {%- if is_carousel %}
      aria-label="{{ label | escape }}"
    {% endif -%}
  >
    {{ children }}
  </{{ track_tag }}>

  {%- if is_carousel and use_controls -%}
    {%- comment -%}
      `controls` is arrows *and* readouts in one row, so it replaces the bare
      pair rather than joining it. A merchant who has turned arrows off still
      gets the numbers and the bar.
    {%- endcomment -%}
    {% render 'carousel-controls', settings: settings %}
  {%- else -%}
    {%- if is_carousel and show_nav -%}
      {% render 'carousel-nav', settings: settings %}
    {%- endif -%}

    {%- if is_carousel and pagination != 'none' -%}
      {% render 'carousel-pagination', style: pagination %}
    {%- endif -%}
  {%- endif -%}

  {%- if is_carousel -%}
    {%- comment -%}
      Rendered whenever autoplay is available rather than only when it is on,
      because the component reveals it the moment autoplay starts and a control
      that appears late is one a keyboard user has already tabbed past.
    {%- endcomment -%}
    {%- if settings.carousel_autoplay -%}
      {%- comment -%}
        The countdown ring is a `::before` on this button, driven by the
        `--carousel-autoplay-progress` property `carousel.js` writes from
        Swiper's own `autoplayTimeLeft`. No extra element, and nothing for a
        screen reader to announce — the ring is decoration, the button is the
        control.
      {%- endcomment -%}
      <button
        type="button"
        class="carousel-shell__pause"
        data-ref="pause"
        aria-pressed="false"
        hidden
      >
        <span class="carousel-shell__pause-glyph carousel-shell__pause-glyph--pause">
          {% render 'icon', icon: 'pause', size: 14 %}
        </span>
        <span class="carousel-shell__pause-glyph carousel-shell__pause-glyph--play">
          {% render 'icon', icon: 'play', size: 14 %}
        </span>
        <span class="visually-hidden carousel-shell__pause-glyph carousel-shell__pause-glyph--pause">
          {{ 'accessibility.pause_slideshow' | t }}
        </span>
        <span class="visually-hidden carousel-shell__pause-glyph carousel-shell__pause-glyph--play">
          {{ 'accessibility.play_slideshow' | t }}
        </span>
      </button>
    {%- endif -%}

    <p class="visually-hidden" data-ref="status" role="status"></p>
  {%- endif -%}
</swiper-carousel>
