{% doc %}
  One responsive layout for every section that can be a grid or a carousel.

  @param {string} [children]
  @param {string} [classes]
  @param {string} [columns_desktop]
  @param {string} [columns_mobile]
  @param {string} [columns_tablet]
  @param {number} [count]
  @param {string} [id]
  @param {string} [label]
  @param {string} [layout]
  @param {string} [layout_mobile]
  @param {string} [nav]
  @param {string} [tag]
  @param {string} [track_classes]
  @param {string} [direction] - horizontal | vertical. Default horizontal. Vertical needs a height on the element; see `--carousel-row-size` in `assets/carousel.css`.
  @param {boolean} [detached] - The caller renders the arrows and the pagination itself, somewhere else, passing `carousel:` with this `id`. Keeps the pause button and the live region, which have to stay inside the element.
  @param {string} [gap_css] - A CSS length or `var()` for `--carousel-gap`, for a carousel whose spacing steps at a breakpoint. See `carousel-vars`.

  @example
    {% render 'carousel-shell',
       children: children,
       layout: section.settings.layout,
       layout_mobile: section.settings.layout_mobile,
       tag: 'ul',
       label: collection.title,
       settings: section.settings %}
{% enddoc %}

{%- liquid
  assign layout_desktop = layout | default: 'grid'
  assign layout_mob = layout_mobile | default: 'carousel'
  assign track_tag = tag | default: 'div'
  assign cols_desktop = columns_desktop | default: 4
  assign cols_tablet = columns_tablet | default: 2
  assign cols_mobile = columns_mobile | default: 1

 
  assign show_nav = settings.carousel_navigation
  if show_nav == nil
    assign show_nav = true
  endif
  unless nav == nil
    assign show_nav = nav
  endunless

  assign pagination = settings.carousel_pagination | default: 'none'
  assign nav_place = settings.carousel_nav_position | default: 'outside'


  if detached
    assign show_nav = false
    assign pagination = 'none'
  endif

  assign is_carousel = false
  if layout_desktop == 'carousel' or layout_mob == 'carousel'
    assign is_carousel = true
  endif

  # `controls` carries its own arrows, so the bare pair would be a duplicate.
  assign use_controls = false
  if pagination == 'controls'
    assign use_controls = true
  endif

 
  assign axis = direction | default: 'horizontal'
  if axis != 'vertical'
    assign axis = 'horizontal'
  endif

  assign inline_style = '--columns-desktop: ' | append: cols_desktop
  assign inline_style = inline_style | append: '; --columns-tablet: ' | append: cols_tablet
  assign inline_style = inline_style | append: '; --columns-mobile: ' | append: cols_mobile | append: ';'
-%}
<carousel-slider
  {% if id %}id="{{ id }}"{% endif %}
  class="carousel-shell carousel-shell--nav-{{ nav_place }} carousel-shell--{{ axis }} {{ classes }}"
  data-layout="{{ layout_desktop }}"
  data-layout-mobile="{{ layout_mob }}"
  data-direction="{{ axis }}"
  data-options="
    {%- render 'carousel-options',
        settings: settings,
        count: count,
        columns_desktop: cols_desktop,
        columns_tablet: cols_tablet,
        columns_mobile: cols_mobile,
        direction: axis,
        pagination: pagination -%}
  "
  style="{{ inline_style }}{% render 'carousel-vars',
      settings: settings,
      columns_desktop: cols_desktop,
      columns_tablet: cols_tablet,
      columns_mobile: cols_mobile,
      gap_css: gap_css %}{% render 'carousel-style', settings: settings %}"
>
  <{{ track_tag }}
    class="carousel-shell__track {{ track_classes }}"
    data-ref="track"
    {% if track_tag == 'ul' %}role="list"{% endif %}
    {%- if is_carousel %}
      aria-label="{{ label | escape }}"
    {% endif -%}
  >
    {{ children }}
  </{{ track_tag }}>

  {%- if is_carousel and use_controls -%}

    {% render 'carousel-controls', settings: settings %}
  {%- else -%}
    {%- if is_carousel and show_nav -%}
      {% render 'carousel-nav', settings: settings %}
    {%- endif -%}

    {%- if is_carousel and pagination != 'none' -%}
      {% render 'carousel-pagination', style: pagination %}
    {%- endif -%}
  {%- endif -%}

  {%- if is_carousel -%}

    {%- if settings.carousel_autoplay -%}

      <button
        type="button"
        class="carousel-shell__pause"
        data-ref="pause"
        aria-pressed="false"
        hidden
      >
        <span class="carousel-shell__pause-glyph carousel-shell__pause-glyph--pause">
          {% render 'icon', icon: 'pause', size: 14 %}
        </span>
        <span class="carousel-shell__pause-glyph carousel-shell__pause-glyph--play">
          {% render 'icon', icon: 'play', size: 14 %}
        </span>
        <span class="visually-hidden carousel-shell__pause-glyph carousel-shell__pause-glyph--pause">
          {{ 'accessibility.pause_slideshow' | t }}
        </span>
        <span class="visually-hidden carousel-shell__pause-glyph carousel-shell__pause-glyph--play">
          {{ 'accessibility.play_slideshow' | t }}
        </span>
      </button>
    {%- endif -%}

    <p class="visually-hidden" data-ref="status" role="status"></p>
  {%- endif -%}
</carousel-slider>
