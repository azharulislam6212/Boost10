{% doc %}
  A horizontal rule between things.

  @param {string} [style] - solid | dashed | dotted | wave. Default solid
  @param {string} [color] - Defaults to the theme divider colour
  @param {number} [thickness] - Pixels. Ignored by the wave, which scales
  @param {string} [width] - full | container | short. Default full
  @param {string} [orientation] - horizontal | vertical. Default horizontal. The wave is always horizontal
  @param {boolean} [flip] - Mirrors the wave vertically

  @example
    {% render 'divider', style: 'wave', color: settings.divider_color %}
{% enddoc %}

{%- liquid
  assign divider_style = style | default: 'solid'
  assign divider_color = color | default: settings.divider_color | default: '#e5e5e5'
  assign divider_thickness = thickness | default: settings.divider_thickness | default: 1
  assign divider_width = width | default: 'full'

  assign divider_orientation = orientation | default: 'horizontal'
  if divider_style == 'wave'
    assign divider_orientation = 'horizontal'
  endif
-%}

<div
  class="divider divider--{{ divider_style }} divider--{{ divider_width }} divider--{{ divider_orientation }}{% if flip %} divider--flip{% endif %}"
  style="--divider-color: {{ divider_color }}; --divider-thickness: {{ divider_thickness }}px;"
  aria-hidden="true"
>
  {%- if divider_style == 'wave' -%}

    <svg
      class="divider__wave"
      viewBox="0 0 1200 40"
      preserveAspectRatio="none"
      focusable="false"
      aria-hidden="true"
    >
      <path
        d="M0,20 C150,0 250,40 400,20 C550,0 650,40 800,20 C950,0 1050,40 1200,20 L1200,40 L0,40 Z"
        fill="var(--divider-color)"
      />
    </svg>
  {%- endif -%}
</div>
