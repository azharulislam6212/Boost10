{% doc %}
  The taxes and shipping line under cart totals. Follows the buyer's market
  (taxes included or not) and links to the shipping policy when one exists.

  @example
    {% render 'cart-tax-note' %}
{% enddoc %}

{%- liquid
  assign has_policy = false
  if shop.shipping_policy.body != blank
    assign has_policy = true
  endif

  if cart.taxes_included
    if has_policy
      echo 'cart.general.taxes_included_shipping_with_policy_html' | t: link: shop.shipping_policy.url
    else
      echo 'cart.general.taxes_included_shipping_at_checkout' | t
    endif
  else
    if has_policy
      echo 'cart.general.taxes_and_shipping_with_policy_html' | t: link: shop.shipping_policy.url
    else
      echo 'cart.general.taxes_and_shipping_at_checkout' | t
    endif
  endif
-%}
