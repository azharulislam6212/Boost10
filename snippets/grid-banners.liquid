{% doc %}
  Splices in-grid banner blocks into a product loop.

  @param {object} section
  @param {number} index - The 1-based position of the product just rendered

  @example
    {%- for product in collection.products -%}
      <li>{% render 'product-card', product: product %}</li>
      {% render 'grid-banners', section: section, index: forloop.index %}
    {%- endfor -%}
{% enddoc %}

{%- for block in section.blocks -%}
  {%- if block.type == 'grid-banner' -%}
    {%- assign banner_position = block.settings.position | plus: 0 -%}
    {%- if banner_position == index -%}

    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
