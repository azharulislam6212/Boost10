<link rel="modulepreload" href="{{ 'global.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'component.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'utilities.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'events.js' | asset_url }}" fetchpriority="low">

{%- unless is_password -%}
  <link rel="modulepreload" href="{{ 'swiper.js' | asset_url }}" fetchpriority="low">
{%- endunless -%}

{%- if is_smooth_scroll -%}
  <link rel="modulepreload" href="{{ 'scrollbar.js' | asset_url }}" fetchpriority="low">
  <link rel="modulepreload" href="{{ 'lenis.js' | asset_url }}" fetchpriority="low">
{%- endif -%}

{%- if use_cart_drawer -%}
  <link rel="modulepreload" href="{{ 'cart-drawer.js' | asset_url }}" fetchpriority="low">
{%- endif -%}

{%- unless is_password -%}
  {%- case template.name -%}
    {%- when 'product' -%}
      <link rel="modulepreload" href="{{ 'product-form.js' | asset_url }}" fetchpriority="low">
      <link rel="modulepreload" href="{{ 'variant-picker.js' | asset_url }}" fetchpriority="low">
      <link rel="modulepreload" href="{{ 'media-gallery.js' | asset_url }}" fetchpriority="low">
      <link rel="modulepreload" href="{{ 'media-coordinator.js' | asset_url }}" fetchpriority="low">
    {%- when 'collection', 'search' -%}
      <link rel="modulepreload" href="{{ 'facets.js' | asset_url }}" fetchpriority="low">
    {%- when 'cart' -%}
      <link rel="modulepreload" href="{{ 'cart-items.js' | asset_url }}" fetchpriority="low">
      <link rel="modulepreload" href="{{ 'quantity-selector.js' | asset_url }}" fetchpriority="low">
    {%- when 'customers/account', 'customers/order' -%}
      <link rel="modulepreload" href="{{ 'customer-orders.js' | asset_url }}" fetchpriority="low">
    {%- when 'customers/addresses' -%}
      <link rel="modulepreload" href="{{ 'customer-addresses.js' | asset_url }}" fetchpriority="low">
  {%- endcase -%}
{%- endunless -%}

<script type="module" src="{{ 'global.js' | asset_url }}"></script>
