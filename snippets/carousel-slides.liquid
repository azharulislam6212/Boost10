{% doc %}
  How many slides are visible at one breakpoint. Returns a bare number.

  @param {string} [columns_desktop]
  @param {string} [columns_mobile]
  @param {string} [columns_tablet]
  @param {string} [peek_desktop]
  @param {string} [peek_mobile]
  @param {string} [viewport]

  @example
    {%- capture spv -%}{% render 'carousel-slides', settings: section.settings, viewport: 'mobile' %}{%- endcapture -%}
{% enddoc %}

{%- liquid
  case viewport
    when 'desktop'
      assign columns = columns_desktop | default: settings.columns_desktop | default: 4
      assign peek = peek_desktop
      if peek == nil
        assign peek = settings.carousel_peek_desktop
      endif
    when 'tablet'
      assign columns = columns_tablet | default: settings.columns_tablet | default: 2
      assign peek = peek_desktop
      if peek == nil
        assign peek = settings.carousel_peek_desktop
      endif
    else
      assign columns = columns_mobile | default: settings.columns_mobile | default: 1
      assign peek = peek_mobile
      if peek == nil
        assign peek = settings.carousel_peek_mobile
      endif
  endcase

  assign columns = columns | plus: 0
  if columns < 1
    assign columns = 1
  endif

  assign peek = peek | default: 0 | plus: 0

  # Capped below one whole slide. At 100 the "partial" slide is a whole extra
  # column, which is the columns setting with extra steps, and above that the
  # arithmetic stops matching what the merchant sees.
  if peek < 0
    assign peek = 0
  endif
  if peek > 90
    assign peek = 90
  endif

  # `100.0` rather than `100`: integer division would floor every peek to zero.
  assign slides = columns
  if peek > 0
    assign fraction = peek | divided_by: 100.0
    assign slides = columns | plus: fraction
  endif
-%}
{{- slides -}}
