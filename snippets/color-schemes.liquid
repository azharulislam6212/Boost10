{% doc %}
  Emits every colour scheme as CSS custom properties.

  @example
{% enddoc %}

{% style %}
  {%- for scheme in settings.color_schemes -%}
    {%- if forloop.index == 1 -%}
      :root,
    {%- endif -%}

    .color-{{ scheme.id }} {
      /* ---- surface ---- */
      --color-background: rgb({{ scheme.settings.background.rgba }});
      --color-background-rgb: {{ scheme.settings.background.rgb }};

      {%- if scheme.settings.secondary_background != blank %}
        --color-secondary-background: rgb({{ scheme.settings.secondary_background.rgba }});
        --color-secondary-background-rgb: {{ scheme.settings.secondary_background.rgb }};
      {%- else %}
        --color-secondary-background: rgb({{ scheme.settings.background.rgba }});
        --color-secondary-background-rgb: {{ scheme.settings.background.rgb }};
      {%- endif %}

      {%- if scheme.settings.background_gradient != blank %}

        --badge-background: {{ scheme.settings.secondary_background | default: scheme.settings.background }};
        --badge-text: {{ scheme.settings.text }};
        --badge-sale-background: {{ scheme.settings.sale_price | default: scheme.settings.text }};
        --badge-sale-text: {{ scheme.settings.background }};

        --gradient-background: {{ scheme.settings.background_gradient }};
      {%- else %}
        --gradient-background: rgb({{ scheme.settings.background.rgba }});
      {%- endif %}

      /* ---- typography ---- */
      --color-text: rgb({{ scheme.settings.text.rgba }});
      --color-text-rgb: {{ scheme.settings.text.rgb }};
      --color-heading: rgb({{ scheme.settings.heading.rgba }});
      --color-heading-rgb: {{ scheme.settings.heading.rgb }};
      --color-accent-text: rgb({{ scheme.settings.accent_text.rgba }});
      --color-accent-text-rgb: {{ scheme.settings.accent_text.rgb }};
      --color-sale-price: rgb({{ scheme.settings.sale_price.rgba }});
      --color-sale-price-rgb: {{ scheme.settings.sale_price.rgb }};
      --color-link: rgb({{ scheme.settings.link_color.rgba }});
      --color-link-rgb: {{ scheme.settings.link_color.rgb }};
      --color-link-hover: rgb({{ scheme.settings.link_hover.rgba }});
      --color-link-hover-rgb: {{ scheme.settings.link_hover.rgb }};

      /* ---- primary button ---- */
      --color-primary-button-background: rgb({{ scheme.settings.primary_button_background.rgba }});
      --color-primary-button-background-rgb: {{ scheme.settings.primary_button_background.rgb }};
      --color-primary-button-text: rgb({{ scheme.settings.primary_button_text.rgba }});
      --color-primary-button-border: rgb({{ scheme.settings.primary_button_border.rgba }});
      --color-primary-button-hover-background: rgb({{ scheme.settings.primary_button_hover_background.rgba }});
      --color-primary-button-hover-text: rgb({{ scheme.settings.primary_button_hover_text.rgba }});
      --color-primary-button-hover-border: rgb({{ scheme.settings.primary_button_hover_border.rgba }});
      --color-primary-button-outline: rgb({{ scheme.settings.primary_outline_button.rgba }});
      --color-primary-button-hover-outline: rgb({{ scheme.settings.primary_outline_button_hover.rgba }});

      /* ---- secondary button ---- */
      --color-secondary-button-background: rgb({{ scheme.settings.secondary_button_background.rgba }});
      --color-secondary-button-text: rgb({{ scheme.settings.secondary_button_text.rgba }});
      --color-secondary-button-border: rgb({{ scheme.settings.secondary_button_border.rgba }});
      --color-secondary-button-hover-background: rgb({{ scheme.settings.secondary_button_hover_background.rgba }});
      --color-secondary-button-hover-text: rgb({{ scheme.settings.secondary_button_hover_text.rgba }});
      --color-secondary-button-hover-border: rgb({{ scheme.settings.secondary_button_hover_border.rgba }});
      --color-secondary-button-outline: rgb({{ scheme.settings.secondary_outline_button.rgba }});
      --color-secondary-button-hover-outline: rgb({{ scheme.settings.secondary_outline_button_hover.rgba }});

      /* ---- inputs ---- */
      --color-input-background: rgb({{ scheme.settings.input_background.rgba }});
      --color-input-text: rgb({{ scheme.settings.input_text_color.rgba }});
      --color-input-text-rgb: {{ scheme.settings.input_text_color.rgb }};
      --color-input-border: rgb({{ scheme.settings.input_border_color.rgba }});

      --color-input-border-alpha: rgba({{ scheme.settings.input_border_color.rgb }}, {{ settings.inputs_border_opacity | default: 100 | divided_by: 100.0 | times: scheme.settings.input_border_color.alpha }});
      --color-input-focus-background: {{ scheme.settings.input_focus_background | default: scheme.settings.input_background }};
      --color-input-focus-text: {{ scheme.settings.input_focus_text | default: scheme.settings.input_text_color }};
      --color-input-focus-border: {{ scheme.settings.input_focus_border | default: scheme.settings.input_text_color }};

      /* ---- slider controls ---- */
      --color-slider-arrow-icon: rgb({{ scheme.settings.slider_arrow_icon.rgba }});
      --color-slider-arrow-background: rgb({{ scheme.settings.slider_arrow_background.rgba }});
      --color-slider-arrow-border: rgb({{ scheme.settings.slider_arrow_border.rgba }});
      --color-slider-arrow-icon-hover: rgb({{ scheme.settings.slider_arrow_icon_hover.rgba }});
      --color-slider-arrow-background-hover: rgb({{ scheme.settings.slider_arrow_background_hover.rgba }});
      --color-slider-arrow-border-hover: rgb({{ scheme.settings.slider_arrow_border_hover.rgba }});
      --color-slider-indicator: rgb({{ scheme.settings.slider_indicator_color.rgba }});
      --color-slider-indicator-active: rgb({{ scheme.settings.slider_indicator_active_color.rgba }});

      /* ---- structure ---- */
      --color-border: rgb({{ scheme.settings.border.rgba }});
      --color-border-rgb: {{ scheme.settings.border.rgb }};
      --color-shadow: rgb({{ scheme.settings.shadow.rgba }});
      --color-shadow-rgb: {{ scheme.settings.shadow.rgb }};

      /* ---- composed shadows ----
         Assembled once here so no component has to rebuild a shadow from four
         separate settings, and so a scheme with a light shadow colour reads
         correctly on a dark background. */
      --shadow-card:
        {{ settings.card_shadow_offset_x | default: 0 }}px
        {{ settings.card_shadow_offset_y | default: 6 }}px
        {{ settings.card_shadow_blur | default: 20 }}px
        rgb({{ scheme.settings.shadow.rgb }} / {{ settings.card_shadow_opacity | default: 0 | divided_by: 100.0 }});

      --shadow-drawer:
        0 0 40px
        rgb({{ scheme.settings.shadow.rgb }} / {{ settings.drawer_shadow_opacity | default: 15 | divided_by: 100.0 }});

      --backdrop-color:
        rgb(0 0 0 / {{ settings.backdrop_opacity | default: 50 | divided_by: 100.0 }});
    }
  {%- endfor -%}

   :root {

      /* ---- gradients ---- */
      --gradient-primary: {{ settings.gradient_primary | default: 'linear-gradient(135deg, #1a1a1a 0%, #4a4a4a 100%)' }};
      --gradient-secondary: {{ settings.gradient_secondary | default: 'linear-gradient(135deg, #c9a961 0%, #e8d5a3 100%)' }};
      --gradient-custom: {{ settings.gradient_custom | default: 'linear-gradient(135deg, #6a5acd 0%, #ff6b9d 100%)' }};

      /* ---- dividers ---- */
      --divider-color: {{ settings.divider_color | default: '#e5e5e5' }};
      --divider-thickness: {{ settings.divider_thickness | default: 1 }}px;

    /* ---- notifications ------------------------------------------------- */

    --color-success: rgb({{ settings.color_success.rgba }});
    --color-success-rgb: {{ settings.color_success.rgb }};
    --color-error: rgb({{ settings.color_error.rgba }});
    --color-error-rgb: {{ settings.color_error.rgb }};
    --color-warning: rgb({{ settings.color_warning.rgba }});
    --color-warning-rgb: {{ settings.color_warning.rgb }};
    --color-info: rgb({{ settings.color_info.rgba }});
    --color-info-rgb: {{ settings.color_info.rgb }};
    --color-white: rgb({{ settings.color_white.rgba }});
    --color-black: rgb({{ settings.color_black.rgba }});

    /* ---- stock states -------------------------------------------------- */

    --color-instock: rgb({{ settings.color_instock.rgba }});
    --color-instock-rgb: {{ settings.color_instock.rgb }};
    --color-lowstock: rgb({{ settings.color_lowstock.rgba }});
    --color-lowstock-rgb: {{ settings.color_lowstock.rgb }};
    --color-outofstock: rgb({{ settings.color_outofstock.rgba }});
    --color-outofstock-rgb: {{ settings.color_outofstock.rgb }};

    /* ---- variant pills ------------------------------------------------- */

    --color-variant-bg: rgb({{ settings.variant_background_color.rgba }});
    --color-variant-text: rgb({{ settings.variant_text_color.rgba }});
    --color-variant-border: rgb({{ settings.variant_border_color.rgba }});
    --color-variant-hover-bg: rgb({{ settings.variant_hover_background.rgba }});
    --color-variant-hover-text: rgb({{ settings.variant_hover_text.rgba }});
    --color-variant-hover-border: rgb({{ settings.variant_hover_border.rgba }});

    --color-variant-selected-bg: rgb({{ settings.selected_variant_background.rgba }});
    --color-variant-selected-text: rgb({{ settings.selected_variant_text.rgba }});
    --color-variant-selected-border: rgb({{ settings.selected_variant_border.rgba }});

    /* ---- swatches ------------------------------------------------------ */

    --color-swatch-border: rgb({{ settings.swatches_border.rgba }});
    --color-swatch-active-border: rgb({{ settings.swatches_active_border.rgba }});

    /* ---- badges -------------------------------------------------------- */

    --color-badge-sale-bg: rgb({{ settings.badge_sale_background.rgba }});
    --color-badge-sale-text: rgb({{ settings.badge_sale_text.rgba }});

    --color-badge-new-bg: rgb({{ settings.badge_new_background.rgba }});
    --color-badge-new-text: rgb({{ settings.badge_new_text.rgba }});

    --color-badge-hot-bg: rgb({{ settings.badge_hot_background.rgba }});
    --color-badge-hot-text: rgb({{ settings.badge_hot_text.rgba }});

    --color-badge-popular-bg: rgb({{ settings.badge_popular_background.rgba }});
    --color-badge-popular-text: rgb({{ settings.badge_popular_text.rgba }});

    --color-badge-sold-out-bg: rgb({{ settings.badge_sold_out_background.rgba }});
    --color-badge-sold-out-text: rgb({{ settings.badge_sold_out_text.rgba }});

    --color-badge-preorder-bg: rgb({{ settings.badge_preorder_background.rgba }});
    --color-badge-preorder-text: rgb({{ settings.badge_preorder_text.rgba }});

    --color-badge-custom-bg: rgb({{ settings.badge_custom_background.rgba }});
    --color-badge-custom-text: rgb({{ settings.badge_custom_text.rgba }});

  }
  .color-scheme-container {
    background-color: var(--color-background);
    background-image: var(--gradient-background);
    color: var(--color-text);
  }
{% endstyle %}
