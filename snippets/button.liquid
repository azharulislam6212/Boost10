{% doc %}
  Renders a button, or a link styled as one.

  @param {string} label - Already translated
  @param {string} [href] - The URL. With `tag: 'auto'` its presence also picks the element
  @param {string} [tag] - 'auto' | 'a' | 'button'. Default 'auto', which is an `<a>` when there is an `href` and a `<button>` otherwise. `'a'` without an `href` falls back to `<button>` — an anchor with no href is unreachable by keyboard
  @param {string} [variant] - 'primary' | 'secondary' | 'outline' | 'secondary-outline' | 'link' | 'custom'. Default primary. 'outline' is the primary outline; it keeps its old name because every existing caller passes it
  @param {string} [size] - 'small' | 'medium' | 'large' | 'custom'. Default medium. Sizes are relative to Theme settings > Buttons > Height, so raising that scales all four
  @param {number} [custom_height] - Pixels. Only read when size is 'custom'
  @param {string} [type] - Button type. Default 'button'
  @param {string} [name] - Form control name
  @param {string} [value] - Form control value
  @param {boolean} [full] - Full width
  @param {boolean} [disabled]
  @param {boolean} [loading] - Shows a spinner and sets aria-busy
  @param {string} [icon] - Icon name from snippets/icon.liquid. Defaults to 'arrow-right' — the theme's house call to action. Pass 'none' for a bare label
  @param {string} [icon_position] - 'start' | 'end'. Default 'end'
  @param {string} [icon_style] - 'default' | 'solid'. Solid puts the icon in a filled circular badge. Default 'solid', except on the 'link' variant and icon-only buttons, which have no box to put a badge beside
  @param {number} [icon_size] - Glyph size in px. The solid badge is derived from it, so both scale together
  @param {number} [icon_radius] - Badge corner radius as a percentage. 50 is a circle; 0 is a square
  @param {string} [border_style] - 'solid' | 'dashed' | 'dotted'
  @param {number} [underline_size] - Link variant only. Underline thickness in px
  @param {string} [width] - 'auto' | 'min' | 'full'. Default 'min'. Auto hugs the label; min holds a comfortable minimum; full fills the container
  @param {number} [min_width] - Pixels, used when width is 'min'. Default 196
  @param {boolean} [icon_only] - Hides the label visually. `label` becomes the aria-label
  @param {string} [effect] - 'auto' | 'swap' | 'sweep' | 'none'. Default 'auto'
  @param {string} [colors] - Extra custom properties for variant 'custom'
  @param {string} [class]
  @param {string} [id]
  @param {string} [aria_label] - Overrides the accessible name
  @param {string} [attributes] - Raw extra attributes, e.g. data-overlay-open="CartDrawer"
  @param {boolean} [new_tab] - Links only. Adds rel and a translated hint

  @example
    {% render 'button', label: 'products.product.add_to_cart' | t, type: 'submit', full: true %}

  @example
    {% render 'button',
       label: 'general.actions.view_all' | t,
       href: collection.url,
       variant: 'secondary',
       icon: 'arrow-right',
       icon_style: 'solid' %}
{% enddoc %}

{%- liquid
  assign resolved_variant = variant | default: 'primary'
  assign resolved_size = size | default: 'medium'
  if resolved_size == 'custom'
    assign resolved_size = 'custom-size'
  endif
  assign resolved_icon_position = icon_position | default: 'end'
  assign resolved_type = type | default: 'button'
  assign accessible_name = aria_label | default: label

  assign resolved_icon = icon | default: 'arrow-right'
  assign resolved_icon_style = icon_style | default: 'solid'

  if resolved_variant == 'link'
    assign resolved_icon_style = icon_style | default: 'default'
  endif

  assign has_icon = false
  if resolved_icon != blank and resolved_icon != 'none'
    assign has_icon = true
  endif

  unless has_icon
    assign resolved_icon_style = 'default'
  endunless

  if icon_only
    assign resolved_icon_style = 'default'
  endif

  assign resolved_effect = effect | default: 'auto'
  if resolved_effect == 'auto'
    if has_icon
      assign resolved_effect = 'swap'
    else
      assign resolved_effect = 'sweep'
    endif
  endif

  assign classes = 'button button--' | append: resolved_variant | append: ' button--' | append: resolved_size

  if has_icon
    assign classes = classes | append: ' button--has-icon button--icon-' | append: resolved_icon_position
    if resolved_icon_style == 'solid'
      assign classes = classes | append: ' button--icon-solid'
    endif
  endif

  assign resolved_width = width | default: 'min'
  if full
    assign classes = classes | append: ' button--full'
  else
    assign classes = classes | append: ' button--width-' | append: resolved_width
  endif
  if icon_only
    assign classes = classes | append: ' button--icon-only'
  endif
  if loading
    assign classes = classes | append: ' button--loading'
  endif
  if class != blank
    assign classes = classes | append: ' ' | append: class
  endif

  assign inline_style = ''
  if resolved_size == 'custom-size'
    if custom_height != blank
      assign inline_style = inline_style | append: '--button-custom-height:' | append: custom_height | append: 'px;'
    endif
  endif
  if icon_size != blank
    assign inline_style = inline_style | append: '--button-icon-size:' | append: icon_size | append: 'px;'
  endif
  if icon_radius != blank
    assign inline_style = inline_style | append: '--button-icon-radius:' | append: icon_radius | append: '%;'
  endif
  if border_style != blank and border_style != 'default'
    assign inline_style = inline_style | append: '--button-border-style:' | append: border_style | append: ';'
  endif
  if min_width != blank and resolved_width == 'min'
    assign inline_style = inline_style | append: '--button-min-width:' | append: min_width | append: 'px;'
  endif
  if resolved_variant == 'link' and underline_size != blank
    assign inline_style = inline_style | append: '--button-underline-size:' | append: underline_size | append: 'px;'
  endif
  if colors != blank
    assign inline_style = inline_style | append: colors
  endif
-%}

{%- capture button_content -%}

  <span class="button-text">
    {%- if has_icon and resolved_icon_position == 'start' -%}
      <span class="button__icon button__icon--start">
        {% render 'icon', icon: resolved_icon %}
      </span>
    {%- endif -%}

    <span class="button__label{% if icon_only %} visually-hidden{% endif %}">{{ label }}</span>

    {%- if has_icon and resolved_icon_position == 'end' -%}
      <span class="button__icon button__icon--end">
        {% render 'icon', icon: resolved_icon %}
      </span>
    {%- endif -%}
  </span>

  {%- if loading -%}

    <span class="button__spinner" aria-hidden="true"></span>
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign resolved_tag = tag | default: 'auto'
  if resolved_tag == 'auto'
    if href != blank
      assign resolved_tag = 'a'
    else
      assign resolved_tag = 'button'
    endif
  endif
  if resolved_tag == 'a' and href == blank
    assign resolved_tag = 'button'
  endif
-%}

{%- capture button_markup -%}
  {%- if resolved_tag == 'a' -%}

    <a
      {% if id != blank %}id="{{ id }}"{% endif %}
      class="{{ classes }}"
      {% if inline_style != blank %}style="{{ inline_style }}"{% endif %}
      href="{{ href }}"
      {% if icon_only %}aria-label="{{ accessible_name | escape }}"{% endif %}
      {% if new_tab %}target="_blank" rel="noopener"{% endif %}
      {% if disabled %}aria-disabled="true"{% endif %}
      {% if resolved_effect == 'none' %}data-fx="none"{% endif %}
      {{ attributes }}
    >
      {{ button_content }}
      {%- if new_tab -%}
        <span class="visually-hidden">{{ 'accessibility.new_window' | t }}</span>
      {%- endif -%}
    </a>
  {%- else -%}

    <button
      {% if id != blank %}id="{{ id }}"{% endif %}
      class="{{ classes }}"
      {% if inline_style != blank %}style="{{ inline_style }}"{% endif %}
      type="{{ resolved_type }}"
      {% if name != blank %}name="{{ name }}"{% endif %}
      {% if value != blank %}value="{{ value | escape }}"{% endif %}
      {% if href != blank %}data-href="{{ href }}"{% endif %}
      {% if icon_only %}aria-label="{{ accessible_name | escape }}"{% endif %}
      {% if disabled %}disabled{% endif %}
      {% if loading %}aria-busy="true"{% endif %}
      {% if resolved_effect == 'none' %}data-fx="none"{% endif %}
      {{ attributes }}
    >
      {{ button_content }}
    </button>
  {%- endif -%}
{%- endcapture -%}

{%- if resolved_effect == 'swap' -%}

  <button-swap class="button-swap"{% if full %} data-full{% endif %}>{{ button_markup }}</button-swap>
{%- else -%}
  {{ button_markup }}
{%- endif -%}
