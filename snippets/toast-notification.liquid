{% doc %}
  Mounts the toast element.

  @example
    {% render 'toast-notification' %}
{% enddoc %}

<toast-notification
  id="Toast"
  style="
    --toast-background: {{ settings.colors_toast_background | default: '#0f2e2f' }};
    --toast-text: {{ settings.colors_toast_text | default: '#ffffff' }};
    --toast-error-background: {{ settings.colors_toast_error | default: '#ff5f00' }};
    --toast-error-text: {{ settings.colors_toast_error_text | default: '#0f2e2f' }};

    --toast-radius: {{ settings.card_radius | default: 8 }}px;
    --toast-offset: {{ settings.toast_offset | default: 20 }}px;
  "
></toast-notification>
