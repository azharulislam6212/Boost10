{% doc %}
  Lays out the product page.

  @param {string} section_id
  @param {object} section_settings - `section.settings`. Named this way because a parameter called `settings` would shadow the global theme settings inside this snippet
  @param {string} media_gallery - Captured `_product-media-gallery`
  @param {string} product_details - Captured `_product-details`
  @param {string} [additional_blocks] - Captured `{% content_for 'blocks' %}`
  @param {number} [media_count] - Used to pick a sensible gallery column width
  @param {string} [class]
  @param {object} [section]

  @example
    {% render 'product-main-content',
       section_id: section.id, section_settings: section.settings,
       media_gallery: media_gallery, product_details: product_details %}
{% enddoc %}

{%- liquid
  assign media_column = '1fr'
  if media_count == 1
    assign media_column = '0.9fr'
  endif
-%}

<div
  class="main-product color-scheme-container color-{{ section_settings.color_scheme }} {{ class }}"
  data-section-id="{{ section_id }}"
  data-product-root
  {% render 'spacing', section: section_settings %}
>
  <div class="{% render 'container', width: section.settings.container_width %}">
    <div class="main-product__layout" style="--media-column: {{ media_column }};">
      <div class="main-product__media">
        {{ media_gallery }}
      </div>

      <div class="main-product__info">
        {{ product_details }}
      </div>
    </div>

    {%- if additional_blocks != blank -%}
      <div class="main-product__blocks">
        {{ additional_blocks }}
      </div>
    {%- endif -%}
  </div>
</div>
