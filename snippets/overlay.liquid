{% doc %}
  A tint laid over background media.

  @param {string} [style] - solid | gradient. Default solid.
  @param {string} [color] - For `solid`.
  @param {string} [gradient] - A `color_background` value, for `gradient`.
  @param {number} [opacity] - 0–100. Default 40.
  @param {string} [classes] - Extra classes.

  @example
    {% render 'overlay',
       style: block.settings.overlay_style,
       color: block.settings.overlay_color,
       gradient: block.settings.overlay_gradient,
       opacity: block.settings.overlay_opacity %}
{% enddoc %}

{%- liquid
  assign overlay_style = style | default: 'solid'

  # Clamped and coerced, so a stored value outside the current schema range
  # cannot emit `opacity: 140` — which is not invalid CSS, merely ignored, and
  # then the overlay is silently missing.
  assign overlay_opacity = opacity | default: 40 | plus: 0
  if overlay_opacity < 0
    assign overlay_opacity = 0
  endif
  if overlay_opacity > 100
    assign overlay_opacity = 100
  endif
  assign alpha = overlay_opacity | divided_by: 100.0

  if overlay_style == 'gradient'
    assign paint = gradient | default: ''
  else
    assign paint = color | default: ''
  endif
-%}

{%- if paint != '' and alpha > 0 -%}
  <div
    class="background-overlay {{ classes }}"
    style="--overlay-paint: {{ paint }}; --overlay-opacity: {{ alpha }};"
    aria-hidden="true"
  ></div>
{%- endif -%}
