{% doc %}
  A background video that fills its container.

  @param {string} [video] - A Shopify-hosted video
  @param {string} [video_url] - A YouTube or Vimeo URL
  @param {image} [image] - Poster override
  @param {image} [mobile_image] - Poster art direction below 767px
  @param {string} [position] - cover | contain. Default cover.
  @param {boolean} [loop] - Default true.
  @param {string} [classes] - Extra classes on the wrapper.

  @example
    {% render 'background-video', video: block.settings.video,
       video_url: block.settings.video_url,
       position: 'cover' %}
{% enddoc %}

{%- liquid
  assign fit = position | default: 'cover'

  assign should_loop = loop
  if should_loop == nil
    assign should_loop = true
  endif

  # Truthiness for the object, `''` for the string. nil is falsy in every Liquid
  # engine; `nil != blank` is not consistently false in all of them, and that
  # difference decides whether a merchant with only a YouTube URL gets an iframe
  # or an empty `<video>`.
  assign hosted = false
  if video
    assign hosted = true
  endif

  assign external = video_url | default: ''

  assign has_video = false
  if hosted or external != ''
    assign has_video = true
  endif

  # Only reach into `video` once it is known to exist.
  if image
    assign poster = image
  elsif hosted
    assign poster = video.preview_image
  endif
-%}

{%- if has_video -%}
  <background-video
    class="background-media__layer background-media__layer--{{ fit }} background-media__video {{ classes }}"
    data-fit="{{ fit }}"
  >
    {%- if poster -%}
      <div class="background-media__poster" data-ref="poster">
        {% render 'image',
           image: poster,
           mobile_image: mobile_image,
           alt: '',
           ratio: 'none',
           sizes: '100vw',
           mobile_sizes: '100vw',
           class: 'background-media__image' %}
      </div>
    {%- endif -%}

    <template data-ref="template">
      {%- if hosted -%}

        {{ video
           | video_tag:
               autoplay: true,
               loop: should_loop,
               muted: true,
               controls: false,
               playsinline: true,
               preload: 'none',
               image_size: '1920x',
               class: 'background-media__el' }}
      {%- else -%}

        {{ video_url
           | external_video_url:
               autoplay: true,
               loop: should_loop,
               muted: true,
               controls: false,
               playsinline: true,
               modestbranding: true,
               rel: 0
           | external_video_tag:
               class: 'background-media__el',
               loading: 'lazy',
               title: '' }}
      {%- endif -%}
    </template>
  </background-video>
{%- endif -%}
