 {% style %}
      @layer reset, tokens, base, layout, components, utilities;

      @layer tokens {
        :root {
          /* ---- layout ---------------------------------------------------------
             Only two numbers come from theme settings: the side padding, and
             the custom width if the merchant asked for one.

             Compact, Standard and Wide are constants in `assets/base.css`, not
             sliders. A merchant setting three widths independently can put them
             in the wrong order — Wide narrower than Standard — and every section
             using them silently disagrees with its own label. Three fixed steps
             plus one Custom escape hatch is the same flexibility without that
             failure mode. */
          --container-custom-width: {{ settings.container_custom_width | default: 1280 }}px;

          --container-gutter: {{ settings.container_gutter | default: 20 }}px;
          --container-gutter-desktop: {{ settings.container_gutter_desktop | default: 40 }}px;

          /* ---- grid gaps ----------------------------------------------------
             `grid_horizontal_space` and `grid_vertical_space` have been in the
             schema all along with nothing reading them, so both sliders moved a
             value that changed no pixels. They drive the gaps now.

             Mobile scales rather than taking its own pair of sliders: a
             merchant who wants 16px on desktop almost never wants 16px on a
             390px screen, and two more numbers to keep in proportion is a worse
             control than one percentage. */
          --grid-gap-x-base: {{ settings.grid_horizontal_space | default: 16 }}px;
          --grid-gap-y-base: {{ settings.grid_vertical_space | default: 32 }}px;
          --grid-gap-scale-mobile: {{ settings.grid_space_scale_mobile | default: 75 | divided_by: 100.0 }};
          --grid-gap-x: var(--grid-gap-x-base);
          --grid-gap-y: var(--grid-gap-y-base);

            --grid-gap-horizontal: var(--grid-gap-x);
            --grid-gap-vertical: var(--grid-gap-y);

          /* Was declared in the schema and read nowhere, so "Space between
             sections" did nothing. `base.css` already had the rule waiting. */
          --section-gap: {{ settings.spacing_sections | default: 0 }}px;
            --duration-drawer: 300ms;
            --shadow-header: 0 1px 3px rgb(0 0 0 / 0.08);
            --card-border-style: solid;
            --color-star: {{ settings.color_star | default: '#f6b01e' }};


          --radius-card: {{ settings.card_radius | default: 8 }}px;
          --radius-media: {{ settings.media_radius | default: 0 }}px;
          --radius-badge: {{ settings.badge_radius | default: 40 }}px;
          --radius-drawer: {{ settings.drawer_radius | default: 0 }}px;

         
 
          --buttons-border-thickness: {{ settings.buttons_corner_thickness | default: settings.buttons_border_thickness | default: 1 }}px;
          --inputs-border-thickness: {{ settings.input_fields_corner_thickness | default: settings.inputs_border_thickness | default: 1 }}px;
          --card-border-thickness: {{ settings.card_border_thickness | default: 0 }}px;

          --radius-button: {{ settings.buttons_corner_radius | default: settings.buttons_radius | default: 4 }}px;
          --radius-input: {{ settings.input_fields_corner_radius | default: settings.inputs_radius | default: 4 }}px;

          --height-button: {{ settings.buttons_height | default: 44 }}px;
          --height-button-small: calc(var(--height-button) * 0.78);
          --height-button-large: calc(var(--height-button) * 1.22);

          --height-input: {{ settings.input_fields_height | default: 46 }}px;
          --height-input-small: calc(var(--height-input) * 0.78);
          --height-input-large: calc(var(--height-input) * 1.22);

          --duration-fast: 150ms;
          --duration-base: 250ms;
          --duration-slow: 450ms;
          --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
          --ease-in-out-quart: cubic-bezier(0.76, 0, 0.24, 1);

          --z-base: 0;
          --z-sticky: 100;
          --z-header: 200;
          --z-backdrop: 300;
          --z-drawer: 400;
          --z-modal: 500;
          --z-zoom: 600;
          --z-toast: 700;
          --z-skip-link: 900;

          --header-height: 0px;
          --announcement-height: 0px;
          --scrollbar-width: 0px;
          --viewport-height: 100vh;

             /* ---- icon sizes ---------------------------------------------------- */

            /* rem, not px — an icon sitting beside text should scale with that text when
            a customer raises their browser font size. */
            --icon-size-sm: {{ icon_sm | divided_by: 16.0 }}rem;
            --icon-size-md: {{ icon_md | divided_by: 16.0 }}rem;
            --icon-size-lg: {{ icon_lg | divided_by: 16.0 }}rem;
            --icon-size: var(--icon-size-md);




        }

        @media screen and (max-width: 749px) {
          :root {
            --grid-gap-x: calc(var(--grid-gap-x-base) * var(--grid-gap-scale-mobile));
            --grid-gap-y: calc(var(--grid-gap-y-base) * var(--grid-gap-scale-mobile));
          }
        }

        @supports (height: 100dvh) {
          :root { --viewport-height: 100dvh; }
        }
      }

      @layer reset {
        *,
        *::before,
        *::after { box-sizing: border-box; }

        html {
          font-size: 62.5%;
          -webkit-text-size-adjust: 100%;
          text-size-adjust: 100%;
          scroll-behavior: smooth;
        }

        body,
        h1, h2, h3, h4, h5, h6,
        p, figure, blockquote, dl, dd { margin: 0; }

        ul[role='list'],
        ol[role='list'] { list-style: none; margin: 0; padding: 0; }

        img, picture, video, canvas, svg {
          display: block;
          max-width: 100%;
        }

        img { height: auto; }

        input, button, textarea, select {
          font: inherit;
          color: inherit;
        }

        button { background: none; border: 0; cursor: pointer; }

        a { color: inherit; }

        summary { cursor: pointer; list-style: none; }
        summary::-webkit-details-marker { display: none; }

        :focus-visible {
          outline: 2px solid var(--color-link, currentColor);
          outline-offset: 3px;
          border-radius: 2px;
        }

        :focus:not(:focus-visible) { outline: none; }

        /* Lenis structural requirements. Without these the library cannot
           take over the document scroller. */
        html.lenis,
        html.lenis body { height: auto; }

        .lenis.lenis-smooth { scroll-behavior: auto !important; }
        .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
        .lenis.lenis-stopped { overflow: hidden; }
        .lenis.lenis-smooth iframe { pointer-events: none; }

        @media (prefers-reduced-motion: reduce) {
          html { scroll-behavior: auto; }
          *,
          *::before,
          *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
          }
        }
      }

      @layer base {

        body {
          margin: 0;
          min-block-size: var(--viewport-height, 100vh);
          display: flex;
          flex-direction: column;
          font-family: var(--font-paragraph-family, var(--font-body-family));
          font-style: var(--font-paragraph-style, var(--font-body-style));
          font-weight: var(--font-paragraph-weight, var(--font-body-weight));
          font-size: var(--font-paragraph-size-current, 1.5rem);
          line-height: var(--font-paragraph-line-height, 1.6);
          letter-spacing: var(--font-paragraph-tracking, 0em);
          text-transform: var(--font-paragraph-transform, none);
          color: var(--color-text);
          background-color: var(--color-background);
          background-image: var(--gradient-background);
          -webkit-font-smoothing: antialiased;
          overflow-wrap: break-word;
        }
        /* Custom elements are inline by default, which would collapse any
           layout wrapper built on one. */
        motion-effect,
        smooth-scrollbar,
        page-transition { display: block; }

        smooth-scrollbar[data-disabled] { display: none; }
        motion-effect[data-effect='marquee'] { overflow: hidden; }

        /* Accordion groups that only collapse below a breakpoint. Above it the
           summary is decoration: no marker, no pointer, no hover affordance. */
        accordion-element[data-static] summary,
        summary[data-static] {
          cursor: default;
          pointer-events: none;
          list-style: none;
        }

        accordion-element[data-static] summary::-webkit-details-marker,
        summary[data-static]::-webkit-details-marker { display: none; }

        accordion-element[data-static] .footer__summary-icon { display: none; }

        /* Responsive image boxes. The ratio is reserved before the image loads,
           and art-directed images can change shape at the breakpoint without the
           box jumping when the source swaps. */
        responsive-image {
          display: block;
          position: relative;
          aspect-ratio: var(--aspect-ratio, 1);
          overflow: hidden;
        }

        responsive-image__picture,
        responsive-image .responsive-image__picture { display: contents; }

        responsive-image img {
          inline-size: 100%;
          block-size: 100%;
          object-fit: cover;
          opacity: 0;
          transition: opacity var(--duration-base) var(--ease-out-expo);
        }

        responsive-image[data-loaded] img,
        html.no-js responsive-image img { opacity: 1; }

        @media screen and (max-width: 767px) {
          responsive-image { aspect-ratio: var(--aspect-ratio-mobile, var(--aspect-ratio, 1)); }
        }

        h1, h2, h3, h4, h5, h6 {
          color: var(--color, --color-heading);
         text-wrap: balance;
        }
      }

      @layer layout {
        .layout__main {
          flex: 1 0 auto;
          display: block;
        }

        /* `.container` is defined once, in `assets/base.css`.

           It used to be defined here as well, with `max-width:
           var(--container-max)`. Two definitions of one class is bad enough;
           the `max-width` made it a real bug. `max-width` and `max-inline-size`
           are the same property, so once the width variants moved to padding —
           and base.css stopped declaring a cap — this copy was the only
           declaration left standing, and it capped every container at the
           standard width. A section set to Compact or Wide got a 1440px box no
           matter which variant it asked for, which is exactly what a DevTools
           badge reading `1440 × 46.4` on a `.container--compact` was reporting.

           base.css is a render-blocking `<link>` emitted immediately below
           this block, so nothing paints before it arrives and there is no
           flash to protect against. */

        /* Section and block spacing.
           Values arrive as custom properties from snippets/spacing.liquid. The
           media query reads a different property rather than a different rule,
           so one inline style drives both breakpoints. */
        [data-section-spacing] {
          padding-block-start: var(--section-padding-block-start, 0px);
          padding-block-end: var(--section-padding-block-end, 0px);
        }

        [data-block-spacing] {
          padding-block-start: var(--block-padding-block-start, 0px);
          padding-inline-end: var(--block-padding-inline-end, 0px);
          padding-block-end: var(--block-padding-block-end, 0px);
          padding-inline-start: var(--block-padding-inline-start, 0px);
        }

        @media screen and (max-width: 749px) {
          [data-section-spacing] {
            padding-block-start: var(--section-padding-block-start-mobile, var(--section-padding-block-start, 0px));
            padding-block-end: var(--section-padding-block-end-mobile, var(--section-padding-block-end, 0px));
          }

          [data-block-spacing] {
            padding-block-start: calc(var(--block-padding-block-start, 0px) * var(--block-padding-scale-mobile, 0.75));
            padding-inline-end: calc(var(--block-padding-inline-end, 0px) * var(--block-padding-scale-mobile, 0.75));
            padding-block-end: calc(var(--block-padding-block-end, 0px) * var(--block-padding-scale-mobile, 0.75));
            padding-inline-start: calc(var(--block-padding-inline-start, 0px) * var(--block-padding-scale-mobile, 0.75));
          }
        }
      }

      @layer components {
        .skip-to-content-link {
          position: absolute;
          inset-block-start: 0;
          inset-inline-start: 0;
          z-index: var(--z-skip-link);
          display: inline-block;
          padding: 1.2rem 2rem;
          background-color: var(--color-primary-button-background);
          color: var(--color-primary-button-text);
          text-decoration: none;
          transform: translateY(-101%);
        }

        .skip-to-content-link:focus {
          transform: translateY(0);
        }

        .media-loader {
          position: absolute;
          inset: 0;
          background-color: rgba(var(--color-text-rgb, 0 0 0) / 0.04);
          pointer-events: none;
          opacity: 1;
          transition: opacity var(--duration-base) var(--ease-out-expo);
        }
      }

      @layer utilities {
        .visually-hidden {
          position: absolute !important;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0 0 0 0);
          clip-path: inset(50%);
          white-space: nowrap;
          border: 0;
        }

        .visually-hidden:focus-within,
        .visually-hidden.is-revealed {
          position: static !important;
          width: auto;
          height: auto;
          margin: 0;
          overflow: visible;
          clip: auto;
          clip-path: none;
          white-space: normal;
        }

        html.no-js .no-js-hidden { display: none !important; }
        html:not(.no-js) .js-hidden { display: none !important; }
        [hidden] { display: none !important; }
      }
    {% endstyle %}
