{% doc %}
  A promotional tile that sits inside the product grid.

  It is an `<li>` in the same list as the product cards, spanning one or two
  columns. Not an overlay, not a row above the grid — an in-grid card is the only
  placement that survives filtering, sorting and pagination without leaving a gap
  where a product used to be.

  It carries no `data-product-id`, which is what keeps it out of every count:
  `<results-list>` counts items by `data-item-selector`, so the promo never
  inflates "showing 24 of 120" and is never mistaken for a loaded page.

  Position is expressed as a card index. On page two of a paginated collection the
  section decides whether to render it again — repeating a promo on every page is
  a decision, not a default.

  @param {object} block - Settings from a promo block or section

  @example
    {% render 'collection-promo-card', block: block %}
{% enddoc %}

{%- liquid
  assign has_image = false
  if block.settings.image != blank
    assign has_image = true
  endif
-%}

<li
  class="promo-card promo-card--{{ block.settings.span }}-col
    {%- if block.settings.color_scheme != blank %} color-scheme-container color-{{ block.settings.color_scheme }}{% endif -%}"
  data-promo-card
  {{ block.shopify_attributes }}
>
  <div class="promo-card__inner promo-card__inner--{{ block.settings.alignment }}">
    {%- if has_image -%}
      {% render 'image',
         image: block.settings.image,
         mobile_image: block.settings.image_mobile,
         alt: '',
         ratio: block.settings.image_ratio,
         sizes: '(min-width: 990px) 33vw, 50vw',
         wrapper_class: 'promo-card__media' %}
    {%- endif -%}

    <div class="promo-card__content">
      {%- if block.settings.overline != blank -%}
        <p class="promo-card__overline">{{ block.settings.overline }}</p>
      {%- endif -%}

      {%- if block.settings.heading != blank -%}
        <h3 class="promo-card__heading">{{ block.settings.heading }}</h3>
      {%- endif -%}

      {%- if block.settings.text != blank -%}
        <div class="promo-card__text rte">{{ block.settings.text }}</div>
      {%- endif -%}

      {%- if block.settings.label != blank and block.settings.link != blank -%}
        {%- comment -%}
          A real link with its own label, not a stretched overlay across the whole
          tile: a promo sitting between products should not swallow clicks aimed
          at the card beside it.
        {%- endcomment -%}
        {% render 'button',
           label: block.settings.label,
           href: block.settings.link,
           variant: block.settings.button_style,
           size: 'small' %}
      {%- endif -%}
    </div>
  </div>
</li>
