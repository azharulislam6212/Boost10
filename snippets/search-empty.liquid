{% doc %}
  The "nothing matched" state, in one place.

  @param {string} [context] - 'panel' inside predictive search, 'filters' for a filtered grid, 'search' for a search page with no results, 'collection' for a collection with no products at all. Default 'filters'
  @param {string} [terms] - The query, echoed back in the panel variant
  @param {string} [url] - Where the reset link goes. Defaults to clearing filters

  @example
    {% render 'search-empty', context: 'panel', terms: predictive_search.terms %}
    {% render 'search-empty', context: 'filters' %}
{% enddoc %}

{%- liquid
  assign variant = context | default: 'filters'

  case variant
    when 'panel'
      assign empty_title = 'search.empty.title' | t
      assign empty_text = 'search.empty.text' | t
    when 'search'
      assign empty_title = 'search.empty.page_title' | t
      assign empty_text = 'search.empty.page_text' | t
    when 'collection'
      assign empty_title = 'collections.empty.title' | t
      assign empty_text = 'collections.empty.text' | t
    else
      assign empty_title = 'products.facets.empty_title' | t
      assign empty_text = 'products.facets.empty_text' | t
  endcase

  assign reset_url = url
  if variant == 'collection'
    assign reset_url = routes.all_products_collection_url
  endif
  if reset_url == blank
    if variant == 'search'
      assign reset_url = routes.search_url
    else
      assign reset_url = collection.url | default: routes.all_products_collection_url
    endif
  endif

  assign reset_label = 'products.facets.clear_all_filters' | t
  if variant == 'collection'
    assign reset_label = 'collections.empty.action' | t
  endif
-%}

<div class="search-empty search-empty--{{ variant }}">
  <span class="search-empty__icon" aria-hidden="true">
    {% render 'icon', icon: 'filter-off', size: 32 %}
  </span>

  <p class="search-empty__title">
    {%- if variant == 'panel' and terms != blank -%}
      {{ 'search.empty.title_for' | t: terms: terms }}
    {%- else -%}
      {{ empty_title }}
    {%- endif -%}
  </p>

  <p class="search-empty__text">{{ empty_text }}</p>

  {%- if variant == 'panel' -%}
    {%- if terms != blank -%}

      {%- capture panel_url -%}
        {{ routes.search_url }}?q={{ terms | url_encode }}&options%5Bprefix%5D=last
      {%- endcapture -%}

      {%- liquid
        assign panel_url = panel_url | strip
        assign panel_label = 'search.empty.action' | t
      -%}

      {% render 'button',
         label: panel_label,
         href: panel_url,
         variant: 'primary',
         size: 'small',
         icon: 'arrow-right',
         icon_style: 'solid',
         class: 'search-empty__action' %}
    {%- endif -%}
  {%- else -%}
    {% render 'button',
       label: reset_label,
       href: reset_url,
       variant: 'primary',
       size: 'medium',
       icon: 'arrow-right',
       icon_style: 'solid',
       class: 'search-empty__action' %}
  {%- endif -%}
</div>
