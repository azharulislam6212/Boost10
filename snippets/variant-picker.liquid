{% doc %}
  Renders the variant selector.

  @param {product} product
  @param {object} section
  @param {boolean} [update_url] - Default true
  @param {string} [swatches_type] - theme | native | none. Product-page override; falls back to the theme setting
  @param {string} [swatch_shape] - circle | round | portrait
  @param {string} [options_picker_type] - buttons | dropdowns
  @param {string} [size_options_picker_type] - buttons | dropdowns, applied to size-like options only
  @param {object} [current]
  @param {string} [form_id]
  @param {boolean} [is_size_option]
  @param {boolean} [no_script] - Default true. Set false on a surface that only exists because JavaScript ran.
  @param {string} [resolved_shape]
  @param {string} [this_picker]

  @example
    {% render 'variant-picker', product: product, section: section %}
{% enddoc %}

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign swatch_names = settings.swatch_option_names | default: 'Colour, Color' | downcase | split: ','

  unless form_id
    assign form_id = section.id | append: '-product-form'
  endunless

  assign resolved_swatch_type = swatches_type
  if resolved_swatch_type == blank
    assign resolved_swatch_type = settings.swatches_type | default: 'theme'
  endif

  assign resolved_shape = swatch_shape | default: settings.swatch_shape | default: 'circle'
  assign picker_type = options_picker_type | default: 'buttons'
  assign size_picker_type = size_options_picker_type | default: 'buttons'
-%}

<variant-picker
  class="variant-picker"
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
  data-update-url="{{ update_url | default: true }}"
>
  <script type="application/json" data-variants>
    {{- product.variants | json -}}
  </script>

  {%- for option in product.options_with_values -%}
    {%- liquid
      assign option_key = option.name | downcase | strip

      assign is_size_option = false
      if option_key contains 'size' or option_key contains 'length' or option_key contains 'fit'
        assign is_size_option = true
      endif

      assign is_swatch = false
      if resolved_swatch_type != 'none'
        for name in swatch_names
          assign swatch_name = name | strip
          if swatch_name == option_key
            assign is_swatch = true
            break
          endif
        endfor
      endif

      assign this_picker = picker_type
      if is_size_option
        assign this_picker = size_picker_type
      endif
      if is_swatch
        assign this_picker = 'swatches'
      endif
    -%}

    <fieldset
      class="variant-picker__option{% if is_swatch %} variant-picker__option--swatch{% endif %}"
      data-option-index="{{ option.position }}"
      data-option-name="{{ option.name | escape }}"
    >
      <legend class="variant-picker__legend">
        <span class="variant-picker__label">{{ option.name }}</span>
        <span class="variant-picker__selected" data-selected-value>{{ option.selected_value }}</span>
      </legend>

      {%- if is_size_option -%}
        {% render 'size-chart-modal', product: product, option_name: option.name, id: section.id %}
      {%- endif -%}

      {%- if this_picker == 'swatches' -%}

        {% render 'advanced-swatches',
           product: product,
           option: option,
           section: section,
           form_id: form_id,
           shape: resolved_shape %}

      {%- elsif this_picker == 'dropdowns' -%}

        {%- assign select_id = section.id | append: '-select-' | append: option.position -%}
        <label class="visually-hidden" for="{{ select_id }}">{{ option.name }}</label>
        <div class="variant-picker__dropdown">
          <select
            id="{{ select_id }}"
            class="variant-picker__select"
            name="{{ option.name | escape }}"
            form="{{ form_id }}"
          >
            {%- for value in option.values -%}
              <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                {{ value }}
              </option>
            {%- endfor -%}
          </select>
          {% render 'icon', icon: 'chevron-down', size: 16 %}
        </div>

      {%- else -%}
        <div class="variant-picker__values">
          {%- for value in option.values -%}
            {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
            <div class="variant-picker__value">
              <input
                type="radio"
                class="visually-hidden"
                id="{{ input_id }}"
                name="{{ option.name | escape }}"
                value="{{ value | escape }}"
                form="{{ form_id }}"
                {% if option.selected_value == value %}checked{% endif %}
              >
              <label class="variant-picker__swatch-label" for="{{ input_id }}">
                <span>{{ value }}</span>
              </label>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </fieldset>
  {%- endfor -%}

  {%- unless no_script == false -%}
    <noscript>
      <label class="visually-hidden" for="{{ section.id }}-variant-select">{{ 'products.variants.legend' | t }}</label>
      <select
        id="{{ section.id }}-variant-select"
        name="id"
        form="{{ form_id }}"
      >
        {%- for variant in product.variants -%}
          <option
            value="{{ variant.id }}"
            {% if variant == current %}selected{% endif %}
            {% unless variant.available %}disabled{% endunless %}
          >
            {{ variant.title }} &ndash; {{ variant.price | money }}
          </option>
        {%- endfor -%}
      </select>
    </noscript>
  {%- endunless -%}

  <input type="hidden" name="id" value="{{ current.id }}" form="{{ form_id }}" data-ref="idInput">
</variant-picker>

{% render 'pickup-availability', variant: current %}
