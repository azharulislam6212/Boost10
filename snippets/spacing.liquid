{% doc %}
  Emits padding as custom properties, for a section or for a block.

  @param {object} [section] - A section settings object
  @param {object} [block] - A block settings object
  @param {boolean} [declarations] - Return properties only, no `style=` and no `data-*` hook. Defaults to false.

  @example
    <div {% render 'spacing', block: block.settings %}>

  @example
    <section {% render 'spacing', section: section.settings %}>
{% enddoc %}

{%- liquid
  assign section_is_global = false
  if section.settings
    assign section_is_global = true
  endif

  assign is_section = false
  assign is_block = false

  if block
    assign is_block = true
  elsif section and section_is_global == false
    assign is_section = true
  endif

  assign b = block

  assign out = ''

  if is_section
    assign s_top = section.padding_top | default: 0 | plus: 0
    assign s_bottom = section.padding_bottom | default: 0 | plus: 0
    assign s_top_mobile = section.padding_top_mobile | default: 0 | plus: 0
    assign s_bottom_mobile = section.padding_bottom_mobile | default: 0 | plus: 0

    assign has_s_top = false
    if section.padding_top
      assign has_s_top = true
    endif
    assign has_s_bottom = false
    if section.padding_bottom
      assign has_s_bottom = true
    endif

    if has_s_top
      assign out = out | append: '--section-padding-block-start:' | append: s_top | append: 'px;'
    endif
    if has_s_bottom
      assign out = out | append: '--section-padding-block-end:' | append: s_bottom | append: 'px;'
    endif

    if s_top_mobile > 0
      assign out = out | append: '--section-padding-block-start-mobile:' | append: s_top_mobile | append: 'px;'
    endif
    if s_bottom_mobile > 0
      assign out = out | append: '--section-padding-block-end-mobile:' | append: s_bottom_mobile | append: 'px;'
    endif
  endif

  if is_block
    assign b_top = b.padding_top | default: b['padding-block-start'] | default: 0 | plus: 0
    assign b_bottom = b.padding_bottom | default: b['padding-block-end'] | default: 0 | plus: 0
    assign b_left = b.padding_left | default: b['padding-inline-start'] | default: 0 | plus: 0
    assign b_right = b.padding_right | default: b['padding-inline-end'] | default: 0 | plus: 0
    assign b_scale = b.padding_scale_mobile | default: 0 | plus: 0

    assign has_b_top = false
    if b.padding_top or b['padding-block-start']
      assign has_b_top = true
    endif
    assign has_b_bottom = false
    if b.padding_bottom or b['padding-block-end']
      assign has_b_bottom = true
    endif
    assign has_b_left = false
    if b.padding_left or b['padding-inline-start']
      assign has_b_left = true
    endif
    assign has_b_right = false
    if b.padding_right or b['padding-inline-end']
      assign has_b_right = true
    endif

    if has_b_top
      assign out = out | append: '--block-padding-block-start:' | append: b_top | append: 'px;'
    endif
    if has_b_bottom
      assign out = out | append: '--block-padding-block-end:' | append: b_bottom | append: 'px;'
    endif
    if has_b_left
      assign out = out | append: '--block-padding-inline-start:' | append: b_left | append: 'px;'
    endif
    if has_b_right
      assign out = out | append: '--block-padding-inline-end:' | append: b_right | append: 'px;'
    endif

    assign b_top_mobile = b.padding_top_mobile | default: 0 | plus: 0
    assign b_bottom_mobile = b.padding_bottom_mobile | default: 0 | plus: 0
    assign b_left_mobile = b.padding_left_mobile | default: 0 | plus: 0
    assign b_right_mobile = b.padding_right_mobile | default: 0 | plus: 0

    assign has_b_top_mobile = false
    if b.padding_top_mobile
      assign has_b_top_mobile = true
    endif
    assign has_b_bottom_mobile = false
    if b.padding_bottom_mobile
      assign has_b_bottom_mobile = true
    endif
    assign has_b_left_mobile = false
    if b.padding_left_mobile
      assign has_b_left_mobile = true
    endif
    assign has_b_right_mobile = false
    if b.padding_right_mobile
      assign has_b_right_mobile = true
    endif

    if has_b_top_mobile
      assign out = out | append: '--block-padding-block-start-mobile:' | append: b_top_mobile | append: 'px;'
    endif
    if has_b_bottom_mobile
      assign out = out | append: '--block-padding-block-end-mobile:' | append: b_bottom_mobile | append: 'px;'
    endif
    if has_b_left_mobile
      assign out = out | append: '--block-padding-inline-start-mobile:' | append: b_left_mobile | append: 'px;'
    endif
    if has_b_right_mobile
      assign out = out | append: '--block-padding-inline-end-mobile:' | append: b_right_mobile | append: 'px;'
    endif

    if b_scale > 0
      assign scale = b_scale | divided_by: 100.0
      assign out = out | append: '--block-padding-scale-mobile:' | append: scale | append: ';'
    endif
  endif
-%}

{%- if declarations -%}
  {{- out -}}
{%- else -%}
  {%- if is_section -%}data-section-spacing {% endif -%}
  {%- if is_block -%}data-block-spacing {% endif -%}
  {%- if out != blank %}style="{{ out }}"{% endif -%}
{%- endif -%}
