{% doc %}
  Design tokens emitted once in document head. All values from theme settings only.

  ## Critical Facts

  1. **No runtime presets** — All settings always visible. Presets go in `settings_data.json`.
  2. **Pixels → rem** — Stored px (merchant), emitted rem (user browser font). Keep `/ 10` + `html { font-size: 62.5% }` synced.
  3. **Responsive swap** — `-current` tokens switch mobile/desktop at 750px.
  4. **Two line-height scales** — Body (1.15/1.6/1.9) ≠ Headings (1.1/1.3/1.6).
  5. **Style follows family** — `--font-paragraph-style` changes with family, not role.

  @example
    {% render 'css-variables' %}
{% enddoc %}

{%- liquid
  assign body_font = settings.type_body_font
  assign heading_font = settings.type_header_font
  assign accent_font = settings.type_accent_font | default: settings.type_header_font

  # ---- Role values, read straight from Theme settings ----------------------
  # The `| default:` on each line is the floor for a setting with no schema
  # default, not a second source of truth. If a value here disagrees with
  # settings_schema.json, the schema wins and this line is stale.

  assign p_font = settings.type_paragraph_font | default: 'body'
  assign p_weight = settings.type_paragraph_weight | default: 400
  assign p_size = settings.type_paragraph_size | default: 16
  assign p_size_mobile = settings.type_paragraph_size_mobile | default: 15
  assign p_case = settings.type_paragraph_case | default: 'none'

  assign d_font = settings.type_default_font | default: 'body'
  assign d_weight = settings.type_default_weight | default: 400
  assign d_size = settings.type_default_size | default: 14
  assign d_size_mobile = settings.type_default_size_mobile | default: 14
  assign d_case = settings.type_default_case | default: 'none'

  assign menu_font = settings.type_menu_font | default: 'body'
  assign menu_weight = settings.type_menu_weight | default: 500
  assign menu_size = settings.type_menu_size | default: 15
  assign menu_case = settings.type_menu_case | default: 'none'

  assign btn_font = settings.type_button_font | default: 'body'
  assign btn_weight = settings.type_button_weight | default: 500
  assign btn_size = settings.type_button_size | default: 15
  assign btn_case = settings.type_button_case | default: 'none'

  # ---- Named line heights and tracking ------------------------------------
  # Merchants choose words; CSS needs numbers. Doing the translation here means
  # the schema never asks anyone what 1.15 looks like.

  assign line_map_tight = 1.15
  assign line_map_normal = 1.6
  assign line_map_loose = 1.9

  # Headings need their own scale. The body values were being reused for all six
  # levels, which put a "Normal" h4 at 1.6 — base.css's own fallback for that
  # same variable is 1.3, so the stylesheet and the token disagreed by a wide
  # margin on every heading a merchant left at the default. Large type needs
  # less leading than body copy, not the same amount.
  #
  # These three land exactly on the fallbacks base.css already declares: 1.1 for
  # h1-h3 (default "Tight") and 1.3 for h4-h6 (default "Normal").
  assign head_line_tight = 1.1
  assign head_line_normal = 1.3
  assign head_line_loose = 1.6

  assign track_map_tight = '-0.02em'
  assign track_map_normal = '0em'
  assign track_map_wide = '0.06em'

  # Paragraph
  case settings.type_paragraph_line
    when 'tight'
      assign p_line = line_map_tight
    when 'loose'
      assign p_line = line_map_loose
    else
      assign p_line = line_map_normal
  endcase
  case settings.type_paragraph_track
    when 'tight'
      assign p_track = track_map_tight
    when 'wide'
      assign p_track = track_map_wide
    else
      assign p_track = track_map_normal
  endcase

  # Default text.
  #
  # `type_default_line` and `type_default_track` are both in the schema and
  # neither was ever read here: the line height was pinned to a literal 1.5 and
  # the tracking had no variable at all. Two controls a merchant could move all
  # day with nothing happening on the page.
  case settings.type_default_line
    when 'tight'
      assign d_line = line_map_tight
    when 'loose'
      assign d_line = line_map_loose
    else
      assign d_line = line_map_normal
  endcase
  case settings.type_default_track
    when 'tight'
      assign d_track = track_map_tight
    when 'wide'
      assign d_track = track_map_wide
    else
      assign d_track = track_map_normal
  endcase

  # Menu
  case settings.type_menu_track
    when 'tight'
      assign menu_track = track_map_tight
    when 'wide'
      assign menu_track = track_map_wide
    else
      assign menu_track = track_map_normal
  endcase

  # Button
  case settings.type_button_track
    when 'tight'
      assign btn_track = track_map_tight
    when 'wide'
      assign btn_track = track_map_wide
    else
      assign btn_track = track_map_normal
  endcase
-%}

<style>
  @layer tokens {
    :root {
      /* ---- families ---- */
      --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
      --font-body-style: {{ body_font.style }};
      --font-body-weight: {{ body_font.weight }};

      --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --font-heading-style: {{ heading_font.style }};
      --font-heading-weight: {{ heading_font.weight }};

      --font-accent-family: {{ accent_font.family }}, {{ accent_font.fallback_families }};
      --font-accent-style: {{ accent_font.style }};
      --font-accent-weight: {{ accent_font.weight }};

      /* ---- weight scale ---- */
      --font-weight-light: 300;
      --font-weight-normal: 400;
      --font-weight-medium: 500;
      --font-weight-semibold: 600;
      --font-weight-bold: 700;

      /* Body bold, relative to whatever weight the merchant picked. Clamped at
         900 because 1000 is not a weight any Shopify font ships. */
      --font-body-weight-bold: {{ body_font.weight | plus: 300 | at_most: 900 }};

      /* ---- paragraph ---- */
      --font-paragraph-family: var(--font-{{ p_font }}-family);
      --font-paragraph-style: var(--font-{{ p_font }}-style);
      --font-paragraph-size: {{ p_size | divided_by: 10.0 }}rem;
      --font-paragraph-size-mobile: {{ p_size_mobile | divided_by: 10.0 }}rem;
      --font-paragraph-size-current: var(--font-paragraph-size-mobile);
      --font-paragraph-weight: {% if p_weight == 'inherit' %}inherit{% else %}{{ p_weight }}{% endif %};
      --font-paragraph-line-height: {{ p_line }};
      --font-paragraph-tracking: {{ p_track }};
      --font-paragraph-transform: {{ p_case }};

      /* ---- default text: captions, labels, badges, prices ---- */
      --font-default-family: var(--font-{{ d_font }}-family);
      --font-default-style: var(--font-{{ d_font }}-style);
      --font-default-size: {{ d_size | divided_by: 10.0 }}rem;
      --font-default-size-mobile: {{ d_size_mobile | divided_by: 10.0 }}rem;
      --font-default-size-current: var(--font-default-size-mobile);
      --font-default-weight: {% if d_weight == 'inherit' %}inherit{% else %}{{ d_weight }}{% endif %};
      --font-default-line-height: {{ d_line }};
      --font-default-tracking: {{ d_track }};
      --font-default-transform: {{ d_case }};

      /* ---- headings ---- */
      {%- assign levels = '1,2,3,4,5,6' | split: ',' -%}
      {%- for level in levels -%}
        {%- liquid
          case level
            when '1'
              assign fallback_size = 72
              assign fallback_mobile = 40
              assign fallback_weight = 700
              assign fallback_line = 'tight'
            when '2'
              assign fallback_size = 48
              assign fallback_mobile = 32
              assign fallback_weight = 700
              assign fallback_line = 'tight'
            when '3'
              assign fallback_size = 32
              assign fallback_mobile = 24
              assign fallback_weight = 700
              assign fallback_line = 'tight'
            when '4'
              assign fallback_size = 24
              assign fallback_mobile = 20
              assign fallback_weight = 600
              assign fallback_line = 'normal'
            when '5'
              assign fallback_size = 20
              assign fallback_mobile = 18
              assign fallback_weight = 600
              assign fallback_line = 'normal'
            else
              assign fallback_size = 18
              assign fallback_mobile = 16
              assign fallback_weight = 600
              assign fallback_line = 'normal'
          endcase

          assign key = 'type_h' | append: level
          assign font_key = key | append: '_font'
          assign weight_key = key | append: '_weight'
          assign case_key = key | append: '_case'
          assign size_key = key | append: '_size'
          assign size_mobile_key = key | append: '_size_mobile'
          assign line_key = key | append: '_line'
          assign track_key = key | append: '_track'

          assign level_font = settings[font_key] | default: 'heading'
          assign level_weight = settings[weight_key] | default: fallback_weight
          assign level_case = settings[case_key] | default: 'none'
          assign size = settings[size_key] | default: fallback_size
          assign size_mobile = settings[size_mobile_key] | default: fallback_mobile

          assign level_line_setting = settings[line_key] | default: fallback_line
          case level_line_setting
            when 'tight'
              assign level_line = head_line_tight
            when 'loose'
              assign level_line = head_line_loose
            else
              assign level_line = head_line_normal
          endcase

          case settings[track_key]
            when 'tight'
              assign level_track = track_map_tight
            when 'wide'
              assign level_track = track_map_wide
            else
              assign level_track = track_map_normal
          endcase
        -%}
        --font-h{{ level }}-family: var(--font-{{ level_font }}-family);
        --font-h{{ level }}-style: var(--font-{{ level_font }}-style);
        --font-h{{ level }}-size: {{ size | divided_by: 10.0 }}rem;
        --font-h{{ level }}-size-mobile: {{ size_mobile | divided_by: 10.0 }}rem;
        --font-h{{ level }}-weight: {% if level_weight == 'inherit' %}inherit{% else %}{{ level_weight }}{% endif %};
        --font-h{{ level }}-line-height: {{ level_line }};
        --font-h{{ level }}-tracking: {{ level_track }};
        --font-h{{ level }}-transform: {{ level_case }};
      {%- endfor -%}

      /* ---- menu ---- */
      --font-menu-family: var(--font-{{ menu_font }}-family);
      --font-menu-style: var(--font-{{ menu_font }}-style);
      --font-menu-size: {{ menu_size | divided_by: 10.0 }}rem;
      --font-menu-weight: {% if menu_weight == 'inherit' %}inherit{% else %}{{ menu_weight }}{% endif %};
      --font-menu-tracking: {{ menu_track }};
      --font-menu-transform: {{ menu_case }};

      /* ---- buttons ---- */
      --font-button-family: var(--font-{{ btn_font }}-family);
      --font-button-style: var(--font-{{ btn_font }}-style);
      --font-button-size: {{ btn_size | divided_by: 10.0 }}rem;
      --font-button-weight: {% if btn_weight == 'inherit' %}inherit{% else %}{{ btn_weight }}{% endif %};
      --font-button-tracking: {{ btn_track }};
      --font-button-transform: {{ btn_case }};

      /* ---- custom elements: card titles, badges, countdowns, prices ---- */
      --font-custom-weight: {% if settings.type_custom_weight == 'inherit' or settings.type_custom_weight == blank %}inherit{% else %}{{ settings.type_custom_weight }}{% endif %};
      --font-custom-size: {{ settings.type_custom_size | default: 16 | divided_by: 10.0 }}rem;

      {%- case settings.type_custom_color -%}
        {%- when 'subtext' -%}
          --font-custom-color: var(--color-accent-text);
        {%- when 'heading' -%}
          --font-custom-color: var(--color-heading);
        {%- when 'gradient' -%}
          --font-custom-color: transparent;
          --font-custom-gradient: var(--gradient-{{ settings.type_custom_gradient | default: 'primary' }});
        {%- else -%}
          --font-custom-color: var(--color-text);
      {%- endcase -%}

      /* ---- names the rest of the theme already reads ----
         `--font-size-base` follows the responsive paragraph token rather than
         the desktop one, so the two components that read it shrink on mobile
         with everything else. */
      --font-size-base: var(--font-paragraph-size-current);
      --font-size-xs: {{ d_size | minus: 2 | at_least: 10 | divided_by: 10.0 }}rem;
      --font-size-sm: {{ d_size | divided_by: 10.0 }}rem;
      --font-size-md: {{ p_size | divided_by: 10.0 }}rem;
      --font-size-lg: {{ p_size | plus: 2 | divided_by: 10.0 }}rem;

      --font-size-h1: var(--font-h1-size-mobile);
      --font-size-h2: var(--font-h2-size-mobile);
      --font-size-h3: var(--font-h3-size-mobile);
      --font-size-h4: var(--font-h4-size-mobile);
      --font-size-h5: var(--font-h5-size-mobile);
      --font-size-h6: var(--font-h6-size-mobile);
    }
 
    @media screen and (min-width: 750px) {
      :root {
        --font-paragraph-size-current: var(--font-paragraph-size);
        --font-default-size-current: var(--font-default-size);
        --font-size-h1: var(--font-h1-size);
        --font-size-h2: var(--font-h2-size);
        --font-size-h3: var(--font-h3-size);
        --font-size-h4: var(--font-h4-size);
        --font-size-h5: var(--font-h5-size);
        --font-size-h6: var(--font-h6-size);
      }
    }
  }
</style>
