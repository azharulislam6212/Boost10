{% doc %}
  Builds the `data-options` JSON that `<carousel-slider>` reads.

  @param {object} settings - Section or block settings
  @param {number} [count] - Slide count. Enables the loop guard. columns_desktop / columns_tablet / columns_mobile (number)
  @param {string} [pagination] - none | dots | numbers | progress | controls
  @param {boolean} [autoplay] - Overrides `settings.carousel_autoplay`
  @param {boolean} [loop] - Overrides `settings.carousel_loop` peek_mobile / peek_desktop (number)  Partial-slide percentage. See `carousel-slides`, which owns the arithmetic.
  @param {number} [space_between] - Gap between slides in px. Omit to let the component read the grid's own `--grid-gap-x`, which is what every section wants; pass `0` for a full-bleed strip such as the product card's image slider.
  @param {string} [extra] - Raw JSON fragment, **without** a leading or trailing comma. Joined like every other fragment.
  @param {string} [columns_desktop]
  @param {string} [columns_mobile]
  @param {string} [columns_tablet]
  @param {string} [peek_desktop]
  @param {string} [peek_mobile]
  @param {string} [direction] - horizontal | vertical. Default horizontal.

  @example
    <carousel-slider data-options="{% render 'carousel-options', settings: section.settings, count: 5 %}">

  @example
    {% render 'carousel-options', settings: section.settings, direction: 'vertical', columns_desktop: 3 %}
{% enddoc %}

{%- capture spv_mobile -%}
  {%- render 'carousel-slides', settings: settings, viewport: 'mobile',
      columns_mobile: columns_mobile,
      peek_mobile: peek_mobile, peek_desktop: peek_desktop -%}
{%- endcapture -%}
{%- capture spv_tablet -%}
  {%- render 'carousel-slides', settings: settings, viewport: 'tablet',
      columns_tablet: columns_tablet,
      peek_mobile: peek_mobile, peek_desktop: peek_desktop -%}
{%- endcapture -%}
{%- capture spv_desktop -%}
  {%- render 'carousel-slides', settings: settings, viewport: 'desktop',
      columns_desktop: columns_desktop,
      peek_mobile: peek_mobile, peek_desktop: peek_desktop -%}
{%- endcapture -%}

{%- liquid
  assign spv_mobile = spv_mobile | strip
  assign spv_tablet = spv_tablet | strip
  assign spv_desktop = spv_desktop | strip

  # The loop guard counts whole slides. `ceil`, not `floor`: a peek means part of
  # a further slide is on screen and it still has to exist on the far side of the
  # seam, so a 2.3-slide carousel needs six slides to loop. `assets/carousel.js`
  # rounds the same way, from the value CSS resolved.
  assign cols_desktop = spv_desktop | plus: 0 | ceil

  # Milliseconds, clamped rather than trusted. A stored value can predate the
  # current schema: the announcement bar used to declare this setting in
  # seconds, so live stores hold a `carousel_speed` of 3–12 that would become a
  # transition no customer could see. Anything under 20 is read as
  # one of those and falls back to the default rather than being clamped to a
  # 100ms flick.
  assign raw_speed = settings.carousel_speed | default: 500 | plus: 0
  if raw_speed < 20
    assign raw_speed = 500
  endif
  assign speed = raw_speed | at_least: 100 | at_most: 3000

  # Seconds in the editor, milliseconds in the component. Converting here means
  # neither the merchant nor the component has to know about the other.
  assign delay_seconds = settings.carousel_autoplay_delay | default: 5 | at_least: 1
  assign delay = delay_seconds | times: 1000

  assign use_autoplay = autoplay
  if use_autoplay == nil
    assign use_autoplay = settings.carousel_autoplay
  endif

  assign use_loop = loop
  if use_loop == nil
    assign use_loop = settings.carousel_loop
  endif

  # The loop guard. `count` is optional, so a caller that cannot count its
  # slides — a section passing content_for 'blocks' straight through — keeps
  # the merchant's setting and lets the component make the call at runtime, from
  # the slide set it can actually see.
  # `| default: 0 | plus: 0` is what makes the comparison safe when the caller
  # omitted `count`: an unset variable compared with `<` is a type error in a
  # strict Liquid engine, and silently false in a lenient one. Coercing to a
  # number first means the guard is simply skipped instead.
  assign use_rewind = false

  assign slide_count = count | default: 0 | plus: 0
  if use_loop and slide_count > 0
    assign loop_minimum = cols_desktop | times: 2
    if slide_count < loop_minimum
      assign use_loop = false

      # Rewind rather than nothing. The merchant asked to get back to the first
      # slide from the last; looping is one way to do that and rewind is the
      # other, and refusing the setting outright would leave the carousel
      # stopping dead at the end with the box still ticked. This is the same
      # fallback `assets/carousel.js` applies when it cannot count slides here.
      assign use_rewind = true
    endif
  endif

  assign pagination_style = pagination | default: settings.carousel_pagination | default: 'none'
  case pagination_style
    when 'numbers'
      assign pagination_type = 'fraction'
    when 'progress'
      assign pagination_type = 'progressbar'
    when 'dots'
      assign pagination_type = 'bullets'
    else
      assign pagination_type = blank
  endcase
-%}

{%- liquid
  assign is_vertical = false
  if direction == 'vertical'
    assign is_vertical = true
  endif

  assign group_mobile = spv_mobile | plus: 0 | ceil | at_least: 1
  assign group_tablet = spv_tablet | plus: 0 | ceil | at_least: 1
  assign group_desktop = spv_desktop | plus: 0 | ceil | at_least: 1
-%}

{%- if is_vertical -%}
  {%- capture fragment_slides -%}
"direction":"vertical","slidesPerView":{{ spv_mobile }},"slidesPerGroup":{{ group_mobile }},"breakpoints":{"750":{"slidesPerView":{{ spv_tablet }},"slidesPerGroup":{{ group_tablet }}},"990":{"slidesPerView":{{ spv_desktop }},"slidesPerGroup":{{ group_desktop }}}}
  {%- endcapture -%}
{%- else -%}
  {%- capture fragment_slides -%}
"slidesPerView":{{ spv_mobile }},"breakpoints":{"750":{"slidesPerView":{{ spv_tablet }}},"990":{"slidesPerView":{{ spv_desktop }}}}
  {%- endcapture -%}
{%- endif -%}

{%- capture fragment_motion -%}
"speed":{{ speed }},"loop":{{ use_loop | default: false | json }},"rewind":{{ use_rewind | json }}
{%- endcapture -%}

{%- assign fragments = fragment_slides | append: '|' | append: fragment_motion -%}

{%- assign gap = space_between | default: -1 | plus: 0 -%}
{%- if gap >= 0 -%}
  {%- assign fragments = fragments | append: '|"spaceBetween":' | append: gap -%}
{%- endif -%}

{%- if use_autoplay -%}
  {%- capture fragment_autoplay -%}
"autoplay":{"delay":{{ delay }},"disableOnInteraction":true,"pauseOnMouseEnter":true}
  {%- endcapture -%}
  {%- assign fragments = fragments | append: '|' | append: fragment_autoplay -%}
{%- endif -%}

{%- if pagination_type != blank -%}
  {%- capture fragment_pagination -%}
"pagination":{"type":{{ pagination_type | json }}}
  {%- endcapture -%}
  {%- assign fragments = fragments | append: '|' | append: fragment_pagination -%}
{%- endif -%}

{%- assign extra_clean = extra | strip | remove_first: ',' | strip -%}
{%- if extra_clean != blank -%}
  {%- assign fragments = fragments | append: '|' | append: extra_clean -%}
{%- endif -%}

{%- capture options_json -%}
{
{{- fragments | split: '|' | join: ',' -}}
}
{%- endcapture -%}
{{- options_json | strip_newlines | strip | escape -}}
