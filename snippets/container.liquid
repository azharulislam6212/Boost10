{% doc %}
  The class list for a section container.

  @param {string} [width] - edge | wide | standard | compact | custom. Falls back to `settings.layout_width`.
  @param {string} [classes] - Extra classes to append.

  @example
    <div class="{% render 'container', width: section.settings.container_width %}">

  @example
    <div class="{% render 'container', classes: 'header__inner' %}">
{% enddoc %}

{%- liquid
  assign resolved = width | default: settings.layout_width | default: 'standard'

  case resolved
    when 'edge'
      assign width_class = 'container container--edge'
    when 'wide'
      assign width_class = 'container container--wide'
    when 'compact'
      assign width_class = 'container container--compact'
    when 'custom'
      assign width_class = 'container container--custom'
    when 'flush'
      assign width_class = 'container container--flush'
    else
      assign width_class = 'container container--standard'
  endcase

  assign out = width_class
  if classes != blank
    assign out = out | append: ' ' | append: classes
  endif
-%}
{{- out -}}
