<div
  class="block-group block-group--{{ settings.direction }} block-group--{{ settings.alignment }}
    {%- if settings.color_scheme != blank %} color-{{ settings.color_scheme }}{% endif -%}"
  style="
    --group-gap: {{ settings.gap }}px;
    {%- if settings.width != 'full' %}--group-width: {{ settings.max_width }}px;{% endif -%}"
  {% render 'spacing', block: settings %}
  {{ shopify_attributes }}
>
  {{- children -}}
</div>

