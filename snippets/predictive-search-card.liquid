{% doc %}
  One row in the predictive search panel.

  @param {string} type - 'product' | 'collection' | 'article' | 'page'
  @param {object} item - The resource, straight from `predictive_search.resources`
  @param {string} id - Id prefix for the option. Must be unique per group
  @param {number} index - Position within the group, for the option id
  @param {boolean} [selectable] - Default true. Pass false outside the combobox popup, where `role="option"` would be invalid ARIA

  @example
    {% render 'predictive-search-card', type: 'product', item: product,
       id: 'PredictiveProduct-', index: forloop.index %}
{% enddoc %}

{%- liquid
  assign option_id = id | append: index

  assign is_selectable = true
  if selectable == false
    assign is_selectable = false
  endif

  assign image = nil
  assign meta = ''
  assign title = item.title

  case type
    when 'product'
      assign variant = item.selected_or_first_available_variant
      assign image = item.featured_media.preview_image

      assign meta_parts = ''
      if settings.show_vendor and item.vendor != blank
        assign meta_parts = item.vendor
      elsif item.type != blank
        assign meta_parts = item.type
      endif

      assign variant_label = ''
      if variant.title != blank and variant.title != 'Default Title'
        assign variant_label = variant.title
      endif

      if meta_parts != blank and variant_label != blank
        assign meta = meta_parts | append: ' • ' | append: variant_label
      else
        assign meta = meta_parts | append: variant_label
      endif

      assign card_price = item.price
      assign card_compare = item.compare_at_price

      assign on_sale = false
      if card_compare != blank and card_compare > card_price
        assign on_sale = true
        assign saved_amount = card_compare | minus: card_price
        assign saved_percent = saved_amount | times: 100.0 | divided_by: card_compare | round
      endif

    when 'collection'
      assign image = item.featured_image
      if image == blank
        assign image = item.products.first.featured_media.preview_image
      endif
      assign meta = 'search.collection_count' | t: count: item.all_products_count

    when 'article'
      assign image = item.image
      if item.published_at != blank
        assign meta = item.published_at | date: format: 'date'
      endif
      if item.author != blank and meta != blank
        assign meta = item.author | append: ' • ' | append: meta
      elsif item.author != blank
        assign meta = item.author
      endif

    else
      assign meta = item.content | strip_html | truncatewords: 14
  endcase
-%}

<li
  id="{{ option_id }}"
  class="search-card-item"
  {% if is_selectable %}role="option" aria-selected="false" data-result{% endif %}
  data-result-type="{{ type }}"
  data-url="{{ item.url }}"
>
  <a class="search-card search-card--{{ type }}" href="{{ item.url }}">
    <span class="search-card__media" aria-hidden="true">
      {%- if image != blank -%}
        {% render 'image',
           image: image,
           ratio: '1-1',
           sizes: '72px',
           widths: '72,144,216',
           class: 'search-card__image',
           wrapper_class: 'search-card__image-wrapper' %}
      {%- else -%}
        {%- liquid
          case type
            when 'article'
              assign fallback_icon = 'edit'
            when 'collection'
              assign fallback_icon = 'grid'
            else
              assign fallback_icon = 'note'
          endcase
        -%}
        <span class="search-card__glyph">
          {% render 'icon', icon: fallback_icon, size: 22 %}
        </span>
      {%- endif -%}
    </span>

    <span class="search-card__body">
      <span class="search-card__title">{{ title }}</span>

      {%- if meta != blank -%}
        <span class="search-card__meta">{{ meta }}</span>
      {%- endif -%}

      {%- if type == 'product' -%}
        <span class="search-card__footer">
          <span class="search-card__price">
            <span class="search-card__price-current{% if on_sale %} search-card__price-current--sale{% endif %}">
              {%- if item.price_varies -%}
                {%- assign card_price_display = card_price | money -%}
                {{- 'products.product.from_price_html' | t: price: card_price_display -}}
              {%- else -%}
                {{- card_price | money -}}
              {%- endif -%}
            </span>
            {%- if on_sale -%}
              <s class="search-card__price-was">{{ card_compare | money }}</s>
            {%- endif -%}
          </span>

          {%- if settings.show_rating -%}
            {% render 'rating', product: item, show_count: false, class: 'search-card__rating' %}
          {%- endif -%}
        </span>
      {%- endif -%}
    </span>

    {%- if type == 'product' and on_sale -%}
      <span class="badge badge--sale search-card__badge">
        {{- 'products.product.save_percent' | t: percent: saved_percent -}}
      </span>
    {%- endif -%}
  </a>
</li>
