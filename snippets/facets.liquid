{% doc %}
  Renders the filter and sort form.

  @param {object} results - `collection` or `search`.
  @param {object} section
  @param {string} [context] - sidebar | drawer. Default sidebar.

  @example
    {% render 'facets', results: collection, section: section %}
{% enddoc %}

{%- liquid
  assign layout = context | default: 'sidebar'
  assign sort_options = results.sort_options
  assign current_sort = results.sort_by | default: results.default_sort_by
-%}

<facet-filters
  class="facets facets--{{ layout }}"
  data-section-id="{{ section.id }}"
  data-results="ProductGrid-{{ section.id }}"
>
  <form data-ref="form" class="facets__form">

    {%- if results.terms -%}
      <input type="hidden" name="q" value="{{ results.terms | escape }}">
      <input type="hidden" name="options[prefix]" value="last">
      {%- if results.types.size > 0 -%}
        <input type="hidden" name="type" value="{{ results.types | join: ',' }}">
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.enable_sorting and sort_options.size > 0 -%}
      <details class="facets__group facets__sort" data-morph-key="sort_by" open>
        <summary class="facets__summary">
          <span class="facets__group-label">{{ 'products.facets.sort_by_label' | t }}</span>
          <span class="facets__group-toggle" aria-hidden="true">{% render 'icon', icon: 'chevron-down', size: 12 %}</span>
        </summary>

        <div class="facets__group-content">
          <fieldset class="facets__sort-options">
            <legend class="visually-hidden">{{ 'products.facets.sort_by_label' | t }}</legend>
            <ul class="facets__values facets__values--rows" role="list">
              {%- for option in sort_options -%}
                <li class="facets__value">
                  <label class="facets__checkbox facets__radio">
                    <input
                      type="radio"
                      name="sort_by"
                      value="{{ option.value }}"
                      {% if option.value == current_sort %}checked{% endif %}
                    >
                    <span class="facets__value-label">{{ option.name }}</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          </fieldset>
        </div>
      </details>
    {%- endif -%}

    {%- if section.settings.enable_filtering -%}

      {% render 'facets-guard', results: results, context: layout %}
    {%- endif -%}

    <noscript>
      <button type="submit" class="button button--primary">{{ 'products.facets.apply' | t }}</button>
    </noscript>
  </form>

  <div class="facets__active" data-ref="active">
    {%- for filter in results.filters -%}
      {%- for value in filter.active_values -%}
        {%- assign value_prefix = value.value | slice: 0, 2 -%}
        {%- if value_prefix == '__' -%}{%- continue -%}{%- endif -%}
        <button
          type="button"
          class="facets__pill"
          data-remove-filter
          data-filter-name="{{ value.param_name }}"
          data-filter-value="{{ value.value | escape }}"
        >
          {{ filter.label }}: {{ value.label }}
          <span class="visually-hidden">{{ 'products.facets.remove_filter' | t: filter: value.label }}</span>
          {% render 'icon', icon: 'close', size: 12 %}
        </button>
      {%- endfor -%}
    {%- endfor -%}
  </div>

  <button type="button" class="facets__clear" data-ref="clear" hidden>
    {{ 'products.facets.clear_all' | t }}
  </button>
</facet-filters>
