{% doc %}
  Maps the shared carousel settings onto the data attributes `SwiperCarousel`
  reads.

  Kept separate from `carousel-shell` so a section with hand-written carousel
  markup — the announcement bar, the product gallery — can adopt the same
  settings without adopting the shell's layout.

  The attribute names are the component's existing contract (`data-autoplay`,
  `data-autoplay-speed`, `data-loop`); nothing here renames them.

  Parameters:
    settings (object, required)  A section or block settings object

  @example
    <swiper-carousel {% render 'carousel-attrs', settings: section.settings %}>
{% enddoc %}

{%- liquid
  assign autoplay = settings.carousel_autoplay | default: false

  # Seconds in the editor, milliseconds in the DOM. A merchant thinks "five
  # seconds"; the component schedules in milliseconds. Converting here means
  # neither has to know about the other.
  assign speed = settings.carousel_speed | default: 5
  assign speed_ms = speed | times: 1000

  assign loop = settings.carousel_loop | default: false
-%}

data-autoplay="{{ autoplay }}"
data-autoplay-speed="{{ speed_ms }}"
data-loop="{{ loop }}"
