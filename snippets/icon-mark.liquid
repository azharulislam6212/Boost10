{% doc %}
  The **Icon / Shape / Ring** vocabulary, resolved in one place for every block
  that offers it.

  @param {object} block - The block's settings hash (`block.settings`)
  @param {boolean} [declarations] - Return the custom properties rather than the ring
  @param {number} [offset] - Ring inset in px
  @param {number} [dash_gap] - Gap between dashes of a dashed ring

  @example
    {%- capture mark -%}{% render 'icon-mark', block: s, declarations: true %}{%- endcapture -%}
    <span class="utility-item__icon icon-mark" style="{{ mark }}">
      {% render 'icon-mark', block: s %}
      {% render 'icon', icon: s.icon, size: icon_size %}
    </span>
{% enddoc %}

{%- liquid
  assign m = block

  assign frame_style = m.icon_frame_style | default: 'none'
  assign frame_size = m.icon_frame_size | default: 56 | plus: 0
  assign frame_radius_pct = m.icon_frame_radius | default: 50 | plus: 0

  assign frame_shape = ''
  if frame_style != 'none'
    if frame_radius_pct >= 50
      assign frame_shape = 'circle'
    else
      assign frame_shape = 'square'
    endif
  endif
  assign frame_radius_px = frame_size | times: frame_radius_pct | divided_by: 100

  assign shape = m.shape | default: 'none'

  assign from_frame = false
  if shape == 'none' and frame_shape != ''
    assign from_frame = true
    assign shape = frame_shape
  endif

  assign shape_chosen = false
  if shape != 'none'
    assign shape_chosen = true
  endif

  if from_frame
    assign shape_size = frame_size
    assign shape_size_mobile = frame_size
  else
    assign shape_size = m.shape_size | default: 86 | plus: 0
    assign shape_size_mobile = m.shape_size_mobile | default: shape_size | plus: 0
  endif

  if shape == 'circle'
    assign shape_radius = shape_size
  elsif from_frame
    assign shape_radius = frame_radius_px
  else
    assign shape_radius = m.shape_radius | default: 16 | plus: 0
  endif

  assign ring_style = m.ring_style | default: 'none'
  if from_frame
    assign ring_style = frame_style
  endif

  assign has_ring = false
  if ring_style != 'none' and shape != 'none'
    assign has_ring = true
  endif

  if from_frame
    assign ring_width = m.icon_frame_width | default: 1 | plus: 0
    assign ring_offset = 0
  else
    assign ring_width = m.ring_width | default: 2 | plus: 0
    assign ring_offset = offset | default: 0 | plus: 0
  endif

  assign ring_size = shape_size

  assign ring_half = ring_size | divided_by: 2.0
  assign ring_radius = ring_size | minus: ring_width | divided_by: 2.0
  assign ring_inset = ring_width | divided_by: 2.0
  assign ring_box = ring_size | minus: ring_width

  assign ring_dash = ''
  assign ring_cap = 'butt'
  if ring_style == 'dashed'
    assign dash_on = 2
    assign dash_off = dash_gap | default: 8 | plus: 0
    assign ring_dash = dash_on | append: ' ' | append: dash_off
  elsif ring_style == 'dotted'
    assign dash_off = ring_width | times: 2
    assign ring_dash = '0.01 ' | append: dash_off
    assign ring_cap = 'round'
  endif

  if from_frame
    assign fill_paint = m.icon_frame_background
    assign fill_hover_paint = ''
    assign ring_paint = m.icon_frame_color
  else
    assign fill_paint = m.fill_color
    assign fill_hover_paint = m.fill_hover_color
    assign ring_paint = m.ring_color
  endif
-%}

{%- if declarations -%}

  {%- if shape_chosen and shape != 'none' -%}
    --icon-mark-size-desktop:{{ shape_size }}px;
    --icon-mark-size-mobile:{{ shape_size_mobile }}px;
    --icon-mark-radius:{{ shape_radius }}px;
    {%- if fill_paint != blank -%}--icon-mark-fill:{{ fill_paint }};{%- endif -%}
    {%- if fill_hover_paint != blank -%}--icon-mark-fill-hover:{{ fill_hover_paint }};{%- endif -%}
  {%- endif -%}
  {%- if m.icon_color != blank -%}--icon-mark-color:{{ m.icon_color }};{%- endif -%}
  {%- if m.icon_hover_color != blank -%}--icon-mark-color-hover:{{ m.icon_hover_color }};{%- endif -%}
  {%- if has_ring -%}
    {%- if ring_paint != blank -%}--icon-mark-ring-color:{{ ring_paint }};{%- endif -%}
  {%- endif -%}

  {%- if has_ring and ring_offset > 0 -%}--icon-mark-inset:{{ ring_offset }}px;{%- endif -%}
{%- elsif has_ring -%}

  <svg
    class="icon-mark__ring"
    width="{{ ring_size }}"
    height="{{ ring_size }}"
    viewBox="0 0 {{ ring_size }} {{ ring_size }}"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    {%- if shape == 'square' -%}
      <rect
        x="{{ ring_inset }}"
        y="{{ ring_inset }}"
        width="{{ ring_box }}"
        height="{{ ring_box }}"
        rx="{{ shape_radius }}"
        stroke="currentColor"
        stroke-width="{{ ring_width }}"
        stroke-linecap="{{ ring_cap }}"
        {% if ring_dash != blank %}stroke-dasharray="{{ ring_dash }}"{% endif %}
      />
    {%- else -%}
      <circle
        cx="{{ ring_half }}"
        cy="{{ ring_half }}"
        r="{{ ring_radius }}"
        stroke="currentColor"
        stroke-width="{{ ring_width }}"
        stroke-linecap="{{ ring_cap }}"
        {% if ring_dash != blank %}stroke-dasharray="{{ ring_dash }}"{% endif %}
      />
    {%- endif -%}
  </svg>
{%- endif -%}
