{% doc %}
  The desktop navigation.

  ## Every item with children is a `<details>`

  Not a `<button>` plus a `data-open` attribute. The browser then owns the
  open/closed semantics, the Enter and Space handling and the "this control
  expands something" announcement, and the menu still opens on click before
  `header.js` has finished downloading — which matters, because navigation is
  usually the first thing a customer touches.

  `<nav-menu>` intercepts the click to run the animation and to add hover
  intent, but everything it does is an enhancement over markup that already
  worked.

  ## Two kinds of panel, one mechanism

  A top-level link with children gets a dropdown built from those links. If a
  `mega-menu` block names the same item, `<nav-menu>` swaps that dropdown for
  the block's panel at runtime. The dropdown is therefore both the fallback and
  the no-JavaScript experience, and a merchant who has not built a panel yet
  still gets a working menu rather than an empty box.

  Blocks are matched on the item's *title*, not its index, because reordering
  the navigation in the Shopify admin would otherwise move every panel to the
  wrong menu — a failure that looks like a caching bug rather than a settings
  problem. Renaming an item detaches its block, which is visible and
  recoverable; reordering silently corrupting every panel is neither.

  Parameters:
    menu (linklist, required)

  @example
    {% render 'header-nav', menu: section.settings.menu %}
{% enddoc %}

{%- liquid
  assign st = section.settings
  assign menu_font = 'var(--font-body-family)'
  if st.menu_font == 'heading'
    assign menu_font = 'var(--font-heading-family)'
  elsif st.menu_font == 'accent'
    assign menu_font = 'var(--font-accent-family, var(--font-heading-family))'
  endif
-%}

<nav-menu
  class="site-header__nav"
  data-trigger="{{ st.menu_trigger }}"
  data-marker="{{ st.menu_marker }}"
  style="--nav-font: {{ menu_font }}; --nav-size: {{ st.menu_size }}px; --nav-case: {% if st.menu_case == 'uppercase' %}uppercase{% else %}none{% endif %};"
>
  <nav aria-label="{{ 'sections.header.menu' | t }}">
    <ul class="nav" role="list">
      {%- for link in menu.links -%}
        {%- liquid
          assign link_title = link.title | strip

          # Find a mega menu block whose `menu_item` names this link.
          # Matched on a normalised title: trimmed and lowercased on both sides.
          #
          # `<nav-menu>` already matches this way when it moves the panel into
          # place, but this comparison did not — so a block whose Menu item read
          # "Catalog " or "catalog" produced no `<details>` at all, and the panel
          # then had nothing to be moved into. The console said the panel had no
          # matching menu item, which was true, and misleading: the item was
          # there, the two comparisons simply disagreed.
          #
          # Typing a name is not the place to demand exactness. Both ends are
          # lenient now, and they are lenient in the same way.
          # `mega_menu_items` is built by `sections/header.liquid` from the
          # rendered panels themselves, and passed in.
          #
          # This used to loop `section.blocks` here and never matched anything:
          # the mega menus are theme blocks rendered through `content_for`, and
          # that collection does not return them. So an item whose panel came
          # from a block, rather than from child links in Navigation, fell
          # through to a plain link - and `nav-menu` had to convert it into a
          # disclosure after the page had loaded. Which worked, and was wrong:
          # the conversion adds a chevron the server never sent, so the item
          # widens, the navigation re-centres, and the menu slides sideways on
          # every load.
          #
          # Both panel types are covered, because both write `data-menu-item`.
          # `mega-menu` is the canvas you arrange blocks on; `mega-menu-simple`
          # is the menu-plus-banners one. A menu item does not care which built
          # its panel.
          #
          # `escape` because the attribute was written escaped, `downcase`
          # because typing a name is not the place to demand exact case, and the
          # pipes because "Sale" must not match inside "Sale Items".
          assign link_key = link_title | escape | downcase
          assign link_lookup = '|' | append: link_key | append: '|'

          assign has_mega = false
          if mega_menu_items contains link_lookup
            assign has_mega = true
          endif

          # A matched panel is enough on its own.
          #
          # An item with no children in Navigation used to fall through to a
          # plain link, and the panel then had no disclosure to be moved into —
          # so the mega menu never appeared, and on the items where Liquid did
          # build one the fallback dropdown was an empty box.
          #
          # The panel decides. Children only matter for items that have no block.
          assign has_panel = false
          if has_mega or link.links.size > 0
            assign has_panel = true
          endif

          assign panel_kind = 'dropdown'
          if has_mega
            assign panel_kind = 'mega'
          endif
        -%}

        <li class="nav__item{% if has_panel %} nav__item--parent{% endif %}">
          {%- if has_panel -%}
            <details
              class="nav__details"
              data-nav-details
              data-kind="{{ panel_kind }}"
              data-menu-item="{{ link_title | escape }}"
            >
              <summary
                class="nav__link"
                data-nav-summary
                aria-expanded="false"
                {% if link.active or link.child_active %}data-current="true"{% endif %}
              >
                <span class="nav__label">{{ link.title }}</span>
                {% render 'icon', icon: 'chevron-down', size: 12, class: 'nav__chevron' %}
              </summary>

              <div class="nav__panel nav__panel--{{ panel_kind }}" data-nav-panel>
                <div class="nav__panel-inner">
                  {%- comment -%}
                    Rendered only when this item has no panel block. With one, the
                    component replaces this element wholesale, and building a
                    dropdown here first meant a flash of the wrong menu on slow
                    connections — or, for an item with no children, an empty box
                    that never got replaced.
                  {%- endcomment -%}
                  {%- unless has_mega -%}
                    {% render 'nav-dropdown', link: link %}
                  {%- endunless -%}
                </div>
              </div>
            </details>
          {%- else -%}
            <a
              class="nav__link"
              href="{{ link.url }}"
              {% if link.active %}aria-current="page" data-current="true"{% endif %}
            >
              <span class="nav__label">{{ link.title }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</nav-menu>
