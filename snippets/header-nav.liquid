{% doc %}
  The desktop navigation.

  ## Every item with children is a `<details>`

  Not a `<button>` plus a `data-open` attribute. The browser then owns the
  open/closed semantics, the Enter and Space handling and the "this control
  expands something" announcement, and the menu still opens on click before
  `header.js` has finished downloading — which matters, because navigation is
  usually the first thing a customer touches.

  `<nav-menu>` intercepts the click to run the animation and to add hover
  intent, but everything it does is an enhancement over markup that already
  worked.

  ## Two kinds of panel, one mechanism

  A top-level link with children gets a dropdown built from those links. If a
  `mega-menu` block names the same item, `<nav-menu>` swaps that dropdown for
  the block's panel at runtime. The dropdown is therefore both the fallback and
  the no-JavaScript experience, and a merchant who has not built a panel yet
  still gets a working menu rather than an empty box.

  Blocks are matched on the item's *title*, not its index, because reordering
  the navigation in the Shopify admin would otherwise move every panel to the
  wrong menu — a failure that looks like a caching bug rather than a settings
  problem. Renaming an item detaches its block, which is visible and
  recoverable; reordering silently corrupting every panel is neither.

  Parameters:
    menu (linklist, required)

  @example
    {% render 'header-nav', menu: section.settings.menu %}
{% enddoc %}

{%- liquid
  assign st = section.settings
  assign menu_font = 'var(--font-body-family)'
  if st.menu_font == 'heading'
    assign menu_font = 'var(--font-heading-family)'
  elsif st.menu_font == 'accent'
    assign menu_font = 'var(--font-accent-family, var(--font-heading-family))'
  endif
-%}

<nav-menu
  class="site-header__nav"
  data-trigger="{{ st.menu_trigger }}"
  data-marker="{{ st.menu_marker }}"
  style="--nav-font: {{ menu_font }}; --nav-size: {{ st.menu_size }}px; --nav-case: {% if st.menu_case == 'uppercase' %}uppercase{% else %}none{% endif %};"
>
  <nav aria-label="{{ 'sections.header.menu' | t }}">
    <ul class="nav" role="list">
      {%- for link in menu.links -%}
        {%- liquid
          assign link_title = link.title | strip

          # Find a mega menu block whose `menu_item` names this link.
          assign mega_block = null
          for candidate in section.blocks
            if candidate.type != 'mega-menu'
              continue
            endif
            assign candidate_item = candidate.settings.menu_item | strip
            if candidate_item == link_title
              assign mega_block = candidate
              break
            endif
          endfor

          assign has_panel = false
          if link.links.size > 0 or mega_block != null
            assign has_panel = true
          endif

          assign panel_kind = 'dropdown'
          if mega_block != null
            assign panel_kind = 'mega'
          endif
        -%}

        <li class="nav__item{% if has_panel %} nav__item--parent{% endif %}">
          {%- if has_panel -%}
            <details
              class="nav__details"
              data-nav-details
              data-kind="{{ panel_kind }}"
              data-menu-item="{{ link_title | escape }}"
            >
              <summary
                class="nav__link"
                data-nav-summary
                aria-expanded="false"
                {% if link.active or link.child_active %}data-current="true"{% endif %}
              >
                <span class="nav__label">{{ link.title }}</span>
                {% render 'icon', icon: 'chevron-down', size: 12, class: 'nav__chevron' %}
              </summary>

              <div class="nav__panel nav__panel--{{ panel_kind }}" data-nav-panel>
                <div class="nav__panel-inner">
                  {% render 'nav-dropdown', link: link %}
                </div>
              </div>
            </details>
          {%- else -%}
            <a
              class="nav__link"
              href="{{ link.url }}"
              {% if link.active %}aria-current="page" data-current="true"{% endif %}
            >
              <span class="nav__label">{{ link.title }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</nav-menu>
