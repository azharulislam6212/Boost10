{% doc %}
  The shipping estimator, shared by the cart page and the cart drawer.

  @param {string} id - Unique per instance, e.g. 'drawer' or 'page'
  @param {boolean} [heading] - Render the title. Default true

  @example
    {% render 'shipping-calculator', id: 'drawer' %}
{% enddoc %}

{%- liquid
  assign instance = id | default: 'page'
  assign show_heading = heading
  if heading == nil
    assign show_heading = true
  endif
-%}

<shipping-calculator class="shipping-calculator">
  {%- if show_heading -%}
    <h2 class="shipping-calculator__title">{{ 'cart.shipping_calculator.title' | t }}</h2>
  {%- endif -%}

  <div class="shipping-calculator__fields">
    <div class="form-field">
      <label for="ShippingCountry-{{ instance }}">{{ 'cart.shipping_calculator.country' | t }}</label>
      <select id="ShippingCountry-{{ instance }}" data-ref="country" name="country">
        {{ country_option_tags }}
      </select>
    </div>

    <div class="form-field" data-province-wrapper hidden>
      <label for="ShippingProvince-{{ instance }}">{{ 'cart.shipping_calculator.province' | t }}</label>
      <select id="ShippingProvince-{{ instance }}" data-ref="province" name="province" disabled></select>
    </div>

    <div class="form-field">
      <label for="ShippingZip-{{ instance }}">{{ 'cart.shipping_calculator.zip' | t }}</label>
      <input
        id="ShippingZip-{{ instance }}"
        data-ref="zip"
        name="zip"
        autocomplete="postal-code"
        autocapitalize="characters"
      >
    </div>
  </div>

  <button type="button" class="button button--secondary" data-ref="submit">
    {{ 'cart.shipping_calculator.calculate' | t }}
  </button>

  <div class="shipping-calculator__results" data-ref="results" role="status"></div>
</shipping-calculator>
