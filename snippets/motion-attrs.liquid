{% doc %}
  Resolves animation settings into `<motion-effect>` attributes.

  Animations are configured at three levels, and the narrowest wins:

      block setting  ›  section setting  ›  theme setting

  Every section and block setting offers an `inherit` option, which is the
  default. A merchant who never opens those settings gets whatever the theme
  preset chose, and a merchant who wants one banner to behave differently
  changes one setting without touching anything else.

  `settings.animations_reveal_on_scroll` is the master switch. When it is off,
  this snippet emits `data-effect="none"` and `<motion-effect>` marks itself
  revealed without animating — the markup stays identical either way, so no
  section needs an if/else around its content.

  @param {string} kind - 'text' or 'image'. Chooses which setting family and which theme-level default to fall back to.
  @param {object} [block] - `block.settings`
  @param {object} [section] - `section.settings`
  @param {string} [effect] - Hard override. Skips the cascade entirely.
  @param {number} [duration] - Milliseconds
  @param {number} [delay] - Milliseconds
  @param {number} [stagger] - Milliseconds between targets
  @param {string} [target] - Selector for descendants to animate
  @param {boolean} [children] - Animate direct children, staggered
  @param {boolean} [once] - Defaults to true
  @param {string} [axis]
  @param {string} [direction]
  @param {string} [speed]
  @param {boolean} [block_level] - Resolve the text cascade as usual, then map any word- or letter-splitting preset onto the whole-element preset that moves the same way. For wrappers whose contents must not come apart — a button, a badge, a pill.

  Setting ids read from `block` and `section`:
    animation_text, animation_image, animation_delay, animation_duration,
    animation_stagger

  @example
    <motion-effect {% render 'motion-attrs', kind: 'text', section: section.settings %}>
      <h2>{{ section.settings.heading }}</h2>
    </motion-effect>

  @example
    <motion-effect {% render 'motion-attrs', kind: 'image', block: block.settings, section: section.settings, target: 'img' %}>
      {% render 'image', image: block.settings.image %}
    </motion-effect>

  @example
    <motion-effect {% render 'motion-attrs', kind: 'text', section: section.settings, children: true, stagger: 90 %}>
      {%- for block in section.blocks -%}<div>…</div>{%- endfor -%}
    </motion-effect>
{% enddoc %}

{%- liquid
  # ---- which family are we resolving -------------------------------------
  if kind == 'image'
    assign setting_key = 'animation_image'
    assign theme_default = settings.motion_effect
  else
    assign setting_key = 'animation_text'
    assign theme_default = settings.animation_style
  endif

  # ---- cascade: block › section › theme ----------------------------------
  #
  # Every optional parameter is coerced with `default` before it is compared.
  # An unset one is nil in Shopify and Undefined elsewhere, and the two disagree
  # about whether that is blank — so `if effect != blank` was true for a caller
  # that never passed an override, and `resolved` came out as the empty string.
  # `data-effect=""` means "no animation" to the component, which is how a whole
  # cascade can resolve to nothing while looking correct in the source.
  assign resolved = 'inherit'

  assign effect_override = effect | default: ''
  if effect_override != ''
    assign resolved = effect_override
  endif

  if resolved == 'inherit' and block
    assign block_value = block[setting_key] | default: 'inherit'
    if block_value != 'inherit' and block_value != ''
      assign resolved = block_value
    endif
  endif

  if resolved == 'inherit' and section
    assign section_value = section[setting_key] | default: 'inherit'
    if section_value != 'inherit' and section_value != ''
      assign resolved = section_value
    endif
  endif

  if resolved == 'inherit'
    assign resolved = theme_default
  endif

  # An empty theme-level image setting means "no image animation".
  assign resolved = resolved | default: 'none'
  if resolved == '' or resolved == 'inherit'
    assign resolved = 'none'
  endif

  # ---- block_level: follow the text setting, but never split the text ----
  #
  # A button wants the same entrance as the words around it, and nothing at all
  # happening inside it. The text family's presets split their element into
  # words or letters and animate the pieces, which on a button means the label
  # coming apart while the pill sits still — the opposite of what is wanted.
  #
  # So the cascade resolves exactly as it always does and only the answer is
  # translated: each splitting preset maps to the whole-element preset that
  # moves the same way. A section set to `words-slide-up` gets buttons that
  # slide up in one piece, same direction, same timing.
  if block_level
    case resolved
      when 'words-slide-up', 'letters-slide-up'
        assign resolved = 'slide-up'
      when 'letters-slide-down'
        assign resolved = 'slide-down'
      when 'words-slide-from-right'
        assign resolved = 'slide-left'
      when 'letters-fade-in', 'letters-fade-in-random'
        assign resolved = 'fade-in'
      when 'words-rotate-in', 'split-text'
        assign resolved = 'fade-up'
    endcase
  endif

  # Master switch always wins.
  unless settings.animations_reveal_on_scroll
    assign resolved = 'none'
  endunless

  # ---- timing: explicit argument › block › section › preset default ------
  # Same coercion for the timings. `0` is the "unset" value here — it is what
  # the sliders sit at by default and what "use the theme default" means — so a
  # chain of `default` filters resolves the cascade in one expression each.
  assign resolved_duration = duration | default: block.animation_duration | default: section.animation_duration | default: 0 | plus: 0
  assign resolved_delay = delay | default: block.animation_delay | default: section.animation_delay | default: 0 | plus: 0
  assign resolved_stagger = stagger | default: block.animation_stagger | default: section.animation_stagger | default: 0 | plus: 0
-%}

{%- comment -%}
  The timings are coerced to numbers before being compared, rather than tested
  with `!= blank` first.

  `nil != blank` is false in Shopify, so the old form short-circuited and never
  reached the comparison — but it is true in other Liquid engines, and there the
  next step is `nil > 0`, which is a type error rather than a false. Any tooling
  that renders these templates outside Shopify hits it, and it is one `default`
  filter to make the comparison mean the same thing everywhere.
{%- endcomment -%}
{%- liquid
  assign target_sel = target | default: ''
  assign speed_value = speed | default: ''
  assign direction_value = direction | default: ''
  assign axis_value = axis | default: ''
-%}
data-effect="{{ resolved | escape }}"
{%- if target_sel != '' %} data-target="{{ target_sel | escape }}"{% endif -%}
{%- if children %} data-children{% endif -%}
{%- if resolved_duration > 0 %} data-duration="{{ resolved_duration }}"{% endif -%}
{%- if resolved_delay > 0 %} data-delay="{{ resolved_delay }}"{% endif -%}
{%- if resolved_stagger > 0 %} data-stagger="{{ resolved_stagger }}"{% endif -%}
{%- if once == false %} data-once="false"{% endif -%}
{%- if speed_value != '' %} data-speed="{{ speed_value }}"{% endif -%}
{%- if direction_value != '' %} data-direction="{{ direction_value | escape }}"{% endif -%}
{%- if axis_value != '' %} data-axis="{{ axis_value | escape }}"{% endif -%}
