{% doc %}
  Mega menu link columns: a link with children is a heading over its list, one
  without is a standalone link.

  @param {object} links - Menu links to lay out
  @param {number} [columns] - Column count. Default 3

  @example
    {% render 'megamenu-columns', links: menu.links, columns: 2 %}
{% enddoc %}

<div class="megamenu__columns" style="--columns: {{ columns | default: 3 }};">
  {%- for link in links -%}
    <div class="megamenu__column">
      {%- if link.links.size > 0 -%}
        <a class="megamenu__column-heading" href="{{ link.url }}">{{ link.title }}</a>

        <ul class="megamenu__list" role="list">
          {%- for child in link.links -%}
            <li><a class="megamenu__link" href="{{ child.url }}">{{ child.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <a class="megamenu__link megamenu__link--standalone" href="{{ link.url }}">{{ link.title }}</a>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>
