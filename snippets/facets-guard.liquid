{% doc %}
  The filter group list.

  @param {object} results - The collection or search result set being filtered.
  @param {string} [context] - sidebar | drawer | horizontal. Default sidebar.
  @param {object} [filter] - Render this one group only. Used by a per-group layout.

  @example
    {% render 'facets-guard', results: collection, context: 'sidebar' %}

  @example
    {% render 'facets-guard', results: collection, context: 'horizontal', filter: f %}
{% enddoc %}

{%- liquid
  assign layout = context | default: 'sidebar'

  assign filters_to_render = results.filters

  assign wrap_in_details = true
  if layout == 'horizontal'
    assign wrap_in_details = false
  endif
-%}

<accordion-element
  class="facets__groups"
  data-collapse-below="{% if layout == 'drawer' %}0{% else %}750{% endif %}"
>
  {%- for f in filters_to_render -%}

    {%- if filter != blank and f.param_name != filter.param_name -%}
      {%- continue -%}
    {%- endif -%}

    {%- capture group_content -%}
      <div class="facets__group-content">
      {%- case f.type -%}
        {%- when 'price_range' -%}
          {%- liquid
            assign range_max = f.range_max | money_without_currency | replace: ',', ''
            assign range_max_display = f.range_max | money
          -%}
          <price-range
            class="price-range"
            data-min="0"
            data-max="{{ f.range_max }}"
          >
            <div class="price-range__head">
              <p class="price-range__max">
                {{ 'products.facets.max_price_html' | t: price: range_max_display }}
              </p>
              <button type="button" class="price-range__reset link" data-price-reset>
                {{- 'products.facets.reset' | t -}}
              </button>
            </div>

            <div class="price-range__slider" aria-hidden="true">
              <div class="price-range__track" data-ref="track">
                <span class="price-range__fill" data-ref="fill"></span>
              </div>
              <input
                class="price-range__thumb"
                type="range"
                data-ref="minThumb"
                min="0"
                max="{{ range_max }}"
                step="1"
                value="{{ f.min_value.value | default: 0 | money_without_currency | replace: ',', '' }}"
                tabindex="-1"
              >
              <input
                class="price-range__thumb"
                type="range"
                data-ref="maxThumb"
                min="0"
                max="{{ range_max }}"
                step="1"
                value="{{ f.max_value.value | default: f.range_max | money_without_currency | replace: ',', '' }}"
                tabindex="-1"
              >
            </div>

            <div class="price-range__inputs">
              <label class="visually-hidden" for="{{ f.min_value.param_name }}-{{ layout }}">
                {{ 'products.facets.price_from' | t }}
              </label>
              <input
                id="{{ f.min_value.param_name }}-{{ layout }}"
                data-ref="min"
                type="number"
                name="{{ f.min_value.param_name }}"
                value="{{ f.min_value.value | money_without_currency | replace: ',', '' }}"
                min="0"
                max="{{ range_max }}"
                inputmode="decimal"
                placeholder="0"
              >
              <span class="price-range__currency" aria-hidden="true">{{ cart.currency.symbol }}</span>

              <label class="visually-hidden" for="{{ f.max_value.param_name }}-{{ layout }}">
                {{ 'products.facets.price_to' | t }}
              </label>
              <input
                id="{{ f.max_value.param_name }}-{{ layout }}"
                data-ref="max"
                type="number"
                name="{{ f.max_value.param_name }}"
                value="{{ f.max_value.value | money_without_currency | replace: ',', '' }}"
                min="0"
                max="{{ range_max }}"
                inputmode="decimal"
                placeholder="{{ range_max }}"
              >
              <span class="price-range__currency" aria-hidden="true">{{ cart.currency.symbol }}</span>

              <button type="submit" class="price-range__apply" aria-label="{{ 'products.facets.apply' | t }}">
                {%- render 'icon', icon: 'arrow-right', size: 16 -%}
              </button>
            </div>

            <output class="price-range__output visually-hidden" data-ref="output"></output>
          </price-range>

        {%- else -%}
          {%- assign visible_values = 0 -%}
          {%- liquid
            assign value_style = 'pills'
            if f.param_name contains 'availability' or f.type == 'boolean'
              assign value_style = 'rows'
            elsif f.presentation == 'image'
              assign value_style = 'image'
            elsif f.presentation == 'swatch'
              assign value_style = 'swatch'
            endif
          -%}
          <ul class="facets__values facets__values--{{ f.presentation | default: 'text' }} facets__values--{{ value_style }}" role="list">
            {%- for value in f.values -%}
              {%- assign value_prefix = value.value | slice: 0, 2 -%}
              {%- if value_prefix == '__' -%}{%- continue -%}{%- endif -%}
              {%- assign visible_values = visible_values | plus: 1 -%}
              <li class="facets__value">
                <label class="facets__checkbox">
                  <input
                    type="checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value | escape }}"
                    {% if value.active %}checked{% endif %}
                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                  >

                  {%- case f.presentation -%}
                    {%- when 'swatch' -%}
                      {% render 'swatch',
                         value: value.label,
                         option_name: f.label,
                         option_value: value,
                         size: 'small' %}
                    {%- when 'image' -%}
                      {%- if value.image != blank -%}
                        {{
                          value.image
                          | image_url: width: 80
                          | image_tag: class: 'facets__value-image', alt: '', width: 40, height: 40, loading: 'lazy'
                        }}
                      {%- endif -%}
                  {%- endcase -%}

                  <span class="facets__value-label">{{ value.label | escape }}</span>
                  <span class="facets__value-check" aria-hidden="true">{% render 'icon', icon: 'check', size: 8 %}</span>
                  <span class="facets__value-count">({{ value.count }})</span>
                </label>
              </li>
            {%- endfor -%}
          </ul>
      {%- endcase -%}
      </div>
    {%- endcapture -%}

    {%- if f.type == 'list' and visible_values == 0 -%}
      {%- continue -%}
    {%- endif -%}

    {%- if wrap_in_details -%}
      <details
        class="facets__group"
        data-morph-key="{{ f.param_name | escape }}"
        data-default-open
        {% if f.active_values.size > 0 %}open{% endif %}
      >
        <summary class="facets__summary">
          <span class="facets__group-label">{{ f.label }}</span>
          {%- if f.active_values.size > 0 -%}
            <span class="facets__group-count">{{ f.active_values.size }}</span>
          {%- endif -%}
          <span class="facets__group-toggle" aria-hidden="true">{% render 'icon', icon: 'chevron-down', size: 12 %}</span>
        </summary>

        {{ group_content }}
      </details>
    {%- else -%}
      <div class="facets__group facets__group--flat" data-morph-key="{{ f.param_name | escape }}">
        {{ group_content }}
      </div>
    {%- endif -%}
  {%- endfor -%}
</accordion-element>
