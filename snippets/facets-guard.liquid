{%- comment -%}
  The filter groups, and the guard that lets one be rendered on its own.

  Written as a separate file for two reasons.

  The body below is around eighty lines of `case f.type` covering price ranges,
  checkboxes and swatches. It is needed twice - once inside a disclosure and once
  without - and pasting it into both branches means the next change to swatch
  rendering has to be made twice, and the two copies drift.

  And a layout that renders one dropdown per filter group calls this once per
  group with `filter:` set. Without the guard, every dropdown would render every
  filter: five filters would show twenty-five groups.

  `snippets/facets.liquid` renders this once, with no `filter`, which is every
  group in a disclosure - exactly what it drew inline before.
{%- endcomment -%}

{% doc %}
  The filter group list.

  @param {object} results - The collection or search result set being filtered.
  @param {string} [context] - sidebar | drawer | horizontal. Default sidebar.
  @param {object} [filter] - Render this one group only. Used by a per-group layout.

  @example
    {% render 'facets-guard', results: collection, context: 'sidebar' %}

  @example
    {% render 'facets-guard', results: collection, context: 'horizontal', filter: f %}
{% enddoc %}

{%- liquid
  assign layout = context | default: 'sidebar'

  comment
    Every filter, then skipped inside the loop when the caller asked for one.

    Building a one-item array instead needs `concat`, and `concat` needs an array
    on both sides - Liquid has no array literal, and an undefined variable is nil
    rather than an empty array, so that route returns nothing and the caller
    renders no filters at all. Skipping inside the loop costs one wasted
    iteration per filter and cannot fail that way.
  endcomment
  assign filters_to_render = results.filters

  comment
    A per-group layout supplies its own summary button and popover, so the
    disclosure wrapper here would nest a disclosure inside a disclosure.
  endcomment
  assign wrap_in_details = true
  if layout == 'horizontal'
    assign wrap_in_details = false
  endif
-%}

<accordion-element
  class="facets__groups"
  data-collapse-below="{% if layout == 'drawer' %}0{% else %}750{% endif %}"
>
  {%- for f in filters_to_render -%}
    {%- comment -%}
      The guard. The loop variable is `f` because `filter` is the incoming
      parameter, and shadowing it would make this line unreadable.
    {%- endcomment -%}
    {%- if filter != blank and f.param_name != filter.param_name -%}
      {%- continue -%}
    {%- endif -%}

    {%- if wrap_in_details -%}
      <details class="facets__group" data-default-open {% if f.active_values.size > 0 %}open{% endif %}>
        <summary class="facets__summary">
          <span class="facets__group-label">{{ f.label }}</span>
          {%- if f.active_values.size > 0 -%}
            <span class="facets__group-count">{{ f.active_values.size }}</span>
          {%- endif -%}
          {% render 'icon', icon: 'chevron-down', size: 14 %}
        </summary>

        <div class="facets__group-content">
        {%- case f.type -%}
          {%- when 'price_range' -%}
            <price-range
              class="price-range"
              data-min="0"
              data-max="{{ f.range_max }}"
            >
              <div class="price-range__inputs">
                <label class="visually-hidden" for="{{ f.min_value.param_name }}-{{ layout }}">
                  {{ 'products.facets.price_from' | t }}
                </label>
                <input
                  id="{{ f.min_value.param_name }}-{{ layout }}"
                  data-ref="min"
                  type="number"
                  name="{{ f.min_value.param_name }}"
                  value="{{ f.min_value.value | money_without_currency | replace: ',', '' }}"
                  min="0"
                  max="{{ f.range_max | money_without_currency | replace: ',', '' }}"
                  inputmode="numeric"
                  placeholder="0"
                >

                <label class="visually-hidden" for="{{ f.max_value.param_name }}-{{ layout }}">
                  {{ 'products.facets.price_to' | t }}
                </label>
                <input
                  id="{{ f.max_value.param_name }}-{{ layout }}"
                  data-ref="max"
                  type="number"
                  name="{{ f.max_value.param_name }}"
                  value="{{ f.max_value.value | money_without_currency | replace: ',', '' }}"
                  min="0"
                  max="{{ f.range_max | money_without_currency | replace: ',', '' }}"
                  inputmode="numeric"
                  placeholder="{{ f.range_max | money_without_currency | replace: ',', '' }}"
                >
              </div>

              <div class="price-range__track" data-ref="track" aria-hidden="true">
                <span class="price-range__fill" data-ref="fill"></span>
              </div>

              <output class="price-range__output" data-ref="output"></output>
              <p class="price-range__max">
                {{ 'products.facets.max_price_html' | t: price: f.range_max | money }}
              </p>
            </price-range>

          {%- else -%}
            <ul class="facets__values" role="list">
              {%- for value in f.values -%}
                <li class="facets__value">
                  <label class="facets__checkbox">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                    >

                    {%- if f.presentation == 'swatch' -%}
                      {% render 'swatch',
                         value: value.label,
                         option_name: f.label,
                         option_value: value,
                         size: 'small' %}
                    {%- else -%}
                      <span class="facets__value-label">{{ value.label }}</span>
                    {%- endif -%}

                    <span class="facets__value-count">({{ value.count }})</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
        {%- endcase -%}
        </div>
      </details>
    {%- else -%}
      <div class="facets__group facets__group--flat">
        <div class="facets__group-content">
        {%- case f.type -%}
          {%- when 'price_range' -%}
            <price-range
              class="price-range"
              data-min="0"
              data-max="{{ f.range_max }}"
            >
              <div class="price-range__inputs">
                <label class="visually-hidden" for="{{ f.min_value.param_name }}-{{ layout }}">
                  {{ 'products.facets.price_from' | t }}
                </label>
                <input
                  id="{{ f.min_value.param_name }}-{{ layout }}"
                  data-ref="min"
                  type="number"
                  name="{{ f.min_value.param_name }}"
                  value="{{ f.min_value.value | money_without_currency | replace: ',', '' }}"
                  min="0"
                  max="{{ f.range_max | money_without_currency | replace: ',', '' }}"
                  inputmode="numeric"
                  placeholder="0"
                >

                <label class="visually-hidden" for="{{ f.max_value.param_name }}-{{ layout }}">
                  {{ 'products.facets.price_to' | t }}
                </label>
                <input
                  id="{{ f.max_value.param_name }}-{{ layout }}"
                  data-ref="max"
                  type="number"
                  name="{{ f.max_value.param_name }}"
                  value="{{ f.max_value.value | money_without_currency | replace: ',', '' }}"
                  min="0"
                  max="{{ f.range_max | money_without_currency | replace: ',', '' }}"
                  inputmode="numeric"
                  placeholder="{{ f.range_max | money_without_currency | replace: ',', '' }}"
                >
              </div>

              <div class="price-range__track" data-ref="track" aria-hidden="true">
                <span class="price-range__fill" data-ref="fill"></span>
              </div>

              <output class="price-range__output" data-ref="output"></output>
              <p class="price-range__max">
                {{ 'products.facets.max_price_html' | t: price: f.range_max | money }}
              </p>
            </price-range>

          {%- else -%}
            <ul class="facets__values" role="list">
              {%- for value in f.values -%}
                <li class="facets__value">
                  <label class="facets__checkbox">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                    >

                    {%- if f.presentation == 'swatch' -%}
                      {% render 'swatch',
                         value: value.label,
                         option_name: f.label,
                         option_value: value,
                         size: 'small' %}
                    {%- else -%}
                      <span class="facets__value-label">{{ value.label }}</span>
                    {%- endif -%}

                    <span class="facets__value-count">({{ value.count }})</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
        {%- endcase -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</accordion-element>
