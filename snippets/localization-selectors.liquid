{% doc %}
  Renders the country and language selectors.

  @param {string} id_prefix - Unique per instance, e.g. 'Footer'
  @param {string} [class]

  @example
    {% render 'localization-selectors', id_prefix: 'Footer' %}
{% enddoc %}

{%- liquid
  assign id_prefix = id_prefix | default: 'Localization'

  assign country_id = id_prefix | append: 'Country'
  assign language_id = id_prefix | append: 'Language'
-%}
<div class="localization {{ class }}">
  {%- if settings.enable_country_selector and localization.available_countries.size > 1 -%}
    <localization-form data-type="country">
      {%- form 'localization', id: country_id, class: 'localization__form' -%}

        <button
          type="button"
          class="localization__trigger"
          data-ref="trigger"
          aria-expanded="false"
          aria-controls="{{ country_id }}Panel"
        >
          <span class="visually-hidden">{{ 'localization.country_label' | t }}</span>
          <span aria-hidden="true">{{ localization.country.name }} ({{ cart.currency.iso_code }})</span>
          {% render 'icon', icon: 'chevron-down' %}
        </button>

        <div class="localization__panel" id="{{ country_id }}Panel" data-ref="panel" data-lenis-prevent hidden>
          <div data-filter-wrapper>
            <label class="visually-hidden" for="{{ country_id }}Filter">
              {{ 'localization.search_countries' | t }}
            </label>
            <input
              id="{{ country_id }}Filter"
              type="search"
              data-ref="filter"
              autocomplete="off"
              placeholder="{{ 'localization.search_countries' | t | escape }}"
            >
          </div>

          <ul class="localization__list" data-ref="list" role="listbox">
            {%- for country in localization.available_countries -%}
              <li>
                <button
                  type="submit"
                  name="country_code"
                  value="{{ country.iso_code }}"
                  data-option
                  data-label="{{ country.name | escape }} {{ country.currency.iso_code | escape }}"
                  {% if country.iso_code == localization.country.iso_code %}aria-selected="true"{% endif %}
                >
                  {{ country.name }}
                  <span class="localization__currency">{{ country.currency.iso_code }}</span>
                </button>
              </li>
            {%- endfor -%}
          </ul>

          <p class="localization__empty" data-ref="empty" hidden>
            {{ 'localization.no_country_results' | t }}
          </p>
        </div>
      {%- endform -%}
    </localization-form>
  {%- endif -%}

  {%- if settings.enable_language_selector and localization.available_languages.size > 1 -%}

    <localization-form data-type="language">
      {%- form 'localization', id: language_id, class: 'localization__form' -%}

        <button
          type="button"
          class="localization__trigger"
          data-ref="trigger"
          aria-expanded="false"
          aria-controls="{{ language_id }}Panel"
        >
          <span class="visually-hidden">{{ 'localization.language_label' | t }}</span>
          <span aria-hidden="true">{{ localization.language.endonym_name | capitalize }}</span>
          {% render 'icon', icon: 'chevron-down' %}
        </button>

        <div class="localization__panel" id="{{ language_id }}Panel" data-ref="panel" hidden>
          <ul class="localization__list" data-ref="list" role="listbox">
            {%- for language in localization.available_languages -%}
              <li>
                <button
                  type="submit"
                  name="locale_code"
                  value="{{ language.iso_code }}"
                  data-option
                  data-label="{{ language.endonym_name | escape }}"
                  lang="{{ language.iso_code }}"
                  {% if language.iso_code == localization.language.iso_code %}aria-selected="true"{% endif %}
                >
                  {{ language.endonym_name | capitalize }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endform -%}
    </localization-form>
  {%- endif -%}
</div>

