{% doc %}
  Renders the newsletter signup.

  @param {string} id - Unique per instance
  @param {string} [heading]
  @param {string} [text]
  @param {string} [class]

  @example
    {% render 'newsletter-form', id: 'FooterNewsletter' %}
{% enddoc %}

<div class="newsletter {{ class }}">
  {%- if heading != blank -%}
    <h2 class="newsletter__heading">{{ heading }}</h2>
  {%- endif -%}

  {%- if text != blank -%}
    <div class="newsletter__text rte">{{ text }}</div>
  {%- endif -%}

  <validated-form>
    {%- form 'customer', id: id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <label class="visually-hidden" for="{{ id }}-email">{{ 'general.newsletter.label' | t }}</label>

      <div class="newsletter__field" data-error-anchor>
        <input
          id="{{ id }}-email"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ 'general.newsletter.placeholder' | t | escape }}"
          autocomplete="email"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="{{ id }}-email-error"
          {% endif %}
        >

        <button type="submit" class="button button--primary">
          {{ 'general.newsletter.submit' | t }}
        </button>
      </div>

      {%- if form.errors -%}
        <div class="newsletter__error" id="{{ id }}-email-error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <p class="newsletter__success" role="status">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </validated-form>
</div>
