{% doc %}
  A tab strip and its panels.

  @param {string} [panels] - The `role="tabpanel"` elements
  @param {string} [tabs] - The `role="tab"` buttons. Omit when the panels carry `data-tab-label`
  @param {string} [orientation] - horizontal | vertical. Default: horizontal
  @param {string} [activation] - auto | manual. Default: auto
  @param {boolean} [hover] - Select on pointer hover as well as click
  @param {string} [label] - Accessible name for the tablist
  @param {string} [id] - Element id. `tabs.js` derives generated panel ids from it
  @param {string} [styles] - Declarations for the group's own `style` attribute
  @param {string} [attributes] - Raw attributes, e.g. `block.shopify_attributes`
  @param {string} [classes]

  @example
    {% render 'tab-group', tabs: tabs, panels: panels, orientation: 'vertical' %}
{% enddoc %}

{%- liquid
  assign tab_orientation = orientation | default: 'horizontal'
  assign tab_activation = activation | default: 'auto'
-%}

<tab-group
  {% if id != blank %}id="{{ id }}"{% endif %}
  class="tabs tabs--{{ tab_orientation }} {{ classes }}"
  data-orientation="{{ tab_orientation }}"
  data-activation="{{ tab_activation }}"
  {% if hover %}data-hover="true"{% endif %}
  {% if styles != blank %}style="{{ styles | strip_newlines | strip }}"{% endif %}
  {{ attributes }}
>
  <div class="tabs__rail">
    <div
      class="tabs__list"
      role="tablist"
      aria-orientation="{{ tab_orientation }}"
      {% if label != blank %}aria-label="{{ label | escape }}"{% endif %}
      data-ref="list"
    >
      <span class="tabs__marker" data-ref="marker" aria-hidden="true"></span>
      {{ tabs }}
    </div>
  </div>

  <div class="tabs__panels" data-ref="panels">
    {{ panels }}
  </div>
</tab-group>
