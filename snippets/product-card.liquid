{% doc %}
  Renders a product card.

  @param {product} product - [ratio]     (product, optional)
  @param {number} [index] - Position in the grid. Drives the reveal delay
  @param {string} [sizes] - Passed to snippets/image.liquid
  @param {boolean} [priority] - Eager-load the image. First row only
  @param {boolean} [show_vendor] - Overrides the theme setting
  @param {string} [class]
  @param {object} [section] - `section.settings`, for the animation cascade
  @param {object} [block] - `block.settings`, for the animation cascade
  @param {string} [quick_add]
  @param {string} [ratio]
  @param {boolean} [show_rating]

  @example
    {%- for product in collection.products -%}
      {% render 'product-card', product: product, index: forloop.index0, priority: forloop.first %}
    {%- endfor -%}
{% enddoc %}

{%- liquid
  assign ratio = ratio | default: settings.card_image_ratio | default: '3-4'
  assign alignment = settings.card_text_alignment | default: 'left'
  assign hover_effect = settings.card_hover_effect | default: 'image-swap'

  assign vendor_visible = settings.show_vendor
  unless show_vendor == nil
    assign vendor_visible = show_vendor
  endunless

  assign rating_visible = settings.show_rating
  unless show_rating == nil
    assign rating_visible = show_rating
  endunless

  assign quick_add_style = quick_add | default: settings.quick_add_style

  assign quick_add_position = settings.quick_add_position | default: 'bar'
  assign quick_add_icon_only = false
  if quick_add_style == 'icon' or quick_add_position == 'corner'
    assign quick_add_icon_only = true
  endif

  assign quick_add_full = true
  if quick_add_position == 'corner'
    assign quick_add_full = false
  endif

  assign card_scheme_classes = ''
  if settings.card_inherit_color_scheme == false and settings.card_color_scheme != blank
    assign card_scheme_classes = ' color-scheme-container color-' | append: settings.card_color_scheme
  endif

  assign swatch_names = settings.swatch_option_names | default: 'Colour, Color' | downcase | split: ','
  assign swatch_option = blank

  for option in product.options_with_values
    assign option_key = option.name | downcase | strip
    assign option_key = option.name | downcase | strip

  for name in swatch_names
    assign swatch_name = name | downcase | strip

    if swatch_name == option_key
      assign swatch_option = option
      break
    endif
  endfor
    if swatch_option != blank
      break
    endif
  endfor

  assign second_image = product.media[1].preview_image
  if hover_effect != 'image-swap'
    assign second_image = blank
  endif

  assign card_delay = 0
  if index != blank
    assign card_delay = index | modulo: 4 | times: 70
  endif

  assign card_id = 'card-' | append: product.id | append: '-' | append: index
-%}

<motion-effect
  {% render 'motion-attrs',
     kind: 'image',
     block: block,
     section: section,
     target: '.product-card__media',
     delay: card_delay %}
  class="product-card product-card--{{ alignment }} product-card--hover-{{ hover_effect }}{{ card_scheme_classes }} {{ class }}"

  data-quick-add-position="{{ quick_add_position }}"
  data-product-id="{{ product.id }}"
  data-morph-key="{{ card_id }}"
>
  <div class="product-card__media-wrapper">
    {%- liquid
      assign card_images = product.images | slice: 0, settings.card_slider_count | default: 4
      assign use_slider = false
      if settings.enable_card_slider and card_images.size > 1
        assign use_slider = true
      endif
    -%}

    {%- if use_slider -%}

      <carousel-slider
        class="product-card__slider carousel-shell"
        data-layout="carousel"
        data-layout-mobile="carousel"
        data-ratio="{{ ratio }}"
        data-options="{%- render 'carousel-options',
          settings: settings,
          count: card_images.size,
          columns_desktop: 1,
          columns_tablet: 1,
          columns_mobile: 1,
          autoplay: false,
          loop: false,
          effect: 'slide',
          pagination: 'none',
          space_between: 0 -%}"
        style="{% render 'carousel-vars',
          settings: settings,
          columns_desktop: 1,
          columns_tablet: 1,
          columns_mobile: 1,
          effect: 'slide',
          peek_mobile: 0,
          peek_desktop: 0,
          space_between: 0 %}"
      >
        <ul
          class="product-card__slides"
          data-ref="track"
          role="list"
          aria-label="{{ product.title | escape }}"
        >

          {%- for card_image in card_images -%}
            <li class="product-card__slide">
              <a
                class="product-card__slide-link"
                href="{{ product.url }}"
                tabindex="-1"
                aria-hidden="true"
              >
                {% render 'image', image: card_image, ratio: ratio, sizes: sizes, priority: priority, class: 'product-card__image' %}
              </a>
            </li>
          {%- endfor -%}
        </ul>

        <button type="button" class="product-card__slider-arrow" data-ref="previous" aria-label="{{ 'accessibility.previous_slide' | t }}">
          {% render 'icon', icon: 'chevron-left', size: 14 %}
        </button>

        <button type="button" class="product-card__slider-arrow product-card__slider-arrow--next" data-ref="next" aria-label="{{ 'accessibility.next_slide' | t }}">
          {% render 'icon', icon: 'chevron-right', size: 14 %}
        </button>

        <p class="visually-hidden" data-ref="status" role="status"></p>
      </carousel-slider>
    {%- else -%}
      <a
        class="product-card__media-link"
        href="{{ product.url }}"
        tabindex="-1"
        aria-hidden="true"
      >
        <div class="product-card__media" data-ratio="{{ ratio }}">
          {% render 'image',
             image: product.featured_media.preview_image,
             ratio: ratio,
             sizes: sizes,
             priority: priority,
             class: 'product-card__image product-card__image--primary' %}

          {%- if second_image != blank -%}
            {% render 'image',
               image: second_image,
               ratio: ratio,
               sizes: sizes,
               class: 'product-card__image product-card__image--secondary' %}
          {%- endif -%}
        </div>
      </a>
    {%- endif -%}

    {% render 'badge', product: product %}

    {%- if quick_add_style != 'none' and product.available -%}
      <div class="product-card__actions" data-quick-add-position="{{ quick_add_position }}">
        {%- liquid
          assign needs_options = true
          if product.has_only_default_variant or product.variants.size == 1
            assign needs_options = false
          endif
        -%}

        {%- if needs_options == false -%}

          <form action="{{ routes.cart_add_url }}" method="post" data-quick-add-form>
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            {%- assign add_to_cart_label = 'products.product.add_to_cart' | t -%}
            {% render 'button', label: add_to_cart_label, type: 'submit', variant: 'primary', size: 'small', full: quick_add_full, icon_only: quick_add_icon_only, icon: 'plus' %}
          </form>
        {%- else -%}

          {%- assign choose_options_label = 'products.product.choose_options' | t -%}

          {%- if settings.enable_quick_add -%}
            {%- assign quick_add_attributes = 'data-overlay-open="QuickAdd" data-product-url="' | append: product.url | append: '" data-section-id="quick-add"' -%}
            {% render 'button', label: choose_options_label, variant: 'primary', size: 'small', full: quick_add_full, icon_only: quick_add_icon_only, icon: 'plus', attributes: quick_add_attributes %}
          {%- else -%}
            {% render 'button', label: choose_options_label, href: product.url, variant: 'primary', size: 'small', full: quick_add_full, icon_only: quick_add_icon_only, icon: 'plus' %}
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if vendor_visible and product.vendor != blank -%}
      <p class="product-card__vendor">
        <span class="visually-hidden">{{ 'products.product.vendor' | t }}:</span>
        {{ product.vendor }}
      </p>
    {%- endif -%}

    <h3 class="product-card__title">
      <a class="product-card__link" href="{{ product.url }}" id="{{ card_id }}-title">
        {{ product.title | escape }}
      </a>
    </h3>

    {%- if rating_visible -%}
      {% render 'rating', product: product %}
    {%- endif -%}

    <div class="product-card__price{% if settings.show_second_line_price %} product-card__price--block{% endif %}">
      {% render 'price', product: product, context: 'card' %}
    </div>

    {%- if settings.enable_compare -%}
      <compare-trigger
        class="product-card__compare"
        data-product-handle="{{ product.handle }}"
        hidden
      >
        <button type="button" class="product-card__compare-button" data-ref="button" aria-pressed="false">
          {% render 'icon', icon: 'compare' %}
          <span>{{ 'products.compare.add' | t }}</span>
        </button>
      </compare-trigger>
    {%- endif -%}

    {%- assign card_swatch_type = settings.swatches_type | default: 'theme' -%}
    {%- if card_swatch_type != 'none' and swatch_option != blank -%}

      <variant-swatch data-product-url="{{ product.url }}">
        <script type="application/json" data-variants>
          {{- product.variants | json -}}
        </script>

        <div class="swatch-group" role="group" aria-label="{{ 'accessibility.swatch_group' | t: option: swatch_option.name | escape }}">
          {%- for value in swatch_option.values limit: settings.swatch_max_visible -%}

            {%- assign value_variant = nil -%}
            {%- for variant in product.variants -%}
              {%- if variant.options contains value -%}
                {%- assign value_variant = variant -%}
                {%- if variant.available -%}{%- break -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            <button
              type="button"
              data-swatch-option
              data-value="{{ value | escape }}"
              aria-pressed="false"
            >
              {% render 'swatch',
                 value: value,
                 option_name: swatch_option.name,
                 option_value: value,
                 variant: value_variant,
                 shape: settings.swatch_shape %}
              <span class="visually-hidden">{{ value }}</span>
            </button>
          {%- endfor -%}

          {%- if swatch_option.values.size > settings.swatch_max_visible -%}
            {%- assign remaining = swatch_option.values.size | minus: settings.swatch_max_visible -%}
            <span class="swatch-count">{{ 'products.variants.show_more_swatches' | t: count: remaining }}</span>
          {%- endif -%}
        </div>
      </variant-swatch>
    {%- endif -%}
</div>
</motion-effect>
