{% doc %}
  Renders the pagination controls for a `<results-list>`.

  @param {object} paginate - The `paginate` drop
  @param {string} type - paginate | load-more | infinite

  @example
    {% paginate collection.products by section.settings.products_per_page %}
      {% render 'pagination', paginate: paginate, type: section.settings.pagination_type %}
    {% endpaginate %}
{% enddoc %}

{%- liquid
  assign mode = type | default: settings.pagination_type | default: 'paginate'
  assign out_of_range = false
  if paginate.current_page > paginate.pages
    assign out_of_range = true
  endif
-%}

{%- if mode == 'paginate' -%}
  {%- if paginate.pages > 1 -%}
    <nav class="pagination" data-ref="pagination" aria-label="{{ 'general.pagination.label' | t }}">
      <ul class="pagination__list" role="list">
        {%- if paginate.previous and out_of_range == false -%}
          <li>
            <a class="pagination__link pagination__link--previous" href="{{ paginate.previous.url }}" rel="prev">
              {% render 'icon', icon: 'arrow-left' %}
              <span class="visually-hidden">{{ 'general.pagination.previous' | t }}</span>
            </a>
          </li>
        {%- endif -%}

        {%- for part in paginate.parts -%}
          <li>
            {%- if part.is_link -%}
              <a class="pagination__link" href="{{ part.url }}">
                <span class="visually-hidden">{{ 'general.pagination.page' | t: number: part.title }}</span>
                {%- assign page_label = part.title | append: '' -%}
                <span aria-hidden="true">{% if page_label.size == 1 %}0{% endif %}{{ page_label }}</span>
              </a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="pagination__link pagination__link--current" aria-current="page">
                <span class="visually-hidden">{{ 'general.pagination.page' | t: number: part.title }}</span>
                {%- assign page_label = part.title | append: '' -%}
                <span aria-hidden="true">{% if page_label.size == 1 %}0{% endif %}{{ page_label }}</span>
              </span>
            {%- else -%}
              <span class="pagination__ellipsis" aria-hidden="true">{{ part.title }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}

        {%- if paginate.next -%}
          <li>
            <a class="pagination__link pagination__link--next" href="{{ paginate.next.url }}" rel="next">
              <span class="visually-hidden">{{ 'general.pagination.next' | t }}</span>
              {% render 'icon', icon: 'arrow-right' %}
            </a>
          </li>
        {%- endif -%}
      </ul>
    </nav>
  {%- endif -%}
{%- else -%}
  {%- if paginate.next -%}
    <a
      class="button button--secondary pagination__load-more"
      data-ref="loadMore"
      data-next-url="{{ paginate.next.url }}"
      href="{{ paginate.next.url }}"
      rel="next"
    >
      {{ 'general.pagination.load_more' | t }}
    </a>
  {%- endif -%}

  {%- if mode == 'infinite' and paginate.items > 0 -%}
    <div class="pagination__sentinel" data-ref="sentinel" aria-hidden="true"></div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
@layer components {
  .pagination__list {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-block-start: var(--space-8);
  }

  .pagination__link {
    display: grid;
    place-items: center;
    min-inline-size: 4rem;
    block-size: 4rem;
    border-radius: var(--radius-button);
    text-decoration: none;
  }

  .pagination__link--current { background-color: var(--color-secondary-background); }

  .pagination__load-more {
    display: block;
    margin-block: var(--space-6);
    margin-inline: auto;
  }

  .pagination { margin-block-start: var(--space-8); }
  .pagination__link--previous,
  .pagination__link--next { color: var(--color-heading); }
  .pagination__ellipsis { display: grid; place-items: center; min-inline-size: 4rem; block-size: 4rem; color: var(--color-muted-text); }
  .pagination__sentinel { block-size: 1px; }

  .pagination__list { align-items: center; gap: var(--space-2); margin-block-start: var(--space-8); }

  .pagination__link,
  .pagination__ellipsis {
    display: grid;
    place-items: center;
    inline-size: 4rem;
    min-inline-size: 4rem;
    block-size: 4rem;
    border: 1px solid var(--color-heading);
    border-radius: 50%;
    color: var(--color-heading);
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
  }

  .pagination__link--current {
    background-color: var(--color-heading);
    color: var(--color-background);
  }

  .pagination__link--previous,
  .pagination__link--next {
    inline-size: 4.8rem;
    block-size: 4.8rem;
  }

  .pagination__link--next {
    background-color: var(--color-heading);
    color: var(--color-background);
  }
}
{% endstylesheet %}
