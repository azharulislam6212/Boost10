{% doc %}
  Background media for any section or block: none, an image, or a video, with an
  optional overlay.

  @param {object} [settings] - A settings object carrying the `background_*`, `image_*`, `video_*` and `overlay_*` keys.
  @param {boolean} [priority] - Eager-load the image. Above-the-fold only.
  @param {string} [placeholder] - Draw this placeholder when Image is chosen and none is uploaded. Opt-in
  @param {string} [classes] - Extra classes on the wrapper.
  @param {string} [attributes] - Extra attributes on the wrapper, such as a block's `shopify_attributes`.
  @param {boolean} [overlay_without_media] - Also draw the overlay when Background media is None
  @param {number} [overlay_opacity] - Overlay opacity when the settings have no `overlay_opacity`

  @example
    {% render 'background-media', settings: block.settings %}

  @example
    {% render 'background-media', settings: section.settings, priority: true %}
{% enddoc %}

{%- liquid
  assign media = settings.background_media | default: 'none'

  assign show_overlay = false
  if media != 'none' and settings.overlay_enabled
    assign show_overlay = true
  endif
  if media == 'none' and overlay_without_media and settings.overlay_enabled
    assign show_overlay = true
  endif
  assign overlay_alpha = settings.overlay_opacity | default: overlay_opacity

  assign has_layer = false
  assign show_placeholder = false
  case media
    when 'image'
      if settings.image
        assign has_layer = true
      elsif placeholder != blank
        assign has_layer = true
        assign show_placeholder = true
      endif
    when 'video'
      assign video_url = settings.video_url | default: ''
      if settings.video or video_url != ''
        assign has_layer = true
      endif
    when 'none'
      if show_overlay
        assign has_layer = true
      endif
  endcase
-%}

{%- if has_layer -%}
  <div class="background-media {{ classes }}" aria-hidden="true" {{ attributes }}>
    {%- case media -%}
      {%- when 'image' -%}
        {%- if show_placeholder -%}
          {% render 'image', placeholder: placeholder, wrapper_class: 'background-media__placeholder' %}
        {%- else -%}
          {% render 'background-image',
             image: settings.image,
             mobile_image: settings.image_mobile,
             position: settings.image_position,
             parallax: settings.image_parallax,
             speed: settings.image_parallax_speed,
             priority: priority %}
        {%- endif -%}

      {%- when 'video' -%}

        {% render 'background-video',
           video: settings.video,
           video_url: settings.video_url,
           image: settings.video_poster,
           position: settings.video_position %}
    {%- endcase -%}

    {%- if show_overlay -%}
      {% render 'overlay',
         style: settings.overlay_style,
         color: settings.overlay_color,
         gradient: settings.overlay_gradient,
         direction: settings.overlay_direction,
         opacity: overlay_alpha %}
    {%- endif -%}
  </div>
{%- endif -%}
