{% doc %}
  A country's flag, as Shopify's flag image. An image rather than emoji
  characters, which Windows shows as two letters.

  @param {object} country - A localization country

  @example
    {% render 'country-flag', country: localization.country %}
{% enddoc %}

{%- if country != blank -%}
  {{
    country
    | image_url: width: 40
    | image_tag: width: 20, height: 15, alt: '', loading: 'lazy', class: 'market-picker__flag'
  }}
{%- endif -%}
