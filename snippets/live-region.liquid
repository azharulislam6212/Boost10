{% doc %}
  Global ARIA live regions.

  @example
    {% render 'live-region' %}
{% enddoc %}

<div
  id="LiveRegion"
  class="visually-hidden"
  role="status"
  aria-live="polite"
  aria-atomic="true"
></div>

<div
  id="LiveRegionAssertive"
  class="visually-hidden"
  role="alert"
  aria-live="assertive"
  aria-atomic="true"
></div>
