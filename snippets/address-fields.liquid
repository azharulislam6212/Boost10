{% doc %}
  The address form fields, shared by the new and edit forms.

  One copy, because two would eventually disagree about which fields exist —
  and an address form that is missing a field in one place is an address that
  cannot be corrected once it is wrong.

  The country select carries data-country and data-default;
  <customer-address-form> reads the province list from the selected option and
  hides the province field entirely for countries that have none. An empty
  dropdown reads as a required field a customer cannot fill.

  Parameters:
    form    (object, required)
    address (object, required)
    id      (string, required)  Unique per form instance

  @example
    {% render 'address-fields', form: form, address: address, id: address.id %}
{% enddoc %}

<div class="address-form__fields">
  <div class="customer__row">
    <div class="form-field">
      <label for="AddressFirstName-{{ id }}">{{ 'customer.addresses.first_name' | t }}</label>
      <input id="AddressFirstName-{{ id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
    </div>

    <div class="form-field">
      <label for="AddressLastName-{{ id }}">{{ 'customer.addresses.last_name' | t }}</label>
      <input id="AddressLastName-{{ id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
    </div>
  </div>

  <div class="form-field">
    <label for="AddressCompany-{{ id }}">{{ 'customer.addresses.company' | t }}</label>
    <input id="AddressCompany-{{ id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization">
  </div>

  <div class="form-field">
    <label for="AddressLine1-{{ id }}">{{ 'customer.addresses.address1' | t }}</label>
    <input id="AddressLine1-{{ id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required>
  </div>

  <div class="form-field">
    <label for="AddressLine2-{{ id }}">{{ 'customer.addresses.address2' | t }}</label>
    <input id="AddressLine2-{{ id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
  </div>

  <div class="customer__row">
    <div class="form-field">
      <label for="AddressCity-{{ id }}">{{ 'customer.addresses.city' | t }}</label>
      <input id="AddressCity-{{ id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required>
    </div>

    <div class="form-field">
      <label for="AddressZip-{{ id }}">{{ 'customer.addresses.zip' | t }}</label>
      <input id="AddressZip-{{ id }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" autocapitalize="characters" required>
    </div>
  </div>

  <div class="form-field">
    <label for="AddressCountry-{{ id }}">{{ 'customer.addresses.country' | t }}</label>
    <select
      id="AddressCountry-{{ id }}"
      name="address[country]"
      data-country
      data-default="{{ form.country }}"
      autocomplete="country-name"
    >
      {{ country_option_tags }}
    </select>
  </div>

  <div class="form-field" data-province-wrapper hidden>
    <label for="AddressProvince-{{ id }}">{{ 'customer.addresses.province' | t }}</label>
    <select
      id="AddressProvince-{{ id }}"
      name="address[province]"
      data-province
      data-default="{{ form.province }}"
      autocomplete="address-level1"
      disabled
    ></select>
  </div>

  <div class="form-field">
    <label for="AddressPhone-{{ id }}">{{ 'customer.addresses.phone' | t }}</label>
    <input id="AddressPhone-{{ id }}" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
  </div>

  <div class="form-field">
    <label class="form-field__checkbox" for="AddressDefault-{{ id }}">
      {{ form.set_as_default_checkbox }}
      <span>{{ 'customer.addresses.set_default' | t }}</span>
    </label>
  </div>
</div>
