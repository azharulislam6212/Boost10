{% doc %}
  A carousel's arrows and pagination, rendered outside the `<carousel-slider>`
  and tied to it by id: the controls bar, or the arrows with the pagination.
  The caller decides whether to show them and wraps them in its own element.

  @param {object} settings - The settings that hold the carousel options.
  @param {string} carousel - Id of the `<carousel-slider>`.
  @param {string} pagination - none | dots | numbers | fraction | progress | controls
  @param {string} [align] - Pagination alignment.
  @param {boolean} [nav] - Show the arrows.
  @param {number} [size] - Button diameter in px for the controls bar.
  @param {boolean} [between] - Put the pagination between the two arrows instead of after them.
  @param {number} [count] - Slide count, for the controls bar's total before the script runs.

  @example
    {% render 'carousel-outside-controls',
       settings: s,
       carousel: carousel_id,
       pagination: cs_pagination,
       align: cs_pagination_align,
       nav: cs_nav,
       between: true %}
{% enddoc %}

{%- if pagination == 'controls' -%}
  {% render 'carousel-controls',
     count: count,
     settings: settings,
     carousel: carousel,
     align: align,
     size: size,
     arrows: nav %}
{%- else -%}
  {%- capture pagination_markup -%}
    {%- if pagination != 'none' -%}
      {%- assign pagination_motion = true -%}
      {%- if between and nav -%}{%- assign pagination_motion = false -%}{%- endif -%}
      {% render 'carousel-pagination',
         style: pagination,
         align: align,
         carousel: carousel,
         motion: pagination_motion %}
    {%- endif -%}
  {%- endcapture -%}

  {%- if between and nav -%}
    {% render 'carousel-nav',
       settings: settings,
       carousel: carousel,
       position: 'bottom',
       between: pagination_markup %}
  {%- else -%}
    {%- if nav -%}
      {% render 'carousel-nav',
         settings: settings,
         carousel: carousel,
         position: 'bottom' %}
    {%- endif -%}

    {{ pagination_markup }}
  {%- endif -%}
{%- endif -%}
