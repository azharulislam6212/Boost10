{% doc %}
  One product in the bundle picker, as a wide row — the product tile the drawing
  calls for, and the slide `snippets/carousel-shell.liquid` pages through.

  @param {product} [product] - Omit with `placeholder: true`.
  @param {boolean} [placeholder] - Draw the empty state.
  @param {number} [index] - Position in the list. Picks the placeholder picture.
  @param {boolean} [show_rating] - Default from `settings.show_rating`.
  @param {boolean} [show_quantity] - Default true.
  @param {number} [max_per_product] - The stepper's maximum.
  @param {string} [id_prefix] - Namespaces the quantity input's id. Required when two categories can render the same product.

  @example
    {% render 'bundle-row', product: product, index: forloop.index0, id_prefix: panel_id %}

  @example
    {% render 'bundle-row', placeholder: true, index: i, id_prefix: panel_id %}
{% enddoc %}

{%- liquid
  assign is_placeholder = false
  if placeholder or product == blank
    assign is_placeholder = true
  endif

  assign position = index | default: 0 | plus: 0
  assign prefix = id_prefix | default: 'bundle'

  assign with_rating = show_rating
  if with_rating == nil
    assign with_rating = section.settings.show_rating
  endif

  assign with_quantity = show_quantity
  if with_quantity == nil
    assign with_quantity = true
  endif

  assign quantity_max = max_per_product | default: section.settings.max_per_product | default: 4 | plus: 0

  assign card_scheme_classes = ''
  if section.settings.card_inherit_color_scheme == false and section.settings.card_color_scheme != blank
    assign card_scheme_classes = ' color-scheme-container color-' | append: section.settings.card_color_scheme
  endif
-%}

{%- if is_placeholder -%}
  {%- liquid
    assign art = position | modulo: 3 | plus: 1
    assign placeholder_image = 'product-apparel-' | append: art
    assign qty_id = prefix | append: '-placeholder-' | append: position | append: '-qty'
  -%}

  <li class="bundle-row carousel-shell__item{{ card_scheme_classes }}" data-bundle-row-placeholder>
    <div class="bundle-row__media">
      {{ placeholder_image | placeholder_svg_tag: 'bundle-row__image placeholder-svg' }}
    </div>

    <div class="bundle-row__body">
      <div class="bundle-row__head">
        <h3 class="bundle-row__title">{{ 'products.bundle.placeholder_title' | t }}</h3>

        <div class="badges badges--{{ settings.badge_position }} bundle-row__badges">
          <span class="badge badge--sale">{{ 'products.bundle.placeholder_badge' | t }}</span>
        </div>
      </div>

      {%- if with_rating -%}
        <div class="bundle-row__aside">
          {% render 'rating', value: 4.5, count: 24, class: 'bundle-row__rating' %}
        </div>
      {%- endif -%}

      <div class="bundle-row__foot">
        {%- if with_quantity -%}
          {% render 'quantity-selector',
             id: qty_id,
             min: 1,
             step: 1,
             max: quantity_max,
             size: 'compact',
             class: 'bundle-row__quantity',
             attributes: 'data-bundle-quantity' %}
        {%- endif -%}

        <span class="bundle-row__price">
          <span class="price">
            <span class="price__sale">{{ 2500 | money }}</span>
            <s class="price__compare">{{ 3200 | money }}</s>
          </span>
        </span>

        <button
          type="button"
          class="bundle-row__add"
          aria-pressed="false"
          disabled
          aria-label="{{ 'products.bundle.add' | t }}"
        >
          <span class="bundle-row__add-plus">{% render 'icon', icon: 'plus', size: 16 %}</span>
          <span class="bundle-row__add-check">{% render 'icon', icon: 'check', size: 16 %}</span>
          <span class="bundle-row__add-loader">{% render 'icon', icon: 'loader', size: 16 %}</span>
        </button>
      </div>
    </div>
  </li>
{%- else -%}
  {%- liquid
    assign variant = product.selected_or_first_available_variant

    assign needs_options = false
    if product.has_only_default_variant == false and product.variants.size > 1
      assign needs_options = true
    endif

    assign qty_id = prefix | append: '-' | append: product.id | append: '-qty'
  -%}

  <li
    class="bundle-row carousel-shell__item{{ card_scheme_classes }}"
    data-bundle-row
    data-product-id="{{ product.id }}"
    data-variant-id="{{ variant.id }}"
    data-product-url="{{ product.url }}"
    data-needs-options="{{ needs_options }}"
    data-price="{{ variant.price }}"
    data-compare-at-price="{{ variant.compare_at_price | default: 0 }}"
    data-title="{{ product.title | escape }}"
    data-image="{{ product.featured_image | image_url: width: 160 }}"
    {% unless variant.available %}data-unavailable{% endunless %}
  >
    <div class="bundle-row__media">
      {% render 'image',
         image: product.featured_image,
         alt: '',
         ratio: '1-1',
         sizes: '(min-width: 750px) 120px, 96px',
         class: 'bundle-row__image' %}
    </div>

    <div class="bundle-row__body">
      <div class="bundle-row__head">
        <h3 class="bundle-row__title">
          <a class="bundle-row__link" href="{{ product.url }}">{{ product.title | escape }}</a>
        </h3>

        {% render 'badge', product: product, variant: variant, class: 'bundle-row__badges' %}
      </div>

      {%- if with_rating -%}
        <div class="bundle-row__aside">
          {% render 'rating', product: product, class: 'bundle-row__rating' %}
        </div>
      {%- endif -%}

      <div class="bundle-row__foot">
        {%- if with_quantity -%}
          {% render 'quantity-selector',
             id: qty_id,
             min: 1,
             step: 1,
             max: quantity_max,
             size: 'compact',
             class: 'bundle-row__quantity',
             product_title: product.title,
             attributes: 'data-bundle-quantity' %}
        {%- endif -%}

        <span class="bundle-row__price">
          {% render 'price', variant: variant, context: 'card' %}
        </span>

        <button
          type="button"
          class="bundle-row__add"
          data-bundle-add
          aria-pressed="false"
          {% unless variant.available %}disabled{% endunless %}
          aria-label="{{ 'products.bundle.add' | t }}: {{ product.title | escape }}"
        >
          <span class="bundle-row__add-plus">{% render 'icon', icon: 'plus', size: 16 %}</span>
          <span class="bundle-row__add-check">{% render 'icon', icon: 'check', size: 16 %}</span>
          <span class="bundle-row__add-loader">{% render 'icon', icon: 'loader', size: 16 %}</span>
        </button>
      </div>
    </div>
  </li>
{%- endif -%}
