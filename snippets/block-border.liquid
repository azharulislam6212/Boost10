{% doc %}
  Emits border and radius custom properties from a block's settings.

  @example
    <div class="product-details" {% render 'block-border', settings: block.settings %}>
{% enddoc %}

{%- liquid
  assign thickness = settings.border_thickness | default: 0 | plus: 0
  assign radius = settings.border_radius | default: 0 | plus: 0

  assign declarations = ''

  if thickness > 0
    assign style = settings.border_style | default: 'solid'

    # `currentColor` rather than a hardcoded fallback: a merchant who sets a
    # thickness but no colour gets a border that matches the text of whatever
    # colour scheme the section is using, instead of a black line on a dark
    # background.
    assign color = settings.border_color | default: 'currentColor'

    assign declarations = declarations | append: '--block-border-width: ' | append: thickness | append: 'px;'
    assign declarations = declarations | append: '--block-border-style: ' | append: style | append: ';'
    assign declarations = declarations | append: '--block-border-color: ' | append: color | append: ';'
  endif

  if radius > 0
    assign declarations = declarations | append: '--block-border-radius: ' | append: radius | append: 'px;'
  endif
-%}

{%- if declarations != blank -%}
  style="{{ declarations }}" data-has-border
{%- endif -%}
