{% doc %}
  One labelled fact with a mark beside it: an email address, a phone number, a
  shop address. The contact row in the footer is three of these.
{% enddoc %}

{%- liquid
  assign icon_source = block.settings.icon_source | default: 'icon'
  capture icon_px
    render 'icon-size', size: block.settings.icon_size, custom: block.settings.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0
  assign value = block.settings.value

  assign href = ''
  case block.settings.link_type
    when 'email'
      assign href = 'mailto:' | append: value
    when 'phone'
      assign phone_href = value | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
      assign href = 'tel:' | append: phone_href
    when 'url'
      assign href = block.settings.link
  endcase

  capture item_spacing
    render 'spacing', block: block.settings, declarations: true
  endcapture
-%}

{%- capture icon_mark_style -%}
  {%- render 'icon-mark', block: block.settings, declarations: true, offset: 4 -%}
{%- endcapture -%}

<div
  class="utility-item icon-mark-host"
  data-icon-style="{{ block.settings.icon_background }}"
  data-block-spacing
  style="
    --utility-icon-size: {{ icon_size }}px;
    {%- if block.settings.icon_color != blank %}--utility-icon-color: {{ block.settings.icon_color }};{% endif -%}
    {%- if block.settings.icon_background_color != blank %}--utility-icon-bg: {{ block.settings.icon_background_color }};{% endif -%}
    {{- item_spacing | strip -}}
  "
  {{ block.shopify_attributes }}
>
  {%- if icon_source == 'image' and block.settings.icon_image != blank -%}
    <span
      class="utility-item__icon icon-mark"
      {% if block.settings.icon_image_alt == blank %}aria-hidden="true"{% endif %}
      style="{{ icon_mark_style | strip_newlines | strip }}"
    >
      {% render 'icon-mark', block: block.settings, offset: 4 %}
      {% render 'image',
         image: block.settings.icon_image,
         alt: block.settings.icon_image_alt,
         ratio: '1-1',
         sizes: '48px',
         widths: '48,96,144',
         class: 'utility-item__image',
         wrapper_class: 'utility-item__image-wrapper' %}
    </span>
  {%- elsif icon_source == 'icon' and block.settings.icon != blank -%}
    <span class="utility-item__icon icon-mark" aria-hidden="true" style="{{ icon_mark_style | strip_newlines | strip }}">
      {% render 'icon-mark', block: block.settings, offset: 4 %}
      {% render 'icon', icon: block.settings.icon, size: icon_size %}
    </span>
  {%- endif -%}

  <span class="utility-item__body">
    {%- if block.settings.label != blank -%}
      <span class="utility-item__label">{{ block.settings.label }}</span>
    {%- endif -%}

    {%- if value != blank -%}
      {%- if href != '' -%}
        <a class="utility-item__value" href="{{ href }}">{{ value }}</a>
      {%- else -%}
        <span class="utility-item__value">{{ value }}</span>
      {%- endif -%}
    {%- endif -%}
  </span>
</div>

