{% doc %}
  blocks/category-carousel.liquid — a row of framed category cards on the
  theme's <carousel-slider>, with the controls bar under it. Built for a tab of
  Shop by category, but sits in any section or group.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign cols_mobile = s.columns_mobile | plus: 0

  assign cs_count = block.blocks.size

  assign cs_layout = 'carousel'
  assign cs_layout_mobile = 'carousel'

  assign carousel_id = 'CategoryCarousel-' | append: block.id
  assign cs_label = 'accessibility.carousel' | t
-%}

{%- capture carousel_style -%}
  --category-gap: {{ s.gap }}px;
  --category-gap-mobile: {{ s.gap_mobile }}px;
  {%- if s.frame_color != blank -%}--category-frame: {{ s.frame_color }};{%- endif -%}
  {%- if s.pill_background != blank -%}--category-pill: {{ s.pill_background }};{%- endif -%}
  {%- if s.arrow_background != blank -%}--category-arrow: {{ s.arrow_background }};{%- endif -%}
  {%- if s.arrow_hover_background != blank -%}--category-arrow-hover: {{ s.arrow_hover_background }};{%- endif -%}
{%- endcapture -%}

{%- if cs_count > 0 -%}
  <div
    class="category-carousel"
    data-block-spacing
    data-motion-items
    style="{% render 'spacing', block: s, declarations: true %}{{ carousel_style | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    <carousel-slider
      {% render 'carousel-shell-attrs',
         settings: s,
         id: carousel_id,
         layout: cs_layout,
         layout_mobile: cs_layout_mobile,
         classes: 'category-carousel__carousel',
         columns_desktop: s.columns_desktop,
         columns_tablet: s.columns_tablet,
         columns_mobile: cols_mobile,
         peek_mobile: 30,
         count: cs_count %}
    >
      <div
        class="carousel-shell__track category-carousel__track"
        data-ref="track"
        aria-label="{{ cs_label | escape }}"
      >
        {% content_for 'blocks' %}
      </div>

      {% render 'carousel-shell-tail',
         settings: s,
         count: cs_count,
         layout: cs_layout,
         layout_mobile: cs_layout_mobile,
         nav_position: 'bottom',
         size: 28 %}
    </carousel-slider>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.category_carousel.name",
  "tag": null,
  "blocks": [
    {
      "type": "_category-card"
    }
  ],
