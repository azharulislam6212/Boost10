    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:shared.columns.tablet.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.columns.mobile.label",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:blocks.category_carousel.settings.gap_mobile.label",
      "min": 0,
      "max": 48,
      "step": 2,
