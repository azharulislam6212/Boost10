{% doc %}
  blocks/product-carousel.liquid — a strip of fixed-width product cards on the
  theme's <carousel-slider>, with the controls bar under it. Sized for the side
  of a hero: the cards keep their width, and the strip can run off the edge of
  the screen.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign product_limit = s.products_to_show
  assign product_source = s.collection.products
  if s.collection == blank
    assign product_source = collections.all.products
  endif

  assign cs_count = product_source | size
  if cs_count > product_limit
    assign cs_count = product_limit
  endif

  assign show_placeholders = false
  if cs_count == 0 and request.design_mode
    assign show_placeholders = true
    assign cs_count = 4
  endif

  assign carousel_id = 'ProductCarousel-' | append: block.id
  assign cs_label = 'accessibility.carousel' | t
  assign card_sizes = '(min-width: 750px) 280px, 240px'

  # Only a carousel in the first two sections can hold the LCP image. Further
  # down, an eager, high-priority first card only takes bandwidth from it.
  # section.index is nil on a Section Rendering API re-render: lazy then.
  assign first_view = false
  if section.index != nil and section.index <= 2
    assign first_view = true
  endif

  assign classes = 'product-carousel'
  if s.bleed
    assign classes = classes | append: ' product-carousel--bleed'
  endif
  if s.glass
    assign classes = classes | append: ' product-carousel--glass'
  endif
-%}

{%- capture carousel_style -%}
  --product-carousel-width: {{ s.width }}%;
  --product-carousel-gap: {{ s.gap }}px;
  --product-carousel-gap-mobile: {{ s.gap_mobile }}px;
  {%- if s.glass -%}
    --product-carousel-glass: {{ s.glass_background | default: 'rgba(15, 46, 47, 0.45)' }};
    --product-carousel-blur: {{ s.glass_blur }}px;
  {%- endif -%}
{%- endcapture -%}

{%- if cs_count > 0 -%}
  <div
    class="{{ classes }}"
    data-block-spacing
    style="{% render 'spacing', block: s, declarations: true %}{{ carousel_style | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    <carousel-slider
      {% render 'carousel-shell-attrs',
         settings: s,
         id: carousel_id,
         layout: 'carousel',
         layout_mobile: 'carousel',
         classes: 'product-carousel__carousel',
         columns_desktop: 2,
         columns_tablet: 2,
         columns_mobile: 1,
         count: cs_count %}
    >
      <div
        class="carousel-shell__track product-carousel__track"
        data-ref="track"
        aria-label="{{ cs_label | escape }}"
      >
        {%- if show_placeholders -%}
          {%- for i in (1..cs_count) -%}
            {% render 'product-card-placeholder', index: forloop.index0, ratio: s.image_ratio, sizes: card_sizes, block: s %}
          {%- endfor -%}
        {%- else -%}
          {%- for product in product_source limit: product_limit -%}
            {%- liquid
              assign card_priority = false
              if first_view and forloop.first
                assign card_priority = true
              endif
            -%}
            {% render 'product-card',
               product: product,
               index: forloop.index0,
               ratio: s.image_ratio,
               sizes: card_sizes,
               priority: card_priority,
               block: s %}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {% render 'carousel-shell-tail',
         settings: s,
         count: cs_count,
         layout: 'carousel',
         layout_mobile: 'carousel',
         nav_position: 'bottom',
         size: 32 %}
    </carousel-slider>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_carousel.name",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:blocks.product_carousel.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collection.settings.products_to_show.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "t:blocks.product_carousel.headers.size"
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:blocks.product_carousel.settings.width.label",
      "info": "t:blocks.product_carousel.settings.width.info",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 43
    },
    {
      "type": "checkbox",
      "id": "bleed",
      "label": "t:blocks.product_carousel.settings.bleed.label",
      "info": "t:blocks.product_carousel.settings.bleed.info",
      "default": true
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:blocks.category_carousel.settings.gap_mobile.label",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:blocks.category_carousel.headers.card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:blocks.product_carousel.settings.image_ratio.label",
      "options": [
        {
          "value": "1-1",
          "label": "t:blocks.product_carousel.settings.image_ratio.options__square"
        },
        {
          "value": "portrait",
          "label": "t:blocks.product_carousel.settings.image_ratio.options__portrait"
        },
        {
          "value": "3-4",
          "label": "t:blocks.product_carousel.settings.image_ratio.options__tall"
        }
      ],
      "default": "1-1"
    },
    {
      "type": "checkbox",
      "id": "glass",
      "label": "t:blocks.product_carousel.settings.glass.label",
      "default": true
    },
    {
      "type": "color_background",
      "id": "glass_background",
      "label": "t:blocks.product_carousel.settings.glass_background.label",
      "default": "rgba(15, 46, 47, 0.45)",
      "visible_if": "{{ block.settings.glass }}"
    },
    {
      "type": "range",
      "id": "glass_blur",
      "label": "t:sections.icon_with_text.settings.backdrop_blur.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.glass }}"
    },
    {
      "type": "header",
      "content": "t:sections.featured_blog.headers.carousel"
    },
    {
      "type": "checkbox",
      "id": "carousel_loop",
      "label": "t:shared.carousel.loop.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "t:shared.carousel.autoplay.label",
      "default": false
    },
    {
      "type": "range",
      "id": "carousel_autoplay_delay",
      "label": "t:blocks.showcase_column.settings.speed.label",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ block.settings.carousel_autoplay }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.navigation"
    },
    {
      "type": "checkbox",
      "id": "carousel_navigation",
      "label": "t:shared.carousel.navigation.label",
      "default": false
    },
    {
      "type": "select",
      "id": "carousel_nav_icon",
      "label": "t:shared.carousel.nav_glyph.label",
      "options": [
        {
          "value": "arrow",
          "label": "t:shared.carousel.nav_glyph.options__1.label"
        },
        {
          "value": "chevron",
          "label": "t:shared.carousel.nav_glyph.options__2.label"
        },
        {
          "value": "arrow-large",
          "label": "t:shared.carousel.nav_glyph.options__3.label"
        },
        {
          "value": "chevron-large",
          "label": "t:shared.carousel.nav_glyph.options__4.label"
        },
        {
          "value": "none",
          "label": "t:shared.carousel.nav_glyph.options__5.label"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.carousel_navigation }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_shape",
      "label": "t:shared.carousel.nav_shape.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.carousel.nav_shape.options__1.label"
        },
        {
          "value": "circle",
          "label": "t:shared.carousel.nav_shape.options__2.label"
        },
        {
          "value": "square",
          "label": "t:shared.carousel.nav_shape.options__3.label"
        }
      ],
      "default": "circle",
      "visible_if": "{{ block.settings.carousel_navigation }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_border_style",
      "label": "t:shared.carousel.nav_border_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.options.dashed"
        },
        {
          "value": "none",
          "label": "t:shared.options.none"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.carousel_navigation and block.settings.carousel_nav_shape != 'none' }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_style",
      "label": "t:shared.carousel.controls_style.label",
      "options": [
        {
          "value": "split",
          "label": "t:shared.carousel.controls_style.options__1.label"
        },
        {
          "value": "ghost",
          "label": "t:shared.carousel.controls_style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:shared.carousel.controls_style.options__3.label"
        }
      ],
      "default": "ghost",
      "visible_if": "{{ block.settings.carousel_navigation }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.pagination"
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "t:shared.carousel.pagination.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.carousel.pagination.options__1.label"
        },
        {
          "value": "dots",
          "label": "t:shared.carousel.pagination.options__2.label"
        },
        {
          "value": "numbers",
          "label": "t:shared.carousel.pagination.options__3.label"
        },
        {
          "value": "progress",
          "label": "t:shared.carousel.pagination.options__4.label"
        },
        {
          "value": "controls",
          "label": "t:shared.carousel.pagination.options__5.label"
        }
      ],
      "default": "controls"
    },
    {
      "type": "select",
      "id": "carousel_pagination_align",
      "label": "t:shared.carousel.pagination_align.label",
      "options": [
        {
          "value": "start",
          "label": "t:shared.carousel.controls_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:shared.carousel.controls_align.options__2.label"
        },
        {
          "value": "end",
          "label": "t:shared.carousel.controls_align.options__3.label"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.carousel_pagination != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.controls"
    },
    {
      "type": "checkbox",
      "id": "carousel_inherit_scheme",
      "label": "t:shared.carousel.inherit_scheme.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "carousel_color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product_carousel.name",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
