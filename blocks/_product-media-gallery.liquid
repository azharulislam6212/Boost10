

{%- liquid
  assign product = closest.product
  unless product
    break
  endunless
-%}

{%- if product -%}
  {% render 'product-media',
     product: product,
     section: section,
     settings: block.settings,  
     block_shopify_attributes: block.shopify_attributes%}
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_media_gallery.name",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_gallery",
      "default": false,
      "label": "t:blocks.product_media_gallery.settings.sticky_gallery.label"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "t:settings_schema.product_media.settings.gallery_layout.label",
      "options": [
        {
          "value": "carousel",
          "label": "t:blocks.product_media_gallery.settings.gallery_layout.options__1.label"
        },
        {
          "value": "stacked",
          "label": "t:settings_schema.product_media.settings.gallery_layout.options__3.label"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "gallery_image_ratio",
      "label": "t:settings_schema.product_media.settings.gallery_image_ratio.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:settings_schema.product_media.settings.gallery_image_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:settings_schema.product_media.settings.gallery_image_ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:settings_schema.product_media.settings.gallery_image_ratio.options__3.label"
        },
        {
          "value": "tall",
          "label": "t:settings_schema.product_media.settings.gallery_image_ratio.options__4.label"
        },
        {
          "value": "long",
          "label": "t:settings_schema.product_media.settings.gallery_image_ratio.options__5.label"
        }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "gallery_gap",
      "label": "t:blocks.product_media_gallery.settings.gallery_gap.label",
      "visible_if": "{{ block.settings.gallery_layout == 'stacked' }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "gallery_full_width_first",
      "label": "t:blocks.product_media_gallery.settings.gallery_full_width_first.label",
      "visible_if": "{{ block.settings.gallery_layout  == 'stacked' }}",
      "default": false
    },
    {
      "type": "select",
      "id": "navigation",
      "label": "t:blocks.product_media_gallery.settings.navigation.label",
      "visible_if": "{{ block.settings.gallery_layout  == 'carousel' }}",
      "options": [
        {
          "label": "t:shared.none.label",
          "value": "none"
        },
        {
          "label": "t:blocks.product_media_gallery.settings.navigation.options__2.label",
          "value": "arrows"
        },
        {
          "label": "t:blocks.product_media_gallery.settings.navigation.options__3.label",
          "value": "chevrons"
        }
      ],
      "default": "arrows"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "t:blocks.product_media_gallery.settings.pagination_type.label",
      "visible_if": "{{ block.settings.gallery_layout  == 'carousel' }}",
      "options": [
        {
          "label": "t:blocks.product_media_gallery.settings.pagination_type.options__1.label",
          "value": "bullets"
        },
        {
          "label": "t:blocks.product_media_gallery.settings.pagination_type.options__2.label",
          "value": "fraction"
        },
        {
          "label": "t:blocks.product_media_gallery.settings.pagination_type.options__3.label",
          "value": "thumbnails"
        }
      ],
      "default": "thumbnails"
    },
    {
      "type": "select",
      "id": "thumbnails_position",
      "label": "t:blocks.product_media_gallery.settings.thumbnails_position.label",
      "visible_if": "{{ block.settings.gallery_layout  == 'carousel' }}",
      "options": [
        {
          "value": "thumbnails-below",
          "label": "t:settings_schema.product_media.settings.gallery_layout.options__1.label"
        },
        {
          "value": "thumbnails-start",
          "label": "t:settings_schema.product_media.settings.gallery_layout.options__2.label"
        },
        {
          "value": "thumbnails-end",
          "label": "t:settings_schema.product_media.settings.gallery_layout.options__4.label"
        }
      ],
      "default": "thumbnails-below"
    },
    {
      "type": "select",
      "id": "thumbnail_size",
      "label": "t:blocks.product_media_gallery.settings.thumbnail_size.label",
      "visible_if": "{{ block.settings.gallery_layout == 'carousel'  }}",
      "options": [
        {
          "value": "small",
          "label": "t:blocks.product_media_gallery.settings.thumbnail_size.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:blocks.product_media_gallery.settings.thumbnail_size.options__2.label"
        },
        {
          "value": "large",
          "label": "t:blocks.product_media_gallery.settings.thumbnail_size.options__3.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "thumbnail_style",
      "label": "t:blocks.product_media_gallery.settings.thumbnail_style.label",
      "visible_if": "{{ block.settings.gallery_layout == 'carousel'  }}",
      "options": [
        {
          "value": "round",
          "label": "t:blocks.product_media_gallery.settings.thumbnail_style.options__1.label"
        },
        {
          "value": "circle",
          "label": "t:blocks.product_media_gallery.settings.thumbnail_style.options__2.label"
        },
        {
          "value": "none",
          "label": "t:shared.none.label"
        }
      ],
      "default": "circle"
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "t:settings_schema.product_media.settings.enable_image_zoom.label",
      "info": "t:settings_schema.product_media.settings.enable_image_zoom.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_gallery_loop",
      "label": "t:settings_schema.product_media.settings.enable_gallery_loop.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "default": false,
      "label": "t:blocks.product_media_gallery.settings.hide_variants.label"
    },
    {
      "type": "header",
      "content": "t:settings_schema.product_media.headers.filter_images"
    },
    {
      "type": "paragraph",
      "content": "t:settings_schema.product_media.paragraphs.filter_images"
    },
    {
      "type": "checkbox",
      "id": "enable_filter_images",
      "label": "t:settings_schema.product_media.settings.enable_filter_images.label",
      "info": "t:settings_schema.product_media.settings.enable_filter_images.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "filter_images_strict",
      "label": "t:settings_schema.product_media.settings.filter_images_strict.label",
      "info": "t:settings_schema.product_media.settings.filter_images_strict.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
