{% doc %}
  The border, corners and backdrop of a group, written as custom properties the
  group folds into its own style attribute.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign line = s.border_style | default: 'none'
  assign width = 0

  if line != 'none'
    assign width = s.border_width | default: 1 | plus: 0

    assign percent = s.border_opacity | default: 100 | plus: 0
    if s.border_color == blank
      assign paint = 'color-mix(in srgb, currentColor ' | append: percent | append: '%, transparent)'
    else
      assign alpha = percent | divided_by: 100.0
      assign paint = s.border_color | color_modify: 'alpha', alpha
    endif
  endif

  assign blur = s.backdrop_blur | default: 0 | plus: 0
-%}
{%- if s.background_color != blank -%}
  --group-background: {{ s.background_color }};
{%- endif -%}
{%- if s.text_color != blank -%}
  color: {{ s.text_color }};
{%- endif -%}
--group-radius: {{ s.border_radius | default: 0 | plus: 0 }}px;
{%- if width > 0 -%}
  --group-border-width: {{ width }}px;
  --group-border-style: {{ line }};
  --group-border-color: {{ paint }};
{%- endif -%}
{%- if blur > 0 -%}
  --group-backdrop-blur: {{ blur }}px;
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.block_frame.name",
  "tag": null,
  "settings": [
    {
      "type": "color_background",
      "id": "background_color",
      "label": "t:shared.background.color.label",
      "info": "t:shared.background.color.info"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.card_content.settings.text_color.label",
      "info": "t:blocks.featured_pills_group.settings.text_color.info"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.group.settings.border_style.options__1.label"
        },
        {
          "value": "solid",
          "label": "t:blocks.group.settings.border_style.options__2.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:blocks.group.settings.border_width.label",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border_style == 'solid' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "t:shared.border.opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.group.settings.border_color.label",
      "visible_if": "{{ block.settings.border_style == 'solid' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:blocks.group.settings.border_radius.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "backdrop_blur",
      "label": "t:blocks.card_content.settings.backdrop_blur.label",
      "info": "t:blocks.card_content.settings.backdrop_blur.info",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
