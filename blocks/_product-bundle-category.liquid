{% doc %}
  blocks/_product-bundle-category.liquid — private.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign collection = s.collection
  assign limit = s.products_limit | default: 6 | plus: 0

  assign show_rating = section.settings.show_rating
  assign show_quantity = section.settings.show_row_quantity
  assign max_per_product = section.settings.max_per_product | default: 4 | plus: 0

  assign label = s.label
  if label == blank
    assign label = 'products.bundle.category_placeholder' | t
  endif

  assign panel_id = 'bundle-panel-' | append: block.id
  assign carousel_id = 'bundle-carousel-' | append: block.id
  assign tab_id = 'bundle-tab-' | append: block.id

  assign pill_icon_allowed = 'star,check,heart,tag,truck,refresh,lock,clock,location,mail,note,info,shield,grid,moon,leaf,droplet,bolt,brain,pulse,sun,sparkle'
  assign pill_icon_haystack = ',' | append: pill_icon_allowed | append: ','
  assign pill_icon_needle = ',' | append: s.icon | append: ','

  assign pill_icon = s.icon
  unless pill_icon_haystack contains pill_icon_needle
    assign pill_icon = 'heart'
  endunless

  assign has_pill_icon = true
  if s.icon_source == 'none'
    assign has_pill_icon = false
  endif

  capture pill_icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign pill_icon_size = pill_icon_px | plus: 0 | at_least: 10

  assign rows = section.settings.rows_per_view | default: 3 | plus: 0
  assign rows_mobile = section.settings.rows_per_view_mobile | default: 2 | plus: 0

  assign placeholder_rows = limit | at_least: 1

  assign has_products = false
  if collection != blank and collection.products.size > 0
    assign has_products = true
  endif

  assign slide_count = placeholder_rows
  if has_products
    assign slide_count = collection.products.size | at_most: limit
  endif
-%}

{%- capture rows_markup -%}
  {%- if has_products -%}
    {%- for product in collection.products limit: limit -%}
      {% render 'bundle-row',
         product: product,
         index: forloop.index0,
         show_rating: show_rating,
         show_quantity: show_quantity,
         max_per_product: max_per_product,
         id_prefix: panel_id %}
    {%- endfor -%}
  {%- else -%}

    {%- for i in (1..placeholder_rows) -%}
      {% render 'bundle-row',
         placeholder: true,
         index: forloop.index0,
         show_rating: show_rating,
         show_quantity: show_quantity,
         max_per_product: max_per_product,
         id_prefix: panel_id %}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture pill_style -%}
  {%- if s.tab_background != blank -%}--bundle-tab-background: {{ s.tab_background }};{%- endif -%}
  {%- if s.tab_color != blank -%}--bundle-tab-color: {{ s.tab_color }};{%- endif -%}
  {%- if s.tab_active_background != blank -%}--bundle-tab-active-background: {{ s.tab_active_background }};{%- endif -%}
  {%- if s.tab_active_color != blank -%}--bundle-tab-active-color: {{ s.tab_active_color }};{%- endif -%}
{%- endcapture -%}

<div class="product-bundle__cat" data-bundle-category>

  <input
    class="product-bundle__pill-input"
    type="radio"
    name="bundle-strip-{{ section.id }}"
    id="{{ tab_id }}"
    aria-controls="{{ panel_id }}"
  >

  <label
    class="product-bundle__pill"
    id="{{ tab_id }}-label"
    for="{{ tab_id }}"
    style="{{ pill_style | strip_newlines | strip }}"
  >
    {%- if has_pill_icon -%}
      <span class="product-bundle__pill-icon">{% render 'icon', icon: pill_icon, size: pill_icon_size %}</span>
    {%- endif -%}
    <span class="product-bundle__pill-label">{{ label }}</span>
  </label>

<div
  class="product-bundle__panel{% unless has_products %} product-bundle__panel--placeholder{% endunless %}"
  id="{{ panel_id }}"
  role="region"
  aria-labelledby="{{ tab_id }}-label"
  data-bundle-panel
  data-block-id="{{ block.id }}"
  data-label="{{ label | escape }}"
  {% render 'spacing', block: s %}
  {{ block.shopify_attributes }}
>

  {% render 'carousel-shell',
     id: carousel_id,
     children: rows_markup,
     direction: 'vertical',
     detached: true,
     layout: 'carousel',
     layout_mobile: 'carousel',
     tag: 'ul',
     label: label,
     classes: 'product-bundle__carousel',
     track_classes: 'product-bundle__list',
     columns_desktop: rows,
     columns_tablet: rows,
     columns_mobile: rows_mobile,
     gap_css: 'var(--bundle-row-gap)',
     count: slide_count,
     settings: section.settings %}

  {%- liquid
    assign has_controls = false
    if section.settings.carousel_navigation or section.settings.carousel_pagination != 'none'
      assign has_controls = true
    endif
  -%}

  {%- if has_controls -%}
  <div class="product-bundle__controls">
    {%- if section.settings.carousel_pagination == 'controls' -%}
      {% render 'carousel-controls',
         settings: section.settings,
         carousel: carousel_id,
         align: section.settings.carousel_pagination_align %}
    {%- else -%}
      {%- if section.settings.carousel_navigation -%}
        {% render 'carousel-nav', settings: section.settings, carousel: carousel_id %}
      {%- endif -%}

      {%- if section.settings.carousel_pagination != 'none' -%}
        {% render 'carousel-pagination',
           style: section.settings.carousel_pagination,
           align: section.settings.carousel_pagination_align,
           carousel: carousel_id %}
      {%- endif -%}
    {%- endif -%}
  </div>
  {%- endif -%}
</div>
</div>

{% schema %}
{
  "name": "t:blocks.product_bundle_category.name",
  "tag": null,

  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.product_bundle_category.paragraph"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.product_bundle_category.settings.label.label",
      "info": "t:blocks.product_bundle_category.settings.label.info"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "t:blocks.product_bundle_category.settings.products_limit.label",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 6
    },

    { "type": "header", "content": "t:blocks.subheading.headers.icon" },
    {
      "type": "select",
      "id": "icon_source",
      "label": "t:blocks.subheading.settings.icon_source.label",
      "options": [
        { "value": "none", "label": "t:shared.none.label" },
        { "value": "icon", "label": "t:blocks.subheading.settings.icon_source.options__2.label" }
      ],
      "default": "icon"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:blocks.subheading.settings.icon.label",
      "options": [
        { "value": "star", "label": "t:blocks.subheading.settings.icon.options__1.label" },
        { "value": "check", "label": "t:blocks.subheading.settings.icon.options__2.label" },
        { "value": "heart", "label": "t:blocks.subheading.settings.icon.options__3.label" },
        { "value": "tag", "label": "t:blocks.subheading.settings.icon.options__4.label" },
        { "value": "truck", "label": "t:blocks.subheading.settings.icon.options__5.label" },
        { "value": "refresh", "label": "t:blocks.subheading.settings.icon.options__6.label" },
        { "value": "lock", "label": "t:blocks.subheading.settings.icon.options__7.label" },
        { "value": "clock", "label": "t:blocks.subheading.settings.icon.options__8.label" },
        { "value": "location", "label": "t:blocks.subheading.settings.icon.options__9.label" },
        { "value": "mail", "label": "t:blocks.subheading.settings.icon.options__10.label" },
        { "value": "note", "label": "t:blocks.subheading.settings.icon.options__11.label" },
        { "value": "info", "label": "t:blocks.subheading.settings.icon.options__12.label" },
        { "value": "shield", "label": "t:blocks.product_bundle_category.settings.icon.options__13.label" },
        { "value": "grid", "label": "t:blocks.product_bundle_category.settings.icon.options__14.label" },
        { "value": "moon", "label": "t:blocks.product_bundle_category.settings.icon.options__15.label" },
        { "value": "leaf", "label": "t:blocks.product_bundle_category.settings.icon.options__16.label" },
        { "value": "droplet", "label": "t:blocks.product_bundle_category.settings.icon.options__17.label" },
        { "value": "bolt", "label": "t:blocks.product_bundle_category.settings.icon.options__18.label" },
        { "value": "brain", "label": "t:blocks.product_bundle_category.settings.icon.options__19.label" },
        { "value": "pulse", "label": "t:blocks.product_bundle_category.settings.icon.options__20.label" },
        { "value": "sun", "label": "t:blocks.product_bundle_category.settings.icon.options__21.label" },
        { "value": "sparkle", "label": "t:blocks.product_bundle_category.settings.icon.options__22.label" }
      ],
      "default": "heart",
      "visible_if": "{{ block.settings.icon_source == 'icon' }}"
    },
    {
      "type": "select",
      "id": "icon_size",
      "label": "t:blocks.subheading.settings.icon_size.label",
      "options": [
        { "value": "extra_small", "label": "t:shared.icon_size.options__1.label" },
        { "value": "small", "label": "t:shared.icon_size.options__2.label" },
        { "value": "medium", "label": "t:shared.icon_size.options__3.label" },
        { "value": "large", "label": "t:shared.icon_size.options__4.label" },
        { "value": "extra_large", "label": "t:shared.icon_size.options__5.label" },
        { "value": "custom", "label": "t:shared.icon_size.options__6.label" }
      ],
      "default": "custom",
      "visible_if": "{{ block.settings.icon_source == 'icon' }}"
    },
    {
      "type": "range",
      "id": "icon_size_custom",
      "label": "t:shared.icon_size.custom.label",
      "info": "t:shared.icon_size.custom.info",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14,
      "visible_if": "{{ block.settings.icon_source == 'icon' and block.settings.icon_size == 'custom' }}"
    },

    { "type": "header", "content": "t:blocks.product_bundle_category.headers.pill" },
    { "type": "paragraph", "content": "t:blocks.product_bundle_category.paragraphs.pill" },
    {
      "type": "color",
      "id": "tab_background",
      "label": "t:sections.product_bundle.settings.tab_background.label"
    },
    {
      "type": "color",
      "id": "tab_color",
      "label": "t:blocks.tabs.settings.tab_color.label"
    },
    {
      "type": "color",
      "id": "tab_active_background",
      "label": "t:sections.product_bundle.settings.tab_active_background.label"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "t:blocks.tabs.settings.tab_active_color.label"
    },

    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
