{% doc %}
  blocks/_featured-collection-pill.liquid — private to `sections/featured-collection-pills.liquid`.
  One pill, and the panel of that collection's products it opens.
  Cards come from the static `product-card` block, one per pill.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign ss = section.settings

  assign label = s.label | default: s.collection.title
  if label == blank
    assign label = 'collections.category.featured' | t
  endif

  assign desktop = ss.columns_desktop | default: 4 | plus: 0
  assign cols_tablet = ss.columns_tablet | default: 2 | plus: 0
  assign cols_mobile = ss.columns_mobile | default: 1 | plus: 0

  assign cs_layout = 'grid'
  if ss.layout == 'carousel'
    assign cs_layout = 'carousel'
  endif

  assign carousel_on_mobile = ss.carousel_on_mobile
  if carousel_on_mobile == nil
    assign carousel_on_mobile = true
  endif

  assign cs_layout_mobile = 'grid'
  if cs_layout == 'carousel' or carousel_on_mobile
    assign cs_layout_mobile = 'carousel'
  endif

  assign cs_is_carousel = false
  if cs_layout == 'carousel' or cs_layout_mobile == 'carousel'
    assign cs_is_carousel = true
  endif

  assign product_limit = ss.products_to_show | default: 4
  assign product_source = s.collection.products
  assign show_placeholder = false
  assign cs_count = product_source | size
  if s.collection == blank or cs_count == 0
    assign show_placeholder = true
    assign cs_count = product_limit
  endif
  if cs_count > product_limit
    assign cs_count = product_limit
  endif

  if cs_layout == 'carousel' and cs_count <= desktop
    assign cs_layout = 'grid'
  endif

  assign panel_id = 'FeaturedCollectionPill-' | append: block.id
  assign carousel_id = panel_id | append: '-carousel'
  assign track_label = label

  assign vw_desktop = 100 | divided_by: desktop
  assign vw_tablet = 100 | divided_by: cols_tablet
  assign vw_mobile = 100 | divided_by: cols_mobile
  assign card_sizes = '(min-width: 990px) ' | append: vw_desktop | append: 'vw, (min-width: 750px) ' | append: vw_tablet | append: 'vw, ' | append: vw_mobile | append: 'vw'
-%}

{%- capture tab_content -%}
  {%- if s.icon != blank and s.icon != 'none' -%}
    <span class="featured-collection-pills__icon">{% render 'icon', icon: s.icon, size: 14 %}</span>
  {%- endif -%}
  <span class="tabs__tab-label">{{ label | escape }}</span>
{%- endcapture -%}

{%- render 'tab-button', panel_id: panel_id, content: tab_content, selected: s.selected -%}
<div
  class="tabs__panel featured-collection-pills__panel"
  role="tabpanel"
  id="{{ panel_id }}"
  aria-labelledby="{{ panel_id }}-tab"
  data-tab-panel
  tabindex="0"
  {{ block.shopify_attributes }}
>
  <carousel-slider
    {% render 'carousel-shell-attrs',
       settings: ss,
       id: carousel_id,
       layout: cs_layout,
       layout_mobile: cs_layout_mobile,
       classes: 'featured-collection-pills__carousel',
       columns_desktop: desktop,
       columns_tablet: cols_tablet,
       columns_mobile: cols_mobile,
       count: cs_count %}
  >
    <div
      class="carousel-shell__track featured-collection-pills__grid"
      data-ref="track"
      {% if cs_is_carousel %}aria-label="{{ track_label | escape }}"{% endif %}
    >
      {%- if show_placeholder -%}
        {%- for i in (1..cs_count) -%}
          {% content_for 'block',
            type: '_product-card',
            id: 'product-card',
            placeholder: true,
            index: forloop.index0,
            sizes: card_sizes,
            card_attributes: 'data-panel-item'
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for product in product_source limit: product_limit -%}
          {% content_for 'block',
            type: '_product-card',
            id: 'product-card',
            product: product,
            index: forloop.index0,
            sizes: card_sizes,
            card_attributes: 'data-panel-item'
          %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {% render 'carousel-shell-tail', settings: ss, count: cs_count, layout: cs_layout, layout_mobile: cs_layout_mobile %}
  </carousel-slider>
</div>

