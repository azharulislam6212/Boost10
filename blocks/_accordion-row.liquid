{% doc %}
  One row of an **Accordion** — a question, or any other short label, and
  whatever answers it. Icon size, shape and ring come from the Accordion.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign question = s.question
  assign icon_source = s.icon_source

  assign has_icon = false
  if icon_source == 'icon' and s.icon != blank
    assign has_icon = true
  endif
  if icon_source == 'image' and s.icon_image != blank
    assign has_icon = true
  endif

  assign question_classes = 'accordion-row__question block-text--' | append: s.preset
  if s.color == 'gradient'
    assign question_classes = question_classes | append: ' block-text--gradient'
  endif

  capture question_style
    render 'block-typography', block: s
  endcapture
-%}

{%- if question != blank -%}
  {%- capture row_style -%}
    {%- render 'spacing', block: s, declarations: true -%}
  {%- endcapture -%}

  <motion-effect
    class="accordion-row-motion"
    {% render 'motion-attrs', kind: 'content', block: s, duration: 1000, block_level: true %}
  >
  <details
    class="accordion-row icon-mark-host{% if has_icon %} accordion-row--has-icon{% endif %}"
    {% if s.open_by_default %}open data-default-open{% endif %}
    data-block-spacing
    style="{{ row_style | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    <summary class="accordion-row__summary">
      {%- if has_icon -%}
        <span class="accordion-row__icon icon-mark">
          <svg class="icon-mark__ring accordion-row__ring" fill="none" aria-hidden="true" focusable="false">
            <circle class="accordion-row__ring-circle" stroke="currentColor" />
            <rect class="accordion-row__ring-square" stroke="currentColor" />
          </svg>
          {%- if icon_source == 'image' -%}
            {% render 'image',
               image: s.icon_image,
               sizes: '48px',
               wrapper_class: 'accordion-row__icon-image' %}
          {%- else -%}
            {% render 'icon', icon: s.icon, class: 'accordion-row__glyph' %}
          {%- endif -%}
        </span>
      {%- endif -%}

      <span class="{{ question_classes }}" style="{{ question_style | strip_newlines | strip }}">
        {{- question -}}
      </span>

      <span class="accordion-row__toggle" aria-hidden="true">
        {% render 'icon', icon: 'chevron-down', size: 14, class: 'accordion-row__chevron' %}
        {% render 'icon', icon: 'plus', size: 14, class: 'accordion-row__plus' %}
      </span>
    </summary>

    <div class="accordion-row__panel">
      <div class="accordion-row__answer">
        {% content_for 'blocks' %}
      </div>
    </div>
  </details>
  </motion-effect>
{%- endif -%}

{% stylesheet %}
@layer components {
  html[dir='rtl'] .accordion-row[open] > .accordion-row__summary .accordion-row__chevron {
    transform: scaleX(-1) rotate(-180deg);
  }
  .accordion-row {
    --accordion-row-tile: var(--accordion-row-background, var(--color-secondary-background));

    border-radius: calc(var(--accordion-row-radius, var(--radius-card, 14px)) + 4px);
    outline: var(--accordion-row-border-width, 0) var(--accordion-row-border-style, solid) transparent;
    outline-offset: 4px;
    transition: outline-color var(--transition-base);
  }
  .accordion-row[open] {
    outline-color: var(--accordion-row-border-color, transparent);
  }
  .accordion-row__summary {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--accordion-row-radius, var(--radius-card, 14px));
    background-color: var(--accordion-row-tile);
    cursor: pointer;
    list-style: none;
  }
  .accordion-row__summary::-webkit-details-marker { display: none; }
  .accordion-row__summary::marker { content: ''; }
  .accordion-row__summary:focus-visible {
    outline: var(--focus-ring);
    outline-offset: calc(var(--focus-offset) * -1);
    border-radius: var(--radius-card, 14px);
  }
  .accordion-row__icon {
    --icon-mark-own-size: var(--accordion-row-icon-box, 28px);
    --icon-mark-own-radius: 6px;
    --icon-mark-own-fill: color-mix(in srgb, var(--accordion-accent) 20%, transparent);
    --icon-mark-own-color: var(--color-heading);

    --icon-mark-own-ring-color: color-mix(in srgb, var(--accordion-accent) 45%, transparent);

    --icon-mark-size-desktop: var(--accordion-mark-size-desktop);
    --icon-mark-size-mobile: var(--accordion-mark-size-mobile);
    --icon-mark-radius: var(--accordion-mark-radius);
    --icon-mark-fill: var(--accordion-mark-fill);
    --icon-mark-fill-hover: var(--accordion-mark-fill-hover);
    --icon-mark-color: var(--accordion-mark-color);
    --icon-mark-color-hover: var(--accordion-mark-color-hover);
    --icon-mark-ring-color: var(--accordion-mark-ring-color);
    --icon-mark-frame: var(--accordion-mark-frame);
  }
  .accordion-row__icon > .accordion-row__glyph {
    inline-size: var(--accordion-row-icon-size, 1.6rem);
    block-size: var(--accordion-row-icon-size, 1.6rem);
  }
  .accordion-row__ring {
    display: none;
    overflow: visible;
  }
  .accordion-row__ring > * {
    display: none;
    stroke-width: var(--accordion-ring-width, 1px);
    stroke-dasharray: var(--accordion-ring-dash, none);
    stroke-linecap: var(--accordion-ring-cap, butt);
  }
  .accordion-row__ring-circle {
    cx: 50%;
    cy: 50%;
    r: calc(50% - var(--accordion-ring-width, 1px) / 2);
  }
  .accordion-row__ring-square {
    x: calc(var(--accordion-ring-width, 1px) / 2);
    y: calc(var(--accordion-ring-width, 1px) / 2);
    width: calc(100% - var(--accordion-ring-width, 1px));
    height: calc(100% - var(--accordion-ring-width, 1px));
    rx: var(--icon-mark-corner, 0px);
  }
  .accordion-row__icon-image { inline-size: var(--accordion-row-icon-size, 16px); }
  .accordion-row__question,
  .accordion-row__answer {
    text-align: var(--accordion-align, start);
  }
  .accordion-row__question {
    flex: 1 1 auto;
    font-family: var(--block-font-family, inherit);
    font-size: var(--block-font-size, inherit);
    font-weight: var(--block-font-weight, 500);
    line-height: var(--block-line-height, inherit);
    letter-spacing: var(--block-letter-spacing, inherit);
    text-transform: var(--block-text-transform, inherit);
    color: var(--block-text-color, var(--color-heading));
  }
  @media screen and (max-width: 749px) {
    .accordion-row__question {
      font-size: var(--block-font-size-mobile, var(--block-font-size, inherit));
    }
  }
  .accordion-row__question.block-text--gradient {
    background-image: var(--block-text-gradient, var(--gradient-primary));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (forced-colors: active) {
    .accordion-row__question.block-text--gradient {
      background-image: none;
      color: CanvasText;
    }
  }
  .accordion-row__toggle {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    inline-size: 2.4rem;
    block-size: 2.4rem;
    border: var(--accordion-row-border-width, 0) var(--accordion-row-border-style, solid)
      var(--accordion-accent);
    border-radius: 8px;
    background-color: transparent;
    color: var(--color-heading);
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base);
  }
  .accordion-row[open] > .accordion-row__summary .accordion-row__toggle {
    border-color: transparent;
    background-color: var(--accordion-accent);
    color: var(--color-primary-button-outline-icon);
  }
  .accordion-row__plus { stroke-width: 2; }
  .accordion-row__chevron { display: none; transition: transform var(--transition-base); }
  .accordion-row[open] > .accordion-row__summary .accordion-row__chevron { transform: rotate(180deg); }
  .accordion-row__panel {
    padding-block-start: var(--space-1);
  }
  .accordion-row__answer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--accordion-row-radius, var(--radius-card, 14px));
    background-color: var(--accordion-row-tile);
    color: var(--color-text);
    min-inline-size: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .accordion-row__plus,
    .accordion-row__plus .icon__bar,
    .accordion-row__chevron,
    .accordion-row__toggle { transition: none; }
  }
}
@layer components {
  .product-details .accordion-row[open] {
    --accordion-row-tile: var(--color-heading);
    border-radius: 1.6rem;
    background-color: var(--color-heading);
    color: var(--color-background);
  }
  .product-details .accordion-row[open] > .accordion-row__summary { color: var(--color-background); }
  .product-details .accordion-row[open] .accordion-row__panel,
  .product-details .accordion-row[open] .accordion-row__answer { background-color: transparent; color: var(--color-background); }
  .product-details .accordion-row[open] .accordion-row__panel :is(p, strong, h1, h2, h3, h4, h5, h6) { color: inherit; }
}
{% endstylesheet %}

