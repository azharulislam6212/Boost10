{% doc %}
  The per-slot discount codes, as the JSON payload the bundle element reads.
  Static, so the codes sit beside the section instead of lengthening its list.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign slots = section.settings.bundle_size | default: 6 | plus: 0

  assign entries = ''
  for i in (1..slots)
    assign code_key = 'tier_' | append: i | append: '_code'
    assign type_key = 'tier_' | append: i | append: '_value_type'
    assign percent_key = 'tier_' | append: i | append: '_discount_percent'
    assign amount_key = 'tier_' | append: i | append: '_discount_amount'

    assign code = s[code_key] | default: '' | strip
    assign type = s[type_key] | default: 'percentage'

    assign value = 0
    if type == 'amount'
      assign value = s[amount_key] | default: 0 | times: 100 | round
    else
      assign value = s[percent_key] | default: 0 | plus: 0
    endif

    if code != blank or value > 0
      capture entry
        echo '{"slot":'
        echo i
        echo ',"code":'
        echo code | json
        echo ',"type":'
        echo type | json
        echo ',"value":'
        echo value
        echo '}'
      endcapture
      assign entries = entries | append: entry | append: '||'
    endif
  endfor
  assign entries = entries | split: '||' | join: ','
-%}

<script type="application/json" data-bundle-discounts>
  [{{ entries }}]
</script>

