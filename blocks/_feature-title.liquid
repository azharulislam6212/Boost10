{% doc %}
  blocks/_feature-title.liquid — private to `blocks/_feature-card.liquid`.

  The line that names the feature.

  ## It is the Text block's typography, by reference

  The root carries `.block-text` and `.block-text--<preset>`, and the colour and
  the Custom preset come from `snippets/block-typography.liquid`. So the presets
  here *are* the presets in Theme settings › Typography: changing Heading 5
  there moves every card on that preset, with nothing to re-render and no second
  copy of the type map in this file.

  What this block adds to a Text block is the two things a Text block cannot
  know about: the heading level, and the line clamp.

  ## Level and size are two settings because they are two questions

  A feature row under an `h2` section heading wants `h3`; the same row as the
  only thing on a landing page wants `h2`. Nothing here can see which, so the
  merchant says — and the *size* is the preset, chosen separately, so an `h4`
  that has to look like an `h5` does not have to lie about its level to a screen
  reader or to Google.

  `p` is offered as a level for the case where the card sits under a heading
  that already covers it and a fourth `h3` on the page would be noise.

  ## Clamping is off by default

  A feature title is two or three words. A clamp exists for the merchant who
  writes a sentence and wants the row to stay level, and at 0 it emits no
  properties and no class at all — `-webkit-line-clamp` on an unclamped element
  still costs a `display: -webkit-box`, which changes how the text lays out.

  ## The heading is inside the `.block-text`, not the `.block-text` itself

  Every rule the Text block relies on is written for a `.block-text.rte`
  wrapper with the real tags inside it:

      .block-text:not(--default).rte :is(h1…h6)   take the preset's type
      .block-text--colored.rte :is(h1…h6)         take the chosen colour
      .block-text--gradient :is(h1…h6)            clip the gradient to the text
      .block-text.rte > :is(h1…h6):first-child    lose the long-form margin

  All four are descendant selectors, so putting the class on the heading itself
  would match none of them — the type would still work, because that is read off
  the element, and the gradient would silently do nothing. Which is the failure
  worth designing out: a colour setting that looks applied in the panel and is
  invisible on the page.

  So the shape here is `blocks/text.liquid`'s shape, and this file adds a tag
  choice and a clamp to it rather than a second way of drawing text.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign tag = s.heading_tag | default: 'h3'
  assign preset = s.preset | default: 'h5'
  assign clamp = s.max_lines | default: 0 | plus: 0
  assign color_mode = s.color | default: 'inherit'

  assign classes = 'feature-title-block block-text rte block-text--' | append: preset

  comment
    `--colored` only once the merchant has actually picked a colour, and never
    alongside `--gradient`. The rule it turns on hands the colour down to the
    heading inside, and doing that unconditionally would repaint a heading that
    was meant to keep `--color-heading` from the colour scheme. Same condition,
    same reason, as `blocks/text.liquid`.
  endcomment
  if color_mode == 'gradient'
    assign classes = classes | append: ' block-text--gradient'
  elsif color_mode != 'inherit' and color_mode != blank
    assign classes = classes | append: ' block-text--colored'
  endif

  if clamp > 0
    assign classes = classes | append: ' feature-title-block--clamped'
  endif
-%}

{%- capture title_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  {%- render 'block-typography', block: s -%}
  {%- if clamp > 0 -%}--feature-title-lines: {{ clamp }};{%- endif -%}
{%- endcapture -%}

{%- if s.text != blank -%}
  <div
    class="{{ classes }}"
    data-block-spacing
    style="{{ title_style | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    <{{ tag }}>{{ s.text }}</{{ tag }}>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.feature_title.name",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:shared.heading.label",
      "default": "Free delivery"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:blocks.article_title.settings.heading_tag.label",
      "info": "t:blocks.article_title.settings.heading_tag.info",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "t:shared.typography.preset.options__2.label" }
      ],
      "default": "h3"
    },
    {
      "type": "range",
      "id": "max_lines",
      "label": "t:blocks.article_title.settings.max_lines.label",
      "info": "t:blocks.article_title.settings.max_lines.info",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0
    },

    { "type": "header", "content": "t:shared.typography.header" },
    {
      "type": "select",
      "id": "preset",
      "label": "t:shared.typography.preset.label",
      "info": "t:shared.typography.preset.info",
      "options": [
        { "value": "h2", "label": "t:shared.typography.preset.options__5.label" },
        { "value": "h3", "label": "t:shared.typography.preset.options__6.label" },
        { "value": "h4", "label": "t:shared.typography.preset.options__7.label" },
        { "value": "h5", "label": "t:shared.typography.preset.options__8.label" },
        { "value": "h6", "label": "t:shared.typography.preset.options__9.label" }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "color",
      "label": "t:shared.typography.color.label",
      "info": "t:shared.typography.color.info",
      "options": [
        { "value": "inherit", "label": "t:shared.typography.color.options__1.label" },
        { "value": "muted", "label": "t:shared.typography.color.options__2.label" },
        { "value": "custom", "label": "t:shared.typography.color.options__3.label" },
        { "value": "gradient", "label": "t:shared.typography.color.options__4.label" }
      ],
      "default": "inherit"
    },
    {
      "type": "color",
      "id": "text_color_custom",
      "label": "t:shared.typography.text_color.label",
      "info": "t:shared.typography.text_color.info",
      "visible_if": "{{ block.settings.color == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "text_gradient",
      "label": "t:shared.typography.text_gradient.label",
      "info": "t:shared.typography.text_gradient.info",
      "default": "linear-gradient(90deg, #161514 0%, #0F2E2F 50%, #03D26F 100%)",
      "visible_if": "{{ block.settings.color == 'gradient' }}"
    },

    { "type": "header", "content": "t:shared.spacing.block_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "info": "t:shared.spacing.block_paragraph",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.feature_title.name"
    }
  ]
}
{% endschema %}
