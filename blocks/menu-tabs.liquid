{% doc %}
  blocks/menu-tabs.liquid — Boost10
{% enddoc %}

{%- liquid
  assign st = block.settings
  assign tab_id = 'MegaTabs-' | append: block.id
-%}

<div
  class="megamenu__item megamenu__item--tabs"
  style="--span: {{ st.column_span }};"
  {{ block.shopify_attributes }}
>
  <tab-group
    id="{{ tab_id }}"
    class="tabs tabs--{{ st.orientation }} tabs--menu"
    data-orientation="{{ st.orientation }}"
    data-activation="auto"
    data-stack="{% if st.stack_on_mobile %}true{% else %}false{% endif %}"
    {% if st.select_on_hover %}data-hover="true"{% endif %}
    style="--tabs-rail-width: {{ st.rail_width }}px; --tabs-marker-radius: {{ st.marker_radius }}px;"
  >
    <div class="tabs__rail">
      <div
        class="tabs__list"
        role="tablist"
        aria-orientation="{{ st.orientation }}"
        {% if st.heading != blank %}aria-label="{{ st.heading | escape }}"{% endif %}
        data-ref="list"
      >
        <span class="tabs__marker" data-ref="marker" aria-hidden="true"></span>
      </div>
    </div>

    <div class="tabs__panels" data-ref="panels">
      {% content_for 'blocks' %}
    </div>
  </tab-group>
</div>

{% schema %}
{
  "name": "t:blocks.menu_tabs.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.menu_tabs.settings.heading.label",
      "info": "t:blocks.menu_tabs.settings.heading.info"
    },
    {
      "type": "select",
      "id": "orientation",
      "label": "t:blocks.menu_tabs.settings.orientation.label",
      "options": [
        {
          "value": "vertical",
          "label": "t:blocks.menu_tabs.settings.orientation.options__1.label"
        },
        {
          "value": "horizontal",
          "label": "t:blocks.menu_tabs.settings.orientation.options__2.label"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "range",
      "id": "rail_width",
      "label": "t:blocks.menu_tabs.settings.rail_width.label",
      "info": "t:blocks.menu_tabs.settings.rail_width.info",
      "min": 140,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "range",
      "id": "marker_radius",
      "label": "t:blocks.menu_tabs.settings.marker_radius.label",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "select_on_hover",
      "label": "t:blocks.menu_tabs.settings.select_on_hover.label",
      "default": true
    },
    {
      "type": "range",
      "id": "column_span",
      "label": "t:blocks.shared.column_span.label",
      "info": "t:blocks.shared.column_span.info",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:blocks.menu_tabs.settings.stack_on_mobile.label",
      "info": "t:blocks.menu_tabs.settings.stack_on_mobile.info",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu-tab"
    }
  ]
}
{% endschema %}
