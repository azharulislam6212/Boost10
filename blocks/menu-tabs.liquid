{% doc %}
  blocks/menu-tabs.liquid — Boost10
{% enddoc %}

{%- liquid
  assign st = block.settings
  assign tab_id = 'MegaTabs-' | append: block.id
  assign tabs_style = '--tabs-rail-width: ' | append: st.rail_width | append: 'px; --tabs-marker-radius: ' | append: st.marker_radius | append: 'px;'

  if st.stack_on_mobile
    assign tab_attributes = 'data-stack="true"'
  else
    assign tab_attributes = 'data-stack="false"'
  endif
-%}

{%- capture panels -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

<div
  class="megamenu__item megamenu__item--tabs"
  style="--span: {{ st.column_span }};"
  {{ block.shopify_attributes }}
>
  {% render 'tab-group',
     id: tab_id,
     panels: panels,
     orientation: st.orientation,
     classes: 'tabs--menu',
     hover: st.select_on_hover,
     label: st.heading,
     styles: tabs_style,
     attributes: tab_attributes %}
</div>

{% schema %}
{
  "name": "t:blocks.menu_tabs.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.menu_tabs.settings.heading.label",
      "info": "t:blocks.menu_tabs.settings.heading.info"
    },
    {
      "type": "select",
      "id": "orientation",
      "label": "t:blocks.menu_tabs.settings.orientation.label",
      "options": [
        {
          "value": "vertical",
          "label": "t:blocks.menu_tabs.settings.orientation.options__1.label"
        },
        {
          "value": "horizontal",
          "label": "t:blocks.menu_tabs.settings.orientation.options__2.label"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "range",
      "id": "rail_width",
      "label": "t:blocks.menu_tabs.settings.rail_width.label",
      "info": "t:blocks.menu_tabs.settings.rail_width.info",
      "min": 140,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "range",
      "id": "marker_radius",
      "label": "t:blocks.menu_tabs.settings.marker_radius.label",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "select_on_hover",
      "label": "t:blocks.menu_tabs.settings.select_on_hover.label",
      "default": true
    },
    {
      "type": "range",
      "id": "column_span",
      "label": "t:blocks.shared.column_span.label",
      "info": "t:blocks.shared.column_span.info",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:blocks.menu_tabs.settings.stack_on_mobile.label",
      "info": "t:blocks.menu_tabs.settings.stack_on_mobile.info",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu-tab"
    }
  ]
}
{% endschema %}
