{% doc %}
  An icon beside a short line of text. Trust points, shipping promises, feature
  rows. With a connector, stacked items join into a timeline.
{% enddoc %}

{%- liquid
  assign s = block.settings

  capture icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0

  assign icon_upload = s.icon_image | default: s.custom_icon

  assign icon_source = s.icon_source
  if icon_source == blank
    if icon_upload != blank
      assign icon_source = 'image'
    else
      assign icon_source = 'icon'
    endif
  endif

  assign has_icon = false
  if icon_source == 'icon' and s.icon != blank and s.icon != 'none'
    assign has_icon = true
  elsif icon_source == 'image' and icon_upload != blank
    assign has_icon = true
  endif

  assign gap = block.settings.gap

  assign nested = false
  if block.blocks.size > 0
    assign nested = true
  endif

  assign nested_mark = 0
  assign nested_mark_mobile = 0
  if nested
    for child in block.blocks
      if child.type contains 'icon-text-icon'
        if child.settings.shape == 'none'
          assign nested_mark = child.settings.icon_size | plus: 0
          assign nested_mark_mobile = nested_mark
        else
          assign nested_mark = child.settings.shape_size
          assign nested_mark_mobile = child.settings.shape_size_mobile
        endif
        break
      endif
    endfor
  endif
-%}

{%- capture icon_text_style -%}
  {%- render 'spacing', block: block.settings, declarations: true -%}
  --icon-text-gap: {{ gap }}px;
  {%- if s.connector and has_icon -%}
    {%- if s.shape == 'none' or s.shape == blank -%}
      --icon-text-mark: {{ icon_size }}px;
      --icon-text-mark-mobile: {{ icon_size }}px;
    {%- else -%}
      --icon-text-mark: {{ s.shape_size }}px;
      --icon-text-mark-mobile: {{ s.shape_size_mobile | default: 32 }}px;
    {%- endif -%}
    {%- if s.ring_style != 'none' and s.ring_color != blank -%}
      --icon-text-connector: {{ s.ring_color }};
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture icon_mark_style -%}
  {%- render 'icon-mark', block: s, declarations: true, offset: 4 -%}
{%- endcapture -%}

{%- if nested -%}
<div
  class="block-icon-text block-icon-text--nested icon-mark-host block-icon-text--{{ block.settings.alignment }}{% if nested_mark > 0 %} block-icon-text--has-mark{% endif %}"
  data-block-spacing
  style="{{ icon_text_style | strip_newlines | strip }}{% if nested_mark > 0 %}--icon-text-mark: {{ nested_mark }}px; --icon-text-mark-mobile: {{ nested_mark_mobile }}px;{% endif %}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>
{%- else -%}
<div
  class="block-icon-text icon-mark-host block-icon-text--{{ block.settings.alignment }}{% if s.connector and block.settings.alignment == 'row' %} block-icon-text--connector{% endif %}"
  data-block-spacing
  style="{{ icon_text_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {%- if has_icon -%}
    <span class="block-icon-text__mark icon-mark" style="{{ icon_mark_style | strip_newlines | strip }}">
      {% render 'icon-mark', block: s, offset: 4 %}
      {%- if icon_source == 'image' -%}
        {% render 'image', image: icon_upload, ratio: '1-1', sizes: '48px', wrapper_class: 'block-icon-text__custom' %}
      {%- else -%}
        {% render 'icon', icon: s.icon, size: icon_size, class: 'block-icon-text__icon' %}
      {%- endif -%}
    </span>
  {%- endif -%}

  <div class="block-icon-text__body">
    {%- if block.settings.heading != blank -%}
      <p class="block-icon-text__heading">{{ block.settings.heading }}</p>
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <div class="block-icon-text__text rte">{{ block.settings.text }}</div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

