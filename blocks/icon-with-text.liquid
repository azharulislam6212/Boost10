        { "value": "check", "label": "t:blocks.subheading.settings.icon.options__2" },
        { "value": "heart", "label": "t:blocks.subheading.settings.icon.options__3" },
        { "value": "tag", "label": "t:blocks.subheading.settings.icon.options__4" },
        { "value": "truck", "label": "t:blocks.subheading.settings.icon.options__5" },
        { "value": "refresh", "label": "t:blocks.subheading.settings.icon.options__6" },
        { "value": "lock", "label": "t:blocks.subheading.settings.icon.options__7" },
        { "value": "clock", "label": "t:blocks.subheading.settings.icon.options__8" },
        { "value": "location", "label": "t:blocks.subheading.settings.icon.options__9" },
        { "value": "mail", "label": "t:blocks.subheading.settings.icon.options__10" },
        { "value": "note", "label": "t:blocks.subheading.settings.icon.options__11" },
        { "value": "info", "label": "t:blocks.subheading.settings.icon.options__12" },
        { "value": "chat", "label": "t:blocks.feature_icon.settings.icon.options__13" },
        { "value": "phone", "label": "t:blocks.feature_icon.settings.icon.options__14" },
        { "value": "share", "label": "t:blocks.feature_icon.settings.icon.options__15" },
        { "value": "grid", "label": "t:blocks.feature_icon.settings.icon.options__16" },
