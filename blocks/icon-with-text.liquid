{% comment %}
  blocks/icon-with-text.liquid

  An icon beside a short line of text. Trust points, shipping promises, feature
  rows.

  The icon is decorative and `aria-hidden`: the text beside it is the content,
  and announcing "truck, free delivery over fifty pounds" helps nobody.
{% endcomment %}

<div
  class="block-icon-text block-icon-text--{{ block.settings.alignment }}"
  {% render 'spacing', block: block.settings %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.custom_icon != blank -%}
    {% render 'image', image: block.settings.custom_icon, ratio: 'square', sizes: '48px', wrapper_class: 'block-icon-text__custom' %}
  {%- else -%}
    {% render 'icon', icon: block.settings.icon, size: block.settings.icon_size, class: 'block-icon-text__icon' %}
  {%- endif -%}

  <div class="block-icon-text__body">
    {%- if block.settings.heading != blank -%}
      <p class="block-icon-text__heading">{{ block.settings.heading }}</p>
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <div class="block-icon-text__text rte">{{ block.settings.text }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.icon_with_text.name",
  "tag": null,
  "settings": [
    {
      "type": "select", "id": "icon", "label": "t:blocks.icon_with_text.settings.icon.label",
      "options": [
        { "value": "truck", "label": "t:blocks.icon_with_text.settings.icon.options__1.label" },
        { "value": "refresh", "label": "t:blocks.icon_with_text.settings.icon.options__2.label" },
        { "value": "lock", "label": "t:blocks.icon_with_text.settings.icon.options__3.label" },
        { "value": "check", "label": "t:blocks.icon_with_text.settings.icon.options__4.label" },
        { "value": "star", "label": "t:blocks.icon_with_text.settings.icon.options__5.label" },
        { "value": "heart", "label": "t:blocks.icon_with_text.settings.icon.options__6.label" },
        { "value": "info", "label": "t:blocks.icon_with_text.settings.icon.options__7.label" }
      ],
      "default": "truck"
    },
    { "type": "image_picker", "id": "custom_icon", "label": "t:blocks.icon_with_text.settings.custom_icon.label", "info": "t:blocks.icon_with_text.settings.custom_icon.info" },
    { "type": "range", "id": "icon_size", "label": "t:blocks.icon_with_text.settings.icon_size.label", "min": 16, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "text", "id": "heading", "label": "t:shared.heading.label", "default": "Free delivery" },
    { "type": "richtext", "id": "text", "label": "t:shared.text.label" },
    {
      "type": "select", "id": "alignment", "label": "t:blocks.icon_with_text.settings.alignment.label",
      "options": [
        { "value": "row", "label": "t:blocks.icon_with_text.settings.alignment.options__1.label" },
        { "value": "column", "label": "t:blocks.icon_with_text.settings.alignment.options__2.label" }
      ],
      "default": "row"
    },
        {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        { "value": "desktop", "label": "t:shared.spacing.devices.options__1.label" },
        { "value": "mobile", "label": "t:shared.spacing.devices.options__2.label" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [{ "name": "t:blocks.icon_with_text.name" }]
}
{% endschema %}
