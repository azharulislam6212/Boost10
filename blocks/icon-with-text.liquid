{% doc %}
  An icon beside a short line of text. Trust points, shipping promises, feature
  rows.
{% enddoc %}

{%- liquid
  assign s = block.settings

  capture icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0

  assign icon_upload = s.icon_image | default: s.custom_icon

  assign icon_source = s.icon_source
  if icon_source == blank
    if icon_upload != blank
      assign icon_source = 'image'
    else
      assign icon_source = 'icon'
    endif
  endif

  assign has_icon = false
  if icon_source == 'icon' and s.icon != blank and s.icon != 'none'
    assign has_icon = true
  elsif icon_source == 'image' and icon_upload != blank
    assign has_icon = true
  endif

  assign gap = block.settings.gap | default: 12 | plus: 0
-%}

{%- capture icon_text_style -%}
  {%- render 'spacing', block: block.settings, declarations: true -%}
  --icon-text-gap: {{ gap }}px;
{%- endcapture -%}

{%- capture icon_mark_style -%}
  {%- render 'icon-mark', block: s, declarations: true -%}
{%- endcapture -%}

<div
  class="block-icon-text icon-mark-host block-icon-text--{{ block.settings.alignment }}"
  data-block-spacing
  style="{{ icon_text_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {%- if has_icon -%}
    <span class="block-icon-text__mark icon-mark" style="{{ icon_mark_style | strip_newlines | strip }}">
      {% render 'icon-mark', block: s %}
      {%- if icon_source == 'image' -%}
        {% render 'image', image: icon_upload, alt: s.icon_image_alt, ratio: '1-1', sizes: '48px', wrapper_class: 'block-icon-text__custom' %}
      {%- else -%}
        {% render 'icon', icon: s.icon, size: icon_size, class: 'block-icon-text__icon' %}
      {%- endif -%}
    </span>
  {%- endif -%}

  <div class="block-icon-text__body">
    {%- if block.settings.heading != blank -%}
      <p class="block-icon-text__heading">{{ block.settings.heading }}</p>
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <div class="block-icon-text__text rte">{{ block.settings.text }}</div>
    {%- endif -%}
  </div>
</div>

