{% doc %}
  The heading cluster that opens a section: an eyebrow, a headline, a line of
  supporting copy, and a call to action.
{% enddoc %}

{%- liquid
  assign layout = 'vertical'
  if block.settings.direction == 'row'
    assign layout = 'horizontal'
  endif

  assign extra_classes = 'block-section-header block-section-header--' | append: layout
-%}

{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{% render 'group',
   children: children,
   settings: block.settings,
   extra_classes: extra_classes,
   styles: '--group-width-mobile: 1 1 0%; --group-width-mobile-size: 100%;',
   animate: true,
   shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "t:blocks.section_header.name",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "_section-header-content"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.group.settings.direction.label",
      "options": [
        {
          "value": "column",
          "label": "t:blocks.group.settings.direction.options__1.label"
        },
        {
          "value": "row",
          "label": "t:blocks.group.settings.direction.options__2.label"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:blocks.group.settings.stack_on_mobile.label",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        },
        {
          "value": "space-between",
          "label": "t:blocks.group.settings.distribution.options__2.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:blocks.group.settings.position.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.position.options__3.label"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "gap_device",
      "label": "t:shared.gap.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_horizontal_mobile",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.gap_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical_mobile",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.gap_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.group.settings.width.label",
      "options": [
        {
          "value": "fit",
          "label": "t:blocks.group.settings.width.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.group.settings.width.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:blocks.group.settings.width.options__3.label"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "t:blocks.group.settings.width_custom.label",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:blocks.group.settings.padding_device.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:blocks.group.settings.padding_device.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:blocks.group.settings.padding_device.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "t:shared.spacing.padding_inline.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "t:shared.spacing.padding_block.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_inline_mobile",
      "label": "t:shared.spacing.padding_inline.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_block_mobile",
      "label": "t:shared.spacing.padding_block.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.section_header.presets.vertical.name",
      "category": "t:categories.layout",
      "settings": {
        "direction": "column",
        "alignment": "center",
        "position": "start",
        "width": "fill",
        "gap_vertical": 16,
        "gap_vertical_mobile": 12
      },
      "blocks": [
        {
          "type": "subheading",
          "settings": {
            "text": "<p>Subheading</p>",
            "preset": "subheading",
            "width": "fit",
            "icon_source": "icon",
            "icon": "star",
            "icon_style": "solid",
            "icon_size": "small",
            "icon_width": 22,
            "icon_border_radius": 50,
            "gap": 8,
            "border_style": "dashed",
            "border_radius": 40
          },
          "blocks": []
        },
        {
          "type": "text",
          "name": "t:blocks.text.presets.heading.name",
          "settings": {
            "text": "<h2>Heading</h2>",
            "preset": "h2",
            "max_width": "none",
            "color": "gradient",
            "text_gradient": "linear-gradient(90deg, #161514 0%, #0F2E2F 50%, #03D26F 100%)"
          }
        },
        {
          "type": "text",
          "name": "t:blocks.text.presets.text.name",
          "settings": {
            "text": "<p>One line of context under the heading — what this section is for, and why it is worth reading.</p>",
            "preset": "paragraph",
            "max_width": "normal"
          }
        }
      ]
    },
    {
      "name": "t:blocks.section_header.presets.horizontal.name",
      "category": "t:categories.layout",
      "settings": {
        "direction": "row",
        "position": "center",
        "width": "fill",
        "alignment": "space-between",
        "gap_horizontal": 32,
        "gap_vertical": 16,
        "gap_vertical_mobile": 16
      },
      "blocks": [
        {
          "type": "_section-header-content",
          "name": "t:blocks.section_header_content.name",
          "blocks": [
            {
              "type": "subheading",
              "settings": {
                "text": "<p>Subheading</p>",
                "preset": "subheading",
                "width": "fit",
                "icon_source": "icon",
                "icon": "star",
                "icon_style": "solid",
                "icon_size": "small",
                "icon_width": 22,
                "icon_border_radius": 50,
                "gap": 8,
                "border_style": "dashed",
                "border_radius": 40
              },
              "blocks": []
            },
            {
              "type": "text",
              "name": "t:blocks.text.presets.heading.name",
              "settings": {
                "text": "<h2>Heading</h2>",
                "preset": "h2",
                "max_width": "none",
                "color": "gradient",
                "text_gradient": "linear-gradient(90deg, #161514 0%, #0F2E2F 50%, #03D26F 100%)"
              }
            },
            {
              "type": "text",
              "name": "t:blocks.text.presets.text.name",
              "settings": {
                "text": "<p>One line of context under the heading — what this section is for, and why it is worth reading.</p>",
                "preset": "paragraph",
                "max_width": "normal"
              }
            }
          ]
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
