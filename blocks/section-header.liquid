{% doc %}
  The heading cluster that opens a section: an eyebrow, a headline, a line of
  supporting copy, and a call to action.
{% enddoc %}

{%- liquid
  # The direction control is the group's own, so the modifier is derived from it
  # rather than stored a second time. A merchant who switches a vertical section
  # header to Horizontal gets the horizontal behaviour, with no second setting
  # left free to disagree with the first.
  assign layout = 'vertical'
  if block.settings.direction == 'row'
    assign layout = 'horizontal'
  endif

  assign extra_classes = 'block-section-header block-section-header--' | append: layout
  if layout == 'horizontal'
    assign extra_classes = extra_classes | append: ' block-group--stack-mobile'
  endif
-%}

{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{% render 'group',
   children: children,
   settings: block.settings,
   extra_classes: extra_classes,
   styles: '--group-width-mobile: 1 1 0%; --group-width-mobile-size: 100%;',
   shopify_attributes: block.shopify_attributes %}

