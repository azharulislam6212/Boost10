{% doc %}
  blocks/_hero-content.liquid — private, the copy column of Hero banner: a
  heading cluster with any theme blocks, and an optional rule down its leading
  edge.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign extra_classes = 'block-section-header block-section-header--vertical hero-content'

  assign rule = s.rule_style | default: 'none'
  if rule != 'none'
    assign extra_classes = extra_classes | append: ' hero-content--rule hero-content--rule-' | append: rule
  endif

  assign rule_alpha = s.rule_opacity | default: 30 | divided_by: 100.0
-%}

{%- capture rule_style -%}
  --group-width-mobile: 1 1 0%; --group-width-mobile-size: 100%;
  {%- if rule != 'none' -%}
    {%- if s.rule_color != blank -%}
      --hero-rule-color: {{ s.rule_color | color_modify: 'alpha', rule_alpha }};
    {%- else -%}
      --hero-rule-color: color-mix(in srgb, currentColor {{ s.rule_opacity | default: 30 }}%, transparent);
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{% render 'group',
   children: children,
   settings: s,
   extra_classes: extra_classes,
   styles: rule_style,
   animate: true,
   shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "t:blocks.hero_content.name",
  "tag": null,
  "blocks": [
    {
      "type": "subheading"
    },
    {
      "type": "text"
    },
    {
      "type": "highlight-text"
    },
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "badge-highlight"
    },
    {
      "type": "rating-badge"
    },
    {
      "type": "divider"
    },
    {
      "type": "spacer"
    },
    {
      "type": "icon-with-text"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "image"
    },
    {
      "type": "group"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        },
        {
          "value": "space-between",
          "label": "t:blocks.group.settings.distribution.options__2.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "gap_device",
      "label": "t:shared.gap.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical_mobile",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.gap_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.group.settings.width.label",
      "options": [
        {
          "value": "fit",
          "label": "t:blocks.group.settings.width.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.group.settings.width.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:blocks.group.settings.width.options__3.label"
        }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "t:blocks.group.settings.width_custom.label",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 38,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.hero_content.headers.rule"
    },
    {
      "type": "select",
      "id": "rule_style",
      "label": "t:blocks.hero_content.settings.rule_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.options.dashed"
        }
      ],
      "default": "dashed"
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "t:blocks.hero_content.settings.rule_color.label",
      "visible_if": "{{ block.settings.rule_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "rule_opacity",
      "label": "t:shared.border.opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ block.settings.rule_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:blocks.group.settings.padding_device.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:blocks.group.settings.padding_device.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:blocks.group.settings.padding_device.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "t:shared.spacing.padding_inline.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "t:shared.spacing.padding_block.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_inline_mobile",
      "label": "t:shared.spacing.padding_inline.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_block_mobile",
      "label": "t:shared.spacing.padding_block.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
