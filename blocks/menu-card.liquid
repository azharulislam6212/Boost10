{% doc %}
  blocks/menu-card.liquid — Boost10
{% enddoc %}

{%- liquid
  assign st = block.settings
  assign has_link = false
  assign is_current = false
  if st.link != blank
    assign has_link = true

    # The card is active on the page it links to, whether the link was saved as
    # a path or a full URL, and with or without a query string.
    assign link_path = st.link | split: "?" | first | split: "#" | first
    assign full_path = shop.url | append: request.path
    if link_path == request.path or link_path == full_path
      assign is_current = true
    endif
  endif
-%}

{%- capture card_body -%}
  <span class="menu-card__media">
    {%- if st.image != blank -%}
      {% render 'image',
        image: st.image,
        alt: st.title,
        ratio: st.image_ratio,
        sizes: '96px',
        widths: '96,140,192,280',
        wrapper_class: 'menu-card__image',
        class: 'menu-card__img'
      %}
    {%- else -%}
      {%- liquid
        # Six illustrations in turn, so neighbouring cards don't repeat one.
        assign placeholder_names = 'hero-apparel-1,hero-apparel-2,hero-apparel-3,blog-apparel-1,blog-apparel-2,blog-apparel-3' | split: ','
        assign placeholder_index = block.id | slice: -1, 1 | plus: 0
        if placeholder_index < 1 or placeholder_index > 6
          assign placeholder_index = block.id | size | modulo: 6 | plus: 1
        endif
        assign placeholder_index = placeholder_index | minus: 1
      -%}
      <span class="menu-card__image menu-card__image--placeholder">
        {{ placeholder_names[placeholder_index] | placeholder_svg_tag: 'placeholder-svg' }}
      </span>
    {%- endif -%}
  </span>

  <span class="menu-card__text">
    {%- if st.title != blank -%}
      <span class="menu-card__title">{{ st.title | escape }}</span>
    {%- endif -%}
    {%- if st.description != blank -%}
      <span class="menu-card__description">{{ st.description | escape }}</span>
    {%- endif -%}
  </span>
{%- endcapture -%}

{%- if has_link -%}
  <a
    class="megamenu__item menu-card"
    href="{{ st.link }}"
    {% if is_current %}aria-current="page"{% endif %}
    style="--span: {{ st.column_span }}; --card-radius: {{ st.corner_radius }}px;"
    {{ block.shopify_attributes }}
  >
    {{ card_body }}
  </a>
{%- else -%}
  <div
    class="megamenu__item menu-card"
    style="--span: {{ st.column_span }}; --card-radius: {{ st.corner_radius }}px;"
    {{ block.shopify_attributes }}
  >
    {{ card_body }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.menu_card.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:shared.image.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:shared.image_ratio.label",
      "options": [
        {
          "value": "portrait",
          "label": "t:shared.image_ratio.options__1.label"
        },
        {
          "value": "3-4",
          "label": "t:shared.image_ratio.options__2.label"
        },
        {
          "value": "2-3",
          "label": "t:shared.image_ratio.options__3.label"
        },
        {
          "value": "9-16",
          "label": "t:shared.image_ratio.options__4.label"
        },
        {
          "value": "1-1",
          "label": "t:shared.image_ratio.options__5.label"
        },
        {
          "value": "5-4",
          "label": "t:shared.image_ratio.options__6.label"
        },
        {
          "value": "4-3",
          "label": "t:shared.image_ratio.options__7.label"
        },
        {
          "value": "3-2",
          "label": "t:shared.image_ratio.options__8.label"
        },
        {
          "value": "16-9",
          "label": "t:shared.image_ratio.options__9.label"
        },
        {
          "value": "aspect-ratio",
          "label": "t:shared.image_ratio.options__10.label"
        }
      ],
      "default": "1-1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:shared.heading.label",
      "default": "Research & Testing"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:shared.text.label",
      "default": "Add a short description"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:shared.link.label"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:shared.corner_radius.label",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "column_span",
      "label": "t:blocks.shared.column_span.label",
      "info": "t:blocks.shared.column_span.info",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 12
    }
  ]
}
{% endschema %}
