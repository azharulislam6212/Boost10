{% doc %}
  blocks/menu-tab.liquid — Boost10
{% enddoc %}

{%- liquid
  assign st = block.settings
  assign panel_id = 'MegaTab-' | append: block.id
  assign columns = st.columns | default: 3

  assign products = st.collection.products
  assign product_limit = st.products_count | default: 4
-%}

<div
  class="tabs__panel"
  role="tabpanel"
  id="{{ panel_id }}"
  data-tab-label="{{ st.title | escape }}"
  tabindex="0"
  style="--tab-columns: {{ columns }};"
  {{ block.shopify_attributes }}
>
  {%- if st.content == 'products' -%}
    {%- if st.collection != blank and products.size > 0 -%}
      {%- capture product_items -%}
        {%- for product in products limit: product_limit -%}
          <li class="carousel-shell__item">
            {% render 'product-card',
              product: product,
              index: forloop.index0,
              sizes: '(min-width: 990px) 22vw, 60vw'
            %}
          </li>
        {%- endfor -%}
      {%- endcapture -%}

      {%- if st.layout == 'carousel' -%}
        {% render 'carousel-shell', id: panel_id, append: '-carousel', children: product_items, layout: 'carousel', layout_mobile: 'carousel', tag: 'ul', label: st.title, columns_desktop: columns, columns_tablet: 2, columns_mobile: 1, count: products.size, settings: st %}
      {%- else -%}
        <ul class="megamenu__products" role="list">
          {%- for product in products limit: product_limit -%}
            <li>
              {% render 'product-card',
                product: product,
                index: forloop.index0,
                sizes: '(min-width: 990px) 22vw, 60vw'
              %}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- else -%}

      <p class="megamenu__empty">{{ 'blocks.mega_menu.empty_collection' | t }}</p>
    {%- endif -%}
  {%- else -%}

    {% content_for 'block',
       type: '_menu-tab-promos',
       id: 'promos',
       panel_id: panel_id,
       layout: st.layout,
       title: st.title,
       columns: columns,
       image_ratio: st.image_ratio,
       tab: st %}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.menu_tab.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:blocks.menu_tab.settings.title.label",
      "default": "Vitamins & Capsules"
    },
    {
      "type": "select",
      "id": "content",
      "label": "t:blocks.menu_tab.settings.content.label",
      "info": "t:blocks.menu_tab.settings.content.info",
      "options": [
        {
          "value": "promotions",
          "label": "t:blocks.menu_tab.settings.content.options__1.label"
        },
        {
          "value": "products",
          "label": "t:blocks.menu_tab.settings.content.options__2.label"
        }
      ],
      "default": "promotions"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:shared.columns.desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:shared.image_ratio.label",
      "options": [
        {
          "value": "portrait",
          "label": "t:shared.image_ratio.options__1.label"
        },
        {
          "value": "3-4",
          "label": "t:shared.image_ratio.options__2.label"
        },
        {
          "value": "2-3",
          "label": "t:shared.image_ratio.options__3.label"
        },
        {
          "value": "9-16",
          "label": "t:shared.image_ratio.options__4.label"
        },
        {
          "value": "1-1",
          "label": "t:shared.image_ratio.options__5.label"
        },
        {
          "value": "5-4",
          "label": "t:shared.image_ratio.options__6.label"
        },
        {
          "value": "4-3",
          "label": "t:shared.image_ratio.options__7.label"
        },
        {
          "value": "3-2",
          "label": "t:shared.image_ratio.options__8.label"
        },
        {
          "value": "16-9",
          "label": "t:shared.image_ratio.options__9.label"
        },
        {
          "value": "aspect-ratio",
          "label": "t:shared.image_ratio.options__10.label"
        }
      ],
      "default": "1-1"
    },
    {
      "type": "header",
      "content": "t:blocks.menu_tab.headers.products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:blocks.menu_tab.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "t:blocks.menu_tab.settings.products_count.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:shared.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:blocks.menu_tab.settings.layout.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:blocks.menu_tab.settings.layout.options__2.label"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "header",
      "content": "t:blocks.menu_tab.headers.carousel_motion",
      "visible_if": "{{ block.settings.layout == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "carousel_speed",
      "label": "t:shared.carousel.speed.label",
      "info": "t:shared.carousel.speed.info",
      "min": 100,
      "max": 1500,
      "step": 50,
      "unit": "ms",
      "default": 500,
      "visible_if": "{{ block.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_loop",
      "label": "t:shared.carousel.loop.label",
      "default": false,
      "visible_if": "{{ block.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "t:shared.carousel.autoplay.label",
      "default": false,
      "visible_if": "{{ block.settings.layout == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "carousel_autoplay_delay",
      "label": "t:shared.carousel.autoplay_delay.label",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ block.settings.layout == 'carousel' and block.settings.carousel_autoplay }}"
    },
    {
      "type": "header",
      "content": "t:blocks.menu_tab.headers.carousel_arrows",
      "visible_if": "{{ block.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_navigation",
      "label": "t:shared.carousel.navigation.label",
      "default": true,
      "visible_if": "{{ block.settings.layout == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_icon",
      "label": "t:shared.carousel.nav_icon.label",
      "options": [
        {
          "value": "chevron",
          "label": "t:shared.carousel.nav_icon.options__1.label"
        },
        {
          "value": "arrow",
          "label": "t:shared.carousel.nav_icon.options__2.label"
        },
        {
          "value": "play",
          "label": "t:shared.carousel.nav_icon.options__3.label"
        },
        {
          "value": "external",
          "label": "t:shared.carousel.nav_icon.options__4.label"
        }
      ],
      "default": "chevron",
      "visible_if": "{{ block.settings.layout == 'carousel' and block.settings.carousel_navigation }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_style",
      "label": "t:shared.carousel.controls_style.label",
      "info": "t:shared.carousel.controls_style.info",
      "options": [
        {
          "value": "split",
          "label": "t:shared.carousel.controls_style.options__1.label"
        },
        {
          "value": "ghost",
          "label": "t:shared.carousel.controls_style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:shared.carousel.controls_style.options__3.label"
        }
      ],
      "default": "ghost",
      "visible_if": "{{ block.settings.layout == 'carousel' and block.settings.carousel_navigation }}"
    },
    {
      "type": "header",
      "content": "t:blocks.menu_tab.headers.carousel_pagination",
      "visible_if": "{{ block.settings.layout == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "t:shared.carousel.pagination.label",
      "info": "t:shared.carousel.pagination.info",
      "options": [
        {
          "value": "none",
          "label": "t:shared.carousel.pagination.options__1.label"
        },
        {
          "value": "dots",
          "label": "t:shared.carousel.pagination.options__2.label"
        },
        {
          "value": "numbers",
          "label": "t:shared.carousel.pagination.options__3.label"
        },
        {
          "value": "progress",
          "label": "t:shared.carousel.pagination.options__4.label"
        },
        {
          "value": "controls",
          "label": "t:shared.carousel.pagination.options__5.label"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.layout == 'carousel' }}"
    }
  ]
}
{% endschema %}
