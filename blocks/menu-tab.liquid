{% comment %}
  blocks/menu-tab.liquid — Boost10

  One category in a `menu-tabs` rail, and whatever it shows on the right.

  ## Two kinds of content from one block

  **Promotions** — three authored cards. Editorial: the merchant writes the
  headline and picks the photograph.

  **Products** — cards from a collection, rendered through `snippets/product-card`.
  Live: price, badges, swatches and availability all come from the product and
  stay correct without anyone editing the menu.

  One block rather than two because the merchant's question is "what does this
  category show", not "which block type do I need". The two modes share the
  category name, the column count and the tab button; only the content differs,
  and the unused settings are the price of not making someone delete a block to
  change their mind.

  ## The product cards are the theme's own

  `product-card` already handles the image swap, the swatches, the quick add and
  the badges, all driven by the same theme settings the collection grid uses. A
  card built here would be a second implementation that drifts from the first
  the week either one changes.

  ## Grid or carousel

  Five products in a four-column panel either wrap to a second row that pushes
  the panel past the fold, or scroll. `layout` on the parent `menu-tabs` block
  decides which, and the carousel is the theme's own `carousel-shell`.

  ## The tab button is not here

  `<tab-group>` builds it from `data-tab-label` below. The button and the panel
  belong in two different containers and `{% content_for 'blocks' %}` emits one
  stream, so the label travels on the panel and the rail is assembled from it.
{% endcomment %}

{%- liquid
  assign st = block.settings
  assign panel_id = 'MegaTab-' | append: block.id
  assign columns = st.columns | default: 3

  assign products = st.collection.products
  assign product_limit = st.products_count | default: 4
-%}

<div
  class="tabs__panel"
  role="tabpanel"
  id="{{ panel_id }}"
  data-tab-label="{{ st.title | escape }}"
  tabindex="0"
  style="--tab-columns: {{ columns }};"
  {{ block.shopify_attributes }}
>
  {%- if st.content == 'products' -%}
    {%- if st.collection != blank and products.size > 0 -%}
      {%- capture product_items -%}
        {%- for product in products limit: product_limit -%}
          <li class="carousel-shell__item">
            {% render 'product-card',
              product: product,
              index: forloop.index0,
              sizes: '(min-width: 990px) 22vw, 60vw'
            %}
          </li>
        {%- endfor -%}
      {%- endcapture -%}

      {%- if st.layout == 'carousel' -%}
        {% render 'carousel-shell',
          id: panel_id | append: '-carousel',
          children: product_items,
          layout: 'carousel',
          layout_mobile: 'carousel',
          tag: 'ul',
          label: st.title,
          columns_desktop: columns,
          columns_tablet: 2,
          columns_mobile: 1,
          count: products.size,
          settings: st
        %}
      {%- else -%}
        <ul class="megamenu__products" role="list">
          {%- for product in products limit: product_limit -%}
            <li>
              {% render 'product-card',
                product: product,
                index: forloop.index0,
                sizes: '(min-width: 990px) 22vw, 60vw'
              %}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- else -%}
      {%- comment -%}
        An empty state a merchant can act on, rather than a panel that opens
        onto nothing and reads as a broken menu.
      {%- endcomment -%}
      <p class="megamenu__empty">{{ 'blocks.mega_menu.empty_collection' | t }}</p>
    {%- endif -%}
  {%- else -%}
    {%- comment -%}
      Eight slots, and the empty ones are skipped. A category with four cards
      and one with eight are the same block; the merchant fills what they need.

      The carousel shows `columns` at a time, so eight cards at four columns is
      two pages — which is the layout that was asked for and the reason the fixed
      three-card grid had to go.
    {%- endcomment -%}
    {%- capture promo_items -%}
      {%- for index in (1..8) -%}
        {%- liquid
          assign image_key = 'image_' | append: index
          assign heading_key = 'heading_' | append: index
          assign label_key = 'link_label_' | append: index
          assign link_key = 'link_' | append: index

          assign card_image = st[image_key]
          assign card_heading = st[heading_key]
          assign card_label = st[label_key]
          assign card_link = st[link_key]

          assign is_empty = false
          if card_image == blank and card_heading == blank
            assign is_empty = true
          endif
        -%}

        {%- unless is_empty -%}
          <div class="carousel-shell__item">
          {%- if card_link != blank -%}
            <a class="menu-promo menu-promo--{{ st.text_position }}" href="{{ card_link }}" style="--promo-radius: 16px;">
          {%- else -%}
            <div class="menu-promo menu-promo--{{ st.text_position }}" style="--promo-radius: 16px;">
          {%- endif -%}

            <span class="menu-promo__media">
              {%- if card_image != blank -%}
                {% render 'image',
                  image: card_image,
                  alt: card_heading,
                  ratio: st.image_ratio,
                  sizes: '(min-width: 990px) 30vw, 80vw',
                  wrapper_class: 'menu-promo__image',
                  class: 'menu-promo__img'
                %}
              {%- else -%}
                <span class="menu-promo__image menu-promo__image--placeholder">
                  {{ 'product-' | append: index | placeholder_svg_tag: 'placeholder-svg' }}
                </span>
              {%- endif -%}

              {%- if st.text_position == 'over' -%}
                <span class="menu-promo__panel">
                  {%- if card_heading != blank -%}
                    <span class="menu-promo__heading">{{ card_heading | escape }}</span>
                  {%- endif -%}
                  {%- if card_label != blank -%}
                    <span class="menu-promo__cta">
                      <span>{{ card_label | escape }}</span>
                      {% render 'icon', icon: 'arrow-right', size: 16 %}
                    </span>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </span>

            {%- if st.text_position != 'over' -%}
              <span class="menu-promo__content">
                {%- if card_heading != blank -%}
                  <span class="menu-promo__heading">{{ card_heading | escape }}</span>
                {%- endif -%}
                {%- if card_label != blank -%}
                  <span class="menu-promo__cta">
                    <span>{{ card_label | escape }}</span>
                    {% render 'icon', icon: 'arrow-right', size: 16 %}
                  </span>
                {%- endif -%}
              </span>
            {%- endif -%}

          {%- if card_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </div>
        {%- endunless -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if st.layout == 'carousel' -%}
      {% render 'carousel-shell',
        id: panel_id | append: '-promos',
        children: promo_items,
        layout: 'carousel',
        layout_mobile: 'carousel',
        label: st.title,
        columns_desktop: columns,
        columns_tablet: 2,
        columns_mobile: 1,
        settings: st
      %}
    {%- else -%}
      <div class="tabs__panel-grid">{{ promo_items }}</div>
    {%- endif -%}
  {%- endif -%}
</div>

