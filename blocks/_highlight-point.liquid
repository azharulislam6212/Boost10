{% doc %}
  One thing worth saying about the product: a mark with a number on it, a name,
  and a line under the name.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign has_icon = false
  if s.icon_source == 'icon' and s.icon != blank
    assign has_icon = true
  endif

  capture icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0

  assign column = s.column | default: 'left'
  assign row = s.row | default: 2 | plus: 0
  assign offset = s.offset | default: 40 | plus: 0

  assign nudge = s.nudge | default: 0 | plus: 0

  case s.row_align
    when 'center'
      assign row_align = 'center'
    when 'end'
      assign row_align = 'end'
    else
      assign row_align = 'start'
  endcase

  case s.alignment
    when 'start'
      assign align_axis = 'start'
      assign text_align = 'start'
    when 'end'
      assign align_axis = 'end'
      assign text_align = 'end'
    else
      assign align_axis = 'center'
      assign text_align = 'center'
  endcase

  assign preset = s.preset | default: 'default'
  assign title_classes = 'highlight-point__title block-text--' | append: preset
  if s.color == 'gradient'
    assign title_classes = title_classes | append: ' block-text--gradient'
  endif

  assign is_active = s.active | default: false
-%}

{%- capture icon_mark_style -%}
  {%- render 'icon-mark', block: s, declarations: true, dash_gap: 6 -%}
{%- endcapture -%}

{%- capture title_style -%}
  {%- render 'block-typography', block: s -%}
{%- endcapture -%}

{%- capture point_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --hp-row: {{ row }};
  --hp-row-align: {{ row_align }};
  --hp-offset: {{ offset }}px;
  --hp-nudge: {{ nudge }}px;
  --hp-align: {{ align_axis }};
  --hp-text-align: {{ text_align }};
  --hp-width: {{ s.width | default: 150 | plus: 0 }}px;
  --hp-gap: {{ s.gap | default: 16 | plus: 0 }}px;
  --hp-stack-gap: {{ s.gap_vertical | default: 2 | plus: 0 }}px;
  --hp-text-size: {{ s.text_size | default: 16 | plus: 0 | divided_by: 10.0 }}rem;
  {%- if s.text_color != blank -%}
    --hp-text-color: {{ s.text_color }};
  {%- endif -%}
  --hp-number-size: {{ s.number_size | default: 28 | plus: 0 }}px;
  {%- if s.number_background != blank -%}
    --hp-number-background: {{ s.number_background }};
  {%- endif -%}
  {%- if s.number_color != blank -%}
    --hp-number-color: {{ s.number_color }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="highlight-point icon-mark-host"
  data-highlight-point
  data-column="{{ column }}"
  {% if is_active %}data-highlight-active aria-current="true"{% endif %}
  data-block-spacing
  style="{{ point_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {%- if has_icon -%}
    <span class="highlight-point__mark icon-mark" aria-hidden="true" style="{{ icon_mark_style | strip_newlines | strip }}">
      {% render 'icon-mark', block: s, dash_gap: 6 %}
      {% render 'icon', icon: s.icon, size: icon_size %}

      {%- if s.number != blank -%}
        <span class="highlight-point__number" aria-hidden="false">{{ s.number | escape }}</span>
      {%- endif -%}
    </span>
  {%- elsif s.number != blank -%}

    <span class="highlight-point__number highlight-point__number--alone">{{ s.number | escape }}</span>
  {%- endif -%}

  <span class="highlight-point__body">
    {%- if s.title != blank -%}
      <span class="{{ title_classes }}" style="{{ title_style | strip_newlines | strip }}">
        {{- s.title | escape -}}
      </span>
    {%- endif -%}

    {%- if s.text != blank -%}
      <span class="highlight-point__text">{{ s.text }}</span>
    {%- endif -%}
  </span>
</div>

