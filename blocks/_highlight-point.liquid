{% doc %}
  One thing worth saying about the product: a mark with a number on it, a name,
  and a line under the name. The three are its static Icon, Heading and Text
  blocks; the point itself places them on the stage.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign column = s.column
  assign row = s.row
  assign offset = s.offset

  assign nudge = s.nudge

  case s.row_align
    when 'center'
      assign row_align = 'center'
    when 'end'
      assign row_align = 'end'
    else
      assign row_align = 'start'
  endcase

  case s.alignment
    when 'start'
      assign align_axis = 'start'
      assign text_align = 'start'
    when 'end'
      assign align_axis = 'end'
      assign text_align = 'end'
    else
      assign align_axis = 'center'
      assign text_align = 'center'
  endcase

  assign is_active = s.active | default: false
-%}

{%- capture point_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --hp-row: {{ row }};
  --hp-row-align: {{ row_align }};
  --hp-offset: {{ offset }}px;
  --hp-nudge: {{ nudge }}px;
  --hp-align: {{ align_axis }};
  --hp-text-align: {{ text_align }};
  --hp-width: {{ s.width }}px;
  --hp-gap: {{ s.gap }}px;
  --hp-stack-gap: {{ s.gap_vertical }}px;
{%- endcapture -%}

<div
  class="highlight-point icon-mark-host"
  data-highlight-point
  data-column="{{ column }}"
  {% if is_active %}data-highlight-active aria-current="true"{% endif %}
  data-block-spacing
  style="{{ point_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'block', type: '_highlight-point-icon', id: 'icon' %}

  <span class="highlight-point__body">
    {% content_for 'block', type: '_highlight-point-heading', id: 'heading' %}
    {% content_for 'block', type: '_highlight-point-text', id: 'text' %}
  </span>
</div>

{% schema %}
{
  "name": "t:blocks.highlight_point.name",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "active",
      "label": "t:blocks.highlight_point.settings.active.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:blocks.highlight_point.headers.position"
    },
    {
      "type": "select",
      "id": "column",
      "label": "t:blocks.highlight_point.settings.column.label",
      "options": [
        {
          "value": "left",
          "label": "t:blocks.highlight_point.settings.column.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.highlight_point.settings.column.options__2.label"
        },
        {
          "value": "right",
          "label": "t:blocks.highlight_point.settings.column.options__3.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "row",
      "label": "t:blocks.highlight_point.settings.row.label",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "offset",
      "label": "t:blocks.highlight_point.settings.offset.label",
      "min": 0,
      "max": 280,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ block.settings.column != 'center' }}"
    },
    {
      "type": "range",
      "id": "nudge",
      "label": "t:blocks.highlight_point.settings.nudge.label",
      "min": -160,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.column != 'center' }}"
    },
    {
      "type": "select",
      "id": "row_align",
      "label": "t:blocks.highlight_point.settings.row_align.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.position.options__3.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:blocks.highlight_point.settings.width.label",
      "min": 100,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:blocks.highlight_point.settings.gap.label",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:blocks.featured_pills_check.settings.gap_vertical.label",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
