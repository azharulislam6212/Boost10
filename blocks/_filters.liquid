{% doc %}
  Private. The collection, category and search sections render it statically as
  `_filters`, so it is theirs alone and no other section can pick it up.

  @param {object} [results] - The collection or search result set being filtered. Falls back to `collection`.
{% enddoc %}

{%- liquid
  assign results_set = results | default: collection
  assign layout = block.settings.layout
  if layout == 'inherit' or layout == blank
    assign layout = settings.facets_layout
  endif
-%}

{%- if results_set -%}
  <div class="collection-filters collection-filters--{{ layout }}" {{ block.shopify_attributes }}>
    {%- if layout == 'sidebar' -%}
      <aside class="collection-filters__sidebar" aria-label="{{ 'products.facets.title' | t }}">
        {% render 'facets', results: results_set, section: section, context: 'sidebar' %}
      </aside>
    {%- endif -%}

    <facet-drawer
      id="FacetDrawer-{{ section.id }}"
      class="facet-drawer drawer"
      data-placement="start"
    >
      <dialog class="drawer__dialog" data-ref="dialog" aria-label="{{ 'products.facets.filter_and_sort' | t }}">
        <div class="drawer__panel" data-ref="panel">
          <header class="drawer__header">
            <h2 class="drawer__title visually-hidden">{{ 'products.facets.filter_and_sort' | t }}</h2>
            {%- liquid
              assign filters_drawer_close_label = 'accessibility.close_filters' | t
            -%}
            {% render 'button',
               label: filters_drawer_close_label,
               id: 'FiltersDrawerClose',
               class: 'close-filters-drawer',
               icon: 'close',
               variant: 'primary',
               size: 'small',
               icon_only: true,
               attributes: 'data-overlay-close' %}
          </header>

          <div class="drawer__body" data-ref="body" data-lenis-prevent>
            {% render 'facets', results: results_set, section: section, context: 'drawer' %}
          </div>

          <footer class="drawer__footer">
            <button type="button" class="button button--secondary" data-clear-filters>
              {{ 'products.facets.clear_all' | t }}
            </button>
            <button type="button" class="button button--primary" data-apply-filters>
              {{ 'products.facets.show_results' | t }}
            </button>
          </footer>
        </div>
      </dialog>
    </facet-drawer>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.filters.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.main_collection.settings.filter_layout.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.inherit.label"
        },
        {
          "value": "sidebar",
          "label": "t:sections.main_collection.settings.filter_layout.options__1.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main_collection.settings.filter_layout.options__2.label"
        }
      ],
      "default": "inherit"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.filters.name",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
