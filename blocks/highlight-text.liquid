{% doc %}
  A statement with small pictures set into the line, at `[image1]` and
  `[image2]`. The text plays the theme's text animation and each picture grows
  in from a tenth of its size when the letters reach it.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign preset = s.preset

  assign text_kind = 'text'
  if preset != 'paragraph'
    assign text_kind = 'heading'
  endif

  capture pic_1
    echo '<motion-effect class="highlight-text__media" data-motion-inline '
    render 'motion-attrs', kind: 'image', effect: 'grow-in'
    echo '>'
    if s.image_1 != blank
      render 'image', image: s.image_1, alt: '', ratio: '1-1', sizes: '96px'
    else
      echo 'product-apparel-1' | placeholder_svg_tag: 'highlight-text__placeholder'
    endif
    echo '</motion-effect>'
  endcapture

  capture pic_2
    echo '<motion-effect class="highlight-text__media" data-motion-inline '
    render 'motion-attrs', kind: 'image', effect: 'grow-in'
    echo '>'
    if s.image_2 != blank
      render 'image', image: s.image_2, alt: '', ratio: '1-1', sizes: '96px'
    else
      echo 'product-apparel-2' | placeholder_svg_tag: 'highlight-text__placeholder'
    endif
    echo '</motion-effect>'
  endcapture

  assign statement = s.text | replace: '[image1]', pic_1 | replace: '[image2]', pic_2

  assign classes = 'highlight-text block-text block-text--' | append: preset
  assign classes = classes | append: ' block-text--align-' | append: s.alignment
  assign classes = classes | append: ' block-text--align-mobile-' | append: s.alignment_mobile
  case s.max_width
    when 'narrow'
      assign classes = classes | append: ' block-text--measure-narrow'
    when 'normal'
      assign classes = classes | append: ' block-text--measure-normal'
  endcase
-%}

{%- capture block_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --block-text-flex: 1 1 100%;
  --block-text-width: 100%;
{%- endcapture -%}

{%- if s.text != blank -%}
  <motion-effect
    class="{{ classes }}"
    data-block-spacing
    style="{{ block_style | strip_newlines | strip }}"
    {% render 'motion-attrs', kind: text_kind, block: s %}
    {{ block.shopify_attributes }}
  >
    <p class="highlight-text__text">{{ statement }}</p>
  </motion-effect>
{%- endif -%}

