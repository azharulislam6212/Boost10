{% comment %}
  blocks/product-collapsible.liquid

  Public and repeatable — which is the reason it has to be a block. Shipping,
  returns, ingredients and care are four rows on one store and one row on another.

  A page reference is offered alongside the rich text so a merchant writes the
  returns policy once and reuses it on every product.
{% endcomment %}

{%- if block.settings.heading != blank -%}
  <accordion-element class="product-collapsible" {% render 'spacing', block: block.settings %} {{ block.shopify_attributes }}>
    <details {% if block.settings.open_by_default %}open data-default-open{% endif %}>
      <summary>
        {%- if block.settings.icon != 'none' -%}
          {% render 'icon', icon: block.settings.icon, size: 18 %}
        {%- endif -%}
        <span>{{ block.settings.heading }}</span>
        {% render 'icon', icon: 'chevron-down', size: 14 %}
      </summary>

      <div class="product-collapsible__content rte">
        {{ block.settings.content }}
        {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
      </div>
    </details>
  </accordion-element>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_collapsible.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:shared.heading.label", "default": "Shipping and returns" },
    { "type": "richtext", "id": "content", "label": "t:shared.text.label" },
    { "type": "page", "id": "page", "label": "t:sections.main_product.blocks.collapsible.settings.page.label", "info": "t:sections.main_product.blocks.collapsible.settings.page.info" },
    {
      "type": "select", "id": "icon", "label": "t:blocks.icon_with_text.settings.icon.label",
      "options": [
        { "value": "none", "label": "t:shared.animation.animation_text.options__2.label" },
        { "value": "truck", "label": "t:blocks.icon_with_text.settings.icon.options__1.label" },
        { "value": "refresh", "label": "t:blocks.icon_with_text.settings.icon.options__2.label" },
        { "value": "lock", "label": "t:blocks.icon_with_text.settings.icon.options__3.label" },
        { "value": "info", "label": "t:blocks.icon_with_text.settings.icon.options__7.label" }
      ],
      "default": "none"
    },
    { "type": "checkbox", "id": "open_by_default", "label": "t:sections.main_product.blocks.collapsible.settings.open_by_default.label", "default": false },
        {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        { "value": "desktop", "label": "t:shared.spacing.devices.options__1.label" },
        { "value": "mobile", "label": "t:shared.spacing.devices.options__2.label" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [{ "name": "t:blocks.product_collapsible.name" }]
}
{% endschema %}
