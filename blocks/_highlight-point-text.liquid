{% doc %}
  blocks/_highlight-point-text.liquid — private, static in blocks/_highlight-point.liquid.
  The line under the point's name.
{% enddoc %}

{%- liquid
  assign s = block.settings
-%}

{%- capture text_style -%}
  --hp-text-size: {{ s.text_size | divided_by: 10.0 }}rem;
  {%- if s.text_color != blank -%}
    --hp-text-color: {{ s.text_color }};
  {%- endif -%}
{%- endcapture -%}

{%- if s.text != blank -%}
  <span
    class="highlight-point__text"
    style="{{ text_style | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    {{- s.text -}}
  </span>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.text.name",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:shared.text.label",
      "default": "<p>One short line of proof.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:blocks.featured_pills_step.settings.text_size.label",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.featured_pills_step.settings.text_color.label"
    }
  ]
}
{% endschema %}
