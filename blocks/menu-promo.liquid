{% doc %}
  blocks/menu-promo.liquid — Boost10
{% enddoc %}

{%- liquid
  assign st = block.settings
  assign has_link = false
  if st.link != blank
    assign has_link = true
  endif

  assign tag = 'div'
  if has_link and st.cta_style != 'button'
    assign tag = 'a'
  endif

  assign show_over = false
  assign show_below = false
  case st.text_position
    when 'over'
      assign show_over = true
    when 'both'
      assign show_over = true
      assign show_below = true
    else
      assign show_below = true
  endcase
-%}

{%- capture eyebrow_and_heading -%}
  {%- if st.eyebrow != blank -%}
    <span class="menu-promo__eyebrow">{{ st.eyebrow | escape }}</span>
  {%- endif -%}
  {%- if st.heading != blank -%}
    <span class="menu-promo__heading">{{ st.heading | escape }}</span>
  {%- endif -%}
{%- endcapture -%}

{%- capture call_to_action -%}
  {%- if st.link_label != blank -%}
    {%- if st.cta_style == 'button' -%}

      <span class="menu-promo__button">
        {% render 'button',
          label: st.link_label,
          href: st.link,
          variant: st.button_variant,
          size: 'small',
          icon: 'arrow-right'
        %}
      </span>
    {%- else -%}
      <span class="menu-promo__cta">
        <span>{{ st.link_label | escape }}</span>
        {% render 'icon', icon: 'arrow-right', size: 16 %}
      </span>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

<{{ tag }}
  class="megamenu__item menu-promo menu-promo--{{ st.text_position }}"
  {% if tag == 'a' %}href="{{ st.link }}"{% endif %}
  style="--span: {{ st.column_span }}; --promo-radius: {{ st.corner_radius }}px;"
  {{ block.shopify_attributes }}
>
  <span class="menu-promo__media">
    {%- if st.image != blank -%}
      {% render 'image',
        image: st.image,
        alt: st.heading,
        ratio: st.image_ratio,
        sizes: '(min-width: 990px) 33vw, 90vw',
        wrapper_class: 'menu-promo__image',
        class: 'menu-promo__img'
      %}
    {%- else -%}
      <span class="menu-promo__image menu-promo__image--placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </span>
    {%- endif -%}

    {%- if show_over -%}
      <span class="menu-promo__panel">
        {{ eyebrow_and_heading }}
        {%- unless show_below -%}{{ call_to_action }}{%- endunless -%}
      </span>
    {%- endif -%}
  </span>

  {%- if show_below -%}
    <span class="menu-promo__content">
      {%- unless show_over -%}{{ eyebrow_and_heading }}{%- endunless -%}
      {{ call_to_action }}
    </span>
  {%- endif -%}
</{{ tag }}>

{% schema %}
{
  "name": "t:blocks.menu_promo.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:shared.image.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:shared.image_ratio.label",
      "options": [
        {
          "value": "portrait",
          "label": "t:shared.image_ratio.options__1.label"
        },
        {
          "value": "3-4",
          "label": "t:shared.image_ratio.options__2.label"
        },
        {
          "value": "2-3",
          "label": "t:shared.image_ratio.options__3.label"
        },
        {
          "value": "9-16",
          "label": "t:shared.image_ratio.options__4.label"
        },
        {
          "value": "1-1",
          "label": "t:shared.image_ratio.options__5.label"
        },
        {
          "value": "5-4",
          "label": "t:shared.image_ratio.options__6.label"
        },
        {
          "value": "4-3",
          "label": "t:shared.image_ratio.options__7.label"
        },
        {
          "value": "3-2",
          "label": "t:shared.image_ratio.options__8.label"
        },
        {
          "value": "16-9",
          "label": "t:shared.image_ratio.options__9.label"
        },
        {
          "value": "aspect-ratio",
          "label": "t:shared.image_ratio.options__10.label"
        }
      ],
      "default": "3-4"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:blocks.menu_promo.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading.label",
      "default": "Micronutrients for Peak Daily Vitality"
    },
    {
      "type": "header",
      "content": "t:blocks.menu_promo.headers.cta"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:blocks.menu_promo.settings.link_label.label",
      "default": "Shop Vitamin"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:shared.link.label"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "t:blocks.menu_promo.settings.cta_style.label",
      "info": "t:blocks.menu_promo.settings.cta_style.info",
      "options": [
        {
          "value": "link",
          "label": "t:blocks.menu_promo.settings.cta_style.options__1.label"
        },
        {
          "value": "button",
          "label": "t:blocks.menu_promo.settings.cta_style.options__2.label"
        }
      ],
      "default": "link"
    },
    {
      "type": "select",
      "id": "button_variant",
      "label": "t:blocks.menu_promo.settings.button_variant.label",
      "options": [
        {
          "value": "primary",
          "label": "t:blocks.menu_promo.settings.button_variant.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:blocks.menu_promo.settings.button_variant.options__2.label"
        },
        {
          "value": "outline",
          "label": "t:blocks.menu_promo.settings.button_variant.options__3.label"
        }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "t:shared.layout.label"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "t:blocks.menu_promo.settings.text_position.label",
      "info": "t:blocks.menu_promo.settings.text_position.info",
      "options": [
        {
          "value": "over",
          "label": "t:blocks.menu_promo.settings.text_position.options__2.label"
        },
        {
          "value": "below",
          "label": "t:blocks.menu_promo.settings.text_position.options__1.label"
        },
        {
          "value": "both",
          "label": "t:blocks.menu_promo.settings.text_position.options__3.label"
        }
      ],
      "default": "over"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:shared.corner_radius.label",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "column_span",
      "label": "t:blocks.shared.column_span.label",
      "info": "t:blocks.shared.column_span.info",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
