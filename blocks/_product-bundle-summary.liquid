{% doc %}
  blocks/_product-bundle-summary.liquid — "Build your own bundle".
{% enddoc %}

{%- liquid
  assign s = section.settings
-%}

<div
  class="bundle-tray__summary"
  {% render 'spacing', block: block.settings %}
  {{ block.shopify_attributes }}
>
  {%- if s.tray_icon != 'none' -%}
    <span class="bundle-tray__mark" aria-hidden="true">
      {% render 'icon', icon: s.tray_icon, size: 24 %}
    </span>
  {%- endif -%}

  <h2 class="bundle-tray__title">{{ s.tray_heading }}</h2>

  {%- if s.tray_subheading != blank -%}
    <p class="bundle-tray__subtitle">{{ s.tray_subheading }}</p>
  {%- endif -%}

  {%- if s.tray_note != blank -%}
    <p class="bundle-tray__note" data-ref="note" role="status">
      {%- if s.tray_note_icon != 'none' -%}
        {% render 'icon', icon: s.tray_note_icon, size: 16 %}
      {%- endif -%}
      <span data-ref="noteText">{{ s.tray_note }}</span>
    </p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.product_bundle_summary.name",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.product_bundle_summary.paragraph"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product_bundle_summary.name",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
