{% doc %}
  blocks/_banner-stat.liquid — private to `blocks/banner.liquid`.
  A frosted panel pinned to a top corner of the banner: an arc filled to the
  Progress value, a number and a label. The arc fills as the banner enters.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign fill = s.fill
  if fill > 100
    assign fill = 100
  endif
-%}

{%- capture stat_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --banner-stat-width: {{ s.width }}px;
  --banner-stat-offset: {{ s.offset }}px;
  --banner-stat-radius: {{ s.radius }}px;
  --banner-stat-blur: {{ s.blur }}px;
  --banner-stat-fill: {{ fill }};
  {%- if s.background != blank -%}--banner-stat-background: {{ s.background }};{%- endif -%}
  {%- if s.text_color != blank -%}--banner-stat-text: {{ s.text_color }};{%- endif -%}
  {%- if s.fill_color != blank -%}--banner-stat-arc: {{ s.fill_color }};{%- endif -%}
  {%- if s.track_color != blank -%}--banner-stat-track: {{ s.track_color }};{%- endif -%}
{%- endcapture -%}

<div
  class="banner-stat banner-stat--{{ s.position }}"
  data-block-spacing
  style="{{ stat_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  <svg class="banner-stat__arc" viewBox="0 0 160 46" fill="none" aria-hidden="true" focusable="false">
    <path class="banner-stat__track" d="M8 41.5A100 100 0 0 1 152 41.5" pathLength="100"/>
    <path class="banner-stat__progress" d="M8 41.5A100 100 0 0 1 152 41.5" pathLength="100"/>
  </svg>
  {%- if s.value != blank -%}
    <span class="banner-stat__value">{{ s.value | escape }}</span>
  {%- endif -%}
  {%- if s.label != blank -%}
    <span class="banner-stat__label">{{ s.label | escape }}</span>
  {%- endif -%}
</div>

{% stylesheet %}
@layer components {
  .banner-card > .block-group__content > :not(.banner-stat) {
    position: relative;
    z-index: 1;
  }
  .banner-stat {
    position: absolute;
    z-index: 2;
    --banner-stat-inset: min(var(--banner-stat-offset, 36px), 5.5cqi);

    inset-block-start: var(--banner-stat-inset);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    inline-size: min(var(--banner-stat-width, 204px), 44cqi);
    border-radius: var(--banner-stat-radius, 16px);
    background-color: var(--banner-stat-background, rgb(255 255 255 / 0.62));
    -webkit-backdrop-filter: blur(var(--banner-stat-blur, 12px));
    backdrop-filter: blur(var(--banner-stat-blur, 12px));
    color: var(--banner-stat-text, var(--color-text));
    text-align: center;
  }
  .banner-stat--end { inset-inline-end: var(--banner-stat-inset); }
  .banner-stat--start { inset-inline-start: var(--banner-stat-inset); }
  .banner-stat__arc {
    inline-size: 76%;
    block-size: auto;
    margin-block-end: clamp(0.6rem, 2.4cqi, 1.6rem);
    overflow: visible;
  }
  .banner-stat__track,
  .banner-stat__progress {
    fill: none;
    stroke-width: 6;
    stroke-linecap: round;
  }
  .banner-stat__track {
    stroke: var(--banner-stat-track, color-mix(in srgb, currentColor 15%, transparent));
  }
  .banner-stat__progress {
    stroke: var(--banner-stat-arc, var(--color-accent));
    stroke-dasharray: var(--banner-stat-fill, 0) 100;
    transition:
      stroke-dasharray 1400ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) 300ms,
      opacity 200ms linear 300ms;
  }
  .banner-card[data-motion-pending] .banner-stat__progress {
    stroke-dasharray: 0 100;
    opacity: 0;
    transition: none;
  }
  .banner-stat__value {
    color: var(--banner-stat-text, var(--color-heading, currentColor));
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(2.4rem, 6.7cqi, 4.4rem);
    line-height: 1;
  }
  .banner-stat__label {
    font-size: clamp(1.1rem, 2cqi, 1.3rem);
    font-weight: 600;
    line-height: 1.3;
  }
  @media (prefers-reduced-motion: reduce) {
    .banner-stat__progress { transition: none; }
  }
}
@layer overrides {
  @container (max-width: 520px) {
    .banner-card > .block-group__content > :not(.banner-stat) {
      flex: 0 0 auto;
      max-inline-size: 100%;
    }
  }
}
{% endstylesheet %}

