{% doc %}
  The panel behind the feature cards, written as custom properties the section
  folds into the panel's own style attribute.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign line = s.panel_border_style | default: 'dashed'
  assign width = 0
  assign paint = ''

  if line != 'none'
    assign width = s.panel_border_width | default: 1 | plus: 0

    assign percent = s.panel_border_opacity | default: 100 | plus: 0
    if s.panel_border_color == blank
      assign paint = 'color-mix(in srgb, currentColor ' | append: percent | append: '%, transparent)'
    else
      assign alpha = percent | divided_by: 100.0
      assign paint = s.panel_border_color | color_modify: 'alpha', alpha
    endif
  endif

  assign padding = s.panel_padding | default: 0 | plus: 0
  assign padding_mobile = s.panel_padding_mobile | default: 6 | plus: 0

  assign background = ''
  assign tint = s.panel_background | default: '#FFFFFF'
  if tint != blank
    assign bg_alpha = s.panel_background_opacity | default: 100 | plus: 0
    assign bg_alpha = bg_alpha | divided_by: 100.0
    assign background = tint | color_modify: 'alpha', bg_alpha
  endif
-%}
--feature-cards-panel-padding: {{ padding }}px;
--feature-cards-panel-padding-mobile: {{ padding_mobile }}px;
{%- if width > 0 -%}
  --feature-cards-panel-border-width: {{ width }}px;
  --feature-cards-panel-border-style: {{ line }};
  --feature-cards-panel-border-color: {{ paint }};
{%- endif -%}
{%- if background != '' -%}
  --feature-cards-panel-background: {{ background }};
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.feature_cards_panel.name",
  "tag": null,
  "settings": [
    {
      "type": "color",
      "id": "panel_background",
      "label": "t:shared.appearance.background_color.label",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "panel_background_opacity",
      "label": "t:sections.feature_cards.settings.panel_background_opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "panel_border_style",
      "label": "t:shared.border.style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.options.dashed"
        }
      ],
      "default": "dashed"
    },
    {
      "type": "range",
      "id": "panel_border_width",
      "label": "t:shared.border.thickness.label",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.panel_border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "panel_border_opacity",
      "label": "t:shared.border.opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.panel_border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "panel_border_color",
      "label": "t:shared.border.color.label",
      "info": "t:shared.border.color.info",
      "default": "#0F2E2F",
      "visible_if": "{{ block.settings.panel_border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "panel_padding",
      "label": "t:sections.feature_cards.settings.panel_padding.label",
      "info": "t:sections.feature_cards.settings.panel_padding.info",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "panel_padding_mobile",
      "label": "t:sections.feature_cards.settings.panel_padding_mobile.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ]
}
{% endschema %}
