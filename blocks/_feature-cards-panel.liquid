{% doc %}
  blocks/_feature-cards-panel.liquid — private, static in sections/feature-cards.liquid.
  The bordered panel holding the feature cards, as a grid or a carousel, with
  the carousel's controls under it.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign desktop = s.columns_desktop | default: 4 | plus: 0

  assign cols_mobile = s.columns_mobile | default: 1 | plus: 0
  if cols_mobile > 2
    assign cols_mobile = 2
  endif
  if cols_mobile < 1
    assign cols_mobile = 1
  endif

  assign cols_tablet = s.columns_tablet | default: 2 | plus: 0

  assign panel_line = s.panel_border_style | default: 'dashed'
  assign panel_width = 0
  assign panel_paint = ''

  if panel_line != 'none'
    assign panel_width = s.panel_border_width | default: 1 | plus: 0

    assign panel_percent = s.panel_border_opacity | default: 100 | plus: 0
    if s.panel_border_color == blank
      assign panel_paint = 'color-mix(in srgb, currentColor ' | append: panel_percent | append: '%, transparent)'
    else
      assign panel_alpha = panel_percent | divided_by: 100.0
      assign panel_paint = s.panel_border_color | color_modify: 'alpha', panel_alpha
    endif
  endif

  assign panel_radius = s.panel_border_radius | default: 40 | plus: 0
  assign panel_radius_mobile = s.panel_border_radius_mobile | default: panel_radius | plus: 0

  assign panel_padding = s.panel_padding | default: 0 | plus: 0
  assign panel_padding_mobile = s.panel_padding_mobile | default: 6 | plus: 0

  assign panel_background = ''
  assign panel_tint = s.panel_background | default: '#FFFFFF'
  if panel_tint != blank
    assign panel_bg_alpha = s.panel_background_opacity | default: 100 | plus: 0
    assign panel_bg_alpha = panel_bg_alpha | divided_by: 100.0
    assign panel_background = panel_tint | color_modify: 'alpha', panel_bg_alpha
  endif

  assign panel_clipped = false
  if panel_radius > 0 or panel_radius_mobile > 0
    assign panel_clipped = true
  endif

  assign layout_type = s.layout | default: 'grid'

  assign cs_layout = 'grid'
  if layout_type == 'carousel'
    assign cs_layout = 'carousel'
  endif

  assign carousel_on_mobile = s.carousel_on_mobile
  if carousel_on_mobile == nil
    assign carousel_on_mobile = true
  endif

  assign cs_layout_mobile = 'grid'
  if layout_type == 'carousel' or carousel_on_mobile
    assign cs_layout_mobile = 'carousel'
  endif

  assign cs_is_carousel = false
  if cs_layout == 'carousel' or cs_layout_mobile == 'carousel'
    assign cs_is_carousel = true
  endif

  assign cs_count = 0
  for feature_block in block.blocks
    if feature_block.type == '_feature-card'
      assign cs_count = cs_count | plus: 1
    endif
  endfor

  assign cs_label = 'accessibility.carousel' | t

  assign carousel_id = 'feature-cards-' | append: section.id

  assign cs_pagination = s.carousel_pagination | default: 'dots'
  assign cs_pagination_align = s.carousel_pagination_align | default: 'center'

  assign cs_nav = s.carousel_navigation
  if cs_nav == nil
    assign cs_nav = false
  endif

  assign controls_class = 'feature-cards__controls'
  if cs_layout == 'carousel'
    assign controls_class = controls_class | append: ' feature-cards__controls--always'
  elsif cs_layout_mobile == 'carousel'
    assign controls_class = controls_class | append: ' feature-cards__controls--mobile'
  endif

  assign has_controls = false
  if cs_is_carousel and cs_nav or cs_is_carousel and cs_pagination != 'none'
    assign has_controls = true
  endif

  assign gap_x = s.gap_horizontal | default: 24 | plus: 0
  assign gap_y = s.gap_vertical | default: 24 | plus: 0

  assign gap_x_mobile = s.gap_horizontal_mobile | plus: 0
  if s.gap_horizontal_mobile == nil
    assign gap_x_mobile = 12
  endif
  assign gap_y_mobile = s.gap_vertical_mobile | plus: 0
  if s.gap_vertical_mobile == nil
    assign gap_y_mobile = 12
  endif

  assign card_stagger = 120
-%}

{%- capture panel_style -%}
  --fc-gap-x: {{ gap_x }}px;
  --fc-gap-y: {{ gap_y }}px;
  --fc-gap-x-mobile: {{ gap_x_mobile }}px;
  --fc-gap-y-mobile: {{ gap_y_mobile }}px;
  --feature-cards-panel-radius: {{ panel_radius }}px;
  --feature-cards-panel-radius-mobile: {{ panel_radius_mobile }}px;
  --feature-cards-panel-padding: {{ panel_padding }}px;
  --feature-cards-panel-padding-mobile: {{ panel_padding_mobile }}px;
  --feature-cards-controls-gap: {{ s.carousel_controls_gap | default: 24 | plus: 0 }}px;
  {%- if panel_width > 0 -%}
    --feature-cards-panel-border-width: {{ panel_width }}px;
    --feature-cards-panel-border-style: {{ panel_line }};
    --feature-cards-panel-border-color: {{ panel_paint }};
  {%- endif -%}
  {%- if panel_background != '' -%}
    --feature-cards-panel-background: {{ panel_background }};
  {%- endif -%}
{%- endcapture -%}

<div class="feature-cards__body" style="{{ panel_style | strip_newlines | strip }}" {{ block.shopify_attributes }}>
  <motion-effect
    class="feature-cards__panel{% if panel_clipped %} feature-cards__panel--clipped{% endif %}"
    {% render 'motion-attrs',
       kind: 'content',
       section: section.settings,
       target: '.feature-card',
       duration: 800,
       stagger: card_stagger %}
  >
    <carousel-slider
      {% render 'carousel-shell-attrs',
         settings: s,
         id: carousel_id,
         layout: cs_layout,
         layout_mobile: cs_layout_mobile,
         classes: 'feature-cards__carousel',
         columns_desktop: desktop,
         columns_tablet: cols_tablet,
         columns_mobile: cols_mobile,
         count: cs_count %}
    >
      <div
        class="carousel-shell__track feature-cards__grid"
        data-ref="track"
        {% if cs_is_carousel %}aria-label="{{ cs_label | escape }}"{% endif %}
      >
        {% content_for 'blocks' %}
      </div>

      {% render 'carousel-shell-tail',
         settings: s,
         layout: cs_layout,
         layout_mobile: cs_layout_mobile,
         detached: true %}
    </carousel-slider>
  </motion-effect>

  {%- if has_controls -%}
    <div class="{{ controls_class }}" style="{% render 'carousel-style', settings: s %}">
      {%- render 'carousel-outside-controls',
         settings: s,
         carousel: carousel_id,
         pagination: cs_pagination,
         align: cs_pagination_align,
         nav: cs_nav -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.feature_cards_panel.name",
  "tag": null,
  "blocks": [
    {
      "type": "_feature-card"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:sections.featured_blog.headers.cards"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:shared.carousel.layout_type.label",
      "options": [
        {
          "value": "grid",
          "label": "t:shared.carousel.layout_type.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:shared.carousel.layout_type.options__2.label"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:shared.carousel.carousel_on_mobile.label",
      "default": true,
      "visible_if": "{{ block.settings.layout != 'carousel' }}"
    },
    {
      "type": "header",
      "content": "t:shared.columns.header"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns.desktop.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:shared.columns.tablet.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.columns.mobile.label",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "gap_device",
      "label": "t:shared.gap.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_horizontal_mobile",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.gap_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical_mobile",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.gap_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:sections.feature_cards.headers.panel"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "t:shared.appearance.background_color.label",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "panel_background_opacity",
      "label": "t:sections.feature_cards.settings.panel_background_opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "panel_border_style",
      "label": "t:shared.border.style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.options.dashed"
        }
      ],
      "default": "dashed"
    },
    {
      "type": "range",
      "id": "panel_border_width",
      "label": "t:shared.border.thickness.label",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.panel_border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "panel_border_opacity",
      "label": "t:shared.border.opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.panel_border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "panel_border_color",
      "label": "t:shared.border.color.label",
      "default": "#0F2E2F",
      "visible_if": "{{ block.settings.panel_border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "panel_border_radius",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "panel_border_radius_mobile",
      "label": "t:shared.corners.radius_mobile.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "panel_padding",
      "label": "t:sections.feature_cards.settings.panel_padding.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "panel_padding_mobile",
      "label": "t:sections.feature_cards.settings.panel_padding_mobile.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "t:sections.featured_blog.headers.carousel",
      "visible_if": "{{ block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_loop",
      "label": "t:shared.carousel.loop.label",
      "default": false,
      "visible_if": "{{ block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "t:shared.carousel.autoplay.label",
      "default": false,
      "visible_if": "{{ block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "range",
      "id": "carousel_autoplay_delay",
      "label": "t:blocks.showcase_column.settings.speed.label",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ block.settings.carousel_autoplay and block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.navigation",
      "visible_if": "{{ block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_navigation",
      "label": "t:shared.carousel.navigation.label",
      "default": false,
      "visible_if": "{{ block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_icon",
      "label": "t:shared.carousel.nav_glyph.label",
      "options": [
        {
          "value": "arrow",
          "label": "t:shared.carousel.nav_glyph.options__1.label"
        },
        {
          "value": "chevron",
          "label": "t:shared.carousel.nav_glyph.options__2.label"
        },
        {
          "value": "arrow-large",
          "label": "t:shared.carousel.nav_glyph.options__3.label"
        },
        {
          "value": "chevron-large",
          "label": "t:shared.carousel.nav_glyph.options__4.label"
        },
        {
          "value": "none",
          "label": "t:shared.carousel.nav_glyph.options__5.label"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.carousel_navigation and block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_shape",
      "label": "t:shared.carousel.nav_shape.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.carousel.nav_shape.options__1.label"
        },
        {
          "value": "circle",
          "label": "t:shared.carousel.nav_shape.options__2.label"
        },
        {
          "value": "square",
          "label": "t:shared.carousel.nav_shape.options__3.label"
        }
      ],
      "default": "circle",
      "visible_if": "{{ block.settings.carousel_navigation and block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_border_style",
      "label": "t:shared.carousel.nav_border_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.options.dashed"
        },
        {
          "value": "none",
          "label": "t:shared.options.none"
        }
      ],
      "default": "dashed",
      "visible_if": "{{ block.settings.carousel_navigation and block.settings.carousel_nav_shape != 'none' and block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_style",
      "label": "t:shared.carousel.controls_style.label",
      "options": [
        {
          "value": "split",
          "label": "t:shared.carousel.controls_style.options__1.label"
        },
        {
          "value": "ghost",
          "label": "t:shared.carousel.controls_style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:shared.carousel.controls_style.options__3.label"
        }
      ],
      "default": "ghost",
      "visible_if": "{{ block.settings.carousel_navigation and block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.pagination",
      "visible_if": "{{ block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "t:shared.carousel.pagination.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.carousel.pagination.options__1.label"
        },
        {
          "value": "dots",
          "label": "t:shared.carousel.pagination.options__2.label"
        },
        {
          "value": "numbers",
          "label": "t:shared.carousel.pagination.options__3.label"
        },
        {
          "value": "progress",
          "label": "t:shared.carousel.pagination.options__4.label"
        },
        {
          "value": "controls",
          "label": "t:shared.carousel.pagination.options__5.label"
        }
      ],
      "default": "dots",
      "visible_if": "{{ block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_pagination_align",
      "label": "t:shared.carousel.pagination_align.label",
      "options": [
        {
          "value": "start",
          "label": "t:shared.carousel.controls_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:shared.carousel.controls_align.options__2.label"
        },
        {
          "value": "end",
          "label": "t:shared.carousel.controls_align.options__3.label"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.carousel_pagination != 'none' and block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.controls",
      "visible_if": "{{ block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_inherit_scheme",
      "label": "t:shared.carousel.inherit_scheme.label",
      "default": true,
      "visible_if": "{{ block.settings.layout == 'carousel' or block.settings.carousel_on_mobile }}"
    },
    {
      "type": "color_scheme",
      "id": "carousel_color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false }}"
    }
  ]
}
{% endschema %}
