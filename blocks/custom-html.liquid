{% comment %}
  blocks/custom-html.liquid

  Raw HTML from the Theme Editor.

  Separate from `custom-liquid` on purpose. Liquid runs on Shopify's servers and
  can read the store's data; HTML cannot. A merchant pasting an embed code, a
  badge, or a widget wants the second thing, and giving them a Liquid field for
  it means a typo in a tag becomes a Liquid syntax error that takes the whole
  section down.

  Output is not escaped — it cannot be, or the block would be pointless. That is
  the merchant's own input from their own admin, which is the same trust boundary
  Shopify's native Custom Liquid section uses.
{% endcomment %}

<div class="custom-html" {% render 'spacing', block: block.settings %} {{ block.shopify_attributes }}>
  {{ block.settings.html }}
</div>

{% schema %}
{
  "name": "t:blocks.custom_embed.name",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "t:blocks.custom_embed.paragraph" },
    { "type": "html", "id": "html", "label": "t:blocks.custom_embed.settings.code.label" },
    { "type": "header", "content": "t:shared.spacing.block_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.custom_embed.name" }]
}
{% endschema %}
