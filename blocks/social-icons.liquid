{% comment %}
  blocks/social-icons.liquid

  Renders only the accounts the merchant has filled in, from Theme settings. A
  row showing three of nine networks is normal; placeholders for the rest are not.
{% endcomment %}

<div class="social-block" {% render 'spacing', block: block.settings %} {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h2 class="social-block__heading">{{ block.settings.heading }}</h2>
  {%- endif -%}

  {% render 'social-icons', size: block.settings.icon_size %}
</div>

{% schema %}
{
  "name": "t:blocks.social_icons.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:shared.heading.label" },
    { "type": "paragraph", "content": "t:sections.footer.blocks.social.paragraph" },
    { "type": "range", "id": "icon_size", "label": "t:blocks.icon_with_text.settings.icon_size.label", "min": 14, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "header", "content": "t:shared.spacing.block_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.social_icons.name" }]
}
{% endschema %}
