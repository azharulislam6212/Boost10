{% comment %}
  blocks/social-icons.liquid

  Renders only the accounts the merchant has filled in, from Theme settings. A
  row showing three of nine networks is normal; placeholders for the rest are not.
{% endcomment %}

{%- liquid
  capture icon_px
    render 'icon-size', size: block.settings.icon_size, custom: block.settings.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0
-%}

<div class="social-block" {% render 'spacing', block: block.settings %} {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h2 class="social-block__heading">{{ block.settings.heading }}</h2>
  {%- endif -%}

  {% render 'social-icons', size: icon_size %}
</div>

{% schema %}
{
  "name": "t:blocks.social_icons.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:shared.heading.label" },
    { "type": "paragraph", "content": "t:sections.footer.blocks.social.paragraph" },
    {
      "type": "select", "id": "icon_size", "label": "t:blocks.icon_with_text.settings.icon_size.label",
      "options": [
        { "value": "extra_small", "label": "t:shared.icon_size.options__1.label" },
        { "value": "small", "label": "t:shared.icon_size.options__2.label" },
        { "value": "medium", "label": "t:shared.icon_size.options__3.label" },
        { "value": "large", "label": "t:shared.icon_size.options__4.label" },
        { "value": "extra_large", "label": "t:shared.icon_size.options__5.label" },
        { "value": "custom", "label": "t:shared.icon_size.options__6.label" }
      ],
      "default": "medium"
    },
    {
      "type": "range", "id": "icon_size_custom", "label": "t:shared.icon_size.custom.label",
      "info": "t:shared.icon_size.custom.info",
      "min": 14, "max": 32, "step": 2, "unit": "px", "default": 18,
      "visible_if": "{{ block.settings.icon_size == 'custom' }}"
    },
        {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        { "value": "desktop", "label": "t:shared.spacing.devices.options__1.label" },
        { "value": "mobile", "label": "t:shared.spacing.devices.options__2.label" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [{ "name": "t:blocks.social_icons.name" }]
}
{% endschema %}
