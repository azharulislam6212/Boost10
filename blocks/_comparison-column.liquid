{% doc %}
  One column of the comparison. Private — addable inside Comparison table only.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign role = s.role | default: 'product'

  assign has_head = true
  if role == 'features' and s.show_head != true
    assign has_head = false
  endif

  assign is_chooser = false
  if role == 'product'
    assign is_chooser = true
  endif

  assign head_source = s.head_source | default: 'logo'
  assign show_logo = false
  if role == 'brand' and head_source == 'logo' and s.logo != blank
    assign show_logo = true
  endif

  assign show_head_text = false
  if has_head and is_chooser == false and show_logo == false
    if s.name != blank and head_source != 'none'
      assign show_head_text = true
    endif
  endif

  assign border_line = s.border_style | default: 'none'
  assign border_width = 0
  if border_line != 'none'
    assign border_width = s.border_width | default: 1 | plus: 0
    assign border_percent = s.border_opacity | default: 100 | plus: 0
    if s.border_color == blank
      assign border_paint = 'color-mix(in srgb, currentColor ' | append: border_percent | append: '%, transparent)'
    else
      assign border_alpha = border_percent | divided_by: 100.0
      assign border_paint = s.border_color | color_modify: 'alpha', border_alpha
    endif
  endif

  assign r_tl = s.radius_top_left | default: 16 | plus: 0
  assign r_tr = s.radius_top_right | default: 16 | plus: 0
  assign r_bl = s.radius_bottom_left | default: 16 | plus: 0
  assign r_br = s.radius_bottom_right | default: 16 | plus: 0

  assign r_tl_m = s.radius_top_left_mobile | default: r_tl | plus: 0
  assign r_tr_m = s.radius_top_right_mobile | default: r_tr | plus: 0
  assign r_bl_m = s.radius_bottom_left_mobile | default: r_bl | plus: 0
  assign r_br_m = s.radius_bottom_right_mobile | default: r_br | plus: 0

  assign divider_style = s.divider_style | default: 'none'
  assign divider_percent = s.divider_opacity | default: 100 | plus: 0
  if s.divider_color == blank
    assign divider_paint = 'color-mix(in srgb, currentColor ' | append: divider_percent | append: '%, transparent)'
  else
    assign divider_alpha = divider_percent | divided_by: 100.0
    assign divider_paint = s.divider_color | color_modify: 'alpha', divider_alpha
  endif

  assign divider_dash = s.divider_dash | default: 2 | plus: 0
  assign divider_gap = s.divider_gap | default: 2 | plus: 0
  if divider_style == 'solid'
    assign divider_gap = 0
  endif
  assign divider_pitch = divider_dash | plus: divider_gap

  assign classes = 'comparison-column comparison-column--' | append: role
  unless has_head
    assign classes = classes | append: ' comparison-column--headless'
  endunless
  if divider_style != 'none'
    assign classes = classes | append: ' comparison-column--ruled'
  endif

  assign column_name = s.name | default: ''

  assign alternative = 1
  if is_chooser
    assign alternatives = section.settings.alternatives | strip | newline_to_br | split: '<br />'
    assign alternative = s.alternative | default: 1 | plus: 0
    if alternative > alternatives.size
      assign alternative = alternatives.size
    endif
    if alternative < 1
      assign alternative = 1
    endif
    assign alt_index = alternative | minus: 1
    assign chosen = alternatives[alt_index] | strip
    if chosen != blank
      assign column_name = chosen
    endif
  endif

  assign chevron_px = s.chevron_size | default: 16 | plus: 0
-%}

{%- capture column_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --ct-col-radius: {{ r_tl }}px {{ r_tr }}px {{ r_br }}px {{ r_bl }}px;
  --ct-col-radius-mobile: {{ r_tl_m }}px {{ r_tr_m }}px {{ r_br_m }}px {{ r_bl_m }}px;
  --ct-col-border-width: {{ border_width }}px;
  {%- if border_width > 0 -%}
    --ct-col-border-style: {{ border_line }};
    --ct-col-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if s.background != blank -%}
    --ct-col-background: {{ s.background }};
  {%- endif -%}
  {%- if s.text_color != blank -%}
    --ct-col-text: {{ s.text_color }};
  {%- endif -%}
  --ct-cell-align: {{ s.cell_alignment | default: 'center' }};
  {%- if divider_style != 'none' -%}
    --ct-divider-height: {{ s.divider_width | default: 1 | plus: 0 }}px;
    --ct-divider-image: repeating-linear-gradient(to right, {{ divider_paint }} 0 {{ divider_dash }}px, transparent {{ divider_dash }}px {{ divider_pitch }}px);
  {%- else -%}
    --ct-divider-height: 0px;
    --ct-divider-image: none;
  {%- endif -%}
  {%- if show_logo -%}
    --ct-logo-width: {{ s.logo_width | default: 140 | plus: 0 }}px;
    --ct-logo-width-mobile: {{ s.logo_width_mobile | default: 96 | plus: 0 }}px;
  {%- endif -%}
  {%- if show_head_text -%}
    --ct-head-size: {{ s.head_font_size | default: 18 | plus: 0 | divided_by: 10.0 }}rem;
    --ct-head-size-mobile: {{ s.head_font_size_mobile | default: 15 | plus: 0 | divided_by: 10.0 }}rem;
    --ct-head-weight: {{ s.head_font_weight | default: '700' }};
    {%- if s.head_color != blank -%}--ct-head-color: {{ s.head_color }};{%- endif -%}
  {%- endif -%}
{%- endcapture -%}

<div
  class="{{ classes }}"
  data-block-spacing
  data-comparison-column
  data-comparison-role="{{ role }}"
  {%- if is_chooser %} data-comparison-alternative="{{ alternative }}"{% endif %}
  {%- if column_name != blank %} data-comparison-name="{{ column_name | escape }}"{% endif %}
  {%- if column_name != blank %} role="group" aria-label="{{ column_name | escape }}"{% endif %}
  style="{{ column_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {%- if has_head -%}
    <div class="comparison-column__head">
      {%- if is_chooser -%}
        <button
          type="button"
          class="comparison-choose__trigger"
          data-comparison-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-disabled="true"
        >
          <span class="comparison-choose__name" data-comparison-trigger-label>
            {{- column_name | default: 'Alternative' | escape -}}
          </span>
          {% render 'icon', icon: 'chevron-down', class: 'comparison-choose__chevron', size: chevron_px %}
        </button>

        <div
          class="comparison-choose__panel"
          data-comparison-panel
          role="listbox"
          tabindex="-1"
          aria-label="{{ column_name | default: 'Alternative' | escape }}"
          hidden
        ></div>
      {%- elsif show_logo -%}
        <div class="comparison-column__logo">
          {% render 'image',
             image: s.logo,
             alt: column_name,
             class: 'comparison-column__logo-image',
             widths: '160,240,320,480',
             sizes: '160px' %}
        </div>
      {%- elsif show_head_text -%}
        <span class="comparison-column__title">{{ column_name | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {% content_for 'blocks' %}
</div>

