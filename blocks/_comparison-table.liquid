{% doc %}
  The comparison grid. Private — addable inside Comparison table only.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign label_ratio = s.label_ratio | default: 123 | plus: 0
  assign label_col = label_ratio | divided_by: 100.0

  assign label_ratio_tablet = s.label_ratio_tablet | default: label_ratio | plus: 0
  assign label_col_tablet = label_ratio_tablet | divided_by: 100.0

  assign label_ratio_mobile = s.label_ratio_mobile | default: label_ratio_tablet | plus: 0
  assign label_col_mobile = label_ratio_mobile | divided_by: 100.0

  assign slots = s.slots | default: 2 | plus: 0
  assign slots_tablet = s.slots_tablet | default: 1 | plus: 0
  assign slots_mobile = s.slots_mobile | default: 1 | plus: 0

  assign cols = slots | plus: 1
  assign cols_tablet = slots_tablet | plus: 1
  assign cols_mobile = slots_mobile | plus: 1

  assign grid_classes = 'comparison-grid comparison-grid--slots-' | append: slots
  assign grid_classes = grid_classes | append: ' comparison-grid--slots-tablet-' | append: slots_tablet
  assign grid_classes = grid_classes | append: ' comparison-grid--slots-mobile-' | append: slots_mobile

  assign alternatives = section.settings.alternatives | strip | newline_to_br | split: '<br />'

  assign rows = s.rows | default: 6 | plus: 0

  assign table_line = s.border_style | default: 'none'
  assign table_width = 0
  if table_line != 'none'
    assign table_width = s.border_width | default: 1 | plus: 0
    assign table_percent = s.border_opacity | default: 100 | plus: 0
    if s.border_color == blank
      assign table_paint = 'color-mix(in srgb, currentColor ' | append: table_percent | append: '%, transparent)'
    else
      assign table_alpha = table_percent | divided_by: 100.0
      assign table_paint = s.border_color | color_modify: 'alpha', table_alpha
    endif
  endif

  assign label_text = s.accessible_label | default: 'Product comparison'
-%}

{%- capture alt_json -%}
  [{% for name in alternatives %}{% unless forloop.first %},{% endunless %}{{ name | strip | json }}{% endfor %}]
{%- endcapture -%}

{%- capture table_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --ct-label-col: {{ label_col }}fr;
  --ct-label-col-tablet: {{ label_col_tablet }}fr;
  --ct-label-col-mobile: {{ label_col_mobile }}fr;
  --ct-cols: {{ cols }};
  --ct-cols-tablet: {{ cols_tablet }};
  --ct-cols-mobile: {{ cols_mobile }};
  --ct-slots: {{ slots }};
  --ct-slots-tablet: {{ slots_tablet }};
  --ct-slots-mobile: {{ slots_mobile }};
  --ct-rows: {{ rows }};
  --ct-gap: {{ s.column_gap | default: 8 | plus: 0 }}px;
  --ct-gap-mobile: {{ s.column_gap_mobile | default: 6 | plus: 0 }}px;
  --ct-head: {{ s.head_height | default: 130 | plus: 0 }}px;
  --ct-head-mobile: {{ s.head_height_mobile | default: 88 | plus: 0 }}px;
  --ct-row-min: {{ s.row_height | default: 70 | plus: 0 }}px;
  --ct-row-min-mobile: {{ s.row_height_mobile | default: 56 | plus: 0 }}px;
  --ct-foot: {{ s.foot_height | default: 32 | plus: 0 }}px;
  --ct-foot-mobile: {{ s.foot_height_mobile | default: 20 | plus: 0 }}px;
  --ct-radius: {{ s.border_radius | default: 0 | plus: 0 }}px;
  --ct-border-width: {{ table_width }}px;
  {%- if table_width > 0 -%}
    --ct-border-style: {{ table_line }};
    --ct-border-color: {{ table_paint }};
  {%- endif -%}
  {%- if s.background != blank -%}
    --ct-background: {{ s.background }};
  {%- endif -%}

  {% content_for 'block', type: '_comparison-chooser', id: 'chooser' %}

  {% content_for 'block', type: '_comparison-marks', id: 'marks' %}
{%- endcapture -%}

<comparison-table
  class="{{ grid_classes }}"
  data-block-spacing
  data-rows="{{ rows }}"
  data-slots="{{ slots }}"
  data-slots-tablet="{{ slots_tablet }}"
  data-slots-mobile="{{ slots_mobile }}"
  data-comparison-alternatives="{{ alt_json | escape }}"
  role="group"
  aria-label="{{ label_text | escape }}"
  style="{{ table_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</comparison-table>

{% schema %}
{
  "name": "t:blocks.comparison_table.name",
  "tag": null,
  "blocks": [
    {
      "type": "_comparison-column"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.comparison_table.paragraphs.blocks"
    },
    {
      "type": "text",
      "id": "accessible_label",
      "label": "t:blocks.featured_pills_carousel.settings.label.label",
      "info": "t:blocks.featured_pills_carousel.settings.label.info",
      "default": "Product comparison"
    },
    {
      "type": "header",
      "content": "t:blocks.comparison_table.headers.rows"
    },
    {
      "type": "range",
      "id": "rows",
      "label": "t:blocks.comparison_table.settings.rows.label",
      "info": "t:blocks.comparison_table.settings.rows.info",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "size_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "head_height",
      "label": "t:blocks.comparison_table.settings.head_height.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 130,
      "visible_if": "{{ block.settings.size_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "t:blocks.comparison_table.settings.row_height.label",
      "info": "t:blocks.comparison_table.settings.row_height.info",
      "min": 32,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 70,
      "visible_if": "{{ block.settings.size_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "foot_height",
      "label": "t:blocks.comparison_table.settings.foot_height.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ block.settings.size_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "head_height_mobile",
      "label": "t:blocks.comparison_table.settings.head_height.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 88,
      "visible_if": "{{ block.settings.size_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "row_height_mobile",
      "label": "t:blocks.comparison_table.settings.row_height.label",
      "min": 32,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ block.settings.size_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "foot_height_mobile",
      "label": "t:blocks.comparison_table.settings.foot_height.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.size_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "range",
      "id": "slots",
      "label": "t:shared.columns.desktop.label",
      "info": "t:blocks.comparison_table.settings.slots.info",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "slots_tablet",
      "label": "t:shared.columns.tablet.label",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "slots_mobile",
      "label": "t:shared.columns.mobile.label",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "label_ratio",
      "label": "t:blocks.comparison_table.settings.label_ratio.label",
      "min": 80,
      "max": 160,
      "step": 1,
      "unit": "%",
      "default": 123,
      "visible_if": "{{ block.settings.size_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "label_ratio_mobile",
      "label": "t:blocks.comparison_table.settings.label_ratio.label",
      "min": 80,
      "max": 160,
      "step": 1,
      "unit": "%",
      "default": 118,
      "visible_if": "{{ block.settings.size_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:shared.gap.label",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 8,
