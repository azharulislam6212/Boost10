      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.size_device == 'mobile' }}"
    },
    {
      "type": "paragraph",
      "content": "t:blocks.comparison_table.paragraphs.marks"
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "t:shared.appearance.background_color.label"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
