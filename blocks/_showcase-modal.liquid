{% doc %}
  The video overlay the showcase opens. Static, so the overlay's settings sit
  beside the section instead of lengthening its own list.
{% enddoc %}

{%- assign modal_id = 'showcase-video-' | append: section.id -%}

{% render 'showcase-video-modal', id: modal_id, settings: block.settings %}

{% schema %}
{
  "name": "t:blocks.showcase_modal.name",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "modal_width",
      "label": "t:sections.testimonials_showcase.settings.modal_width.label",
      "min": 480,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 880
    },
    {
      "type": "select",
      "id": "modal_ratio",
      "label": "t:sections.testimonials_showcase.settings.modal_ratio.label",
      "info": "t:sections.testimonials_showcase.settings.modal_ratio.info",
      "options": [
        {
          "value": "16-9",
          "label": "t:shared.image_ratio.options__7.label"
        },
        {
          "value": "4-3",
          "label": "t:shared.image_ratio.options__6.label"
        },
        {
          "value": "1-1",
          "label": "t:shared.image_ratio.options__5.label"
        },
        {
          "value": "4-5",
          "label": "t:shared.image_ratio.options__4.label"
        },
        {
          "value": "9-16",
          "label": "t:shared.image_ratio.options__1.label"
        }
      ],
      "default": "16-9"
    },
    {
      "type": "range",
      "id": "modal_radius",
      "label": "t:sections.testimonials_showcase.settings.modal_radius.label",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "modal_ring_width",
      "label": "t:sections.testimonials_showcase.settings.modal_ring_width.label",
      "info": "t:sections.testimonials_showcase.settings.modal_ring_width.info",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "modal_ring_color",
      "label": "t:sections.testimonials_showcase.settings.modal_ring_color.label",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.modal_ring_width > 0 }}"
    },
    {
      "type": "range",
      "id": "modal_ring_opacity",
      "label": "t:shared.border.opacity.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 28,
      "visible_if": "{{ block.settings.modal_ring_width > 0 }}"
    },
    {
      "type": "color",
      "id": "modal_backdrop_color",
      "label": "t:sections.testimonials_showcase.settings.modal_backdrop_color.label",
      "default": "rgba(15, 46, 47, 0.55)"
    },
    {
      "type": "range",
      "id": "modal_backdrop_blur",
      "label": "t:sections.testimonials_showcase.settings.modal_backdrop_blur.label",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "modal_animation",
      "label": "t:sections.testimonials_showcase.settings.modal_animation.label",
      "options": [
        {
          "value": "fade",
          "label": "t:shared.animation.animation_text.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_text.options__4.label"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.testimonials_showcase.settings.modal_animation.options__3.label"
        },
        {
          "value": "zoom-out",
          "label": "t:sections.testimonials_showcase.settings.modal_animation.options__4.label"
        },
        {
          "value": "rise",
          "label": "t:sections.testimonials_showcase.settings.modal_animation.options__5.label"
        }
      ],
      "default": "zoom-out"
    },
    {
      "type": "range",
      "id": "modal_animation_duration",
      "label": "t:shared.animation.animation_duration.label",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "ms",
      "default": 360
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "t:sections.testimonials_showcase.settings.badge_size.label",
      "info": "t:sections.testimonials_showcase.settings.badge_size.info",
      "min": 60,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "t:sections.testimonials_showcase.settings.badge_background.label",
      "default": "#03D26F"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "t:sections.testimonials_showcase.settings.badge_text_color.label",
      "default": "#0F2E2F"
    },
    {
      "type": "range",
      "id": "badge_spin",
      "label": "t:sections.testimonials_showcase.settings.badge_spin.label",
      "info": "t:sections.testimonials_showcase.settings.badge_spin.info",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "s",
      "default": 12
    }
  ]
}
{% endschema %}
