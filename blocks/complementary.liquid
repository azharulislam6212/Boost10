{% comment %}
  blocks/complementary.liquid

  Cross-sells on the product page, from Shopify's Search & Discovery app.

  `intent: complementary` returns what the merchant curated in that app, not what
  an algorithm guessed. That difference matters: "related" gives you four more
  t-shirts on a t-shirt page, while "complementary" gives you the thing the
  merchant knows people buy alongside it.

  Deferred. Nothing is fetched until the block is near the viewport, because a
  cross-sell below the fold should not compete with the product image above it
  for the connection.

  Renders nothing when the app returns nothing — an empty "You might also like"
  heading is worse than no heading, and a store that has not set up curated
  recommendations should simply not see this block.
{% endcomment %}

{%- liquid
  assign product = closest.product
  assign count = block.settings.products_to_show | default: 4
-%}

{%- if product -%}
  <complementary-products
    class="complementary"
    data-product-id="{{ product.id }}"
    data-section-id="{{ section.id }}"
    data-limit="{{ count }}"
    data-intent="complementary"
    {% render 'spacing', block: block.settings %}
    {{ block.shopify_attributes }}
    hidden
  >
    <h2 class="complementary__title" data-recommendations-heading hidden>
      {{ block.settings.heading | default: 'products.recommendations.complementary' | t }}
    </h2>

    <div
      class="complementary__list"
      data-ref="content"
      data-recommendations-content
      data-layout="{{ block.settings.layout }}"
    ></div>
  </complementary-products>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.complementary.name",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "t:blocks.complementary.paragraph" },
    { "type": "text", "id": "heading", "label": "t:shared.heading.label" },
    { "type": "range", "id": "products_to_show", "label": "t:sections.featured_collection.settings.products_to_show.label", "min": 1, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select", "id": "layout", "label": "t:blocks.complementary.settings.layout.label",
      "options": [
        { "value": "list", "label": "t:blocks.complementary.settings.layout.options__1.label" },
        { "value": "grid", "label": "t:blocks.complementary.settings.layout.options__2.label" }
      ],
      "default": "list"
    },
    { "type": "header", "content": "t:shared.spacing.block_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.complementary.name" }]
}
{% endschema %}
