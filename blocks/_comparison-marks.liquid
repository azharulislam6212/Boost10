{% doc %}
  The tick and cross a comparison row draws, written as the custom properties
  the table folds into its own style attribute.
{% enddoc %}

{%- liquid
  assign s = block.settings
-%}
--ct-mark-yes-size: {{ s.mark_yes_size | default: 24 | plus: 0 }}px;
--ct-mark-yes-size-mobile: {{ s.mark_yes_size_mobile | default: 20 | plus: 0 }}px;
--ct-mark-yes-icon-size: {{ s.mark_yes_icon_size | default: 12 | plus: 0 }}px;
--ct-mark-yes-fill: {% if s.mark_yes_fill != blank %}{{ s.mark_yes_fill }}{% else %}none{% endif %};
--ct-mark-yes-ring-width: {{ s.mark_yes_ring_width | default: 0 | plus: 0 }}px;
--ct-mark-yes-ring-color: {{ s.mark_yes_ring_color | default: 'transparent' }};
--ct-mark-yes-color: {{ s.mark_yes_color | default: '#161514' }};
--ct-mark-no-size: {{ s.mark_no_size | default: 20 | plus: 0 }}px;
--ct-mark-no-size-mobile: {{ s.mark_no_size_mobile | default: 18 | plus: 0 }}px;
--ct-mark-no-icon-size: {{ s.mark_no_icon_size | default: 9 | plus: 0 }}px;
--ct-mark-no-fill: {% if s.mark_no_fill != blank %}{{ s.mark_no_fill }}{% else %}none{% endif %};
--ct-mark-no-ring-width: {{ s.mark_no_ring_width | default: 1 | plus: 0 }}px;
--ct-mark-no-ring-color: {{ s.mark_no_ring_color | default: '#03D26F' }};
--ct-mark-no-color: {{ s.mark_no_color | default: '#161514' }};

{% schema %}
{
  "name": "t:blocks.comparison_marks.name",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.comparison_table.headers.mark_yes"
    },
    {
      "type": "range",
      "id": "mark_yes_size",
      "label": "t:blocks.feature_icon.settings.shape_size.label",
      "min": 12,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mark_yes_size_mobile",
      "label": "t:blocks.feature_icon.settings.shape_size_mobile.label",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mark_yes_icon_size",
      "label": "t:shared.icon_size.custom.label",
      "min": 6,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_background",
      "id": "mark_yes_fill",
      "label": "t:blocks.feature_icon.settings.fill_color.label",
      "default": "linear-gradient(rgba(3, 210, 111, 1), rgba(3, 210, 111, 1))"
    },
    {
      "type": "range",
      "id": "mark_yes_ring_width",
      "label": "t:shared.border.thickness.label",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "mark_yes_ring_color",
      "label": "t:shared.border.color.label",
      "visible_if": "{{ block.settings.mark_yes_ring_width > 0 }}"
    },
    {
      "type": "color",
      "id": "mark_yes_color",
      "label": "t:blocks.feature_icon.settings.icon_color.label",
      "default": "#161514"
    },
    {
      "type": "header",
      "content": "t:blocks.comparison_table.headers.mark_no"
    },
    {
      "type": "range",
      "id": "mark_no_size",
      "label": "t:blocks.feature_icon.settings.shape_size.label",
      "min": 12,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mark_no_size_mobile",
      "label": "t:blocks.feature_icon.settings.shape_size_mobile.label",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "mark_no_icon_size",
      "label": "t:shared.icon_size.custom.label",
      "min": 6,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "type": "color_background",
      "id": "mark_no_fill",
      "label": "t:blocks.feature_icon.settings.fill_color.label"
    },
    {
      "type": "range",
      "id": "mark_no_ring_width",
      "label": "t:shared.border.thickness.label",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "mark_no_ring_color",
      "label": "t:shared.border.color.label",
      "default": "#03D26F",
      "visible_if": "{{ block.settings.mark_no_ring_width > 0 }}"
    },
    {
      "type": "color",
      "id": "mark_no_color",
      "label": "t:blocks.feature_icon.settings.icon_color.label",
      "default": "#161514"
    }
  ]
}
{% endschema %}
