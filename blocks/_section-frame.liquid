{% doc %}
  The border and corners of a section, written as custom properties that the
  section folds into its own style attribute. Static, so the frame settings sit
  beside the section instead of lengthening its own list.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign border_line = s.border_style | default: 'none'

  assign bw_top = 0
  assign bw_right = 0
  assign bw_bottom = 0
  assign bw_left = 0
  assign border_paint = 'transparent'

  if border_line != 'none'
    assign bw_top = s.border_width_top | default: 0 | plus: 0
    assign bw_right = s.border_width_right | default: 0 | plus: 0
    assign bw_bottom = s.border_width_bottom | default: 0 | plus: 0
    assign bw_left = s.border_width_left | default: 0 | plus: 0

    assign border_percent = s.border_opacity | default: 100 | plus: 0
    if s.border_color == blank
      assign border_paint = 'color-mix(in srgb, currentColor ' | append: border_percent | append: '%, transparent)'
    else
      assign border_alpha = border_percent | divided_by: 100.0
      assign border_paint = s.border_color | color_modify: 'alpha', border_alpha
    endif
  endif

  assign r_tl = s.border_radius_top_left | default: 0 | plus: 0
  assign r_tr = s.border_radius_top_right | default: 0 | plus: 0
  assign r_bl = s.border_radius_bottom_left | default: 0 | plus: 0
  assign r_br = s.border_radius_bottom_right | default: 0 | plus: 0

  assign r_tl_m = s.border_radius_top_left_mobile | default: r_tl | plus: 0
  assign r_tr_m = s.border_radius_top_right_mobile | default: r_tr | plus: 0
  assign r_bl_m = s.border_radius_bottom_left_mobile | default: r_bl | plus: 0
  assign r_br_m = s.border_radius_bottom_right_mobile | default: r_br | plus: 0
-%}
--section-frame-radius: {{ r_tl }}px {{ r_tr }}px {{ r_br }}px {{ r_bl }}px;
--section-frame-radius-mobile: {{ r_tl_m }}px {{ r_tr_m }}px {{ r_br_m }}px {{ r_bl_m }}px;
--section-frame-border-width: {{ bw_top }}px {{ bw_right }}px {{ bw_bottom }}px {{ bw_left }}px;
--section-frame-border-style: {{ border_line }};
--section-frame-border-color: {{ border_paint }};

{% schema %}
{
  "name": "t:blocks.section_frame.name",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.group.headers.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.options.dashed"
        }
      ],
      "default": "dashed"
    },
    {
      "type": "range",
      "id": "border_width_top",
      "label": "t:shared.border.sides.top.label",
      "info": "t:shared.border.sides.info",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_width_right",
      "label": "t:shared.border.sides.right.label",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_width_bottom",
      "label": "t:shared.border.sides.bottom.label",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_width_left",
      "label": "t:shared.border.sides.left.label",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "t:shared.border.opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.group.settings.border_color.label",
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:shared.corners.header"
    },
    {
      "type": "select",
      "id": "device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "border_radius_top_left",
      "label": "t:shared.corners.top_left.label",
      "info": "t:shared.corners.paragraph",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "border_radius_top_right",
      "label": "t:shared.corners.top_right.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "border_radius_bottom_left",
      "label": "t:shared.corners.bottom_left.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "border_radius_bottom_right",
      "label": "t:shared.corners.bottom_right.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "border_radius_top_left_mobile",
      "label": "t:shared.corners.top_left.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "border_radius_top_right_mobile",
      "label": "t:shared.corners.top_right.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "border_radius_bottom_left_mobile",
      "label": "t:shared.corners.bottom_left.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "border_radius_bottom_right_mobile",
      "label": "t:shared.corners.bottom_right.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    }
  ]
}
{% endschema %}
