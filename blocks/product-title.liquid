{% comment %}
  blocks/_product-title.liquid — private.

  An `<h1>` on the product page, because the product is the page. The vendor sits
  above it as plain text rather than as a heading: it is a label, not a section of
  the document.
{% endcomment %}

{%- liquid
  assign product = closest.product
-%}

{%- if product -%}
  <div class="product-title" {{ block.shopify_attributes }}>
    {%- if block.settings.show_vendor and product.vendor != blank -%}
      <p class="product-title__vendor">
        <span class="visually-hidden">{{ 'products.product.vendor' | t }}:</span>
        {{ product.vendor }}
      </p>
    {%- endif -%}

    <motion-effect {% render 'motion-attrs', kind: 'text', block: block.settings %}>
      <h1 class="product-title__text">{{ product.title }}</h1>
    </motion-effect>

  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_title.name",
  "tag": null,
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "t:settings_schema.product_cards.settings.show_vendor.label", "default": false },
    { "type": "header", "content": "t:shared.animation.header" },
    {
      "type": "select", "id": "animation_text", "label": "t:shared.animation.animation_text.label",
      "options": [
        { "value": "inherit", "label": "t:shared.animation.animation_text.options__1.label" },
        { "value": "none", "label": "t:shared.animation.animation_text.options__2.label" },
        { "value": "fade-up", "label": "t:shared.animation.animation_text.options__4.label" },
        { "value": "words-slide-up", "label": "t:shared.animation.animation_text.options__9.label" }
      ],
      "default": "inherit"
    }
  ]
}
{% endschema %}
