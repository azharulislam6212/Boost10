{% doc %}
  blocks/_feature-text.liquid — private to `blocks/_feature-card.liquid`.

  The sentence under the icon.

  ## Same typography, same place

  Like `_feature-title`, this is `.block-text` plus a preset class, with the
  colour and any Custom-preset overrides from
  `snippets/block-typography.liquid`. There is no type map in this file, so
  Theme settings › Typography still decides what Paragraph looks like here.

  ## `richtext`, not `inline_richtext`

  A title is one line and gains nothing from paragraphs. This is prose — a
  merchant writing two sentences wants them to break, and a list is a
  legitimate thing to put in a feature card. `.rte` on the root is what makes
  the theme's own list and link styling apply to what they write.

  ## Clamping is the setting that keeps a row level

  Four cards whose sentences are 12, 18, 14 and 30 words long are four cards of
  different heights, and the icons stop lining up across the row. The clamp is
  the answer to that, so unlike the title's it defaults to on — three lines,
  which is a sentence and a half at a card's width.

  It is a range rather than a checkbox because "how many lines" is the actual
  question, and 0 is the off position.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign preset = s.preset | default: 'paragraph'
  assign clamp = s.max_lines | default: 0 | plus: 0
  assign color_mode = s.color | default: 'muted'

  assign classes = 'feature-text-block block-text rte block-text--' | append: preset

  comment
    `--colored` only once a colour has been picked, and never alongside
    `--gradient` — the two rules paint the same runs of text and the gradient
    needs `color: transparent` to survive. Same condition as
    `blocks/text.liquid`, which is where the pair is documented.
  endcomment
  if color_mode == 'gradient'
    assign classes = classes | append: ' block-text--gradient'
  elsif color_mode != 'inherit' and color_mode != blank
    assign classes = classes | append: ' block-text--colored'
  endif

  if clamp > 0
    assign classes = classes | append: ' feature-text-block--clamped'
  endif
-%}

{%- capture text_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  {%- render 'block-typography', block: s -%}
  {%- if clamp > 0 -%}--feature-text-lines: {{ clamp }};{%- endif -%}
{%- endcapture -%}

{%- if s.text != blank -%}
  <div
    class="{{ classes }}"
    data-block-spacing
    style="{{ text_style | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    {{ s.text }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.feature_text.name",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:shared.text.label",
      "default": "<p>Say what this feature does for the customer, in a sentence they can read at a glance.</p>"
    },
    {
      "type": "range",
      "id": "max_lines",
      "label": "t:blocks.article_title.settings.max_lines.label",
      "info": "t:blocks.feature_text.settings.max_lines.info",
      "min": 0,
      "max": 8,
      "step": 1,
      "default": 3
    },

    { "type": "header", "content": "t:shared.typography.header" },
    {
      "type": "select",
      "id": "preset",
      "label": "t:shared.typography.preset.label",
      "info": "t:shared.typography.preset.info",
      "options": [
        { "value": "paragraph", "label": "t:shared.typography.preset.options__2.label" },
        { "value": "subheading", "label": "t:shared.typography.preset.options__3.label" },
        { "value": "h6", "label": "t:shared.typography.preset.options__9.label" }
      ],
      "default": "paragraph"
    },
    {
      "type": "select",
      "id": "color",
      "label": "t:shared.typography.color.label",
      "info": "t:shared.typography.color.info",
      "options": [
        { "value": "inherit", "label": "t:shared.typography.color.options__1.label" },
        { "value": "muted", "label": "t:shared.typography.color.options__2.label" },
        { "value": "custom", "label": "t:shared.typography.color.options__3.label" },
        { "value": "gradient", "label": "t:shared.typography.color.options__4.label" }
      ],
      "default": "muted"
    },
    {
      "type": "color",
      "id": "text_color_custom",
      "label": "t:shared.typography.text_color.label",
      "info": "t:shared.typography.text_color.info",
      "visible_if": "{{ block.settings.color == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "text_gradient",
      "label": "t:shared.typography.text_gradient.label",
      "info": "t:shared.typography.text_gradient.info",
      "visible_if": "{{ block.settings.color == 'gradient' }}"
    },

    { "type": "header", "content": "t:shared.spacing.block_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.feature_text.name"
    }
  ]
}
{% endschema %}
