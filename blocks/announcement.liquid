{% comment %}
  blocks/announcement.liquid

  One announcement.

  A link renders as an `<a>` and plain text as a `<p>`. Wrapping text in an anchor
  with no href, so the markup is uniform, produces a focusable element that goes
  nowhere — which is worse than two branches.
{% endcomment %}

{%- if block.settings.text != blank -%}

 
  <div class="announcement carousel-shell__item" {{ block.shopify_attributes }}>
    {%- if block.settings.icon != 'none' -%}
      {% render 'icon', icon: block.settings.icon, size: 14, class: 'announcement__icon' %}
    {%- endif -%}

    {%- if block.settings.link != blank -%}
      <a class="announcement__text" href="{{ block.settings.link }}">{{ block.settings.text }}</a>
    {%- else -%}
      <p class="announcement__text">{{ block.settings.text }}</p>
    {%- endif -%}
 

    </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.announcement.name",
  "tag": null,
  "settings": [
    { "type": "inline_richtext", "id": "text", "label": "t:shared.text.label", "default": "Free shipping on orders over £50" },
    { "type": "url", "id": "link", "label": "t:shared.link.label" },
    {
      "type": "select", "id": "icon", "label": "t:blocks.icon_with_text.settings.icon.label",
      "options": [
        { "value": "none", "label": "t:shared.animation.animation_text.options__2.label" },
        { "value": "truck", "label": "t:blocks.icon_with_text.settings.icon.options__1.label" },
        { "value": "refresh", "label": "t:blocks.icon_with_text.settings.icon.options__2.label" },
        { "value": "star", "label": "t:blocks.icon_with_text.settings.icon.options__5.label" },
        { "value": "lock", "label": "t:blocks.icon_with_text.settings.icon.options__3.label" }
      ],
      "default": "none"
    }
  ],
  "presets": [{ "name": "t:blocks.announcement.name" }]
}
{% endschema %}
