{% doc %}
  The badge's own surface — its wash, blur, border width, corners and text
  alignment — written as the custom properties the badge folds into its style.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign paint = ''
  if s.background != blank
    assign alpha = s.background_opacity | default: 100 | plus: 0
    assign alpha = alpha | divided_by: 100.0
    assign paint = s.background | color_modify: 'alpha', alpha
  endif

  assign blur = s.backdrop_blur | default: 0 | plus: 0
-%}
{%- if paint != '' -%}--badge-background: {{ paint }};{%- endif -%}
{%- if s.text_alignment != blank and s.text_alignment != 'inherit' -%}
  --badge-text-align: {{ s.text_alignment }};
{%- endif -%}
--badge-border-width: {{ s.border_width }}px;
--badge-radius: {{ s.radius }}px;
{%- if blur > 0 -%}--badge-backdrop-blur: {{ blur }}px;{%- endif -%}

{% schema %}
{
  "name": "t:blocks.badge_surface.name",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.badge_highlight.headers.style"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:blocks.badge_highlight.settings.background.label"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "label": "t:blocks.card_content.settings.background_opacity.label",
      "info": "t:blocks.badge_highlight.settings.background_opacity.info",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "backdrop_blur",
      "label": "t:blocks.card_content.settings.backdrop_blur.label",
      "info": "t:blocks.card_content.settings.backdrop_blur.info",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:blocks.badge_highlight.settings.border_width.label",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:blocks.badge_highlight.settings.radius.label",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:blocks.badge_highlight.settings.text_alignment.label",
      "info": "t:blocks.badge_highlight.settings.text_alignment.info",
      "options": [
        {
          "value": "inherit",
          "label": "t:settings_schema.typography.options.case_default"
        },
        {
          "value": "start",
          "label": "t:shared.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:shared.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:shared.alignment.options__3.label"
        }
      ],
      "default": "inherit"
    }
  ]
}
{% endschema %}
