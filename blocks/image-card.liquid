{% doc %}
  A picture with blocks on it — the panel beside the FAQ in the *FAQ: Banner*
  preset, where a photograph carries a heading, a line of text and a button.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign content_over = false
  if s.background_media == 'image'
    assign content_over = true
  endif

  assign ratio = s.ratio | default: 'aspect-ratio'

  capture ratio_value
    render 'aspect-ratio', ratio: ratio, image: s.image
  endcapture

  assign classes = 'image-card'
  if content_over
    assign classes = classes | append: ' image-card--over'
  else
    assign classes = classes | append: ' image-card--below'
  endif
-%}

{%- capture card_style -%}
  {%- if content_over and s.height != 'fill' -%}
    --image-card-ratio: {{ ratio_value | strip }};
  {%- endif -%}
  {%- if s.label_color != blank -%}
    --image-card-label-color: {{ s.label_color }};
  {%- endif -%}
{%- endcapture -%}

{%- capture card_attributes -%}
  {% render 'motion-attrs', kind: 'image', block: s %}
{%- endcapture -%}

{%- capture children -%}

  {%- if content_over == false -%}
    {% render 'image',
       image: s.image,
       mobile_image: s.image_mobile,
       alt: s.alt,
       ratio: ratio,
       mobile_ratio: s.ratio_mobile,
       sizes: '(min-width: 990px) 40vw, 100vw',
       priority: s.priority,
       preload: s.priority,
       wrapper_class: 'image-card__media' %}
  {%- endif -%}

  {%- if s.label_text != blank -%}
    <span class="image-card__label{% unless s.label_in_content %} image-card__label--pinned{% endunless %}">
      {{- s.label_text | escape -}}
    </span>
  {%- endif -%}

  {% content_for 'blocks' %}
{%- endcapture -%}

{% render 'group',
   children: children,
   settings: s,
   extra_classes: classes,
   tag: 'motion-effect',
   attributes: card_attributes,
   styles: card_style,
   priority: s.priority,
   placeholder: 'hero-apparel-1',
   shopify_attributes: block.shopify_attributes %}

