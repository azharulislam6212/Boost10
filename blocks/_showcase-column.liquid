    },
    {
      "type": "range",
      "id": "height",
      "label": "t:blocks.showcase_column.settings.height.label",
      "info": "t:blocks.showcase_column.settings.height.info",
      "min": 0,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 940
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:blocks.showcase_column.settings.width.label",
      "info": "t:blocks.showcase_column.settings.width.info",
      "min": 0,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_width_mobile",
