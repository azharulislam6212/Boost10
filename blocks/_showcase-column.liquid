{% doc %}
  blocks/_showcase-column.liquid — private to `sections/testimonials-showcase.liquid`.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign direction = s.direction | default: 'up'
  assign direction_mobile = s.direction_mobile | default: 'left'

  assign speed = s.speed | default: 40 | plus: 0

  assign offset = s.offset | default: 0 | plus: 0
-%}

{%- capture lane_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --sv-card-radius: {{ s.card_radius | default: 20 | plus: 0 }}px;
  {%- if s.card_border_color != blank -%}
    --sv-card-border-start: {{ s.card_border_color }};
  {%- endif -%}
  {%- if s.card_border_color_end != blank -%}
    --sv-card-border-end: {{ s.card_border_color_end }};
  {%- endif -%}
  --sv-card-glow-color: {{ s.card_glow_color | default: 'transparent' }};
  {%- if s.card_scrim_color != blank -%}
    --sv-scrim: {{ s.card_scrim_color }};
  {%- endif -%}
  {%- if s.card_text_color != blank -%}
    --sv-card-text: {{ s.card_text_color }};
  {%- endif -%}
  {%- if s.card_star_color != blank -%}
    --sv-star-color: {{ s.card_star_color }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="showcase-lane"
  data-showcase-lane
  data-block-spacing
  data-direction-desktop="{{ direction }}"
  data-direction-mobile="{{ direction_mobile }}"
  data-speed="{{ speed }}"
  data-offset="{{ offset }}"
  style="{{ lane_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>

  <div class="showcase-lane__track" data-showcase-track>
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.showcase_column.name",
  "tag": null,
  "blocks": [
    {
      "type": "_showcase-video"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.showcase_column.settings.direction.label",
      "options": [
        {
          "value": "up",
          "label": "t:blocks.showcase_column.settings.direction.options__1.label"
        },
        {
          "value": "down",
          "label": "t:blocks.showcase_column.settings.direction.options__2.label"
        }
      ],
      "default": "up"
    },
    {
      "type": "select",
      "id": "direction_mobile",
      "label": "t:blocks.showcase_column.settings.direction_mobile.label",
      "options": [
        {
          "value": "left",
          "label": "t:blocks.showcase_column.settings.direction_mobile.options__1.label"
        },
        {
          "value": "right",
          "label": "t:blocks.showcase_column.settings.direction_mobile.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:blocks.showcase_column.settings.speed.label",
      "min": 5,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "offset",
      "label": "t:blocks.showcase_column.settings.offset.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:shared.corner_radius.label",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "t:blocks.group.settings.border_color.label",
      "default": "#03D26F"
    },
    {
      "type": "color",
      "id": "card_border_color_end",
      "label": "t:blocks.showcase_video.settings.border_color_end.label",
      "default": "#0F2E2F"
    },
    {
      "type": "color",
      "id": "card_glow_color",
      "label": "t:blocks.showcase_video.settings.glow_color.label",
      "default": "rgba(3, 210, 111, 0.25)"
    },
    {
      "type": "color",
      "id": "card_scrim_color",
      "label": "t:blocks.showcase_video.settings.scrim_color.label",
      "default": "rgba(15, 46, 47, 0.9)"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "t:blocks.showcase_video.settings.text_color.label",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_star_color",
      "label": "t:blocks.showcase_video.settings.star_color.label",
      "default": "#F9F871"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
