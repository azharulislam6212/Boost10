{% doc %}
  blocks/_showcase-column.liquid — private to `sections/testimonials-showcase.liquid`.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign direction = s.direction | default: 'up'
  assign direction_mobile = s.direction_mobile | default: 'left'

  assign speed = s.speed | default: 40 | plus: 0
  assign speed_mobile = s.speed_mobile | plus: 0
  if s.speed_mobile == nil
    assign speed_mobile = 30
  endif

  assign offset = s.offset | default: 0 | plus: 0
-%}

{%- capture lane_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
{%- endcapture -%}

<div
  class="showcase-lane"
  data-showcase-lane
  data-block-spacing
  data-direction-desktop="{{ direction }}"
  data-direction-mobile="{{ direction_mobile }}"
  data-speed="{{ speed }}"
  data-speed-mobile="{{ speed_mobile }}"
  data-offset="{{ offset }}"
  style="{{ lane_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>

  <div class="showcase-lane__track" data-showcase-track>
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.showcase_column.name",
  "tag": null,
  "blocks": [
    {
      "type": "_showcase-video"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.showcase_column.paragraph"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.showcase_column.settings.direction.label",
      "info": "t:blocks.showcase_column.settings.direction.info",
      "options": [
        {
          "value": "up",
          "label": "t:blocks.showcase_column.settings.direction.options__1.label"
        },
        {
          "value": "down",
          "label": "t:blocks.showcase_column.settings.direction.options__2.label"
        }
      ],
      "default": "up"
    },
    {
      "type": "select",
      "id": "direction_mobile",
      "label": "t:blocks.showcase_column.settings.direction_mobile.label",
      "info": "t:blocks.showcase_column.settings.direction_mobile.info",
      "options": [
        {
          "value": "left",
          "label": "t:blocks.showcase_column.settings.direction_mobile.options__1.label"
        },
        {
          "value": "right",
          "label": "t:blocks.showcase_column.settings.direction_mobile.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:blocks.showcase_column.settings.speed.label",
      "info": "t:blocks.showcase_column.settings.speed.info",
      "min": 5,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "speed_mobile",
      "label": "t:blocks.showcase_column.settings.speed_mobile.label",
      "min": 5,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "offset",
      "label": "t:blocks.showcase_column.settings.offset.label",
      "info": "t:blocks.showcase_column.settings.offset.info",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
