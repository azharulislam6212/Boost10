      "label": "t:blocks.showcase_column.settings.direction_mobile.label",
      "info": "t:blocks.showcase_column.settings.direction_mobile.info",
      "options": [
        {
          "value": "left",
          "label": "t:blocks.showcase_column.settings.direction_mobile.options__1.label"
        },
        {
          "value": "right",
          "label": "t:blocks.showcase_column.settings.direction_mobile.options__2.label"
