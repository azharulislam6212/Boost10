      "unit": "%",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:blocks.showcase_column.settings.hide_mobile.label",
      "info": "t:blocks.showcase_column.settings.hide_mobile.info",
