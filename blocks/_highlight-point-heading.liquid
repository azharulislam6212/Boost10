        },
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        }
      ],
      "default": "inherit",
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:shared.typography.font_size.label",
      "options": [
        {
          "value": "12",
          "label": "12px"
        },
        {
          "value": "14",
          "label": "14px"
        },
        {
          "value": "16",
          "label": "16px"
        },
        {
          "value": "18",
          "label": "18px"
        },
        {
