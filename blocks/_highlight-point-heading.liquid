          "value": "paragraph",
          "label": "t:shared.typography.preset.options__2.label"
        },
        {
          "value": "subheading",
          "label": "t:shared.typography.preset.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:shared.typography.preset.options__7.label"
        },
        {
          "value": "h5",
          "label": "t:shared.typography.preset.options__8.label"
        },
        {
          "value": "h6",
          "label": "t:shared.typography.preset.options__9.label"
        },
        {
          "value": "custom",
          "label": "t:shared.typography.preset.options__10.label"
        }
      ],
      "default": "h6"
    },
    {
      "type": "select",
      "id": "font_family",
