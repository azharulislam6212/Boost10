{% doc %}
  blocks/_highlight-point-heading.liquid — private, static in blocks/_highlight-point.liquid.
  The point's name, with its own typography.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign preset = s.preset
  assign title_classes = 'highlight-point__title block-text--' | append: preset
  if s.color == 'gradient'
    assign title_classes = title_classes | append: ' block-text--gradient'
  endif
-%}

{%- capture title_style -%}
  {%- render 'block-typography', block: s -%}
{%- endcapture -%}

{%- if s.title != blank -%}
  <span
    class="{{ title_classes }}"
    style="{{ title_style | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    {{- s.title | escape -}}
  </span>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.menu_heading.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:shared.heading.label",
