{% doc %}
  blocks/mega-menu.liquid — Boost10
{% enddoc %}

{%- liquid
  assign st = block.settings
  assign label = st.menu_item | strip

  capture panel_blocks
    content_for 'blocks'
  endcapture

  assign has_blocks = true
  assign fallback_links = blank
  if panel_blocks == blank
    assign has_blocks = false
    assign label_key = label | downcase
    for item in section.settings.menu.links
      assign item_key = item.title | strip | downcase
      if item_key == label_key
        assign fallback_links = item.links
        break
      endif
    endfor
  endif

  assign fallback_columns = 1
  if fallback_links != blank
    assign nested_count = 0
    for child in fallback_links
      if child.links.size > 0
        assign nested_count = nested_count | plus: 1
      endif
    endfor

    if nested_count > 0
      assign fallback_columns = fallback_links.size
    else
      assign fallback_columns = fallback_links.size | plus: 5 | divided_by: 6
    endif

    if fallback_columns > 4
      assign fallback_columns = 4
    endif
  endif
-%}

<div
  class="nav__panel nav__panel--mega nav__panel--{{ st.width }}"
  data-nav-panel
  data-mega-panel
  data-menu-item="{{ label | escape }}"
  {% if st.show_on_mobile %}data-mobile="true"{% endif %}
  data-align="{{ st.align }}"
  {{ block.shopify_attributes }}
>
  <div
    class="nav__panel-inner megamenu color-{{ st.color_scheme }}"
    style="
      --mega-columns: {{ st.columns }};
      --mega-radius: {{ st.corner_radius }}px;
      --mega-padding: {{ st.padding }}px;
      --mega-gap: {{ st.gap }}px;
      {%- if st.max_width > 0 %}--mega-max-width: {{ st.max_width }}px;{% endif -%}
    "
  >
    <div class="megamenu__grid">
      {%- if has_blocks -%}
        {{ panel_blocks }}
      {%- elsif fallback_links.size > 0 -%}
        <div class="megamenu__item megamenu__item--links" style="--span: {{ st.columns }};">
          {% render 'megamenu-columns', links: fallback_links, columns: fallback_columns %}
        </div>
      {%- elsif request.design_mode -%}
        <p class="megamenu__item megamenu__empty" style="--span: {{ st.columns }};">{{ 'blocks.mega_menu.empty_panel' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.mega_menu.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "menu_item",
      "label": "t:blocks.mega_menu.settings.menu_item.label",
      "info": "t:blocks.mega_menu.settings.menu_item.info"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.mega_menu.settings.width.label",
      "options": [
        {
          "value": "full",
          "label": "t:blocks.mega_menu.settings.width.options__1.label"
        },
        {
          "value": "page",
          "label": "t:blocks.mega_menu.settings.width.options__2.label"
        },
        {
          "value": "compact",
          "label": "t:blocks.mega_menu.settings.width.options__3.label"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:blocks.mega_menu.settings.align.label",
      "info": "t:blocks.mega_menu.settings.align.info",
      "options": [
        {
          "value": "start",
          "label": "t:shared.position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:shared.position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:shared.position.options__3.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:blocks.mega_menu.settings.max_width.label",
      "info": "t:blocks.mega_menu.settings.max_width.info",
      "min": 0,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.columns.header"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:shared.columns.desktop.label",
      "info": "t:blocks.mega_menu.settings.columns.info",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:blocks.mega_menu.settings.gap.label",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:blocks.mega_menu.settings.padding.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:shared.corner_radius.label",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "t:blocks.mega_menu.settings.show_on_mobile.label",
      "info": "t:blocks.mega_menu.settings.show_on_mobile.info",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu-links"
    },
    {
      "type": "menu-card"
    },
    {
      "type": "menu-promo"
    },
    {
      "type": "menu-tabs"
    },
    {
      "type": "menu-heading"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.mega_menu.name"
    }
  ]
}
{% endschema %}
