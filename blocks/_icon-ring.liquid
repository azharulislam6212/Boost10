{% doc %}
  blocks/_health-goal.liquid — private, one box of `health-goals`.
  A dashed ring around a soft disc and its icon, a dashed arrow curling down
  from the ring to the label. On hover the disc turns green, the ring turns and
  an arrow badge pops in. The whole box is the link.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign has_link = false
  if s.link != blank
    assign has_link = true
  endif

  assign tag = 'div'
  if has_link
    assign tag = 'a'
  endif
-%}

<{{ tag }}
  class="health-goal{% if has_link %} health-goal--link{% endif %}"
  {% if has_link %}href="{{ s.link }}"{% if s.new_tab %} target="_blank" rel="noopener"{% endif %}{% endif %}
  {{ block.shopify_attributes }}
>
  {%- if has_link and s.new_tab -%}<span class="visually-hidden">{{ 'accessibility.new_window' | t }}</span>{%- endif -%}
  <span class="health-goal__mark" aria-hidden="true">
    <svg class="health-goal__ring" viewBox="0 0 96 96" fill="none" focusable="false">
      <circle cx="48" cy="48" r="47.5" />
    </svg>

    <span class="health-goal__disc">
      {%- if s.icon_image != blank -%}
        <img
          class="health-goal__image"
          src="{{ s.icon_image | image_url: width: 96 }}"
          alt=""
          width="32"
          height="32"
          loading="lazy"
        >
      {%- elsif s.icon != blank and s.icon != 'none' -%}
        {% render 'icon-goal', icon: s.icon, size: 32, class: 'health-goal__icon' %}
      {%- endif -%}
    </span>

    {%- if has_link -%}
      <span class="health-goal__badge">
        <svg viewBox="562.5 64 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M577.682 75.6465V72.8181H574.853M577.682 72.8181L571.318 79.182"/>
        </svg>
      </span>
    {%- endif -%}
  </span>

  <svg class="health-goal__connector" viewBox="238 158 34 52" fill="none" aria-hidden="true" focusable="false">
    <path class="health-goal__curve" d="M269.6 159A29.5 29.5 0 0 0 247.25 207" />
    <path class="health-goal__tip" d="M247.74 202.3L247.2 207.27L242.72 206.8" />
  </svg>

  {%- if s.heading != blank -%}
    <span class="health-goal__label">{{ s.heading | escape }}</span>
  {%- endif -%}
</{{ tag }}>

{% schema %}
{
  "name": "t:blocks.health_goal.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:blocks.health_goal.settings.icon.label",
      "options": [
        { "value": "none", "label": "t:shared.options.none" },
        { "value": "energy", "label": "t:blocks.health_goal.settings.icon.options__energy" },
        { "value": "gut", "label": "t:blocks.health_goal.settings.icon.options__gut" },
        { "value": "skin", "label": "t:blocks.health_goal.settings.icon.options__skin" },
        { "value": "aging", "label": "t:blocks.health_goal.settings.icon.options__aging" },
        { "value": "weight", "label": "t:blocks.health_goal.settings.icon.options__weight" },
        { "value": "sleep", "label": "t:blocks.health_goal.settings.icon.options__sleep" },
        { "value": "stress", "label": "t:blocks.health_goal.settings.icon.options__stress" },
        { "value": "brain", "label": "t:blocks.health_goal.settings.icon.options__brain" },
        { "value": "female", "label": "t:blocks.health_goal.settings.icon.options__female" },
        { "value": "male", "label": "t:blocks.health_goal.settings.icon.options__male" },
        { "value": "joints", "label": "t:blocks.health_goal.settings.icon.options__joints" },
        { "value": "heart", "label": "t:blocks.health_goal.settings.icon.options__heart" },
        { "value": "leaf", "label": "t:blocks.health_goal.settings.icon.options__leaf" },
        { "value": "shield", "label": "t:blocks.health_goal.settings.icon.options__shield" }
      ],
      "default": "energy"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "t:blocks.health_goal.settings.icon_image.label",
      "info": "t:blocks.health_goal.settings.icon_image.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.health_goal.settings.heading.label",
      "default": "t:blocks.health_goal.defaults.heading"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.category_card.settings.link.label"
    },
    {
      "type": "checkbox",
      "id": "new_tab",
      "label": "t:blocks.category_card.settings.new_tab.label",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:blocks.health_goal.name"
    }
  ]
}
{% endschema %}
