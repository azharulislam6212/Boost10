{% doc %}
  The colours a carousel paints its arrows and dots with, written as custom
  properties the section folds into the slider's own style attribute.
{% enddoc %}

{% render 'carousel-style', settings: block.settings %}

{% schema %}
{
  "name": "t:blocks.carousel_colors.name",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "carousel_inherit_scheme",
      "label": "t:shared.carousel.inherit_scheme.label",
      "info": "t:shared.carousel.inherit_scheme.info",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "color_scheme",
      "id": "carousel_color_scheme",
      "label": "t:shared.color_scheme.label",
      "info": "t:shared.carousel.color_scheme.info",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_style",
      "label": "t:shared.carousel.nav_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.carousel.nav_style.options__1.label"
        },
        {
          "value": "gradient",
          "label": "t:shared.carousel.nav_style.options__2.label"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_bg",
      "label": "t:shared.carousel.nav_bg.label",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false and block.settings.carousel_nav_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_bg_hover",
      "label": "t:shared.carousel.nav_bg_hover.label",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false and block.settings.carousel_nav_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "carousel_nav_gradient",
      "label": "t:shared.carousel.nav_gradient.label",
      "default": "linear-gradient(135deg, #1a1a1a 0%, #4a4a4a 100%)",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false and block.settings.carousel_nav_style == 'gradient' }}"
    },
    {
      "type": "color_background",
      "id": "carousel_nav_gradient_hover",
      "label": "t:shared.carousel.nav_gradient_hover.label",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false and block.settings.carousel_nav_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_icon_color",
      "label": "t:shared.carousel.nav_icon_color.label",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_icon_hover",
      "label": "t:shared.carousel.nav_icon_hover.label",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_border_color",
      "label": "t:shared.carousel.nav_border_color.label",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_border_hover",
      "label": "t:shared.carousel.nav_border_hover.label",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false }}"
    },
    {
      "type": "color",
      "id": "carousel_dot_color",
      "label": "t:shared.carousel.dot_color.label",
      "info": "t:shared.carousel.dot_color.info",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false }}"
    },
    {
      "type": "color",
      "id": "carousel_dot_active_color",
      "label": "t:shared.carousel.dot_active_color.label",
      "visible_if": "{{ block.settings.carousel_inherit_scheme == false }}"
    }
  ]
}
{% endschema %}
