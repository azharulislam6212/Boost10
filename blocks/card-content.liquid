  ],
  "presets": [
    {
      "name": "t:blocks.card_content.name",
      "category": "t:categories.layout",
      "blocks": [
        {
          "type": "text",
          "name": "t:blocks.text.presets.heading.name",
          "settings": {
            "text": "<p>Still have a question?</p>",
