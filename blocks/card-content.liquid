{% doc %}
  The panel that sits on a picture — the frosted card in the bottom corner of the
  *FAQ: Banner* image, holding a heading, a line of text and a button.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign card_classes = 'card-content'
  assign border_gradient = ''
  if s.border_style == 'solid' and s.border_gradient != blank
    assign border_gradient = s.border_gradient
    assign card_classes = card_classes | append: ' card-content--gradient-border'
  endif
-%}

{%- capture card_style -%}
  {%- if border_gradient != '' -%}
    --card-border-paint: {{ border_gradient }};
  {%- endif -%}
  {%- if s.text_color != blank -%}
    color: {{ s.text_color }};
    --color-text: {{ s.text_color }};
    --color-heading: {{ s.text_color }};
    --color-muted-text: {{ s.text_color | color_modify: 'alpha', 0.7 }};
  {%- endif -%}
{%- endcapture -%}

{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{% render 'group',
   children: children,
   settings: s,
   extra_classes: card_classes,
   styles: card_style,
   animate: true,
   gap_mobile_max: 20,
   shopify_attributes: block.shopify_attributes %}

{% schema %}
{
