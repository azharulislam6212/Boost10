{% doc %}
  The overlay link that makes a whole group clickable. Static, so the link
  settings sit beside the group instead of lengthening its own list.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign url = s.link | default: ''
-%}

{%- if url != '' -%}
  <a
    class="block-group__link"
    href="{{ url }}"
    {% if s.link_new_tab %}target="_blank" rel="noopener"{% endif %}
    aria-label="{{ s.link_label | default: url | escape }}"
    {{ block.shopify_attributes }}
  ></a>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.block_link.name",
  "tag": null,
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.group.settings.link.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:blocks.group.settings.link_label.label",
      "info": "t:blocks.group.settings.link_label.info",
      "visible_if": "{{ block.settings.link != blank }}"
    },
    {
      "type": "checkbox",
      "id": "link_new_tab",
      "label": "t:blocks.group.settings.link_new_tab.label",
      "default": false,
      "visible_if": "{{ block.settings.link != blank }}"
    }
  ]
}
{% endschema %}
