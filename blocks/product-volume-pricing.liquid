{% doc %}
  The quantity price break table, the per-unit price it produces, and the
  quantity of this variant already in the cart.
{% enddoc %}

{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
-%}

{%- if product -%}
  <div
    class="product-volume-pricing"
    {% render 'spacing', block: block.settings %}
    {{ block.shopify_attributes }}
  >
    {% render 'volume-pricing',
       product: product,
       variant: variant,
       show_heading: block.settings.show_heading,
       show_unit_price: block.settings.show_unit_price,
       show_cart_quantity: block.settings.show_cart_quantity,
       visible_tiers: block.settings.visible_tiers %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_volume_pricing.name",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "t:blocks.product_volume_pricing.settings.show_heading.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_unit_price",
      "label": "t:blocks.product_volume_pricing.settings.show_unit_price.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_quantity",
      "label": "t:blocks.product_volume_pricing.settings.show_cart_quantity.label",
      "default": true
    },
    {
      "type": "range",
      "id": "visible_tiers",
      "label": "t:blocks.product_volume_pricing.settings.visible_tiers.label",
      "info": "t:blocks.product_volume_pricing.settings.visible_tiers.info",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product_volume_pricing.name",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
