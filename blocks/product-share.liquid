{% comment %}
  blocks/product-share.liquid

  Uses the device share sheet where it exists and falls back to copying the link.
  Nine social icons that open a compose window are a 2015 pattern: they are wrong
  on mobile, where the native sheet already knows which apps the customer has.
{% endcomment %}

{%- liquid
  assign product = closest.product
-%}

{%- if product -%}
  {%- comment -%}
    `<share-button>` is what turns this into a working control. Rendering the
    button alone leaves markup that looks interactive and does nothing, which is
    exactly what this block used to do.
  {%- endcomment -%}
  <share-button
    class="product-share"
    data-url="{{ shop.url }}{{ product.url }}"
    data-title="{{ product.title | escape }}"
    {% render 'spacing', block: block.settings %}
    {{ block.shopify_attributes }}
  >
    <button type="button" class="button button--link product-share__button" data-ref="button">
      {% render 'icon', icon: 'share', size: 16 %}
      {{ block.settings.label | default: 'products.product.share' | t }}
    </button>

    <span class="product-share__feedback" data-ref="feedback" role="status" hidden></span>
  </share-button>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_share.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "t:blocks.button.settings.label.label" },
    { "type": "header", "content": "t:shared.spacing.block_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.product_share.name" }]
}
{% endschema %}
