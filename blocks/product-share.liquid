{% comment %}
  blocks/product-share.liquid

  Uses the device share sheet where it exists and falls back to copying the link.
  Nine social icons that open a compose window are a 2015 pattern: they are wrong
  on mobile, where the native sheet already knows which apps the customer has.
{% endcomment %}

{%- liquid
  assign product = closest.product
-%}

{%- if product -%}
  {%- comment -%}
    `<share-button>` is what turns this into a working control. Rendering the
    button alone leaves markup that looks interactive and does nothing, which is
    exactly what this block used to do.
  {%- endcomment -%}
  <share-button
    class="product-share"
    data-url="{{ shop.url }}{{ product.url }}"
    data-title="{{ product.title | escape }}"
    data-native-share="{% if settings.enable_native_share %}true{% else %}false{% endif %}"
    {% render 'spacing', block: block.settings %}
    {{ block.shopify_attributes }}
  >
    <button type="button" class="button button--link product-share__button" data-ref="button">
      {% render 'icon', icon: 'share', size: 16 %}
      {{ block.settings.label | default: 'products.product.share' | t }}
    </button>

    <span class="product-share__feedback" data-ref="feedback" role="status" hidden></span>
  </share-button>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_share.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "t:blocks.button.settings.label.label" },
        {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        { "value": "desktop", "label": "t:shared.spacing.devices.options__1.label" },
        { "value": "mobile", "label": "t:shared.spacing.devices.options__2.label" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [{ "name": "t:blocks.product_share.name" }]
}
{% endschema %}
