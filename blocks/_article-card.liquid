{% doc %}
  blocks/_article-card.liquid — private.

  @param {number} [index] - Position in the row, for the stagger delay.
{% enddoc %}

{%- liquid
  assign article = closest.article
  assign s = block.settings

  assign card_delay = 0
  if index != blank
    assign columns = s.stagger_span | default: 3 | plus: 0
    assign card_delay = index | modulo: columns | times: 80
  endif

  assign gap = s.gap | default: 12 | plus: 0

  assign direction = s.direction | default: 'column'
-%}

{%- capture card_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --article-card-gap: {{ gap }}px;
{%- endcapture -%}

{%- if article -%}
  <motion-effect
    class="article-card-block article-card-block--{{ direction }}"
    data-block-spacing
    data-morph-key="article-{{ article.id }}"
    style="{{ card_style | strip_newlines | strip }}"
    {% render 'motion-attrs',
       kind: 'image',
       block: s,
       section: section.settings,
       target: '.article-image-block, .article-content-block',
       duration: 1000,
       delay: card_delay %}
    {{ block.shopify_attributes }}
  >
    {% content_for 'blocks' %}
  </motion-effect>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.article_card.name",
  "tag": null,
  "blocks": [
    {
      "type": "_article-image"
    },
    {
      "type": "_article-content"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.article_card.paragraph"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.group.settings.direction.label",
      "options": [
        {
          "value": "column",
          "label": "t:blocks.group.settings.direction.options__1.label"
        },
        {
          "value": "row",
          "label": "t:blocks.group.settings.direction.options__2.label"
        }
      ],
      "default": "column"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:blocks.article_card.settings.gap.label",
      "info": "t:blocks.article_card.settings.gap.info",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
      "type": "select",
      "id": "animation_image",
      "label": "t:shared.animation.animation_image.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_text.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_text.options__2.label"
        },
        {
          "value": "fade-in",
          "label": "t:shared.animation.animation_text.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_text.options__4.label"
        },
        {
          "value": "slide-up",
          "label": "t:shared.animation.animation_text.options__5.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "stagger_span",
      "label": "t:blocks.article_card.settings.stagger_span.label",
      "info": "t:blocks.article_card.settings.stagger_span.info",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
