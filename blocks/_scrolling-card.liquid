{% doc %}
  blocks/_scrolling-card.liquid — private to sections/scrolling-cards.liquid.
  One glass card: a label, a title, a ringed icon and a line of text.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign icon_name = s.icon | default: 'leaf'
-%}

<article class="scrolling-card" data-scrolling-card {{ block.shopify_attributes }}>
  {%- if s.label != blank -%}
    <p class="scrolling-card__label">{{ s.label | escape }}</p>
  {%- endif -%}

  {%- if s.title != blank -%}
    <h3 class="scrolling-card__title">{{ s.title | escape }}</h3>
  {%- endif -%}

  {%- if icon_name != blank and icon_name != 'none' -%}
    <span class="scrolling-card__icon" aria-hidden="true">
      {% render 'icon', icon: icon_name, size: 32 %}
    </span>
  {%- endif -%}

  {%- if s.text != blank -%}
    <div class="scrolling-card__text rte">{{ s.text }}</div>
  {%- endif -%}
</article>

