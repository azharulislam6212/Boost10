{% doc %}
  Which page types the header floats over, answered for the page being drawn
  and handed back as `supports|inverse logo|text colour`. Static, so the four
  page types sit beside the section instead of lengthening its own list.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign supports = false
  assign inverse = false
  assign text = blank

  case request.page_type
    when 'index'
      assign supports = s.transparent_home
      assign inverse = s.inverse_logo_home
      assign text = s.transparent_text_home
    when 'product'
      assign supports = s.transparent_product
      assign inverse = s.inverse_logo_product
      assign text = s.transparent_text_product
    when 'collection', 'list-collections'
      assign supports = s.transparent_collection
      assign inverse = s.inverse_logo_collection
      assign text = s.transparent_text_collection
    when 'article', 'blog'
      assign supports = s.transparent_blog
      assign inverse = s.inverse_logo_blog
      assign text = s.transparent_text_blog
  endcase

  echo supports
  echo '|'
  echo inverse
  echo '|'
  echo text
-%}

