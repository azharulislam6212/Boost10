{% comment %}
  blocks/newsletter.liquid

  Wraps Shopify's own `customer` form, which creates a customer with the email
  marketing consent flag set. There is no separate newsletter endpoint, and a
  theme has no business posting subscriber addresses anywhere else.

  The form is not intercepted: success and error come back from Shopify after a
  reload, and re-implementing its validation and consent handling in JavaScript
  would be inventing a second source of truth for a legal record.
{% endcomment %}

{%- comment -%}
  The form id is built before the render, not inside its arguments.

  This block previously passed `id: 'Newsletter-', append: block.id`, which is
  what an automatic rewrite leaves behind when it strips a filter out of a
  `render` argument: `append` is not a parameter this snippet has, so every
  newsletter block on a page rendered with the same id — `Newsletter-`. Two
  blocks then shared one `<label for>` and one error region, and clicking the
  second block's label focused the first block's field.
{%- endcomment -%}
{%- assign newsletter_id = 'Newsletter-' | append: block.id -%}

<div class="newsletter-block" {% render 'spacing', block: block.settings %} {{ block.shopify_attributes }}>
  {% render 'newsletter-form',
     id: newsletter_id,
     heading: block.settings.heading,
     text: block.settings.text %}
</div>

{% schema %}
{
  "name": "t:blocks.newsletter.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:shared.heading.label", "default": "Stay in the loop" },
    { "type": "richtext", "id": "text", "label": "t:shared.text.label" },
    { "type": "paragraph", "content": "t:blocks.newsletter.paragraph" },
        {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        { "value": "desktop", "label": "t:shared.spacing.devices.options__1.label" },
        { "value": "mobile", "label": "t:shared.spacing.devices.options__2.label" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [{ "name": "t:blocks.newsletter.name" }]
}
{% endschema %}
