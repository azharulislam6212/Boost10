{% comment %}
  blocks/newsletter.liquid

  Wraps Shopify's own `customer` form, which creates a customer with the email
  marketing consent flag set. There is no separate newsletter endpoint, and a
  theme has no business posting subscriber addresses anywhere else.

  The form is not intercepted: success and error come back from Shopify after a
  reload, and re-implementing its validation and consent handling in JavaScript
  would be inventing a second source of truth for a legal record.
{% endcomment %}

<div class="newsletter-block" {% render 'spacing', block: block.settings %} {{ block.shopify_attributes }}>
  {% render 'newsletter-form', id: 'Newsletter-', append: block.id, heading: block.settings.heading, text: block.settings.text %}
</div>

{% schema %}
{
  "name": "t:blocks.newsletter.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:shared.heading.label", "default": "Stay in the loop" },
    { "type": "richtext", "id": "text", "label": "t:shared.text.label" },
    { "type": "paragraph", "content": "t:blocks.newsletter.paragraph" },
    { "type": "header", "content": "t:shared.spacing.block_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.newsletter.name" }]
}
{% endschema %}
{% comment %}

This file has been rewritten to preserve the original behavior.

