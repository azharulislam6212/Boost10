{% doc %}
  Two buttons side by side.
{% enddoc %}

{%- liquid
  assign custom_1 = false
  if block.settings.style_1 == 'custom'
    assign custom_1 = true
  endif

  assign custom_2 = false
  if block.settings.style_2 == 'custom'
    assign custom_2 = true
  endif
-%}

{%- capture colors_1 -%}
  {% content_for 'block', type: '_button-colors', id: 'button-1-colors', enabled: custom_1 %}
{%- endcapture -%}

{%- capture colors_2 -%}
  {% content_for 'block', type: '_button-colors', id: 'button-2-colors', enabled: custom_2 %}
{%- endcapture -%}

{%- liquid
  assign s = block.settings
  assign colors_1 = colors_1 | strip_newlines | strip
  assign colors_2 = colors_2 | strip_newlines | strip

  capture icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0

  assign label_1 = s.label_1
  assign label_2 = s.label_2
  if request.design_mode
    assign label_1 = label_1 | default: 'Button'
    assign label_2 = label_2 | default: 'Button'
  endif

  assign shape = ''
  assign radius = s.corner_radius | default: -1 | plus: 0
  if radius >= 0
    assign shape = shape | append: '--radius-button:' | append: radius | append: 'px;'
  endif
  assign thickness = s.border_thickness | default: -1 | plus: 0
  if thickness >= 0
    assign shape = shape | append: '--buttons-border-thickness:' | append: thickness | append: 'px;'
  endif

  assign inline_1 = colors_1 | append: shape
  assign inline_2 = colors_2 | append: shape

  assign size_class = s.size | default: 'medium'
  if size_class == 'custom'
    assign size_class = 'custom-size'
  endif
-%}

<motion-effect
  class="block-buttons block-buttons--{{ s.alignment | default: 'start' }}"
  data-block-spacing
  style="{% content_for 'block', type: '_block-spacing', id: 'spacing' %}"
  {% render 'motion-attrs', kind: 'text', block: s, block_level: true %}
  {{ block.shopify_attributes }}
>
  {%- if label_1 != blank -%}
    {% render 'button',
       label: label_1,
       href: s.link_1,
       new_tab: s.new_tab_1,
       variant: s.style_1,
       size: size_class,
       custom_height: s.buttons_height_custom,
       icon: s.icon_1,
       icon_style: s.icon_style_1,
       icon_position: s.icon_position_1,
       icon_size: icon_size,
       icon_radius: s.icon_radius,
       border_style: s.border_style,
       underline_size: s.underline_thickness,
       width: s.width,
       min_width: s.min_width,
       effect: s.hover_effect,
       colors: inline_1 %}
  {%- endif -%}

  {%- if label_2 != blank -%}
    {% render 'button',
       label: label_2,
       href: s.link_2,
       new_tab: s.new_tab_2,
       variant: s.style_2,
       size: size_class,
       custom_height: s.buttons_height_custom,
       icon: s.icon_2,
       icon_style: s.icon_style_2,
       icon_position: s.icon_position_2,
       icon_size: icon_size,
       icon_radius: s.icon_radius,
       border_style: s.border_style,
       underline_size: s.underline_thickness,
       width: s.width,
       min_width: s.min_width,
       effect: s.hover_effect,
       colors: inline_2 %}
  {%- endif -%}
</motion-effect>


