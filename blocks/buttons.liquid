{% comment %}
  blocks/buttons.liquid

  Two buttons side by side.

  A separate block rather than "add the button block twice", because a pair of
  buttons is a single design decision: they share alignment, they wrap together
  on mobile, and the second is almost always the quieter one. Two independent
  blocks give a merchant two ways to get that subtly wrong.
{% endcomment %}

<div
  class="block-buttons block-buttons--{{ block.settings.alignment }}"
  {% render 'spacing', block: block.settings %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.label_1 != blank -%}
    {% render 'button',
       label: block.settings.label_1,
       href: block.settings.link_1,
       variant: block.settings.style_1,
       size: block.settings.size %}
  {%- endif -%}

  {%- if block.settings.label_2 != blank -%}
    {% render 'button',
       label: block.settings.label_2,
       href: block.settings.link_2,
       variant: block.settings.style_2,
       size: block.settings.size %}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.buttons.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label_1", "label": "t:blocks.buttons.settings.label_1.label", "default": "Shop now" },
    { "type": "url", "id": "link_1", "label": "t:blocks.buttons.settings.link_1.label" },
    {
      "type": "select", "id": "style_1", "label": "t:blocks.buttons.settings.style_1.label",
      "options": [
        { "value": "primary", "label": "t:blocks.button.settings.style.options__1.label" },
        { "value": "secondary", "label": "t:blocks.button.settings.style.options__2.label" },
        { "value": "outline", "label": "t:blocks.button.settings.style.options__3.label" }
      ],
      "default": "primary"
    },
    { "type": "text", "id": "label_2", "label": "t:blocks.buttons.settings.label_2.label" },
    { "type": "url", "id": "link_2", "label": "t:blocks.buttons.settings.link_2.label" },
    {
      "type": "select", "id": "style_2", "label": "t:blocks.buttons.settings.style_2.label",
      "options": [
        { "value": "primary", "label": "t:blocks.button.settings.style.options__1.label" },
        { "value": "secondary", "label": "t:blocks.button.settings.style.options__2.label" },
        { "value": "outline", "label": "t:blocks.button.settings.style.options__3.label" },
        { "value": "link", "label": "t:blocks.button.settings.style.options__4.label" }
      ],
      "default": "secondary"
    },
    {
      "type": "select", "id": "size", "label": "t:blocks.button.settings.size.label",
      "options": [
        { "value": "small", "label": "t:blocks.button.settings.size.options__1.label" },
        { "value": "medium", "label": "t:blocks.button.settings.size.options__2.label" },
        { "value": "large", "label": "t:blocks.button.settings.size.options__3.label" },
        { "value": "custom", "label": "t:blocks.button.settings.size.options__4.label" }
      ],
      "default": "medium"
    },
      {
        "type": "range",
        "id": "buttons_height_custom",
        "label": "t:settings_schema.buttons.settings.height.label",
        "min": 30,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 60,
         "visible_if": "{{ block.settings.size == \"custom\" }}"
      },
    {
      "type": "select", "id": "alignment", "label": "t:blocks.group.settings.alignment.label",
      "options": [
        { "value": "start", "label": "t:blocks.group.settings.alignment.options__1.label" },
        { "value": "center", "label": "t:blocks.group.settings.alignment.options__2.label" },
        { "value": "end", "label": "t:blocks.group.settings.alignment.options__3.label" }
      ],
      "default": "start"
    },
    { "type": "header", "content": "t:shared.spacing.block_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.buttons.name" }]
}
{% endschema %}
