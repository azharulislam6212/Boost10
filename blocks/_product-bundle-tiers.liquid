{% doc %}
  The volume discount ladder, written as the compact `slot:percent` list the
  bundle element reads. Static, so the tiers sit beside the section instead of
  lengthening its own list.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign slots = section.settings.bundle_size | default: 6 | plus: 0

  assign parts = ''
  for i in (1..6)
    assign enable_key = 'tier_' | append: i | append: '_enable'
    assign percent_key = 'tier_' | append: i | append: '_percent'

    if s[enable_key] and i <= slots
      assign parts = parts | append: i | append: ':' | append: s[percent_key] | append: ','
    endif
  endfor
  echo parts | split: ',' | join: ','
-%}

{% schema %}
{
  "name": "t:blocks.product_bundle_tiers.name",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "tier_1_enable",
      "label": "t:sections.product_bundle.settings.tier_enable.label_1",
      "default": true,
      "visible_if": "{{ section.settings.tray_style == 'ladder' }}"
    },
    {
