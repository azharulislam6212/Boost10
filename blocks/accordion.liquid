{% doc %}
  The group its rows belong to. It also sets the look every row shares:
  toggle, icon size, shape and ring, background, border and corners.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign gap = s.gap | default: 16 | plus: 0
  assign alignment = s.alignment | default: 'start'

  assign border_style = s.border_style | default: 'none'
  assign border_width = 0
  if border_style != 'none'
    assign border_width = s.border_width | default: 1 | plus: 0

    if s.border_color == blank
      assign border_paint = 'var(--color-heading)'
    else
      assign border_paint = s.border_color
    endif
  endif

  assign radius = s.border_radius | default: 14 | plus: 0

  # ---- the row icon -------------------------------------------------------
  # One look for every row. Rows cannot read this block's settings, so the
  # mark is handed down as `--accordion-mark-*` properties that only the row
  # icon maps back onto `--icon-mark-*`; icons inside an answer never see them.
  capture icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0
  assign icon_box = icon_size | plus: 12

  capture mark_declarations
    render 'icon-mark', block: s, declarations: true, dash_gap: 4
  endcapture
  assign mark_declarations = mark_declarations | replace: '--icon-mark-', '--accordion-mark-'

  assign shape = s.shape | default: 'none'
  assign ring_style = s.ring_style | default: 'none'
  assign ring_width = s.ring_width | default: 1 | plus: 0
  assign ring = 'none'
  if shape != 'none' and ring_style != 'none'
    assign ring = shape
  endif

  assign ring_dash = 'none'
  assign ring_cap = 'butt'
  if ring_style == 'dashed'
    assign ring_dash = '2px 4px'
  elsif ring_style == 'dotted'
    assign dot_gap = ring_width | times: 2
    assign ring_dash = '0.01px ' | append: dot_gap | append: 'px'
    assign ring_cap = 'round'
  endif
-%}

{%- capture accordion_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --block-padding-inline-start: 0px;
  --block-padding-inline-end: 0px;
  --block-padding-inline-start-mobile: 0px;
  --block-padding-inline-end-mobile: 0px;
  --accordion-gap: {{ gap }}px;
  --accordion-align: {{ alignment }};
  --accordion-row-radius: {{ radius }}px;
  --accordion-row-icon-size: {{ icon_size }}px;
  --accordion-row-icon-box: {{ icon_box }}px;
  {{ mark_declarations }}
  {%- if ring != 'none' -%}
    --accordion-ring-width: {{ ring_width }}px;
    --accordion-ring-dash: {{ ring_dash }};
    --accordion-ring-cap: {{ ring_cap }};
  {%- endif -%}
  {%- if s.background_color != blank -%}
    --accordion-row-background: {{ s.background_color }};
  {%- endif -%}
  {%- if border_width > 0 -%}
    --accordion-row-border-width: {{ border_width }}px;
    --accordion-row-border-style: {{ border_style }};
    --accordion-row-border-color: {{ border_paint }};
  {%- endif -%}
{%- endcapture -%}

<motion-effect
  class="accordion-motion"
  {% render 'motion-attrs', kind: 'text', block: s, target: '.accordion-row', duration: 1000 %}
>
  <accordion-element
    class="accordion"
    {% if s.single_open %}data-single{% endif %}
    data-toggle="{{ s.toggle_style | default: 'plus' }}"
    data-icon-style="{{ s.icon_style | default: 'soft' }}"
    data-ring="{{ ring }}"
    data-block-spacing
    style="{{ accordion_style | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    {% content_for 'blocks' %}
  </accordion-element>
</motion-effect>

{% schema %}
