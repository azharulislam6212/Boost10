{% comment %}
  blocks/_footer-localization.liquid

  The country and language pickers, as a block a merchant can place.

  They were a section setting, which meant the footer decided where they went.
  As a block they sit wherever the merchant drags them — usually the end of the
  utilities row, which is what the design shows.

  Nothing about the pickers themselves is re-implemented here.
  `snippets/localization-selectors.liquid` wraps Shopify's own `localization`
  form, which is the only supported way to change market or locale and the only
  one that works with no JavaScript. The country list is searchable through that
  snippet's own filter field — the same control the header uses, because it is
  the same snippet.
{% endcomment %}

{%- liquid
  capture localization_spacing
    render 'spacing', block: block.settings, declarations: true
  endcapture

  assign picker_id = 'FooterLocalization-' | append: block.id
-%}

<div
  class="footer-localization-block"
  data-block-spacing
  style="{{ localization_spacing | strip }}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="footer-localization-block__heading">{{ block.settings.heading }}</p>
  {%- endif -%}

  {% render 'localization-selectors', id_prefix: picker_id, class: 'footer__localization' %}
</div>

{% schema %}
{
  "name": "t:blocks.footer_localization.name",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.footer_localization.paragraph"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading.label"
    },
        {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        { "value": "desktop", "label": "t:shared.spacing.devices.options__1.label" },
        { "value": "mobile", "label": "t:shared.spacing.devices.options__2.label" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
