{% doc %}
  The shipping promise on a pre-order product.
{% enddoc %}

{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant

  assign is_preorder = false
  if variant.inventory_management != blank and variant.inventory_policy == 'continue' and variant.inventory_quantity <= 0
    assign is_preorder = true
  endif

  if settings.preorder_tag != blank and product.tags contains settings.preorder_tag
    assign is_preorder = true
  endif
-%}

{%- if product and is_preorder -%}
  <div
    class="preorder-note"
    data-preorder-note
    {% render 'spacing', block: block.settings %}
    {{ block.shopify_attributes }}
  >
    {% render 'icon', icon: 'truck', size: 18, class: 'preorder-note__icon' %}

    <div class="preorder-note__body">
      <p class="preorder-note__heading">{{ 'products.preorder.heading' | t }}</p>

      {%- if block.settings.ship_date != blank -%}
        <p class="preorder-note__date">
          {{ 'products.preorder.ships_on_html' | t: date: block.settings.ship_date }}
        </p>
      {%- else -%}
        <p class="preorder-note__date">{{ 'products.preorder.ships_soon' | t }}</p>
      {%- endif -%}

      {%- if block.settings.text != blank -%}
        <div class="preorder-note__text rte">{{ block.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
@layer components {
  .preorder-note {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-secondary-background);
  }

  .preorder-note__icon { flex: 0 0 auto; margin-block-start: 0.2rem; }
  .preorder-note__body { min-inline-size: 0; }
  .preorder-note__heading { font-weight: 500; }
  .preorder-note__date { font-size: var(--font-size-sm); }
  .preorder-note__text { font-size: var(--font-size-xs); color: var(--color-muted-text); margin-block-start: var(--space-2); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.preorder_note.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "ship_date",
      "label": "t:blocks.preorder_note.settings.ship_date.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:shared.text.label"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.preorder_note.name",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}

