{% comment %}
  blocks/footer-menu.liquid

  A column of links.

  Renders as `<details>` so the footer can collapse it on small screens. The
  parent `<accordion-element data-collapse-below>` opens every one above the
  breakpoint and marks the summaries static — one set of markup for both, no
  duplicate DOM, and with the script gone it is an open list, which is a readable
  footer.

  Only link columns collapse. A short about paragraph, a newsletter form and a
  social row are what customers are looking for at the bottom of a page; hiding
  them behind a tap is how a signup form stops being used.
{% endcomment %}

{%- if block.settings.menu != blank or block.settings.heading != blank -%}
  <details
    class="footer-menu"
    {% if block.settings.open_on_mobile %}data-default-open open{% endif %}
    {% render 'spacing', block: block.settings %}
    {{ block.shopify_attributes }}
  >
    <summary class="footer-menu__summary">
      <h2 class="footer-menu__heading">{{ block.settings.heading }}</h2>
      {% render 'icon', icon: 'chevron-down', class: 'footer-menu__icon', size: 14 %}
    </summary>

    <div class="footer-menu__content">
      <ul class="footer-menu__list" role="list">
        {%- for link in block.settings.menu.links -%}
          <li>
            <a class="footer-menu__link" href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </details>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.footer_menu.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:shared.heading.label", "default": "Shop" },
    { "type": "link_list", "id": "menu", "label": "t:sections.footer.blocks.menu.settings.menu.label", "default": "footer" },
    { "type": "checkbox", "id": "open_on_mobile", "label": "t:sections.footer.blocks.shared.open_on_mobile.label", "info": "t:sections.footer.blocks.shared.open_on_mobile.info", "default": false },
        {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        { "value": "desktop", "label": "t:shared.spacing.devices.options__1.label" },
        { "value": "mobile", "label": "t:shared.spacing.devices.options__2.label" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [{ "name": "t:blocks.footer_menu.name" }]
}
{% endschema %}
