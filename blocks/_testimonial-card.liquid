{% doc %}
  blocks/_testimonial-card.liquid — private to `sections/testimonials.liquid`.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign product = s.product
  assign panel_id = 'tc-panel-' | append: block.id

  assign info_title = 'onboarding.product_title' | t
  if product != blank
    assign info_title = product.title
  endif

  assign border_paint = ''
  if s.border_style != 'none' and s.border_thickness > 0
    if s.border_color == blank
      assign border_paint = 'color-mix(in srgb, currentColor ' | append: s.border_opacity | append: '%, transparent)'
    else
      assign border_alpha = s.border_opacity | divided_by: 100.0
      assign border_paint = s.border_color | color_modify: 'alpha', border_alpha
    endif
  endif
-%}

{%- capture card_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --tc-frame-gap: {{ s.gap }}px;
  --tc-radius: {{ s.border_radius }}px;
  --tc-radius-mobile: {{ s.border_radius_mobile }}px;
  --tc-frame-radius: {{ s.frame_radius }}px;
  --tc-frame-radius-mobile: {{ s.frame_radius_mobile }}px;
  {%- if s.min_height > 0 %} --tc-min-height: {{ s.min_height }}px;{% endif -%}
  {%- if border_paint != blank %}
    --tc-border-width: {{ s.border_thickness }}px;
    --tc-border-style: {{ s.border_style }};
    --tc-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if s.frame_background != blank %}
    {%- assign frame_alpha = s.frame_background_opacity | divided_by: 100.0 %}
    --tc-frame-background: {{ s.frame_background | color_modify: 'alpha', frame_alpha }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="testimonial-card
    {%- if s.show_product %} testimonial-card--has-product{% endif %}
    {%- if product == blank %} testimonial-card--placeholder-product{% endif %}"
  style="{{ card_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {%- if s.show_product -%}<testimonial-product>{%- endif -%}

  <div class="testimonial-card__frame" data-block-spacing>
    <div class="testimonial-card__head">
      <div class="testimonial-card__identity">
        {%- if s.author != blank -%}
          <cite class="testimonial-card__name">{{ s.author | escape }}</cite>
        {%- endif -%}
        {%- if s.role != blank -%}
          <span class="testimonial-card__role">{{ s.role | escape }}</span>
        {%- endif -%}
      </div>

      {%- if s.show_verified and s.verified_label != blank -%}
        <span class="testimonial-card__verified">
          <span class="testimonial-card__verified-mark" aria-hidden="true">
            {% render 'icon', icon: 'check', size: 10 %}
          </span>
          {{ s.verified_label | escape }}
        </span>
      {%- endif -%}
    </div>

    {%- if s.rating > 0 -%}
      {% render 'rating-stars', rating: s.rating, size: s.star_size, class: 'testimonial-card__stars' %}
    {%- endif -%}

    {%- if s.quote != blank -%}
      <blockquote class="testimonial-card__quote">{{ s.quote }}</blockquote>
    {%- endif -%}

    {%- if s.show_product -%}
      <div class="testimonial-card__info" id="{{ panel_id }}" data-ref="panel">
        {%- if product != blank -%}
          <a class="testimonial-card__info-title" href="{{ product.url }}">{{ info_title }}</a>
          {%- assign product_rating = product.metafields.reviews.rating.value -%}
          {%- if s.show_info_rating and product_rating != blank and product_rating.rating != blank -%}
            {% render 'rating', product: product, class: 'testimonial-card__info-rating' %}
          {%- endif -%}
          {%- if s.show_info_price -%}
            {% render 'price', product: product, price_class: 'testimonial-card__info-price' %}
          {%- endif -%}
        {%- else -%}
          <p class="testimonial-card__info-title">{{ info_title }}</p>
          {%- if s.show_info_price -%}
            <div class="price testimonial-card__info-price">
              <span class="price__current">{{ 1999 | money }}</span>
            </div>
          {%- endif -%}
        {%- endif -%}

        <button
          type="button"
          class="testimonial-card__info-close"
          data-ref="close"
          aria-label="{{ 'general.actions.close' | t }}"
        >
          {% render 'icon', icon: 'close', size: 12 %}
        </button>
      </div>
    {%- endif -%}
  </div>

  {%- if s.show_product -%}
    <button
      type="button"
      class="testimonial-card__thumb"
      data-ref="toggle"
      aria-expanded="false"
      aria-controls="{{ panel_id }}"
      aria-label="{{ info_title | escape }}"
    >
      {% render 'image',
         image: product.featured_image,
         alt: '',
         ratio: '1-1',
         class: 'testimonial-card__thumb-image',
         placeholder: 'product-apparel-1',
         sizes: '140px' %}
    </button>
    </testimonial-product>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.testimonial_card.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "author",
      "label": "t:blocks.testimonial.settings.author.label",
      "default": "t:blocks.testimonial_card.defaults.author"
    },
    {
      "type": "text",
      "id": "role",
      "label": "t:blocks.testimonial_card.settings.role.label",
      "default": "t:blocks.testimonial_card.defaults.role"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "t:blocks.testimonial.settings.quote.label",
      "default": "t:blocks.testimonial_card.defaults.quote"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "t:blocks.testimonial.settings.rating.label",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:blocks.article_card.settings.gap.label",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "t:blocks.testimonial_card.settings.star_size.label",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "show_verified",
      "label": "t:blocks.testimonial_card.settings.show_verified.label",
      "default": true
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "t:blocks.testimonial_card.settings.verified_label.label",
      "default": "t:blocks.testimonial_card.defaults.verified_label",
      "visible_if": "{{ block.settings.show_verified }}"
    },
    {
      "type": "header",
      "content": "t:blocks.testimonial_card.headers.product"
    },
    {
      "type": "checkbox",
      "id": "show_product",
      "label": "t:blocks.testimonial_card.settings.show_product.label",
      "default": true
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:blocks.testimonial_card.settings.product.label"
    },
    {
      "type": "checkbox",
      "id": "show_info_rating",
      "label": "t:blocks.testimonial_card.settings.show_info_rating.label",
      "default": true,
      "visible_if": "{{ block.settings.show_product }}"
    },
    {
      "type": "checkbox",
      "id": "show_info_price",
      "label": "t:blocks.testimonial_card.settings.show_info_price.label",
      "default": true,
      "visible_if": "{{ block.settings.show_product }}"
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "color",
      "id": "frame_background",
      "label": "t:blocks.testimonial_card.settings.frame_background.label",
      "default": "#E5F1EE"
    },
    {
      "type": "range",
      "id": "frame_background_opacity",
      "label": "t:sections.feature_cards.settings.panel_background_opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "frame_radius",
      "label": "t:blocks.testimonial_card.settings.frame_radius.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "frame_radius_mobile",
      "label": "t:blocks.testimonial_card.settings.frame_radius_mobile.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "t:blocks.feature_card.settings.min_height.label",
      "min": 0,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 350
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:shared.border.style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.options.dashed"
        }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "t:shared.border.thickness.label",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "t:shared.border.opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:shared.border.color.label",
      "default": "#E5F1EE",
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:shared.corners.header"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius_mobile",
      "label": "t:shared.corners.radius_mobile.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
