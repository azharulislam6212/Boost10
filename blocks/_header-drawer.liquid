{% doc %}
  The mobile menu drawer. Static, so the drawer options sit beside the header
  instead of lengthening its own list.
{% enddoc %}

{% render 'header-drawer', menu: section.settings.menu, options: block.settings %}

{% schema %}
{
  "name": "t:blocks.header_drawer.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "mobile_submenu_style",
      "label": "t:sections.header.settings.mobile_submenu_style.label",
      "info": "t:sections.header.settings.mobile_submenu_style.info",
      "options": [
        {
          "value": "accordion",
          "label": "t:sections.header.settings.mobile_submenu_style.options__1.label"
        },
        {
          "value": "slide",
          "label": "t:sections.header.settings.mobile_submenu_style.options__2.label"
        }
      ],
      "default": "accordion"
    },
    {
      "type": "checkbox",
      "id": "mobile_drawer_logo",
      "label": "t:sections.header.settings.mobile_drawer_logo.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_dividers",
      "label": "t:sections.header.settings.mobile_dividers.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_show_localization",
      "label": "t:sections.header.settings.mobile_show_localization.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_show_social",
      "label": "t:sections.header.settings.mobile_show_social.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_show_account",
      "label": "t:sections.header.settings.mobile_show_account.label",
      "default": true
    }
  ]
}
{% endschema %}
