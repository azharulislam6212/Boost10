{% doc %}
  A banner: media first, then nested blocks laid over it — a figure, a line of
  copy, a stat card pinned to a corner. Built on the group snippet like
  `blocks/image-card.liquid`, so it shares that block's settings.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign content_over = false
  if s.background_media == 'image'
    assign content_over = true
  endif

  assign ratio = s.ratio

  capture ratio_value
    render 'aspect-ratio', ratio: ratio, image: s.image
  endcapture

  assign classes = 'image-card banner-card'
  if content_over
    assign classes = classes | append: ' image-card--over'
  else
    assign classes = classes | append: ' image-card--below'
  endif
-%}

{%- capture card_style -%}
  {%- if content_over and s.height != 'fill' -%}
    --image-card-ratio: {{ ratio_value | strip }};
  {%- endif -%}
  {%- if s.label_color != blank -%}
    --image-card-label-color: {{ s.label_color }};
  {%- endif -%}
{%- endcapture -%}

{%- capture card_attributes -%}
  {% render 'motion-attrs',
     kind: 'image',
     block: s,
     target: ':scope > .background-media > *, :scope > .block-group__content > .image-card__media > *'
  %}
{%- endcapture -%}

{%- capture children -%}

  {%- if content_over == false -%}
    {% render 'image',
       image: s.image,
       mobile_image: s.image_mobile,
       ratio: ratio,
       mobile_ratio: s.ratio_mobile,
       sizes: '(min-width: 990px) 40vw, 100vw',
       priority: s.priority,
       preload: s.priority,
       wrapper_class: 'image-card__media' %}
  {%- endif -%}

  {%- if s.label_text != blank -%}
    <span class="image-card__label{% unless s.label_in_content %} image-card__label--pinned{% endunless %}">
      {{- s.label_text | escape -}}
    </span>
  {%- endif -%}

  {% content_for 'blocks' %}
{%- endcapture -%}

{% render 'group',
   children: children,
   settings: s,
   extra_classes: classes,
   tag: 'motion-effect',
   attributes: card_attributes,
   styles: card_style,
   priority: s.priority,
   placeholder: 'hero-apparel-1',
   overlay_opacity: 100,
   gap_mobile_max: 20,
   shopify_attributes: block.shopify_attributes %}

