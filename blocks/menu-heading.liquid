{% doc %}
  blocks/menu-heading.liquid — Boost10
{% enddoc %}

{%- liquid
  assign st = block.settings
-%}

<div
  class="megamenu__item megamenu__item--heading"
  style="--span: {{ st.column_span }};"
  {{ block.shopify_attributes }}
>
  {%- if st.link != blank -%}
    <a class="megamenu__eyebrow megamenu__eyebrow--link" href="{{ st.link }}">
      <span>{{ st.text | escape }}</span>
      {% render 'icon', icon: 'arrow-right', size: 14 %}
    </a>
  {%- else -%}
    <p class="megamenu__eyebrow">{{ st.text | escape }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.menu_heading.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:shared.text.label",
      "default": "Featured"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:shared.link.label"
    },
    {
      "type": "range",
      "id": "column_span",
      "label": "t:blocks.shared.column_span.label",
      "info": "t:blocks.shared.column_span.info",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 12
    }
  ]
}
{% endschema %}
