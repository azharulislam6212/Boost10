{% doc %}
  blocks/_showcase-stats.liquid — private to `sections/testimonials-showcase.liquid`.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign columns = s.columns | default: 3 | plus: 0
  assign columns_mobile = s.columns_mobile | default: 1 | plus: 0
-%}

{%- capture stats_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --sv-stats-columns: {{ columns }};
  --sv-stats-columns-mobile: {{ columns_mobile }};
  --sv-stat-radius: {{ s.stat_radius | default: 24 | plus: 0 }}px;
  {%- if s.stat_icon_color != blank -%}
    --sv-stat-icon-color: {{ s.stat_icon_color }};
  {%- endif -%}
  {%- if s.stat_value_color != blank -%}
    --sv-stat-value-color: {{ s.stat_value_color }};
  {%- endif -%}
  {%- if s.stat_label_color != blank -%}
    --sv-stat-label-color: {{ s.stat_label_color }};
  {%- endif -%}
  {%- if s.stat_background != blank -%}
    --sv-stat-background: {{ s.stat_background }};
  {%- endif -%}
  {%- if s.stat_border_start != blank -%}
    --sv-stat-border-start: {{ s.stat_border_start }};
  {%- endif -%}
  {%- if s.stat_border_end != blank -%}
    --sv-stat-border-end: {{ s.stat_border_end }};
  {%- endif -%}
{%- endcapture -%}

<motion-effect
  class="showcase-stats"
  data-block-spacing
  data-easing="outQuint"
  style="{{ stats_style | strip_newlines | strip }}"
  {% render 'motion-attrs', kind: 'image', section: section.settings, target: '.showcase-stat', duration: 1000, stagger: 120 %}
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</motion-effect>

{% schema %}
{
  "name": "t:blocks.showcase_stats.name",
  "tag": null,
  "blocks": [
    {
      "type": "_showcase-stat"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.showcase_stats.paragraph"
    },
    {
      "type": "header",
      "content": "t:shared.columns.header"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:shared.columns.desktop.label",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "t:shared.columns.mobile.label",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "t:blocks.showcase_stats.headers.stats"
    },
    {
      "type": "color",
      "id": "stat_icon_color",
      "label": "t:blocks.showcase_stat.settings.icon_color.label",
      "default": "#03D26F"
    },
    {
      "type": "color",
      "id": "stat_value_color",
      "label": "t:blocks.testimonial_stat.settings.value_color.label",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "stat_label_color",
      "label": "t:blocks.testimonial_stat.settings.label_color.label",
      "default": "rgba(255, 255, 255, 0.72)"
    },
    {
      "type": "color",
      "id": "stat_background",
      "label": "t:shared.background.color.label",
      "default": "rgba(255, 255, 255, 0.04)"
    },
    {
      "type": "color",
      "id": "stat_border_start",
      "label": "t:blocks.showcase_stat.settings.border_gradient_start.label",
      "info": "t:blocks.showcase_stat.settings.border_gradient_start.info",
      "default": "rgba(3, 210, 111, 0.4)"
    },
    {
      "type": "color",
      "id": "stat_border_end",
      "label": "t:blocks.showcase_stat.settings.border_gradient_end.label",
      "default": "rgba(255, 255, 255, 0.1)"
    },
    {
      "type": "range",
      "id": "stat_radius",
      "label": "t:shared.corner_radius.label",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
