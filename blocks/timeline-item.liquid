{% comment %}
  blocks/timeline-item.liquid

  One moment in a brand story.

  An `<li>` inside the section's ordered list, because a timeline is a sequence
  and marking it up as a list is what tells a screen reader "four of nine" rather
  than leaving the customer to count.
{% endcomment %}

<li class="timeline__item" {% render 'spacing', block: block.settings %} {{ block.shopify_attributes }}>
  <motion-effect {% render 'motion-attrs', kind: 'text', block: block.settings %} class="timeline__inner">
    {%- if block.settings.year != blank -%}
      <p class="timeline__year">{{ block.settings.year }}</p>
    {%- endif -%}

    {%- if block.settings.image != blank -%}
      {% render 'image',
         image: block.settings.image,
         alt: '',
         ratio: 'landscape',
         sizes: '(min-width: 750px) 33vw, 80vw',
         wrapper_class: 'timeline__media' %}
    {%- endif -%}

    {%- if block.settings.heading != blank -%}
      <h3 class="timeline__heading">{{ block.settings.heading }}</h3>
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <div class="timeline__text rte">{{ block.settings.text }}</div>
    {%- endif -%}
  </motion-effect>
</li>

{% schema %}
{
  "name": "t:blocks.timeline_item.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "year", "label": "t:blocks.timeline_item.settings.year.label", "default": "2019" },
    { "type": "text", "id": "heading", "label": "t:shared.heading.label", "default": "The first workshop" },
    { "type": "richtext", "id": "text", "label": "t:shared.text.label" },
    { "type": "image_picker", "id": "image", "label": "t:shared.image.label" },
    { "type": "header", "content": "t:shared.animation.header" },
    {
      "type": "select", "id": "animation_text", "label": "t:shared.animation.animation_text.label",
      "options": [
        { "value": "inherit", "label": "t:shared.animation.animation_text.options__1.label" },
        { "value": "none", "label": "t:shared.animation.animation_text.options__2.label" },
        { "value": "fade-up", "label": "t:shared.animation.animation_text.options__4.label" }
      ],
      "default": "inherit"
    },
        { "type": "header", "content": "t:shared.spacing.block_header" },
        { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
        { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
        { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
        { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
        { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.timeline_item.name" }]
}
{% endschema %}
