{% doc %}
  One trust badge: an icon, an optional pill, a heading and some text.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign has_link = false
  if s.link != blank
    assign has_link = true
  endif

  assign icon_source = s.icon_source
  if icon_source == blank
    if s.custom_svg != blank
      assign icon_source = 'svg'
    elsif s.icon_image != blank
      assign icon_source = 'image'
    else
      assign icon_source = 'icon'
    endif
  endif

  assign has_icon = false
  if icon_source == 'icon' and s.icon != blank and s.icon != 'none'
    assign has_icon = true
  elsif icon_source == 'image' and s.icon_image != blank
    assign has_icon = true
  elsif icon_source == 'svg' and s.custom_svg != blank
    assign has_icon = true
  endif

  capture icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0

  assign box_width = s.width | default: 0 | plus: 0
  assign box_height = s.height | default: 0 | plus: 0

  assign has_shape = false
  if s.shape != blank and s.shape != 'none'
    assign has_shape = true
  elsif s.shape == blank and s.icon_frame_style != blank and s.icon_frame_style != 'none'
    assign has_shape = true
  endif

  assign border_is_gradient = false
  if s.border_color contains 'gradient'
    assign border_is_gradient = true
  endif

  assign classes = 'badge-highlight icon-mark-host badge-highlight--' | append: s.alignment
  if s.hover != 'none'
    assign classes = classes | append: ' badge-highlight--hover-' | append: s.hover
  endif
  if border_is_gradient
    assign classes = classes | append: ' badge-highlight--gradient-border'
  endif

  assign inherit_scheme = s.inherit_color_scheme
  if inherit_scheme == nil
    assign inherit_scheme = true
  endif
  if inherit_scheme == false and s.color_scheme != blank
    assign classes = classes | append: ' color-scheme-container color-' | append: s.color_scheme
  endif
-%}

{%- capture badge_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  
  {%- if s.border_color != blank -%}
    {%- if border_is_gradient -%}
      --badge-border-paint: {{ s.border_color }};
    {%- else -%}
      --badge-border-color: {{ s.border_color }};
    {%- endif -%}
  {%- endif -%}

  --badge-icon-size: {{ icon_size }}px;
  {%- if s.icon_color != blank -%}--badge-icon-color: {{ s.icon_color }};{%- endif -%}
  {%- if box_width > 0 -%}--badge-width: {{ box_width }}px;{%- endif -%}
  {%- if box_height > 0 -%}--badge-height: {{ box_height }}px;{%- endif -%}
{%- endcapture -%}

{%- capture icon_mark_style -%}
  {%- render 'icon-mark', block: s, declarations: true, size: icon_size, shape_default: 'none' -%}
{%- endcapture -%}

<div
  class="{{ classes }}"
  data-block-spacing
  style="{{ badge_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>

  {%- if has_icon or has_shape -%}
    <div class="badge-highlight__icon icon-mark" style="{{ icon_mark_style | strip_newlines | strip }}">
      {% render 'icon-mark', block: s, size: icon_size, shape_default: 'none' %}
      {%- if icon_source == 'svg' and s.custom_svg != blank -%}
        <span class="badge-highlight__svg" aria-hidden="true">{{ s.custom_svg }}</span>
      {%- elsif icon_source == 'image' and s.icon_image != blank -%}
        <img
          class="badge-highlight__image"
          src="{{ s.icon_image | image_url: width: 160 }}"
          alt="{{ s.icon_image_alt | default: '' | escape }}"
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          loading="lazy"
        >
      {%- elsif has_icon -%}
        {% render 'icon', icon: s.icon, size: icon_size, class: 'badge-highlight__glyph' %}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="badge-highlight__body">
    {%- if s.pill != blank -%}
      <span
        class="badge-highlight__pill"
        style="
          {%- if s.pill_background != blank %}--pill-background: {{ s.pill_background }};{% endif -%}
          {%- if s.pill_color != blank %}--pill-color: {{ s.pill_color }};{% endif -%}
        "
      >
        {{ s.pill }}
      </span>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h3 class="badge-highlight__heading">
        {%- if has_link -%}
          <a class="badge-highlight__link" href="{{ s.link }}">{{ s.heading }}</a>
        {%- else -%}
          {{ s.heading }}
        {%- endif -%}
      </h3>
    {%- endif -%}

    {%- if s.text != blank -%}
      <div class="badge-highlight__text rte">{{ s.text }}</div>
    {%- endif -%}
  </div>
</div>


