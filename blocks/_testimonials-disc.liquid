{% doc %}
  The portrait disc on a testimonial card, written as custom properties the
  section folds into its own style attribute.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign line = s.thumb_border_style | default: 'dashed'
  assign width = 0
  assign paint = ''

  if line != 'none'
    assign width = s.thumb_border_width | default: 1 | plus: 0

    assign percent = s.thumb_border_opacity | default: 100 | plus: 0
    if s.thumb_border_color == blank
      assign paint = 'color-mix(in srgb, currentColor ' | append: percent | append: '%, transparent)'
    else
      assign alpha = percent | divided_by: 100.0
      assign paint = s.thumb_border_color | color_modify: 'alpha', alpha
    endif
  endif

  assign effect = section.settings.thumb_hover_effect | default: 'zoom_in'
  assign scale = s.thumb_hover_scale | default: 112 | plus: 0
  assign scale = scale | divided_by: 100.0
-%}
--tc-thumb-size: {{ s.thumb_size | default: 80 | plus: 0 }}px;
--tc-thumb-overhang: {{ s.thumb_overhang | default: 24 | plus: 0 }}px;
--tc-thumb-inset: {{ s.thumb_inset | default: 28 | plus: 0 }}px;
--tc-info-inset: {{ s.info_inset | default: 28 | plus: 0 }}px;
--tc-info-gap: {{ s.info_gap | default: 14 | plus: 0 }}px;
{%- if effect != 'none' -%}
  --tc-thumb-scale: {{ scale }};
{%- endif -%}
{%- if width > 0 -%}
  --tc-thumb-border-width: {{ width }}px;
  --tc-thumb-border-style: {{ line }};
  --tc-thumb-border-color: {{ paint }};
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.testimonials_disc.name",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "thumb_size",
      "label": "t:sections.testimonials.settings.thumb_size.label",
      "min": 48,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "thumb_overhang",
      "label": "t:sections.testimonials.settings.thumb_overhang.label",
      "info": "t:sections.testimonials.settings.thumb_overhang.info",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "thumb_inset",
      "label": "t:sections.testimonials.settings.thumb_inset.label",
      "info": "t:sections.testimonials.settings.thumb_inset.info",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "thumb_border_style",
      "label": "t:sections.testimonials.settings.thumb_border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.options.dashed"
        },
        {
          "value": "dotted",
          "label": "t:shared.border.style.options__3.label"
        }
      ],
      "default": "dashed"
    },
    {
      "type": "range",
      "id": "thumb_border_width",
      "label": "t:shared.border.thickness.label",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.thumb_border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "thumb_border_opacity",
      "label": "t:shared.border.opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.thumb_border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "thumb_border_color",
      "label": "t:shared.border.color.label",
      "default": "#0F2E2F",
      "visible_if": "{{ block.settings.thumb_border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "info_inset",
      "label": "t:sections.testimonials.settings.info_inset.label",
      "info": "t:sections.testimonials.settings.info_inset.info",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "info_gap",
      "label": "t:sections.testimonials.settings.info_gap.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "thumb_hover_scale",
      "label": "t:shared.image_effect.scale.label",
      "min": 100,
      "max": 150,
      "step": 1,
      "unit": "%",
      "default": 112,
      "visible_if": "{{ section.settings.thumb_hover_effect != 'none' }}"
    }
  ]
}
{% endschema %}
