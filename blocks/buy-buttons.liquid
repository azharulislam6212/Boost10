{% comment %}
  blocks/_product-buy-buttons.liquid — private.

  The one block that must never be removable. Everything else on this page is a
  preference; this is the reason the page exists.
{% endcomment %}

{%- liquid
  assign product = closest.product

  comment
    Declarations rather than the spacing snippet's own `style` attribute: a tag
    with two of them keeps the first and silently drops the second, which is how
    a padding slider ends up moving a value that never reaches the page.
  endcomment
  capture block_spacing
    render 'spacing', block: block.settings, declarations: true
  endcapture
-%}

{%- if product -%}
  <div
    class="block-buy-buttons"
    data-block-spacing
    style="{{ block_spacing | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    {% render 'buy-buttons',
       product: product,
       section: section,
       show_dynamic: block.settings.show_dynamic_checkout %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_buy_buttons.name",
  "tag": null,
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:sections.main_cart.settings.show_dynamic_checkout.label", "info": "t:sections.main_cart.settings.show_dynamic_checkout.info", "default": true },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        { "value": "desktop", "label": "t:shared.spacing.devices.options__1.label" },
        { "value": "mobile", "label": "t:shared.spacing.devices.options__2.label" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
