{% doc %}
  blocks/_showcase-rating.liquid — private to `blocks/_showcase-intro.liquid`. Chip size and colours live in base.css; the stars and score enter one after another with the theme's subheading animation.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign rating_max = s.rating_max
  assign rating_filled = s.rating_filled | at_most: rating_max
  assign rating_label = 'products.product.rating_html' | t: rating: rating_filled, max: rating_max
-%}

{%- capture rating_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
{%- endcapture -%}

<motion-effect
  class="showcase-intro__score"
  data-block-spacing
  style="{{ rating_style | strip_newlines | strip }}"
  {% render 'motion-attrs', kind: 'subheading', target: '.showcase-intro__chip, .showcase-intro__score-value', stagger: 80 %}
  {{ block.shopify_attributes }}
>
  <span class="showcase-intro__chips" role="img" aria-label="{{ rating_label | strip_html | escape }}">
    {%- for index in (1..rating_max) -%}
      <span class="showcase-intro__chip{% if index > rating_filled %} showcase-intro__chip--empty{% endif %}" aria-hidden="true">
        {% render 'icon', icon: 'star', size: 12, class: 'showcase-intro__chip-star' %}
      </span>
    {%- endfor -%}
  </span>

  {%- if s.score != blank -%}
    <span class="showcase-intro__score-value" aria-hidden="true">{{ s.score | escape }}</span>
  {%- endif -%}
</motion-effect>

{% schema %}
{
  "name": "t:blocks.showcase_rating.name",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "rating_max",
      "label": "t:blocks.rating_badge.settings.rating_max.label",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "rating_filled",
      "label": "t:blocks.showcase_rating.settings.rating_filled.label",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "score",
      "label": "t:blocks.showcase_rating.settings.score.label",
      "default": "4.9/5.00"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.showcase_rating.name"
    }
  ]
}
{% endschema %}
