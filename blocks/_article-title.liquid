{% doc %}
  blocks/_article-title.liquid — private.
{% enddoc %}

{%- liquid
  assign article = closest.article
  assign s = block.settings

  assign tag = s.heading_tag | default: 'h3'
  assign preset = s.preset | default: 'h5'
  assign clamp = s.max_lines | default: 0 | plus: 0
-%}

{%- capture title_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  {%- if clamp > 0 -%}--article-title-lines: {{ clamp }};{%- endif -%}
  {%- if s.text_color != blank -%}color: {{ s.text_color }};{%- endif -%}
{%- endcapture -%}

{%- if article -%}
  <{{ tag }}
    class="article-title-block block-text--{{ preset }}{% if clamp > 0 %} article-title-block--clamped{% endif %}"
    data-block-spacing
    style="{{ title_style | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    <a class="article-title-block__link" href="{{ article.url }}">{{ article.title | escape }}</a>
  </{{ tag }}>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.article_title.name",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "t:blocks.article_title.paragraph" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:blocks.article_title.settings.heading_tag.label",
      "info": "t:blocks.article_title.settings.heading_tag.info",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "t:shared.typography.preset.options__2.label" }
      ],
      "default": "h3"
    },
    {
      "type": "range",
      "id": "max_lines",
      "label": "t:blocks.article_title.settings.max_lines.label",
      "info": "t:blocks.article_title.settings.max_lines.info",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 2
    },

    { "type": "header", "content": "t:shared.typography.header" },
    {
      "type": "select",
      "id": "preset",
      "label": "t:shared.typography.preset.label",
      "info": "t:shared.typography.preset.info",
      "options": [
        { "value": "h2", "label": "t:shared.typography.preset.options__5.label" },
        { "value": "h3", "label": "t:shared.typography.preset.options__6.label" },
        { "value": "h4", "label": "t:shared.typography.preset.options__7.label" },
        { "value": "h5", "label": "t:shared.typography.preset.options__8.label" },
        { "value": "h6", "label": "t:shared.typography.preset.options__9.label" }
      ],
      "default": "h5"
    },
    { "type": "color", "id": "text_color", "label": "t:shared.text.label" },

    { "type": "header", "content": "t:shared.spacing.block_header" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
