{% comment %}
  blocks/collapsible.liquid

  A disclosure row. Renamed Collapsible Row in the editor; the file and the type
  keep their name so no template referencing `collapsible` breaks.

  ## Still a `<details>`

  The added settings — plus/minus or arrow, a left icon, disabling the accordion
  on one breakpoint — are all presentation. None of them is a reason to hand-roll
  the disclosure with a button and `aria-expanded`, which is the usual next step
  and the usual place accordions stop working without JavaScript.

  ## "Disable accordion" is CSS, not markup

  A merchant can turn the accordion off on desktop and keep it on mobile — FAQ
  content that should read as a plain article on a wide screen and collapse on a
  phone. That is `[open]` plus a CSS rule hiding the marker and forcing the
  content visible, applied at one breakpoint.

  It is *not* rendering a `<div>` at one width and a `<details>` at another.
  That would be two DOM structures for one block, which is the thing this
  refactor set out to remove, and it would also mean the disclosure state resets
  every time the viewport crosses the breakpoint.

  The `open` attribute is still set when the accordion is disabled, so the
  content is in the accessibility tree and findable by in-page search even
  though the toggle is hidden.
{% endcomment %}

{%- liquid
  assign heading = block.settings.heading
  assign accordion_desktop = block.settings.enable_accordion_desktop
  assign accordion_mobile = block.settings.enable_accordion_mobile

  # Open when the merchant asked for it, and also whenever the accordion is off
  # at either breakpoint — a row that cannot be opened must not start closed.
  assign is_open = block.settings.open_by_default
  if accordion_desktop == false or accordion_mobile == false
    assign is_open = true
  endif

  assign toggle = block.settings.toggle_style | default: 'plus'
-%}

{%- if heading != blank -%}
  <details
    class="collapsible collapsible--toggle-{{ toggle }} collapsible--icon-{{ block.settings.icon_position }}"
    data-collapsible
    data-accordion-desktop="{{ accordion_desktop }}"
    data-accordion-mobile="{{ accordion_mobile }}"
    {% if is_open %}open{% endif %}
    {% if block.settings.open_by_default %}data-default-open{% endif %}
    {% render 'spacing', block: block.settings %}
    {{ block.shopify_attributes }}
  >
    <summary class="collapsible__summary">
      {%- if block.settings.icon != 'none' and block.settings.icon_position == 'start' -%}
        {% render 'icon', icon: block.settings.icon, size: 18, class: 'collapsible__icon' %}
      {%- endif -%}

      <span class="collapsible__heading">{{ heading }}</span>

      {%- comment -%}
        The toggle is decorative. `<summary>` already conveys expanded state to
        a screen reader, so labelling this would announce the same thing twice.
      {%- endcomment -%}
      <span class="collapsible__toggle" aria-hidden="true">
        {%- if toggle == 'arrow' -%}
          {% render 'icon', icon: 'chevron-down', size: 14, class: 'collapsible__chevron' %}
        {%- else -%}
          <span class="collapsible__plus"></span>
        {%- endif -%}
      </span>
    </summary>

    {%- comment -%}
      The inner wrapper exists so height can be animated. Animating padding or
      height on `.collapsible__content` directly fights the `grid-template-rows`
      transition below and produces a visible jump at the end of the open.
    {%- endcomment -%}
    <div class="collapsible__panel">
      <div class="collapsible__content rte">
        {{ block.settings.content }}
        {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
      </div>
    </div>
  </details>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.collapsible.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:blocks.collapsible.settings.heading.label", "default": "How long does delivery take?" },
    { "type": "richtext", "id": "content", "label": "t:blocks.collapsible.settings.content.label" },
    { "type": "page", "id": "page", "label": "t:sections.main_product.blocks.collapsible.settings.page.label", "info": "t:sections.main_product.blocks.collapsible.settings.page.info" },

    { "type": "header", "content": "t:blocks.collapsible.headers.toggle" },
    {
      "type": "select", "id": "toggle_style", "label": "t:blocks.collapsible.settings.toggle_style.label",
      "options": [
        { "value": "plus", "label": "t:blocks.collapsible.settings.toggle_style.options__1.label" },
        { "value": "arrow", "label": "t:blocks.collapsible.settings.toggle_style.options__2.label" }
      ],
      "default": "plus"
    },
    {
      "type": "select", "id": "icon", "label": "t:blocks.icon_with_text.settings.icon.label",
      "options": [
        { "value": "none", "label": "t:shared.animation.animation_text.options__2.label" },
        { "value": "truck", "label": "t:blocks.icon_with_text.settings.icon.options__1.label" },
        { "value": "refresh", "label": "t:blocks.icon_with_text.settings.icon.options__2.label" },
        { "value": "lock", "label": "t:blocks.icon_with_text.settings.icon.options__3.label" },
        { "value": "info", "label": "t:blocks.icon_with_text.settings.icon.options__7.label" }
      ],
      "default": "none"
    },
    {
      "type": "select", "id": "icon_position", "label": "t:blocks.collapsible.settings.icon_position.label",
      "options": [
        { "value": "start", "label": "t:blocks.collapsible.settings.icon_position.options__1.label" },
        { "value": "none", "label": "t:blocks.collapsible.settings.icon_position.options__2.label" }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.icon != 'none' }}"
    },

    { "type": "header", "content": "t:blocks.collapsible.headers.behaviour" },
    { "type": "checkbox", "id": "open_by_default", "label": "t:sections.main_product.blocks.collapsible.settings.open_by_default.label", "default": false },
    { "type": "checkbox", "id": "enable_accordion_desktop", "label": "t:blocks.collapsible.settings.enable_accordion_desktop.label", "info": "t:blocks.collapsible.settings.enable_accordion_desktop.info", "default": true },
    { "type": "checkbox", "id": "enable_accordion_mobile", "label": "t:blocks.collapsible.settings.enable_accordion_mobile.label", "default": true },

    { "type": "header", "content": "t:shared.spacing.block_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.collapsible.name" }]
}
{% endschema %}