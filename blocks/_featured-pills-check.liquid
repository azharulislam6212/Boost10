  "name": "t:blocks.featured_pills_check.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.featured_pills_check.settings.label.label",
      "default": "Name one ingredient"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:blocks.featured_pills_check.settings.description.label",
      "info": "t:blocks.featured_pills_check.settings.description.info"
    },
    {
      "type": "checkbox",
      "id": "highlighted",
      "label": "t:blocks.featured_pills_check.settings.highlighted.label",
      "info": "t:blocks.featured_pills_check.settings.highlighted.info",
      "default": false
    },
    { "type": "url", "id": "link", "label": "t:shared.link.label" },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:blocks.group.settings.link_label.label",
      "info": "t:blocks.featured_pills_check.settings.link_label.info",
      "visible_if": "{{ block.settings.link != blank }}"
    },
    {
      "type": "checkbox",
      "id": "link_new_tab",
      "label": "t:blocks.group.settings.link_new_tab.label",
      "default": false,
      "visible_if": "{{ block.settings.link != blank }}"
    },

    { "type": "header", "content": "t:blocks.group.headers.layout" },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.group.settings.width.label",
      "info": "t:blocks.group.settings.width.info",
      "options": [
        { "value": "fill", "label": "t:blocks.group.settings.width.options__2.label" },
        { "value": "fit", "label": "t:blocks.group.settings.width.options__1.label" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:blocks.featured_pills_check.settings.gap.label",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:blocks.featured_pills_check.settings.gap_vertical.label",
