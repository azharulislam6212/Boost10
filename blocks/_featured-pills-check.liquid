      "id": "icon",
      "label": "t:blocks.subheading.settings.icon.label",
      "options": [
        { "value": "check", "label": "t:blocks.subheading.settings.icon.options__2.label" },
        { "value": "leaf", "label": "t:blocks.featured_pills_tab.icons.leaf" },
        { "value": "droplet", "label": "t:blocks.featured_pills_tab.icons.droplet" },
        { "value": "bolt", "label": "t:blocks.featured_pills_tab.icons.bolt" },
        { "value": "brain", "label": "t:blocks.featured_pills_tab.icons.brain" },
        { "value": "pulse", "label": "t:blocks.featured_pills_tab.icons.pulse" },
        { "value": "sparkle", "label": "t:blocks.featured_pills_tab.icons.sparkle" },
        { "value": "shield", "label": "t:blocks.icon_with_text.settings.icon.options__2" },
        { "value": "star", "label": "t:blocks.subheading.settings.icon.options__1.label" },
        { "value": "heart", "label": "t:blocks.subheading.settings.icon.options__3.label" },
