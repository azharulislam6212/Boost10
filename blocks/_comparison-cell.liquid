{% doc %}
  One answer in one column. Private — addable inside Comparison column only.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign kind = s.kind | default: 'text'

  assign has_mark = false
  if kind == 'check' or kind == 'cross' or kind == 'icon'
    assign has_mark = true
  endif

  assign palette = 'yes'
  if kind == 'cross'
    assign palette = 'no'
  endif

  case kind
    when 'check'
      assign glyph = 'check'
    when 'cross'
      assign glyph = 'close'
    when 'icon'
      assign glyph = s.icon | default: 'check'
    else
      assign glyph = ''
  endcase

  assign sr_text = s.sr_text | default: ''
  if sr_text == blank
    case kind
      when 'check'
        assign sr_text = 'sections.comparison_table.yes' | t
      when 'cross'
        assign sr_text = 'sections.comparison_table.no' | t
    endcase
  endif

  assign preset = s.preset | default: 'default'
  assign text_classes = 'comparison-cell__text block-text--' | append: preset
  if s.color == 'gradient'
    assign text_classes = text_classes | append: ' block-text--gradient'
  endif

  assign align = s.alignment | default: 'inherit'

  assign values = s.values | strip | newline_to_br | split: '<br />'
  assign per_alternative = false
  if values.size > 0
    assign per_alternative = true
  endif

  assign classes = 'comparison-cell comparison-cell--' | append: kind
  if align != 'inherit'
    assign classes = classes | append: ' comparison-cell--align-' | append: align
  endif
-%}

{%- capture cell_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  {%- if has_mark and per_alternative == false -%}
    {%- render 'comparison-mark-vars', palette: palette, block: s -%}
  {%- endif -%}
  {%- render 'block-typography', block: s -%}
{%- endcapture -%}

<div
  class="{{ classes }}"
  data-block-spacing
  data-comparison-cell
  data-comparison-kind="{{ kind }}"
  style="{{ cell_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {%- if per_alternative -%}
    {%- for line in values -%}
      {%- liquid
        assign value = line | strip
        assign token = value | downcase

        assign v_kind = 'text'
        if token == 'check' or token == 'yes'
          assign v_kind = 'check'
        elsif token == 'cross' or token == 'no'
          assign v_kind = 'cross'
        elsif value == blank or value == '-'
          assign v_kind = 'blank'
        endif

        assign v_palette = 'yes'
        assign v_glyph = 'check'
        assign v_sr = 'sections.comparison_table.yes' | t
        if v_kind == 'cross'
          assign v_palette = 'no'
          assign v_glyph = 'close'
          assign v_sr = 'sections.comparison_table.no' | t
        endif
        if s.sr_text != blank
          assign v_sr = s.sr_text
        endif

        assign v_style = ''
        if v_kind == 'check' or v_kind == 'cross'
          capture v_style
            render 'comparison-mark-vars', palette: v_palette, block: s
          endcapture
          assign v_style = v_style | strip_newlines | strip
        endif
      -%}
      <span
        class="comparison-cell__value"
        data-comparison-value="{{ forloop.index }}"
        {%- if v_style != blank %} style="{{ v_style }}"{% endif %}
      >
        {%- if v_kind == 'check' or v_kind == 'cross' -%}
          <span class="comparison-cell__mark" data-comparison-mark>
            {% render 'icon', icon: v_glyph, class: 'comparison-cell__glyph' %}
            <span class="visually-hidden" data-comparison-answer>{{ v_sr | escape }}</span>
          </span>
        {%- elsif v_kind == 'text' -%}
          <span class="{{ text_classes }}">{{ value | escape }}</span>
        {%- endif -%}
      </span>
    {%- endfor -%}
  {%- elsif has_mark -%}
    <span class="comparison-cell__mark" data-comparison-mark>
      {% render 'icon', icon: glyph, class: 'comparison-cell__glyph' %}
      {%- if sr_text != blank -%}
        <span class="visually-hidden" data-comparison-answer>{{ sr_text | escape }}</span>
      {%- endif -%}
    </span>
  {%- elsif kind == 'text' and s.text != blank -%}
    <span class="{{ text_classes }}">{{ s.text | escape }}</span>
  {%- endif -%}
</div>

