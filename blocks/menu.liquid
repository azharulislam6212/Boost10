{% doc %}
  A list of links, and nothing else.
{% enddoc %}

{%- liquid
  assign menu = block.settings.menu
  assign link_preset = block.settings.link_preset | default: 'paragraph'

  capture menu_spacing
    render 'spacing', block: block.settings, declarations: true
  endcapture
-%}

{%- if menu != blank -%}
  <div
    class="footer-menu menu-block"
    data-link-preset="{{ link_preset }}"
    data-block-spacing
    style="
      {%- if block.settings.text_color != blank %}--menu-color: {{ block.settings.text_color }};{% endif -%}
      {{- menu_spacing | strip -}}
    "
    {{ block.shopify_attributes }}
  >
    <ul class="footer-menu__list" role="list">
      {%- for link in menu.links -%}
        <li>
          <a
            class="footer-menu__link"
            href="{{ link.url }}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{- link.title -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.menu.name",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:blocks.menu.settings.menu.label",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "t:blocks.menu.headers.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.menu.settings.text_color.label"
    },
    {
      "type": "select",
      "id": "link_preset",
      "label": "t:blocks.menu.settings.link_preset.label",
      "options": [
        {
          "value": "paragraph",
          "label": "t:shared.presets.paragraph"
        },
        {
          "value": "h5",
          "label": "t:shared.presets.h5"
        },
        {
          "value": "h6",
          "label": "t:shared.presets.h6"
        }
      ],
      "default": "paragraph"
    },
        {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        { "value": "desktop", "label": "t:shared.spacing.devices.options__1.label" },
        { "value": "mobile", "label": "t:shared.spacing.devices.options__2.label" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.menu.name",
      "category": "t:categories.header"
    }
  ]
}
{% endschema %}
