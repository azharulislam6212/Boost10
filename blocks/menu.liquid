{% comment %}
  blocks/menu.liquid

  A list of links, and nothing else.
  

  It used to carry a heading, a heading preset, a background and an accordion
  toggle of its own. All four moved up to the Column, because that is where they
  were already being decided: a Column is the thing that collapses on a phone, it
  is the thing with a surface, and two places to set a heading meant a merchant
  could give one column two headings, or set a preset on the menu that the column
  overrode. One owner per decision.

  What is left is the menu, its link colour and its type preset — the things that
  are genuinely about the links.

  ## It is not a disclosure any more

  It was a `<details>` with its own summary. Now the Column is the disclosure and
  this is the content inside it, so the menu renders as a plain list — one
  summary per column rather than a summary inside a summary, which is what a
  nested `<details>` in a collapsed column actually produced on a phone.
{% endcomment %}

{%- liquid
  assign menu = block.settings.menu
  assign link_preset = block.settings.link_preset | default: 'paragraph'

  comment
    Declarations, merged into the one `style` attribute this element already
    has. `data-block-spacing` is written by hand below because the attribute —
    not the properties — is the selector base.css applies the padding through.
  endcomment
  capture menu_spacing
    render 'spacing', block: block.settings, declarations: true
  endcapture
-%}

{%- if menu != blank -%}
  <div
    class="footer-menu menu-block"
    data-link-preset="{{ link_preset }}"
    data-block-spacing
    style="
      {%- if block.settings.text_color != blank %}--menu-color: {{ block.settings.text_color }};{% endif -%}
      {{- menu_spacing | strip -}}
    "
    {{ block.shopify_attributes }}
  >
    <ul class="footer-menu__list" role="list">
      {%- for link in menu.links -%}
        <li>
          <a
            class="footer-menu__link"
            href="{{ link.url }}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{- link.title -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.menu.name",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:blocks.menu.settings.menu.label",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "t:blocks.menu.headers.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.menu.settings.text_color.label"
    },
    {
      "type": "select",
      "id": "link_preset",
      "label": "t:blocks.menu.settings.link_preset.label",
      "options": [
        {
          "value": "paragraph",
          "label": "t:shared.presets.paragraph"
        },
        {
          "value": "h5",
          "label": "t:shared.presets.h5"
        },
        {
          "value": "h6",
          "label": "t:shared.presets.h6"
        }
      ],
      "default": "paragraph"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.menu.name"
    }
  ]
}
{% endschema %}
