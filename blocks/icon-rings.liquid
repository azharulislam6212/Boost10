{% doc %}
  blocks/icon-rings.liquid — a centred grid of icon-ring boxes: full rows,
  then a short last row held in the middle. Built for a tab of Shop by category.
{% enddoc %}

{{ 'component-icon-ring.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = block.settings
-%}

{%- capture grid_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --icon-rings-columns: {{ s.columns_desktop }};
  --icon-rings-columns-tablet: {{ s.columns_tablet }};
  --icon-rings-columns-mobile: {{ s.columns_mobile }};
  --icon-rings-gap: {{ s.gap }}px;
  --icon-rings-gap-mobile: {{ s.gap_mobile }}px;
  {%- if s.box_background != blank -%}--icon-ring-box: {{ s.box_background }};{%- endif -%}
  {%- if s.disc_color != blank -%}--icon-ring-disc: {{ s.disc_color }};{%- endif -%}
  {%- if s.disc_hover_color != blank -%}--icon-ring-disc-hover: {{ s.disc_hover_color }};{%- endif -%}
  {%- if s.line_color != blank -%}--icon-ring-line: {{ s.line_color }};{%- endif -%}
{%- endcapture -%}

<div
  class="icon-rings{% if s.box_shadow == false %} icon-rings--flat{% endif %}"
  data-block-spacing
  data-motion-items
  style="{{ grid_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:blocks.icon_rings.name",
  "tag": null,
  "blocks": [
    {
      "type": "_icon-ring"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:shared.columns.header"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns.desktop.label",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 7
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:shared.columns.tablet.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "t:shared.columns.mobile.label",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:blocks.category_carousel.settings.gap_mobile.label",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:blocks.category_carousel.headers.card"
    },
    {
      "type": "color",
      "id": "box_background",
      "label": "t:blocks.icon_rings.settings.box_background.label",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "box_shadow",
      "label": "t:blocks.icon_rings.settings.box_shadow.label",
      "default": true
    },
    {
      "type": "color",
      "id": "disc_color",
      "label": "t:blocks.icon_rings.settings.disc_color.label",
      "default": "#E5F1EE"
    },
    {
      "type": "color",
      "id": "disc_hover_color",
      "label": "t:blocks.icon_rings.settings.disc_hover_color.label",
      "default": "#03D26F"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "t:blocks.icon_rings.settings.line_color.label",
      "default": "#0F2E2F"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.icon_rings.name",
      "category": "t:categories.collection",
      "blocks": [
        {
          "type": "_icon-ring",
          "settings": {
            "icon": "energy",
