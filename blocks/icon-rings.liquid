{% doc %}
  blocks/icon-rings.liquid — a centred grid of icon-ring boxes: full rows,
  then a short last row held in the middle. Built for a tab of Shop by category.
{% enddoc %}

{%- liquid
  assign s = block.settings
-%}

{%- capture grid_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --icon-rings-columns: {{ s.columns_desktop }};
  --icon-rings-columns-tablet: {{ s.columns_tablet }};
  --icon-rings-columns-mobile: {{ s.columns_mobile }};
  --icon-rings-gap: {{ s.gap }}px;
  --icon-rings-gap-mobile: {{ s.gap_mobile }}px;
  {%- if s.box_background != blank -%}--icon-ring-box: {{ s.box_background }};{%- endif -%}
  {%- if s.disc_color != blank -%}--icon-ring-disc: {{ s.disc_color }};{%- endif -%}
  {%- if s.disc_hover_color != blank -%}--icon-ring-disc-hover: {{ s.disc_hover_color }};{%- endif -%}
  {%- if s.line_color != blank -%}--icon-ring-line: {{ s.line_color }};{%- endif -%}
{%- endcapture -%}

<div
  class="icon-rings{% if s.box_shadow == false %} icon-rings--flat{% endif %}"
  data-block-spacing
  data-motion-items
  style="{{ grid_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
@layer components {
  .icon-rings {
    --icon-rings-cols: var(--icon-rings-columns-mobile, 2);
    --icon-rings-space: var(--icon-rings-gap-mobile, 12px);

    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--icon-rings-space);
    inline-size: 100%;
  }
  @media screen and (min-width: 750px) {
    .icon-rings {
      --icon-rings-cols: var(--icon-rings-columns-tablet, 4);
      --icon-rings-space: var(--icon-rings-gap, 24px);
    }
  }
  @media screen and (min-width: 990px) {
    .icon-rings {
      --icon-rings-cols: var(--icon-rings-columns, 7);
    }
  }
  .icon-rings > * {
    flex: 0 0 calc((100% - (var(--icon-rings-cols) - 1) * var(--icon-rings-space)) / var(--icon-rings-cols));
    min-inline-size: 0;
  }
  .icon-ring {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3.2rem 1.2rem;
    border-radius: 2.4rem;
    background-color: var(--icon-ring-box, #fff);
    box-shadow: var(--icon-ring-shadow, 0 4px 24px rgb(15 46 47 / 0.06), 0 1px 2px rgb(15 46 47 / 0.04));
    color: var(--color-heading);
    text-align: center;
    text-decoration: none;
    transition:
      box-shadow 500ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)),
      translate 500ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .icon-rings--flat .icon-ring {
    --icon-ring-shadow: none;
  }
  .icon-ring__mark {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 9.6rem;
    block-size: 9.6rem;
    flex: 0 0 auto;
  }
  .icon-ring__ring {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    stroke: var(--icon-ring-line, #0f2e2f);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    transition: rotate 1200ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .icon-ring__disc {
    display: grid;
    place-items: center;
    inline-size: 7.6rem;
    block-size: 7.6rem;
    border-radius: 50%;
    background-color: var(--icon-ring-disc, #e5f1ee);
    color: #161514;
    transition:
      background-color 500ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)),
      scale 500ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .icon-ring__disc .icon {
    --icon-size: 3.2rem;
  }
  .icon-ring__image {
    inline-size: 3.2rem;
    block-size: 3.2rem;
    object-fit: contain;
  }
  .icon-ring__badge {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    display: grid;
    place-items: center;
    inline-size: 2.4rem;
    block-size: 2.4rem;
    border-radius: 50%;
    background-color: var(--icon-ring-line, #0f2e2f);
    color: #fff;
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 300ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)),
      scale 500ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .icon-ring__badge svg {
    inline-size: 2.4rem;
    block-size: 2.4rem;
  }
  .icon-ring__connector {
    flex: 0 0 auto;
    inline-size: 3.4rem;
    block-size: 5.2rem;
    margin-block-start: -0.1rem;
    margin-inline-end: 2.8rem;
    stroke: var(--icon-ring-line, #0f2e2f);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .icon-ring__curve {
    stroke-dasharray: 0.6 5.9;
    transition: stroke-dashoffset 1200ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .icon-ring__label {
    margin-block-start: 1rem;
    font-size: 1.6rem;
    line-height: 1.5;
    color: #161514;
  }
  @media (hover: hover) {
    .icon-rings:not(.icon-rings--flat) .icon-ring--link:is(:hover, :focus-visible) {
      box-shadow: 0 16px 40px rgb(15 46 47 / 0.1), 0 2px 6px rgb(15 46 47 / 0.05);
      translate: 0 -4px;
    }
    .icon-ring--link:is(:hover, :focus-visible) .icon-ring__disc {
      background-color: var(--icon-ring-disc-hover, #03d26f);
      scale: 1.04;
    }
    .icon-ring--link:is(:hover, :focus-visible) .icon-ring__ring {
      rotate: 45deg;
    }
    .icon-ring--link:is(:hover, :focus-visible) .icon-ring__badge {
      opacity: 1;
      scale: 1;
    }
    .icon-ring--link:is(:hover, :focus-visible) .icon-ring__curve {
      stroke-dashoffset: -13;
    }
  }
  .icon-ring--link:focus-visible {
    outline: 2px solid var(--icon-ring-disc-hover, #03d26f);
    outline-offset: 2px;
  }
  @media screen and (max-width: 749px) {
    .icon-ring {
      padding: 2.4rem 0.8rem;
    }
    .icon-ring__label {
      font-size: 1.4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .icon-ring,
    .icon-ring__ring,
    .icon-ring__disc,
    .icon-ring__badge,
    .icon-ring__curve {
      transition: none;
    }
  }
}
{% endstylesheet %}

