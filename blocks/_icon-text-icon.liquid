{% doc %}
  blocks/_icon-text-icon.liquid — private, the icon of a nested Icon with text.
  An icon (a theme glyph or an upload) in a shape with an optional ring, on the
  shared Icon / Shape / Ring vocabulary of `icon-mark`.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign icon_size = s.icon_size | default: 20 | plus: 0

  assign has_icon = false
  if s.icon_source == 'image' and s.icon_image != blank
    assign has_icon = true
  elsif s.icon_source != 'image' and s.icon != blank and s.icon != 'none'
    assign has_icon = true
  endif

  assign dash_gap = s.ring_dash_gap | default: 2 | plus: 0
  assign ring_opacity = s.ring_opacity | default: 100 | divided_by: 100.0
-%}

{%- capture mark_style -%}
  {%- render 'icon-mark', block: s, declarations: true -%}
  --icon-text-icon-size: {{ icon_size }}px;
  --icon-ring-opacity: {{ ring_opacity }};
{%- endcapture -%}

<span
  class="icon-text-icon icon-mark"
  style="{{ mark_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {% render 'icon-mark', block: s, dash_gap: dash_gap %}
  {%- if has_icon -%}
    {%- if s.icon_source == 'image' -%}
      <img
        class="icon-text-icon__image"
        src="{{ s.icon_image | image_url: width: 96 }}"
        alt=""
        width="{{ icon_size }}"
        height="{{ icon_size }}"
        loading="lazy"
      >
    {%- else -%}
      {% render 'icon-goal', icon: s.icon, size: icon_size, class: 'icon-text-icon__glyph' %}
    {%- endif -%}
  {%- endif -%}
</span>

{% schema %}
{
  "name": "t:blocks.icon_text_icon.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon_source",
      "label": "t:blocks.subheading.settings.icon_source.label",
      "options": [
        { "value": "icon", "label": "t:blocks.subheading.settings.icon_source.options__2.label" },
        { "value": "image", "label": "t:blocks.subheading.settings.icon_source.options__3.label" }
      ],
      "default": "icon"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:blocks.subheading.settings.icon.label",
      "options": [
        { "value": "trust-pure", "label": "t:blocks.icon_text_icon.settings.icon.options__pure" },
        { "value": "trust-verified", "label": "t:blocks.icon_text_icon.settings.icon.options__verified" },
        { "value": "trust-tested", "label": "t:blocks.icon_text_icon.settings.icon.options__tested" },
        { "value": "trust-shipping", "label": "t:blocks.icon_text_icon.settings.icon.options__shipping" },
        { "value": "trust-save", "label": "t:blocks.icon_text_icon.settings.icon.options__save" },
        { "value": "star", "label": "t:blocks.subheading.settings.icon.options__1.label" },
        { "value": "check", "label": "t:blocks.subheading.settings.icon.options__2.label" },
        { "value": "heart", "label": "t:blocks.subheading.settings.icon.options__3.label" },
        { "value": "leaf", "label": "t:blocks.health_goal.settings.icon.options__leaf" },
        { "value": "shield", "label": "t:blocks.health_goal.settings.icon.options__shield" },
        { "value": "truck", "label": "t:blocks.icon_text_icon.settings.icon.options__truck" },
        { "value": "refresh", "label": "t:blocks.icon_text_icon.settings.icon.options__refresh" },
        { "value": "lock", "label": "t:blocks.icon_text_icon.settings.icon.options__lock" },
        { "value": "gift", "label": "t:blocks.icon_text_icon.settings.icon.options__gift" },
        { "value": "award", "label": "t:blocks.icon_text_icon.settings.icon.options__award" }
      ],
      "default": "trust-pure",
      "visible_if": "{{ block.settings.icon_source != 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "t:blocks.health_goal.settings.icon_image.label",
      "visible_if": "{{ block.settings.icon_source == 'image' }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "t:blocks.icon_text_icon.settings.icon_size.label",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:blocks.icon_text_icon.settings.icon_color.label"
    },
    {
      "type": "color",
      "id": "icon_hover_color",
      "label": "t:blocks.icon_text_icon.settings.icon_hover_color.label"
    },
    {
      "type": "header",
      "content": "t:blocks.feature_icon.headers.shape"
    },
    {
      "type": "select",
      "id": "shape",
      "label": "t:blocks.icon_text_icon.settings.shape.label",
      "options": [
        { "value": "none", "label": "t:shared.options.none" },
        { "value": "circle", "label": "t:shared.carousel.nav_shape.options__2.label" },
        { "value": "square", "label": "t:shared.carousel.nav_shape.options__3.label" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "shape_size",
      "label": "t:blocks.icon_text_icon.settings.shape_size.label",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ block.settings.shape != 'none' }}"
    },
    {
      "type": "range",
      "id": "shape_size_mobile",
      "label": "t:blocks.icon_text_icon.settings.shape_size_mobile.label",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ block.settings.shape != 'none' }}"
    },
    {
      "type": "range",
      "id": "shape_radius",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.shape == 'square' }}"
    },
    {
      "type": "color_background",
      "id": "fill_color",
      "label": "t:blocks.icon_text_icon.settings.fill_color.label",
      "visible_if": "{{ block.settings.shape != 'none' }}"
    },
    {
      "type": "color_background",
      "id": "fill_hover_color",
      "label": "t:blocks.icon_text_icon.settings.fill_hover_color.label",
      "visible_if": "{{ block.settings.shape != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.feature_icon.headers.ring"
    },
    {
      "type": "select",
      "id": "ring_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        { "value": "none", "label": "t:shared.options.none" },
        { "value": "solid", "label": "t:shared.options.solid" },
        { "value": "dashed", "label": "t:shared.options.dashed" }
      ],
      "default": "dashed",
      "visible_if": "{{ block.settings.shape != 'none' }}"
    },
    {
      "type": "range",
      "id": "ring_width",
      "label": "t:shared.border.thickness.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.shape != 'none' and block.settings.ring_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "ring_dash_gap",
      "label": "t:blocks.icon_text_icon.settings.ring_dash_gap.label",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2,
      "visible_if": "{{ block.settings.shape != 'none' and block.settings.ring_style == 'dashed' }}"
    },
    {
      "type": "color",
      "id": "ring_color",
      "label": "t:blocks.group.settings.border_color.label",
      "default": "#0F2E2F",
      "visible_if": "{{ block.settings.shape != 'none' and block.settings.ring_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "ring_opacity",
      "label": "t:blocks.icon_text_icon.settings.ring_opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ block.settings.shape != 'none' and block.settings.ring_style != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.icon_text_icon.name"
    }
  ]
}
{% endschema %}
