{% doc %}
  A custom button's own colours, written as the custom properties the pair
  folds into that button's style attribute.

  @param {boolean} [enabled] - Only paint when the button is set to Custom.
{% enddoc %}

{%- liquid
  assign s = block.settings

  if enabled
    if s.background != blank
      echo '--button-custom-background:' | append: s.background | append: ';'
    endif
    if s.text != blank
      echo '--button-custom-foreground:' | append: s.text | append: ';'
    endif
    if s.border != blank
      echo '--button-custom-border:' | append: s.border | append: ';'
    endif
    if s.hover_background != blank
      echo '--button-custom-hover-background:' | append: s.hover_background | append: ';'
    endif
    if s.hover_text != blank
      echo '--button-custom-hover-foreground:' | append: s.hover_text | append: ';'
    endif
    if s.hover_border != blank
      echo '--button-custom-hover-border:' | append: s.hover_border | append: ';'
    endif
  endif
-%}

{% schema %}
{
  "name": "t:blocks.button_colors.name",
  "tag": null,
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "t:blocks.button.settings.custom_background.label"
    },
    {
      "type": "color",
      "id": "text",
      "label": "t:blocks.button.settings.custom_text.label"
    },
    {
      "type": "color",
      "id": "border",
      "label": "t:blocks.button.settings.custom_border.label"
    },
    {
      "type": "color",
      "id": "hover_background",
      "label": "t:blocks.button.settings.custom_hover_background.label"
    },
    {
      "type": "color",
      "id": "hover_text",
      "label": "t:blocks.button.settings.custom_hover_text.label"
    },
    {
      "type": "color",
      "id": "hover_border",
      "label": "t:blocks.button.settings.custom_hover_border.label"
    }
  ]
}
{% endschema %}
