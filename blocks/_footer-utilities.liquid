{% doc %}
  A full-width row for the things a footer carries that are not links: contact
  details, the country and language pickers, the payment marks and the copyright.
{% enddoc %}

{%- liquid
  assign order = block.settings.column_order | default: 0 | plus: 0

  assign border_width = 0
  if block.settings.border_style == 'solid'
    assign border_width = block.settings.border_width | default: 1 | plus: 0
  endif

  assign background_paint = ''
  if block.settings.background_style == 'gradient'
    assign background_paint = block.settings.background_gradient | default: ''
  elsif block.settings.background_color != blank
    assign background_alpha = block.settings.background_opacity | default: 100 | plus: 0 | divided_by: 100.0
    assign background_paint = block.settings.background_color | color_modify: 'alpha', background_alpha
  endif

  assign scheme_class = ''
  if block.settings.inherit_color_scheme == false and block.settings.color_scheme != blank
    assign scheme_class = ' color-scheme-container color-' | append: block.settings.color_scheme
  endif

  capture utilities_spacing
    render 'spacing', block: block.settings, declarations: true
  endcapture

  capture utilities_children
    content_for 'blocks'
  endcapture
-%}

<div
  class="footer-utilities footer-utilities--{{ block.settings.panel_style | default: 'card' }}{{ scheme_class }}"
  data-align="{{ block.settings.alignment | default: 'space-between' }}"
  data-block-spacing
  style="
    --column-order: {{ order }};
    --utilities-gap-x: {{ block.settings.gap_horizontal | default: 32 }}px;
    --utilities-gap-y: {{ block.settings.gap_vertical | default: 20 }}px;
    --utilities-radius: {{ block.settings.border_radius | default: 24 }}px;
    {%- if border_width > 0 -%}
      --utilities-border-width: {{ border_width }}px;
      --utilities-border-color: {{ block.settings.border_color | default: 'currentColor' }};
    {%- endif -%}
    {%- if background_paint != '' -%}
      --utilities-background: {{ background_paint }};
    {%- endif -%}
    {%- if block.settings.backdrop_blur > 0 -%}
      --utilities-backdrop-blur: {{ block.settings.backdrop_blur }}px;
    {%- endif -%}
    {{- utilities_spacing | strip -}}
  "
  {{ block.shopify_attributes }}
>
  {{ utilities_children }}
</div>

{% schema %}
{
  "name": "t:blocks.footer_utilities.name",
  "tag": null,
  "blocks": [
    {
      "type": "_utility-item"
    },
    {
      "type": "_footer-contact"
    },
    {
      "type": "_footer-localization"
    },
    {
      "type": "_footer-bottom"
    },
    {
      "type": "group"
    },
    {
      "type": "menu"
    },
    {
      "type": "social-follow"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "divider"
    },
    {
      "type": "spacer"
    },
    {
      "type": "icon-with-text"
    },
    {
      "type": "custom-html"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "panel_style",
      "label": "t:sections.footer.settings.panel_style.label",
      "options": [
        {
          "value": "card",
          "label": "t:sections.footer.settings.panel_style.options__1.label"
        },
        {
          "value": "plain",
          "label": "t:sections.footer.settings.panel_style.options__2.label"
        }
      ],
      "default": "card"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.footer_utilities.settings.alignment.label",
      "options": [
        {
          "value": "space-between",
          "label": "t:blocks.footer_utilities.settings.alignment.options__1.label"
        },
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "space-between"
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "t:blocks.group.settings.gap_horizontal.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:blocks.group.settings.gap_vertical.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text",
      "id": "column_order",
      "label": "t:blocks.footer_column.settings.column_order.label",
      "info": "t:blocks.footer_column.settings.column_order.info",
      "default": "0"
    },
    {
      "type": "header",
      "content": "t:blocks.footer_column.headers.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:blocks.group.settings.inherit_color_scheme.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "t:blocks.card_content.settings.background_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:blocks.card_content.settings.background_style.options__1.label"
        },
        {
          "value": "gradient",
          "label": "t:blocks.card_content.settings.background_style.options__2.label"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.panel_style == 'card' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "t:blocks.card_content.settings.background_gradient.label",
      "visible_if": "{{ block.settings.panel_style == 'card' and block.settings.background_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:blocks.menu.settings.background_color.label",
      "visible_if": "{{ block.settings.panel_style == 'card' and block.settings.background_style == 'solid' }}"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "label": "t:blocks.card_content.settings.background_opacity.label",
      "visible_if": "{{ block.settings.panel_style == 'card' and block.settings.background_style == 'solid' }}",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "backdrop_blur",
      "label": "t:blocks.card_content.settings.backdrop_blur.label",
      "info": "t:blocks.card_content.settings.backdrop_blur.info",
      "visible_if": "{{ block.settings.panel_style == 'card' }}",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:blocks.group.settings.border_width.label",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.group.settings.border_color.label",
      "visible_if": "{{ block.settings.border_style == 'solid' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:blocks.group.settings.border_radius.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
