{% comment %}
  blocks/_footer-utilities.liquid

  A full-width row for the things a footer carries that are not links: contact
  details, the country and language pickers, the payment marks and the copyright.

  It is a Column with a different default shape. A Column divides a row into
  shares and collapses under a heading on a phone; a Utilities row spans the
  whole width, lays its children out end to end, and has a card of its own — the
  bar the design draws under the menu panel. Rather than adding four "unless this
  is the utilities one" branches to Column, it is its own block, and both stay
  simple.

  What goes inside is the merchant's choice: utility items, the localization
  pickers, the bottom bar, or any theme block. The contact addresses and the
  picker toggle used to be section settings, which meant the section decided both
  what they said and where they went. Here the section decides neither.
{% endcomment %}

{%- liquid
  assign order = block.settings.column_order | default: 0 | plus: 0

  assign border_width = 0
  if block.settings.border_style == 'solid'
    assign border_width = block.settings.border_width | default: 1 | plus: 0
  endif

  capture utilities_spacing
    render 'spacing', block: block.settings, declarations: true
  endcapture

  capture utilities_children
    content_for 'blocks'
  endcapture
-%}

<div
  class="footer-utilities footer-utilities--{{ block.settings.panel_style | default: 'card' }}"
  data-align="{{ block.settings.alignment | default: 'space-between' }}"
  data-block-spacing
  style="
    --column-order: {{ order }};
    --utilities-gap-x: {{ block.settings.gap_horizontal | default: 32 }}px;
    --utilities-gap-y: {{ block.settings.gap_vertical | default: 20 }}px;
    --utilities-radius: {{ block.settings.border_radius | default: 24 }}px;
    {%- if border_width > 0 -%}
      --utilities-border-width: {{ border_width }}px;
      --utilities-border-color: {{ block.settings.border_color | default: 'currentColor' }};
    {%- endif -%}
    {%- if block.settings.background_color != blank -%}
      --utilities-background: {{ block.settings.background_color }};
    {%- endif -%}
    {{- utilities_spacing | strip -}}
  "
  {{ block.shopify_attributes }}
>
  {{ utilities_children }}
</div>

{% schema %}
{
  "name": "t:blocks.footer_utilities.name",
  "tag": null,
  "blocks": [
    {
      "type": "_utility-item"
    },
    {
      "type": "_footer-contact"
    },
    {
      "type": "_footer-localization"
    },
    {
      "type": "_footer-bottom"
    },
    {
      "type": "group"
    },
    {
      "type": "menu"
    },
    {
      "type": "social-follow"
    },
    {
      "type": "social-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "divider"
    },
    {
      "type": "spacer"
    },
    {
      "type": "icon-with-text"
    },
    {
      "type": "custom-html"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "panel_style",
      "label": "t:sections.footer.settings.panel_style.label",
      "options": [
        {
          "value": "card",
          "label": "t:sections.footer.settings.panel_style.options__1.label"
        },
        {
          "value": "plain",
          "label": "t:sections.footer.settings.panel_style.options__2.label"
        }
