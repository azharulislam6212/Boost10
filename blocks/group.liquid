{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{% render 'group',
   children: children,
   settings: block.settings,
   shopify_attributes: block.shopify_attributes %}
   

{% schema %}
{
  "name": "t:blocks.group.name",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.group.settings.direction.label",
      "options": [
        {
          "value": "column",
          "label": "t:blocks.group.settings.direction.options__1.label"
        },
        {
          "value": "row",
          "label": "t:blocks.group.settings.direction.options__2.label"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:blocks.group.settings.stack_on_mobile.label",
      "info": "t:blocks.group.settings.stack_on_mobile.info",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "info": "t:blocks.group.settings.alignment.info",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:blocks.group.settings.position.label",
      "info": "t:blocks.group.settings.position.info",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.position.options__3.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "distribution",
      "label": "t:blocks.group.settings.distribution.label",
      "info": "t:blocks.group.settings.distribution.info",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.group.settings.distribution.options__1.label"
        },
        {
          "value": "space-between",
          "label": "t:blocks.group.settings.distribution.options__2.label"
        },
        {
          "value": "space-around",
          "label": "t:blocks.group.settings.distribution.options__3.label"
        },
        {
          "value": "space-evenly",
          "label": "t:blocks.group.settings.distribution.options__4.label"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:blocks.group.settings.gap.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "t:blocks.group.settings.gap_horizontal.label",
      "info": "t:blocks.group.settings.gap_horizontal.info",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:blocks.group.settings.gap_vertical.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.group.settings.width.label",
      "info": "t:blocks.group.settings.width.info",
      "options": [
        {
          "value": "fit",
          "label": "t:blocks.group.settings.width.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.group.settings.width.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:blocks.group.settings.width.options__3.label"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "t:blocks.group.settings.width_custom.label",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:blocks.group.settings.width_mobile.label",
      "options": [
        {
          "value": "fit",
          "label": "t:blocks.group.settings.width.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.group.settings.width.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:blocks.group.settings.width.options__3.label"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_custom_mobile",
      "label": "t:blocks.group.settings.width_custom.label",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:blocks.group.settings.height.label",
      "info": "t:blocks.group.settings.height.info",
      "options": [
        {
          "value": "fit",
          "label": "t:blocks.group.settings.height.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.group.settings.height.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:blocks.group.settings.height.options__3.label"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "height_custom",
      "label": "t:blocks.group.settings.height_custom.label",
      "min": 80,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 300,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "sticky_desktop",
      "label": "t:blocks.group.settings.sticky_desktop.label",
      "info": "t:blocks.group.settings.sticky_desktop.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:shared.background.media.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.background.media.options__1.label"
        },
        {
          "value": "image",
          "label": "t:shared.background.media.options__2.label"
        },
        {
          "value": "video",
          "label": "t:shared.background.media.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "t:shared.background.color.label",
      "info": "t:shared.background.color.info",
      "visible_if": "{{ block.settings.background_media == 'none' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:shared.background.image.label",
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:shared.background.image_mobile.label",
      "info": "t:shared.background.image_mobile.info",
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:shared.background.image_position.label",
      "info": "t:shared.background.image_position.info",
      "options": [
        {
          "value": "cover",
          "label": "t:shared.background.image_position.options__1.label"
        },
        {
          "value": "fit",
          "label": "t:shared.background.image_position.options__2.label"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "image_parallax",
      "label": "t:shared.background.image_parallax.label",
      "info": "t:shared.background.image_parallax.info",
      "default": false,
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "range",
      "id": "image_parallax_speed",
      "label": "t:shared.background.image_parallax_speed.label",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "%",
      "default": 15,
      "visible_if": "{{ block.settings.background_media == 'image' and block.settings.image_parallax }}",
      "info": "t:shared.background.image_parallax_speed.info"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:shared.background.video.label",
      "info": "t:shared.background.video.info",
      "visible_if": "{{ block.settings.background_media == 'video' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:shared.background.video_url.label",
      "info": "t:shared.background.video_url.info",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "visible_if": "{{ block.settings.background_media == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "t:shared.background.video_poster.label",
      "info": "t:shared.background.video_poster.info",
      "visible_if": "{{ block.settings.background_media == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:shared.background.video_position.label",
      "options": [
        {
          "value": "cover",
          "label": "t:shared.background.video_position.options__1.label"
        },
        {
          "value": "contain",
          "label": "t:shared.background.video_position.options__2.label"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.background_media == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:shared.background.video_loop.label",
      "default": true,
      "visible_if": "{{ block.settings.background_media == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "overlay_enabled",
      "label": "t:shared.background.overlay_enabled.label",
      "info": "t:shared.background.overlay_enabled.info",
      "default": false,
      "visible_if": "{{ block.settings.background_media != 'none' }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:shared.background.overlay_style.label",
      "info": "t:shared.background.overlay_style.info",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.background.overlay_style.options__1.label"
        },
        {
          "value": "gradient",
          "label": "t:shared.background.overlay_style.options__2.label"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.background_media != 'none' and block.settings.overlay_enabled }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:shared.background.overlay_color.label",
      "default": "#000000",
      "visible_if": "{{ block.settings.background_media != 'none' and block.settings.overlay_enabled and block.settings.overlay_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "label": "t:shared.background.overlay_gradient.label",
      "info": "t:shared.background.overlay_gradient.info",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 1) 100%)",
      "visible_if": "{{ block.settings.background_media != 'none' and block.settings.overlay_enabled and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:shared.background.overlay_opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ block.settings.background_media != 'none' and block.settings.overlay_enabled }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.group.settings.border_style.options__1.label"
        },
        {
          "value": "solid",
          "label": "t:blocks.group.settings.border_style.options__2.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:blocks.group.settings.border_width.label",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.group.settings.border_color.label",
      "visible_if": "{{ block.settings.border_style == 'solid' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:blocks.group.settings.border_radius.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.link"
    },
    {
      "type": "paragraph",
      "content": "t:blocks.group.paragraphs.link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.group.settings.link.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:blocks.group.settings.link_label.label",
      "info": "t:blocks.group.settings.link_label.info",
      "visible_if": "{{ block.settings.link != blank }}"
    },
    {
      "type": "checkbox",
      "id": "link_new_tab",
      "label": "t:blocks.group.settings.link_new_tab.label",
      "default": false,
      "visible_if": "{{ block.settings.link != blank }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.mobile_layout"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "label": "t:blocks.group.settings.swipe_on_mobile.label",
      "info": "t:blocks.group.settings.swipe_on_mobile.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "custom_column_width_mobile",
      "label": "t:blocks.group.settings.custom_column_width_mobile.label",
      "default": false,
      "visible_if": "{{ block.settings.swipe_on_mobile }}"
    },
    {
      "type": "range",
      "id": "column_width_mobile",
      "label": "t:blocks.group.settings.column_width_mobile.label",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 76,
      "visible_if": "{{ block.settings.swipe_on_mobile and block.settings.custom_column_width_mobile }}"
    },
    {
      "type": "range",
      "id": "gap_horizontal_mobile",
      "label": "t:blocks.group.settings.gap_horizontal.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_vertical_mobile",
      "label": "t:blocks.group.settings.gap_vertical.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text",
      "id": "column_order",
      "label": "t:blocks.group.settings.column_order.label",
      "info": "t:blocks.group.settings.column_order.info"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:blocks.group.settings.padding_device.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:blocks.group.settings.padding_device.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:blocks.group.settings.padding_device.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.group.name"
    }
  ]
}
{% endschema %}
