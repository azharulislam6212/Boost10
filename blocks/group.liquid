 {%- capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'group', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "t:blocks.group.name",
  "tag": null,
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select", "id": "direction", "label": "t:blocks.group.settings.direction.label",
      "options": [
        { "value": "column", "label": "t:blocks.group.settings.direction.options__1.label" },
        { "value": "row", "label": "t:blocks.group.settings.direction.options__2.label" }
      ],
      "default": "column"
    },
    {
      "type": "select", "id": "alignment", "label": "t:blocks.group.settings.alignment.label",
      "options": [
        { "value": "start", "label": "t:blocks.group.settings.alignment.options__1.label" },
        { "value": "center", "label": "t:blocks.group.settings.alignment.options__2.label" },
        { "value": "end", "label": "t:blocks.group.settings.alignment.options__3.label" }
      ],
      "default": "start"
    },
    { "type": "range", "id": "gap", "label": "t:blocks.group.settings.gap.label", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 16 },
    {
      "type": "select", "id": "width", "label": "t:blocks.group.settings.width.label",
      "options": [
        { "value": "full", "label": "t:blocks.group.settings.width.options__1.label" },
        { "value": "fixed", "label": "t:blocks.group.settings.width.options__2.label" }
      ],
      "default": "full"
    },
    { "type": "range", "id": "max_width", "label": "t:blocks.group.settings.max_width.label", "min": 200, "max": 1200, "step": 20, "unit": "px", "default": 600 },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label" },
    { "type": "header", "content": "t:shared.spacing.block_header" },
    { "type": "paragraph", "content": "t:shared.spacing.block_paragraph" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.group.name" }]
}
{% endschema %}
