{% comment %}
  blocks/image.liquid

  An image, through `snippets/image.liquid` — so it gets the full ratio list,
  mobile art direction and the srcset cap for free rather than reimplementing
  any of it.
{% endcomment %}

<motion-effect
  {% render 'motion-attrs', kind: 'image', block: block.settings, target: 'img' %}
  class="block-image block-image--{{ block.settings.alignment }}"
  style="--image-width: {{ block.settings.width }}%;"
  {% render 'spacing', block: block.settings %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="block-image__link">{%- endif -%}

  {% render 'image',
     image: block.settings.image,
     mobile_image: block.settings.image_mobile,
     alt: block.settings.alt,
     ratio: block.settings.ratio,
     mobile_ratio: block.settings.ratio_mobile,
     sizes: '(min-width: 990px) 50vw, 100vw',
     wrapper_class: 'block-image__media' %}

  {%- if block.settings.link != blank -%}</a>{%- endif -%}

  {%- if block.settings.caption != blank -%}
    <p class="block-image__caption">{{ block.settings.caption }}</p>
  {%- endif -%}
</motion-effect>

{% schema %}
{
  "name": "t:blocks.image.name",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:shared.image.label" },
    { "type": "image_picker", "id": "image_mobile", "label": "t:shared.image_mobile.label", "info": "t:shared.image_mobile.info" },
    { "type": "text", "id": "alt", "label": "t:blocks.image.settings.alt.label", "info": "t:blocks.image.settings.alt.info" },
    { "type": "url", "id": "link", "label": "t:shared.link.label" },
    { "type": "text", "id": "caption", "label": "t:blocks.image.settings.caption.label" },
    {
      "type": "select", "id": "ratio", "label": "t:blocks.image.settings.ratio.label",
      "options": [
        { "value": "adapt", "label": "t:blocks.image.settings.ratio.options__1.label" },
        { "value": "square", "label": "t:blocks.image.settings.ratio.options__2.label" },
        { "value": "portrait", "label": "t:blocks.image.settings.ratio.options__3.label" },
        { "value": "landscape", "label": "t:blocks.image.settings.ratio.options__4.label" },
        { "value": "wide", "label": "t:blocks.image.settings.ratio.options__5.label" },
        { "value": "tall", "label": "t:blocks.image.settings.ratio.options__6.label" },
        { "value": "long", "label": "t:blocks.image.settings.ratio.options__7.label" }
      ],
      "default": "adapt"
    },
    {
      "type": "select", "id": "ratio_mobile", "label": "t:blocks.image.settings.ratio_mobile.label", "info": "t:blocks.image.settings.ratio_mobile.info",
      "options": [
        { "value": "", "label": "t:blocks.image.settings.ratio_mobile.options__1.label" },
        { "value": "square", "label": "t:blocks.image.settings.ratio.options__2.label" },
        { "value": "portrait", "label": "t:blocks.image.settings.ratio.options__3.label" },
        { "value": "landscape", "label": "t:blocks.image.settings.ratio.options__4.label" },
        { "value": "tall", "label": "t:blocks.image.settings.ratio.options__6.label" },
        { "value": "long", "label": "t:blocks.image.settings.ratio.options__7.label" }
      ],
      "default": ""
    },
    { "type": "range", "id": "width", "label": "t:blocks.image.settings.width.label", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 100 },
    {
      "type": "select", "id": "alignment", "label": "t:blocks.group.settings.alignment.label",
      "options": [
        { "value": "start", "label": "t:blocks.group.settings.alignment.options__1.label" },
        { "value": "center", "label": "t:blocks.group.settings.alignment.options__2.label" },
        { "value": "end", "label": "t:blocks.group.settings.alignment.options__3.label" }
      ],
      "default": "start"
    },
    { "type": "header", "content": "t:shared.animation.header" },
    {
      "type": "select", "id": "animation_image", "label": "t:shared.animation.animation_image.label",
      "options": [
        { "value": "inherit", "label": "t:shared.animation.animation_image.options__1.label" },
        { "value": "none", "label": "t:shared.animation.animation_image.options__2.label" },
        { "value": "fade-in", "label": "t:shared.animation.animation_image.options__3.label" },
        { "value": "zoom-in", "label": "t:shared.animation.animation_image.options__7.label" },
        { "value": "reveal-up", "label": "t:shared.animation.animation_image.options__11.label" }
      ],
      "default": "inherit"
    },
    { "type": "header", "content": "t:shared.spacing.block_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.image.name" }]
}
{% endschema %}
