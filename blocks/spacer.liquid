{% doc %}
  Vertical space.
{% enddoc %}

<div
  class="block-spacer
    {%- if block.settings.show_divider %} block-spacer--divider{% endif -%}
    {%- if block.settings.divider_mobile_only %} block-spacer--divider-mobile{% endif -%}"
  style="--spacer-height: {{ block.settings.height }}px; --spacer-height-mobile: {{ block.settings.height_mobile | default: block.settings.height }}px;"
  aria-hidden="true"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "t:blocks.spacer.name",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "t:blocks.spacer.settings.height.label",
      "min": 4,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "t:blocks.spacer.settings.height_mobile.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.spacer.name",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
