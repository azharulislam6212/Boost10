{% doc %}
  One panel in a **Tabs** block, and the button that opens it.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign fallback_label = 'sections.tabs.tab' | t
  assign label = s.label | default: fallback_label

  assign has_icon = false
  if s.icon_source == 'icon' and s.icon != blank
    assign has_icon = true
  endif

  capture icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0

  assign gap_block = s.gap_vertical | default: 24 | plus: 0
  assign gap_block_mobile = s.gap_vertical_mobile | default: gap_block | plus: 0

  assign pill = s.pill
-%}

{%- capture pill_style -%}
  {%- if s.pill_background != blank -%}
    --tabs-tab-pill-background: {{ s.pill_background }};
  {%- endif -%}
  {%- if s.pill_color != blank -%}
    --tabs-tab-pill-color: {{ s.pill_color }};
  {%- endif -%}
{%- endcapture -%}

{%- capture panel_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --tab-content-gap: {{ gap_block }}px;
  --tab-content-gap-mobile: {{ gap_block_mobile }}px;
{%- endcapture -%}

{%- capture tab_content -%}
  {%- if has_icon -%}
    <span class="tabs__tab-icon">{% render 'icon', icon: s.icon, size: icon_size %}</span>
  {%- endif -%}
  <span class="tabs__tab-label">
    {{- label | escape -}}
  </span>

  {%- if pill != blank -%}
    <span class="tabs__tab-pill" style="{{ pill_style | strip_newlines | strip }}" aria-hidden="true">
      {{- pill | escape -}}
    </span>
  {%- endif -%}
{%- endcapture -%}

{%- assign panel_id = 'Tab-' | append: block.id -%}
{%- render 'tab-button', panel_id: panel_id, content: tab_content, selected: s.selected -%}
<div
  class="tabs__panel"
  role="tabpanel"
  id="{{ panel_id }}"
  aria-labelledby="{{ panel_id }}-tab"
  data-tab-panel
  tabindex="0"
  data-block-spacing
  style="{{ panel_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  <motion-effect
    class="tabs__panel-content"
    {% render 'motion-attrs', kind: 'text', block: s, children: true, duration: 1000 %}
  >
    {% content_for 'blocks' %}
  </motion-effect>
</div>

{% schema %}
{
  "name": "t:blocks.tab.name",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.tab.settings.label.label",
      "info": "t:blocks.tab.settings.label.info",
      "default": "Tab"
    },
    {
      "type": "text",
      "id": "pill",
      "label": "t:blocks.tab.settings.pill.label",
      "info": "t:blocks.tab.settings.pill.info"
    },
    {
      "type": "color",
      "id": "pill_background",
      "label": "t:blocks.tab.settings.pill_background.label",
      "visible_if": "{{ block.settings.pill != blank }}"
    },
    {
      "type": "color",
      "id": "pill_color",
      "label": "t:blocks.tab.settings.pill_color.label",
      "visible_if": "{{ block.settings.pill != blank }}"
    },
    {
      "type": "checkbox",
      "id": "selected",
      "label": "t:blocks.tab.settings.selected.label",
      "info": "t:blocks.tab.settings.selected.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:blocks.group.settings.gap_vertical.label",
      "info": "t:blocks.tab.settings.gap_vertical.info",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_vertical_mobile",
      "label": "t:blocks.image_card.settings.gap_vertical_mobile.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:blocks.subheading.headers.icon"
    },
    {
      "type": "select",
      "id": "icon_source",
      "label": "t:blocks.subheading.settings.icon_source.label",
      "info": "t:blocks.tab.settings.icon_source.info",
      "options": [
        {
          "value": "none",
          "label": "t:shared.none.label"
        },
        {
          "value": "icon",
          "label": "t:blocks.subheading.settings.icon_source.options__2.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:blocks.subheading.settings.icon.label",
      "options": [
        {
          "value": "star",
          "label": "t:blocks.subheading.settings.icon.options__1.label"
        },
        {
          "value": "check",
          "label": "t:blocks.subheading.settings.icon.options__2.label"
        },
        {
          "value": "heart",
          "label": "t:blocks.subheading.settings.icon.options__3.label"
        },
        {
          "value": "tag",
          "label": "t:blocks.subheading.settings.icon.options__4.label"
        },
        {
          "value": "truck",
          "label": "t:blocks.subheading.settings.icon.options__5.label"
        },
        {
          "value": "refresh",
          "label": "t:blocks.subheading.settings.icon.options__6.label"
        },
        {
          "value": "lock",
          "label": "t:blocks.subheading.settings.icon.options__7.label"
        },
        {
          "value": "clock",
          "label": "t:blocks.subheading.settings.icon.options__8.label"
        },
        {
          "value": "location",
          "label": "t:blocks.subheading.settings.icon.options__9.label"
        },
        {
          "value": "mail",
          "label": "t:blocks.subheading.settings.icon.options__10.label"
        },
        {
          "value": "note",
          "label": "t:blocks.subheading.settings.icon.options__11.label"
        },
        {
          "value": "info",
          "label": "t:blocks.subheading.settings.icon.options__12.label"
        }
      ],
      "default": "note",
      "visible_if": "{{ block.settings.icon_source == 'icon' }}"
    },
    {
      "type": "select",
      "id": "icon_size",
      "label": "t:blocks.subheading.settings.icon_size.label",
      "options": [
        {
          "value": "extra_small",
          "label": "t:shared.icon_size.options__1.label"
        },
        {
          "value": "small",
          "label": "t:shared.icon_size.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:shared.icon_size.options__3.label"
        },
        {
          "value": "large",
          "label": "t:shared.icon_size.options__4.label"
        },
        {
          "value": "extra_large",
          "label": "t:shared.icon_size.options__5.label"
        },
        {
          "value": "custom",
          "label": "t:shared.icon_size.options__6.label"
        }
      ],
      "default": "medium",
      "visible_if": "{{ block.settings.icon_source == 'icon' }}"
    },
    {
      "type": "range",
      "id": "icon_size_custom",
      "label": "t:shared.icon_size.custom.label",
      "info": "t:shared.icon_size.custom.info",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.icon_source == 'icon' and block.settings.icon_size == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
      "type": "select",
      "id": "animation_text",
      "label": "t:shared.animation.animation_text.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_text.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_text.options__2.label"
        },
        {
          "value": "fade-in",
          "label": "t:shared.animation.animation_text.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_text.options__4.label"
        },
        {
          "value": "slide-up",
          "label": "t:shared.animation.animation_text.options__5.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.tab.name",
      "category": "t:categories.layout",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "preset": "paragraph"
          }
        }
      ]
    }
  ]
}
{% endschema %}
