{% doc %}
  One panel in a **Tabs** block, and the button that opens it.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign fallback_label = 'sections.tabs.tab' | t
  assign label = s.label | default: fallback_label

  assign has_icon = false
  if s.icon_source == 'icon' and s.icon != blank
    assign has_icon = true
  endif

  capture icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0

  assign gap_block = s.gap_vertical | default: 24 | plus: 0
  assign gap_block_mobile = s.gap_vertical_mobile | default: gap_block | plus: 0

  assign preset = s.preset | default: 'default'

  assign label_classes = 'tabs__tab-label block-text--' | append: preset
  if s.color == 'gradient'
    assign label_classes = label_classes | append: ' block-text--gradient'
  endif

  assign pill = s.pill
-%}

{%- capture label_style -%}
  {%- render 'block-typography', block: s -%}
{%- endcapture -%}

{%- capture pill_style -%}
  {%- if s.pill_background != blank -%}
    --tabs-tab-pill-background: {{ s.pill_background }};
  {%- endif -%}
  {%- if s.pill_color != blank -%}
    --tabs-tab-pill-color: {{ s.pill_color }};
  {%- endif -%}
{%- endcapture -%}

{%- capture panel_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --tab-content-gap: {{ gap_block }}px;
  --tab-content-gap-mobile: {{ gap_block_mobile }}px;
{%- endcapture -%}

<div
  class="tabs__panel"
  role="tabpanel"
  id="Tab-{{ block.id }}"
  data-tab-label="{{ label | escape }}"

  {% if s.selected %}data-tab-selected{% endif %}
  tabindex="0"
  data-block-spacing
  style="{{ panel_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  <template data-tab-button>
    {%- if has_icon -%}
      <span class="tabs__tab-icon">{% render 'icon', icon: s.icon, size: icon_size %}</span>
    {%- endif -%}
    <span class="{{ label_classes }}" style="{{ label_style | strip_newlines | strip }}">
      {{- label | escape -}}
    </span>

    {%- if pill != blank -%}
      <span class="tabs__tab-pill" style="{{ pill_style | strip_newlines | strip }}" aria-hidden="true">
        {{- pill | escape -}}
      </span>
    {%- endif -%}
  </template>

  <motion-effect
    class="tabs__panel-content"
    {% render 'motion-attrs', kind: 'text', block: s, children: true, duration: 1000 %}
  >
    {% content_for 'blocks' %}
  </motion-effect>
</div>

