{% comment %}
  blocks/_product-variant-picker.liquid — private.

  Private because it owns variant state. Two pickers on one page would each
  dispatch `variant:change` and the gallery would follow whichever fired last.
{% endcomment %}

{%- liquid
  assign product = closest.product
-%}

{%- if product and product.has_only_default_variant == false -%}
  <div {{ block.shopify_attributes }}>
    {% render 'variant-picker', product: product, section: section %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_variant_picker.name",
  "tag": null,
  "settings": [
         {
      "type": "paragraph",
      "content": "t:sections.all.common.displays_inventory_from_parent_product"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.variant_selector.settings.title.label",
      "default": "Variant selector",
      "info": "t:sections.variant_selector.settings.title.info"
    },
    {
      "type": "select",
      "id": "size_options_picker_type",
      "label": "t:sections.variant_selector.settings.size_options_picker_type.label",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:sections.variant_selector.settings.size_options_picker_type.options__1_dropdowns.label"
        },
        {
          "value": "buttons",
          "label": "t:sections.variant_selector.settings.size_options_picker_type.options__2_buttons.label"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "select",
      "id": "options_picker_type",
      "label": "t:sections.variant_selector.settings.variant_options_picker_type.label",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:sections.variant_selector.settings.variant_options_picker_type.options__1_dropdowns.label"
        },
        {
          "value": "buttons",
          "label": "t:sections.variant_selector.settings.variant_options_picker_type.options__2_buttons.label"
        }
      ],
      "default": "buttons"
    },
        {
        "type": "select",
        "id": "swatches_type",
        "label": "t:settings_schema.product_cards.settings.swatches_type.label",
        "options": [
          {
            "value": "theme",
            "label": "t:settings_schema.product_cards.settings.swatches_type.options__1.label"
          },
          {
            "value": "native",
            "label": "t:settings_schema.product_cards.settings.swatches_type.options__2.label"
          },
          {
            "value": "none",
            "label": "t:settings_schema.product_cards.settings.swatches_type.options__3.label"
          }
        ],
        "default": "theme"
      },
            {
        "type": "select",
        "id": "swatch_shape",
        "label": "t:settings_schema.product_cards.settings.swatch_shape.label",
        "options": [
          {
            "value": "circle",
            "label": "t:settings_schema.product_cards.settings.swatch_shape.options__1.label"
          },
          {
            "value": "round",
            "label": "t:settings_schema.product_cards.settings.swatch_shape.options__2.label"
          },
          {
            "value": "portrait",
            "label": "t:settings_schema.product_cards.settings.swatch_shape.options__3.label"
          }
        ],
        "default": "circle"
      },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:sections.all.common.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.label"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:sections.all.spacing.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:sections.all.spacing.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:sections.all.spacing.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:sections.all.spacing.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
