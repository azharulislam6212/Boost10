{% doc %}
  A follow row: one link per social account, each pasted into this block.
{% enddoc %}

{%- liquid
  assign handles = 'facebook,instagram,youtube,tiktok,x,threads,linkedin,bluesky,snapchat,pinterest,tumblr,vimeo'
  assign handles = handles | split: ','

  capture icon_px
    render 'icon-size', size: block.settings.icon_size, custom: block.settings.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0
-%}

{%- capture social_styles -%}
  {%- if block.settings.color != blank -%}
    --social-color: {{ block.settings.color }};
  {%- endif -%}
  --social-icon-size: {{ icon_size }}px;
  {%- if block.settings.icon_color != blank -%}
    --social-icon-color: {{ block.settings.icon_color }};
  {%- endif -%}
  {%- if block.settings.icon_background_color != blank -%}
    --social-icon-bg: {{ block.settings.icon_background_color }};
  {%- endif -%}
  {%- if block.settings.icon_hover_color != blank -%}
    --social-icon-hover: {{ block.settings.icon_hover_color }};
  {%- endif -%}
  {%- render 'spacing', block: block.settings, declarations: true -%}
{%- endcapture -%}

<div
  class="social-links"
  data-align="{{ block.settings.alignment | default: 'left' }}"
  data-icon-style="{{ block.settings.icon_background | default: 'solid' }}"
  data-block-spacing
  style="{{ social_styles | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="social-links__heading">{{ block.settings.heading }}</p>
  {%- endif -%}

  <ul class="social-links__list" role="list">
    {%- for handle in handles -%}
      {%- liquid
        assign block_key = 'social_' | append: handle

        assign url = block.settings[block_key]

        assign platform = handle | capitalize
        assign label = 'general.share.share_on' | t: platform: platform
      -%}

      {%- if url != blank -%}
        <li class="social-links__item">
          <a
            class="social-links__link"
            href="{{ url }}"
            target="_blank"
            rel="noopener"
            aria-label="{{ label | escape }}"
          >
            {% render 'icon', icon: handle, size: icon_size %}
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}

    {%- if block.settings.social_custom != blank -%}
      <li class="social-links__item">
        <a
          class="social-links__link"
          href="{{ block.settings.social_custom }}"
          target="_blank"
          rel="noopener"
          aria-label="{{ block.settings.social_custom_label | default: shop.name | escape }}"
        >
          {% render 'icon', icon: 'external', size: icon_size %}
        </a>
      </li>
    {%- endif -%}
  </ul>
</div>

