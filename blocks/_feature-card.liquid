{% doc %}
  blocks/_feature-card.liquid — private to `sections/feature-cards.liquid`.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign align = s.alignment
  assign min_height = s.min_height

  assign border_line = s.border_style
  assign border_width = 0
  assign border_paint = ''

  if border_line != 'none'
    assign border_width = s.border_thickness

    assign border_percent = s.border_opacity
    if s.border_color == blank
      assign border_paint = 'color-mix(in srgb, currentColor ' | append: border_percent | append: '%, transparent)'
    else
      assign border_alpha = border_percent | divided_by: 100.0
      assign border_paint = s.border_color | color_modify: 'alpha', border_alpha
    endif
  endif

  assign background_paint = ''
  if s.background_color != blank
    assign background_alpha = s.background_opacity
    assign background_alpha = background_alpha | divided_by: 100.0
    assign background_paint = s.background_color | color_modify: 'alpha', background_alpha
  endif

  assign has_media = true
  assign has_placeholder = false
  if s.hover_image == blank
    assign has_placeholder = true
  endif

  assign image_effect = s.hover_image_effect

  assign drift_speed = s.hover_image_parallax_speed
  if drift_speed < 10
    assign drift_speed = 10
  endif
  if drift_speed > 50
    assign drift_speed = 50
  endif
  assign drift_speed = drift_speed | divided_by: 100.0

  assign layer_tag = 'div'
  if image_effect == 'drift'
    assign layer_tag = 'parallax-media'
  endif

  assign overlay_paint = ''
  assign overlay_tint = s.overlay_color | default: '#000000'
  if overlay_tint != blank
    assign overlay_alpha = s.overlay_opacity
    assign overlay_alpha = overlay_alpha | divided_by: 100.0
    assign overlay_paint = overlay_tint | color_modify: 'alpha', overlay_alpha
  endif

  assign hover_text = s.hover_text_color | default: '#FFFFFF'

  assign card_classes = 'feature-card feature-card--align-' | append: align
  if has_media
    assign card_classes = card_classes | append: ' feature-card--has-media'
  endif
  if has_placeholder
    assign card_classes = card_classes | append: ' feature-card--placeholder-media'
  endif
  if hover_text != ''
    assign card_classes = card_classes | append: ' feature-card--hover-text'
  endif

  assign card_sizes = '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 90vw'
-%}

{%- capture card_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --feature-card-gap: {{ s.gap }}px;
  --feature-card-align: {{ align }};
  --feature-card-radius: {{ s.border_radius }}px;
  --feature-card-radius-mobile: {{ s.border_radius_mobile }}px;
  {%- if min_height > 0 -%}
    --feature-card-min-height: {{ min_height }}px;
  {%- endif -%}
  {%- if border_width > 0 -%}
    --feature-card-border-width: {{ border_width }}px;
    --feature-card-border-style: {{ border_line }};
    --feature-card-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if background_paint != '' -%}
    --feature-card-background: {{ background_paint }};
  {%- endif -%}
  {%- if overlay_paint != '' -%}
    --feature-card-overlay: {{ overlay_paint }};
  {%- endif -%}
  {%- if hover_text != '' -%}
    --feature-card-hover-text: {{ hover_text }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="{{ card_classes }}"
  data-block-spacing
  style="{{ card_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>

  <div class="feature-card__media" aria-hidden="true">

    <{{ layer_tag }}
      class="feature-card__layer feature-card__layer--{{ image_effect | replace: '_', '-' }}"
      {% if image_effect == 'drift' %}data-speed="{{ drift_speed }}"{% endif %}
    >
      {% render 'image',
         image: s.hover_image,
         alt: '',
         class: 'feature-card__image',
         placeholder: 'hero-apparel-1',
         sizes: card_sizes %}
    </{{ layer_tag }}>
  </div>

  <div class="feature-card__inner">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.feature_card.name",
  "tag": null,
  "blocks": [
    {
      "type": "_feature-title"
    },
    {
      "type": "_feature-icon"
    },
    {
      "type": "_feature-text"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:blocks.article_card.settings.gap.label",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "t:blocks.feature_card.settings.min_height.label",
      "min": 0,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "t:blocks.feature_card.headers.hover"
    },
    {
      "type": "image_picker",
      "id": "hover_image",
      "label": "t:blocks.feature_card.settings.hover_image.label"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:shared.background.overlay_color.label",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:shared.background.overlay_opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "select",
      "id": "hover_image_effect",
      "label": "t:shared.image_effect.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "zoom_in",
          "label": "t:shared.image_effect.options__2.label"
        },
        {
          "value": "zoom_out",
          "label": "t:shared.image_effect.options__3.label"
        },
        {
          "value": "drift",
          "label": "t:shared.image_effect.options__4.label"
        }
      ],
      "default": "zoom_in"
    },
    {
      "type": "range",
      "id": "hover_image_parallax_speed",
      "label": "t:shared.image_effect.speed.label",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ block.settings.hover_image_effect == 'drift' }}"
    },
    {
      "type": "color",
      "id": "hover_text_color",
      "label": "t:blocks.feature_card.settings.hover_text_color.label",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:shared.appearance.background_color.label"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "label": "t:sections.feature_cards.settings.panel_background_opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.background_color != blank }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:shared.border.style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.options.dashed"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "t:shared.border.thickness.label",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "t:shared.border.opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:shared.border.color.label",
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius_mobile",
      "label": "t:shared.corners.radius_mobile.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.feature_card.name",
      "category": "t:categories.text",
      "blocks": [
        {
          "type": "_feature-title"
        },
        {
          "type": "_feature-icon"
        },
        {
          "type": "_feature-text"
        }
      ]
    }
  ]
}
{% endschema %}
