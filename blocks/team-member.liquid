{% comment %}
  blocks/team-member.liquid

  One person.

  The photo carries empty alt text and the name sits beside it as real text. A
  photograph captioned with the same name it sits next to is announced twice, and
  "photo of Priya Nair, Priya Nair, Head of Design" is what that sounds like.
{% endcomment %}

<div class="team-member" {% render 'spacing', block: block.settings %} {{ block.shopify_attributes }}>
  {%- if block.settings.image != blank -%}
    {% render 'image',
       image: block.settings.image,
       alt: '',
       ratio: block.settings.image_ratio,
       sizes: '(min-width: 990px) 25vw, 50vw',
       wrapper_class: 'team-member__media' %}
  {%- endif -%}

  <div class="team-member__body">
    {%- if block.settings.name != blank -%}
      <p class="team-member__name">{{ block.settings.name }}</p>
    {%- endif -%}

    {%- if block.settings.role != blank -%}
      <p class="team-member__role">{{ block.settings.role }}</p>
    {%- endif -%}

    {%- if block.settings.bio != blank -%}
      <div class="team-member__bio rte">{{ block.settings.bio }}</div>
    {%- endif -%}

    {%- if block.settings.link != blank and block.settings.link_label != blank -%}
      <a class="team-member__link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.team_member.name",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:shared.image.label" },
    {
      "type": "select", "id": "image_ratio", "label": "t:blocks.image.settings.ratio.label",
      "options": [
        { "value": "square", "label": "t:blocks.image.settings.ratio.options__2.label" },
        { "value": "portrait", "label": "t:blocks.image.settings.ratio.options__3.label" },
        { "value": "tall", "label": "t:blocks.image.settings.ratio.options__6.label" }
      ],
      "default": "portrait"
    },
    { "type": "text", "id": "name", "label": "t:blocks.team_member.settings.name.label", "default": "Priya Nair" },
    { "type": "text", "id": "role", "label": "t:blocks.testimonial.settings.role.label", "default": "Head of Design" },
    { "type": "richtext", "id": "bio", "label": "t:blocks.team_member.settings.bio.label" },
    { "type": "url", "id": "link", "label": "t:shared.link.label" },
    { "type": "text", "id": "link_label", "label": "t:blocks.button.settings.label.label" },
        { "type": "header", "content": "t:shared.spacing.block_header" },
        { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
        { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
        { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
        { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
        { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.team_member.name" }]
}
{% endschema %}
