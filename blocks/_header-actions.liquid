{% doc %}
  The promotional pill, account control and cart control. Static, so their
  options sit beside the header instead of lengthening its own list.
{% enddoc %}

{%- liquid
  assign cart_is_drawer = false
  if settings.cart_type == 'drawer'
    assign cart_is_drawer = true
  endif

  assign cart_count = cart.item_count
  if block.settings.cart_count_padded and cart_count < 10
    assign cart_count_display = cart_count | prepend: '0'
  else
    assign cart_count_display = cart_count
  endif
-%}

{% render 'header-actions',
   cart_is_drawer: cart_is_drawer,
   cart_count_display: cart_count_display,
   options: block.settings %}

{% schema %}
{
  "name": "t:blocks.header_actions.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "promo_label",
      "label": "t:sections.header.settings.promo_label.label",
      "default": "Promo label"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "t:shared.link.label"
    },
    {
      "type": "checkbox",
      "id": "promo_show_mobile",
      "label": "t:sections.header.settings.promo_show_mobile.label",
      "info": "t:sections.header.settings.promo_show_mobile.info",
      "default": false
    },
    {
      "type": "select",
      "id": "utility_style",
      "label": "t:sections.header.settings.utility_style.label",
      "info": "t:sections.header.settings.utility_style.info",
      "options": [
        {
          "value": "icons",
          "label": "t:sections.header.settings.utility_style.options__1.label"
        },
        {
          "value": "text",
          "label": "t:sections.header.settings.utility_style.options__2.label"
        }
      ],
      "default": "icons"
    },
    {
      "type": "checkbox",
      "id": "cart_count_padded",
      "label": "t:sections.header.settings.cart_count_padded.label",
      "info": "t:sections.header.settings.cart_count_padded.info",
      "default": true
    }
  ]
}
{% endschema %}
