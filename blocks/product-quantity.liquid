{% doc %}
  The quantity selector as its own block.

  @param {string} [product_form_id] - The id of the product form this input belongs to, so the control can sit outside the form and still submit with it
{% enddoc %}

{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant

  # Shopify enforces these server-side. Reflecting them in the input means the
  # customer is told before they add, not after checkout rejects it.
  assign min = variant.quantity_rule.min | default: 1
  assign step = variant.quantity_rule.increment | default: 1
  assign max = variant.quantity_rule.max

  assign input_id = 'Quantity-' | append: block.id
-%}

{%- if product -%}
  {%- liquid
    assign rule_text = ''
    if variant.quantity_rule.increment > 1 or variant.quantity_rule.min > 1
      assign rule_text = 'products.product.quantity_rule' | t: min: min, step: step
    endif

    capture block_attributes
      render 'block-border', settings: block.settings
      render 'spacing', block: block.settings
      echo block.shopify_attributes
    endcapture
  -%}

  {% render 'quantity-selector',
     id: input_id,
     min: min,
     step: step,
     max: max,
     product_title: product.title,
     show_label: block.settings.show_label,
     form: product_form_id,
     rule: rule_text,
     attributes: block_attributes %}
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_quantity.name",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "t:blocks.product_quantity.settings.show_label.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:shared.border.header"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "t:shared.border.thickness.label",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:shared.border.style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.border.style.options__1.label"
        },
        {
          "value": "dashed",
          "label": "t:shared.border.style.options__2.label"
        },
        {
          "value": "dotted",
          "label": "t:shared.border.style.options__3.label"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.border_thickness > 0 }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:shared.border.color.label",
      "visible_if": "{{ block.settings.border_thickness > 0 }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:shared.border.radius.label",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product_quantity.name",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
