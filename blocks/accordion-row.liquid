{% doc %}
  One row of an **Accordion** — a question, or any other short label, and
  whatever answers it.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign question = s.question
  assign icon_source = s.icon_source | default: 'none'
  capture icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0

  assign has_icon = false
  if icon_source == 'icon' and s.icon != blank
    assign has_icon = true
  endif
  if icon_source == 'image' and s.icon_image != blank
    assign has_icon = true
  endif

  assign toggle = s.toggle_style | default: 'plus'

  assign border_style = s.border_style | default: 'none'
  assign border_width = 0
  if border_style != 'none'
    assign border_width = s.border_width | default: 1 | plus: 0

    if s.border_color == blank
      assign border_paint = 'color-mix(in srgb, currentColor 20%, transparent)'
    else
      assign border_paint = s.border_color
    endif
  endif

  assign radius = s.border_radius | default: 14 | plus: 0

  # The icon tile grows with the glyph rather than taking a second slider that
  # can be set smaller than the thing it contains.
  assign icon_box = icon_size | plus: 12

  assign preset = s.preset | default: 'default'

  assign question_classes = 'accordion-row__question block-text--' | append: preset
  if s.color == 'gradient'
    assign question_classes = question_classes | append: ' block-text--gradient'
  endif
-%}

{%- capture question_style -%}
  {%- render 'block-typography', block: s -%}
{%- endcapture -%}

{%- capture icon_mark_style -%}
  {%- render 'icon-mark', block: s, declarations: true -%}
{%- endcapture -%}

{%- if question != blank -%}
  {%- capture row_style -%}
    {%- render 'spacing', block: s, declarations: true -%}
    {%- if has_icon -%}
      --accordion-row-icon-size: {{ icon_size }}px;
      --accordion-row-icon-box: {{ icon_box }}px;
    {%- endif -%}
    --accordion-row-radius: {{ radius }}px;
    {%- if s.background_color != blank -%}
      --accordion-row-background: {{ s.background_color }};
    {%- endif -%}
    {%- if border_width > 0 -%}
      --accordion-row-border-width: {{ border_width }}px;
      --accordion-row-border-style: {{ border_style }};
      --accordion-row-border-color: {{ border_paint }};
    {%- endif -%}
  {%- endcapture -%}

  <motion-effect
    class="accordion-row-motion"
    {% render 'motion-attrs', kind: 'text', block: s %}
  >
  <details
    class="accordion-row icon-mark-host accordion-row--toggle-{{ toggle }}{% if has_icon %} accordion-row--has-icon{% endif %}"
    {% if s.open_by_default %}open data-default-open{% endif %}
    data-block-spacing
    style="{{ row_style | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    <summary class="accordion-row__summary">
      {%- if has_icon -%}

        <span class="accordion-row__icon icon-mark" style="{{ icon_mark_style | strip_newlines | strip }}">
          {% render 'icon-mark', block: s %}
          {%- if icon_source == 'image' -%}
            {% render 'image',
               image: s.icon_image,
               alt: s.icon_image_alt,
               sizes: '48px',
               wrapper_class: 'accordion-row__icon-image' %}
          {%- else -%}
            {% render 'icon', icon: s.icon, size: icon_size %}
          {%- endif -%}
        </span>
      {%- endif -%}

      <span class="{{ question_classes }}" style="{{ question_style | strip_newlines | strip }}">
        {{- question -}}
      </span>

      <span class="accordion-row__toggle" aria-hidden="true">
        {%- if toggle == 'arrow' -%}
          {% render 'icon', icon: 'chevron-down', size: 14, class: 'accordion-row__chevron' %}
        {%- else -%}
          {% render 'icon', icon: 'plus', size: 14, class: 'accordion-row__plus' %}
        {%- endif -%}
      </span>
    </summary>

    <div class="accordion-row__panel">
      <div class="accordion-row__answer">
        {% content_for 'blocks' %}
      </div>
    </div>
  </details>
  </motion-effect>
{%- endif -%}

