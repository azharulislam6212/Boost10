{% doc %}
  How a bundle row and its cards are sized and painted, written as custom
  properties the section folds into its own style attribute.
{% enddoc %}

{%- liquid
  assign s = block.settings
-%}
--product-bundle-row-size: {{ s.row_height | default: 145 }}px;
--product-bundle-row-gap: {{ s.row_gap | default: 13 }}px;
--product-bundle-row-size-mobile: {{ s.row_height_mobile | default: 124 }}px;
--product-bundle-row-gap-mobile: {{ s.row_gap_mobile | default: 12 }}px;
--product-bundle-card-padding-block: {{ s.card_padding | default: 17.5 }}px;
--product-bundle-card-radius: {{ s.card_radius | default: 24 }}px;
--product-bundle-media-radius: {{ s.media_radius | default: 14 }}px;
{%- if s.card_background != blank -%}
  --product-bundle-card-background: {{ s.card_background }};
{%- endif -%}
{%- if s.card_foreground != blank -%}
  --product-bundle-card-foreground: {{ s.card_foreground }};
{%- endif -%}
{%- if s.card_active_background != blank -%}
  --product-bundle-card-active-background: {{ s.card_active_background }};
{%- endif -%}
{%- if s.card_active_foreground != blank -%}
  --product-bundle-card-active-foreground: {{ s.card_active_foreground }};
{%- endif -%}
{%- if s.card_active_border != blank -%}
  --product-bundle-card-active-border: {{ s.card_active_border }};
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_bundle_cards.name",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "row_height",
      "label": "t:sections.product_bundle.settings.row_height.label",
      "info": "t:sections.product_bundle.settings.row_height.info",
      "min": 110,
      "max": 210,
      "step": 1,
      "unit": "px",
      "default": 145
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:sections.product_bundle.settings.row_gap.label",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "row_height_mobile",
      "label": "t:sections.product_bundle.settings.row_height_mobile.label",
      "min": 96,
      "max": 196,
      "step": 1,
      "unit": "px",
      "default": 124
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "t:sections.product_bundle.settings.row_gap_mobile.label",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "t:sections.product_bundle.settings.card_padding.label",
      "info": "t:sections.product_bundle.settings.card_padding.info",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "px",
      "default": 17.5
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:sections.product_bundle.settings.card_radius.label",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "t:sections.product_bundle.settings.media_radius.label",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:sections.product_bundle.settings.card_background.label",
      "info": "t:sections.product_bundle.settings.card_background.info"
    },
    {
      "type": "color",
      "id": "card_foreground",
      "label": "t:sections.product_bundle.settings.card_foreground.label",
      "info": "t:sections.product_bundle.settings.card_foreground.info"
    },
    {
      "type": "color",
      "id": "card_active_background",
      "label": "t:sections.product_bundle.settings.card_active_background.label",
      "info": "t:sections.product_bundle.settings.card_active_background.info"
    },
    {
      "type": "color",
      "id": "card_active_foreground",
      "label": "t:sections.product_bundle.settings.card_active_foreground.label",
      "info": "t:sections.product_bundle.settings.card_active_foreground.info"
    },
    {
      "type": "color",
      "id": "card_active_border",
      "label": "t:sections.product_bundle.settings.card_active_border.label",
      "info": "t:sections.product_bundle.settings.card_active_border.info"
    }
  ]
}
{% endschema %}
