{% comment %}
  blocks/_product-selling-plans.liquid — private.

  Allocations are rendered per variant. A 1kg tub and a 500g pouch can have
  different subscription prices, and a plan on one may not exist on the other —
  which is why the selector re-reads this map on every variant change rather than
  trusting what it read at page load.
{% endcomment %}

{%- liquid
  assign product = closest.product
-%}

{%- if product -%}
  <div {{ block.shopify_attributes }}>
    {% render 'selling-plans', product: product %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_selling_plans.name",
  "tag": null,
  "settings": []
}
{% endschema %}
