{% doc %}
  A container for one panel of **Featured pills**: a flex box with a surface,
  a frame and a set of blocks inside it.
{% enddoc %}

{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{%- capture background -%}
  {% content_for 'block', type: '_background-media', id: 'background' %}
{%- endcapture -%}

{%- capture frame -%}
  {% content_for 'block', type: '_block-frame', id: 'frame' %}
{%- endcapture -%}

{%- capture link_layer -%}
  {% content_for 'block', type: '_block-link', id: 'link' %}
{%- endcapture -%}

{% render 'group',
   background: background,
   frame: frame,
   link_layer: link_layer,
   children: children,
   settings: block.settings,
   extra_classes: 'featured-pills-group',
   shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "t:blocks.featured_pills_group.name",
  "tag": null,
  "blocks": [
    {
      "type": "_featured-pills-group"
    },
    {
      "type": "_featured-pills-carousel"
    },
    {
      "type": "_featured-pills-check"
    },
    {
      "type": "_featured-pills-step"
    },
    {
      "type": "_featured-pills-tabs"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.group.settings.direction.label",
      "options": [
        {
          "value": "column",
          "label": "t:blocks.group.settings.direction.options__1.label"
        },
        {
          "value": "row",
          "label": "t:blocks.group.settings.direction.options__2.label"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:blocks.group.settings.stack_on_mobile.label",
      "info": "t:blocks.group.settings.stack_on_mobile.info",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "info": "t:blocks.group.settings.alignment.info",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:blocks.group.settings.position.label",
      "info": "t:blocks.group.settings.position.info",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.position.options__3.label"
        },
        {
          "value": "stretch",
          "label": "t:blocks.group.settings.position.options__4.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "distribution",
      "label": "t:blocks.group.settings.distribution.label",
      "info": "t:blocks.group.settings.distribution.info",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.group.settings.distribution.options__1.label"
        },
        {
          "value": "space-between",
          "label": "t:blocks.group.settings.distribution.options__2.label"
        },
        {
          "value": "space-around",
          "label": "t:blocks.group.settings.distribution.options__3.label"
        },
        {
          "value": "space-evenly",
          "label": "t:blocks.group.settings.distribution.options__4.label"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:blocks.group.settings.gap.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_horizontal",
