      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:blocks.group.settings.gap_vertical.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
