    {
      "type": "range",
      "id": "animation_duration",
      "label": "t:shared.animation.animation_duration.label",
      "info": "t:shared.animation.animation_duration.info",
      "min": 0,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "default": 1000,
      "visible_if": "{{ block.settings.animation_text != 'none' }}"
    },
    {
      "type": "range",
      "id": "animation_stagger",
      "label": "t:shared.animation.animation_stagger.label",
      "info": "t:shared.animation.animation_stagger.info",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation_text != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:blocks.group.settings.padding_device.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:blocks.group.settings.padding_device.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:blocks.group.settings.padding_device.options__2.label"
        }
      ],
