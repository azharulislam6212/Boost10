    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:blocks.group.settings.inherit_color_scheme.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.visibility"
    },
    {
      "type": "paragraph",
      "content": "t:blocks.group.paragraphs.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:blocks.group.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_tablet",
      "label": "t:blocks.group.settings.hide_tablet.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:blocks.group.settings.hide_desktop.label",
      "default": false
