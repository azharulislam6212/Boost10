{% comment %}
  blocks/_product-details.liquid

  Private. The information column.

  It renders four private children in a fixed order — title, price, variant
  picker, buy buttons — and then `{% content_for 'blocks' %}` for everything the
  merchant arranges below them.

  That split is the whole design. The customer can always see what the product is,
  what it costs, which one they are choosing and how to buy it, because none of
  those four can be removed. Everything below is theirs: description, collapsible
  rows, trust points, app blocks, groups of any of them, in any order.

  A merchant who wants the description above the buy button is an argument for
  making this fixed region shorter — not for making the buy button deletable.
{% endcomment %}

{%- liquid
  assign product = closest.product
   assign block_settings = block.settings 
-%}

<div class="product-details" {{ block.shopify_attributes }}>
  {% capture children %}
   <div class="view-product-title">
      <a
        href="{{ product.selected_or_first_available_variant.url }}"
        class="link"
      >
        {{- product.title }}
      </a>
    </div>
    {% content_for 'blocks' %}
  {% endcapture %}

 
  <div class="product-details__blocks">
    {% render 'group', children: children, settings: block_settings, shopify_attributes: block.shopify_attributes %}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.product_details.name",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "product-title"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "collapsible"
    },
    {
      "type": "complementary"
    },
    {
      "type": "product-price"
    },
    {
      "type": "variant-picker"
    },
    {
      "type": "product-quantity"
    },
    {
      "type": "buy-buttons"
    },
    {
      "type": "product-description"
    },
    {
      "type": "divider"
    },
    {
      "type": "product-inventory"
    },
    {
      "type": "_product-selling-plans"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.product_details.settings.width.label",
      "options": [
        {
          "value": "fit-content",
          "label": "t:blocks.product_details.settings.width.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.product_details.settings.width.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:blocks.product_details.settings.width.options__3.label"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:blocks.product_details.settings.custom_width.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:blocks.product_details.settings.width_mobile.label",
      "options": [
        {
          "value": "fit-content",
          "label": "t:blocks.product_details.settings.width_mobile.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.product_details.settings.width_mobile.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:blocks.product_details.settings.width_mobile.options__3.label"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:blocks.product_details.settings.custom_width_mobile.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:blocks.product_details.settings.height.label",
      "options": [
        {
          "value": "fit",
          "label": "t:blocks.product_details.settings.height.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.product_details.settings.height.options__2.label"
        }
      ],
      "default": "fit"
    },
    {
      "type": "select",
      "id": "details_position",
      "label": "t:blocks.product_details.settings.details_position.label",
      "options": [
        {
          "value": "flex-start",
          "label": "t:blocks.product_details.settings.details_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.product_details.settings.details_position.options__2.label"
        },
        {
          "value": "flex-end",
          "label": "t:blocks.product_details.settings.details_position.options__3.label"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.height == \"fill\" }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:blocks.product_details.settings.gap.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "sticky_details_desktop",
      "label": "t:blocks.product_details.settings.sticky_details_desktop.label",
      "default": false
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:shared.border.style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.none.label"
        },
        {
          "value": "dashed",
          "label": "t:shared.border.style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:shared.border.style.options__1.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "label": "t:shared.border.thickness.label",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:shared.border.opacity.label",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:shared.border.radius.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
