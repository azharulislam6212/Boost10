{% doc %}
  Private. The information column.
{% enddoc %}

{%- liquid
  assign product = closest.product
   assign block_settings = block.settings
-%}

<div class="product-details" {{ block.shopify_attributes }}>
  {%- capture children -%}
    {%- content_for 'blocks' -%}
  {%- endcapture -%}

  {%- if children == blank -%}
    {%- capture children -%}
      <h1 class="product-title__text">{{ product.title }}</h1>
    {%- endcapture -%}
  {%- endif -%}

  <div class="product-details__blocks">
    {% render 'group', children: children, settings: block_settings, gap_mobile_max: 20, shopify_attributes: block.shopify_attributes %}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.product_details.name",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "product-title"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "accordion"
    },
    {
      "type": "complementary"
    },
    {
      "type": "product-price"
    },
    {
      "type": "variant-picker"
    },
    {
      "type": "product-quantity"
    },
    {
      "type": "product-volume-pricing"
    },
    {
      "type": "buy-buttons"
    },
    {
      "type": "product-description"
    },
    {
      "type": "divider"
    },
    {
      "type": "product-inventory"
    },
    {
      "type": "_product-selling-plans"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:shared.gap.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.group.settings.width.label",
      "options": [
        {
          "value": "fit",
          "label": "t:blocks.group.settings.width.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.group.settings.width.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:blocks.group.settings.width.options__3.label"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "t:blocks.group.settings.width_custom.label",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:blocks.group.settings.width_mobile.label",
      "options": [
        {
          "value": "fit",
          "label": "t:blocks.group.settings.width.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.group.settings.width.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:blocks.group.settings.width.options__3.label"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_custom_mobile",
      "label": "t:blocks.group.settings.width_custom.label",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:blocks.group.settings.height.label",
      "options": [
        {
          "value": "fit",
          "label": "t:blocks.group.settings.height.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.group.settings.height.options__2.label"
        }
      ],
      "default": "fit"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:blocks.group.settings.position.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.position.options__3.label"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.height == 'fill' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.group.settings.border_style.options__1.label"
        },
        {
          "value": "solid",
          "label": "t:blocks.group.settings.border_style.options__2.label"
        },
        {
          "value": "dashed",
          "label": "t:shared.border.style.options__2.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:shared.border.thickness.label",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "t:shared.border.opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:shared.border.color.label",
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:blocks.group.settings.border_radius.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:blocks.group.settings.padding_device.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:blocks.group.settings.padding_device.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:blocks.group.settings.padding_device.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "t:shared.spacing.padding_inline.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "t:shared.spacing.padding_block.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_inline_mobile",
      "label": "t:shared.spacing.padding_inline.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_block_mobile",
      "label": "t:shared.spacing.padding_block.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
