{% doc %}
  blocks/menu-links.liquid — Boost10
{% enddoc %}

{%- liquid
  assign st = block.settings
  assign menu = st.menu
-%}

<div
  class="megamenu__item megamenu__item--links"
  style="--span: {{ st.column_span }};"
  {{ block.shopify_attributes }}
>
  {%- if st.heading != blank -%}
    <p class="megamenu__eyebrow">{{ st.heading | escape }}</p>
  {%- endif -%}

  {%- if menu != blank and menu.links.size > 0 -%}
    <div class="megamenu__columns" style="--columns: {{ st.columns }};">
      {%- for link in menu.links -%}
        <div class="megamenu__column">
          {%- if link.links.size > 0 -%}
            <a class="megamenu__column-heading" href="{{ link.url }}">{{ link.title }}</a>

            <ul class="megamenu__list" role="list">
              {%- for child in link.links -%}
                <li>
                  <a class="megamenu__link" href="{{ child.url }}">{{ child.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <a class="megamenu__link megamenu__link--standalone" href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}

    <p class="megamenu__empty">{{ 'blocks.mega_menu.empty_menu' | t }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.menu_links.name",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:blocks.menu_links.settings.menu.label",
      "info": "t:blocks.menu_links.settings.menu.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading.label"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:shared.columns.desktop.label",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "column_span",
      "label": "t:blocks.shared.column_span.label",
      "info": "t:blocks.shared.column_span.info",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ]
}
{% endschema %}
