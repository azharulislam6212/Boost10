{% comment %}
  blocks/menu-links.liquid — Boost10

  Link columns inside a mega menu panel, built from a menu the merchant picks in
  the Shopify admin.

  ## Why it picks its own menu

  A nested block cannot read its parent's settings, and it has no idea which
  navigation item the panel is attached to. Asking for a menu here is not a
  workaround for that — it is the more useful behaviour: the panel under "Shop"
  can show a curated "Shop by category" menu that is not part of the header tree
  at all, and the merchant edits it in Navigation like everything else.

  Point it at the same child menu as the navigation item and it behaves exactly
  like an automatic dropdown, only laid out in columns.

  ## Two levels, and the heading is a link

  A menu's second level becomes the column heading and its third level the
  entries beneath. The heading is an anchor, not a label — a customer who reads
  "Vitamins & Capsules" and clicks it expects the collection, and a heading that
  does nothing is a dead target in the middle of the panel.
{% endcomment %}

{%- liquid
  assign st = block.settings
  assign menu = st.menu
-%}

<div
  class="megamenu__item megamenu__item--links"
  style="--span: {{ st.column_span }};"
  {{ block.shopify_attributes }}
>
  {%- if st.heading != blank -%}
    <p class="megamenu__eyebrow">{{ st.heading | escape }}</p>
  {%- endif -%}

  {%- if menu != blank and menu.links.size > 0 -%}
    <div class="megamenu__columns" style="--columns: {{ st.columns }};">
      {%- for link in menu.links -%}
        <div class="megamenu__column">
          {%- if link.links.size > 0 -%}
            <a class="megamenu__column-heading" href="{{ link.url }}">{{ link.title }}</a>

            <ul class="megamenu__list" role="list">
              {%- for child in link.links -%}
                <li>
                  <a class="megamenu__link" href="{{ child.url }}">{{ child.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <a class="megamenu__link megamenu__link--standalone" href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- comment -%}
      An empty state a merchant can act on. The alternative — rendering nothing —
      makes a panel that looks broken with no clue as to why.
    {%- endcomment -%}
    <p class="megamenu__empty">{{ 'blocks.mega_menu.empty_menu' | t }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.menu_links.name",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:blocks.menu_links.settings.menu.label",
      "info": "t:blocks.menu_links.settings.menu.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading.label"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:shared.columns.desktop.label",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "column_span",
      "label": "t:blocks.shared.column_span.label",
      "info": "t:blocks.shared.column_span.info",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ]
}
{% endschema %}
