{% doc %}
  blocks/_highlight-point-icon.liquid — private, static in blocks/_highlight-point.liquid.
  The point's mark: an icon in its shape and ring, with the number badge on it.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign has_icon = false
  if s.icon_source == 'icon' and s.icon != blank
    assign has_icon = true
  endif

  capture icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0
-%}

{%- capture number_vars -%}
  --hp-number-size: {{ s.number_size }}px;
  {%- if s.number_background != blank -%}
    --hp-number-background: {{ s.number_background }};
  {%- endif -%}
  {%- if s.number_color != blank -%}
    --hp-number-color: {{ s.number_color }};
  {%- endif -%}
{%- endcapture -%}

{%- capture icon_mark_style -%}
  {%- render 'icon-mark', block: s, declarations: true, dash_gap: 6 -%}
  {{ number_vars }}
{%- endcapture -%}

{%- if has_icon -%}
  <span
    class="highlight-point__mark icon-mark"
    aria-hidden="true"
    style="{{ icon_mark_style | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    {% render 'icon-mark', block: s, dash_gap: 6 %}
    {% render 'icon', icon: s.icon, size: icon_size %}

    {%- if s.number != blank -%}
      <span class="highlight-point__number" aria-hidden="false">{{ s.number | escape }}</span>
    {%- endif -%}
  </span>
{%- elsif s.number != blank -%}
  <span
    class="highlight-point__number highlight-point__number--alone"
    style="{{ number_vars | strip_newlines | strip }}"
    {{ block.shopify_attributes }}
  >
    {{- s.number | escape -}}
  </span>
{%- endif -%}

