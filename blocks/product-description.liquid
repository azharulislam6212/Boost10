{% comment %}
  blocks/product-description.liquid

  Public. Merchant-addable, because a merchant may want the description above the
  collapsible rows, below them, or split into a group with an image beside it.

  Renders nothing without a product, so dropping it into a non-product section is
  harmless rather than an error.
{% endcomment %}

{%- liquid
  assign product = closest.product
-%}

{%- if product and product.description != blank -%}
  <motion-effect
    {% render 'motion-attrs', kind: 'text', block: block.settings %}
    class="product-description rte"
    {% render 'spacing', block: block.settings %}
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.truncate -%}
      <show-more data-height="{{ block.settings.truncate_height }}">
        <div data-ref="content">{{ product.description }}</div>
        <button
          type="button"
          data-ref="button"
          class="button button--link"
          aria-expanded="false"
          data-label-more="{{ 'general.actions.show_more' | t | escape }}"
          data-label-less="{{ 'general.actions.show_less' | t | escape }}"
        >
          {{ 'general.actions.show_more' | t }}
        </button>
      </show-more>
    {%- else -%}
      {{ product.description }}
    {%- endif -%}
  </motion-effect>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_description.name",
  "tag": null,
  "settings": [
    { "type": "checkbox", "id": "truncate", "label": "t:blocks.product_description.settings.truncate.label", "info": "t:blocks.product_description.settings.truncate.info", "default": false },
    { "type": "range", "id": "truncate_height", "label": "t:blocks.product_description.settings.truncate_height.label", "min": 80, "max": 400, "step": 20, "unit": "px", "default": 180 },
    { "type": "header", "content": "t:shared.spacing.block_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:shared.spacing.padding_right.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:shared.spacing.padding_left.label", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_scale_mobile", "label": "t:shared.spacing.padding_scale_mobile.label", "info": "t:shared.spacing.padding_scale_mobile.info", "min": 25, "max": 100, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "t:blocks.product_description.name" }]
}
{% endschema %}
