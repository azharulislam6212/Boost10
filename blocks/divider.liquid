{% comment %}
  blocks/divider.liquid

  A rule between blocks, inside a section.

  Same four styles as the section, same snippet underneath. The difference is
  only where it can be placed — this one goes between blocks, the section goes
  between sections, and a merchant should not have to think about which file
  each one lives in.
{% endcomment %}

<div class="divider-block" {% render 'spacing', block: block.settings %} {{ block.shopify_attributes }}>
  {% render 'divider',
     style: block.settings.style,
     color: block.settings.color,
     thickness: block.settings.thickness,
     width: block.settings.width %}
</div>

{% schema %}
{
  "name": "t:blocks.divider.name",
  "tag": null,
  "settings": [
    {
      "type": "select", "id": "style", "label": "t:sections.divider.settings.style.label",
      "options": [
        { "value": "solid", "label": "t:sections.divider.settings.style.options__1.label" },
        { "value": "dashed", "label": "t:sections.divider.settings.style.options__2.label" },
        { "value": "dotted", "label": "t:sections.divider.settings.style.options__3.label" }
      ],
      "default": "solid"
    },
    { "type": "color", "id": "color", "label": "t:settings_schema.gradients.settings.divider_color.label" },
    { "type": "range", "id": "thickness", "label": "t:settings_schema.gradients.settings.divider_thickness.label", "min": 1, "max": 8, "step": 1, "unit": "px", "default": 1 },
    {
      "type": "select", "id": "width", "label": "t:sections.divider.settings.width.label",
      "options": [
        { "value": "full", "label": "t:sections.divider.settings.width.options__1.label" },
        { "value": "short", "label": "t:sections.divider.settings.width.options__3.label" }
      ],
      "default": "full"
    },
        {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        { "value": "desktop", "label": "t:shared.spacing.devices.options__1.label" },
        { "value": "mobile", "label": "t:shared.spacing.devices.options__2.label" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [{ "name": "t:blocks.divider.name" }]
}
{% endschema %}
