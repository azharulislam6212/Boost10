{% comment %}
  blocks/divider.liquid

  A rule between blocks, inside a section.

  Same four styles as the section, same snippet underneath. The difference is
  only where it can be placed — this one goes between blocks, the section goes
  between sections, and a merchant should not have to think about which file
  each one lives in.
{% endcomment %}

{%- liquid
  comment
    Vertical is the same rule turned on its side, for the case a horizontal one
    cannot serve: a hairline *between* blocks laid out in a row — the tick marks
    between "No hidden fees", "Skip anytime" and "Secure checkout".

    It is an orientation rather than a second block because everything else is
    identical: the same three styles, the same colour, the same thickness, the
    same snippet. What changes is which border edge is drawn and which axis the
    length runs along.

    A vertical rule stretches to the row it sits in, so it needs no length of
    its own. `--divider-length` is the escape hatch for a row whose items are
    much taller than the mark should be.
  endcomment
  assign orientation = block.settings.orientation | default: 'horizontal'
  assign length = block.settings.length | default: 0 | plus: 0
-%}

{%- capture divider_style -%}
  {%- render 'spacing', block: block.settings, declarations: true -%}
  {%- if orientation == 'vertical' and length > 0 -%}
    --divider-length: {{ length }}px;
  {%- endif -%}
{%- endcapture -%}

<div
  class="divider-block divider-block--{{ orientation }}"
  data-block-spacing
  style="{{ divider_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  {% render 'divider',
     style: block.settings.style,
     color: block.settings.color,
     thickness: block.settings.thickness,
     width: block.settings.width,
     orientation: orientation %}
</div>

{% schema %}
{
  "name": "t:blocks.divider.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "orientation",
      "label": "t:blocks.divider.settings.orientation.label",
      "info": "t:blocks.divider.settings.orientation.info",
      "options": [
        { "value": "horizontal", "label": "t:blocks.divider.settings.orientation.options__1.label" },
        { "value": "vertical", "label": "t:blocks.divider.settings.orientation.options__2.label" }
      ],
      "default": "horizontal"
    },
    {
      "type": "range",
      "id": "length",
      "label": "t:blocks.divider.settings.length.label",
      "info": "t:blocks.divider.settings.length.info",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.orientation == 'vertical' }}"
    },
    {
      "type": "select", "id": "style", "label": "t:sections.divider.settings.style.label",
      "options": [
        { "value": "solid", "label": "t:sections.divider.settings.style.options__1.label" },
        { "value": "dashed", "label": "t:sections.divider.settings.style.options__2.label" },
        { "value": "dotted", "label": "t:sections.divider.settings.style.options__3.label" }
      ],
      "default": "solid"
    },
    { "type": "color", "id": "color", "label": "t:settings_schema.gradients.settings.divider_color.label" },
    { "type": "range", "id": "thickness", "label": "t:settings_schema.gradients.settings.divider_thickness.label", "min": 1, "max": 8, "step": 1, "unit": "px", "default": 1 },
    {
      "type": "select", "id": "width", "label": "t:sections.divider.settings.width.label",
      "options": [
        { "value": "full", "label": "t:sections.divider.settings.width.options__1.label" },
        { "value": "short", "label": "t:sections.divider.settings.width.options__3.label" }
      ],
      "default": "full"
    },
        {
      "type": "header",
      "content": "t:shared.spacing.block_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        { "value": "desktop", "label": "t:shared.spacing.devices.options__1.label" },
        { "value": "mobile", "label": "t:shared.spacing.devices.options__2.label" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:shared.spacing.padding_left.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:shared.spacing.padding_right.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [{ "name": "t:blocks.divider.name" }]
}
{% endschema %}
