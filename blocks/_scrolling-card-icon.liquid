{% doc %}
  blocks/_scrolling-card-icon.liquid — private to `blocks/_scrolling-card.liquid`.
  A glyph on a translucent disc inside a ring of fine ticks. Hovering the card
  spins the ring and swaps the colours; empty colour settings follow the scheme.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign icon_source = s.icon_source
  assign icon_name = s.icon

  capture icon_px
    render 'icon-size', size: s.icon_size, custom: s.icon_size_custom
  endcapture
  assign icon_size = icon_px | plus: 0

  assign size = s.shape_size
  assign size_mobile = s.shape_size_mobile
-%}

{%- capture icon_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --sc-icon-size: {{ size }}px;
  --sc-icon-size-mobile: {{ size_mobile }}px;
  --sc-icon-glyph: {{ icon_size }}px;
  {%- if s.icon_color != blank -%}--sc-icon-color: {{ s.icon_color }};{%- endif -%}
  {%- if s.icon_hover_color != blank -%}--sc-icon-color-hover: {{ s.icon_hover_color }};{%- endif -%}
  {%- if s.fill_color != blank -%}--sc-icon-fill: {{ s.fill_color }};{%- endif -%}
  {%- if s.fill_hover_color != blank -%}--sc-icon-fill-hover: {{ s.fill_hover_color }};{%- endif -%}
  {%- if s.ring_color != blank -%}--sc-icon-ring: {{ s.ring_color }};{%- endif -%}
  {%- if s.ring_hover_color != blank -%}--sc-icon-ring-hover: {{ s.ring_hover_color }};{%- endif -%}
{%- endcapture -%}

<div
  class="scrolling-card-icon"
  data-block-spacing
  style="{{ icon_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>
  <span class="scrolling-card-icon__shape" aria-hidden="true">
    <span class="scrolling-card-icon__ring"></span>
    <span class="scrolling-card-icon__disc">
      {%- if icon_source == 'image' and s.icon_image != blank -%}
        <img
          class="scrolling-card-icon__image"
          src="{{ s.icon_image | image_url: width: 160 }}"
          alt=""
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          loading="lazy"
        >
      {%- elsif icon_name != blank and icon_name != 'none' -%}
        {% render 'icon', icon: icon_name, size: icon_size, class: 'scrolling-card-icon__glyph' %}
      {%- endif -%}
    </span>
  </span>
</div>

