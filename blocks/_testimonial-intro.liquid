{% doc %}
  blocks/_testimonial-intro.liquid — private to `sections/testimonials.liquid`.
{% enddoc %}

{%- liquid
  assign s = block.settings

  assign align = s.alignment | default: 'start'
  assign gap = s.gap | default: 20 | plus: 0
  assign min_height = s.min_height | default: 366 | plus: 0
  assign width = s.width | default: 312 | plus: 0

  assign border_line = s.border_style | default: 'none'
  assign border_width = 0
  assign border_paint = ''

  if border_line != 'none'
    assign border_width = s.border_width | default: 1 | plus: 0

    assign border_percent = s.border_opacity | default: 100 | plus: 0
    if s.border_color == blank
      assign border_paint = 'color-mix(in srgb, currentColor ' | append: border_percent | append: '%, transparent)'
    else
      assign border_alpha = border_percent | divided_by: 100.0
      assign border_paint = s.border_color | color_modify: 'alpha', border_alpha
    endif
  endif

  assign radius = s.border_radius | default: 20 | plus: 0
  assign radius_mobile = s.border_radius_mobile | default: radius | plus: 0

  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif

  assign background_paint = ''
  if has_background_media == false and s.background_color != blank
    assign background_alpha = s.background_opacity | default: 100 | plus: 0
    assign background_alpha = background_alpha | divided_by: 100.0
    assign background_paint = s.background_color | color_modify: 'alpha', background_alpha
  endif
-%}

{%- capture intro_style -%}
  {%- render 'spacing', block: s, declarations: true -%}
  --tc-intro-align: {{ align }};
  --tc-intro-gap: {{ gap }}px;
  --tc-intro-width: {{ width }}px;
  --tc-intro-radius: {{ radius }}px;
  --tc-intro-radius-mobile: {{ radius_mobile }}px;
  --tc-intro-heading-size: {{ s.heading_size | default: 24 | plus: 0 }}px;
  --tc-intro-stat-gap: {{ s.stat_gap | default: 28 | plus: 0 }}px;
  {%- if min_height > 0 -%}
    --tc-intro-min-height: {{ min_height }}px;
  {%- endif -%}
  {%- if border_width > 0 -%}
    --tc-intro-border-width: {{ border_width }}px;
    --tc-intro-border-style: {{ border_line }};
    --tc-intro-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if background_paint != '' -%}
    --tc-intro-background: {{ background_paint }};
  {%- endif -%}
  {%- if s.text_color != blank -%}
    --tc-intro-text: {{ s.text_color }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="testimonial-intro{% if has_background_media %} has-background-media{% endif %}"
  data-block-spacing
  style="{{ intro_style | strip_newlines | strip }}"
  {{ block.shopify_attributes }}
>

  {%- if has_background_media -%}
    {% render 'background-media', settings: s %}
  {%- endif -%}

  {%- if s.heading != blank -%}

    <h3 class="testimonial-intro__heading">{{ s.heading }}</h3>
  {%- endif -%}

  <div class="testimonial-intro__stats">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
