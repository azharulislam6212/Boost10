{
  "sections": {
    "main": {
      "type": "main-product",
      "settings": {
        "enable_sticky_atc": false,
        "animation_text": "inherit",
        "animation_image": "inherit",
        "color_scheme": "scheme-1",
        "padding_top": 32,
        "padding_bottom": 64,
        "padding_top_mobile": 0,
        "padding_bottom_mobile": 0
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "layout": "carousel"
      }
    },
    "sticky-bar": {
      "type": "sticky-product-bar",
      "settings": {
        "enable": true,
        "form_section_id": "main",
        "position": "bottom",
        "show_image": true,
        "show_variants": true,
        "show_quantity": false
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "products_to_show": 4,
        "minimum_products": 2,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "show_clear": true,
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48,
        "padding_top_mobile": 0,
        "padding_bottom_mobile": 0,
        "layout": "carousel"
      }
    }
  },
  "order": [
    "main",
    "sticky-bar",
    "recommendations",
    "recently-viewed"
  ]
}
