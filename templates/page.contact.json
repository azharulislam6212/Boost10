        "form_field_4": {
          "type": "form-field",
          "settings": {
            "type": "select",
            "label": "Subject",
            "options": "Order question\nProduct question\nSubscription\nWholesale\nOther",
            "width": "half"
          }
        },
        "form_field_5": {
          "type": "form-field",
          "settings": {
            "type": "textarea",
            "label": "Message",
            "rows": 6,
            "required": true
