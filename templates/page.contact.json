{
  "sections": {
    "form": {
      "type": "contact-form",
      "blocks": {
        "contact-form-header": {
          "type": "section-header",
          "static": true,
          "settings": {
            "width": "custom",
            "width_custom": 40
          },
          "blocks": {
            "subheading_1": {
              "type": "subheading",
              "settings": {
                "text": "<p>Contact Us</p>",
                "icon": "capsule"
              }
            },
            "text_1": {
              "type": "text",
              "settings": {
                "text": "<p>We’re Here. <em>To Help</em> You</p>",
                "preset": "h2"
              }
            },
            "text_2": {
              "type": "text",
              "settings": {
                "text": "<p>Questions about your order or our products? Our team is here and keen to help — just drop us a line.</p>",
                "preset": "paragraph",
                "max_width": "normal"
              }
            },
            "group_1": {
              "type": "group",
              "settings": {
                "border_style": "solid",
                "border_opacity": 20,
                "border_radius": 24,
                "gap_vertical_mobile": 12,
                "padding_top": 32,
                "padding_bottom": 32,
                "padding_left": 28,
                "padding_right": 28,
                "padding_top_mobile": 24,
                "padding_bottom_mobile": 24,
                "padding_left_mobile": 20,
                "padding_right_mobile": 20,
                "inherit_color_scheme": false,
                "color_scheme": "scheme-2"
              },
              "blocks": {
                "icon_with_text_1": {
                  "type": "icon-with-text",
                  "settings": {
                    "icon": "phone",
                    "shape": "circle",
                    "ring_style": "dashed",
                    "shape_size": 48,
                    "shape_size_mobile": 40,
                    "heading": "Phone Support"
                  }
                },
                "text_3": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Speak with a real person on our team.</p><p><strong>(000) 000-0000</strong><br>Mon–Fri, 9:00 AM – 5:00 PM</p>",
                    "preset": "paragraph"
                  }
                },
                "button_1": {
                  "type": "button",
                  "settings": {
                    "label": "Call Us Now",
                    "link": "/pages/contact",
                    "style": "outline"
                  }
                }
              },
              "block_order": [
                "icon_with_text_1",
                "text_3",
                "button_1"
              ]
            },
            "group_2": {
              "type": "group",
              "settings": {
                "border_style": "solid",
                "border_opacity": 20,
                "border_radius": 24,
                "gap_vertical_mobile": 12,
                "padding_top": 32,
                "padding_bottom": 32,
                "padding_left": 28,
                "padding_right": 28,
                "padding_top_mobile": 24,
                "padding_bottom_mobile": 24,
                "padding_left_mobile": 20,
                "padding_right_mobile": 20,
                "inherit_color_scheme": false,
                "color_scheme": "scheme-2"
              },
              "blocks": {
                "icon_with_text_2": {
                  "type": "icon-with-text",
                  "settings": {
                    "icon": "mail",
                    "shape": "circle",
                    "ring_style": "dashed",
                    "shape_size": 48,
                    "shape_size_mobile": 40,
                    "heading": "Email Support"
                  }
                },
                "text_4": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We reply within 24 hours.</p><p><strong>support@example.com</strong></p>",
                    "preset": "paragraph"
                  }
                },
                "button_2": {
                  "type": "button",
                  "settings": {
                    "label": "Email Us Now",
                    "link": "/pages/contact",
                    "style": "outline"
                  }
                }
              },
              "block_order": [
                "icon_with_text_2",
                "text_4",
                "button_2"
              ]
            }
          },
          "block_order": [
            "subheading_1",
            "text_1",
            "text_2",
            "group_1",
            "group_2"
