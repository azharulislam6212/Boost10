{
  "sections": {
    "main": {
      "type": "main-contact",
      "blocks": {
        "name": {
          "type": "form-field",
          "settings": {
            "type": "text",
            "label": "Name",
            "required": true,
            "width": "half",
            "autocomplete": "name"
          }
        },
        "email": {
          "type": "form-field",
          "settings": {
            "type": "email",
            "label": "Email",
            "required": true,
            "width": "half"
          }
        },
        "subject": {
          "type": "form-field",
          "settings": {
            "type": "select",
            "label": "Subject",
            "options": "Order enquiry\nReturns\nWholesale\nSomething else"
          }
        },
        "message": {
          "type": "form-field",
          "settings": {
            "type": "textarea",
            "label": "Message",
            "rows": 6,
            "required": true
          }
        }
      },
      "block_order": [
        "name",
        "email",
        "subject",
        "message"
      ],
      "settings": {
        "heading": "Contact us",
        "layout": "split",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 64,
        "padding_top_mobile": 0,
        "padding_bottom_mobile": 0
      }
    }
  },
  "order": [
    "main"
  ]
}