{% comment %}
  sections/main-list-collections.liquid

  Every collection in the store.

  Sorting is a real link, not a select that posts. Shopify serves
  /collections?sort_by=… itself, so each order is a URL a customer can share and
  the Back button understands. That also means the sort survives pagination
  without the theme carrying state between pages.

  The grid reuses product-grid, so the three pagination modes behave exactly as
  they do everywhere else. data-item-selector points at collections rather than
  products, which is the only difference.

  Empty collections are hidden by default. A store with fifteen live collections
  and six seasonal ones it has emptied should show fifteen, not twenty-one tiles
  where a third lead nowhere.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
  assign per_page = section_settings.collections_per_page | default: 12

  assign source = collections
  if section_settings.collection_list != blank and section_settings.collection_list.size > 0
    assign source = section_settings.collection_list
  endif
-%}

<div
  class="list-collections color-scheme-container color-{{ section_settings.color_scheme }}"
  {% render 'spacing', section: section_settings %}
>
  <div class="{% render 'container', width: section.settings.container_width %}">
    <div class="list-collections__head list-collections__head--{{ section_settings.alignment }}">
      {%- if section_settings.show_title -%}
        <motion-effect {% render 'motion-attrs', kind: 'text', section: section_settings %}>
          <h1 class="list-collections__title">
            {{ section_settings.heading | default: 'collections.list.title' | t }}
          </h1>
        </motion-effect>
      {%- endif -%}

      {%- if section_settings.text != blank -%}
        <div class="list-collections__text rte">{{ section_settings.text }}</div>
      {%- endif -%}

      {%- if section_settings.show_sort and section_settings.collection_list == blank -%}
        {%- comment -%}
          Real links. Shopify serves each order itself, so the sort is shareable
          and the Back button understands it.
        {%- endcomment -%}
        <nav class="list-collections__sort" aria-label="{{ 'collections.list.sort_label' | t }}">
          <ul class="list-collections__sort-list" role="list">
            {%- assign orders = 'alphabetical,alphabetical-reversed,date-reversed,products-high' | split: ',' -%}
            {%- for order in orders -%}
              {%- liquid
                case order
                  when 'alphabetical'
                    assign order_label = 'collections.list.sort_alphabetical' | t
                  when 'alphabetical-reversed'
                    assign order_label = 'collections.list.sort_alphabetical_reversed' | t
                  when 'date-reversed'
                    assign order_label = 'collections.list.sort_newest' | t
                  else
                    assign order_label = 'collections.list.sort_most_products' | t
                endcase
              -%}
              <li>
                <a
                  class="list-collections__sort-link"
                  href="{{ routes.collections_url }}?sort_by={{ order }}"
                  {%- comment -%}
                    No `aria-current` here.

                    It used to be gated on `sort_by == order`, and `sort_by` is not
                    an object Liquid has on this template - Shopify exposes
                    `collection.sort_by` on a collection page and nothing equivalent
                    for the collections list. So the comparison was nil against a
                    string, never true, and the attribute was never written. Marking
                    the active sort needs the current query string, which Liquid
                    cannot read.
                  {%- endcomment -%}
                >
                  {{ order_label }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- comment -%}
      `source`, not `bv`.

      `bv` was never assigned anywhere in this file. `paginate` on nothing gives a
      `paginate` object with no items, so `paginate.items` below was empty, the
      pagination controls never appeared, and the loop underneath walked the whole
      unpaginated list regardless of the per-page setting.
    {%- endcomment -%}
    {%- paginate source by per_page -%}
      {%- capture children -%}
        {%- for item in source -%}
 
          {%- if item.all_products_count > 0 or section_settings.show_empty -%}
            <li class="product-grid__item" data-collection-id="{{ item.id }}">
              {% render 'collection-card',
                 collection: item,
                 index: forloop.index0,
                 priority: forloop.first,
                 ratio: section_settings.image_ratio,
                 show_count: section_settings.show_count,
                 show_description: section_settings.show_description,
                 section: section_settings %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign grid_id = 'CollectionGrid-' | append: section.id  -%}

      {% render 'product-grid',
         children: children,
         paginate: paginate,
         section: section,
         total: paginate.items,
         item_selector: '[data-collection-id]',
         id: grid_id
         %}
    {%- endpaginate -%}

    <div class="list-collections__blocks">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:sections.main_blog.settings.show_title.label",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:shared.text.label"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:sections.main_list_collections.settings.collection_list.label",
      "info": "t:sections.main_list_collections.settings.collection_list.info",
      "limit": 24
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "label": "t:sections.main_list_collections.settings.collections_per_page.label",
      "min": 4,
      "max": 36,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns.desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:shared.columns.tablet.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.columns.mobile.label",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "t:shared.pagination.label",
      "info": "t:shared.pagination.info",
      "options": [
        {
          "value": "paginate",
          "label": "t:shared.pagination.options__1.label"
        },
        {
          "value": "load-more",
          "label": "t:shared.pagination.options__2.label"
        },
        {
          "value": "infinite",
          "label": "t:shared.pagination.options__3.label"
        }
      ],
      "default": "paginate"
    },
    {
      "type": "header",
      "content": "t:sections.main_list_collections.headers.cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:blocks.image.settings.ratio.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:blocks.image.settings.ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:blocks.image.settings.ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:blocks.image.settings.ratio.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:blocks.image.settings.ratio.options__4.label"
        }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.main_list_collections.settings.show_count.label",
      "info": "t:sections.main_list_collections.settings.show_count.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.main_list_collections.settings.show_description.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_empty",
      "label": "t:sections.main_list_collections.settings.show_empty.label",
      "info": "t:sections.main_list_collections.settings.show_empty.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "t:sections.main_list_collections.settings.show_sort.label",
      "info": "t:sections.main_list_collections.settings.show_sort.info",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
      "type": "select",
      "id": "animation_text",
      "label": "t:shared.animation.animation_text.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_text.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_text.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_text.options__4.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "animation_image",
      "label": "t:shared.animation.animation_image.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_image.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_image.options__2.label"
        },
        {
          "value": "fade-in",
          "label": "t:shared.animation.animation_image.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_image.options__4.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "t:sections.main_list_collections.name"
    }
  ]
}
{% endschema %}
