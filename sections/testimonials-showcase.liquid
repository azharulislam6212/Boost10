{% comment %}
  A column of proof beside lanes of video reviews that never stop moving, and
  the modal one of them opens.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif

  assign background_paint = ''
  if has_background_media == false
    assign background_paint = s.background_color | default: ''
  endif

  assign border_line = s.border_style | default: 'none'

  assign bw_top = 0
  assign bw_right = 0
  assign bw_bottom = 0
  assign bw_left = 0
  assign border_any = 0
  assign border_paint = ''

  if border_line != 'none'
    assign bw_top = s.border_width_top | default: 0 | plus: 0
    assign bw_right = s.border_width_right | default: 0 | plus: 0
    assign bw_bottom = s.border_width_bottom | default: 0 | plus: 0
    assign bw_left = s.border_width_left | default: 0 | plus: 0
    assign border_any = bw_top | plus: bw_right | plus: bw_bottom | plus: bw_left

    assign border_percent = s.border_opacity | default: 100 | plus: 0
    if s.border_color == blank
      assign border_paint = 'color-mix(in srgb, currentColor ' | append: border_percent | append: '%, transparent)'
    else
      assign border_alpha = border_percent | divided_by: 100.0
      assign border_paint = s.border_color | color_modify: 'alpha', border_alpha
    endif
  endif

  assign r_tl = s.border_radius_top_left | default: 40 | plus: 0
  assign r_tr = s.border_radius_top_right | default: 40 | plus: 0
  assign r_bl = s.border_radius_bottom_left | default: 0 | plus: 0
  assign r_br = s.border_radius_bottom_right | default: 0 | plus: 0

  assign r_tl_m = s.border_radius_top_left_mobile | default: r_tl | plus: 0
  assign r_tr_m = s.border_radius_top_right_mobile | default: r_tr | plus: 0
  assign r_bl_m = s.border_radius_bottom_left_mobile | default: r_bl | plus: 0
  assign r_br_m = s.border_radius_bottom_right_mobile | default: r_br | plus: 0

  assign margin_top = s.margin_top | default: 0 | plus: 0
  assign margin_bottom = s.margin_bottom | default: 0 | plus: 0

  assign gap_x = s.gap_horizontal | default: 56 | plus: 0
  assign gap_y = s.gap_vertical | default: 40 | plus: 0

  assign gap_x_mobile = s.gap_horizontal_mobile | plus: 0
  if s.gap_horizontal_mobile == nil
    assign gap_x_mobile = 28
  endif
  assign gap_y_mobile = s.gap_vertical_mobile | plus: 0
  if s.gap_vertical_mobile == nil
    assign gap_y_mobile = 20
  endif

  assign lane_gap = s.lane_gap | default: 32 | plus: 0
  assign lane_gap_mobile = s.lane_gap_mobile | plus: 0
  if s.lane_gap_mobile == nil
    assign lane_gap_mobile = 16
  endif

  assign content_pt = s.content_padding_top | default: 80 | plus: 0
  assign content_pb = s.content_padding_bottom | default: 80 | plus: 0
  assign content_pl = s.content_padding_left | default: 0 | plus: 0
  assign content_pr = s.content_padding_right | default: 0 | plus: 0

  assign content_pt_mobile = s.content_padding_top_mobile | plus: 0
  if s.content_padding_top_mobile == nil
    assign content_pt_mobile = 48
  endif
  assign content_pb_mobile = s.content_padding_bottom_mobile | plus: 0
  if s.content_padding_bottom_mobile == nil
    assign content_pb_mobile = 48
  endif
  assign content_pl_mobile = s.content_padding_left_mobile | plus: 0
  if s.content_padding_left_mobile == nil
    assign content_pl_mobile = 0
  endif
  assign content_pr_mobile = s.content_padding_right_mobile | plus: 0
  if s.content_padding_right_mobile == nil
    assign content_pr_mobile = 0
  endif

  assign media_position = s.media_position | default: 'end'
  assign align_items = s.align_items | default: 'center'

  assign intro_width = s.intro_width | default: 0 | plus: 0

  assign show_intro = s.show_intro
  if show_intro == nil
    assign show_intro = true
  endif

  assign show_stats = s.show_stats
  if show_stats == nil
    assign show_stats = true
  endif

  assign modal_autoplay = s.modal_autoplay
  if modal_autoplay == nil
    assign modal_autoplay = false
  endif

  assign modal_id = 'showcase-video-' | append: section.id

  assign pause_on_hover = s.pause_on_hover
  if pause_on_hover == nil
    assign pause_on_hover = true
  endif

  assign accent = s.accent_color | default: ''

  assign lane_stagger = s.animation_stagger | default: 140 | plus: 0
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --sv-gap-x: {{ gap_x }}px;
  --sv-gap-y: {{ gap_y }}px;
  --sv-gap-x-mobile: {{ gap_x_mobile }}px;
  --sv-gap-y-mobile: {{ gap_y_mobile }}px;
  --sv-lanes-gap: {{ lane_gap }}px;
  --sv-lanes-gap-mobile: {{ lane_gap_mobile }}px;
  --sv-content-pt: {{ content_pt }}px;
  --sv-content-pb: {{ content_pb }}px;
  --sv-content-pl: {{ content_pl }}px;
  --sv-content-pr: {{ content_pr }}px;
  --sv-content-pt-mobile: {{ content_pt_mobile }}px;
  --sv-content-pb-mobile: {{ content_pb_mobile }}px;
  --sv-content-pl-mobile: {{ content_pl_mobile }}px;
  --sv-content-pr-mobile: {{ content_pr_mobile }}px;
  --sv-align: {{ align_items }};
  {%- if intro_width > 0 -%}
    --sv-intro-col: {{ intro_width }}px;
  {%- endif -%}
  --showcase-radius: {{ r_tl }}px {{ r_tr }}px {{ r_br }}px {{ r_bl }}px;
  --showcase-radius-mobile: {{ r_tl_m }}px {{ r_tr_m }}px {{ r_br_m }}px {{ r_bl_m }}px;
  --showcase-margin-block-start: {{ margin_top }}px;
  --showcase-margin-block-end: {{ margin_bottom }}px;
  {%- if border_any > 0 -%}
    --showcase-border-width: {{ bw_top }}px {{ bw_right }}px {{ bw_bottom }}px {{ bw_left }}px;
    --showcase-border-style: {{ border_line }};
    --showcase-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
  {%- if accent != '' -%}
    --sv-accent: {{ accent }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="testimonial-showcase color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}{% if has_background_media %} has-background-media{% endif %}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: s %}
  {%- endif -%}

  <div class="{% render 'container', width: s.container_width %}">
    <div class="showcase__layout showcase__layout--media-{{ media_position }}{% if show_intro or show_stats %} showcase__layout--split{% endif %}">
      {%- if show_intro or show_stats -%}

        <motion-effect
          class="showcase__intro"
          {% render 'motion-attrs', kind: 'text', section: s, children: true %}
        >
          {%- if show_intro -%}
            {% content_for 'block', type: '_showcase-intro', id: 'showcase-intro' %}
          {%- endif -%}

          {%- if show_stats -%}
            {% content_for 'block', type: '_showcase-stats', id: 'showcase-stats' %}
          {%- endif -%}
        </motion-effect>
      {%- endif -%}

      <motion-effect
        class="showcase__media"
        {% render 'motion-attrs',
           kind: 'image',
           section: s,
           target: '.showcase-lane',
           stagger: lane_stagger %}
      >
        <testimonial-showcase
          class="showcase__lanes"
          data-modal="{{ modal_id }}"
          data-pause-on-hover="{{ pause_on_hover }}"
          data-modal-autoplay="{{ modal_autoplay }}"
        >
          {% content_for 'blocks' %}
        </testimonial-showcase>
      </motion-effect>
    </div>
  </div>
</div>

{% content_for 'block', type: '_showcase-modal', id: 'showcase-modal' %}

