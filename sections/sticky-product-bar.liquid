{% comment %}
  The buy bar that appears once the real one has scrolled away.
{% endcomment %}

{%- liquid
  assign target = product | default: closest.product
  assign form_id = section.settings.form_section_id | default: 'main'

  # No `variant` alias. The bar reads the variant through `target` where it needs
  # it, and `<sticky-add-to-cart>` re-reads it on every variant change - a value
  # captured once at render time would be the wrong one the moment a customer
  # picked a different size.
-%}

{%- if target != blank and section.settings.enable -%}
  {% render 'sticky-add-to-cart',
     product: target,
     form_id: form_id,
     id: section.id,
     position: section.settings.position,
     show_image: section.settings.show_image,
     show_variants: section.settings.show_variants,
     show_quantity: section.settings.show_quantity %}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.sticky_product_bar.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "t:sections.sticky_product_bar.settings.enable.label",
      "default": true
    },
    {
      "type": "text",
      "id": "form_section_id",
      "label": "t:sections.sticky_product_bar.settings.form_section_id.label",
      "info": "t:sections.sticky_product_bar.settings.form_section_id.info",
      "default": "main"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:sections.sticky_product_bar.settings.position.label",
      "options": [
        {
          "value": "bottom",
          "label": "t:sections.sticky_product_bar.settings.position.options__1.label"
        },
        {
          "value": "top",
          "label": "t:sections.sticky_product_bar.settings.position.options__2.label"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.sticky_product_bar.settings.show_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_variants",
      "label": "t:sections.sticky_product_bar.settings.show_variants.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:sections.sticky_product_bar.settings.show_quantity.label",
      "default": false
    }
  ]
}
{% endschema %}
