{% comment %}
  Login and password recovery, on one page.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
-%}

<div
  class="customer customer--login color-scheme-container color-{{ section_settings.color_scheme }}"
  {% render 'spacing', section: section_settings %}
>
  <div class="container customer__inner">

    <div class="customer__panel customer__panel--recover" id="recover" tabindex="-1">
      <h1 class="customer__title">{{ 'customer.recover_password.title' | t }}</h1>
      <p class="customer__intro">{{ 'customer.recover_password.subtext' | t }}</p>

      <validated-form>
        {%- form 'recover_customer_password', class: 'customer__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="customer__success" role="status" tabindex="-1">
              {{ 'customer.recover_password.success' | t }}
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="customer__errors" role="alert" tabindex="-1">
              <ul role="list">
                {%- for field in form.errors -%}
                  <li>
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="form-field">
            <label for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
            <input
              id="RecoverEmail"
              type="email"
              name="email"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              {% if form.errors %}aria-invalid="true"{% endif %}
            >
          </div>

          <button type="submit" class="button button--primary button--full">
            {{ 'customer.recover_password.submit' | t }}
          </button>

          <a class="customer__switch" href="#login">{{ 'customer.recover_password.cancel' | t }}</a>
        {%- endform -%}
      </validated-form>
    </div>

    <div class="customer__panel customer__panel--login" id="login" tabindex="-1">
      <h1 class="customer__title">
        {{ section_settings.heading | default: 'customer.login.title' | t }}
      </h1>

      <validated-form>
        {%- form 'customer_login', class: 'customer__form' -%}
          {%- if form.errors -%}
            <div class="customer__errors" role="alert" tabindex="-1">
              <ul role="list">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="form-field">
            <label for="LoginEmail">{{ 'customer.login.email' | t }}</label>
            <input
              id="LoginEmail"
              type="email"
              name="customer[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              {% if form.errors %}aria-invalid="true"{% endif %}
            >
          </div>

          {%- if form.password_needed -%}
            <div class="form-field">
              <label for="LoginPassword">{{ 'customer.login.password' | t }}</label>
              <input
                id="LoginPassword"
                type="password"
                name="customer[password]"
                autocomplete="current-password"
                required
              >
              <a class="customer__forgot" href="#recover">{{ 'customer.login.forgot_password' | t }}</a>
            </div>
          {%- endif -%}

          <button type="submit" class="button button--primary button--full">
            {{ 'customer.login.submit' | t }}
          </button>
        {%- endform -%}
      </validated-form>

      {%- if shop.customer_accounts_enabled -%}
        <p class="customer__alt">
          {{ 'customer.login.no_account' | t }}
          <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
        </p>
      {%- endif -%}

      {%- if section_settings.text != blank -%}
        <div class="customer__note rte">{{ section_settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_login.name",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:shared.heading.label" },
    { "type": "richtext", "id": "text", "label": "t:shared.text.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label", "default": "scheme-1" },
    { "type": "header", "content": "t:shared.spacing.section_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_top_mobile", "label": "t:shared.spacing.padding_top_mobile.label", "info": "t:shared.spacing.padding_top_mobile.info", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "t:shared.spacing.padding_bottom_mobile.label", "info": "t:shared.spacing.padding_bottom_mobile.info", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 50 }
  ]
}
{% endschema %}
