{% comment %}
  sections/main-activate-account.liquid

  Set a password from an invitation.

  Declining is a real submit button, not a link, because it posts a decline to
  Shopify rather than navigating. It is styled quietly and placed after the
  primary action: a customer who clicked an invitation email meant to accept it.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
-%}

<div
  class="customer customer--activate color-{{ section_settings.color_scheme }}"
  {% render 'spacing', section: section_settings %}
>
  <div class="container customer__inner">
    <div class="customer__panel">
      <h1 class="customer__title">{{ 'customer.activate_account.title' | t }}</h1>
      <p class="customer__intro">{{ 'customer.activate_account.subtext' | t }}</p>

      <validated-form>
        {%- form 'activate_customer_password', class: 'customer__form' -%}
          {%- if form.errors -%}
            <div class="customer__errors" role="alert" tabindex="-1">
              <ul role="list">
                {%- for field in form.errors -%}
                  <li>
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="form-field">
            <label for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
            <input
              id="ActivatePassword"
              type="password"
              name="customer[password]"
              autocomplete="new-password"
              required
              aria-describedby="ActivatePasswordHelp"
            >
            <p class="form-field__help" id="ActivatePasswordHelp">
              {{ 'customer.register.password_help' | t }}
            </p>
          </div>

          <div class="form-field">
            <label for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
            <input
              id="ActivatePasswordConfirm"
              type="password"
              name="customer[password_confirmation]"
              autocomplete="new-password"
              required
            >
          </div>

          <button type="submit" class="button button--primary button--full">
            {{ 'customer.activate_account.submit' | t }}
          </button>

          <button type="submit" name="decline" class="button button--link button--full">
            {{ 'customer.activate_account.decline' | t }}
          </button>
        {%- endform -%}
      </validated-form>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_activate_account.name",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label", "default": "scheme-1" },
    { "type": "header", "content": "t:shared.spacing.section_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "t:shared.spacing.padding_top_mobile.label", "info": "t:shared.spacing.padding_top_mobile.info", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "t:shared.spacing.padding_bottom_mobile.label", "info": "t:shared.spacing.padding_bottom_mobile.info", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ]
}
{% endschema %}
