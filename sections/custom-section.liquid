          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_section.presets.default.name",
      "category": "t:categories.layout",
      "settings": {
        "container_width": "standard",
        "direction": "column",
        "alignment": "center",
        "gap_vertical": 24,
        "gap_vertical_mobile": 16
      },
      "blocks": [
        {
          "type": "section-header",
          "settings": {
            "direction": "column",
            "alignment": "center",
            "position": "start",
            "gap_vertical": 16,
            "gap_vertical_mobile": 12,
            "width": "fill"
          },
          "blocks": [
            {
              "type": "subheading",
              "settings": {
                "text": "<p>Section</p>",
                "preset": "subheading",
                "width": "fit",
                "icon_source": "icon",
                "icon": "star",
