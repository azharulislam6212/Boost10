{% comment %}
  sections/main-reset-password.liquid

  Set a new password from a reset link.

  The password rule is stated before the field, not after a failed submit.
  Shopify enforces a five character minimum; telling a customer that up front
  costs one line and saves a round trip on the page where they are already
  frustrated.

  No strength meter. A meter that scores against its own arbitrary rules while
  Shopify enforces different ones tells the customer their password is weak and
  then accepts it, or calls it strong and then rejects it.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
-%}

<div
  class="customer customer--reset color-scheme-container color-{{ section_settings.color_scheme }}"
  {% render 'spacing', section: section_settings %}
>
  <div class="container customer__inner">
    <div class="customer__panel">
      <h1 class="customer__title">{{ 'customer.reset_password.title' | t }}</h1>
      {%- comment -%}
    `email` is a global Shopify exposes on the reset-password template only, so
    theme-check cannot see where it comes from and reports it as undefined. It
    is not: the address is the one the customer asked the reset for, and there
    is nothing else to read it from.
  {%- endcomment -%}
  {% # theme-check-disable UndefinedObject %}
  <p class="customer__intro">{{ 'customer.reset_password.subtext' | t: email: email }}</p>
  {% # theme-check-enable UndefinedObject %}

      <validated-form>
        {%- form 'reset_customer_password', class: 'customer__form' -%}
          {%- if form.errors -%}
            <div class="customer__errors" role="alert" tabindex="-1">
              <ul role="list">
                {%- for field in form.errors -%}
                  <li>
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="form-field">
            <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
            <input
              id="ResetPassword"
              type="password"
              name="customer[password]"
              autocomplete="new-password"
              minlength="5"
              required
              aria-describedby="ResetPasswordHelp"
            >
            <p class="form-field__help" id="ResetPasswordHelp">
              {{ 'customer.register.password_help' | t }}
            </p>
          </div>

          <div class="form-field">
            <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
            <input
              id="ResetPasswordConfirm"
              type="password"
              name="customer[password_confirmation]"
              autocomplete="new-password"
              minlength="5"
              required
            >
          </div>

          <button type="submit" class="button button--primary button--full">
            {{ 'customer.reset_password.submit' | t }}
          </button>
        {%- endform -%}
      </validated-form>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_reset_password.name",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label", "default": "scheme-1" },
    { "type": "header", "content": "t:shared.spacing.section_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_top_mobile", "label": "t:shared.spacing.padding_top_mobile.label", "info": "t:shared.spacing.padding_top_mobile.info", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "t:shared.spacing.padding_bottom_mobile.label", "info": "t:shared.spacing.padding_bottom_mobile.info", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 50 }
  ]
}
{% endschema %}
