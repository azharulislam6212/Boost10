{% comment %}
  The same shape as the collection page, because a customer filtering search
  results expects exactly what they get on a collection.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
  assign per_page = section_settings.products_per_page | default: 24
  assign desktop = section_settings.columns_desktop | default: 4
  assign card_sizes = '(min-width: 990px) ' | append: 100 | divided_by: desktop | append: 'vw, (min-width: 750px) 33vw, 50vw'
-%}

<results-list
  class="search-results color-scheme-container color-{{ section_settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-pagination="{{ section_settings.pagination_type }}"
  data-item-selector="[data-product-id]"
  data-page="{{ current_page | default: 1 }}"
  data-total="{{ search.results_count }}"
  role="region"
  aria-label="{{ search.terms | default: 'products.facets.title' | t | escape }}"
  {% render 'spacing', section: section_settings %}
>
  <a class="skip-to-content-link visually-hidden" href="#MainContent">
    {{ 'accessibility.skip_to_content' | t }}
  </a>

  <div class="{% render 'container', width: section.settings.container_width %}">

    {%- if section_settings.show_type_tabs and search.performed -%}
      {%- assign query = search.terms | url_encode -%}

      <nav class="search-tabs" aria-label="{{ 'search.filter_by_type' | t }}">
        <ul class="search-tabs__list" role="list">
          <li>
            <a
              class="search-tabs__link"
              href="{{ routes.search_url }}?q={{ query }}&options%5Bprefix%5D=last"
              {% if search.types.size == 0 or search.types.size > 1 %}aria-current="page"{% endif %}
            >
              {{ 'search.type_all' | t }}
            </a>
          </li>

          {%- assign types = 'product,article,page' | split: ',' -%}
          {%- for type in types -%}
            {%- liquid
              case type
                when 'product'
                  assign type_label = 'search.type_products' | t
                when 'article'
                  assign type_label = 'search.type_articles' | t
                else
                  assign type_label = 'search.type_pages' | t
              endcase

              assign is_current = false
              if search.types.size == 1 and search.types.first == type
                assign is_current = true
              endif
            -%}

            <li>
              <a
                class="search-tabs__link"
                href="{{ routes.search_url }}?q={{ query }}&type={{ type }}&options%5Bprefix%5D=last"
                {% if is_current %}aria-current="page"{% endif %}
              >
                {{ type_label }}

                {%- if is_current -%}
                  <span class="search-tabs__count">{{ search.results_count }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if search.performed -%}
    {% paginate search.results by per_page %}
      {% content_for 'block',
        type: '_filters',
        id: 'filters',
        results: search,
        results_size: search.results_count,
        paginate: paginate
      %}

      {%- liquid
        assign grid_mode = section.settings.pagination_type | default: settings.pagination_type | default: 'paginate'
        assign grid_total = search.results_count
        assign grid_id = 'ProductGrid-' | append: section.id
        assign grid_desktop = section.settings.columns_desktop | default: 4
        assign grid_tablet = section.settings.columns_tablet | default: 3
        assign grid_mobile = section.settings.columns_mobile | default: 2
      -%}

      <div class="product-grid-wrapper">
        <h2 class="visually-hidden">{{ 'products.facets.title' | t }}</h2>

        {%- if paginate.previous and grid_mode != 'paginate' -%}
          <button
            type="button"
            class="button button--secondary results-list__load-previous"
            data-ref="loadPrevious"
            data-prev-url="{{ paginate.previous.url }}"
            hidden
          >
            {{ 'general.pagination.load_previous' | t }}
          </button>
        {%- endif -%}

        <ul
          class="product-grid"
          id="{{ grid_id }}"
          data-ref="grid"
          role="list"
          style="--columns-desktop: {{ grid_desktop }}; --columns-tablet: {{ grid_tablet }}; --columns-mobile: {{ grid_mobile }};"
        >
        {%- for product in search.results -%}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            data-result-type="{{ product.object_type }}"
          >

            {%- case product.object_type -%}
              {%- when 'article' -%}
                {% render 'article-card', article: product, index: forloop.index0 %}

              {%- when 'page' -%}
                <div class="search-page-result">
                  <h3 class="search-page-result__title">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h3>
                  {%- if product.content != blank -%}
                    <p class="search-page-result__excerpt">
                      {{ product.content | strip_html | truncatewords: 30 }}
                    </p>
                  {%- endif -%}
                </div>

              {%- else -%}
                {% content_for 'block',
                  type: '_product-card',
                  id: 'product-card',
                  product: product,
                  index: forloop.index0,
                  priority: forloop.first,
                  sizes: card_sizes
                %}
            {%- endcase -%}
          </li>
        {%- endfor -%}

        </ul>

        {%- capture search_reset_url -%}
          {{ routes.search_url }}?q={{ search.terms | url_encode }}&options%5Bprefix%5D=last
        {%- endcapture -%}
        {%- assign search_reset_url = search_reset_url | strip -%}

        {%- liquid
          assign has_active_filters = false
          for filter in search.filters
            if filter.active_values.size > 0
              assign has_active_filters = true
              break
            endif
            if filter.min_value.value != blank or filter.max_value.value != blank
              assign has_active_filters = true
              break
            endif
          endfor
        -%}

        <div class="product-grid__empty" data-ref="empty" {% if grid_total > 0 %}hidden{% endif %}>
          {%- if has_active_filters -%}
            {% render 'search-empty', context: 'filters', url: search_reset_url %}
          {%- else -%}
            {% render 'search-empty', context: 'search', terms: search.terms, url: routes.search_url %}
          {%- endif -%}
        </div>

        <div class="product-grid__pagination">
          {% render 'pagination', paginate: paginate, type: grid_mode %}
        </div>

        <p class="visually-hidden" data-ref="status" role="status"></p>
      </div>

    {% endpaginate %}
    {%- endif -%}

    <div class="collection-results__blocks">
      {% content_for 'blocks' %}
    </div>
  </div>
</results-list>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "_filters"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_search.paragraph"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.main_collection.settings.products_per_page.label",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns.desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:shared.columns.tablet.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.columns.mobile.label",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "t:shared.pagination.label",
      "info": "t:shared.pagination.info",
      "options": [
        {
          "value": "paginate",
          "label": "t:shared.pagination.options__1.label"
        },
        {
          "value": "load-more",
          "label": "t:shared.pagination.options__2.label"
        },
        {
          "value": "infinite",
          "label": "t:shared.pagination.options__3.label"
        }
      ],
      "default": "paginate"
    },
    {
      "type": "checkbox",
      "id": "show_type_tabs",
      "label": "t:sections.main_search.settings.show_type_tabs.label",
      "info": "t:sections.main_search.settings.show_type_tabs.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.main_collection.settings.enable_sorting.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main_collection.settings.enable_filtering.label",
      "info": "t:sections.main_collection.settings.enable_filtering.info",
      "default": true
    },
    {
      "type": "select",
      "id": "facets_layout",
      "label": "t:settings_schema.search.settings.facets_layout.label",
      "options": [
        {
          "value": "drawer",
          "label": "t:settings_schema.search.settings.facets_layout.options__1.label"
        },
        {
          "value": "sidebar",
          "label": "t:settings_schema.search.settings.facets_layout.options__2.label"
        }
      ],
      "default": "sidebar"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    }
  ]
}
{% endschema %}
