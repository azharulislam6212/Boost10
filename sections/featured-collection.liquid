      "visible_if": "{{ section.settings.carousel_custom_colors and section.settings.carousel_pagination != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name",
      "category": "Collections",
      "blocks": [
