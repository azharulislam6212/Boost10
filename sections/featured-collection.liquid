      "id": "carousel_nav_icon",
      "label": "t:shared.carousel.nav_icon.label",
      "options": [
        {
          "value": "chevron",
          "label": "t:shared.carousel.nav_icon.options__1.label"
        },
        {
          "value": "arrow",
          "label": "t:shared.carousel.nav_icon.options__2.label"
        },
        {
          "value": "play",
          "label": "t:shared.carousel.nav_icon.options__3.label"
        },
        {
          "value": "external",
          "label": "t:shared.carousel.nav_icon.options__4.label"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.carousel_navigation }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_style",
      "label": "t:shared.carousel.controls_style.label",
      "info": "t:shared.carousel.controls_style.info",
      "options": [
        {
          "value": "split",
          "label": "t:shared.carousel.controls_style.options__1.label"
        },
        {
          "value": "ghost",
          "label": "t:shared.carousel.controls_style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:shared.carousel.controls_style.options__3.label"
        }
      ],
      "default": "split",
      "visible_if": "{{ section.settings.carousel_navigation }}"
    },
    {
      "type": "range",
      "id": "carousel_nav_size",
      "label": "t:shared.carousel.nav_size.label",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44,
      "visible_if": "{{ section.settings.carousel_navigation }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.pagination"
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "t:shared.carousel.pagination.label",
      "info": "t:shared.carousel.pagination.info",
      "options": [
        {
          "value": "none",
          "label": "t:shared.carousel.pagination.options__1.label"
        },
        {
          "value": "dots",
          "label": "t:shared.carousel.pagination.options__2.label"
        },
        {
          "value": "numbers",
          "label": "t:shared.carousel.pagination.options__3.label"
        },
        {
          "value": "progress",
          "label": "t:shared.carousel.pagination.options__4.label"
        },
        {
          "value": "controls",
          "label": "t:shared.carousel.pagination.options__5.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "carousel_controls_align",
      "label": "t:shared.carousel.controls_align.label",
      "options": [
        {
          "value": "start",
          "label": "t:shared.carousel.controls_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:shared.carousel.controls_align.options__2.label"
        },
        {
          "value": "end",
          "label": "t:shared.carousel.controls_align.options__3.label"
        }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.carousel_pagination == 'controls' }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.colors"
    },
    {
      "type": "paragraph",
      "content": "t:shared.carousel.paragraphs.colors"
    },
    {
      "type": "checkbox",
      "id": "carousel_custom_colors",
      "label": "t:shared.carousel.custom_colors.label",
      "info": "t:shared.carousel.custom_colors.info",
      "default": false
    },
    {
      "type": "select",
      "id": "carousel_nav_style",
      "label": "t:shared.carousel.nav_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.carousel.nav_style.options__1.label"
        },
        {
          "value": "gradient",
          "label": "t:shared.carousel.nav_style.options__2.label"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_bg",
      "label": "t:shared.carousel.nav_bg.label",
      "visible_if": "{{ section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_bg_hover",
      "label": "t:shared.carousel.nav_bg_hover.label",
      "visible_if": "{{ section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'solid' }}"
    },
