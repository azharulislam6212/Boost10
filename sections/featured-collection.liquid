      "id": "columns_tablet",
      "label": "t:shared.carousel.columns_tablet.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "t:shared.carousel.columns_mobile.label",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.motion"
    },
    {
      "type": "range",
      "id": "carousel_speed",
      "label": "t:shared.carousel.speed.label",
      "info": "t:shared.carousel.speed.info",
      "min": 100,
      "max": 1500,
      "step": 50,
      "unit": "ms",
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "carousel_loop",
      "label": "t:shared.carousel.loop.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "t:shared.carousel.autoplay.label",
      "info": "t:shared.carousel.autoplay.info",
      "default": false
    },
    {
      "type": "range",
      "id": "carousel_autoplay_delay",
      "label": "t:shared.carousel.autoplay_delay.label",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.carousel_autoplay }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.peek"
    },
    {
      "type": "paragraph",
      "content": "t:shared.carousel.paragraphs.peek"
    },
    {
      "type": "range",
      "id": "carousel_peek_mobile",
      "label": "t:shared.carousel.peek_mobile.label",
      "info": "t:shared.carousel.peek_mobile.info",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "carousel_peek_desktop",
      "label": "t:shared.carousel.peek_desktop.label",
      "info": "t:shared.carousel.peek_desktop.info",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.navigation"
    },
    {
      "type": "checkbox",
      "id": "carousel_navigation",
      "label": "t:shared.carousel.navigation.label",
      "default": true
