{% comment %}
  A heading cluster over a grid of theme blocks that can run as a carousel.
{% endcomment %}

{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif

  assign desktop = s.columns_desktop
  assign cols_mobile = s.columns_mobile | plus: 0
  assign carousel_id = 'featured-collection-' | append: section.id

  assign product_limit = s.products_to_show
  assign show_placeholder = false
  assign cs_count = s.collection.products | size
  if s.collection == blank or cs_count == 0
    assign show_placeholder = true
    assign cs_count = product_limit
  endif
  if cs_count > product_limit
    assign cs_count = product_limit
  endif

  capture cs_layout
    render 'carousel-layout', settings: s, count: cs_count, columns: desktop
  endcapture
  capture cs_layout_mobile
    render 'carousel-layout', settings: s, mobile: true
  endcapture
  assign cs_layout = cs_layout | strip
  assign cs_layout_mobile = cs_layout_mobile | strip

  assign cs_nav = s.carousel_navigation
  if cs_nav == nil
    assign cs_nav = false
  endif

  assign panel_controls = false
  if cs_layout_mobile == 'carousel'
    if cs_nav or s.carousel_pagination != 'none'
      assign panel_controls = true
    endif
  endif

  assign panel_controls_class = 'featured-collection-panel__controls--always'
  if cs_layout != 'carousel'
    assign panel_controls_class = 'featured-collection-panel__controls--mobile'
  endif
-%}

{%- capture panel -%}
  {% content_for 'block',
    type: '_featured-collection-panel',
    id: 'featured-collection-panel',
    carousel: carousel_id,
    controls: panel_controls,
    controls_class: panel_controls_class
  %}
{%- endcapture -%}

{%- liquid
  assign show_panel = false
  assign nav_position = 'bottom'
  assign peek_desktop = nil
  assign layout_classes = 'featured-collection-section__layout'

  if panel contains 'featured-collection-panel'
    assign show_panel = true
    assign nav_position = nil
    assign peek_desktop = 87
    assign layout_classes = layout_classes | append: ' featured-collection-section__layout--with-panel'
    if cs_layout == 'carousel'
      assign layout_classes = layout_classes | append: ' featured-collection-section__layout--bleed'
    endif
  endif

  capture content_classes
    render 'section-content', settings: s, output: 'class'
  endcapture
  capture content_style
    render 'section-content', settings: s, output: 'style'
  endcapture
  capture section_style
    render 'spacing', section: s, declarations: true
    render 'section-frame', settings: s, media: true
  endcapture
-%}

<div
  class="section featured-collection-section color-scheme color-{{ s.color_scheme | default: 'scheme-1' }}{% if has_background_media %} has-background-media{% endif %}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: s, placeholder: 'hero-apparel-1' %}
  {%- endif -%}

  <div class="section-inner {% render 'container', width: s.container_width %}">
    <motion-effect
      class="{{ content_classes }}"
      data-easing="outQuint"
      style="{{ content_style | strip_newlines | strip }}"
      {% render 'motion-attrs', kind: 'content', section: s, children: true, duration: 1000 %}
    >
      {% content_for 'block', type: 'section-header', id: 'featured-collection-header' %}
      {% content_for 'blocks' %}

      {%- if cs_count > 0 -%}
        <div class="{{ layout_classes }}">
          {%- if show_panel -%}{{ panel }}{%- endif -%}
          <carousel-slider
            {% render 'carousel-shell-attrs',
               settings: s,
               id: carousel_id,
               layout: cs_layout,
               layout_mobile: cs_layout_mobile,
               classes: 'featured-collection-section__carousel',
               columns_desktop: desktop,
               columns_tablet: s.columns_tablet,
               columns_mobile: cols_mobile,
               peek_desktop: peek_desktop,
               count: cs_count %}
          >
            <div
              class="carousel-shell__track featured-collection-section__grid"
              data-ref="track"
              {% if cs_layout_mobile == 'carousel' %}aria-label="{{ 'accessibility.carousel' | t | escape }}"{% endif %}
            >
              {%- if show_placeholder -%}
                {%- for i in (1..cs_count) -%}
                  {% content_for 'block', type: '_product-card', id: 'product-card', placeholder: true, index: forloop.index0 %}
                {%- endfor -%}
              {%- else -%}
                {%- for product in s.collection.products limit: product_limit -%}
                  {% content_for 'block', type: '_product-card', id: 'product-card', product: product, index: forloop.index0 %}
                {%- endfor -%}
              {%- endif -%}
            </div>

            {% render 'carousel-shell-tail',
               settings: s,
               count: cs_count,
               layout: cs_layout,
               layout_mobile: cs_layout_mobile,
               detached: show_panel,
               nav_position: nav_position %}
          </carousel-slider>
        </div>
      {%- endif -%}
    </motion-effect>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@theme"
