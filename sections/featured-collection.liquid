    {
      "type": "select",
      "id": "carousel_nav_position",
      "label": "t:shared.carousel.nav_position.label",
      "info": "t:shared.carousel.nav_position.info",
      "options": [
        {
          "value": "outside",
          "label": "t:shared.carousel.nav_position.options__1.label"
        },
        {
          "value": "inside",
          "label": "t:shared.carousel.nav_position.options__2.label"
        },
        {
          "value": "bottom",
          "label": "t:shared.carousel.nav_position.options__3.label"
        },
        {
          "value": "inline",
          "label": "t:shared.carousel.nav_position.options__4.label"
        }
      ],
      "default": "outside",
      "visible_if": "{{ section.settings.carousel_navigation }}"
    },
    {
