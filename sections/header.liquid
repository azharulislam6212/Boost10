{% comment %}
  sections/header.liquid — Boost10

  ## The slot grid, and why the header is built out of captures

  
  Every element in the header — logo, navigation, search, localization,
  utilities — is placed by two settings: a *row* (top or bottom) and a
  *position* (start, centre or end). That is ten independent placements from
  five settings, and writing them as nested conditionals produces markup that
  nobody can read and that silently drops an element when two conditions
  overlap.

  So each element is captured once into a string, then appended to one of six
  slot buffers. The slots are emitted at the end. An element can only ever land
  in one slot, the row disappears entirely when all three of its slots are
  empty, and adding a seventh element later is one capture and one append
  rather than a rewrite.

  ## Sticky is a mode, not two booleans

  `sticky` + `hide_on_scroll` as separate checkboxes produced a state nobody
  wanted — "not sticky, but hides on scroll" — and the CSS had to defend
  against it. One `sticky_mode` select has four values and no impossible
  combinations:

    never       stays in the flow
    always      pinned from the first pixel
    scroll-up   pinned, hides going down, returns going up
    scroll-down pinned, appears only once the page has scrolled past a fold

  ## Transparency is per template, and it is two things

  `site-header--transparent` is written here and means "this template supports
  transparency". `[data-transparent]` is written by the component and means "be
  transparent right now". Keeping them apart is what lets the header render
  correctly with JavaScript off: the class alone gives a transparent header over
  the hero, and it simply never turns solid.

  A template only opts in when its first section is one that can sit behind a
  header. There is no way to ask Liquid what the first section is, so the
  merchant states it per page type instead of the theme guessing and getting it
  wrong on the one store that put a rich-text block at the top.
{% endcomment %}


{%- liquid
  assign st = section.settings
  assign menu = st.menu

  # ---- height -------------------------------------------------------------
  case st.header_height
    when 'compact'
      assign row_height = 56
    when 'large'
      assign row_height = 96
    when 'custom'
      assign row_height = st.header_height_custom | default: 72
    else
      assign row_height = 72
  endcase

  # ---- transparency -------------------------------------------------------
  # Read once into three plain variables so the markup below never has to ask
  # which page type it is on again.
  assign supports_transparent = false
  assign inverse_logo = false
  assign transparent_text = blank

  case request.page_type
    when 'index'
      assign supports_transparent = st.transparent_home
      assign inverse_logo = st.inverse_logo_home
      assign transparent_text = st.transparent_text_home
    when 'product'
      assign supports_transparent = st.transparent_product
      assign inverse_logo = st.inverse_logo_product
      assign transparent_text = st.transparent_text_product
    when 'collection', 'list-collections'
      assign supports_transparent = st.transparent_collection
      assign inverse_logo = st.inverse_logo_collection
      assign transparent_text = st.transparent_text_collection
    when 'article', 'blog'
      assign supports_transparent = st.transparent_blog
      assign inverse_logo = st.inverse_logo_blog
      assign transparent_text = st.transparent_text_blog
  endcase

  # ---- cart ---------------------------------------------------------------
  assign cart_is_drawer = false
  if settings.cart_type == 'drawer'
    assign cart_is_drawer = true
  endif

  assign cart_count = cart.item_count
  if st.cart_count_padded and cart_count < 10
    assign cart_count_display = cart_count | prepend: '0'
  else
    assign cart_count_display = cart_count
  endif

  # ---- classes ------------------------------------------------------------
  assign header_classes = 'site-header color-' | append: st.color_scheme
  assign header_classes = header_classes | append: ' site-header--shape-' | append: st.header_shape
  if supports_transparent
    assign header_classes = header_classes | append: ' site-header--transparent'
  endif
  if inverse_logo
    assign header_classes = header_classes | append: ' site-header--inverse-logo'
  endif
-%}

{%- comment -%}
  ---------------------------------------------------------------------------
  Slot captures. Each block below produces one fragment and drops it into one
  of `slot_top_start` … `slot_bottom_end`.
  ---------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign slot_top_start = ''
  assign slot_top_center = ''
  assign slot_top_end = ''
  assign slot_bottom_start = ''
  assign slot_bottom_center = ''
  assign slot_bottom_end = ''
-%}

{%- capture fragment_logo -%}
  {% render 'header-logo', inverse: inverse_logo %}
{%- endcapture -%}

{%- capture fragment_nav -%}
  {% render 'header-nav', menu: menu %}
{%- endcapture -%}

{%- comment -%}
  Search is no longer slotted. `header-actions` renders it beside the account and
  cart controls, which is where a customer looks for it.
{%- endcomment -%}
{%- assign fragment_search = '' -%}

{%- capture fragment_localization -%}
  {% render 'header-localization', context: 'header' %}
{%- endcapture -%}

{%- liquid
  # Logo
  case st.logo_position
    when 'center'
      assign slot_top_center = slot_top_center | append: fragment_logo
    when 'right'
      assign slot_top_end = slot_top_end | append: fragment_logo
    else
      assign slot_top_start = slot_top_start | append: fragment_logo
  endcase

  # Navigation
  #
  # A centred logo and a centred menu both land in the same slot, and the slot
  # centres the pair — so the logo is never on the centre line and the setting
  # looks broken. There is only one centre, so the logo takes it and the menu
  # steps aside to the start. The merchant asked for a centred logo; that is the
  # setting that wins.
  assign menu_place = st.menu_position
  if st.logo_position == 'center' and st.menu_position == 'center' and st.menu_row == 'top'
    assign menu_place = 'left'
  endif

  if st.menu_row == 'bottom'
    case menu_place
      when 'center'
        assign slot_bottom_center = slot_bottom_center | append: fragment_nav
      when 'right'
        assign slot_bottom_end = slot_bottom_end | append: fragment_nav
      else
        assign slot_bottom_start = slot_bottom_start | append: fragment_nav
    endcase
  else
    case menu_place
      when 'center'
        assign slot_top_center = slot_top_center | append: fragment_nav
      when 'right'
        assign slot_top_end = slot_top_end | append: fragment_nav
      else
        assign slot_top_start = slot_top_start | append: fragment_nav
    endcase
  endif

  # Localization
  if st.localization_row == 'bottom'
    if st.localization_position == 'left'
      assign slot_bottom_start = slot_bottom_start | append: fragment_localization
    else
      assign slot_bottom_end = slot_bottom_end | append: fragment_localization
    endif
  else
    if st.localization_position == 'left'
      assign slot_top_start = slot_top_start | append: fragment_localization
    else
      assign slot_top_end = slot_top_end | append: fragment_localization
    endif
  endif

  # Search
  if st.search_row == 'bottom'
    if st.search_position == 'left'
      assign slot_bottom_start = slot_bottom_start | append: fragment_search
    else
      assign slot_bottom_end = slot_bottom_end | append: fragment_search
    endif
  else
    if st.search_position == 'left'
      assign slot_top_start = slot_top_start | append: fragment_search
    else
      assign slot_top_end = slot_top_end | append: fragment_search
    endif
  endif

  assign bottom_row = slot_bottom_start | append: slot_bottom_center | append: slot_bottom_end | strip
-%}

{%- comment -%}
  The header's height, published before a single frame is painted.

  `--header-height` is written by `<sticky-header>` from `offsetHeight`, which is
  correct and arrives late. Until it does, the transparent header's offset on
  `#MainContent` resolves to `0` — so the banner starts *below* the header, and
  then jumps up by the header's height the moment the module loads. That vertical
  jump is what makes the whole header look like it is assembling itself.

  The height is knowable from the settings, so it is stated here. CSS uses this
  from the first paint and the measured value afterwards; they agree, so nothing
  moves.
{%- endcomment -%}
{%- comment -%}
  The stated height has to match the painted one to the pixel, because
  `#MainContent` is pulled up by exactly this number. Three things were missing
  from the old sum, and every one of them left the banner sitting *higher* than
  the header — far enough, with the default settings, to climb into the
  announcement bar above it.

    1. The shell's border. `border: var(--header-border-width) solid` is on the
       box, top and bottom, so it is two more thicknesses of header.

    2. The bottom row. A merchant who moves the menu or the market pickers to
       the second row gets a header that is a whole row taller than this said.

    3. The mobile padding fallback. `snippets/spacing.liquid` only emits the
       mobile custom properties when the merchant set them; left at 0 the
       stylesheet falls back to the *desktop* value, which is the documented
       behaviour of those sliders. Reading `padding_top_mobile` raw claimed 0
       where the page was actually painting 12.
{%- endcomment -%}
{%- liquid
  assign border_total = st.border_thickness | default: 0 | plus: 0 | times: 2

  # ---- desktop ------------------------------------------------------------
  assign header_block_size = row_height | plus: st.padding_top | plus: st.padding_bottom | plus: border_total

  # ---- mobile: the sliders fall back to the desktop value at 0 -------------
  assign pad_top_mobile = st.padding_top_mobile | default: 0 | plus: 0
  if pad_top_mobile == 0
    assign pad_top_mobile = st.padding_top | default: 0 | plus: 0
  endif

  assign pad_bottom_mobile = st.padding_bottom_mobile | default: 0 | plus: 0
  if pad_bottom_mobile == 0
    assign pad_bottom_mobile = st.padding_bottom | default: 0 | plus: 0
  endif

  assign header_block_size_mobile = 54 | plus: pad_top_mobile | plus: pad_bottom_mobile | plus: border_total

  # ---- the second row, when there is one ----------------------------------
  # `--header-row-height * 0.7` plus its 1px top rule, mirroring header.css.
  if bottom_row != blank
    assign bottom_extra = row_height | times: 70 | divided_by: 100 | plus: 1
    assign header_block_size = header_block_size | plus: bottom_extra

    assign bottom_extra_mobile = 54 | times: 72 | divided_by: 100 | plus: 1
    assign header_block_size_mobile = header_block_size_mobile | plus: bottom_extra_mobile
  endif
-%}

{% style %}
  :root {
    --header-block-size: {{ header_block_size }}px;
  }

  @media screen and (max-width: 989px) {
    :root {
      --header-block-size: {{ header_block_size_mobile }}px;
    }
  }
{% endstyle %}

{%- comment -%}
  The spacing snippet's declarations, captured rather than rendered.

  `{% render 'spacing' %}` emits its own `style=` attribute, and this element
  already has one. Two `style` attributes on one tag and the browser keeps the
  first and silently drops the second — so the header's padding never reached
  the page at all. The bar painted 24px shorter than the number published above,
  and the banner was pulled up by the difference.

  `declarations: true` returns the bare property list instead, which is
  concatenated into the single attribute below. `data-section-spacing` is the
  hook `base.css` selects on, so it is written by hand here.
{%- endcomment -%}
{%- capture header_spacing -%}
  {%- render 'spacing', section: section.settings, declarations: true -%}
{%- endcapture -%}
{%- assign header_spacing = header_spacing | strip -%}

<sticky-header
  class="{{ header_classes }}"
  data-sticky-mode="{{ st.sticky_mode }}"
  data-logo-mobile="{{ st.logo_position_mobile | default: 'left' }}"
  {%- comment -%}
    The alignment settings are published as attributes as well as acted on
    by the slot captures above. Liquid decides which of the six slots an
    element lands in; CSS reads these to justify it *within* that slot.
    Without the second half, "Right" put the logo in the end slot and then
    the slot centred it, which is why the setting looked ignored.
  {%- endcomment -%}
  data-logo-position="{{ st.logo_position }}"
  data-menu-position="{{ st.menu_position }}"
  data-search-position="{{ st.search_position }}"
  data-threshold="80"
  {% if supports_transparent %}data-transparent{% endif %}
  {% if st.sticky_color_scheme != blank %}data-sticky-scheme="color-{{ st.sticky_color_scheme }}"{% endif %}
  data-section-spacing
  style="
    --header-row-height: {{ row_height }}px;
    --header-border-width: {{ st.border_thickness }}px;
    --header-utility-size: {{ st.utility_size }}px;
    --header-localization-size: {{ st.localization_size }}px;
    {%- if transparent_text != blank %}--header-transparent-text: {{ transparent_text }};{% endif -%}
    {{- header_spacing -}}
  "
>
  <div class="{% render 'container', width: st.container_width, classes: 'site-header__inner' %}">
    <div class="site-header__shell">
      <div class="site-header__row site-header__row--top">
        <div class="site-header__slot site-header__slot--start">
          {%- comment -%}
            The drawer toggle is not slotted. It is always the first thing in
            the reading order on small screens, whatever the merchant did with
            the other five placements.
          {%- endcomment -%}
          <button
            type="button"
            class="site-header__burger"
            data-overlay-open="MenuDrawer"
            aria-expanded="false"
            aria-controls="MenuDrawer"
            aria-label="{{ 'accessibility.open_menu' | t }}"
          >
            <span class="site-header__burger-bars" aria-hidden="true"><i></i><i></i></span>
          </button>

          {{ slot_top_start }}
        </div>

        <div class="site-header__slot site-header__slot--center">{{ slot_top_center }}</div>

        <div class="site-header__slot site-header__slot--end">
          {{ slot_top_end }}
          {% render 'header-actions', cart_is_drawer: cart_is_drawer, cart_count_display: cart_count_display %}
        </div>
      </div>

      {%- if bottom_row != blank -%}
        <div class="site-header__row site-header__row--bottom">
          <div class="site-header__slot site-header__slot--start">{{ slot_bottom_start }}</div>
          <div class="site-header__slot site-header__slot--center">{{ slot_bottom_center }}</div>
          <div class="site-header__slot site-header__slot--end">{{ slot_bottom_end }}</div>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}
    The panel bay.

    `{% content_for 'blocks' %}` can only be called once and only renders in
    block order, so a mega menu panel cannot be emitted inside the `<li>` it
    belongs to. It is emitted here instead, and `<nav-menu>` moves each panel
    into the matching `<details>` on connect.

    The bay is `hidden` rather than absent, so the panels are still in the
    document for the theme editor to highlight before the move happens, and
    every panel that finds no matching menu item simply stays here, invisible,
    instead of appearing loose at the top of the page.
  {%- endcomment -%}
  <div class="site-header__bay" data-nav-bay hidden>
    {% content_for 'blocks' %}
  </div>
</sticky-header>

{% render 'header-drawer', menu: menu %}

{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "header",
  "class": "header-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "t:sections.header.settings.menu.label", "default": "main-menu" },
    {
      "type": "select",
      "id": "menu_trigger",
      "label": "t:sections.header.settings.menu_trigger.label",
      "options": [
        { "value": "hover", "label": "t:sections.header.settings.menu_trigger.options__1.label" },
        { "value": "click", "label": "t:sections.header.settings.menu_trigger.options__2.label" }
      ],
      "default": "hover"
    },

    { "type": "header", "content": "t:sections.header.headers.logo" },
    {
      "type": "select",
      "id": "logo_position",
      "label": "t:shared.position.label",
      "options": [
        { "value": "left", "label": "t:shared.position.options__1.label" },
        { "value": "center", "label": "t:shared.position.options__2.label" },
        { "value": "right", "label": "t:shared.position.options__3.label" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "logo_position_mobile",
      "label": "t:sections.header.settings.logo_position_mobile.label",
      "info": "t:sections.header.settings.logo_position_mobile.info",
      "options": [
        { "value": "left", "label": "t:shared.position.options__1.label" },
        { "value": "center", "label": "t:shared.position.options__2.label" }
      ],
      "default": "left"
    },
    { "type": "image_picker", "id": "logo", "label": "t:sections.header.settings.logo.label" },
    {
      "type": "image_picker",
      "id": "logo_inverse",
      "label": "t:sections.header.settings.logo_inverse.label",
      "info": "t:sections.header.settings.logo_inverse.info"
    },
    { "type": "range", "id": "logo_width", "label": "t:sections.header.settings.logo_width.label", "min": 60, "max": 320, "step": 4, "unit": "px", "default": 140 },
    { "type": "range", "id": "logo_width_mobile", "label": "t:sections.header.settings.logo_width_mobile.label", "min": 60, "max": 240, "step": 5, "unit": "px", "default": 110 },

    { "type": "header", "content": "t:sections.header.headers.menu" },
    {
      "type": "select",
      "id": "menu_position",
      "label": "t:shared.position.label",
      "options": [
        { "value": "left", "label": "t:shared.position.options__1.label" },
        { "value": "center", "label": "t:shared.position.options__2.label" },
        { "value": "right", "label": "t:shared.position.options__3.label" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "menu_row",
      "label": "t:shared.row.label",
      "options": [
        { "value": "top", "label": "t:shared.row.options__1.label" },
        { "value": "bottom", "label": "t:shared.row.options__2.label" }
      ],
      "default": "top"
    },
    { "type": "range", "id": "menu_size", "label": "t:shared.typography.size.label", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    {
      "type": "select",
      "id": "menu_font",
      "label": "t:shared.typography.font.label",
      "options": [
        { "value": "body", "label": "t:shared.typography.font.options__1.label" },
        { "value": "heading", "label": "t:shared.typography.font.options__2.label" },
        { "value": "accent", "label": "t:shared.typography.font.options__3.label" }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "menu_case",
      "label": "t:shared.typography.case.label",
      "options": [
        { "value": "none", "label": "t:shared.typography.case.options__1.label" },
        { "value": "uppercase", "label": "t:shared.typography.case.options__2.label" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "menu_marker",
      "label": "t:sections.header.settings.menu_marker.label",
      "info": "t:sections.header.settings.menu_marker.info",
      "options": [
        { "value": "pill", "label": "t:sections.header.settings.menu_marker.options__1.label" },
        { "value": "underline", "label": "t:sections.header.settings.menu_marker.options__2.label" },
        { "value": "none", "label": "t:sections.header.settings.menu_marker.options__3.label" }
      ],
      "default": "pill"
    },

    { "type": "header", "content": "t:sections.header.headers.search" },
    { "type": "checkbox", "id": "show_search", "label": "t:sections.header.settings.show_search.label", "default": true },
    {
      "type": "select",
      "id": "search_position",
      "label": "t:shared.position.label",
      "options": [
        { "value": "left", "label": "t:shared.position.options__1.label" },
        { "value": "right", "label": "t:shared.position.options__3.label" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "search_row",
      "label": "t:shared.row.label",
      "options": [
        { "value": "top", "label": "t:shared.row.options__1.label" },
        { "value": "bottom", "label": "t:shared.row.options__2.label" }
      ],
      "default": "top"
    },

    { "type": "header", "content": "t:sections.header.headers.account" },
    { "type": "paragraph", "content": "t:sections.header.paragraphs.account" },
    { "type": "checkbox", "id": "show_account", "label": "t:sections.header.settings.show_account.label", "default": true },
 

    { "type": "header", "content": "t:sections.header.headers.localization" },
    { "type": "checkbox", "id": "show_country", "label": "t:sections.header.settings.show_country.label", "default": true },
    { "type": "checkbox", "id": "show_flag", "label": "t:sections.header.settings.show_flag.label", "default": false },
    { "type": "checkbox", "id": "show_language", "label": "t:sections.header.settings.show_language.label", "default": true },
    {
      "type": "select",
      "id": "localization_search",
      "label": "t:sections.header.settings.localization_search.label",
      "info": "t:sections.header.settings.localization_search.info",
      "options": [
        { "value": "auto", "label": "t:sections.header.settings.localization_search.options__1.label" },
        { "value": "always", "label": "t:sections.header.settings.localization_search.options__2.label" },
        { "value": "never", "label": "t:sections.header.settings.localization_search.options__3.label" }
      ],
      "default": "always"
    },
    {
      "type": "select",
      "id": "localization_font",
      "label": "t:shared.typography.font.label",
      "options": [
        { "value": "body", "label": "t:shared.typography.font.options__1.label" },
        { "value": "heading", "label": "t:shared.typography.font.options__2.label" },
        { "value": "accent", "label": "t:shared.typography.font.options__3.label" }
      ],
      "default": "heading"
    },
    { "type": "range", "id": "localization_size", "label": "t:shared.typography.size.label", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    {
      "type": "select",
      "id": "localization_position",
      "label": "t:shared.position.label",
      "options": [
        { "value": "left", "label": "t:shared.position.options__1.label" },
        { "value": "right", "label": "t:shared.position.options__3.label" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "localization_row",
      "label": "t:shared.row.label",
      "options": [
        { "value": "top", "label": "t:shared.row.options__1.label" },
        { "value": "bottom", "label": "t:shared.row.options__2.label" }
      ],
      "default": "top"
    },

    { "type": "header", "content": "t:sections.header.headers.promo" },
    { "type": "text", "id": "promo_label", "label": "t:sections.header.settings.promo_label.label" },
    { "type": "text", "id": "promo_badge", "label": "t:sections.header.settings.promo_badge.label" },
    { "type": "url", "id": "promo_link", "label": "t:shared.link.label" },
    {
      "type": "checkbox",
      "id": "promo_show_mobile",
      "label": "t:sections.header.settings.promo_show_mobile.label",
      "info": "t:sections.header.settings.promo_show_mobile.info",
      "default": false
    },

    { "type": "header", "content": "t:sections.header.headers.appearance" },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        { "value": "edge", "label": "t:shared.container.width.options__1.label" },
        { "value": "wide", "label": "t:shared.container.width.options__2.label" },
        { "value": "standard", "label": "t:shared.container.width.options__3.label" },
        { "value": "compact", "label": "t:shared.container.width.options__4.label" },
        { "value": "custom", "label": "t:shared.container.width.options__5.label" }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "header_shape",
      "label": "t:sections.header.settings.header_shape.label",
      "info": "t:sections.header.settings.header_shape.info",
      "options": [
        { "value": "bar", "label": "t:sections.header.settings.header_shape.options__1.label" },
        { "value": "pill", "label": "t:sections.header.settings.header_shape.options__2.label" }
      ],
      "default": "pill"
    },
