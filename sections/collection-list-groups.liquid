        "gap_vertical_mobile": 32
      },
      "blocks": [
        {
          "type": "group",
          "settings": {
            "gap": 24,
            "width": "fill"
          },
          "blocks": [
            {
              "type": "group",
              "settings": {
                "direction": "row",
                "gap": 24,
                "alignment": "space-between",
                "stack_on_mobile": false,
