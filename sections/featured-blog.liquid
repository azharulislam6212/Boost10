{% comment %}
  Articles from one blog. The Articles static block holds the blog, the
  layout and the carousel; the section keeps its frame and spacing.
{% endcomment %}

{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --fb-space: {{ s.space_between }}px;
  --fb-space-mobile: {{ s.space_between_mobile }}px;
  {%- render 'section-frame', settings: s -%}
{%- endcapture -%}

<div
  class="featured-blog color-scheme color-{{ s.color_scheme }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  <div class="{% render 'container', width: s.container_width %}">
    <motion-effect
      class="featured-blog__header"
      {% render 'motion-attrs', kind: 'content', section: s, children: true, duration: 1000 %}
    >
      {% content_for 'blocks' %}
    </motion-effect>

    {% content_for 'block', type: '_featured-blog-articles', id: 'articles' %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_blog.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:sections.featured_blog.headers.section"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "select",
      "id": "space_device",
      "label": "t:shared.gap.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "space_between",
      "label": "t:blocks.group.settings.distribution.options__2.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.space_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "space_between_mobile",
      "label": "t:blocks.group.settings.distribution.options__2.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.space_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "t:shared.background.color.label"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.border.style.options__2.label"
        }
      ],
      "default": "dashed"
    },
    {
      "type": "select",
      "id": "border_sides",
      "label": "t:shared.border.sides.label",
      "options": [
        {
          "value": "all",
          "label": "t:shared.options.all"
        },
        {
          "value": "top",
          "label": "t:shared.border.sides.top.label"
        },
        {
          "value": "bottom",
          "label": "t:shared.border.sides.bottom.label"
        },
        {
          "value": "top_bottom",
          "label": "t:shared.border.sides.top_bottom.label"
        }
      ],
      "default": "top",
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:shared.border.thickness.label",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.group.settings.border_color.label",
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:shared.corners.header"
    },
    {
      "type": "select",
      "id": "radius_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "select",
      "id": "corner_position",
      "label": "t:shared.corners.position.label",
      "options": [
        {
          "value": "top",
          "label": "t:shared.border.sides.top.label"
        },
        {
          "value": "bottom",
          "label": "t:shared.border.sides.bottom.label"
        },
        {
          "value": "all",
          "label": "t:shared.options.all"
        }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.radius_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "border_radius_mobile",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.radius_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
      "type": "select",
      "id": "animation_text",
      "label": "t:shared.animation.animation_text.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_text.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_text.options__2.label"
        },
        {
          "value": "fade-in",
          "label": "t:shared.animation.animation_text.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_text.options__4.label"
        },
        {
          "value": "slide-up",
          "label": "t:shared.animation.animation_text.options__5.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "select",
      "id": "stack_layer",
      "label": "t:shared.spacing.stack_layer.label",
      "options": [
        {
          "value": "under",
          "label": "t:shared.spacing.stack_layer.options__1.label"
        },
        {
          "value": "default",
          "label": "t:shared.spacing.stack_layer.options__2.label"
        },
        {
          "value": "over",
          "label": "t:shared.spacing.stack_layer.options__3.label"
        }
      ],
      "default": "over"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_blog.name",
      "category": "t:categories.text",
      "settings": {
        "container_width": "standard"
      },
      "blocks": [
        {
          "type": "section-header",
          "name": "t:blocks.section_header.presets.vertical.name",
          "settings": {
            "direction": "column",
            "alignment": "center",
            "position": "start",
            "width": "fill",
            "gap_vertical": 16,
            "gap_vertical_mobile": 12
          },
          "blocks": [
            {
              "type": "subheading",
              "settings": {
                "text": "<p>Journal</p>",
                "preset": "subheading",
                "width": "fit",
                "icon_source": "icon",
                "icon": "note",
                "icon_style": "solid",
                "icon_size": "small",
                "icon_width": 22,
                "icon_border_radius": 50,
                "gap": 8,
                "border_style": "dashed",
                "border_radius": 40
              },
              "blocks": []
            },
            {
              "type": "text",
              "name": "t:blocks.text.presets.heading.name",
              "settings": {
                "text": "<h2>From the blog</h2>",
                "preset": "h2",
                "max_width": "none",
                "color": "gradient",
                "text_gradient": "linear-gradient(90deg, #161514 0%, #0F2E2F 50%, #03D26F 100%)"
              }
            },
            {
              "type": "text",
              "name": "t:blocks.text.presets.text.name",
              "settings": {
                "text": "<p>Use this text to introduce your latest articles.</p>",
                "preset": "paragraph",
                "max_width": "normal"
              }
            }
          ]
        },
        {
          "type": "_featured-blog-articles",
          "id": "articles",
          "static": true,
          "settings": {
            "articles_to_show": 6,
            "layout": "carousel",
            "carousel_on_mobile": true,
            "columns_desktop": 3,
            "columns_tablet": 2,
            "columns_mobile": "1",
            "gap_horizontal": 24,
            "gap_vertical": 32,
            "show_view_all": true,
            "carousel_navigation": false,
            "carousel_nav_icon": "arrow",
            "carousel_nav_shape": "circle",
            "carousel_nav_border_style": "solid",
            "carousel_pagination": "controls",
            "carousel_pagination_align": "center",
            "carousel_inherit_scheme": true
          },
          "blocks": [
            {
              "type": "_article-card",
              "static": true,
              "id": "article-card",
              "settings": {
                "gap": 12,
                "stagger_span": 3
              },
              "blocks": [
                {
                  "type": "_article-image",
                  "settings": {
                    "ratio": "landscape",
                    "ratio_mobile": "landscape",
                    "hover_image_effect": "zoom_in",
                    "border_style": "none",
                    "border_radius": 24,
                    "show_date": true,
                    "date_icon": "clock",
                    "show_tags": true
                  }
                },
                {
                  "type": "_article-content",
                  "settings": {
                    "alignment": "start",
                    "gap": 12,
                    "border_style": "dashed",
                    "border_width": 1,
                    "border_opacity": 50,
                    "border_radius": 16,
                    "padding_top": 24,
                    "padding_bottom": 24,
                    "padding_left": 24,
                    "padding_right": 24,
                    "padding_top_mobile": 20,
                    "padding_bottom_mobile": 20,
                    "padding_left_mobile": 20,
                    "padding_right_mobile": 20
                  },
                  "blocks": [
                    {
                      "type": "_article-read-time",
                      "settings": {
                        "icon": "clock",
                        "icon_size": "small",
                        "preset": "subheading",
                        "words_per_minute": 200
                      }
                    },
                    {
                      "type": "_article-title",
                      "settings": {
                        "heading_tag": "h3",
                        "preset": "h5",
                        "max_lines": 2
                      }
                    },
                    {
                      "type": "_article-excerpt",
                      "settings": {
                        "word_limit": 24,
                        "max_lines": 3,
                        "preset": "paragraph"
                      }
                    },
                    {
                      "type": "_article-read-more",
                      "settings": {
                        "variant": "link",
                        "size": "medium",
                        "width": "auto",
                        "icon": "arrow-right",
                        "icon_position": "end",
                        "icon_style": "default"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
