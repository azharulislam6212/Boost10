{% comment %}
  Articles from one blog, as a grid or a carousel.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign featured = s.blog
  assign limit = s.articles_to_show | default: 6 | plus: 0

  if s.layout == 'editorial'
    assign limit = s.articles_to_show_editorial | default: 8 | plus: 0
  endif

  assign desktop = s.columns_desktop | default: 3 | plus: 0

  assign cols_mobile = s.columns_mobile | default: 1 | plus: 0
  if cols_mobile > 2
    assign cols_mobile = 2
  endif
  if cols_mobile < 1
    assign cols_mobile = 1
  endif

  assign card_width = 100 | divided_by: desktop
  assign card_sizes = '(min-width: 990px) ' | append: card_width | append: 'vw, (min-width: 750px) 45vw, 90vw'

  assign background_paint = s.background_color | default: ''

  assign margin_top = s.margin_top | default: 0 | plus: 0
  assign margin_bottom = s.margin_bottom | default: 0 | plus: 0

  assign layout_type = s.layout | default: 'carousel'

  assign editorial_class = ''
  if layout_type == 'editorial'
    assign editorial_class = ' article-grid--editorial'
  endif

  assign cs_layout = 'grid'
  if layout_type == 'carousel'
    assign cs_layout = 'carousel'
  endif

  assign carousel_on_mobile = s.carousel_on_mobile
  if carousel_on_mobile == nil
    assign carousel_on_mobile = true
  endif

  assign cs_layout_mobile = 'grid'
  if layout_type == 'carousel' or carousel_on_mobile
    assign cs_layout_mobile = 'carousel'
  endif

  assign gap_x = s.gap_horizontal | default: 24 | plus: 0
  assign gap_y = s.gap_vertical | default: 32 | plus: 0

  assign gap_x_mobile = s.gap_horizontal_mobile | plus: 0
  if s.gap_horizontal_mobile == nil
    assign gap_x_mobile = 12
  endif
  assign gap_y_mobile = s.gap_vertical_mobile | plus: 0
  if s.gap_vertical_mobile == nil
    assign gap_y_mobile = 16
  endif

  assign cs_count = featured.articles_count | default: 0 | plus: 0
  if cs_count > limit
    assign cs_count = limit
  endif

  assign cs_is_carousel = false
  if cs_layout == 'carousel' or cs_layout_mobile == 'carousel'
    assign cs_is_carousel = true
  endif

  assign show_view_all = false
  if s.show_view_all and layout_type != 'carousel' and featured.articles_count > limit
    assign show_view_all = true
  endif

  assign has_articles = false
  if featured.articles.size > 0
    assign has_articles = true
  endif

  assign placeholder_count = limit

  unless has_articles
    assign cs_count = placeholder_count
  endunless
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --fb-gap-x: {{ gap_x }}px;
  --fb-gap-y: {{ gap_y }}px;
  --fb-gap-x-mobile: {{ gap_x_mobile }}px;
  --fb-gap-y-mobile: {{ gap_y_mobile }}px;
  --featured-blog-radius: var(--section-frame-radius, 40px 40px 0px 0px);
  --featured-blog-radius-mobile: var(--section-frame-radius-mobile, 24px 24px 0px 0px);
  --featured-blog-margin-block-start: {{ margin_top }}px;
  --featured-blog-margin-block-end: {{ margin_bottom }}px;
  --featured-blog-border-width: var(--section-frame-border-width, 1px 0px 0px 0px);
  --featured-blog-border-style: var(--section-frame-border-style, dashed);
  --featured-blog-border-color: var(--section-frame-border-color, color-mix(in srgb, currentColor 100%, transparent));
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

{%- capture carousel_colors -%}
  {% content_for 'block', type: '_carousel-colors', id: 'carousel-colors' %}
{%- endcapture -%}

{%- capture frame_style -%}
  {% content_for 'block', type: '_section-frame', id: 'section-frame' %}
{%- endcapture -%}

<div
  class="featured-blog color-scheme-container color-{{ s.color_scheme }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}{{ frame_style | strip_newlines | strip }}"
>
  {% content_for 'block', type: '_background-media', id: 'section-background' %}

  <div class="{% render 'container', width: s.container_width %}">

    <motion-effect
      class="featured-blog__header featured-blog__header--{{ s.alignment | default: 'start' }}"
      {% render 'motion-attrs', kind: 'text', section: s, children: true %}
    >
      {% content_for 'blocks' %}
    </motion-effect>

    <carousel-slider
      {% render 'carousel-shell-attrs',
         settings: s,
         inline_style: carousel_colors,
         layout: cs_layout,
         layout_mobile: cs_layout_mobile,
         classes: 'featured-blog__carousel',
         columns_desktop: s.columns_desktop,
         columns_tablet: s.columns_tablet,
         columns_mobile: cols_mobile,
         count: cs_count %}
    >
      <ul
        class="carousel-shell__track article-grid{{ editorial_class }}{% unless has_articles %} featured-blog__placeholders{% endunless %}"
        data-ref="track"
        role="list"
        {% if has_articles and cs_is_carousel %}aria-label="{{ featured.title | escape }}"{% endif %}
      >
        {%- if has_articles -%}
          {%- for article in featured.articles limit: limit -%}
            <li class="article-grid__item carousel-shell__item" data-article-id="{{ article.id }}">
              {% content_for 'block',
                 type: '_article-card',
                 id: 'article-card',
                 closest.article: article,
                 index: forloop.index0,
                 priority: forloop.first,
                 sizes: card_sizes %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..placeholder_count) -%}
            <li class="article-grid__item carousel-shell__item">
              {% render 'article-card-placeholder',
                 index: forloop.index0,
                 columns: desktop,
                 sizes: card_sizes,
                 section: s %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {% content_for 'block', type: '_featured-blog-controls', id: 'carousel-controls' %}
    </carousel-slider>

    {%- if show_view_all -%}
      <div class="featured-blog__footer">
        {% render 'button', label: 'general.actions.view_all', href: featured.url, variant: 'secondary' %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_blog.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.featured_blog.settings.blog.label"
    },
    {
      "type": "select",
