  "presets": [
    {
      "name": "t:sections.featured_blog.name",
      "category": "t:categories.text",
      "settings": {
        "container_width": "standard",
        "articles_to_show": 6,
        "layout": "carousel",
        "carousel_on_mobile": true,
        "columns_desktop": 3,
        "columns_tablet": 2,
        "columns_mobile": "1",
        "gap_horizontal": 24,
        "gap_vertical": 32,
        "show_view_all": true,
        "alignment": "center"
      },
      "blocks": [
        {
          "type": "_carousel-colors",
          "id": "carousel-colors",
          "static": true,
          "settings": {
            "carousel_inherit_scheme": true
          }
        },
        {
          "type": "_featured-blog-controls",
          "id": "carousel-controls",
          "static": true,
          "settings": {
            "carousel_navigation": false,
            "carousel_nav_icon": "arrow",
            "carousel_nav_shape": "circle",
            "carousel_nav_border_style": "solid",
            "carousel_controls_style": "ghost",
            "carousel_pagination": "controls",
            "carousel_pagination_align": "center"
          }
        },
        {
          "type": "section-header",
          "name": "t:blocks.section_header.presets.vertical.name",
          "settings": {
            "direction": "column",
            "alignment": "center",
            "position": "start",
            "gap": 16,
            "gap_vertical": 16,
            "gap_vertical_mobile": 12,
            "width": "fill"
          },
          "blocks": [
            {
              "type": "subheading",
              "settings": {
                "text": "<p>Journal</p>",
                "preset": "subheading",
                "width": "fit",
                "alignment": "center",
                "alignment_mobile": "center",
                "icon_source": "icon",
                "icon": "note",
                "icon_style": "solid",
                "icon_size": "small",
                "icon_width": 22,
                "icon_height": 22,
                "icon_border_radius": 50,
                "show_divider": true,
                "gap": 8,
                "border_style": "dashed",
                "border_thickness": 1,
                "border_radius": 40
              },
              "blocks": [
                {
                  "type": "_block-typography",
                  "id": "typography",
                  "static": true,
                  "settings": {
                    "font_size": "16",
                    "font_size_mobile": "15"
                  }
                },
                {
                  "type": "_block-spacing",
                  "id": "spacing",
                  "static": true,
                  "settings": {
                    "padding_top": 4,
                    "padding_bottom": 4,
                    "padding_left": 4,
                    "padding_right": 16
                  }
                }
              ]
            },
            {
              "type": "text",
              "name": "t:blocks.text.presets.heading.name",
              "settings": {
                "text": "<p>From the blog</p>",
                "preset": "h2",
