{% comment %}
  sections/featured-blog.liquid

  Articles from one blog, as a grid or a carousel.

  ## Two existing implementations, joined rather than copied

  The surface is `sections/main-faq.liquid`'s — colour scheme, background media,
  border, radius, margins and padding, the same setting ids feeding the same
  snippets. The carousel is `sections/featured-collection.liquid`'s, down to the
  last `carousel_*` id, so the arrows, the peek, the pagination and the custom
  colours are one implementation with one set of bugs and one place to fix them.

  Nothing here is a third copy of either.

  ## The card is blocks, not settings

  `snippets/article-card.liquid` still renders the blog index, where every card
  is the same and there is nothing to arrange. A featured row is the other case,
  so the card is `blocks/_article-card.liquid` and everything in it — the
  picture, the pills on it, the read time, the title, the excerpt, the button —
  is a nested block the merchant arranges once.

  It is rendered here rather than added by the merchant, with the same `id` on
  every pass, because a row decides how many cards it has. One id means one set
  of settings shared by all of them: a grid whose third card could be styled
  differently from the first is a grid that will be.

  `closest.article:` is what carries the article into the card *and* into every
  block nested inside it. `{% content_for 'blocks' %}` passes no parameters, so
  a nested Article title has no other way to know which article it is titling.
  `sections/main-product.liquid` passes `closest.product` into its detail blocks
  for exactly the same reason.

  ## Why the carousel element is written out here

  `snippets/carousel-shell.liquid` takes its slides as a captured string, and
  `content_for` output cannot be captured — Shopify renders blocks with their
  editor bindings attached, and buffering that into a variable is not something
  the platform supports. So the element and its track are written here, while
  `carousel-shell-attrs` and `carousel-shell-tail` supply the attributes and the
  controls from the same sub-snippets the shell itself uses.
  `sections/featured-collection.liquid` does the same, for the same reason.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign featured = s.blog
  assign limit = s.articles_to_show | default: 3 | plus: 0
  assign desktop = s.columns_desktop | default: 3 | plus: 0

  comment
    `sizes` has to describe the widest a card is ever painted, which is the
    desktop column count. Getting it wrong is the most common cause of a grid
    downloading pictures two or three times larger than it shows.
  endcomment
  assign card_width = 100 | divided_by: desktop
  assign card_sizes = '(min-width: 990px) ' | append: card_width | append: 'vw, (min-width: 750px) 45vw, 90vw'

  comment
    ---- the surface, from `sections/main-faq.liquid` ----
  endcomment
  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif

  assign background_paint = ''
  if has_background_media == false
    assign background_paint = s.background_color | default: ''
  endif

  comment
    Opacity goes into the colour rather than onto the element: `opacity` on the
    section would fade the cards along with the frame.

    With no colour picked the border is `currentColor`, which the colour filters
    cannot take an alpha channel from — there is nothing to read until the
    scheme resolves in the browser. `color-mix` does the same fade at that point
    instead, so both paths honour the slider.
  endcomment
  assign border_width = 0
  if s.border_style == 'solid'
    assign border_width = s.border_width | default: 1 | plus: 0

    assign border_percent = s.border_opacity | default: 100 | plus: 0
    if s.border_color == blank
      assign border_paint = 'color-mix(in srgb, currentColor ' | append: border_percent | append: '%, transparent)'
    else
      assign border_alpha = border_percent | divided_by: 100.0
      assign border_paint = s.border_color | color_modify: 'alpha', border_alpha
    endif
  endif

  assign radius = s.border_radius | default: 0 | plus: 0
  assign margin_top = s.margin_top | default: 0 | plus: 0
  assign margin_bottom = s.margin_bottom | default: 0 | plus: 0

  comment
    ---- the carousel ----

    One `matchMedia` and nothing else when both breakpoints are grids: the
    component checks before it touches Swiper, so a grid-everywhere section
    never constructs one.

    `count` is what lets `carousel-options` decide whether the merchant's Loop
    setting is achievable — Swiper silently disables looping below twice
    `slidesPerView`, which reads as the setting doing nothing.
  endcomment
  assign cs_layout = s.layout | default: 'grid'
  assign cs_layout_mobile = s.layout_mobile | default: 'carousel'

  assign cs_count = featured.articles_count | default: 0 | plus: 0
  if cs_count > limit
    assign cs_count = limit
  endif

  assign cs_is_carousel = false
  if cs_layout == 'carousel' or cs_layout_mobile == 'carousel'
    assign cs_is_carousel = true
  endif
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --featured-blog-radius: {{ radius }}px;
  --featured-blog-margin-block-start: {{ margin_top }}px;
  --featured-blog-margin-block-end: {{ margin_bottom }}px;
  {%- if border_width > 0 -%}
    --featured-blog-border-width: {{ border_width }}px;
    --featured-blog-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="featured-blog color-scheme-container color-{{ s.color_scheme }}{% if has_background_media %} has-background-media{% endif %}"
  data-section-spacing
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: s %}
  {%- endif -%}

  <div class="{% render 'container', width: s.container_width %}">
    {%- comment -%}
      The merchant's own heading cluster. Whatever they add — a Section header,
      a Text block, a row with a button in it — sits above the cards, and this
      section says nothing about what it should be.
    {%- endcomment -%}
    <motion-effect
      class="featured-blog__header featured-blog__header--{{ s.alignment | default: 'start' }}"
      {% render 'motion-attrs', kind: 'text', section: s, children: true %}
    >
      {% content_for 'blocks' %}
    </motion-effect>

    {%- if featured.articles.size > 0 -%}
      <swiper-carousel
        {% render 'carousel-shell-attrs',
           settings: s,
           layout: cs_layout,
           layout_mobile: cs_layout_mobile,
           classes: 'featured-blog__carousel',
           columns_desktop: s.columns_desktop,
           columns_tablet: s.columns_tablet,
           columns_mobile: s.columns_mobile,
           count: cs_count %}
      >
        <ul
          class="carousel-shell__track article-grid"
          data-ref="track"
          role="list"
          {% if cs_is_carousel %}aria-label="{{ featured.title | escape }}"{% endif %}
        >
          {%- for article in featured.articles limit: limit -%}
            <li class="article-grid__item carousel-shell__item" data-article-id="{{ article.id }}">
              {% content_for 'block',
                 type: '_article-card',
                 id: 'article-card',
                 closest.article: article,
                 index: forloop.index0,
                 priority: forloop.first,
                 sizes: card_sizes %}
            </li>
          {%- endfor -%}
        </ul>

        {% render 'carousel-shell-tail',
           settings: s,
           layout: cs_layout,
           layout_mobile: cs_layout_mobile %}
      </swiper-carousel>

      {%- if s.show_view_all and featured.articles_count > limit -%}
        <div class="featured-blog__footer">
          {% render 'button', label: 'general.actions.view_all', href: featured.url, variant: 'secondary' %}
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="featured-blog__empty">{{ 'blogs.article.no_articles' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_blog.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.featured_blog.settings.blog.label"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "t:sections.featured_blog.settings.articles_to_show.label",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns.desktop.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.settings.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.featured_collection.settings.layout.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:sections.featured_collection.settings.layout.options__2.label"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.settings.show_view_all.label",
      "default": true,
      "info": "t:sections.featured_blog.settings.show_view_all.info"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:shared.background.media.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.background.media.options__1.label"
        },
        {
          "value": "image",
          "label": "t:shared.background.media.options__2.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "t:shared.background.color.label",
      "info": "t:shared.background.color.info",
      "visible_if": "{{ section.settings.background_media == 'none' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:shared.background.image.label",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:shared.background.image_mobile.label",
      "info": "t:shared.background.image_mobile.info",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
