      "info": "t:shared.carousel.carousel_on_mobile.info",
      "default": true,
      "visible_if": "{{ section.settings.layout != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "t:sections.featured_blog.settings.articles_to_show.label",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 6,
      "visible_if": "{{ section.settings.layout != 'editorial' }}"
    },
    {
      "type": "range",
      "id": "articles_to_show_editorial",
      "label": "t:sections.featured_blog.settings.articles_to_show.label",
      "info": "t:sections.featured_blog.settings.articles_to_show_editorial.info",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8,
      "visible_if": "{{ section.settings.layout == 'editorial' }}"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns.desktop.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.layout != 'editorial' }}"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:shared.carousel.columns_tablet.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.carousel.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:shared.carousel.columns_mobile.options__1.label"
        },
