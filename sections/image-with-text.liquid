{% comment %}
  sections/image-with-text.liquid

  Image on one side, blocks on the other.

  The image is a section setting rather than a block, because it is what defines
  the section — a merchant who deletes it is left with a rich text section that
  reserves half the page for nothing. Everything beside it is blocks.

  `data-order` flips the columns on desktop only. On mobile the image is always
  first, because a wall of text with the picture below it is not the arrangement
  anyone chose.
{% endcomment %}

<div
  class="image-with-text color-{{ section.settings.color_scheme }}"
  {% render 'spacing', section: section.settings %}
>
  <div class="{% if section.settings.full_width %}image-with-text--full{% else %}container{% endif %}">
    <div
      class="image-with-text__grid"
      data-order="{{ section.settings.image_position }}"
      style="--image-column: {{ section.settings.image_width | divided_by: 10.0 }}fr;"
    >
      <div class="image-with-text__media">
        {% render 'image',
           image: section.settings.image,
           mobile_image: section.settings.image_mobile,
           ratio: section.settings.image_ratio,
           mobile_ratio: section.settings.image_ratio_mobile,
           sizes: '(min-width: 750px) 50vw, 100vw' %}
      </div>

      <div class="image-with-text__content image-with-text__content--{{ section.settings.alignment }}">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "tag": "section",
  "class": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:shared.image.label" },
    { "type": "image_picker", "id": "image_mobile", "label": "t:shared.image_mobile.label", "info": "t:shared.image_mobile.info" },
    {
      "type": "select", "id": "image_ratio", "label": "t:blocks.image.settings.ratio.label",
      "options": [
        { "value": "adapt", "label": "t:blocks.image.settings.ratio.options__1.label" },
        { "value": "square", "label": "t:blocks.image.settings.ratio.options__2.label" },
        { "value": "portrait", "label": "t:blocks.image.settings.ratio.options__3.label" },
        { "value": "landscape", "label": "t:blocks.image.settings.ratio.options__4.label" },
        { "value": "tall", "label": "t:blocks.image.settings.ratio.options__6.label" }
      ],
      "default": "landscape"
    },
    {
      "type": "select", "id": "image_ratio_mobile", "label": "t:blocks.image.settings.ratio_mobile.label", "info": "t:blocks.image.settings.ratio_mobile.info",
      "options": [
        { "value": "", "label": "t:blocks.image.settings.ratio_mobile.options__1.label" },
        { "value": "square", "label": "t:blocks.image.settings.ratio.options__2.label" },
        { "value": "landscape", "label": "t:blocks.image.settings.ratio.options__4.label" },
        { "value": "long", "label": "t:blocks.image.settings.ratio.options__7.label" }
      ],
      "default": ""
    },
    {
      "type": "select", "id": "image_position", "label": "t:sections.image_with_text.settings.image_position.label", "info": "t:sections.image_with_text.settings.image_position.info",
      "options": [
        { "value": "start", "label": "t:sections.image_with_text.settings.image_position.options__1.label" },
        { "value": "end", "label": "t:sections.image_with_text.settings.image_position.options__2.label" }
      ],
      "default": "start"
    },
    { "type": "range", "id": "image_width", "label": "t:sections.image_with_text.settings.image_width.label", "min": 5, "max": 20, "step": 1, "default": 10 },
    { "type": "checkbox", "id": "full_width", "label": "t:sections.image_with_text.settings.full_width.label", "default": false },
    {
      "type": "select", "id": "alignment", "label": "t:blocks.group.settings.alignment.label",
      "options": [
        { "value": "start", "label": "t:blocks.group.settings.alignment.options__1.label" },
        { "value": "center", "label": "t:blocks.group.settings.alignment.options__2.label" },
        { "value": "end", "label": "t:blocks.group.settings.alignment.options__3.label" }
      ],
      "default": "start"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label", "default": "scheme-1" },
    { "type": "header", "content": "t:shared.spacing.section_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "t:shared.spacing.padding_top_mobile.label", "info": "t:shared.spacing.padding_top_mobile.info", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "t:shared.spacing.padding_bottom_mobile.label", "info": "t:shared.spacing.padding_bottom_mobile.info", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.name",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
