    },
    {
      "type": "range",
      "id": "border_radius_top_left_mobile",
      "label": "t:shared.corners.top_left.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "border_radius_top_right_mobile",
      "label": "t:shared.corners.top_right.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "border_radius_bottom_left_mobile",
      "label": "t:shared.corners.bottom_left.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "border_radius_bottom_right_mobile",
      "label": "t:shared.corners.bottom_right.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
