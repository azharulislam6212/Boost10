      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "border_radius_bottom_left",
      "label": "t:shared.corners.bottom_left.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "border_radius_bottom_right",
      "label": "t:shared.corners.bottom_right.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
