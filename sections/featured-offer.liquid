{% comment %}
  One offer over a photograph: a panel on one side, highlight cards on the
  other, and a strip of details under both.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_paint = s.background_color | default: ''

  assign margin_top = s.margin_top | default: 0 | plus: 0
  assign margin_bottom = s.margin_bottom | default: 0 | plus: 0

  assign min_height = s.min_height | default: 0 | plus: 0
  assign min_height_mobile = s.min_height_mobile | default: min_height | plus: 0

  assign direction = s.direction | default: 'row'
  assign is_row = false
  if direction == 'row'
    assign is_row = true
  endif

  assign alignment_setting = s.alignment | default: 'start'

  case alignment_setting
    when 'center'
      assign alignment_axis = 'center'
    when 'end'
      assign alignment_axis = 'end'
    else
      assign alignment_axis = 'start'
  endcase

  assign inline_axis = alignment_axis
  if is_row
    case alignment_setting
      when 'space-between', 'space-around', 'space-evenly'
        assign inline_axis = alignment_setting
    endcase
  endif

  case s.position
    when 'center'
      assign block_axis = 'center'
    when 'end'
      assign block_axis = 'end'
    when 'stretch'
      assign block_axis = 'stretch'
    else
      assign block_axis = 'start'
  endcase

  assign gap_x = s.gap_horizontal | default: 24 | plus: 0
  assign gap_y = s.gap_vertical | default: 24 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0
  assign gap_y_mobile = s.gap_vertical_mobile | default: gap_y | plus: 0

  assign content_classes = 'featured-offer__content featured-offer__content--' | append: direction
  if is_row and s.stack_on_mobile
    assign content_classes = content_classes | append: ' featured-offer__content--stack-mobile'
  endif

  if is_row and s.reverse
    assign content_classes = content_classes | append: ' featured-offer__content--reverse'
  endif
-%}

{%- capture content_style -%}
  --featured-offer-gap-x: {{ gap_x }}px;
  --featured-offer-gap-y: {{ gap_y }}px;
  --featured-offer-gap-x-mobile: {{ gap_x_mobile }}px;
  --featured-offer-gap-y-mobile: {{ gap_y_mobile }}px;
  --featured-offer-inline: {{ inline_axis }};
  --featured-offer-align: {{ alignment_axis }};
  --featured-offer-block: {{ block_axis }};
{%- endcapture -%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --featured-offer-radius: var(--section-frame-radius, 40px 40px 0px 0px);
  --featured-offer-radius-mobile: var(--section-frame-radius-mobile, 24px 24px 0px 0px);
  --featured-offer-margin-block-start: {{ margin_top }}px;
  --featured-offer-margin-block-end: {{ margin_bottom }}px;
  --featured-offer-min-height: {{ min_height }}px;
  --featured-offer-min-height-mobile: {{ min_height_mobile }}px;
  --featured-offer-border-width: var(--section-frame-border-width, 1px 0px 0px 0px);
  --featured-offer-border-style: var(--section-frame-border-style, dashed);
  --featured-offer-border-color: var(--section-frame-border-color, color-mix(in srgb, currentColor 100%, transparent));
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

{%- capture frame_style -%}
  {% content_for 'block', type: '_section-frame', id: 'section-frame' %}
{%- endcapture -%}

<div
  class="featured-offer color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}{{ frame_style | strip_newlines | strip }}"
>

  {% content_for 'block',
     type: '_background-media',
     id: 'section-background',
     priority: true,
     placeholder: 'hero-apparel-1' %}

  <div class="featured-offer__inner {% render 'container', width: s.container_width %}">

    <motion-effect
      class="{{ content_classes }}"
      data-easing="outQuint"
      style="{{ content_style | strip_newlines | strip }}"
      {% render 'motion-attrs', kind: 'text', section: s, children: true %}
    >
      {% content_for 'blocks' %}
    </motion-effect>
  </div>
</div>

