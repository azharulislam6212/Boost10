      "type": "paragraph",
      "content": "t:sections.expert_quote.paragraphs.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.border.style.options__2.label"
        }
      ],
      "default": "dashed"
    },
    {
      "type": "range",
