{% comment %}
  One endorsement, said by a named person, with the products it is about
  scattered around them.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_paint = s.background_color | default: ''

  assign margin_top = s.margin_top | default: 0 | plus: 0
  assign margin_bottom = s.margin_bottom | default: 0 | plus: 0

  assign gap_x = s.gap_horizontal | default: 24 | plus: 0
  assign gap_y = s.gap_vertical | default: 24 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0
  assign gap_y_mobile = s.gap_vertical_mobile | default: gap_y | plus: 0

  assign motion_distance = s.motion_distance | default: 18 | plus: 0
  assign motion_duration = s.motion_duration | default: 4000 | plus: 0

  assign motion_angle = motion_distance | times: 25 | divided_by: 100.0
  assign motion_scale = motion_distance | times: 5 | divided_by: 1000.0 | plus: 1

  assign stage_classes = 'expert-quote__stage'
  unless s.scatter_on_mobile
    assign stage_classes = stage_classes | append: ' expert-quote__stage--no-scatter-mobile'
  endunless
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --expert-quote-radius: var(--section-frame-radius, 40px 40px 0px 0px);
  --expert-quote-radius-mobile: var(--section-frame-radius-mobile, 24px 24px 0px 0px);
  --expert-quote-margin-block-start: {{ margin_top }}px;
  --expert-quote-margin-block-end: {{ margin_bottom }}px;
  --expert-quote-gap-x: {{ gap_x }}px;
  --expert-quote-gap-y: {{ gap_y }}px;
  --expert-quote-gap-x-mobile: {{ gap_x_mobile }}px;
  --expert-quote-gap-y-mobile: {{ gap_y_mobile }}px;
  --expert-quote-motion-distance: {{ motion_distance }}px;
  --expert-quote-motion-angle: {{ motion_angle }}deg;
  --expert-quote-motion-scale: {{ motion_scale }};
  --expert-quote-motion-duration: {{ motion_duration }}ms;
  --expert-quote-border-width: var(--section-frame-border-width, 1px 0px 0px 0px);
  --expert-quote-border-style: var(--section-frame-border-style, dashed);
  --expert-quote-border-color: var(--section-frame-border-color, #0F2E2F);
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

{%- capture frame_style -%}
  {% content_for 'block', type: '_section-frame', id: 'section-frame' %}
{%- endcapture -%}

<div
  class="expert-quote color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}{{ frame_style | strip_newlines | strip }}"
>
  {% content_for 'block', type: '_background-media', id: 'section-background' %}

  <div class="expert-quote__inner {% render 'container', width: s.container_width %}">

    <figure class="expert-quote__figure">
      {% content_for 'block', type: '_expert-quote-lead', id: 'expert-quote-lead' %}

      <div class="{{ stage_classes }}">
        {% content_for 'block', type: '_expert-quote-feature', id: 'expert-quote-feature' %}

        {% content_for 'blocks' %}
      </div>
    </figure>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.expert_quote.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "_expert-quote-image"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.expert_quote.paragraphs.blocks"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "paragraph",
      "content": "t:sections.expert_quote.paragraphs.layout"
    },
    {
      "type": "checkbox",
      "id": "scatter_on_mobile",
      "label": "t:sections.expert_quote.settings.scatter_on_mobile.label",
      "info": "t:sections.expert_quote.settings.scatter_on_mobile.info",
      "default": true
    },
    {
      "type": "select",
      "id": "gap_device",
      "label": "t:shared.gap.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_horizontal_mobile",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.gap_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical_mobile",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.gap_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:sections.expert_quote.headers.drift"
    },
    {
      "type": "paragraph",
      "content": "t:sections.expert_quote.paragraphs.drift"
    },
    {
      "type": "range",
      "id": "motion_distance",
      "label": "t:sections.expert_quote.settings.motion_distance.label",
      "info": "t:sections.expert_quote.settings.motion_distance.info",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "motion_duration",
      "label": "t:sections.expert_quote.settings.motion_duration.label",
      "info": "t:sections.expert_quote.settings.motion_duration.info",
      "min": 1500,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 4000
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "t:shared.background.color.label",
      "info": "t:shared.background.color.info",
      "default": "linear-gradient(90deg, #E5F1EE 0%, #FBFDFC 20%, #FBFDFC 40%, #F4F9F8 60%, #EDF5F3 80%, #E5F1EE 100%)"
    },
    {
      "type": "paragraph",
      "content": "t:sections.expert_quote.paragraphs.borders"
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
      "type": "paragraph",
      "content": "t:sections.expert_quote.paragraphs.animation"
    },
    {
      "type": "select",
      "id": "animation_text",
      "label": "t:shared.animation.animation_text.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_text.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_text.options__2.label"
        },
        {
          "value": "fade-in",
          "label": "t:shared.animation.animation_text.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_text.options__4.label"
        },
        {
          "value": "slide-up",
          "label": "t:shared.animation.animation_text.options__5.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "animation_image",
      "label": "t:shared.animation.animation_image.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_image.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_image.options__2.label"
        },
        {
          "value": "fade-in",
          "label": "t:shared.animation.animation_image.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_image.options__4.label"
        },
        {
          "value": "zoom-in",
          "label": "t:shared.animation.animation_image.options__7.label"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "t:shared.animation.animation_duration.label",
      "info": "t:shared.animation.animation_duration.info",
      "min": 0,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "default": 1000
    },
    {
      "type": "range",
      "id": "animation_stagger",
      "label": "t:shared.animation.animation_stagger.label",
      "info": "t:shared.animation.animation_stagger.info",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "ms",
      "default": 90
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "paragraph",
      "content": "t:shared.spacing.section_paragraph"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:shared.spacing.margin_top.label",
      "info": "t:shared.spacing.margin_negative.info",
      "min": -160,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:shared.spacing.margin_bottom.label",
      "info": "t:shared.spacing.margin_negative.info",
      "min": -160,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "stack_layer",
      "label": "t:shared.spacing.stack_layer.label",
      "info": "t:shared.spacing.stack_layer.info",
      "options": [
        {
          "value": "under",
          "label": "t:shared.spacing.stack_layer.options__1.label"
        },
        {
          "value": "default",
          "label": "t:shared.spacing.stack_layer.options__2.label"
        },
        {
          "value": "over",
          "label": "t:shared.spacing.stack_layer.options__3.label"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "t:sections.expert_quote.presets.default.name",
      "category": "t:categories.text",
      "settings": {
        "container_width": "standard",
        "scatter_on_mobile": true,
        "gap_horizontal": 24,
        "gap_vertical": 24,
        "gap_horizontal_mobile": 12,
        "gap_vertical_mobile": 12,
        "motion_distance": 18,
        "motion_duration": 4000,
        "color_scheme": "scheme-1",
        "animation_image": "fade-up",
        "animation_duration": 1000,
        "animation_stagger": 90,
        "padding_top": 100,
        "padding_bottom": 100,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 56
      },
      "blocks": [
        {
          "type": "_section-frame",
          "id": "section-frame",
          "static": true,
          "settings": {
            "border_color": "#0F2E2F"
          }
        },
        {
          "type": "_expert-quote-image",
          "settings": {
            "placement": "start",
            "width": 260,
            "width_mobile": 160,
            "offset": -96,
            "offset_mobile": 0,
            "rotate": -12,
            "radius": 32,
            "radius_mobile": 20,
            "ratio": "portrait",
            "motion_style": "float",
            "motion_delay": 0,
            "animation_delay": 0
          }
        },
        {
          "type": "_expert-quote-image",
          "settings": {
            "placement": "end",
            "width": 260,
            "width_mobile": 160,
            "offset": -160,
            "offset_mobile": 0,
            "rotate": 14,
            "radius": 32,
            "radius_mobile": 20,
            "ratio": "portrait",
            "motion_style": "orbit",
            "motion_delay": 3200,
            "animation_delay": 250
          }
        }
      ]
    }
  ]
}
{% endschema %}
