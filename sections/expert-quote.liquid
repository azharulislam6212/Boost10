{% comment %}
  One endorsement, said by a named person, with pictures scattered around them.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_paint = s.background_color | default: ''

  assign border_line = s.border_style | default: 'none'

  assign bw_top = 0
  assign bw_right = 0
  assign bw_bottom = 0
  assign bw_left = 0
  assign border_any = 0

  if border_line != 'none'
    assign border_sides = s.border_sides | default: 'top'
    assign border_size = s.border_width | default: 1 | plus: 0

    case border_sides
      when 'all'
        assign bw_top = border_size
        assign bw_right = border_size
        assign bw_bottom = border_size
        assign bw_left = border_size
      when 'bottom'
        assign bw_bottom = border_size
      when 'top_bottom'
        assign bw_top = border_size
        assign bw_bottom = border_size
      else
        assign bw_top = border_size
    endcase
    assign border_any = border_size

    if s.border_color == blank
      assign border_paint = 'currentColor'
    else
      assign border_paint = s.border_color
    endif
  endif

  assign corner_position = s.corner_position | default: 'top'
  assign radius = s.border_radius | default: 40 | plus: 0
  assign radius_mobile = s.border_radius_mobile | default: 24 | plus: 0

  assign r_tl = 0
  assign r_tr = 0
  assign r_bl = 0
  assign r_br = 0
  assign r_tl_m = 0
  assign r_tr_m = 0
  assign r_bl_m = 0
  assign r_br_m = 0

  if corner_position != 'bottom'
    assign r_tl = radius
    assign r_tr = radius
    assign r_tl_m = radius_mobile
    assign r_tr_m = radius_mobile
  endif
  if corner_position != 'top'
    assign r_bl = radius
    assign r_br = radius
    assign r_bl_m = radius_mobile
    assign r_br_m = radius_mobile
  endif

  assign overlap = 0
  assign overlap_mobile = 0
  if s.stack_layer == 'over' or s.stack_layer == 'under'
    assign overlap = r_tl
    assign overlap_mobile = r_tl_m
  endif

  assign gap_x = s.gap_horizontal | default: 24 | plus: 0
  assign gap_y = s.gap_vertical | default: 24 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0
  assign gap_y_mobile = s.gap_vertical_mobile | default: gap_y | plus: 0

  assign motion_distance = s.motion_distance | default: 18 | plus: 0
  assign motion_duration = s.motion_duration | default: 4000 | plus: 0

  assign motion_angle = motion_distance | times: 25 | divided_by: 100.0
  assign motion_scale = motion_distance | times: 5 | divided_by: 1000.0 | plus: 1

  assign stage_classes = 'expert-quote__stage'
  unless s.scatter_on_mobile
    assign stage_classes = stage_classes | append: ' expert-quote__stage--no-scatter-mobile'
  endunless
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --expert-quote-radius: {{ r_tl }}px {{ r_tr }}px {{ r_br }}px {{ r_bl }}px;
  --expert-quote-radius-mobile: {{ r_tl_m }}px {{ r_tr_m }}px {{ r_br_m }}px {{ r_bl_m }}px;
  --section-overlap: {{ overlap }}px;
  --section-overlap-mobile: {{ overlap_mobile }}px;
  --expert-quote-gap-x: {{ gap_x }}px;
  --expert-quote-gap-y: {{ gap_y }}px;
  --expert-quote-gap-x-mobile: {{ gap_x_mobile }}px;
  --expert-quote-gap-y-mobile: {{ gap_y_mobile }}px;
  --expert-quote-motion-distance: {{ motion_distance }}px;
  --expert-quote-motion-angle: {{ motion_angle }}deg;
  --expert-quote-motion-scale: {{ motion_scale }};
  --expert-quote-motion-duration: {{ motion_duration }}ms;
  {%- if border_any > 0 -%}
    --expert-quote-border-width: {{ bw_top }}px {{ bw_right }}px {{ bw_bottom }}px {{ bw_left }}px;
    --expert-quote-border-style: {{ border_line }};
    --expert-quote-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="expert-quote color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  <div class="expert-quote__inner {% render 'container', width: s.container_width %}">

    <figure class="expert-quote__figure">
      {% content_for 'block', type: '_expert-quote-lead', id: 'expert-quote-lead' %}

      <div class="{{ stage_classes }}">
        {% content_for 'block', type: '_expert-quote-feature', id: 'expert-quote-feature' %}

        {% content_for 'blocks' %}
      </div>
    </figure>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.expert_quote.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "_expert-quote-image"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.expert_quote.paragraphs.blocks"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "paragraph",
      "content": "t:sections.expert_quote.paragraphs.layout"
    },
    {
      "type": "checkbox",
      "id": "scatter_on_mobile",
      "label": "t:sections.expert_quote.settings.scatter_on_mobile.label",
      "info": "t:sections.expert_quote.settings.scatter_on_mobile.info",
      "default": true
    },
    {
      "type": "select",
      "id": "gap_device",
      "label": "t:shared.gap.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_horizontal_mobile",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.gap_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical_mobile",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.gap_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:sections.expert_quote.headers.drift"
    },
    {
      "type": "paragraph",
      "content": "t:sections.expert_quote.paragraphs.drift"
    },
    {
      "type": "range",
      "id": "motion_distance",
      "label": "t:sections.expert_quote.settings.motion_distance.label",
      "info": "t:sections.expert_quote.settings.motion_distance.info",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "motion_duration",
      "label": "t:sections.expert_quote.settings.motion_duration.label",
      "info": "t:sections.expert_quote.settings.motion_duration.info",
      "min": 1500,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 4000
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "t:shared.background.color.label",
      "info": "t:shared.background.color.info"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.borders"
    },
    {
      "type": "paragraph",
      "content": "t:sections.expert_quote.paragraphs.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.border.style.options__2.label"
        }
      ],
      "default": "dashed"
    },
    {
      "type": "select",
      "id": "border_sides",
      "label": "t:shared.border.sides.label",
      "options": [
        {
          "value": "all",
          "label": "t:shared.options.all"
        },
        {
          "value": "top",
          "label": "t:shared.border.sides.top.label"
        },
        {
          "value": "bottom",
          "label": "t:shared.border.sides.bottom.label"
        },
        {
          "value": "top_bottom",
          "label": "t:shared.border.sides.top_bottom.label"
        }
      ],
      "default": "top",
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:shared.border.thickness.label",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.group.settings.border_color.label",
      "default": "#0F2E2F",
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:shared.corners.header"
    },
    {
      "type": "select",
      "id": "radius_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "select",
      "id": "corner_position",
      "label": "t:shared.corners.position.label",
      "options": [
        {
          "value": "top",
          "label": "t:shared.border.sides.top.label"
        },
        {
          "value": "bottom",
          "label": "t:shared.border.sides.bottom.label"
        },
        {
          "value": "all",
          "label": "t:shared.options.all"
        }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.radius_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "border_radius_mobile",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.radius_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
      "type": "paragraph",
      "content": "t:sections.expert_quote.paragraphs.animation"
    },
    {
      "type": "select",
      "id": "animation_text",
      "label": "t:shared.animation.animation_text.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_text.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_text.options__2.label"
        },
        {
          "value": "fade-in",
          "label": "t:shared.animation.animation_text.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_text.options__4.label"
        },
        {
          "value": "slide-up",
          "label": "t:shared.animation.animation_text.options__5.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "animation_image",
      "label": "t:shared.animation.animation_image.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_image.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_image.options__2.label"
        },
        {
          "value": "fade-in",
          "label": "t:shared.animation.animation_image.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_image.options__4.label"
        },
        {
          "value": "zoom-in",
          "label": "t:shared.animation.animation_image.options__7.label"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "paragraph",
      "content": "t:shared.spacing.section_paragraph"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "select",
      "id": "stack_layer",
      "label": "t:shared.spacing.stack_layer.label",
      "info": "t:shared.spacing.stack_layer.info",
      "options": [
        {
          "value": "under",
          "label": "t:shared.spacing.stack_layer.options__1.label"
        },
        {
          "value": "default",
          "label": "t:shared.spacing.stack_layer.options__2.label"
        },
        {
          "value": "over",
          "label": "t:shared.spacing.stack_layer.options__3.label"
        }
      ],
      "default": "over"
    }
  ],
  "presets": [
    {
      "name": "t:sections.expert_quote.presets.default.name",
      "category": "t:categories.text",
      "settings": {
        "container_width": "standard",
        "scatter_on_mobile": true,
        "gap_horizontal": 24,
        "gap_vertical": 24,
        "gap_horizontal_mobile": 12,
        "gap_vertical_mobile": 12,
        "motion_distance": 18,
        "motion_duration": 4000,
        "color_scheme": "scheme-2",
        "animation_image": "fade-up",
        "padding_top": 100,
        "padding_bottom": 100,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 56
      },
      "blocks": [
        {
          "type": "_expert-quote-image",
          "settings": {
            "placement": "start",
            "width": 260,
            "width_mobile": 160,
            "offset": -96,
            "offset_mobile": 0,
            "rotate": -12,
            "radius": 32,
            "radius_mobile": 20,
            "ratio": "portrait",
            "motion_style": "float",
            "motion_delay": 0
          }
        },
        {
          "type": "_expert-quote-image",
          "settings": {
            "placement": "end",
            "width": 260,
            "width_mobile": 160,
            "offset": -160,
            "offset_mobile": 0,
            "rotate": 14,
            "radius": 32,
            "radius_mobile": 20,
            "ratio": "portrait",
            "motion_style": "orbit",
            "motion_delay": 3200
          }
        }
      ]
    }
  ]
}
{% endschema %}
