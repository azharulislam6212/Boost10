{% comment %}
  One endorsement, said by a named person, with the products it is about
  scattered around them.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif

  assign background_paint = ''
  if has_background_media == false
    assign background_paint = s.background_color | default: ''
  endif

  assign border_line = s.border_style | default: 'none'

  assign bw_top = 0
  assign bw_right = 0
  assign bw_bottom = 0
  assign bw_left = 0
  assign border_any = 0

  if border_line != 'none'
    assign bw_top = s.border_width_top | default: 0 | plus: 0
    assign bw_right = s.border_width_right | default: 0 | plus: 0
    assign bw_bottom = s.border_width_bottom | default: 0 | plus: 0
    assign bw_left = s.border_width_left | default: 0 | plus: 0
    assign border_any = bw_top | plus: bw_right | plus: bw_bottom | plus: bw_left

    assign border_percent = s.border_opacity | default: 100 | plus: 0
    if s.border_color == blank
      assign border_paint = 'color-mix(in srgb, currentColor ' | append: border_percent | append: '%, transparent)'
    else
      assign border_alpha = border_percent | divided_by: 100.0
      assign border_paint = s.border_color | color_modify: 'alpha', border_alpha
    endif
  endif

  assign r_tl = s.border_radius_top_left | default: 40 | plus: 0
  assign r_tr = s.border_radius_top_right | default: 40 | plus: 0
  assign r_bl = s.border_radius_bottom_left | default: 0 | plus: 0
  assign r_br = s.border_radius_bottom_right | default: 0 | plus: 0

  assign r_tl_m = s.border_radius_top_left_mobile | default: r_tl | plus: 0
  assign r_tr_m = s.border_radius_top_right_mobile | default: r_tr | plus: 0
  assign r_bl_m = s.border_radius_bottom_left_mobile | default: r_bl | plus: 0
  assign r_br_m = s.border_radius_bottom_right_mobile | default: r_br | plus: 0

  assign margin_top = s.margin_top | default: 0 | plus: 0
  assign margin_bottom = s.margin_bottom | default: 0 | plus: 0

  assign gap_x = s.gap_horizontal | default: 24 | plus: 0
  assign gap_y = s.gap_vertical | default: 24 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0
  assign gap_y_mobile = s.gap_vertical_mobile | default: gap_y | plus: 0

  assign motion_distance = s.motion_distance | default: 18 | plus: 0
  assign motion_duration = s.motion_duration | default: 4000 | plus: 0

  assign motion_angle = motion_distance | times: 25 | divided_by: 100.0
  assign motion_scale = motion_distance | times: 5 | divided_by: 1000.0 | plus: 1

  assign stage_classes = 'expert-quote__stage'
  unless s.scatter_on_mobile
    assign stage_classes = stage_classes | append: ' expert-quote__stage--no-scatter-mobile'
  endunless
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --expert-quote-radius: {{ r_tl }}px {{ r_tr }}px {{ r_br }}px {{ r_bl }}px;
  --expert-quote-radius-mobile: {{ r_tl_m }}px {{ r_tr_m }}px {{ r_br_m }}px {{ r_bl_m }}px;
  --expert-quote-margin-block-start: {{ margin_top }}px;
  --expert-quote-margin-block-end: {{ margin_bottom }}px;
  --expert-quote-gap-x: {{ gap_x }}px;
  --expert-quote-gap-y: {{ gap_y }}px;
  --expert-quote-gap-x-mobile: {{ gap_x_mobile }}px;
  --expert-quote-gap-y-mobile: {{ gap_y_mobile }}px;
  --expert-quote-motion-distance: {{ motion_distance }}px;
  --expert-quote-motion-angle: {{ motion_angle }}deg;
  --expert-quote-motion-scale: {{ motion_scale }};
  --expert-quote-motion-duration: {{ motion_duration }}ms;
  {%- if border_any > 0 -%}
    --expert-quote-border-width: {{ bw_top }}px {{ bw_right }}px {{ bw_bottom }}px {{ bw_left }}px;
    --expert-quote-border-style: {{ border_line }};
    --expert-quote-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="expert-quote color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}{% if has_background_media %} has-background-media{% endif %}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: s %}
  {%- endif -%}

  <div class="expert-quote__inner {% render 'container', width: s.container_width %}">

    <figure class="expert-quote__figure">
      {% content_for 'block', type: '_expert-quote-lead', id: 'expert-quote-lead' %}

      <div class="{{ stage_classes }}">
        {% content_for 'block', type: '_expert-quote-feature', id: 'expert-quote-feature' %}

        {% content_for 'blocks' %}
      </div>
    </figure>
  </div>
</div>

{% schema %}
