{% comment %}
  Hero banner: a static Media layer behind a static Content column, with any
  theme blocks (such as Product carousel) beside it.
{% endcomment %}

{%- liquid
  assign s = section.settings

  case s.height
    when 'small'
      assign hero_height = '560px'
    when 'medium'
      assign hero_height = '720px'
    when 'large'
      assign hero_height = '832px'
    when 'full'
      assign hero_height = '100svh'
    when 'custom'
      assign hero_height = s.height_custom | append: 'px'
    else
      assign hero_height = 'auto'
  endcase

  case s.height_mobile
    when 'small'
      assign hero_height_mobile = '480px'
    when 'medium'
      assign hero_height_mobile = '600px'
    when 'large'
      assign hero_height_mobile = '720px'
    when 'full'
      assign hero_height_mobile = '100svh'
    when 'custom'
      assign hero_height_mobile = s.height_mobile_custom | append: 'px'
    else
      assign hero_height_mobile = 'auto'
  endcase

  capture content_classes
    render 'section-content', settings: s, output: 'class'
  endcapture
  capture content_style
    render 'section-content', settings: s, output: 'style'
  endcapture
  capture section_style
    render 'spacing', section: s, declarations: true
    render 'section-frame', settings: s
  endcapture
-%}

<div
  class="section hero-banner color-scheme color-{{ s.color_scheme | default: 'scheme-4' }} has-background-media"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }} --hero-height: {{ hero_height }}; --hero-height-mobile: {{ hero_height_mobile }};"
>
  {% content_for 'block', type: '_hero-media', id: 'hero-banner-media' %}

  <div class="section-inner hero-banner__inner {% render 'container', width: s.container_width %}">
    <motion-effect
      class="{{ content_classes }} hero-banner__layout"
      data-easing="outQuint"
      style="{{ content_style | strip_newlines | strip }}"
      {% render 'motion-attrs', kind: 'content', section: s, children: true, duration: 1000 %}
    >
      {% content_for 'block', type: '_hero-content', id: 'hero-banner-content' %}
      {% content_for 'blocks' %}
    </motion-effect>
  </div>
</div>

