{% comment %}
  Shoppable video: a heading over a centre-focused carousel of portrait videos,
  each with the product it sells.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif

  assign alignment_axis = 'center'

  assign inline_axis = alignment_axis
  assign block_axis = 'start'

  assign gap_x = s.gap_horizontal | default: 24 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0

  assign content_classes = 'section-content section-content--column'

  assign slide_label = 'accessibility.of_count' | t: index: '__index__', count: '__count__'

  assign video_count = 0
  for block in section.blocks
    if block.settings.video_source != blank
      assign video_count = video_count | plus: 1
    endif
  endfor

  assign loop = s.carousel_loop
  if loop == nil
    assign loop = true
  endif

  assign autoplay_delay = 0
  if s.carousel_autoplay
    assign autoplay_delay = s.carousel_autoplay_delay | times: 1000
  endif

  assign pagination = s.carousel_pagination
  assign pagination_align = s.carousel_pagination_align
  if video_count < 2
    assign pagination = 'none'
  endif
-%}

{%- capture sv_pagination -%}
  {%- case pagination -%}
    {%- when 'dots' -%}
      <div class="carousel-shell__dots carousel-pagination--{{ pagination_align }}" data-carousel-active>
        {%- for i in (1..video_count) -%}
          <button
            type="button"
            class="carousel-shell__dot"
            data-dot="{{ forloop.index0 }}"
            aria-label="{{ 'accessibility.of_count' | t: index: i, count: video_count | escape }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- when 'numbers' -%}
      <div class="carousel-shell__counter carousel-pagination--{{ pagination_align }}" data-carousel-active aria-hidden="true">
        <span class="carousel-shell__fraction-current" data-ref="current">01</span>
        /
        <span class="carousel-shell__fraction-total">{% if video_count < 10 %}0{% endif %}{{ video_count }}</span>
      </div>
    {%- when 'progress' -%}
      <div class="carousel-shell__progress carousel-pagination--{{ pagination_align }}" data-carousel-active aria-hidden="true">
        <span class="carousel-shell__progress-fill" data-ref="fill"></span>
      </div>
  {%- endcase -%}
{%- endcapture -%}

{%- capture content_style -%}
  --section-gap-x: {{ gap_x }}px;
  --section-gap-y: {{ s.gap_vertical }}px;
  --section-gap-x-mobile: {{ gap_x_mobile }}px;
  --section-gap-y-mobile: {{ s.gap_vertical_mobile }}px;
  --section-inline: {{ inline_axis }};
  --section-align: {{ alignment_axis }};
  --section-block: {{ block_axis }};
{%- endcapture -%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  {%- render 'section-frame', settings: s, media: true -%}
{%- endcapture -%}

<div
  class="section shoppable-video-section color-scheme color-{{ s.color_scheme | default: 'scheme-1' }}{% if has_background_media %} has-background-media{% endif %}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: s, placeholder: 'hero-apparel-1' %}
  {%- endif -%}

  <div class="section-inner {% render 'container', width: s.container_width %}">
    <motion-effect
      class="{{ content_classes }}"
      data-easing="outQuint"
      style="{{ content_style | strip_newlines | strip }}"
      {% render 'motion-attrs', kind: 'content', section: s, children: true, duration: 1000 %}
    >
      {% content_for 'block', type: 'section-header', id: 'shoppable-video-header' %}

      <shoppable-video
        class="shoppable-video shoppable-video--play-{{ s.play_position }}"
        style="--sv-play-size: {{ s.play_icon_size }}px;
          {%- if s.play_button_color != blank %} --sv-play-fill: {{ s.play_button_color }};{% endif -%}
          {%- if s.play_icon_color != blank %} --sv-play-ink: {{ s.play_icon_color }};{% endif -%}
          {%- render 'carousel-style', settings: s -%}"
        data-slide-label="{{ slide_label | escape }}"
        data-loop="{{ loop }}"
        {%- if autoplay_delay > 0 %} data-autoplay-delay="{{ autoplay_delay }}"{% endif %}
      >
        <div
          class="shoppable-video__stage"
          data-ref="stage"
          tabindex="0"
          role="region"
          aria-roledescription="{{ 'accessibility.carousel' | t | escape }}"
          aria-label="{{ 'sections.shoppable_video.carousel_label' | t | escape }}"
        >
          <span class="shoppable-video__frame" aria-hidden="true">
            <svg focusable="false"><rect x="0.5" y="0.5" rx="31.5" ry="31.5" /></svg>
          </span>

          {% content_for 'blocks' %}
        </div>

        {%- if video_count > 1 -%}
          {%- if s.carousel_navigation -%}
            <div class="shoppable-video__controls shoppable-video__controls--{{ pagination_align }}">
              {% render 'carousel-nav', settings: s, position: 'inline', between: sv_pagination %}
            </div>
          {%- elsif sv_pagination != blank -%}
            <div class="shoppable-video__controls shoppable-video__controls--{{ pagination_align }}">
              {{ sv_pagination }}
            </div>
          {%- endif -%}
        {%- endif -%}
      </shoppable-video>
    </motion-effect>
  </div>
</div>

