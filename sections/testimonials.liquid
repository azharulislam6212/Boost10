{% comment %}
  A row of customer reviews that starts against a filled intro panel and runs
  off the right-hand edge of the page.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign carousel_id = 'testimonials-' | append: section.id
  assign columns_mobile = s.columns_mobile | plus: 0
  assign slide_count = section.blocks | where: 'type', '_testimonial-card' | size
  assign stagger = 120

  capture layout
    render 'carousel-layout', settings: s, fallback: 'carousel', guard: false
  endcapture
  capture layout_mobile
    render 'carousel-layout', settings: s, fallback: 'carousel', mobile: true
  endcapture
  assign layout = layout | strip
  assign layout_mobile = layout_mobile | strip

  assign has_controls = false
  if layout == 'carousel' or layout_mobile == 'carousel'
    if s.carousel_navigation or s.carousel_pagination != 'none'
      assign has_controls = true
    endif
  endif
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --tc-space: {{ s.space_between }}px;
  --tc-space-mobile: {{ s.space_between_mobile }}px;
  --tc-gap: {{ s.gap }}px;
  --tc-gap-mobile: {{ s.gap_mobile }}px;
  {%- render 'section-frame', settings: s -%}
{%- endcapture -%}

{%- capture intro_panel -%}
  {% content_for 'block', type: '_testimonial-intro', id: 'testimonials-intro' %}
{%- endcapture -%}

<div
  class="testimonials color-scheme color-{{ s.color_scheme }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  <div class="{% render 'container', width: s.container_width %}">
    <motion-effect
      class="testimonials__header"
      {% render 'motion-attrs', kind: 'content', section: s, children: true, duration: 800, stagger: stagger %}
    >
      {% content_for 'block', type: 'section-header', id: 'testimonials-header' %}
    </motion-effect>

    <div class="testimonials__layout testimonials__layout--{{ layout }}{% if intro_panel != blank %} testimonials__layout--with-intro{% endif %}">
      {%- if intro_panel != blank -%}
        <motion-effect
          class="testimonials__intro"
          {% render 'motion-attrs', kind: 'content', section: s, duration: 800, stagger: stagger %}
        >
          {{ intro_panel }}
        </motion-effect>
      {%- endif -%}

      <motion-effect
        class="testimonials__track testimonials__track--{{ layout }}
          {%- if layout == 'carousel' %} testimonials__track--bleed-desktop{% endif %}
          {%- if layout_mobile == 'carousel' %} testimonials__track--bleed-mobile{% endif %}"
        {% render 'motion-attrs', kind: 'content', section: s, target: '.testimonial-card', duration: 800, stagger: stagger %}
      >
        <carousel-slider
          {% render 'carousel-shell-attrs',
             settings: s,
             id: carousel_id,
             layout: layout,
             layout_mobile: layout_mobile,
             classes: 'testimonials__carousel',
             columns_desktop: s.columns_desktop,
             columns_tablet: s.columns_tablet,
             columns_mobile: columns_mobile,
             peek_mobile: 25,
             peek_desktop: 15,
             count: slide_count %}
        >
          <div
            class="carousel-shell__track testimonials__grid"
            data-ref="track"
            {% if layout == 'carousel' or layout_mobile == 'carousel' %}aria-label="{{ 'accessibility.carousel' | t | escape }}"{% endif %}
          >
            {% content_for 'blocks' %}
          </div>

          {% render 'carousel-shell-tail', settings: s, layout: layout, layout_mobile: layout_mobile, autoplay: false, detached: true %}
        </carousel-slider>
      </motion-effect>
    </div>

    {%- if has_controls -%}
      <div class="testimonials__controls testimonials__controls--{{ s.carousel_pagination_align }}
        {%- if layout == 'carousel' %} testimonials__controls--always{% elsif layout_mobile == 'carousel' %} testimonials__controls--mobile{% endif %}">
        {%- render 'carousel-outside-controls',
           settings: s,
           carousel: carousel_id,
           pagination: s.carousel_pagination,
           align: s.carousel_pagination_align,
           nav: s.carousel_navigation,
           between: true -%}
      </div>
    {%- endif -%}
  </div>
</div>

