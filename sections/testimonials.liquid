{% comment %}
  sections/testimonials.liquid

  Customer quotes, as a grid or a carousel.

  ## What changed in Phase 3

  Same duplication as the other two: a carousel branch carrying the arrows, the
  pause button and the live region, and a grid branch carrying none of them.

  The pause button matters here more than anywhere else in the theme. Autoplay
  is genuinely useful for testimonials and merchants switch it on, and moving
  content that cannot be stopped is a WCAG 2.2.2 failure. In the old markup the
  control existed only in one branch; the shell renders it whenever autoplay is
  available, so it cannot go missing by choosing the other layout.
{% endcomment %}

<div
  class="testimonials color-{{ section.settings.color_scheme }}"
  {% render 'spacing', section: section.settings %}
>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="testimonials__header testimonials__header--{{ section.settings.alignment }}">
        <h2 class="testimonials__heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    {%- capture children -%}
      {% content_for 'blocks' %}
    {%- endcapture -%}

    {% render 'carousel-shell',
       children: children,
       layout: section.settings.layout,
       layout_mobile: section.settings.layout_mobile,
       tag: 'div',
       label: 'sections.testimonials.carousel_label' | t,
       classes: 'testimonials__carousel',
       track_classes: 'testimonials__grid',
       columns_desktop: section.settings.columns_desktop,
       columns_tablet: section.settings.columns_tablet,
       columns_mobile: section.settings.columns_mobile,
       settings: section.settings %}
  </div>
</div>


{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading.label",
      "default": "What customers say"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns.desktop.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.settings.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.featured_collection.settings.layout.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:sections.featured_collection.settings.layout.options__2.label"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.announcement_bar.settings.autoplay.label",
      "info": "t:sections.testimonials.settings.autoplay.info",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.announcement_bar.settings.autoplay_speed.label",
      "min": 4,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
      "type": "select",
      "id": "animation_text",
      "label": "t:shared.animation.animation_text.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_text.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_text.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_text.options__4.label"
        },
        {
          "value": "words-slide-up",
          "label": "t:shared.animation.animation_text.options__9.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.carousel.header"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "t:shared.carousel.layout_mobile.label",
      "options": [
        {
          "value": "grid",
          "label": "t:shared.carousel.layout.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:shared.carousel.layout.options__2.label"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:shared.carousel.columns_tablet.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "t:shared.carousel.columns_mobile.label",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.motion"
    },
    {
      "type": "select",
      "id": "carousel_effect",
      "label": "t:shared.carousel.effect.label",
      "info": "t:shared.carousel.effect.info",
      "options": [
        {
          "value": "slide",
          "label": "t:shared.carousel.effect.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:shared.carousel.effect.options__2.label"
        }
      ],
      "default": "slide"
    },
    {
      "type": "range",
      "id": "carousel_speed",
      "label": "t:shared.carousel.speed.label",
      "info": "t:shared.carousel.speed.info",
      "min": 100,
      "max": 1500,
      "step": 50,
      "unit": "ms",
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "carousel_loop",
      "label": "t:shared.carousel.loop.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "t:shared.carousel.autoplay.label",
      "info": "t:shared.carousel.autoplay.info",
      "default": false
    },
    {
      "type": "range",
      "id": "carousel_autoplay_delay",
      "label": "t:shared.carousel.autoplay_delay.label",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.carousel_autoplay }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.navigation"
    },
    {
      "type": "checkbox",
      "id": "carousel_navigation",
      "label": "t:shared.carousel.navigation.label",
      "default": true
    },
    {
      "type": "select",
      "id": "carousel_nav_position",
      "label": "t:shared.carousel.nav_position.label",
      "info": "t:shared.carousel.nav_position.info",
      "options": [
        {
          "value": "outside",
          "label": "t:shared.carousel.nav_position.options__1.label"
        },
        {
          "value": "inside",
          "label": "t:shared.carousel.nav_position.options__2.label"
        },
        {
          "value": "bottom",
          "label": "t:shared.carousel.nav_position.options__3.label"
        },
        {
          "value": "inline",
          "label": "t:shared.carousel.nav_position.options__4.label"
        }
      ],
      "default": "outside",
      "visible_if": "{{ section.settings.carousel_navigation }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_icon",
      "label": "t:shared.carousel.nav_icon.label",
      "options": [
        {
          "value": "chevron",
          "label": "t:shared.carousel.nav_icon.options__1.label"
        },
        {
          "value": "arrow",
          "label": "t:shared.carousel.nav_icon.options__2.label"
        },
        {
          "value": "play",
          "label": "t:shared.carousel.nav_icon.options__3.label"
        },
        {
          "value": "external",
          "label": "t:shared.carousel.nav_icon.options__4.label"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.carousel_navigation }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_style",
      "label": "t:shared.carousel.controls_style.label",
      "info": "t:shared.carousel.controls_style.info",
      "options": [
        {
          "value": "split",
          "label": "t:shared.carousel.controls_style.options__1.label"
        },
        {
          "value": "ghost",
          "label": "t:shared.carousel.controls_style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:shared.carousel.controls_style.options__3.label"
        }
      ],
      "default": "split",
      "visible_if": "{{ section.settings.carousel_navigation }}"
    },
    {
      "type": "range",
      "id": "carousel_nav_size",
      "label": "t:shared.carousel.nav_size.label",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44,
      "visible_if": "{{ section.settings.carousel_navigation }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.pagination"
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "t:shared.carousel.pagination.label",
      "info": "t:shared.carousel.pagination.info",
      "options": [
        {
          "value": "none",
          "label": "t:shared.carousel.pagination.options__1.label"
        },
        {
          "value": "dots",
          "label": "t:shared.carousel.pagination.options__2.label"
        },
        {
          "value": "numbers",
          "label": "t:shared.carousel.pagination.options__3.label"
        },
        {
          "value": "progress",
          "label": "t:shared.carousel.pagination.options__4.label"
        },
        {
          "value": "controls",
          "label": "t:shared.carousel.pagination.options__5.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "carousel_controls_align",
      "label": "t:shared.carousel.controls_align.label",
      "options": [
        {
          "value": "start",
          "label": "t:shared.carousel.controls_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:shared.carousel.controls_align.options__2.label"
        },
        {
          "value": "end",
          "label": "t:shared.carousel.controls_align.options__3.label"
        }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.carousel_pagination == 'controls' }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.colors"
    },
    {
      "type": "paragraph",
      "content": "t:shared.carousel.paragraphs.colors"
    },
    {
      "type": "checkbox",
      "id": "carousel_custom_colors",
      "label": "t:shared.carousel.custom_colors.label",
      "info": "t:shared.carousel.custom_colors.info",
      "default": false
    },
    {
      "type": "select",
      "id": "carousel_nav_style",
      "label": "t:shared.carousel.nav_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.carousel.nav_style.options__1.label"
        },
        {
          "value": "gradient",
          "label": "t:shared.carousel.nav_style.options__2.label"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_bg",
      "label": "t:shared.carousel.nav_bg.label",
      "visible_if": "{{ section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_bg_hover",
      "label": "t:shared.carousel.nav_bg_hover.label",
      "visible_if": "{{ section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "carousel_nav_gradient",
      "label": "t:shared.carousel.nav_gradient.label",
      "default": "linear-gradient(135deg, #1a1a1a 0%, #4a4a4a 100%)",
      "visible_if": "{{ section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'gradient' }}"
    },
    {
      "type": "color_background",
      "id": "carousel_nav_gradient_hover",
      "label": "t:shared.carousel.nav_gradient_hover.label",
      "visible_if": "{{ section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_icon_color",
      "label": "t:shared.carousel.nav_icon_color.label",
      "visible_if": "{{ section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_icon_hover",
      "label": "t:shared.carousel.nav_icon_hover.label",
      "visible_if": "{{ section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_border_color",
      "label": "t:shared.carousel.nav_border_color.label",
      "visible_if": "{{ section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_border_hover",
      "label": "t:shared.carousel.nav_border_hover.label",
      "visible_if": "{{ section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_dot_color",
      "label": "t:shared.carousel.dot_color.label",
