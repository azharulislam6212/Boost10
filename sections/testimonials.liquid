{% comment %}
  A row of customer reviews that starts against a filled intro panel and runs
  off the right-hand edge of the page.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign desktop = s.columns_desktop | default: 3 | plus: 0

  assign cols_mobile = s.columns_mobile | default: 1 | plus: 0
  if cols_mobile > 2
    assign cols_mobile = 2
  endif
  if cols_mobile < 1
    assign cols_mobile = 1
  endif

  assign cols_tablet = s.columns_tablet | default: 2 | plus: 0

  assign background_paint = s.background_color | default: ''

  assign border_line = s.border_style | default: 'none'

  assign bw_top = 0
  assign bw_right = 0
  assign bw_bottom = 0
  assign bw_left = 0
  assign border_any = 0
  assign border_paint = ''

  if border_line != 'none'
    assign border_sides = s.border_sides | default: 'top'
    assign border_size = s.border_width | default: 1 | plus: 0

    case border_sides
      when 'all'
        assign bw_top = border_size
        assign bw_right = border_size
        assign bw_bottom = border_size
        assign bw_left = border_size
      when 'bottom'
        assign bw_bottom = border_size
      when 'top_bottom'
        assign bw_top = border_size
        assign bw_bottom = border_size
      else
        assign bw_top = border_size
    endcase
    assign border_any = border_size

    if s.border_color == blank
      assign border_paint = 'currentColor'
    else
      assign border_paint = s.border_color
    endif
  endif

  assign corner_position = s.corner_position | default: 'top'
  assign radius = s.border_radius | default: 40 | plus: 0
  assign radius_mobile = s.border_radius_mobile | default: 24 | plus: 0

  assign r_tl = 0
  assign r_tr = 0
  assign r_bl = 0
  assign r_br = 0
  assign r_tl_m = 0
  assign r_tr_m = 0
  assign r_bl_m = 0
  assign r_br_m = 0

  if corner_position != 'bottom'
    assign r_tl = radius
    assign r_tr = radius
    assign r_tl_m = radius_mobile
    assign r_tr_m = radius_mobile
  endif
  if corner_position != 'top'
    assign r_bl = radius
    assign r_br = radius
    assign r_bl_m = radius_mobile
    assign r_br_m = radius_mobile
  endif

  assign overlap = 0
  assign overlap_mobile = 0
  if s.stack_layer == 'over' or s.stack_layer == 'under'
    assign overlap = r_tl
    assign overlap_mobile = r_tl_m
  endif

  assign gap_x = s.gap | default: 24 | plus: 0
  assign gap_y = gap_x

  assign gap_x_mobile = s.gap_mobile | plus: 0
  if s.gap_mobile == nil
    assign gap_x_mobile = 16
  endif
  assign gap_y_mobile = gap_x_mobile

  assign layout_type = s.layout | default: 'carousel'

  assign cs_layout = 'grid'
  if layout_type == 'carousel'
    assign cs_layout = 'carousel'
  endif

  assign carousel_on_mobile = s.carousel_on_mobile
  if carousel_on_mobile == nil
    assign carousel_on_mobile = true
  endif

  assign cs_layout_mobile = 'grid'
  if layout_type == 'carousel' or carousel_on_mobile
    assign cs_layout_mobile = 'carousel'
  endif

  assign cs_is_carousel = false
  if cs_layout == 'carousel' or cs_layout_mobile == 'carousel'
    assign cs_is_carousel = true
  endif

  assign cs_count = 0
  for review_block in section.blocks
    if review_block.type == '_testimonial-card'
      assign cs_count = cs_count | plus: 1
    endif
  endfor

  assign cs_label = 'accessibility.carousel' | t

  assign carousel_id = 'testimonials-' | append: section.id

  assign cs_pagination = s.carousel_pagination | default: 'controls'
  assign cs_pagination_align = s.carousel_pagination_align | default: 'center'

  assign cs_nav = s.carousel_navigation
  if cs_nav == nil
    assign cs_nav = true
  endif

  assign has_controls = false
  if cs_is_carousel and cs_nav or cs_is_carousel and cs_pagination != 'none'
    assign has_controls = true
  endif

  assign controls_class = 'testimonials__controls testimonials__controls--' | append: cs_pagination_align
  if cs_layout == 'carousel'
    assign controls_class = controls_class | append: ' testimonials__controls--always'
  elsif cs_layout_mobile == 'carousel'
    assign controls_class = controls_class | append: ' testimonials__controls--mobile'
  endif

  assign card_stagger = 120

  assign track_classes = 'testimonials__track'
  if cs_layout == 'carousel'
    assign track_classes = track_classes | append: ' testimonials__track--bleed-desktop'
  endif
  if cs_layout_mobile == 'carousel'
    assign track_classes = track_classes | append: ' testimonials__track--bleed-mobile'
  endif
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --tc-gap-x: {{ gap_x }}px;
  --tc-gap-y: {{ gap_y }}px;
  --tc-gap-x-mobile: {{ gap_x_mobile }}px;
  --tc-gap-y-mobile: {{ gap_y_mobile }}px;
  --testimonials-radius: {{ r_tl }}px {{ r_tr }}px {{ r_br }}px {{ r_bl }}px;
  --testimonials-radius-mobile: {{ r_tl_m }}px {{ r_tr_m }}px {{ r_br_m }}px {{ r_bl_m }}px;
  --section-overlap: {{ overlap }}px;
  --section-overlap-mobile: {{ overlap_mobile }}px;
  {%- if border_any > 0 -%}
    --testimonials-border-width: {{ bw_top }}px {{ bw_right }}px {{ bw_bottom }}px {{ bw_left }}px;
    --testimonials-border-style: {{ border_line }};
    --testimonials-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

{%- capture intro_panel -%}
  {% content_for 'block', type: '_testimonial-intro', id: 'testimonials-intro' %}
{%- endcapture -%}
{%- assign show_intro = false -%}
{%- if intro_panel != blank -%}
  {%- assign show_intro = true -%}
{%- endif -%}

<div
  class="testimonials testimonials--thumb-zoom-in color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>

  <div class="{% render 'container', width: s.container_width %}">

    <motion-effect
      class="testimonials__header"
      {% render 'motion-attrs', kind: 'text', section: s, children: true, duration: 800, stagger: card_stagger %}
    >
      {% content_for 'block', type: 'section-header', id: 'testimonials-header' %}
    </motion-effect>

    <div class="testimonials__layout testimonials__layout--{{ cs_layout }}{% if show_intro %} testimonials__layout--with-intro{% endif %}">
      {%- if show_intro -%}
        <motion-effect
          class="testimonials__intro"
          {% render 'motion-attrs', kind: 'image', section: s, duration: 800, stagger: card_stagger %}
        >
          {{ intro_panel }}
        </motion-effect>
      {%- endif -%}

      <motion-effect
        class="{{ track_classes }} testimonials__track--{{ cs_layout }}"
        {% render 'motion-attrs',
           kind: 'image',
           section: s,
           target: '.testimonial-card',
           duration: 800,
           stagger: card_stagger %}
      >
        <carousel-slider
          {% render 'carousel-shell-attrs',
             settings: s,
             id: carousel_id,
             layout: cs_layout,
             layout_mobile: cs_layout_mobile,
             classes: 'testimonials__carousel',
             columns_desktop: desktop,
             columns_tablet: cols_tablet,
             columns_mobile: cols_mobile,
             peek_mobile: 25,
             peek_desktop: 15,
             count: cs_count %}
        >
          <div
            class="carousel-shell__track testimonials__grid"
            data-ref="track"
            {% if cs_is_carousel %}aria-label="{{ cs_label | escape }}"{% endif %}
          >
            {% content_for 'blocks' %}
          </div>

          {% render 'carousel-shell-tail',
             settings: s,
             layout: cs_layout,
             layout_mobile: cs_layout_mobile,
             autoplay: false,
             detached: true %}
        </carousel-slider>
      </motion-effect>
    </div>

    {%- if has_controls -%}
      <div class="{{ controls_class }}">
        {%- if cs_pagination == 'controls' -%}
          {% render 'carousel-controls',
             settings: s,
             carousel: carousel_id,
             align: cs_pagination_align,
             arrows: cs_nav %}
        {%- else -%}
          {%- capture pagination_markup -%}
            {%- if cs_pagination != 'none' -%}
              {% render 'carousel-pagination',
                 style: cs_pagination,
                 align: cs_pagination_align,
                 carousel: carousel_id %}
            {%- endif -%}
          {%- endcapture -%}

          {%- if cs_nav -%}
            {% render 'carousel-nav',
               settings: s,
               carousel: carousel_id,
               position: 'bottom',
               between: pagination_markup %}
          {%- else -%}
            {{ pagination_markup }}
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>


{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "_testimonial-card"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:shared.carousel.layout_type.label",
      "options": [
        {
          "value": "grid",
          "label": "t:shared.carousel.layout_type.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:shared.carousel.layout_type.options__2.label"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:shared.carousel.carousel_on_mobile.label",
      "info": "t:shared.carousel.carousel_on_mobile.info",
      "default": true,
      "visible_if": "{{ section.settings.layout != 'carousel' }}"
    },
    {
      "type": "header",
      "content": "t:shared.columns.header"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns.desktop.label",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:shared.columns.tablet.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.columns.mobile.label",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "gap_device",
      "label": "t:shared.gap.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:sections.testimonials.settings.gap.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:sections.testimonials.settings.gap.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.gap_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:sections.featured_blog.headers.section"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "t:shared.background.color.label"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.options.dashed"
        },
        {
          "value": "dotted",
          "label": "t:shared.border.style.options__3.label"
        }
      ],
      "default": "dashed"
    },
    {
      "type": "select",
      "id": "border_sides",
      "label": "t:shared.border.sides.label",
      "options": [
        {
          "value": "all",
          "label": "t:shared.options.all"
        },
        {
          "value": "top",
          "label": "t:shared.border.sides.top.label"
        },
        {
          "value": "bottom",
          "label": "t:shared.border.sides.bottom.label"
        },
        {
          "value": "top_bottom",
          "label": "t:shared.border.sides.top_bottom.label"
        }
      ],
      "default": "top",
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:shared.border.thickness.label",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.group.settings.border_color.label",
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:shared.corners.header"
    },
    {
      "type": "select",
      "id": "radius_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "select",
      "id": "corner_position",
      "label": "t:shared.corners.position.label",
      "options": [
        {
          "value": "top",
          "label": "t:shared.border.sides.top.label"
        },
        {
          "value": "bottom",
          "label": "t:shared.border.sides.bottom.label"
        },
        {
          "value": "all",
          "label": "t:shared.options.all"
        }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.radius_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "border_radius_mobile",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.radius_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:sections.featured_blog.headers.carousel",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_loop",
      "label": "t:shared.carousel.loop.label",
      "default": false,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "t:shared.carousel.autoplay.label",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "range",
      "id": "carousel_autoplay_delay",
      "label": "t:blocks.showcase_column.settings.speed.label",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.carousel_autoplay }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.navigation",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_navigation",
      "label": "t:shared.carousel.navigation.label",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_icon",
      "label": "t:shared.carousel.nav_glyph.label",
      "options": [
        {
          "value": "arrow",
          "label": "t:shared.carousel.nav_glyph.options__1.label"
        },
        {
          "value": "chevron",
          "label": "t:shared.carousel.nav_glyph.options__2.label"
        },
        {
          "value": "arrow-large",
          "label": "t:shared.carousel.nav_glyph.options__3.label"
        },
        {
          "value": "chevron-large",
          "label": "t:shared.carousel.nav_glyph.options__4.label"
        },
        {
          "value": "none",
          "label": "t:shared.carousel.nav_glyph.options__5.label"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.carousel_navigation and section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_shape",
      "label": "t:shared.carousel.nav_shape.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.carousel.nav_shape.options__1.label"
        },
        {
          "value": "circle",
          "label": "t:shared.carousel.nav_shape.options__2.label"
        },
        {
          "value": "square",
          "label": "t:shared.carousel.nav_shape.options__3.label"
        }
      ],
      "default": "circle",
      "visible_if": "{{ section.settings.carousel_navigation and section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_border_style",
      "label": "t:shared.carousel.nav_border_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.options.dashed"
        },
        {
          "value": "none",
          "label": "t:shared.options.none"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.carousel_navigation and section.settings.carousel_nav_shape != 'none' and section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_style",
      "label": "t:shared.carousel.controls_style.label",
      "options": [
        {
          "value": "split",
          "label": "t:shared.carousel.controls_style.options__1.label"
        },
        {
          "value": "ghost",
          "label": "t:shared.carousel.controls_style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:shared.carousel.controls_style.options__3.label"
        }
      ],
      "default": "ghost",
      "visible_if": "{{ section.settings.carousel_navigation and section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.pagination",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "t:shared.carousel.pagination.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.carousel.pagination.options__1.label"
        },
        {
          "value": "dots",
          "label": "t:shared.carousel.pagination.options__2.label"
        },
        {
          "value": "numbers",
          "label": "t:shared.carousel.pagination.options__3.label"
        },
        {
          "value": "progress",
          "label": "t:shared.carousel.pagination.options__4.label"
        },
        {
          "value": "controls",
          "label": "t:shared.carousel.pagination.options__5.label"
        }
      ],
      "default": "controls",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_pagination_align",
      "label": "t:shared.carousel.pagination_align.label",
      "options": [
        {
          "value": "start",
          "label": "t:shared.carousel.controls_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:shared.carousel.controls_align.options__2.label"
        },
        {
          "value": "end",
          "label": "t:shared.carousel.controls_align.options__3.label"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.controls",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_inherit_scheme",
      "label": "t:shared.carousel.inherit_scheme.label",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "color_scheme",
      "id": "carousel_color_scheme",
