{% comment %}
  A heading cluster over a grid of Banners (or any theme blocks) that can run
  as a carousel.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif


  assign direction = s.direction | default: 'column'
  assign is_row = false
  if direction == 'row'
    assign is_row = true
  endif

  assign alignment_setting = s.alignment | default: 'start'

  case alignment_setting
    when 'center'
      assign alignment_axis = 'center'
    when 'end'
      assign alignment_axis = 'end'
    else
      assign alignment_axis = 'start'
  endcase

  assign inline_axis = alignment_axis
  if is_row
    case alignment_setting
      when 'space-between', 'space-around', 'space-evenly'
        assign inline_axis = alignment_setting
    endcase
  endif

  case s.position
    when 'center'
      assign block_axis = 'center'
    when 'end'
      assign block_axis = 'end'
    when 'stretch'
      assign block_axis = 'stretch'
    else
      assign block_axis = 'start'
  endcase

  assign gap_x = s.gap_horizontal | default: 24 | plus: 0
  assign gap_y = s.gap_vertical | default: 24 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0
  assign gap_y_mobile = s.gap_vertical_mobile | default: gap_y | plus: 0

  assign content_classes = 'section-content section-content--' | append: direction
  if is_row and s.stack_on_mobile != false
    assign content_classes = content_classes | append: ' section-content--stack-mobile'
  endif

  if is_row and s.reverse
    assign content_classes = content_classes | append: ' section-content--reverse'
  endif
-%}

{%- liquid
  assign desktop = s.columns_desktop | default: 2 | plus: 0 | at_most: 3
  assign cols_tablet = s.columns_tablet | default: 2 | plus: 0 | at_most: 2
  # One banner per row on a phone; they are too rich to share the width.
  assign cols_mobile = 1

  assign cs_layout = 'grid'
  if s.layout == 'carousel'
    assign cs_layout = 'carousel'
  endif

  assign carousel_on_mobile = s.carousel_on_mobile
  if carousel_on_mobile == nil
    assign carousel_on_mobile = true
  endif

  assign cs_layout_mobile = 'grid'
  if cs_layout == 'carousel' or carousel_on_mobile
    assign cs_layout_mobile = 'carousel'
  endif

  assign cs_is_carousel = false
  if cs_layout == 'carousel' or cs_layout_mobile == 'carousel'
    assign cs_is_carousel = true
  endif

  assign cs_label = 'accessibility.carousel' | t
  assign carousel_id = 'grid-banner-' | append: section.id

  assign cs_count = section.blocks.size

  if cs_layout == 'carousel' and cs_count <= desktop
    assign cs_layout = 'grid'
  endif
-%}

{%- capture content_style -%}
  --section-gap-x: {{ gap_x }}px;
  --section-gap-y: {{ gap_y }}px;
  --section-gap-x-mobile: {{ gap_x_mobile }}px;
  --section-gap-y-mobile: {{ gap_y_mobile }}px;
  --section-inline: {{ inline_axis }};
  --section-align: {{ alignment_axis }};
  --section-block: {{ block_axis }};
{%- endcapture -%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  {%- render 'section-frame', settings: s, media: true -%}
{%- endcapture -%}


<div
  class="section grid-banner-section color-scheme color-{{ s.color_scheme | default: 'scheme-1' }}{% if has_background_media %} has-background-media{% endif %}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: s, placeholder: 'hero-apparel-1' %}
  {%- endif -%}

  <div class="section-inner {% render 'container', width: s.container_width %}">
    <motion-effect
      class="{{ content_classes }}"
      data-easing="outQuint"
      style="{{ content_style | strip_newlines | strip }}"
      {% render 'motion-attrs', kind: 'content', section: s, children: true, duration: 1000, stagger: 450 %}
    >
      {% content_for 'block', type: 'section-header', id: 'grid-banner-header' %}

      {%- if cs_count > 0 -%}
        <carousel-slider
          {% render 'carousel-shell-attrs',
             settings: s,
             id: carousel_id,
             layout: cs_layout,
             layout_mobile: cs_layout_mobile,
             classes: 'grid-banner-section__carousel',
             columns_desktop: desktop,
             columns_tablet: cols_tablet,
             columns_mobile: cols_mobile,
             count: cs_count %}
        >
          <div
            class="carousel-shell__track grid-banner-section__grid"
            data-ref="track"
            {% if cs_is_carousel %}aria-label="{{ cs_label | escape }}"{% endif %}
          >
            {% content_for 'blocks' %}
          </div>

          {% render 'carousel-shell-tail', settings: s, layout: cs_layout, layout_mobile: cs_layout_mobile %}
        </carousel-slider>
      {%- endif -%}
    </motion-effect>
  </div>
</div>

{% schema %}
{
