{% comment %}
  sections/divider.liquid

  A divider a merchant can drop between any two sections.

  It exists as a section as well as a snippet because that is the only way to put
  a rule between two sections in the Theme Editor — a block lives inside a
  section, and the gap between sections belongs to neither of them.

  The wave style carries its own colour rather than inheriting the scheme border,
  because a wave is a shape sitting on a background, and merchants reach for it
  to bridge two differently coloured sections.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
-%}

<div
  class="divider-section color-scheme-container color-{{ section_settings.color_scheme }}"
  {% render 'spacing', section: section_settings %}
>
  {%- if section_settings.width == 'full' -%}
    {% render 'divider',
       style: section_settings.style,
       color: section_settings.color,
       thickness: section_settings.thickness,
       width: 'full',
       flip: section_settings.flip %}
  {%- else -%}
    <div class="{% render 'container', width: section.settings.container_width %}">
      {% render 'divider',
         style: section_settings.style,
         color: section_settings.color,
         thickness: section_settings.thickness,
         width: section_settings.width,
         flip: section_settings.flip %}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.divider.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.divider.settings.style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:sections.divider.settings.style.options__1.label"
        },
        {
          "value": "dashed",
          "label": "t:sections.divider.settings.style.options__2.label"
        },
        {
          "value": "dotted",
          "label": "t:sections.divider.settings.style.options__3.label"
        },
        {
          "value": "wave",
          "label": "t:sections.divider.settings.style.options__4.label"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:settings_schema.gradients.settings.divider_color.label"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "t:settings_schema.gradients.settings.divider_thickness.label",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.divider.settings.width.label",
      "options": [
        {
          "value": "full",
          "label": "t:sections.divider.settings.width.options__1.label"
        },
        {
          "value": "container",
          "label": "t:sections.divider.settings.width.options__2.label"
        },
        {
          "value": "short",
          "label": "t:sections.divider.settings.width.options__3.label"
        }
      ],
      "default": "container"
    },
    {
      "type": "checkbox",
      "id": "flip",
      "label": "t:sections.divider.settings.flip.label",
      "info": "t:sections.divider.settings.flip.info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.divider.name"
    }
  ]
}
{% endschema %}
