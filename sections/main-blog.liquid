{% comment %}
  sections/main-blog.liquid

  The article list.

  Tag filtering is real links, not a script. Shopify already serves
  blog.url + /tagged/handle, so each tag is crawlable, shareable and works with
  the Back button — none of which is true of a filter that only exists in memory.

  The grid reuses product-grid for its pagination, so load-more and infinite
  scroll behave exactly as they do on a collection. data-item-selector points at
  articles instead of products, which is the only difference.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
  assign per_page = section_settings.posts_per_page | default: 12
-%}

<div
  class="main-blog color-scheme-container color-{{ section_settings.color_scheme }}"
  {% render 'spacing', section: section_settings %}
>
  <div class="{% render 'container', width: section.settings.container_width %}">
    <div class="main-blog__head main-blog__head--{{ section_settings.alignment }}">
      {%- if section_settings.show_title -%}
        <motion-effect {% render 'motion-attrs', kind: 'text', section: section_settings %}>
          <h1 class="main-blog__title">{{ blog.title }}</h1>
        </motion-effect>
      {%- endif -%}

      {%- if section_settings.show_tags and blog.all_tags.size > 0 -%}
        <nav class="main-blog__tags" aria-label="{{ 'blogs.article.tags' | t }}">
          <ul class="main-blog__tag-list" role="list">
            <li>
              <a
                class="main-blog__tag"
                href="{{ blog.url }}"
                {% if current_tags == empty %}aria-current="page"{% endif %}
              >
                {{ 'blogs.article.all_topics' | t }}
              </a>
            </li>

            {%- for tag in blog.all_tags -%}
              <li>
                <a
                  class="main-blog__tag"
                  href="{{ blog.url }}/tagged/{{ tag | handle }}"
                  {% if current_tags contains tag %}aria-current="page"{% endif %}
                >
                  {{ tag }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- if blog.articles_count > 0 -%}
      {% paginate blog.articles by per_page %}
        {%- capture children -%}
          {%- for article in blog.articles -%}
            <li class="product-grid__item" data-article-id="{{ article.id }}">
              {% render 'article-card',
                 article: article,
                 index: forloop.index0,
                 priority: forloop.first,
                 show_image: section_settings.show_image,
                 show_excerpt: section_settings.show_excerpt,
                 show_date: section_settings.show_date,
                 show_author: section_settings.show_author %}
            </li>
          {%- endfor -%}
        {%- endcapture -%}

        {% render 'product-grid', children: children, paginate: paginate, section: section, total: blog.articles_count, item_selector: '[data-article-id]', id: 'ArticleGrid-', append: section.id %}
      {% endpaginate %}
    {%- else -%}
      <p class="main-blog__empty">{{ 'blogs.article.no_articles' | t }}</p>
    {%- endif -%}

    <div class="main-blog__blocks">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

