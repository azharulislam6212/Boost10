{% comment %}
  sections/collection-banner.liquid

  The collection heading, description and image.

  The `<h1>` lives here rather than in the grid section, because a collection page
  should have exactly one and the grid is also used by search, where the heading
  says something else.

  The description is rendered as the merchant wrote it. Truncating it behind a
  show-more control by default hides the text search engines read and customers
  came for; the option exists, off.
{% endcomment %}

{%- liquid
  assign show_image = false
  if section.settings.show_image and collection.image != blank
    assign show_image = true
  endif
-%}

<div
  class="collection-banner collection-banner--{{ section.settings.layout }} color-scheme-container color-{{ section.settings.color_scheme }}"
  {% render 'spacing', section: section.settings %}
>
  {%- if show_image -%}
    <div class="collection-banner__media">
      {% render 'image',
         image: collection.image,
         alt: collection.title,
         ratio: section.settings.image_ratio,
         mobile_ratio: 'square',
         priority: true,
         preload: true,
         sizes: '100vw' %}
    </div>
  {%- endif -%}

  <div class="{% render 'container', width: section.settings.container_width, classes: 'collection-banner__inner collection-banner__inner--{{ section.settings.alignment }}' %}">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="collection-banner__breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
        <ol role="list">
          <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
          <li aria-current="page">{{ collection.title }}</li>
        </ol>
      </nav>
    {%- endif -%}

    {%- if section.settings.show_title -%}
      <motion-effect {% render 'motion-attrs', kind: 'text', section: section.settings %}>
        <h1 class="collection-banner__title">{{ collection.title }}</h1>
      </motion-effect>
    {%- endif -%}

    {%- if section.settings.show_description and collection.description != blank -%}
      {%- if section.settings.truncate_description -%}
        <show-more class="collection-banner__description" data-height="120">
          <div class="rte" data-ref="content">{{ collection.description }}</div>
          <button
            type="button"
            class="button button--link"
            data-ref="button"
            aria-expanded="false"
            data-label-more="{{ 'general.actions.show_more' | t | escape }}"
            data-label-less="{{ 'general.actions.show_less' | t | escape }}"
          >
            {{ 'general.actions.show_more' | t }}
          </button>
        </show-more>
      {%- else -%}
        <div class="collection-banner__description rte">{{ collection.description }}</div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.menu != blank -%}
      {% render 'sub-collections', menu: linklists[section.settings.menu] %}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection_banner.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:sections.collection_banner.settings.show_title.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.collection_banner.settings.show_description.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "truncate_description",
      "label": "t:sections.collection_banner.settings.truncate_description.label",
      "info": "t:sections.collection_banner.settings.truncate_description.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.collection_banner.settings.show_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.collection_banner.settings.show_breadcrumbs.label",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.collection_banner.settings.menu.label",
      "info": "t:sections.collection_banner.settings.menu.info"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.collection_banner.settings.layout.label",
      "options": [
        {
          "value": "stacked",
          "label": "t:sections.collection_banner.settings.layout.options__1.label"
        },
        {
          "value": "overlay",
          "label": "t:sections.collection_banner.settings.layout.options__2.label"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:blocks.image.settings.ratio.label",
      "options": [
        {
          "value": "wide",
          "label": "t:blocks.image.settings.ratio.options__5.label"
        },
        {
          "value": "landscape",
          "label": "t:blocks.image.settings.ratio.options__4.label"
        },
        {
          "value": "square",
          "label": "t:blocks.image.settings.ratio.options__2.label"
        }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
      "type": "select",
      "id": "animation_text",
      "label": "t:shared.animation.animation_text.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_text.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_text.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_text.options__4.label"
        },
        {
          "value": "words-slide-up",
          "label": "t:shared.animation.animation_text.options__9.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    }
  ]
}
{% endschema %}
