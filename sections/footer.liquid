 

{%- liquid
  assign section_settings = section.settings
  assign breakpoint = section_settings.collapse_below | default: 750
-%}

<footer
  class="footer color-{{ section_settings.color_scheme }}"
  role="contentinfo"
  {% render 'spacing', section: section_settings %}
>
  <div class="{% render 'container', width: section.settings.container_width %}">
    {%- if section.blocks.size > 0 -%}
      <accordion-element
        class="footer__blocks"
        {% if section_settings.collapse_on_mobile %}data-collapse-below="{{ breakpoint }}"{% endif %}
        style="--footer-columns: {{ section.blocks.size }};"
      >
        {% content_for 'blocks' %}
      </accordion-element>
    {%- endif -%}

    <div class="footer__bottom">
      {%- if section_settings.show_localization -%}
        {% render 'localization-selectors', id_prefix: 'Footer', class: 'footer__localization' %}
      {%- endif -%}

      <p class="footer__copyright">
        {{ 'sections.footer.copyright_html' | t: year: 'now' | date: '%Y', shop: shop.name }}
        {{ powered_by_link }}
      </p>

      
      {%- if section_settings.show_follow_on_shop -%}
        <div class="footer__follow">
          {{ shop | login_button: action: 'follow' }}
        </div>
      {%- endif -%}

      {%- if section_settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payment">
          <h2 class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</h2>
          <ul class="footer__payment-list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section_settings.policy_menu != blank -%}
        <ul class="footer__policies" role="list">
          {%- for link in section_settings.policy_menu.links -%}
            <li><a class="footer__policy-link" href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "collapse_on_mobile",
      "label": "t:sections.footer.settings.collapse_on_mobile.label",
      "info": "t:sections.footer.settings.collapse_on_mobile.info",
      "default": true
    },
    {
      "type": "range",
      "id": "collapse_below",
      "label": "t:sections.footer.settings.collapse_below.label",
      "min": 480,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 750
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "t:sections.footer.settings.show_localization.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:sections.footer.settings.show_follow_on_shop.label",
      "info": "t:sections.footer.settings.show_follow_on_shop.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "info": "t:sections.footer.settings.show_payment_icons.info",
      "default": true
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "t:sections.footer.settings.policy_menu.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}