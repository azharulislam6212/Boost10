{% comment %}
  The footer, composed rather than configured.
{% endcomment %}

{%- liquid
  assign st = section.settings
  assign has_background_media = false
  if st.background_media != 'none'
    assign has_background_media = true
  endif

  assign background_paint = ''
  if has_background_media == false
    assign background_paint = st.background_color | default: ''
  endif

  # Border widths as top / sides / bottom.
  assign border_size = 0
  assign bw_top = 0
  assign bw_side = 0
  assign bw_bottom = 0
  if st.border_style != 'none'
    assign border_size = st.border_width
    case st.border_sides
      when 'all'
        assign bw_top = border_size
        assign bw_side = border_size
        assign bw_bottom = border_size
      when 'bottom'
        assign bw_bottom = border_size
      when 'top_bottom'
        assign bw_top = border_size
        assign bw_bottom = border_size
      else
        assign bw_top = border_size
    endcase
  endif

  # Corner radius on the top pair, the bottom pair, or both.
  assign r_top = 0
  assign r_top_m = 0
  assign r_bottom = 0
  assign r_bottom_m = 0
  if st.corner_position != 'bottom'
    assign r_top = st.border_radius
    assign r_top_m = st.border_radius_mobile
  endif
  if st.corner_position != 'top'
    assign r_bottom = st.border_radius
    assign r_bottom_m = st.border_radius_mobile
  endif

  assign overlap = 0
  assign overlap_mobile = 0
  if st.stack_layer == 'over' or st.stack_layer == 'under'
    assign overlap = r_top
    assign overlap_mobile = r_top_m
  endif

  assign has_policy = false
  if st.policy_menu != blank and st.policy_menu.links.size > 0
    assign has_policy = true
  endif

  capture section_spacing
    render 'spacing', section: st, declarations: true
  endcapture
-%}

{%- capture footer_styles -%}
  --footer-radius: {{ r_top }}px {{ r_top }}px {{ r_bottom }}px {{ r_bottom }}px;
  --footer-radius-mobile: {{ r_top_m }}px {{ r_top_m }}px {{ r_bottom_m }}px {{ r_bottom_m }}px;
  --section-overlap: {{ overlap }}px;
  --section-overlap-mobile: {{ overlap_mobile }}px;
  {%- if border_size > 0 -%}
    --footer-border-width: {{ bw_top }}px {{ bw_side }}px {{ bw_bottom }}px {{ bw_side }}px;
    --footer-border-style: {{ st.border_style }};
    --footer-border-color: {{ st.border_color | default: 'currentColor' }};
  {%- endif -%}
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
  {{- section_spacing | strip -}}
{%- endcapture -%}

<footer
  class="footer color-scheme color-{{ st.color_scheme }}{% if has_background_media %} has-background-media{% endif %}"
  role="contentinfo"
  data-section-spacing
  {%- if st.stack_layer != blank and st.stack_layer != 'default' %} data-section-layer="{{ st.stack_layer }}"{% endif %}
  style="{{ footer_styles | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: st %}
  {%- endif -%}

  <div class="{% render 'container', width: st.container_width %}">
    {%- if section.blocks.size > 0 -%}
      <motion-effect
        class="footer__panel footer__panel--{{ st.panel_style }}"
        data-easing="outQuint"
        {% render 'motion-attrs', kind: 'content', section: st, children: true, duration: 1000, stagger: 120 %}
      >
        <footer-columns
          id="FooterColumns-{{ section.id }}"
          class="footer__columns"
          data-motion-items
          {% if has_policy %}data-has-policy{% endif %}
          data-collapse-below="750"
        >
          {% content_for 'blocks' %}

          {%- if has_policy -%}
            <div class="footer__policies" style="--column-order: 2;">
              <ul class="footer__policies-list" role="list">
                {%- for link in st.policy_menu.links -%}
                  <li><a class="footer__policy-link" href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </footer-columns>
      </motion-effect>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "_footer-column"
    },
    {
      "type": "_footer-contact"
    },
    {
      "type": "_footer-utilities"
    },
    {
      "type": "_footer-legal"
    },
    {
      "type": "group"
    },
    {
      "type": "menu"
    },
    {
      "type": "email-signup"
    },
    {
      "type": "social-follow"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "divider"
    },
    {
      "type": "spacer"
    },
    {
      "type": "icon-with-text"
    },
    {
      "type": "custom-html"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "panel_style",
      "label": "t:sections.footer.settings.panel_style.label",
      "options": [
        {
          "value": "card",
          "label": "t:sections.footer.settings.panel_style.options__1.label"
        },
        {
          "value": "plain",
          "label": "t:sections.footer.settings.panel_style.options__2.label"
        }
      ],
      "default": "card"
    },
    {
      "type": "header",
      "content": "t:sections.footer.headers.legal_links"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "t:sections.footer.settings.policy_menu.label"
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-4"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:shared.background.media.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.background.media.options__1.label"
        },
        {
          "value": "image",
          "label": "t:shared.background.media.options__2.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "t:shared.background.color.label",
      "visible_if": "{{ section.settings.background_media == 'none' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:shared.background.image.label",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:shared.background.image_mobile.label",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:shared.background.image_position.label",
      "options": [
        {
          "value": "cover",
          "label": "t:shared.background.image_position.options__1.label"
        },
        {
          "value": "fit",
          "label": "t:shared.background.image_position.options__2.label"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.border.style.options__2.label"
        }
      ],
      "default": "dashed"
    },
    {
      "type": "select",
      "id": "border_sides",
      "label": "t:shared.border.sides.label",
      "options": [
        {
          "value": "all",
          "label": "t:shared.options.all"
        },
        {
          "value": "top",
          "label": "t:shared.border.sides.top.label"
        },
        {
          "value": "bottom",
          "label": "t:shared.border.sides.bottom.label"
        },
        {
          "value": "top_bottom",
          "label": "t:shared.border.sides.top_bottom.label"
        }
      ],
      "default": "top",
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:shared.border.thickness.label",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.group.settings.border_color.label",
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:shared.corners.header"
    },
    {
      "type": "select",
      "id": "radius_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "select",
      "id": "corner_position",
      "label": "t:shared.corners.position.label",
      "options": [
        {
          "value": "top",
          "label": "t:shared.border.sides.top.label"
        },
        {
          "value": "bottom",
          "label": "t:shared.border.sides.bottom.label"
        },
        {
          "value": "all",
          "label": "t:shared.options.all"
        }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.radius_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "border_radius_mobile",
      "label": "t:shared.corners.radius.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.radius_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
      "type": "select",
      "id": "animation_text",
      "label": "t:shared.animation.animation_text.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_text.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_text.options__2.label"
        },
        {
          "value": "fade-in",
          "label": "t:shared.animation.animation_text.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_text.options__4.label"
        },
        {
          "value": "slide-up",
          "label": "t:shared.animation.animation_text.options__5.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "select",
      "id": "stack_layer",
      "label": "t:shared.spacing.stack_layer.label",
      "options": [
        {
          "value": "under",
          "label": "t:shared.spacing.stack_layer.options__1.label"
        },
        {
          "value": "default",
          "label": "t:shared.spacing.stack_layer.options__2.label"
        },
        {
          "value": "over",
          "label": "t:shared.spacing.stack_layer.options__3.label"
        }
      ],
      "default": "over"
    }
  ]
}
{% endschema %}
