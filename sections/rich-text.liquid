{% comment %}
  sections/rich-text.liquid

  A narrow column of blocks. It ships no content settings of its own: a heading,
  some text and a button are three theme blocks the merchant already knows, and
  duplicating them here as settings would mean two ways to do the same thing that
  behave slightly differently.

  This is the shape most of the marketing sections take. It is also the smallest
  demonstration of why the block conversion was worth doing.
{% endcomment %}

<div
  class="rich-text color-{{ section.settings.color_scheme }}"
  {% render 'spacing', section: section.settings %}
>
  <div class="container">
    <div
      class="rich-text__inner rich-text__inner--{{ section.settings.alignment }}"
      style="--rich-text-width: {{ section.settings.max_width }}px;"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "tag": "section",
  "class": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select", "id": "alignment", "label": "t:blocks.group.settings.alignment.label",
      "options": [
        { "value": "start", "label": "t:blocks.group.settings.alignment.options__1.label" },
        { "value": "center", "label": "t:blocks.group.settings.alignment.options__2.label" },
        { "value": "end", "label": "t:blocks.group.settings.alignment.options__3.label" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "max_width", "label": "t:blocks.group.settings.max_width.label", "min": 400, "max": 1200, "step": 20, "unit": "px", "default": 720 },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label", "default": "scheme-1" },
    { "type": "header", "content": "t:shared.spacing.section_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "t:shared.spacing.padding_top_mobile.label", "info": "t:shared.spacing.padding_top_mobile.info", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "t:shared.spacing.padding_bottom_mobile.label", "info": "t:shared.spacing.padding_bottom_mobile.info", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.name",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
