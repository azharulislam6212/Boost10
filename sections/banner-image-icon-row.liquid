    },
    {
      "type": "select",
      "id": "stack_layer",
      "label": "t:shared.spacing.stack_layer.label",
      "options": [
        {
          "value": "under",
          "label": "t:shared.spacing.stack_layer.options__1.label"
        },
        {
          "value": "default",
          "label": "t:shared.spacing.stack_layer.options__2.label"
        },
        {
          "value": "over",
          "label": "t:shared.spacing.stack_layer.options__3.label"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "t:sections.banner_image_icon_row.name",
      "category": "t:categories.banners",
      "settings": {
        "padding_top": 96,
        "padding_bottom": 0,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 0,
        "alignment": "center",
        "gap_vertical": 48,
        "gap_vertical_mobile": 24
      },
      "blocks": [
        {
          "type": "section-header",
          "settings": {
            "alignment": "center"
          },
          "static": true,
          "id": "banner-image-icon-row-header",
          "blocks": [
            {
              "type": "subheading",
              "settings": {
                "text": "<p>Our standards</p>",
                "icon": "capsule"
              }
            },
            {
              "type": "text",
              "name": "t:blocks.text.presets.heading.name",
              "settings": {
                "text": "<h2>What we leave out <em>matters as</em> much as what <em>we put in.</em></h2>",
                "preset": "h2"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>We build formulas without compromise — clean ingredients that respect your body and our planet.</p>",
                "preset": "paragraph",
                "max_width": "normal"
              }
            }
          ]
        },
        {
          "type": "group",
          "settings": {
            "direction": "row",
            "gap": 48,
            "alignment": "center",
            "width": "fill"
          },
          "blocks": [
            {
              "type": "icon-with-text",
              "settings": {
                "icon": "no-dairy",
                "shape": "circle",
                "ring_style": "dashed",
                "shape_size": 48,
                "shape_size_mobile": 40,
                "heading": "No Dairy",
                "text": "<p>Gentle on sensitive stomachs.</p>",
                "alignment": "column"
              }
            },
            {
              "type": "icon-with-text",
              "settings": {
                "icon": "no-gluten",
                "shape": "circle",
                "ring_style": "dashed",
                "shape_size": 48,
                "shape_size_mobile": 40,
                "heading": "No Gluten",
                "text": "<p>Free from wheat and fillers.</p>",
                "alignment": "column"
              }
            },
            {
              "type": "icon-with-text",
              "settings": {
                "icon": "sprout",
                "shape": "circle",
                "ring_style": "dashed",
                "shape_size": 48,
                "shape_size_mobile": 40,
                "heading": "No Nonsense",
                "text": "<p>Vegan, non-GMO, and third-party tested.</p>",
                "alignment": "column"
              }
            }
          ]
        },
        {
          "type": "group",
          "settings": {
            "direction": "row",
            "gap": 24,
            "alignment": "center",
            "width": "fill"
          },
          "blocks": [
            {
              "type": "image",
              "settings": {
                "ratio": "16-9",
                "border_radius": 24
