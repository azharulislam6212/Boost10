{% comment %}
  sections/main-product.liquid

  A composition layer, nothing more. It captures the blocks and hands them to
  `product-main-content`, which owns the markup.

  Two private blocks are placed by the theme and cannot be removed: the gallery
  and the details column. Inside the details column, four more private blocks —
  title, price, variant picker, buy buttons — are followed by the merchant's own.
  The customer can always see what the product is, what it costs, which one they
  are choosing, and how to buy it.

  `closest.product` is passed explicitly rather than left for each block to find,
  so the same blocks work here, in quick view, and anywhere else a product is
  rendered.
{% endcomment %}

{%- comment -%}
  The layout is written here rather than in `snippets/product-main-content.liquid`.

  Every column on this page is a theme block, and `{% content_for %}` cannot have
  its output captured - theme-check reports it as an error, because Shopify
  renders blocks with their editor bindings attached and buffering that output
  into a variable is not something the platform supports. Handing three captured
  strings to a wrapper snippet was exactly that, three times over.

  The wrapper was thirty lines and had one caller, so it moves here whole. Same
  markup, same classes, same `--media-column`.
{%- endcomment -%}
{%- liquid
  comment
    A product with one image does not need half the page for it. The gallery
    column narrows, which keeps the buy button closer to the top of the fold.
  endcomment
  assign media_column = '1fr'
  if closest.product.media.size == 1
    assign media_column = '0.9fr'
  endif
-%}

<div
  class="main-product color-scheme-container color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-product-root
  {% render 'spacing', section: section.settings %}
>
  <div class="{% render 'container', width: section.settings.container_width %}">
    <div class="main-product__layout" style="--media-column: {{ media_column }};">
      <div class="main-product__media">
        {%- content_for 'block',
          type: '_product-media-gallery',
          id: 'media-gallery',
          closest.product: closest.product
        -%}
      </div>

      <div class="main-product__info">
        {%- content_for 'block',
          type: '_product-details',
          id: 'product-details',
          closest.product: closest.product
        -%}
      </div>
    </div>

    {%- comment -%}
      The merchant's own blocks. Previously wrapped in `{% if additional_blocks
      != blank %}`, which a capture made possible and `content_for` does not:
      there is no string to test. The wrapper is now always present and empty
      when the merchant has added nothing - an empty `<div>` with no padding of
      its own, which changes nothing on the page.
    {%- endcomment -%}
    <div class="main-product__blocks">
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>

{%- if section.settings.enable_sticky_atc -%}
  <sticky-add-to-cart
    class="sticky-atc"
    data-form="AddToCart-{{ section.id }}"
    data-watch="AddToCart-{{ section.id }}"
    hidden
  >
    <div class="container sticky-atc__inner">
      <span class="sticky-atc__title" data-ref="title">{{ closest.product.title }}</span>
      <span class="sticky-atc__price" data-ref="price"></span>
      <span class="sticky-atc__varaint" data-ref="sticky-variant"></span>
      <button type="button" class="button button--primary" data-ref="submit">
        {{ 'products.product.add_to_cart' | t }}
      </button>
    </div>
  </sticky-add-to-cart>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_product.paragraph"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "t:sections.main_product.settings.enable_sticky_atc.label",
      "info": "t:sections.main_product.settings.enable_sticky_atc.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
      "type": "paragraph",
      "content": "t:shared.animation.paragraph"
    },
    {
      "type": "select",
      "id": "animation_text",
      "label": "t:shared.animation.animation_text.label",
      "info": "t:shared.animation.animation_text.info",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_text.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_text.options__2.label"
        },
        {
          "value": "fade-in",
          "label": "t:shared.animation.animation_text.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_text.options__4.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "animation_image",
      "label": "t:shared.animation.animation_image.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:shared.animation.animation_image.options__1.label"
        },
        {
          "value": "none",
          "label": "t:shared.animation.animation_image.options__2.label"
        },
        {
          "value": "fade-in",
          "label": "t:shared.animation.animation_image.options__3.label"
        },
        {
          "value": "fade-up",
          "label": "t:shared.animation.animation_image.options__4.label"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}