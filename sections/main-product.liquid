{% comment %}
  sections/main-product.liquid

  A composition layer, nothing more. It captures the blocks and hands them to
  `product-main-content`, which owns the markup.

  Two private blocks are placed by the theme and cannot be removed: the gallery
  and the details column. Inside the details column, four more private blocks —
  title, price, variant picker, buy buttons — are followed by the merchant's own.
  The customer can always see what the product is, what it costs, which one they
  are choosing, and how to buy it.

  `closest.product` is passed explicitly rather than left for each block to find,
  so the same blocks work here, in quick view, and anywhere else a product is
  rendered.
{% endcomment %}

{% capture product_media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {%- content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture additional_blocks %}
  {%- content_for 'blocks' -%}
{% endcapture %}

{% render 'product-main-content',
  section_id: section.id,
  section_settings: section.settings,
  media_gallery: product_media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks,
  media_count: closest.product.media.size
%}

{%- if section.settings.enable_sticky_atc -%}
  <sticky-add-to-cart
    class="sticky-atc"
    data-form="AddToCart-{{ section.id }}"
    data-watch="AddToCart-{{ section.id }}"
    hidden
  >
    <div class="container sticky-atc__inner">
      <span class="sticky-atc__title" data-ref="title">{{ closest.product.title }}</span>
      <span class="sticky-atc__price" data-ref="price"></span>
      <span class="sticky-atc__varaint" data-ref="sticky-variant"></span>
      <button type="button" class="button button--primary" data-ref="submit">
        {{ 'products.product.add_to_cart' | t }}
      </button>
    </div>
  </sticky-add-to-cart>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
  { "type": "@theme" }, 
  { "type": "@app" }],
  "settings": [
    { "type": "paragraph", "content": "t:sections.main_product.paragraph" },
    { "type": "checkbox", "id": "enable_sticky_atc", "label": "t:sections.main_product.settings.enable_sticky_atc.label", "info": "t:sections.main_product.settings.enable_sticky_atc.info", "default": true },
    { "type": "header", "content": "t:shared.animation.header" },
    { "type": "paragraph", "content": "t:shared.animation.paragraph" },
    {
      "type": "select", "id": "animation_text", "label": "t:shared.animation.animation_text.label", "info": "t:shared.animation.animation_text.info",
      "options": [
        { "value": "inherit", "label": "t:shared.animation.animation_text.options__1.label" },
        { "value": "none", "label": "t:shared.animation.animation_text.options__2.label" },
        { "value": "fade-in", "label": "t:shared.animation.animation_text.options__3.label" },
        { "value": "fade-up", "label": "t:shared.animation.animation_text.options__4.label" }
      ],
      "default": "inherit"
    },
    {
      "type": "select", "id": "animation_image", "label": "t:shared.animation.animation_image.label",
      "options": [
        { "value": "inherit", "label": "t:shared.animation.animation_image.options__1.label" },
        { "value": "none", "label": "t:shared.animation.animation_image.options__2.label" },
        { "value": "fade-in", "label": "t:shared.animation.animation_image.options__3.label" },
        { "value": "fade-up", "label": "t:shared.animation.animation_image.options__4.label" }
      ],
      "default": "inherit"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label", "default": "scheme-1" },
    { "type": "header", "content": "t:shared.spacing.section_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "t:shared.spacing.padding_top_mobile.label", "info": "t:shared.spacing.padding_top_mobile.info", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "t:shared.spacing.padding_bottom_mobile.label", "info": "t:shared.spacing.padding_bottom_mobile.info", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ]
}
{% endschema %}