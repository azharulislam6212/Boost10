    },
    {
      "type": "select",
      "id": "stack_layer",
      "label": "t:shared.spacing.stack_layer.label",
      "options": [
        {
          "value": "under",
          "label": "t:shared.spacing.stack_layer.options__1.label"
        },
        {
          "value": "default",
          "label": "t:shared.spacing.stack_layer.options__2.label"
        },
        {
          "value": "over",
          "label": "t:shared.spacing.stack_layer.options__3.label"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "t:sections.horizontal_tabs.name",
      "category": "t:categories.text",
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 96,
        "padding_bottom": 96,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 56,
        "border_radius": 40,
        "border_radius_mobile": 24,
        "gap_vertical": 48,
        "gap_vertical_mobile": 24
      },
      "blocks": [
        {
          "type": "section-header",
          "settings": {},
          "static": true,
          "id": "horizontal-tabs-header",
          "blocks": [
            {
              "type": "subheading",
              "settings": {
                "text": "<p>Provenance &amp; testing phases</p>",
                "icon": "capsule"
              }
            },
            {
              "type": "text",
              "name": "t:blocks.text.presets.heading.name",
              "settings": {
                "text": "<h2>What to expect, <em>phase by</em> phase.</h2>",
                "preset": "h2"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Quality is not an overnight switch. Knowing how each phase is verified makes it easier to trust the result.</p>",
                "preset": "paragraph"
              }
            }
          ]
        },
        {
          "type": "tabs",
          "settings": {
            "strip_style": "segmented"
          },
          "blocks": [
            {
              "type": "_tab",
              "settings": {
                "label": "Phase 1: Sourcing",
                "selected": true
              },
              "blocks": [
                {
                  "type": "group",
                  "settings": {
                    "direction": "row",
                    "gap": 40,
                    "alignment": "center",
                    "width": "fill"
                  },
                  "blocks": [
                    {
                      "type": "group",
                      "settings": {
                        "width": "fill"
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "settings": {
                            "text": "<h2>100%</h2>",
                            "preset": "h2"
                          }
                        },
                        {
                          "type": "text",
                          "settings": {
                            "text": "<p>of ingredients traced to their origin</p>",
                            "preset": "paragraph",
                            "color": "muted"
                          }
                        },
                        {
                          "type": "text",
                          "settings": {
                            "text": "<h4>Every ingredient has a known source</h4>",
                            "preset": "h4"
                          }
                        },
                        {
                          "type": "text",
                          "settings": {
                            "text": "<p>We work with growers we know and document where every batch comes from.</p>",
                            "preset": "paragraph"
                          }
                        }
                      ]
                    },
                    {
                      "type": "image",
                      "settings": {
                        "ratio": "4-3",
                        "border_radius": 24
                      }
                    }
