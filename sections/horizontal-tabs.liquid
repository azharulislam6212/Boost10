              ]
            },
            {
              "type": "_tab",
              "settings": {
                "label": "Phases 2 to 4: Harvest & Extraction"
              },
              "blocks": [
                {
                  "type": "group",
                  "settings": {
                    "direction": "row",
                    "gap": 40,
                    "alignment": "center",
                    "width": "fill"
                  },
                  "blocks": [
                    {
                      "type": "group",
                      "settings": {
                        "width": "fill"
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "settings": {
                            "text": "<h2>~100%</h2>",
                            "preset": "h2"
                          }
                        },
                        {
                          "type": "text",
                          "settings": {
                            "text": "<p>of batches traced in the first weeks</p>",
                            "preset": "paragraph",
                            "color": "muted"
                          }
                        },
                        {
                          "type": "text",
                          "settings": {
