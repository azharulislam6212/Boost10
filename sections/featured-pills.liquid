{% comment %}
  One subject, told four ways: a heading cluster, a strip of pill-shaped
  options under it, and one panel of blocks per option.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif

  assign background_paint = ''
  if has_background_media == false
    assign background_paint = s.background_color | default: ''
  endif

  assign border_line = s.border_style | default: 'none'

  assign bw_top = 0
  assign bw_right = 0
  assign bw_bottom = 0
  assign bw_left = 0
  assign border_any = 0

  if border_line != 'none'
    assign bw_top = s.border_width_top | default: 0 | plus: 0
    assign bw_right = s.border_width_right | default: 0 | plus: 0
    assign bw_bottom = s.border_width_bottom | default: 0 | plus: 0
    assign bw_left = s.border_width_left | default: 0 | plus: 0
    assign border_any = bw_top | plus: bw_right | plus: bw_bottom | plus: bw_left

    assign border_percent = s.border_opacity | default: 100 | plus: 0
    if s.border_color == blank
      assign border_paint = 'color-mix(in srgb, currentColor ' | append: border_percent | append: '%, transparent)'
    else
      assign border_alpha = border_percent | divided_by: 100.0
      assign border_paint = s.border_color | color_modify: 'alpha', border_alpha
    endif
  endif

  assign r_tl = s.border_radius_top_left | default: 40 | plus: 0
  assign r_tr = s.border_radius_top_right | default: 40 | plus: 0
  assign r_bl = s.border_radius_bottom_left | default: 0 | plus: 0
  assign r_br = s.border_radius_bottom_right | default: 0 | plus: 0

  assign r_tl_m = s.border_radius_top_left_mobile | default: r_tl | plus: 0
  assign r_tr_m = s.border_radius_top_right_mobile | default: r_tr | plus: 0
  assign r_bl_m = s.border_radius_bottom_left_mobile | default: r_bl | plus: 0
  assign r_br_m = s.border_radius_bottom_right_mobile | default: r_br | plus: 0

  assign margin_top = s.margin_top | default: 0 | plus: 0
  assign margin_bottom = s.margin_bottom | default: 0 | plus: 0

  assign min_height = s.min_height | default: 0 | plus: 0
  assign min_height_mobile = s.min_height_mobile | default: min_height | plus: 0

  assign direction = s.direction | default: 'column'
  assign is_row = false
  if direction == 'row'
    assign is_row = true
  endif

  assign alignment_setting = s.alignment | default: 'center'

  case alignment_setting
    when 'center'
      assign alignment_axis = 'center'
    when 'end'
      assign alignment_axis = 'end'
    else
      assign alignment_axis = 'start'
  endcase

  assign inline_axis = alignment_axis
  if is_row
    case alignment_setting
      when 'space-between', 'space-around', 'space-evenly'
        assign inline_axis = alignment_setting
    endcase
  endif

  case s.position
    when 'center'
      assign block_axis = 'center'
    when 'end'
      assign block_axis = 'end'
    when 'stretch'
      assign block_axis = 'stretch'
    else
      assign block_axis = 'start'
  endcase

  assign gap_x = s.gap_horizontal | default: 40 | plus: 0
  assign gap_y = s.gap_vertical | default: 40 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0
  assign gap_y_mobile = s.gap_vertical_mobile | default: gap_y | plus: 0

  assign content_classes = 'featured-pills__content featured-pills__content--' | append: direction
  if is_row and s.stack_on_mobile
    assign content_classes = content_classes | append: ' featured-pills__content--stack-mobile'
  endif

  if is_row and s.reverse
    assign content_classes = content_classes | append: ' featured-pills__content--reverse'
  endif
-%}

{%- capture content_style -%}
  --featured-pills-gap-x: {{ gap_x }}px;
  --featured-pills-gap-y: {{ gap_y }}px;
  --featured-pills-gap-x-mobile: {{ gap_x_mobile }}px;
  --featured-pills-gap-y-mobile: {{ gap_y_mobile }}px;
  --featured-pills-inline: {{ inline_axis }};
  --featured-pills-align: {{ alignment_axis }};
  --featured-pills-block: {{ block_axis }};
{%- endcapture -%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --featured-pills-radius: {{ r_tl }}px {{ r_tr }}px {{ r_br }}px {{ r_bl }}px;
  --featured-pills-radius-mobile: {{ r_tl_m }}px {{ r_tr_m }}px {{ r_br_m }}px {{ r_bl_m }}px;
  --featured-pills-margin-block-start: {{ margin_top }}px;
  --featured-pills-margin-block-end: {{ margin_bottom }}px;
  --featured-pills-min-height: {{ min_height }}px;
  --featured-pills-min-height-mobile: {{ min_height_mobile }}px;
  {%- if border_any > 0 -%}
    --featured-pills-border-width: {{ bw_top }}px {{ bw_right }}px {{ bw_bottom }}px {{ bw_left }}px;
    --featured-pills-border-style: {{ border_line }};
    --featured-pills-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="featured-pills color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}{% if has_background_media %} has-background-media{% endif %}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: s %}
  {%- endif -%}

  <div class="featured-pills__inner {% render 'container', width: s.container_width %}">

    <motion-effect
      class="{{ content_classes }}"
      data-easing="outQuint"
      style="{{ content_style | strip_newlines | strip }}"
      {% render 'motion-attrs', kind: 'text', section: s, children: true %}
    >
      {% content_for 'blocks' %}
    </motion-effect>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_pills.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "_featured-pills-tabs"
    },
    {
      "type": "_featured-pills-group"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.featured_pills.paragraphs.blocks"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.group.settings.direction.label",
      "options": [
        {
          "value": "column",
          "label": "t:blocks.group.settings.direction.options__1.label"
        },
        {
          "value": "row",
          "label": "t:blocks.group.settings.direction.options__2.label"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "t:sections.featured_offer.settings.reverse.label",
      "info": "t:sections.featured_offer.settings.reverse.info",
      "default": false,
      "visible_if": "{{ section.settings.direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:blocks.group.settings.stack_on_mobile.label",
      "info": "t:blocks.group.settings.stack_on_mobile.info",
      "default": true,
      "visible_if": "{{ section.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        },
        {
          "value": "space-between",
          "label": "t:blocks.group.settings.distribution.options__2.label"
        },
        {
          "value": "space-around",
          "label": "t:blocks.group.settings.distribution.options__3.label"
        },
        {
          "value": "space-evenly",
          "label": "t:blocks.group.settings.distribution.options__4.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:blocks.group.settings.position.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.position.options__3.label"
        },
        {
          "value": "stretch",
          "label": "t:sections.featured_offer.settings.position.options__4.label"
        }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.direction == 'row' }}"
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_horizontal_mobile",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical_mobile",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:sections.featured_offer.headers.height"
    },
    {
      "type": "paragraph",
      "content": "t:sections.featured_offer.paragraphs.height"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "t:sections.featured_offer.settings.min_height.label",
      "min": 0,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "t:sections.featured_offer.settings.min_height_mobile.label",
      "info": "t:sections.featured_offer.settings.min_height_mobile.info",
      "min": 0,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:shared.background.media.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.background.media.options__1.label"
        },
        {
          "value": "image",
          "label": "t:shared.background.media.options__2.label"
        },
        {
          "value": "video",
          "label": "t:shared.background.media.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "t:shared.background.color.label",
      "info": "t:shared.background.color.info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:shared.background.image.label",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:shared.background.image_mobile.label",
      "info": "t:shared.background.image_mobile.info",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:shared.background.image_position.label",
      "info": "t:shared.background.image_position.info",
      "options": [
        {
          "value": "cover",
          "label": "t:shared.background.image_position.options__1.label"
        },
        {
          "value": "fit",
          "label": "t:shared.background.image_position.options__2.label"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "image_parallax",
      "label": "t:shared.background.image_parallax.label",
      "info": "t:shared.background.image_parallax.info",
      "default": false,
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "range",
      "id": "image_parallax_speed",
      "label": "t:shared.background.image_parallax_speed.label",
      "info": "t:shared.background.image_parallax_speed.info",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "%",
      "default": 15,
      "visible_if": "{{ section.settings.background_media == 'image' and section.settings.image_parallax }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:shared.background.video.label",
      "info": "t:shared.background.video.info",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:shared.background.video_url.label",
      "info": "t:shared.background.video_url.info",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "t:shared.background.video_poster.label",
      "info": "t:shared.background.video_poster.info",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:shared.background.video_position.label",
      "options": [
        {
          "value": "cover",
          "label": "t:shared.background.video_position.options__1.label"
        },
        {
          "value": "contain",
          "label": "t:shared.background.video_position.options__2.label"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:shared.background.video_loop.label",
      "default": true,
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "overlay_enabled",
      "label": "t:shared.background.overlay_enabled.label",
      "info": "t:shared.background.overlay_enabled.info",
      "default": false,
      "visible_if": "{{ section.settings.background_media != 'none' }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:shared.background.overlay_style.label",
      "info": "t:shared.background.overlay_style.info",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.background.overlay_style.options__1.label"
        },
        {
          "value": "gradient",
          "label": "t:shared.background.overlay_style.options__2.label"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.background_media != 'none' and section.settings.overlay_enabled }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:shared.background.overlay_color.label",
      "default": "#000000",
      "visible_if": "{{ section.settings.background_media != 'none' and section.settings.overlay_enabled and section.settings.overlay_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "label": "t:shared.background.overlay_gradient.label",
      "info": "t:shared.background.overlay_gradient.info",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 1) 100%)",
      "visible_if": "{{ section.settings.background_media != 'none' and section.settings.overlay_enabled and section.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:shared.background.overlay_opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ section.settings.background_media != 'none' and section.settings.overlay_enabled }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.borders"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.group.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:shared.border.style.options__2.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width_top",
      "label": "t:shared.border.sides.top.label",
      "info": "t:shared.border.sides.info",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_width_right",
      "label": "t:shared.border.sides.right.label",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_width_bottom",
      "label": "t:shared.border.sides.bottom.label",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_width_left",
      "label": "t:shared.border.sides.left.label",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0,
