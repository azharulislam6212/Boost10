{% comment %}
  A row of feature cards inside one bordered panel. Each card is a title, a
  ringed icon and a line of text; hovering one fills it with a picture and
  swaps the icon's colour. The Cards panel static block holds the cards, their
  layout and the carousel; the section keeps its frame and spacing.
{% endcomment %}

{%- liquid
  assign s = section.settings


  assign card_stagger = 120
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --fc-space: {{ s.space_between | default: 32 | plus: 0 }}px;
  --fc-space-mobile: {{ s.space_between_mobile | default: 16 | plus: 0 }}px;
  {%- render 'section-frame', settings: s, border_default: 'dashed' -%}
{%- endcapture -%}

<div
  class="feature-cards color-scheme color-{{ s.color_scheme | default: 'scheme-1' }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>

  <div class="{% render 'container', width: s.container_width %}">

    <motion-effect
      class="feature-cards__header"
      {% render 'motion-attrs', kind: 'content', section: s, children: true, duration: 800, stagger: card_stagger %}
    >
      {% content_for 'block', type: 'section-header', id: 'feature-cards-header' %}
    </motion-effect>

    {% content_for 'block', type: '_feature-cards-panel', id: 'cards-panel' %}

    <motion-effect
      class="feature-cards__footer"
      {% render 'motion-attrs', kind: 'content', section: s, children: true, duration: 800, stagger: card_stagger %}
    >
      {% content_for 'block', type: 'section-header', id: 'feature-cards-footer' %}
    </motion-effect>
  </div>
</div>

