{% comment %}
  A row of feature cards inside one bordered panel. Each card is a title, a
  ringed icon and a line of text; hovering one fills it with a picture and
  swaps the icon's colour.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign desktop = s.columns_desktop | default: 4 | plus: 0

  assign cols_mobile = s.columns_mobile | default: 1 | plus: 0
  if cols_mobile > 2
    assign cols_mobile = 2
  endif
  if cols_mobile < 1
    assign cols_mobile = 1
  endif

  assign cols_tablet = s.columns_tablet | default: 2 | plus: 0

  assign background_paint = s.background_color | default: ''

  assign margin_top = s.margin_top | default: 0 | plus: 0
  assign margin_bottom = s.margin_bottom | default: 0 | plus: 0

  assign panel_radius = s.panel_border_radius | default: 40 | plus: 0
  assign panel_radius_mobile = s.panel_border_radius_mobile | default: panel_radius | plus: 0

  assign panel_clipped = false
  if panel_radius > 0 or panel_radius_mobile > 0
    assign panel_clipped = true
  endif

  assign layout_type = s.layout | default: 'grid'

  assign cs_layout = 'grid'
  if layout_type == 'carousel'
    assign cs_layout = 'carousel'
  endif

  assign carousel_on_mobile = s.carousel_on_mobile
  if carousel_on_mobile == nil
    assign carousel_on_mobile = true
  endif

  assign cs_layout_mobile = 'grid'
  if layout_type == 'carousel' or carousel_on_mobile
    assign cs_layout_mobile = 'carousel'
  endif

  assign cs_is_carousel = false
  if cs_layout == 'carousel' or cs_layout_mobile == 'carousel'
    assign cs_is_carousel = true
  endif

  assign cs_count = 0
  for feature_block in section.blocks
    if feature_block.type == '_feature-card'
      assign cs_count = cs_count | plus: 1
    endif
  endfor

  assign cs_label = 'accessibility.carousel' | t

  assign carousel_id = 'feature-cards-' | append: section.id

  assign gap_x = s.gap_horizontal | default: 24 | plus: 0
  assign gap_y = s.gap_vertical | default: 24 | plus: 0

  assign gap_x_mobile = s.gap_horizontal_mobile | plus: 0
  if s.gap_horizontal_mobile == nil
    assign gap_x_mobile = 12
  endif
  assign gap_y_mobile = s.gap_vertical_mobile | plus: 0
  if s.gap_vertical_mobile == nil
    assign gap_y_mobile = 12
  endif

  assign card_stagger = s.animation_stagger | default: 120 | plus: 0
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --fc-gap-x: {{ gap_x }}px;
  --fc-gap-y: {{ gap_y }}px;
  --fc-gap-x-mobile: {{ gap_x_mobile }}px;
  --fc-gap-y-mobile: {{ gap_y_mobile }}px;
  --feature-cards-radius: var(--section-frame-radius, 40px 40px 0px 0px);
  --feature-cards-radius-mobile: var(--section-frame-radius-mobile, 24px 24px 0px 0px);
  --feature-cards-margin-block-start: {{ margin_top }}px;
  --feature-cards-margin-block-end: {{ margin_bottom }}px;
  --feature-cards-border-width: var(--section-frame-border-width, 1px 0px 0px 0px);
  --feature-cards-border-style: var(--section-frame-border-style, dashed);
  --feature-cards-border-color: var(--section-frame-border-color, color-mix(in srgb, currentColor 100%, transparent));
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

{%- capture panel_style -%}
  --feature-cards-panel-radius: {{ panel_radius }}px;
  --feature-cards-panel-radius-mobile: {{ panel_radius_mobile }}px;
  --feature-cards-controls-gap: {{ s.carousel_controls_gap | default: 24 | plus: 0 }}px;
  {% content_for 'block', type: '_feature-cards-panel', id: 'feature-cards-panel' %}
{%- endcapture -%}

{%- capture frame_style -%}
  {% content_for 'block', type: '_section-frame', id: 'section-frame' %}
{%- endcapture -%}

<div
  class="feature-cards color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}{{ frame_style | strip_newlines | strip }}"
>
  {% content_for 'block', type: '_background-media', id: 'section-background' %}

  <div class="{% render 'container', width: s.container_width %}">

    <motion-effect
      class="feature-cards__header feature-cards__header--{{ s.alignment | default: 'center' }}"
      {% render 'motion-attrs', kind: 'text', section: s, children: true %}
    >
      {% content_for 'block', type: 'section-header', id: 'feature-cards-header' %}
    </motion-effect>

    <motion-effect
      class="feature-cards__panel{% if panel_clipped %} feature-cards__panel--clipped{% endif %}"
      style="{{ panel_style | strip_newlines | strip }}"
      {% render 'motion-attrs',
         kind: 'image',
         section: s,
         target: '.feature-card',
         stagger: card_stagger %}
    >

      <carousel-slider
        {% render 'carousel-shell-attrs',
           settings: s,
           id: carousel_id,
           layout: cs_layout,
           layout_mobile: cs_layout_mobile,
           classes: 'feature-cards__carousel',
           columns_desktop: desktop,
           columns_tablet: cols_tablet,
           columns_mobile: cols_mobile,
           count: cs_count %}
      >
        <div
          class="carousel-shell__track feature-cards__grid"
          data-ref="track"
          {% if cs_is_carousel %}aria-label="{{ cs_label | escape }}"{% endif %}
        >
          {% content_for 'blocks' %}
        </div>

        {% render 'carousel-shell-tail',
           settings: s,
           layout: cs_layout,
           layout_mobile: cs_layout_mobile,
           detached: true %}
      </carousel-slider>
    </motion-effect>

    {% content_for 'block', type: '_feature-cards-controls', id: 'feature-cards-controls' %}

    {%- liquid
      assign show_footer = s.show_footer
      if show_footer == nil
        assign show_footer = true
      endif
    -%}
    {%- if show_footer -%}

      <motion-effect
        class="feature-cards__footer feature-cards__footer--{{ s.footer_alignment | default: 'center' }}"
        {% render 'motion-attrs', kind: 'text', section: s, children: true %}
      >
        {% content_for 'block', type: 'section-header', id: 'feature-cards-footer' %}
      </motion-effect>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.feature_cards.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "_feature-card"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "info": "t:sections.feature_cards.settings.alignment.info",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "device",
      "label": "t:shared.spacing.devices.label",
      "info": "t:shared.spacing.devices.info",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "header",
      "content": "t:sections.featured_blog.headers.cards"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:shared.carousel.layout_type.label",
      "info": "t:shared.carousel.layout_type.info",
      "options": [
        {
          "value": "grid",
          "label": "t:shared.carousel.layout_type.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:shared.carousel.layout_type.options__2.label"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:shared.carousel.carousel_on_mobile.label",
      "info": "t:shared.carousel.carousel_on_mobile.info",
      "default": true,
      "visible_if": "{{ section.settings.layout != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns.desktop.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:shared.carousel.columns_tablet.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.carousel.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:shared.carousel.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:shared.carousel.columns_mobile.options__2.label"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_horizontal_mobile",
      "label": "t:shared.gap.horizontal.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "gap_vertical_mobile",
      "label": "t:shared.gap.vertical.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:sections.feature_cards.headers.panel"
    },
    {
      "type": "paragraph",
      "content": "t:sections.feature_cards.paragraphs.panel"
    },
    {
      "type": "range",
      "id": "panel_border_radius",
      "label": "t:shared.corners.radius.label",
      "info": "t:sections.feature_cards.settings.panel_border_radius.info",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "panel_border_radius_mobile",
      "label": "t:shared.corners.radius_mobile.label",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:sections.feature_cards.headers.footer"
    },
    {
      "type": "paragraph",
      "content": "t:sections.feature_cards.paragraphs.footer"
    },
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "t:sections.feature_cards.settings.show_footer.label",
      "info": "t:sections.feature_cards.settings.show_footer.info",
      "default": true
    },
    {
      "type": "select",
      "id": "footer_alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.show_footer }}"
    },
    {
      "type": "header",
      "content": "t:sections.featured_blog.headers.section"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "t:shared.appearance.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "t:shared.background.color.label",
      "info": "t:shared.background.color.info"
    },
    {
      "type": "paragraph",
      "content": "t:sections.feature_cards.paragraphs.borders"
    },
    {
      "type": "header",
      "content": "t:sections.featured_blog.headers.carousel",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "paragraph",
      "content": "t:sections.featured_blog.paragraphs.carousel",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "range",
      "id": "carousel_speed",
      "label": "t:shared.carousel.speed.label",
      "info": "t:shared.carousel.speed.info",
      "min": 100,
      "max": 1500,
      "step": 50,
      "unit": "ms",
      "default": 500,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_loop",
      "label": "t:shared.carousel.loop.label",
      "default": false,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "t:shared.carousel.autoplay.label",
      "info": "t:shared.carousel.autoplay.info",
      "default": false,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "range",
      "id": "carousel_autoplay_delay",
      "label": "t:shared.carousel.autoplay_delay.label",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.carousel_autoplay and section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.peek",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "paragraph",
      "content": "t:shared.carousel.paragraphs.peek",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "range",
      "id": "carousel_peek_mobile",
      "label": "t:shared.carousel.peek_mobile.label",
      "info": "t:shared.carousel.peek_mobile.info",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0,
