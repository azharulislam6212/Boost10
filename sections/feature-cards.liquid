    },
    {
      "type": "range",
      "id": "carousel_peek_desktop",
      "label": "t:shared.carousel.peek_desktop.label",
      "info": "t:shared.carousel.peek_desktop.info",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.pagination",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "range",
      "id": "carousel_controls_gap",
      "label": "t:sections.feature_cards.settings.carousel_controls_gap.label",
      "info": "t:sections.feature_cards.settings.carousel_controls_gap.info",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.controls",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "paragraph",
      "content": "t:shared.carousel.paragraphs.colors",
