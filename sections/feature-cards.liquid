    },
    {
      "type": "color_scheme",
      "id": "carousel_color_scheme",
      "label": "t:shared.color_scheme.label",
      "info": "t:shared.carousel.color_scheme.info",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.carousel_inherit_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:shared.animation.header"
    },
    {
      "type": "select",
      "id": "animation_text",
      "label": "t:shared.animation.animation_text.label",
