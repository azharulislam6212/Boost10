{% comment %}
  One product, and the things worth saying about it pinned around it — each a
  mark, a number, a name and a line, lighting up in turn as the section scrolls
  past.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif

  assign background_paint = ''
  if has_background_media == false
    assign background_paint = s.background_color | default: ''
  endif

  assign border_line = s.border_style | default: 'none'

  assign bw_top = 0
  assign bw_right = 0
  assign bw_bottom = 0
  assign bw_left = 0
  assign border_any = 0

  if border_line != 'none'
    assign bw_top = s.border_width_top | default: 0 | plus: 0
    assign bw_right = s.border_width_right | default: 0 | plus: 0
    assign bw_bottom = s.border_width_bottom | default: 0 | plus: 0
    assign bw_left = s.border_width_left | default: 0 | plus: 0
    assign border_any = bw_top | plus: bw_right | plus: bw_bottom | plus: bw_left

    assign border_percent = s.border_opacity | default: 100 | plus: 0
    if s.border_color == blank
      assign border_paint = 'color-mix(in srgb, currentColor ' | append: border_percent | append: '%, transparent)'
    else
      assign border_alpha = border_percent | divided_by: 100.0
      assign border_paint = s.border_color | color_modify: 'alpha', border_alpha
    endif
  endif

  assign r_tl = s.border_radius_top_left | default: 40 | plus: 0
  assign r_tr = s.border_radius_top_right | default: 40 | plus: 0
  assign r_bl = s.border_radius_bottom_left | default: 0 | plus: 0
  assign r_br = s.border_radius_bottom_right | default: 0 | plus: 0

  assign r_tl_m = s.border_radius_top_left_mobile | default: r_tl | plus: 0
  assign r_tr_m = s.border_radius_top_right_mobile | default: r_tr | plus: 0
  assign r_bl_m = s.border_radius_bottom_left_mobile | default: r_bl | plus: 0
  assign r_br_m = s.border_radius_bottom_right_mobile | default: r_br | plus: 0

  assign margin_top = s.margin_top | default: 0 | plus: 0
  assign margin_bottom = s.margin_bottom | default: 0 | plus: 0

  assign min_height = s.min_height | default: 0 | plus: 0
  assign min_height_mobile = s.min_height_mobile | default: min_height | plus: 0

  assign direction = s.direction | default: 'column'
  assign is_row = false
  if direction == 'row'
    assign is_row = true
  endif

  assign alignment_setting = s.alignment | default: 'center'

  case alignment_setting
    when 'center'
      assign alignment_axis = 'center'
    when 'end'
      assign alignment_axis = 'end'
    else
      assign alignment_axis = 'start'
  endcase

  assign inline_axis = alignment_axis
  if is_row
    case alignment_setting
      when 'space-between', 'space-around', 'space-evenly'
        assign inline_axis = alignment_setting
    endcase
  endif

  case s.position
    when 'center'
      assign block_axis = 'center'
    when 'end'
      assign block_axis = 'end'
    when 'stretch'
      assign block_axis = 'stretch'
    else
      assign block_axis = 'start'
  endcase

  assign gap_x = s.gap_horizontal | default: 40 | plus: 0
  assign gap_y = s.gap_vertical | default: 40 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0
  assign gap_y_mobile = s.gap_vertical_mobile | default: gap_y | plus: 0

  assign content_classes = 'product-highlight-point__content product-highlight-point__content--' | append: direction
  if is_row and s.stack_on_mobile
    assign content_classes = content_classes | append: ' product-highlight-point__content--stack-mobile'
  endif

  if is_row and s.reverse
    assign content_classes = content_classes | append: ' product-highlight-point__content--reverse'
  endif
-%}

{%- capture content_style -%}
  --product-highlight-point-gap-x: {{ gap_x }}px;
  --product-highlight-point-gap-y: {{ gap_y }}px;
  --product-highlight-point-gap-x-mobile: {{ gap_x_mobile }}px;
  --product-highlight-point-gap-y-mobile: {{ gap_y_mobile }}px;
  --product-highlight-point-inline: {{ inline_axis }};
  --product-highlight-point-align: {{ alignment_axis }};
  --product-highlight-point-block: {{ block_axis }};
{%- endcapture -%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --product-highlight-point-radius: {{ r_tl }}px {{ r_tr }}px {{ r_br }}px {{ r_bl }}px;
  --product-highlight-point-radius-mobile: {{ r_tl_m }}px {{ r_tr_m }}px {{ r_br_m }}px {{ r_bl_m }}px;
  --product-highlight-point-margin-block-start: {{ margin_top }}px;
  --product-highlight-point-margin-block-end: {{ margin_bottom }}px;
  --product-highlight-point-min-height: {{ min_height }}px;
  --product-highlight-point-min-height-mobile: {{ min_height_mobile }}px;
  {%- if border_any > 0 -%}
    --product-highlight-point-border-width: {{ bw_top }}px {{ bw_right }}px {{ bw_bottom }}px {{ bw_left }}px;
    --product-highlight-point-border-style: {{ border_line }};
    --product-highlight-point-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="product-highlight-point color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}{% if has_background_media %} has-background-media{% endif %}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: s %}
  {%- endif -%}

  <div class="product-highlight-point__inner {% render 'container', width: s.container_width %}">

    <motion-effect
      class="{{ content_classes }}"
      data-easing="outQuint"
      style="{{ content_style | strip_newlines | strip }}"
      {% render 'motion-attrs', kind: 'text', section: s, children: true %}
    >
      {% content_for 'blocks' %}
    </motion-effect>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.product_highlight_point.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "_highlight-stage"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.product_highlight_point.paragraphs.blocks"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "t:blocks.group.headers.layout"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.group.settings.direction.label",
      "options": [
        {
          "value": "column",
          "label": "t:blocks.group.settings.direction.options__1.label"
        },
        {
          "value": "row",
          "label": "t:blocks.group.settings.direction.options__2.label"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "t:sections.featured_offer.settings.reverse.label",
      "info": "t:sections.featured_offer.settings.reverse.info",
      "default": false,
      "visible_if": "{{ section.settings.direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:blocks.group.settings.stack_on_mobile.label",
      "info": "t:blocks.group.settings.stack_on_mobile.info",
      "default": true,
      "visible_if": "{{ section.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        },
        {
          "value": "space-between",
          "label": "t:blocks.group.settings.distribution.options__2.label"
        },
        {
          "value": "space-around",
          "label": "t:blocks.group.settings.distribution.options__3.label"
        },
        {
          "value": "space-evenly",
          "label": "t:blocks.group.settings.distribution.options__4.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:blocks.group.settings.position.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.position.options__3.label"
        },
