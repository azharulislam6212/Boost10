        },
        {
          "value": "default",
          "label": "t:shared.spacing.stack_layer.options__2.label"
        },
        {
          "value": "over",
          "label": "t:shared.spacing.stack_layer.options__3.label"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "t:sections.vertical_tabs.name",
      "category": "t:categories.text",
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 96,
        "padding_bottom": 96,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 56,
        "border_radius": 40,
        "border_radius_mobile": 24,
        "gap_vertical": 48,
        "gap_vertical_mobile": 24
      },
      "blocks": [
        {
          "type": "section-header",
          "settings": {},
          "static": true,
          "id": "vertical-tabs-header",
          "blocks": [
            {
              "type": "subheading",
              "settings": {
                "text": "<p>What’s included</p>",
                "icon": "capsule"
              }
            },
            {
              "type": "text",
              "name": "t:blocks.text.presets.heading.name",
              "settings": {
                "text": "<h2>Inside our 950+ screens.</h2>",
                "preset": "h2"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Every production batch is verified against strict standards and screened for contaminants.</p>",
                "preset": "paragraph"
              }
            },
            {
              "type": "button",
              "settings": {
                "label": "Subscribe For Exclusive Deals",
                "link": "/collections/all"
              }
            }
          ]
        },
        {
          "type": "tabs",
          "settings": {
            "direction": "vertical",
            "strip_style": "segmented"
          },
          "blocks": [
            {
              "type": "_tab",
              "settings": {
                "label": "Heavy Metals Testing",
                "selected": true,
                "icon_source": "icon",
                "icon": "flask"
              },
              "blocks": [
                {
                  "type": "group",
                  "settings": {
                    "direction": "row",
                    "gap": 40,
                    "alignment": "center",
                    "width": "fill"
                  },
                  "blocks": [
                    {
                      "type": "group",
                      "settings": {
                        "width": "fill"
                      },
                      "blocks": [
                        {
