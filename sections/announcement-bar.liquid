{% comment %}
  Announcements as a slider or a dot-separated marquee, with an optional close button.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
  assign count = section.blocks.size
  assign mode = section_settings.mode
  assign pagination = section_settings.carousel_pagination

  assign show_nav = section_settings.carousel_navigation
  if show_nav == nil
    assign show_nav = true
  endif

  assign should_render = true
  if section_settings.homepage_only and request.page_type != 'index'
    assign should_render = false
  endif
-%}

{%- if count > 0 and should_render -%}
  {%- capture announcements -%}{%- content_for 'blocks' -%}{%- endcapture -%}
  {%- assign dismiss_key = announcements | strip_html | strip | md5 | slice: 0, 10 -%}

  <announcement-bar
    id="AnnouncementBar-{{ section.id }}"
    class="announcement-bar color-scheme color-{{ section_settings.color_scheme }}{% unless section_settings.enable_on_mobile %} announcement-bar--desktop-only{% endunless %}"
    data-announcement-bar
    data-section-id="{{ section.id }}"
    data-dismiss-key="{{ dismiss_key }}"
    {% if section_settings.show_close %}data-dismissible{% endif %}
    {% render 'spacing', section: section_settings %}
  >
    <div class="{% render 'container', width: section_settings.container_width, classes: 'announcement-bar__inner' %}">
      {%- if mode == 'marquee' -%}
        <motion-effect
          id="AnnouncementMarquee-{{ section.id }}"
          class="announcement-bar__marquee marquee__viewport"
          data-effect="marquee"
          data-target=".marquee__track"
          data-direction="{{ section_settings.marquee_direction }}"
          data-speed="{{ section_settings.marquee_speed }}"
          data-pause-on-hover="{{ section_settings.pause_on_hover | default: true }}"
          role="marquee"
          aria-label="{{ 'sections.announcements.carousel_label' | t }}"
        >
          <div class="marquee__track" data-marquee-track>
            <div class="announcement-bar__group">{{ announcements }}</div>
            {%- for i in (1..4) -%}
              <div class="announcement-bar__group" data-marquee-clone aria-hidden="true" inert>
                {{- announcements -}}
              </div>
            {%- endfor -%}
          </div>
        </motion-effect>
      {%- elsif mode == 'slider' and count > 1 -%}
        <carousel-slider
          class="announcement-bar__carousel carousel-shell"
          data-layout="carousel"
          data-layout-mobile="carousel"
          data-options="{%- render 'carousel-options', settings: section_settings, count: count, columns_desktop: 1, columns_tablet: 1, columns_mobile: 1, pagination: pagination -%}"
          style="{% render 'carousel-vars', settings: section_settings, columns_desktop: 1, columns_tablet: 1, columns_mobile: 1, peek_mobile: 0, peek_desktop: 0 %}{% render 'carousel-style', settings: section_settings %}"
        >
          <div
            class="announcement-bar__track carousel-shell__track"
            data-ref="track"
            role="group"
            aria-label="{{ 'sections.announcements.carousel_label' | t }}"
          >
            {{ announcements }}
          </div>

          {%- if show_nav -%}
            {% render 'carousel-nav', settings: section_settings, position: 'inside', size: 28 %}
          {%- endif -%}

          {%- if pagination == 'controls' -%}
            {% render 'carousel-controls', settings: section_settings, size: 28 %}
          {%- elsif pagination != 'none' -%}
            {% render 'carousel-pagination', style: pagination %}
          {%- endif -%}

          {%- if section_settings.carousel_autoplay -%}
            <button type="button" class="carousel-shell__pause announcement-bar__pause" data-ref="pause" aria-pressed="false" hidden>
              <span class="carousel-shell__pause-glyph carousel-shell__pause-glyph--pause">{% render 'icon', icon: 'pause', size: 12 %}</span>
              <span class="carousel-shell__pause-glyph carousel-shell__pause-glyph--play">{% render 'icon', icon: 'play', size: 12 %}</span>
              <span class="visually-hidden carousel-shell__pause-glyph carousel-shell__pause-glyph--pause">{{ 'accessibility.pause_slideshow' | t }}</span>
              <span class="visually-hidden carousel-shell__pause-glyph carousel-shell__pause-glyph--play">{{ 'accessibility.play_slideshow' | t }}</span>
            </button>
          {%- endif -%}

          <p class="visually-hidden" data-ref="status" role="status"></p>
        </carousel-slider>
      {%- else -%}
        <div class="announcement-bar__single">{{ announcements }}</div>
      {%- endif -%}

      {%- if section_settings.show_close -%}
        <button type="button" class="announcement-bar__close" data-ref="close" aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon', icon: 'close', size: 14 %}
        </button>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% stylesheet %}
/* Head-loaded (styles.css): the bar is the first thing on every page. */
@layer components {
  .announcement-bar { text-align: center; font-size: 1.2rem; line-height: 1.5; }
  .announcement-bar__carousel { position: relative; }
  .announcement { display: flex; align-items: center; justify-content: center; gap: var(--space-2); }
  .announcement__icon { flex: 0 0 auto; }
  .announcement__text { display: block; text-decoration: none; }
}

@layer overrides {
  announcement-bar {
    display: block;
    position: relative;
  }

  announcement-bar[data-dismissed] { display: none; }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .announcement-bar__carousel,
  .announcement-bar__marquee,
  .announcement-bar__single {
    flex: 1;
    min-inline-size: 0;
  }

  .announcement-bar__single {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .announcement-bar__carousel .carousel-shell__dots,
  .announcement-bar__carousel .carousel-shell__counter,
  .announcement-bar__carousel .carousel-shell__progress { margin-block: 0; }

  .announcement-bar__close {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    inline-size: 2.4rem;
    block-size: 2.4rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 150ms ease;
  }

  .announcement-bar__close:hover { opacity: 1; }

  .announcement-bar__carousel .announcement-bar__pause {
    --carousel-pause-size: 2.4rem;
    inset-block: 50% auto;
    inset-inline-end: 0;
    translate: 0 -50%;
    background: none;
    box-shadow: none;
    color: inherit;
  }

  /* ---- mobile visibility ---- */

  @media screen and (max-width: 749px) {
    .announcement-bar--desktop-only { display: none; }
  }

  /* ---- marquee mode ---- */

  .announcement-bar__marquee { overflow: hidden; }

  .announcement-bar .marquee__track {
    --announcement-separator-gap: 3.3rem;

    display: flex;
    align-items: center;
    gap: 0;
    inline-size: max-content;
    will-change: transform;
  }

  .announcement-bar__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--announcement-separator-gap);
    padding-inline-end: var(--announcement-separator-gap);
  }

  .announcement-bar .marquee__track .announcement::after {
    content: "";
    flex: 0 0 auto;
    inline-size: 0.3rem;
    block-size: 0.3rem;
    margin-inline-start: calc(var(--announcement-separator-gap) - var(--space-2));
    border-radius: 50%;
    background-color: currentColor;
  }

  .announcement-bar .marquee__track .announcement { flex-shrink: 0; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "tag": "section",
  "class": "announcement-bar-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "announcement"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "t:sections.announcement_bar.settings.mode.label",
      "options": [
        {
          "value": "slider",
          "label": "t:sections.announcement_bar.settings.mode.options__1.label"
        },
        {
          "value": "marquee",
          "label": "t:sections.announcement_bar.settings.mode.options__2.label"
        }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "edge"
    },
    {
      "type": "header",
      "content": "t:sections.announcement_bar.headers.marquee",
      "visible_if": "{{ section.settings.mode == 'marquee' }}"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "t:sections.marquee.settings.direction.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.marquee.settings.direction.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.marquee.settings.direction.options__2.label"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.mode == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:sections.marquee.settings.speed.label",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.mode == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:sections.marquee.settings.pause_on_hover.label",
      "default": true,
      "visible_if": "{{ section.settings.mode == 'marquee' }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.motion",
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "range",
      "id": "carousel_speed",
      "label": "t:shared.carousel.speed.label",
      "min": 100,
      "max": 1500,
      "step": 50,
      "unit": "ms",
      "default": 500,
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_loop",
      "label": "t:shared.carousel.loop.label",
      "default": true,
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "t:shared.carousel.autoplay.label",
      "default": true,
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "range",
      "id": "carousel_autoplay_delay",
      "label": "t:shared.carousel.autoplay_delay.label",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_autoplay }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.navigation",
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_navigation",
      "label": "t:shared.carousel.navigation.label",
      "default": true,
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_icon",
      "label": "t:shared.carousel.nav_icon.label",
      "options": [
        {
          "value": "chevron",
          "label": "t:shared.carousel.nav_icon.options__1.label"
        },
        {
          "value": "arrow",
          "label": "t:shared.carousel.nav_icon.options__2.label"
        },
        {
          "value": "play",
          "label": "t:shared.carousel.nav_icon.options__3.label"
        },
        {
          "value": "external",
          "label": "t:shared.carousel.nav_icon.options__4.label"
        }
      ],
      "default": "chevron",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_navigation }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_style",
      "label": "t:shared.carousel.controls_style.label",
      "options": [
        {
          "value": "split",
          "label": "t:shared.carousel.controls_style.options__1.label"
        },
        {
          "value": "ghost",
          "label": "t:shared.carousel.controls_style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:shared.carousel.controls_style.options__3.label"
        }
      ],
      "default": "ghost",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_navigation }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.pagination",
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "t:shared.carousel.pagination.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.carousel.pagination.options__1.label"
        },
        {
          "value": "dots",
          "label": "t:shared.carousel.pagination.options__2.label"
        },
        {
          "value": "numbers",
          "label": "t:shared.carousel.pagination.options__3.label"
        },
        {
          "value": "progress",
          "label": "t:shared.carousel.pagination.options__4.label"
        },
        {
          "value": "controls",
          "label": "t:shared.carousel.pagination.options__5.label"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "header",
      "content": "t:sections.announcement_bar.headers.visibility"
    },
    {
      "type": "checkbox",
      "id": "enable_on_mobile",
      "label": "t:sections.announcement_bar.settings.enable_on_mobile.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "homepage_only",
      "label": "t:sections.announcement_bar.settings.homepage_only.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "t:sections.announcement_bar.settings.show_close.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.colors",
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_custom_colors",
      "label": "t:shared.carousel.custom_colors.label",
      "default": false,
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_style",
      "label": "t:shared.carousel.nav_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.carousel.nav_style.options__1.label"
        },
        {
          "value": "gradient",
          "label": "t:shared.carousel.nav_style.options__2.label"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_bg",
      "label": "t:shared.carousel.nav_bg.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_bg_hover",
      "label": "t:shared.carousel.nav_bg_hover.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "carousel_nav_gradient",
      "label": "t:shared.carousel.nav_gradient.label",
      "default": "linear-gradient(135deg, #1a1a1a 0%, #4a4a4a 100%)",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'gradient' }}"
    },
    {
      "type": "color_background",
      "id": "carousel_nav_gradient_hover",
      "label": "t:shared.carousel.nav_gradient_hover.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_icon_color",
      "label": "t:shared.carousel.nav_icon_color.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_icon_hover",
      "label": "t:shared.carousel.nav_icon_hover.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_border_color",
      "label": "t:shared.carousel.nav_border_color.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_border_hover",
      "label": "t:shared.carousel.nav_border_hover.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_dot_color",
      "label": "t:shared.carousel.dot_color.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_pagination != 'none' }}"
    },
    {
      "type": "color",
      "id": "carousel_dot_active_color",
      "label": "t:shared.carousel.dot_active_color.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_pagination != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:shared.spacing.devices.label",
      "options": [
        {
          "value": "desktop",
          "label": "t:shared.spacing.devices.options__1.label"
        },
        {
          "value": "mobile",
          "label": "t:shared.spacing.devices.options__2.label"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
