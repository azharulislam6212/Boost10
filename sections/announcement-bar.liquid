{% comment %}
  sections/announcement-bar.liquid

  Announcements as a slider or a marquee, with an optional close button.

  ## What was wrong

  **The bar could not render at all.** With "show close" enabled the section
  emits `data-dismissible`, and `base.css` hides
  `announcement-bar[data-dismissible]:not([data-ready])` until the component has
  checked storage. `assets/announcement-bar.js` was in the import map but in no
  module map, so it never loaded, `data-ready` was never written, and the whole
  bar — carousel, marquee, close button and all — stayed `display: none`. Fixed
  in `assets/global.js`.

  **A single announcement rendered nothing.** The slider branch was
  an `if count > 1` branch with an empty `else`, so one block produced an
  empty bar. One announcement is now static markup, which is also the right
  answer: a carousel with one slide is controls with nothing to control.

  **The marquee moved the wrong element.** See `assets/motion-effect.js`.

  **The slider ignored half its own schema.** `carousel_navigation` and
  `carousel_pagination` were merchant-facing settings the markup never read, and
  `carousel_speed` was declared in seconds here and milliseconds in every other
  section, so this one carousel handed Swiper a 5ms transition.

  ## Layout

  Deliberately no `layout` / `columns_*` settings. An announcement bar is one
  full-width line at every breakpoint; those controls existed in the schema,
  did nothing, and only invited a merchant to set four columns and wonder why.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
  assign count = section.blocks.size
  assign mode = section_settings.mode | default: 'slider'

  assign should_render = true
  if section_settings.homepage_only and request.page_type != 'index'
    assign should_render = false
  endif

  # A slider needs something to slide between. Below two blocks the section
  # renders the announcement on its own — no track, no arrows, no live region.
  assign is_slider = false
  if mode == 'slider' and count > 1
    assign is_slider = true
  endif

  assign show_nav = section_settings.carousel_navigation
  if show_nav == nil
    assign show_nav = true
  endif

  assign pagination = section_settings.carousel_pagination | default: 'none'
-%}

{%- if count > 0 and should_render -%}
  {%- capture announcements -%}
    {%- content_for 'blocks' -%}
  {%- endcapture -%}

  <announcement-bar
    class="announcement-bar color-scheme-container color-{{ section_settings.color_scheme }}{% unless section_settings.enable_on_mobile %} announcement-bar--desktop-only{% endunless %}"
    data-announcement-bar
    data-section-id="{{ section.id }}"
    {% if section_settings.show_close %}data-dismissible{% endif %}
    {% render 'spacing', section: section_settings %}
  >
    <div class="container announcement-bar__inner">
      {%- case mode -%}
        {%- when 'marquee' -%}
          {%- comment -%}
            `data-target` names the track explicitly. The marquee translates the
            element it is given and clips against that element's parent, so
            leaving it to default to the host meant translating the viewport
            itself — the bar slid off the page once and never returned.
          {%- endcomment -%}
          <motion-effect
            class="announcement-bar__marquee marquee__viewport"
            data-effect="marquee"
            data-target=".marquee__track"
            data-direction="{{ section_settings.marquee_direction | default: 'left' }}"
            data-speed="{{ section_settings.marquee_speed | default: 40 }}"
            data-pause-on-hover="{{ section_settings.pause_on_hover | default: true }}"
            role="marquee"
            aria-label="{{ 'sections.announcements.carousel_label' | t }}"
          >
            <div class="marquee__track" data-marquee-track>
              {{ announcements }}
            </div>
          </motion-effect>

        {%- else -%}
          {%- if is_slider -%}
            <swiper-carousel
              class="announcement-bar__carousel carousel-shell swiper"
              data-layout="carousel"
              data-layout-mobile="carousel"
              data-options="{%- render 'carousel-options',
                settings: section_settings,
                count: count,
                columns_desktop: 1,
                columns_tablet: 1,
                columns_mobile: 1,
                pagination: pagination -%}"
              style="{% render 'carousel-vars',
                settings: section_settings,
                columns_desktop: 1,
                columns_tablet: 1,
                columns_mobile: 1,
                peek_mobile: 0,
                peek_desktop: 0 %}{% render 'carousel-style', settings: section_settings %}"
            >
              <div
                class="announcement-bar__track carousel-shell__track"
                data-ref="track"
                role="group"
                aria-label="{{ 'sections.announcements.carousel_label' | t }}"
              >
                {{ announcements }}
              </div>

              {%- if show_nav -%}
                {% render 'carousel-nav',
                   settings: section_settings,
                   position: 'inside',
                   size: 28 %}
              {%- endif -%}

              {%- comment -%}
                The pagination mount point was missing entirely, so choosing
                dots, numbers or a progress bar changed nothing on the page.
                `controls` carries its own arrows, so it replaces the pair above
                rather than sitting alongside them.
              {%- endcomment -%}
              {%- if pagination == 'controls' -%}
                {% render 'carousel-controls', settings: section_settings, size: 28 %}
              {%- elsif pagination != 'none' -%}
                {% render 'carousel-pagination', style: pagination %}
              {%- endif -%}

              {%- if section_settings.carousel_autoplay -%}
                <button
                  type="button"
                  class="carousel-shell__pause"
                  data-ref="pause"
                  aria-pressed="false"
                  hidden
                >
                  <span class="carousel-shell__pause-glyph carousel-shell__pause-glyph--pause">
                    {% render 'icon', icon: 'pause', size: 12 %}
                  </span>
                  <span class="carousel-shell__pause-glyph carousel-shell__pause-glyph--play">
                    {% render 'icon', icon: 'play', size: 12 %}
                  </span>
                  <span class="visually-hidden carousel-shell__pause-glyph carousel-shell__pause-glyph--pause">
                    {{ 'accessibility.pause_slideshow' | t }}
                  </span>
                  <span class="visually-hidden carousel-shell__pause-glyph carousel-shell__pause-glyph--play">
                    {{ 'accessibility.play_slideshow' | t }}
                  </span>
                </button>
              {%- endif -%}

              <p class="visually-hidden" data-ref="status" role="status"></p>
            </swiper-carousel>
          {%- else -%}
            <div class="announcement-bar__single">
              {{ announcements }}
            </div>
          {%- endif -%}
      {%- endcase -%}

      {%- if section_settings.show_close -%}
        <button
          type="button"
          class="announcement-bar__close"
          data-ref="close"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon', icon: 'close', size: 14 %}
        </button>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "tag": "section",
  "class": "announcement-bar-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "t:sections.announcement_bar.settings.mode.label",
      "options": [
        {
          "value": "slider",
          "label": "t:sections.announcement_bar.settings.mode.options__1.label"
        },
        {
          "value": "marquee",
          "label": "t:sections.announcement_bar.settings.mode.options__2.label"
        }
      ],
      "default": "slider"
    },
    {
      "type": "header",
      "content": "t:sections.announcement_bar.headers.marquee",
      "visible_if": "{{ section.settings.mode == 'marquee' }}"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "t:sections.marquee.settings.direction.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.marquee.settings.direction.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.marquee.settings.direction.options__2.label"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.mode == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:sections.marquee.settings.speed.label",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.mode == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:sections.marquee.settings.pause_on_hover.label",
      "default": true,
      "visible_if": "{{ section.settings.mode == 'marquee' }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.motion",
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "range",
      "id": "carousel_speed",
      "label": "t:shared.carousel.speed.label",
      "info": "t:shared.carousel.speed.info",
      "min": 100,
      "max": 1500,
      "step": 50,
      "unit": "ms",
      "default": 500,
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_loop",
      "label": "t:shared.carousel.loop.label",
      "default": true,
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "t:shared.carousel.autoplay.label",
      "default": true,
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "range",
      "id": "carousel_autoplay_delay",
      "label": "t:shared.carousel.autoplay_delay.label",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_autoplay }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.navigation",
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_navigation",
      "label": "t:shared.carousel.navigation.label",
      "default": true,
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_icon",
      "label": "t:shared.carousel.nav_icon.label",
      "options": [
        {
          "value": "chevron",
          "label": "t:shared.carousel.nav_icon.options__1.label"
        },
        {
          "value": "arrow",
          "label": "t:shared.carousel.nav_icon.options__2.label"
        },
        {
          "value": "play",
          "label": "t:shared.carousel.nav_icon.options__3.label"
        },
        {
          "value": "external",
          "label": "t:shared.carousel.nav_icon.options__4.label"
        }
      ],
      "default": "chevron",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_navigation }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_style",
      "label": "t:shared.carousel.controls_style.label",
      "info": "t:shared.carousel.controls_style.info",
      "options": [
        {
          "value": "split",
          "label": "t:shared.carousel.controls_style.options__1.label"
        },
        {
          "value": "ghost",
          "label": "t:shared.carousel.controls_style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:shared.carousel.controls_style.options__3.label"
        }
      ],
      "default": "ghost",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_navigation }}"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.pagination",
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "t:shared.carousel.pagination.label",
      "info": "t:shared.carousel.pagination.info",
      "options": [
        {
          "value": "none",
          "label": "t:shared.carousel.pagination.options__1.label"
        },
        {
          "value": "dots",
          "label": "t:shared.carousel.pagination.options__2.label"
        },
        {
          "value": "numbers",
          "label": "t:shared.carousel.pagination.options__3.label"
        },
        {
          "value": "progress",
          "label": "t:shared.carousel.pagination.options__4.label"
        },
        {
          "value": "controls",
          "label": "t:shared.carousel.pagination.options__5.label"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "header",
      "content": "t:sections.announcement_bar.headers.visibility"
    },
    {
      "type": "checkbox",
      "id": "enable_on_mobile",
      "label": "t:sections.announcement_bar.settings.enable_on_mobile.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "homepage_only",
      "label": "t:sections.announcement_bar.settings.homepage_only.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "t:sections.announcement_bar.settings.show_close.label",
      "info": "t:sections.announcement_bar.settings.show_close.info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:shared.carousel.headers.colors",
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "paragraph",
      "content": "t:shared.carousel.paragraphs.colors",
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_custom_colors",
      "label": "t:shared.carousel.custom_colors.label",
      "info": "t:shared.carousel.custom_colors.info",
      "default": false,
      "visible_if": "{{ section.settings.mode == 'slider' }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_style",
      "label": "t:shared.carousel.nav_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:shared.carousel.nav_style.options__1.label"
        },
        {
          "value": "gradient",
          "label": "t:shared.carousel.nav_style.options__2.label"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_bg",
      "label": "t:shared.carousel.nav_bg.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'solid' }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_bg_hover",
      "label": "t:shared.carousel.nav_bg_hover.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "carousel_nav_gradient",
      "label": "t:shared.carousel.nav_gradient.label",
      "default": "linear-gradient(135deg, #1a1a1a 0%, #4a4a4a 100%)",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'gradient' }}"
    },
    {
      "type": "color_background",
      "id": "carousel_nav_gradient_hover",
      "label": "t:shared.carousel.nav_gradient_hover.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_nav_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_icon_color",
      "label": "t:shared.carousel.nav_icon_color.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_icon_hover",
      "label": "t:shared.carousel.nav_icon_hover.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_border_color",
      "label": "t:shared.carousel.nav_border_color.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_nav_border_hover",
      "label": "t:shared.carousel.nav_border_hover.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors }}"
    },
    {
      "type": "color",
      "id": "carousel_dot_color",
      "label": "t:shared.carousel.dot_color.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_pagination != 'none' }}"
    },
    {
      "type": "color",
      "id": "carousel_dot_active_color",
      "label": "t:shared.carousel.dot_active_color.label",
      "visible_if": "{{ section.settings.mode == 'slider' and section.settings.carousel_custom_colors and section.settings.carousel_pagination != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
