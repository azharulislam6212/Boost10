                  "settings": {
                    "text": "<ul><li>Discomfort that does not pass</li><li>Any signs of an allergic reaction</li><li>Anything that worries you</li></ul>",
                    "preset": "paragraph"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
