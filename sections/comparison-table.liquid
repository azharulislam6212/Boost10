{% comment %}
  Comparison table — the claims down the left, your product beside them, and
  alternatives the customer can swap between.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_paint = s.background_color | default: ''

  assign margin_top = s.margin_top | default: 0 | plus: 0
  assign margin_bottom = s.margin_bottom | default: 0 | plus: 0

  assign gap_x = s.gap_horizontal | default: 40 | plus: 0
  assign gap_y = s.gap_vertical | default: 40 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0
  assign gap_y_mobile = s.gap_vertical_mobile | default: gap_y | plus: 0

  assign align = s.alignment | default: 'center'
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --comparison-radius: var(--section-frame-radius, 40px 40px 0px 0px);
  --comparison-radius-mobile: var(--section-frame-radius-mobile, 24px 24px 0px 0px);
  --comparison-margin-block-start: {{ margin_top }}px;
  --comparison-margin-block-end: {{ margin_bottom }}px;
  --comparison-gap-x: {{ gap_x }}px;
  --comparison-gap-y: {{ gap_y }}px;
  --comparison-gap-x-mobile: {{ gap_x_mobile }}px;
  --comparison-gap-y-mobile: {{ gap_y_mobile }}px;
  --comparison-border-width: var(--section-frame-border-width, 1px 0px 0px 0px);
  --comparison-border-style: var(--section-frame-border-style, solid);
  --comparison-border-color: var(--section-frame-border-color, #0F2E2F);
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

{%- capture frame_style -%}
  {% content_for 'block', type: '_section-frame', id: 'section-frame' %}
{%- endcapture -%}

<div
  class="comparison-section comparison-section--{{ align }} color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}{{ frame_style | strip_newlines | strip }}"
>
  {% content_for 'block', type: '_background-media', id: 'section-background' %}

  <div class="comparison-section__inner {% render 'container', width: s.container_width %}">
    {% content_for 'blocks' %}
  </div>
</div>

