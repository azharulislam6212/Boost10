      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.presets.default.name",
      "settings": {
        "container_width": "compact"
      },
      "blocks": [
        {
          "type": "section-header",
          "static": true,
          "id": "faq-header",
          "settings": {
