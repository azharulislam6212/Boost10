{% comment %}
  A heading cluster and the theme blocks under it, on the shared section frame.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif

  assign background_paint = ''
  if has_background_media == false
    assign background_paint = s.background_color | default: ''
  endif

  assign border_line = s.border_style | default: 'none'

  assign bw_top = 0
  assign bw_right = 0
  assign bw_bottom = 0
  assign bw_left = 0
  assign border_any = 0

  if border_line != 'none'
    assign border_sides = s.border_sides | default: 'top'
    assign border_size = s.border_width | default: 1 | plus: 0

    case border_sides
      when 'all'
        assign bw_top = border_size
        assign bw_right = border_size
        assign bw_bottom = border_size
        assign bw_left = border_size
      when 'bottom'
        assign bw_bottom = border_size
      when 'top_bottom'
        assign bw_top = border_size
        assign bw_bottom = border_size
      else
        assign bw_top = border_size
    endcase
    assign border_any = border_size

    if s.border_color == blank
      assign border_paint = 'currentColor'
    else
      assign border_paint = s.border_color
    endif
  endif

  assign corner_position = s.corner_position | default: 'top'
  assign radius = s.border_radius | default: 40 | plus: 0
  assign radius_mobile = s.border_radius_mobile | default: 24 | plus: 0

  assign r_tl = 0
  assign r_tr = 0
  assign r_bl = 0
  assign r_br = 0
  assign r_tl_m = 0
  assign r_tr_m = 0
  assign r_bl_m = 0
  assign r_br_m = 0

  if corner_position != 'bottom'
    assign r_tl = radius
    assign r_tr = radius
    assign r_tl_m = radius_mobile
    assign r_tr_m = radius_mobile
  endif
  if corner_position != 'top'
    assign r_bl = radius
    assign r_br = radius
    assign r_bl_m = radius_mobile
    assign r_br_m = radius_mobile
  endif

  assign overlap = 0
  assign overlap_mobile = 0
  if s.stack_layer == 'over' or s.stack_layer == 'under'
    assign overlap = r_tl
    assign overlap_mobile = r_tl_m
  endif

  assign direction = s.direction | default: 'column'
  assign is_row = false
  if direction == 'row'
    assign is_row = true
  endif

  assign alignment_setting = s.alignment | default: 'start'

  case alignment_setting
    when 'center'
      assign alignment_axis = 'center'
    when 'end'
      assign alignment_axis = 'end'
    else
      assign alignment_axis = 'start'
  endcase

  assign inline_axis = alignment_axis
  if is_row
    case alignment_setting
      when 'space-between', 'space-around', 'space-evenly'
        assign inline_axis = alignment_setting
    endcase
  endif

  case s.position
    when 'center'
      assign block_axis = 'center'
    when 'end'
      assign block_axis = 'end'
    when 'stretch'
      assign block_axis = 'stretch'
    else
      assign block_axis = 'start'
  endcase

  assign gap_x = s.gap_horizontal | default: 24 | plus: 0
  assign gap_y = s.gap_vertical | default: 24 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0
  assign gap_y_mobile = s.gap_vertical_mobile | default: gap_y | plus: 0

  assign content_classes = 'custom-section__content custom-section__content--' | append: direction
  if is_row and s.stack_on_mobile != false
    assign content_classes = content_classes | append: ' custom-section__content--stack-mobile'
  endif

  if is_row and s.reverse
    assign content_classes = content_classes | append: ' custom-section__content--reverse'
  endif
-%}


{%- capture content_style -%}
  --custom-section-gap-x: {{ gap_x }}px;
  --custom-section-gap-y: {{ gap_y }}px;
  --custom-section-gap-x-mobile: {{ gap_x_mobile }}px;
  --custom-section-gap-y-mobile: {{ gap_y_mobile }}px;
  --custom-section-inline: {{ inline_axis }};
  --custom-section-align: {{ alignment_axis }};
  --custom-section-block: {{ block_axis }};
{%- endcapture -%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --custom-section-radius: {{ r_tl }}px {{ r_tr }}px {{ r_br }}px {{ r_bl }}px;
  --custom-section-radius-mobile: {{ r_tl_m }}px {{ r_tr_m }}px {{ r_br_m }}px {{ r_bl_m }}px;
  --section-overlap: {{ overlap }}px;
  --section-overlap-mobile: {{ overlap_mobile }}px;
  {%- if border_any > 0 -%}
    --custom-section-border-width: {{ bw_top }}px {{ bw_right }}px {{ bw_bottom }}px {{ bw_left }}px;
    --custom-section-border-style: {{ border_line }};
    --custom-section-border-color: {{ border_paint }};
  {%- endif -%}
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}


<div
  class="custom-section split-comparison-table-section color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}{% if has_background_media %} has-background-media{% endif %}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: s, placeholder: 'hero-apparel-1' %}
  {%- endif -%}

  <div class="custom-section__inner {% render 'container', width: s.container_width %}">
    <motion-effect
      class="{{ content_classes }}"
      data-easing="outQuint"
      style="{{ content_style | strip_newlines | strip }}"
      {% render 'motion-attrs', kind: 'text', section: s, children: true, duration: 1000 %}
    >
      {% content_for 'block', type: 'section-header', id: 'split-comparison-table-header' %}
      {% content_for 'blocks' %}
    </motion-effect>
  </div>
</div>

