{% comment %}
  sections/main-cart.liquid

  The line items and the summary are private blocks. A merchant who can delete
  the summary has a cart page with no checkout button.

  What they can arrange is the region below the items: a returns promise, a
  payment-security line, an app block. That is the flexibility merchants actually
  ask for, and it costs nothing to give.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
-%}

{%- comment -%}
  The form is written here rather than through `snippets/cart-items-component.liquid`.

  Everything inside it is a theme block, and handing the block output to a wrapper
  snippet meant capturing it first - which `{% content_for %}` does not allow. The
  wrapper was a single `<form>` with one caller, so it moves here whole: same
  action, same method, same class, same `data-section-id`.

  With JavaScript disabled the page still updates quantities and reaches checkout,
  because this is a real form and always was.
{%- endcomment -%}
<form action="{{ routes.cart_url }}" method="post" class="cart-page__form" data-section-id="{{ section.id }}">
  <div
    class="cart-section color-{{ section_settings.color_scheme }}"
    role="region"
    aria-label="{{ 'cart.general.title' | t | escape }}"
    {% render 'spacing', section: section_settings %}
  >
    <div class="{% render 'container', width: section.settings.container_width %}">
      <h1 class="cart-page__title">{{ 'cart.general.title' | t }}</h1>

      <div class="cart-wrapper">
        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' -%}

          {%- comment -%}
            The merchant's own blocks, rendered where they belong.

            They used to be captured at the top of the file and printed here
            behind an `!= blank` test. `{% content_for %}` cannot have its output
            captured - theme-check reports it as an error, because Shopify renders
            blocks with their editor bindings attached and buffering that output
            is not something the platform supports. Without a captured string
            there is nothing to test, so the wrapper is always present and simply
            empty when the merchant has added nothing.
          {%- endcomment -%}
          <div class="cart-page__blocks">{%- content_for 'blocks' -%}</div>
        </div>

        {%- unless cart.empty? -%}
          <div class="cart-page__summary">
            {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
          </div>
        {%- endunless -%}
      </div>

      {%- if settings.enable_cart_upsells and cart.item_count > 0 -%}
        <product-recommendations
          class="cart-page__upsell"
          data-product-id="{{ cart.items.first.product_id }}"
          data-section-id="cart-upsell"
          data-limit="{{ settings.cart_upsell_count | default: 4 }}"
        >
          <h2 class="cart-page__upsell-title" data-recommendations-heading hidden>
            {{ 'cart.upsell.title' | t }}
          </h2>
          <div data-ref="content" data-recommendations-content></div>
        </product-recommendations>
      {%- endif -%}
    </div>
  </div>
</form>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_cart.paragraph"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
