{% comment %}
  sections/main-register.liquid

  Account creation.

  Only email and password are required, because they are the only two Shopify
  needs. First and last name are optional and marked so: every required field on
  a registration form costs signups, and a customer who abandons here is a
  customer who checks out as a guest at best.

  autocomplete tokens are exact — new-password rather than current-password —
  so password managers offer to generate rather than to fill.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
-%}

<div
  class="customer customer--register color-scheme-container color-{{ section_settings.color_scheme }}"
  {% render 'spacing', section: section_settings %}
>
  <div class="container customer__inner">
    <div class="customer__panel">
      <h1 class="customer__title">
        {{ section_settings.heading | default: 'customer.register.title' | t }}
      </h1>

      {%- if section_settings.text != blank -%}
        <div class="customer__intro rte">{{ section_settings.text }}</div>
      {%- endif -%}

      <validated-form>
        {%- form 'create_customer', class: 'customer__form' -%}
          {%- if form.errors -%}
            <div class="customer__errors" role="alert" tabindex="-1">
              <ul role="list">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if section_settings.show_name_fields -%}
            <div class="customer__row">
              <div class="form-field">
                <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
                <input id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}">
              </div>

              <div class="form-field">
                <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
                <input id="RegisterLastName" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}">
              </div>
            </div>
          {%- endif -%}

          <div class="form-field">
            <label for="RegisterEmail">{{ 'customer.register.email' | t }} *</label>
            <input
              id="RegisterEmail"
              type="email"
              name="customer[email]"
              value="{{ form.email }}"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="form-field">
            <label for="RegisterPassword">{{ 'customer.register.password' | t }} *</label>
            <input
              id="RegisterPassword"
              type="password"
              name="customer[password]"
              autocomplete="new-password"
              required
              aria-describedby="RegisterPasswordHelp"
              {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
            >
            <p class="form-field__help" id="RegisterPasswordHelp">
              {{ 'customer.register.password_help' | t }}
            </p>
          </div>

          {%- if section_settings.show_marketing_optin -%}
            <div class="form-field">
              <label class="form-field__checkbox" for="RegisterMarketing">
                {%- comment -%}
                  Unticked by default. A pre-ticked consent box is not consent in
                  most of the markets this theme will be sold into.
                {%- endcomment -%}
                <input id="RegisterMarketing" type="checkbox" name="customer[accepts_marketing]" value="true">
                <span>{{ 'customer.register.accepts_marketing' | t }}</span>
              </label>
            </div>
          {%- endif -%}

          <button type="submit" class="button button--primary button--full">
            {{ 'customer.register.submit' | t }}
          </button>
        {%- endform -%}
      </validated-form>

      <p class="customer__alt">
        {{ 'customer.register.have_account' | t }}
        <a href="{{ routes.account_login_url }}">{{ 'customer.register.sign_in' | t }}</a>
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_register.name",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:shared.heading.label" },
    { "type": "richtext", "id": "text", "label": "t:shared.text.label" },
    { "type": "checkbox", "id": "show_name_fields", "label": "t:sections.main_register.settings.show_name_fields.label", "info": "t:sections.main_register.settings.show_name_fields.info", "default": true },
    { "type": "checkbox", "id": "show_marketing_optin", "label": "t:sections.main_register.settings.show_marketing_optin.label", "info": "t:sections.main_register.settings.show_marketing_optin.info", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label", "default": "scheme-1" },
    { "type": "header", "content": "t:shared.spacing.section_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "t:shared.spacing.padding_top_mobile.label", "info": "t:shared.spacing.padding_top_mobile.info", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "t:shared.spacing.padding_bottom_mobile.label", "info": "t:shared.spacing.padding_bottom_mobile.info", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ]
}
{% endschema %}
