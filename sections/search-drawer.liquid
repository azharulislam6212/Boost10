{% comment %}
  sections/search-drawer.liquid

  The search drawer. Focus goes to the field on open rather than to the close
  button — the one exception to the drawer default, because opening search has
  exactly one purpose.
{% endcomment %}

<search-drawer
  id="SearchDrawer"
  class="search-drawer drawer"
  {%- comment -%}
    The style comes from Theme settings › Search, which already had a
    modal/drawer control that nothing read. A second copy on this section would
    have been one more setting saying the same thing in a different place.
  {%- endcomment -%}
  {%- if settings.predictive_search_layout == 'drawer' -%}
    data-placement="end"
  {%- else -%}
    data-placement="top"
  {%- endif -%}
  data-overlay-type="search"
>
  <dialog class="drawer__dialog" data-ref="dialog" aria-label="{{ 'search.title' | t }}">
    <div class="drawer__panel" data-ref="panel">
      <header class="drawer__header">
        <h2 class="visually-hidden">{{ 'search.title' | t }}</h2>
        {%- liquid
          assign search_drawer_close_label = 'accessibility.close_search' | t
        -%}
        {% render 'button',
           label: search_drawer_close_label,
           id: 'SearchClose',
           class: 'close-search-drawer',
           icon: 'close',
           variant: 'primary',
           size: 'small',
           icon_only: true,
           attributes: 'data-overlay-close' %}
      </header>

      <div class="drawer__body" data-ref="body" data-lenis-prevent>
        {% render 'predictive-search', id: 'SearchDrawerInput' %}
      </div>
    </div>
  </dialog>
</search-drawer>

{% schema %}
{
  "name": "t:sections.search_drawer.name",
  "settings": []
}
{% endschema %}
