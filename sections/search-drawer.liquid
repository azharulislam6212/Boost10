{% comment %}
  The search overlay, in both of its shapes.
{% endcomment %}

{%- liquid
  assign layout = settings.predictive_search_layout | default: 'modal'
-%}

<search-drawer
  id="SearchDrawer"
  class="search-drawer drawer search-drawer--{{ layout }}"
  data-layout="{{ layout }}"

  {%- if layout == 'drawer' -%}
    data-placement="end"
  {%- else -%}
    data-placement="top"
  {%- endif -%}
  data-overlay-type="search"
>
  <dialog class="drawer__dialog" data-ref="dialog" aria-label="{{ 'search.title' | t }}">
    <div class="drawer__panel search-panel" data-ref="panel">
      {% render 'predictive-search',
         id: 'SearchDrawerInput',
         variant: 'overlay',
         layout: layout,
         close: true %}
    </div>
  </dialog>
</search-drawer>

{% schema %}
{
  "name": "t:sections.search_drawer.name",
  "settings": []
}
{% endschema %}
