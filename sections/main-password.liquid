{% comment %}
  sections/main-password.liquid

  The storefront a visitor sees while the store is password protected.

  Two things live here that nowhere else does: a signup form for people who
  arrived before launch, and the password entry itself. Shopify renders the
  password form in a modal it controls, so the theme provides the trigger and
  Shopify handles the rest.

  Deliberately spare. This page has one job — collect an email address from
  someone who found the store early — and every extra element competes with it.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
-%}

<div
  class="password-page color-scheme-container color-{{ section_settings.color_scheme }}"
  {% render 'spacing', section: section_settings %}
>
  <div class="container password-page__inner">
    {%- if section_settings.logo != blank -%}
      {% render 'image', image: section_settings.logo, alt: shop.name, ratio: 'adapt', priority: true, sizes: section_settings.logo_width, append: 'px', wrapper_class: 'password-page__logo' %}
    {%- else -%}
      <p class="password-page__shop-name">{{ shop.name }}</p>
    {%- endif -%}

    <h1 class="password-page__heading">
      {{ section_settings.heading | default: 'general.password_page.opening_soon' | t }}
    </h1>

    {%- comment -%}
      `shop.password_message` is what the merchant typed in admin, and the Theme
      Store requires it on this page. The section setting is an addition to it,
      not a replacement — overriding the admin field would hide a message the
      merchant wrote where they expected it to appear.
    {%- endcomment -%}
    {%- if shop.password_message != blank -%}
      <div class="password-page__message rte">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- if section_settings.text != blank -%}
      <div class="password-page__text rte">{{ section_settings.text }}</div>
    {%- endif -%}

    {%- if section_settings.show_newsletter -%}
      <div class="password-page__newsletter">
        {% render 'newsletter-form',
           id: 'PasswordNewsletter',
           heading: section_settings.newsletter_heading,
           text: section_settings.newsletter_text %}
      </div>
    {%- endif -%}

    {% render 'social-icons', class: 'password-page__social' %}

    {%- comment -%}
      Shopify owns the password modal. The theme supplies the trigger and the
      link Shopify listens for; re-implementing the form would mean handling an
      authentication flow the platform already handles.
    {%- endcomment -%}
    <div class="password-page__enter">
      <a href="#login_modal" class="button button--link">
        {{ 'general.password_page.login_form_heading' | t }}
      </a>
    </div>

    <p class="password-page__powered">
      {{ powered_by_link }}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "t:sections.header.settings.logo.label" },
    { "type": "range", "id": "logo_width", "label": "t:sections.header.settings.logo_width.label", "min": 60, "max": 320, "step": 10, "unit": "px", "default": 160 },
    { "type": "text", "id": "heading", "label": "t:shared.heading.label" },
    { "type": "richtext", "id": "text", "label": "t:shared.text.label" },
    { "type": "checkbox", "id": "show_newsletter", "label": "t:sections.main_password.settings.show_newsletter.label", "info": "t:sections.main_password.settings.show_newsletter.info", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "t:sections.main_password.settings.newsletter_heading.label", "default": "Be the first to know" },
    { "type": "richtext", "id": "newsletter_text", "label": "t:sections.main_password.settings.newsletter_text.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme.label", "default": "scheme-1" },
    { "type": "header", "content": "t:shared.spacing.section_header" },
    { "type": "range", "id": "padding_top", "label": "t:shared.spacing.padding_top.label", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "t:shared.spacing.padding_bottom.label", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_top_mobile", "label": "t:shared.spacing.padding_top_mobile.label", "info": "t:shared.spacing.padding_top_mobile.info", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "t:shared.spacing.padding_bottom_mobile.label", "info": "t:shared.spacing.padding_bottom_mobile.info", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 50 }
  ]
}
{% endschema %}
