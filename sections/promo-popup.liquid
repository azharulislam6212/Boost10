{% comment %}
  sections/promo-popup.liquid

  The newsletter and discount overlay.

  Everything cautious about this component is in `promo-popup.js`: it will not
  show on a first page view, will not stack on an open drawer, will not use exit
  intent on touch, and will not reappear until the merchant's chosen number of
  days has passed. Those are not settings a merchant can switch off, because each
  one exists to stop the theme doing something it should not.

  The discount is stored on the cart and appended to the checkout URL. No
  storefront API can validate a code, so the copy says it will be applied at
  checkout rather than claiming a saving the theme cannot verify.

  Rendered in the overlay group, so it exists on every page and its timing is
  measured across the visit rather than restarting on each one.
{% endcomment %}

{%- if section.settings.enable -%}
  <promo-popup
    id="PromoPopup"
    class="promo-popup modal"
    data-trigger="{{ section.settings.trigger }}"
    data-delay="{{ section.settings.delay }}"
    data-scroll-depth="{{ section.settings.scroll_depth }}"
    data-frequency="{{ section.settings.frequency }}"
    {% if section.settings.discount_code != blank %}data-discount-code="{{ section.settings.discount_code | escape }}"{% endif %}
  >
    <dialog class="modal__dialog" data-ref="dialog" aria-label="{{ section.settings.heading | default: 'general.newsletter.label' | t | escape }}">
      <div class="modal__panel promo-popup__panel" data-ref="panel">
        {%- liquid
          assign promo_popup_close_label = 'general.actions.close' | t
        -%}
        {% render 'button',
           label: promo_popup_close_label,
           id: 'PromoPopupClose',
           class: 'close-promo-popup',
           icon: 'close',
           variant: 'primary',
           size: 'small',
           icon_only: true,
           attributes: 'data-overlay-close' %}

        {%- if section.settings.image != blank -%}
          <div class="promo-popup__media">
            {% render 'image',
               image: section.settings.image,
               alt: '',
               ratio: 'portrait',
               mobile_ratio: 'landscape',
               sizes: '(min-width: 750px) 320px, 100vw' %}
          </div>
        {%- endif -%}

        <div class="promo-popup__content">
          {%- if section.settings.heading != blank -%}
            <h2 class="promo-popup__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="promo-popup__text rte">{{ section.settings.text }}</div>
          {%- endif -%}

          {%- form 'customer', id: 'PromoPopupForm', class: 'promo-popup__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            <label class="visually-hidden" for="PromoPopupEmail">
              {{ 'general.newsletter.label' | t }}
            </label>

            <div class="promo-popup__field">
              <input
                id="PromoPopupEmail"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ 'general.newsletter.placeholder' | t | escape }}"
                autocomplete="email"
                required
                {% if form.errors %}aria-invalid="true" aria-describedby="PromoPopupError"{% endif %}
              >

              <button type="submit" class="button button--primary">
                {{ section.settings.button_label | default: 'general.newsletter.submit' | t }}
              </button>
            </div>

            {%- if form.errors -%}
              <p class="promo-popup__error" id="PromoPopupError" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <p class="promo-popup__success" role="status">{{ 'general.newsletter.success' | t }}</p>
            {%- endif -%}
          {%- endform -%}

          <p class="promo-popup__message" data-ref="message" role="status"></p>

          {%- if section.settings.disclaimer != blank -%}
            <div class="promo-popup__disclaimer rte">{{ section.settings.disclaimer }}</div>
          {%- endif -%}

          <button type="button" class="promo-popup__dismiss button button--link" data-overlay-close>
            {{ section.settings.dismiss_label | default: 'general.actions.close' | t }}
          </button>
        </div>
      </div>
    </dialog>
  </promo-popup>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.promo_popup.name",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "t:sections.promo_popup.settings.enable.label", "info": "t:sections.promo_popup.settings.enable.info", "default": false },
    { "type": "text", "id": "heading", "label": "t:shared.heading.label", "default": "10% off your first order" },
    { "type": "richtext", "id": "text", "label": "t:shared.text.label" },
    { "type": "image_picker", "id": "image", "label": "t:shared.image.label" },
    { "type": "text", "id": "button_label", "label": "t:blocks.button.settings.label.label" },
    { "type": "text", "id": "dismiss_label", "label": "t:sections.promo_popup.settings.dismiss_label.label" },
    { "type": "richtext", "id": "disclaimer", "label": "t:sections.promo_popup.settings.disclaimer.label", "info": "t:sections.promo_popup.settings.disclaimer.info" },
    { "type": "header", "content": "t:sections.promo_popup.headers.discount" },
    { "type": "text", "id": "discount_code", "label": "t:sections.promo_popup.settings.discount_code.label", "info": "t:sections.promo_popup.settings.discount_code.info" },
    { "type": "header", "content": "t:sections.promo_popup.headers.timing" },
    {
      "type": "select", "id": "trigger", "label": "t:sections.promo_popup.settings.trigger.label",
      "options": [
        { "value": "delay", "label": "t:sections.promo_popup.settings.trigger.options__1.label" },
        { "value": "scroll", "label": "t:sections.promo_popup.settings.trigger.options__2.label" },
        { "value": "exit-intent", "label": "t:sections.promo_popup.settings.trigger.options__3.label" }
      ],
      "default": "delay"
    },
    { "type": "range", "id": "delay", "label": "t:sections.promo_popup.settings.delay.label", "min": 3, "max": 30, "step": 1, "unit": "s", "default": 6 },
    { "type": "range", "id": "scroll_depth", "label": "t:sections.promo_popup.settings.scroll_depth.label", "min": 20, "max": 90, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "frequency", "label": "t:sections.promo_popup.settings.frequency.label", "info": "t:sections.promo_popup.settings.frequency.info", "min": 1, "max": 30, "step": 1, "default": 7 }
  ]
}
{% endschema %}
