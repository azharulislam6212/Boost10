{% comment %}
  The page title over a picture, with an optional breadcrumb trail.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif


  assign direction = s.direction | default: 'column'
  assign is_row = false
  if direction == 'row'
    assign is_row = true
  endif

  assign alignment_setting = s.alignment | default: 'start'

  case alignment_setting
    when 'center'
      assign alignment_axis = 'center'
    when 'end'
      assign alignment_axis = 'end'
    else
      assign alignment_axis = 'start'
  endcase

  assign inline_axis = alignment_axis
  if is_row
    case alignment_setting
      when 'space-between', 'space-around', 'space-evenly'
        assign inline_axis = alignment_setting
    endcase
  endif

  case s.position
    when 'center'
      assign block_axis = 'center'
    when 'end'
      assign block_axis = 'end'
    when 'stretch'
      assign block_axis = 'stretch'
    else
      assign block_axis = 'start'
  endcase

  assign gap_x = s.gap_horizontal | default: 24 | plus: 0
  assign gap_y = s.gap_vertical | default: 24 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0
  assign gap_y_mobile = s.gap_vertical_mobile | default: gap_y | plus: 0

  assign content_classes = 'section-content section-content--' | append: direction
  if is_row and s.stack_on_mobile != false
    assign content_classes = content_classes | append: ' section-content--stack-mobile'
  endif

  if is_row and s.reverse
    assign content_classes = content_classes | append: ' section-content--reverse'
  endif
-%}

{%- liquid
  assign banner_title = s.title
  assign banner_text = s.text

  case request.page_type
    when 'collection'
      assign banner_title = banner_title | default: collection.title
      assign banner_text = banner_text | default: collection.description
    when 'blog'
      assign banner_title = banner_title | default: blog.title
    when 'article'
      assign banner_title = banner_title | default: article.title
    when 'page'
      assign banner_title = banner_title | default: page.title
    when 'search'
      assign search_heading = 'search.label' | t
      assign banner_title = banner_title | default: search_heading
    else
      assign banner_title = banner_title | default: page_title
  endcase

  assign banner_text = banner_text | strip_html | truncatewords: 40
-%}

{%- capture content_style -%}
  --section-gap-x: {{ gap_x }}px;
  --section-gap-y: {{ gap_y }}px;
  --section-gap-x-mobile: {{ gap_x_mobile }}px;
  --section-gap-y-mobile: {{ gap_y_mobile }}px;
  --section-inline: {{ inline_axis }};
  --section-align: {{ alignment_axis }};
  --section-block: {{ block_axis }};
{%- endcapture -%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  {%- render 'section-frame', settings: s, media: true -%}
{%- endcapture -%}


<div
  class="section page-banner-section color-scheme color-{{ s.color_scheme | default: 'scheme-1' }}{% if has_background_media %} has-background-media{% endif %}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: s, placeholder: 'hero-apparel-1', priority: true %}
  {%- endif -%}

  <div class="section-inner {% render 'container', width: s.container_width %}">
    <motion-effect
      class="{{ content_classes }}"
      data-easing="outQuint"
      style="{{ content_style | strip_newlines | strip }}"
      {% render 'motion-attrs', kind: 'content', section: s, children: true, duration: 1000 %}
    >
      {%- if s.show_breadcrumb -%}
        {% render 'breadcrumbs' %}
      {%- endif -%}

      <h1 class="page-banner-section__title">{{ banner_title }}</h1>

      {%- if banner_text != blank -%}
        <div class="page-banner-section__text rte">{{ banner_text }}</div>
      {%- endif -%}

      {% content_for 'blocks' %}
    </motion-effect>
  </div>
</div>

