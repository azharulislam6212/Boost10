{% comment %}
  Build-your-own-bundle: a category-filtered product list on one side, a tray of
  slots on the other, and a discount that grows as the tray fills.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_paint = s.background_color | default: ''

  assign margin_top = s.margin_top | default: 0 | plus: 0
  assign margin_bottom = s.margin_bottom | default: 0 | plus: 0

  assign gap_x = s.gap_horizontal | default: 48 | plus: 0
  assign gap_y = s.gap_vertical | default: 16 | plus: 0
  assign gap_x_mobile = s.gap_horizontal_mobile | default: gap_x | plus: 0
  assign gap_y_mobile = s.gap_vertical_mobile | default: gap_y | plus: 0

  assign slots = s.bundle_size | default: 6 | plus: 0
  assign tray_style = s.tray_style | default: 'ladder'

  assign layout_classes = 'product-bundle__layout'
-%}

{%- capture tiers -%}
  {% content_for 'block', type: '_product-bundle-tiers', id: 'product-bundle-tiers' %}
{%- endcapture -%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  --product-bundle-radius: var(--section-frame-radius, 0px 0px 0px 0px);
  --product-bundle-radius-mobile: var(--section-frame-radius-mobile, 0px 0px 0px 0px);
  --product-bundle-margin-block-start: {{ margin_top }}px;
  --product-bundle-margin-block-end: {{ margin_bottom }}px;
  --product-bundle-gap-x: {{ gap_x }}px;
  --product-bundle-gap-y: {{ gap_y }}px;
  --product-bundle-gap-x-mobile: {{ gap_x_mobile }}px;
  --product-bundle-gap-y-mobile: {{ gap_y_mobile }}px;
  --product-bundle-slot-columns: {{ s.slot_columns | default: 3 }};
  --product-bundle-accent: {{ s.accent_color | default: '#03D26F' }};

  {% content_for 'block', type: '_product-bundle-cards', id: 'product-bundle-cards' %}
  --product-bundle-border-width: var(--section-frame-border-width, 0px 0px 0px 0px);
  --product-bundle-border-style: var(--section-frame-border-style, none);
  --product-bundle-border-color: var(--section-frame-border-color, transparent);
  {%- if background_paint != '' -%}
    background: {{ background_paint }};
  {%- endif -%}
{%- endcapture -%}

{%- capture frame_style -%}
  {% content_for 'block', type: '_section-frame', id: 'section-frame' %}
{%- endcapture -%}

<div
  class="product-bundle color-scheme-container color-{{ s.color_scheme | default: 'scheme-1' }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}{{ frame_style | strip_newlines | strip }}"
>
  {% content_for 'block', type: '_background-media', id: 'section-background' %}

  <div class="product-bundle__inner {% render 'container', width: s.container_width %}">
    {% content_for 'block', type: 'section-header', id: 'product-bundle-header' %}

    <product-bundle
      class="{{ layout_classes }}"
      data-section-id="{{ section.id }}"
      data-size="{{ slots }}"
      data-tiers="{{ tiers | strip_newlines | strip }}"
      data-tray-style="{{ tray_style }}"
      data-max-per-product="{{ s.max_per_product | default: 4 }}"
      data-require-full="{{ s.require_full }}"
      data-bundle-id="bundle-{{ section.id }}"
      data-bundle-label="{{ s.tray_heading | escape }}"
      data-quick-add="{{ settings.enable_quick_add }}"
    >

      {% content_for 'block', type: '_product-bundle-slot-discounts', id: 'product-bundle-slot-discounts' %}

      {% content_for 'blocks' %}
    </product-bundle>
  </div>
</div>

