{% comment %}
  sections/cart-drawer.liquid

  A section rather than a snippet in the layout, because every cart mutation asks
  Shopify to re-render it in the same request that changed the cart. That is only
  possible for something the Section Rendering API can address.

  It renders nothing when the merchant has set the cart to open a page instead of
  a drawer, so a store using the cart page never ships the drawer markup.
{% endcomment %}

{%- if settings.cart_type == 'drawer' or settings.cart_type == 'notification' -%}
  {% render 'cart-drawer' %}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.cart_drawer.paragraph"
    }
  ]
}
{% endschema %}

