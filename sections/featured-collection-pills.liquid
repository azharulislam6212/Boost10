{% comment %}
  A heading beside a row of collection pills; each pill opens a grid of that collection's products.
{% endcomment %}

{%- liquid
  assign s = section.settings


  assign space = s.space_between
  assign space_mobile = s.space_between_mobile

  assign tabs_id = 'FeaturedCollectionPills-' | append: section.id
  assign tabs_label = 'sections.featured_collection_pills.tabs_label' | t
-%}

{%- capture content_style -%}
  --section-gap-y: {{ space }}px;
  --section-gap-y-mobile: {{ space_mobile }}px;
{%- endcapture -%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  {%- render 'section-frame', settings: s -%}
{%- endcapture -%}

{%- capture header -%}
  {% content_for 'block', type: 'section-header', id: 'featured-collection-pills-header' %}
{%- endcapture -%}

{%- capture panels -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

<div
  class="section featured-collection-pills color-scheme color-{{ s.color_scheme | default: 'scheme-1' }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  <div class="section-inner {% render 'container', width: s.container_width %}">
    <motion-effect
      class="section-content section-content--column tabs-motion featured-collection-pills__content"
      data-easing="outQuint"
      style="{{ content_style | strip_newlines | strip }}"
      {% render 'motion-attrs', kind: 'content', section: s, target: '.tabs__lead, .tabs__rail, .tabs__panels', duration: 1000, stagger: 120 %}
    >
      {%- if panels contains '<!--tab-panel-->' -%}
        {% render 'tab-group',
           id: tabs_id,
           panels: panels,
           lead: header,
           label: tabs_label,
           classes: 'featured-collection-pills__tabs',
           attributes: 'data-panel-motion="fade-up"' %}
      {%- else -%}
        <div class="tabs__lead">{{ header }}</div>
        {{ panels }}
      {%- endif -%}
    </motion-effect>
  </div>
</div>

