    {
      "type": "select",
      "id": "stack_layer",
      "label": "t:shared.spacing.stack_layer.label",
      "options": [
        {
          "value": "under",
          "label": "t:shared.spacing.stack_layer.options__1.label"
        },
        {
          "value": "default",
          "label": "t:shared.spacing.stack_layer.options__2.label"
        },
        {
          "value": "over",
          "label": "t:shared.spacing.stack_layer.options__3.label"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "t:sections.scrolling_editorial_product.name",
      "category": "t:categories.text",
      "settings": {
        "speed": 35
      },
      "blocks": [
        {
          "type": "icon-with-text",
          "settings": {
            "icon": "sparkle",
            "shape": "circle",
            "ring_style": "dashed",
            "shape_size": 48,
