{% comment %}
  A continuous ticker of short blocks.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif

  capture content_classes
    render 'section-content', settings: s, output: 'class'
  endcapture
  capture content_style
    render 'section-content', settings: s, output: 'style'
  endcapture
  capture section_style
    render 'spacing', section: s, declarations: true
    render 'section-frame', settings: s, media: true
  endcapture
-%}

<div
  class="section scrolling-editorial-product-section color-scheme color-{{ s.color_scheme | default: 'scheme-1' }}{% if has_background_media %} has-background-media{% endif %}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  {%- if has_background_media -%}
    {% render 'background-media', settings: s, placeholder: 'hero-apparel-1' %}
  {%- endif -%}

  <div class="section-inner {% render 'container', width: s.container_width %}">
    <motion-effect
      class="{{ content_classes }}"
      data-easing="outQuint"
      style="{{ content_style | strip_newlines | strip }}"
      {% render 'motion-attrs', kind: 'content', section: s, children: true, duration: 1000 %}
    >
      <motion-effect
        id="Marquee-{{ section.id }}"
        class="marquee__viewport"
        data-effect="marquee"
        data-target=".marquee__track"
        data-direction="{{ s.marquee_direction }}"
        data-speed="{{ s.speed }}"
        data-pause-on-hover="{{ s.pause_on_hover | default: true }}"
        role="marquee"
        aria-label="{{ 'sections.marquee.label' | t | escape }}"
      >
        <div class="marquee__track scrolling-editorial-product-section__track" data-marquee-track>
          {% content_for 'blocks' %}
        </div>
      </motion-effect>
      {%- assign marquee_id = 'Marquee-' | append: section.id -%}
      {% render 'marquee-toggle', controls: marquee_id %}
    </motion-effect>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.scrolling_editorial_product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@theme"
