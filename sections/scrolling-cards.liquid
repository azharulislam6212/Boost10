{% comment %}
  A photograph held in place while a heading and a zigzag of glass cards scroll
  over it. Each card — text blocks and a ringed icon — grows into place as it rises (assets/scrolling-cards.js);
  the heading's entrance is the theme's text animation.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign background_media = s.background_media | default: 'none'
  assign has_background_media = false
  if background_media != 'none'
    assign has_background_media = true
  endif


  assign card_width = s.card_width | default: 312 | plus: 0
  assign space = s.space_between | default: 48 | plus: 0
  assign space_mobile = s.space_between_mobile | default: 32 | plus: 0
  assign card_gap = s.card_gap | default: 24 | plus: 0
  # Cards close up on a phone: half the desktop gap, as before.
  assign card_gap_mobile = card_gap | divided_by: 2

  assign glass_alpha = s.glass_opacity | default: 10 | plus: 0 | divided_by: 100.0
  assign glass_blur = s.glass_blur | default: 16 | plus: 0
  assign glass_border = s.glass_border_opacity | default: 20 | plus: 0
  assign card_radius = s.card_radius | default: 24 | plus: 0

  assign animate = true
  if s.scroll_animation == false
    assign animate = false
  endif
-%}

{%- capture section_style -%}
  {%- render 'spacing', section: s, declarations: true -%}
  {%- render 'section-frame', settings: s -%}
  --sc-card-width: {{ card_width }}px;
  --sc-space: {{ space }}px;
  --sc-space-mobile: {{ space_mobile }}px;
  --sc-card-gap: {{ card_gap }}px;
  --sc-card-gap-mobile: {{ card_gap_mobile }}px;
  --sc-glass: {{ glass_alpha }};
  --sc-blur: {{ glass_blur }}px;
  --sc-border: {{ glass_border }}%;
  --sc-card-radius: {{ card_radius }}px;
{%- endcapture -%}

<div
  class="section scrolling-cards color-scheme color-{{ s.color_scheme | default: 'scheme-4' }}"
  data-section-spacing
  {%- if s.stack_layer != blank and s.stack_layer != 'default' %} data-section-layer="{{ s.stack_layer }}"{% endif %}
  data-section-id="{{ section.id }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  <scrolling-cards class="scrolling-cards__stage" data-animate="{{ animate }}">
    {%- if has_background_media -%}
      <div class="scrolling-cards__backdrop">
        {% render 'background-media', settings: s, placeholder: 'hero-apparel-1' %}
      </div>
    {%- endif -%}

    <div class="scrolling-cards__inner {% render 'container', width: s.container_width %}">
      <motion-effect
        class="scrolling-cards__heading"
        data-easing="outQuint"
        {% render 'motion-attrs', kind: 'content', section: s, children: true %}
      >
        {% content_for 'block', type: 'section-header', id: 'scrolling-cards-header' %}
      </motion-effect>

      <motion-effect
        class="scrolling-cards__cards"
        {% render 'motion-attrs', kind: 'content', section: s, target: '.scrolling-card', stagger: 90 %}
      >
        {% content_for 'blocks' %}
      </motion-effect>
    </div>
  </scrolling-cards>
</div>

