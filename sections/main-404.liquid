{% comment %}
  sections/main-404.liquid

  The not-found page.

  A 404 is the one page nobody chose to visit, so its job is to get the customer
  somewhere useful in one click. It offers search first, then a route back — not
  an apology and a dead end.

  The search field is the same predictive-search component the header uses, so
  the customer gets suggestions as they type rather than being sent to a results
  page to try again.

  Merchants can add blocks — a featured collection, a set of category links —
  because the best 404 on a shoe store and the best 404 on a bookshop are not the
  same page.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
-%}

<div
  class="main-404 color-scheme-container color-{{ section_settings.color_scheme }}"
  {% render 'spacing', section: section_settings %}
>
  <div class="{% render 'container', width: section.settings.container_width, classes: 'main-404__inner' %}">
    <p class="main-404__code" aria-hidden="true">404</p>

    <h1 class="main-404__title">
      {{ section_settings.heading | default: 'templates.404.title' | t }}
    </h1>

    <div class="main-404__text rte">
      {%- if section_settings.text != blank -%}
        {{ section_settings.text }}
      {%- else -%}
        <p>{{ 'templates.404.subtext' | t }}</p>
      {%- endif -%}
    </div>

    {%- if section_settings.show_search -%}
      <div class="main-404__search">
        {% render 'predictive-search', id: 'NotFoundSearch' %}
      </div>
    {%- endif -%}

    <div class="main-404__actions">
      {% render 'button', label: 'general.404.continue_shopping', href: routes.all_products_collection_url, variant: 'primary' %}

      {% render 'button', label: 'general.breadcrumbs.home', href: routes.root_url, variant: 'link' %}
    </div>

    <div class="main-404__blocks">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.heading.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:shared.text.label"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.main_404.settings.show_search.label",
      "info": "t:sections.main_404.settings.show_search.info",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    }
  ]
}
{% endschema %}
