{% comment %}
  sections/main-collection.liquid

  `<results-list>` wraps the filters as well as the grid, not just the grid. When
  a filter changes, the whole element is morphed in one pass — counts next to each
  value, the active filter pills, the grid and the pagination all update together
  and cannot disagree with each other.

  The skip link inside it matters more than it looks: this region is replaced by
  AJAX, and without a way back to the main content a keyboard user who has tabbed
  into a long filter list has a long way out.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
  assign per_page = section_settings.products_per_page | default: 24
  assign desktop = section_settings.columns_desktop | default: 4
  assign card_sizes = '(min-width: 990px) ' | append: 100 | divided_by: desktop | append: 'vw, (min-width: 750px) 33vw, 50vw'
-%}

<results-list
  class="collection-results color-{{ section_settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-pagination="{{ section_settings.pagination_type }}"
  data-item-selector="[data-product-id]"
  data-page="{{ current_page | default: 1 }}"
  data-total="{{ collection.products_count }}"
  role="region"
  aria-label="{{ collection.title | default: 'products.facets.title' | t | escape }}"
  {% render 'spacing', section: section_settings %}
>
  <a class="skip-to-content-link visually-hidden" href="#MainContent">
    {{ 'accessibility.skip_to_content' | t }}
  </a>

  <div class="{% render 'container', width: section.settings.container_width %}">
    {% paginate collection.products by per_page %}
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count,
        paginate: paginate
      %}

      {%- comment -%}
        The grid markup, inline rather than through `snippets/product-grid.liquid`.

        The loop below renders each card with `{% content_for 'block' %}`, and the
        output of `content_for` cannot be captured - theme-check reports it as an
        error, because Shopify renders blocks with their theme-editor bindings
        attached and buffering that output into a variable is not something the
        platform supports. Passing the cards to a wrapper snippet meant capturing
        them first, so the wrapper had to come here instead.

        This is the same markup `product-grid.liquid` emits, with the same classes,
        the same refs and the same order. Nothing about how the grid looks or how
        `<results-list>` finds it has changed.
      {%- endcomment -%}
      {%- liquid
        assign grid_mode = section.settings.pagination_type | default: settings.pagination_type | default: 'paginate'
        assign grid_total = collection.products_count
        assign grid_id = 'ProductGrid-' | append: section.id
        assign grid_desktop = section.settings.columns_desktop | default: 4
        assign grid_tablet = section.settings.columns_tablet | default: 3
        assign grid_mobile = section.settings.columns_mobile | default: 2
      -%}

      <div class="product-grid-wrapper">
        <h2 class="visually-hidden">{{ 'products.facets.title' | t }}</h2>

        {%- if paginate.previous and grid_mode != 'paginate' -%}
          <button
            type="button"
            class="button button--secondary results-list__load-previous"
            data-ref="loadPrevious"
            data-prev-url="{{ paginate.previous.url }}"
            hidden
          >
            {{ 'general.pagination.load_previous' | t }}
          </button>
        {%- endif -%}

        <ul
          class="product-grid"
          id="{{ grid_id }}"
          data-ref="grid"
          role="list"
          style="--columns-desktop: {{ grid_desktop }}; --columns-tablet: {{ grid_tablet }}; --columns-mobile: {{ grid_mobile }};"
        >
        {%- for product in collection.products -%}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
          >
            {% content_for 'block',
              type: '_product-card',
              id: 'product-card',
              product: product,
              index: forloop.index0,
              priority: forloop.first,
              sizes: card_sizes
            %}
          </li>
        {%- endfor -%}
      
        </ul>

        <div class="product-grid__empty" data-ref="empty" {% if grid_total > 0 %}hidden{% endif %}>
          <p class="product-grid__empty-title">{{ 'products.facets.no_results' | t }}</p>
          <a class="button button--link" href="{{ collection.url }}">{{ 'products.facets.clear_all' | t }}</a>
        </div>

        <div class="product-grid__pagination">
          {% render 'pagination', paginate: paginate, type: grid_mode %}
        </div>

        <p class="visually-hidden" data-ref="status" role="status"></p>
      </div>

    {% endpaginate %}

    {%- comment -%}
      Merchant blocks sit below the grid, outside the paginated region, so
      appending a page never re-renders them.
    {%- endcomment -%}
    <div class="collection-results__blocks">
      {% content_for 'blocks' %}
    </div>
  </div>
</results-list>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_collection.paragraph"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.main_collection.settings.products_per_page.label",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:shared.columns.desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:shared.columns.tablet.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.columns.mobile.label",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "t:shared.pagination.label",
      "info": "t:shared.pagination.info",
      "options": [
        {
          "value": "paginate",
          "label": "t:shared.pagination.options__1.label"
        },
        {
          "value": "load-more",
          "label": "t:shared.pagination.options__2.label"
        },
        {
          "value": "infinite",
          "label": "t:shared.pagination.options__3.label"
        }
      ],
      "default": "paginate"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.main_collection.settings.enable_sorting.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main_collection.settings.enable_filtering.label",
      "info": "t:sections.main_collection.settings.enable_filtering.info",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
