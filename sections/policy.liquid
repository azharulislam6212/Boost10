{% comment %}
  sections/policy.liquid

  Shopify's legal policies: refund, privacy, terms, shipping, contact
  information.

  The content is generated by Shopify and cannot be edited here, so the only
  thing this section controls is readability — and that is worth controlling.
  Legal text is the writing customers are least willing to read and most likely
  to need, so the measure is capped near 68 characters, the line height is
  raised, and headings inside the content get room above them.

  No blocks. A policy page with a promotional banner on it is a policy page a
  regulator reads unfavourably, and there is no legitimate merchandising to do
  on a refund policy.
{% endcomment %}

{%- liquid
  assign section_settings = section.settings
-%}

<div
  class="policy color-{{ section_settings.color_scheme }}"
  {% render 'spacing', section: section_settings %}
>
  <div class="{% render 'container', width: section.settings.container_width %}">
    {%- if section_settings.show_breadcrumbs -%}
      {% render 'breadcrumbs' %}
    {%- endif -%}

    <div class="policy__inner">
      <h1 class="policy__title">{{ policy.title }}</h1>

      {%- comment -%}
        `policy.body` is Shopify's own HTML. It is not run through any filter:
        stripping or reformatting a legal document is not the theme's decision to
        make.
      {%- endcomment -%}
      <div class="policy__content rte">
        {{ policy.body }}
      </div>

      {%- if section_settings.show_back_link -%}
        <a class="policy__back button button--link" href="{{ routes.root_url }}">
          {{ 'general.breadcrumbs.home' | t }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "t:sections.policy.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:shared.container.width.label",
      "info": "t:shared.container.width.info",
      "options": [
        {
          "value": "edge",
          "label": "t:shared.container.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:shared.container.width.options__2.label"
        },
        {
          "value": "standard",
          "label": "t:shared.container.width.options__3.label"
        },
        {
          "value": "compact",
          "label": "t:shared.container.width.options__4.label"
        },
        {
          "value": "custom",
          "label": "t:shared.container.width.options__5.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "paragraph",
      "content": "t:sections.policy.paragraph"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.collection_banner.settings.show_breadcrumbs.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_back_link",
      "label": "t:sections.policy.settings.show_back_link.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:shared.spacing.section_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.spacing.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.spacing.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:shared.spacing.padding_top_mobile.label",
      "info": "t:shared.spacing.padding_top_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:shared.spacing.padding_bottom_mobile.label",
      "info": "t:shared.spacing.padding_bottom_mobile.info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
