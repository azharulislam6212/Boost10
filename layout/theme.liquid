    {%- comment -%}
      ---------- Conditional modulepreload ----------
      Sections import what they need; these hints only parallelise the fetch
      so module resolution does not wait for section HTML to parse.
    {%- endcomment -%}
    <link rel="modulepreload" href="{{ 'global.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'component.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'utilities.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'events.js' | asset_url }}">

    {%- if use_smooth_scroll -%}
      <link rel="modulepreload" href="{{ 'scrollbar.js' | asset_url }}">
      <link rel="modulepreload" href="{{ 'lenis.js' | asset_url }}">
    {%- endif -%}

    {%- if use_cart_drawer -%}
      <link rel="modulepreload" href="{{ 'cart-drawer.js' | asset_url }}">
    {%- endif -%}

    {%- case template.name -%}
      {%- when 'product' -%}
        <link rel="modulepreload" href="{{ 'product-form.js' | asset_url }}">
        <link rel="modulepreload" href="{{ 'variant-picker.js' | asset_url }}">
        <link rel="modulepreload" href="{{ 'media-gallery.js' | asset_url }}">
        <link rel="modulepreload" href="{{ 'media-coordinator.js' | asset_url }}">
      {%- when 'collection', 'search' -%}
        <link rel="modulepreload" href="{{ 'facets.js' | asset_url }}">
      {%- when 'cart' -%}
        <link rel="modulepreload" href="{{ 'cart-items.js' | asset_url }}">
        <link rel="modulepreload" href="{{ 'quantity-selector.js' | asset_url }}">
      {%- when 'customers/account', 'customers/order' -%}
        <link rel="modulepreload" href="{{ 'customer-orders.js' | asset_url }}">
      {%- when 'customers/addresses' -%}
        <link rel="modulepreload" href="{{ 'customer-addresses.js' | asset_url }}">
    {%- endcase -%}

    <script type="module" src="{{ 'global.js' | asset_url }}"></script>

    {{ content_for_header }}

    {%- comment -%}
      ---------- Merchant custom CSS ----------
      Deliberately UNLAYERED. Unlayered styles outrank every layered style, so
      merchant overrides always win without needing !important.
    {%- endcomment -%}
    {%- if settings.custom_css != blank -%}
      {% style %}
        {{ settings.custom_css }}
      {% endstyle %}
    {%- endif -%}
  </head>

  <body class="{{ body_classes }}">
    {% render 'skip-to-content' %}

    {%- if use_smooth_scroll -%}
      <smooth-scrollbar
        data-lerp="{{ settings.smooth_scroll_lerp | default: 8 | divided_by: 100.0 }}"
        data-wheel-multiplier="{{ settings.smooth_scroll_wheel_multiplier | default: 10 | divided_by: 10.0 }}"
        data-touch-multiplier="{{ settings.smooth_scroll_touch_multiplier | default: 15 | divided_by: 10.0 }}"
      ></smooth-scrollbar>
    {%- endif -%}

    {%- if use_page_transitions -%}
      <page-transition
        data-mode="{{ settings.page_transition_style | default: 'fade' }}"
        aria-hidden="true"
      ></page-transition>
    {%- endif -%}

    {% sections 'header-group' %}

    <main
      id="MainContent"
      class="layout__main"
      role="main"
      tabindex="-1"
      data-page-type="{{ request.page_type }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% sections 'overlay-group' %}

    {% render 'scroll-to-top' %}

    {% render 'live-region' %}

    {%- comment -%}
      Country / province data required by <customer-address-form>. Loaded only
      where an address form can exist, and only as data — no behaviour.
    {%- endcomment -%}
    {%- if request.page_type == 'customers/addresses' -%}
      <script src="{{ 'country_option_tags.liquid' | shopify_asset_url }}" defer></script>
    {%- endif -%}
  </body>
</html>
