<!doctype html>

{%- liquid
  # --- Text direction -------------------------------------------------------
  assign rtl_locales = 'ar,arc,ckb,dv,fa,ha,he,khw,ks,ku,ps,sd,ur,uz-AF,yi' | split: ','
  assign locale_root = request.locale.iso_code | split: '-' | first
  assign text_direction = 'ltr'
  if rtl_locales contains request.locale.iso_code or rtl_locales contains locale_root
    assign text_direction = 'rtl'
  endif

  # --- Feature flags used by the shell --------------------------------------
  assign use_smooth_scroll = settings.enable_smooth_scroll | default: false
  assign use_page_transitions = settings.enable_page_transitions | default: false
  assign use_cart_drawer = false
  if settings.cart_type == 'drawer'
    assign use_cart_drawer = true
  endif

  # --- Body classes ---------------------------------------------------------
  assign body_classes = 'template-' | append: template.name
  if template.suffix != blank
    assign body_classes = body_classes | append: ' template-suffix-' | append: template.suffix
  endif
  if settings.animations_reveal_on_scroll
    assign body_classes = body_classes | append: ' scroll-reveal-enabled'
  endif
-%}

<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  dir="{{ text_direction }}"
  data-template="{{ template.name }}"
  {% if template.suffix != blank %}data-template-suffix="{{ template.suffix }}"{% endif %}
  data-direction="{{ text_direction }}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="format-detection" content="telephone=no">

    {%- if settings.browser_theme_color != blank -%}
      <meta name="theme-color" content="{{ settings.browser_theme_color }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- comment -%} ---------- Favicons ---------- {%- endcomment -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- comment -%} ---------- Title & description ---------- {%- endcomment -%}
    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- comment -%} ---------- Pagination rel links ---------- {%- endcomment -%}
    {%- if paginate.previous -%}
      <link rel="prev" href="{{ paginate.previous.url }}">
    {%- endif -%}
    {%- if paginate.next -%}
      <link rel="next" href="{{ paginate.next.url }}">
    {%- endif -%}


    {%- if shop.published_locales.size > 1 -%}
      {%- liquid
        assign path_without_locale = request.path
        unless request.locale.root_url == '/'
          assign path_without_locale = request.path | remove_first: request.locale.root_url
        endunless
      -%}
      {%- for locale in shop.published_locales -%}
        {%- liquid
          if locale.root_url == '/'
            assign localized_path = path_without_locale
          else
            assign localized_path = locale.root_url | append: path_without_locale
          endif
        -%}
        <link rel="alternate" hreflang="{{ locale.iso_code }}" href="{{ request.origin }}{{ localized_path }}">
      {%- endfor -%}
      <link rel="alternate" hreflang="x-default" href="{{ request.origin }}{{ path_without_locale }}">
    {%- endif -%}

    {%- comment -%} ---------- Social metadata and structured data ---------- {%- endcomment -%}
    {% render 'social-meta-tags' %}
    {% render 'structured-data' %}
    

    {%- comment -%} ---------- Fonts ---------- {%- endcomment -%}
    {%- liquid
      assign body_font = settings.type_body_font
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
      assign heading_font = settings.type_header_font
      assign heading_font_bold = heading_font | font_modify: 'weight', 'bold'
    -%}

    <link rel="preload" as="font" href="{{ body_font | font_url }}" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="{{ heading_font | font_url }}" type="font/woff2" crossorigin>

    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ heading_font_bold | font_face: font_display: 'swap' }}
    {% endstyle %}

 
    {% render 'color-schemes' %}
    {% render 'css-variables' %}

 
    {% style %}
      @layer reset, tokens, base, layout, components, utilities;

      @layer tokens {
        :root {
          --container-max: {{ settings.page_width | default: 1440 }}px;
          --container-gutter: {{ settings.container_gutter | default: 20 }}px;
          --container-gutter-desktop: {{ settings.container_gutter_desktop | default: 40 }}px;

          --radius-card: {{ settings.card_radius | default: 8 }}px;
          --radius-media: {{ settings.media_radius | default: 0 }}px;
          --radius-badge: {{ settings.badge_radius | default: 40 }}px;
          --radius-drawer: {{ settings.drawer_radius | default: 0 }}px;

          {%- comment -%}
            ---------- Controls: buttons and input fields ----------

            Theme settings › Buttons and › Input fields are the source of truth
            for every control in the theme, and everything below is derived from
            them so a merchant changes one number and the whole store follows.

            Two sections could each claim these. Borders and shadows also has a
            radius and a thickness for buttons and inputs, from an earlier pass.
            The dedicated sections win, and the older values are the fallback, so
            a store that only ever set the old ones keeps its look.

            Small and large are computed from the base height rather than being
            fixed pixel values. A merchant who raises the button height to 64px
            expects the small variant to grow with it; a hardcoded 36px small
            button next to a 64px medium one looks like a mistake, not a scale.
          {%- endcomment -%}
          --buttons-border-thickness: {{ settings.buttons_corner_thickness | default: settings.buttons_border_thickness | default: 1 }}px;
          --inputs-border-thickness: {{ settings.input_fields_corner_thickness | default: settings.inputs_border_thickness | default: 1 }}px;
          --card-border-thickness: {{ settings.card_border_thickness | default: 0 }}px;

          --radius-button: {{ settings.buttons_corner_radius | default: settings.buttons_radius | default: 4 }}px;
          --radius-input: {{ settings.input_fields_corner_radius | default: settings.inputs_radius | default: 4 }}px;

          --height-button: {{ settings.buttons_height | default: 44 }}px;
          --height-button-small: calc(var(--height-button) * 0.78);
          --height-button-large: calc(var(--height-button) * 1.22);

          --height-input: {{ settings.input_fields_height | default: 46 }}px;
          --height-input-small: calc(var(--height-input) * 0.78);
          --height-input-large: calc(var(--height-input) * 1.22);

          --duration-fast: 150ms;
          --duration-base: 250ms;
          --duration-slow: 450ms;
          --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
          --ease-in-out-quart: cubic-bezier(0.76, 0, 0.24, 1);

          --z-base: 0;
          --z-sticky: 100;
          --z-header: 200;
          --z-backdrop: 300;
          --z-drawer: 400;
          --z-modal: 500;
          --z-zoom: 600;
          --z-toast: 700;
          --z-skip-link: 900;

          --header-height: 0px;
          --announcement-height: 0px;
          --scrollbar-width: 0px;
          --viewport-height: 100vh;
        }

        @supports (height: 100dvh) {
          :root { --viewport-height: 100dvh; }
        }
      }

      @layer reset {
        *,
        *::before,
        *::after { box-sizing: border-box; }

        html {
          font-size: 62.5%;
          -webkit-text-size-adjust: 100%;
          text-size-adjust: 100%;
          scroll-behavior: smooth;
        }

        body,
        h1, h2, h3, h4, h5, h6,
        p, figure, blockquote, dl, dd { margin: 0; }

        ul[role='list'],
        ol[role='list'] { list-style: none; margin: 0; padding: 0; }

        img, picture, video, canvas, svg {
          display: block;
          max-width: 100%;
        }

        img { height: auto; }

        input, button, textarea, select {
          font: inherit;
          color: inherit;
        }

        button { background: none; border: 0; cursor: pointer; }

        a { color: inherit; }

        summary { cursor: pointer; list-style: none; }
        summary::-webkit-details-marker { display: none; }

        :focus-visible {
          outline: 2px solid var(--color-link, currentColor);
          outline-offset: 3px;
          border-radius: 2px;
        }

        :focus:not(:focus-visible) { outline: none; }

        /* Lenis structural requirements. Without these the library cannot
           take over the document scroller. */
        html.lenis,
        html.lenis body { height: auto; }

        .lenis.lenis-smooth { scroll-behavior: auto !important; }
        .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
        .lenis.lenis-stopped { overflow: hidden; }
        .lenis.lenis-smooth iframe { pointer-events: none; }

        @media (prefers-reduced-motion: reduce) {
          html { scroll-behavior: auto; }
          *,
          *::before,
          *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
          }
        }
      }

      @layer base {
        body {
          margin: 0;
          min-height: var(--viewport-height);
          display: flex;
          flex-direction: column;
          font-family: var(--font-body-family);
          font-style: var(--font-body-style);
          font-weight: var(--font-body-weight);
          font-size: var(--font-size-base);
          line-height: 1.6;
          color: var(--color-text);
          background-color: var(--color-background);
          background-image: var(--gradient-background);
          -webkit-font-smoothing: antialiased;
          overflow-wrap: break-word;
        }

        /* Custom elements are inline by default, which would collapse any
           layout wrapper built on one. */
        motion-effect,
        smooth-scrollbar,
        page-transition { display: block; }

        smooth-scrollbar[data-disabled] { display: none; }
        motion-effect[data-effect='marquee'] { overflow: hidden; }

        /* Accordion groups that only collapse below a breakpoint. Above it the
           summary is decoration: no marker, no pointer, no hover affordance. */
        accordion-element[data-static] summary,
        summary[data-static] {
          cursor: default;
          pointer-events: none;
          list-style: none;
        }

        accordion-element[data-static] summary::-webkit-details-marker,
        summary[data-static]::-webkit-details-marker { display: none; }

        accordion-element[data-static] .footer__summary-icon { display: none; }

        /* Responsive image boxes. The ratio is reserved before the image loads,
           and art-directed images can change shape at the breakpoint without the
           box jumping when the source swaps. */
        responsive-image {
          display: block;
          position: relative;
          aspect-ratio: var(--aspect-ratio, 1);
          overflow: hidden;
        }

        responsive-image__picture,
        responsive-image .responsive-image__picture { display: contents; }

        responsive-image img {
          inline-size: 100%;
          block-size: 100%;
          object-fit: cover;
          opacity: 0;
          transition: opacity var(--duration-base) var(--ease-out-expo);
        }

        responsive-image[data-loaded] img,
        html.no-js responsive-image img { opacity: 1; }

        @media screen and (max-width: 767px) {
          responsive-image { aspect-ratio: var(--aspect-ratio-mobile, var(--aspect-ratio, 1)); }
        }

        h1, h2, h3, h4, h5, h6 {
          font-family: var(--font-heading-family);
          font-style: var(--font-heading-style);
          font-weight: var(--font-heading-weight);
          color: var(--color-heading);
          line-height: 1.2;
          text-wrap: balance;
        }
      }

      @layer layout {
        .layout__main {
          flex: 1 0 auto;
          display: block;
        }

        .container {
          width: 100%;
          max-width: var(--container-max);
          margin-inline: auto;
          padding-inline: var(--container-gutter);
        }

        @media screen and (min-width: 990px) {
          .container { padding-inline: var(--container-gutter-desktop); }
        }

        /* Section and block spacing.
           Values arrive as custom properties from snippets/spacing.liquid. The
           media query reads a different property rather than a different rule,
           so one inline style drives both breakpoints. */
        [data-section-spacing] {
          padding-block-start: var(--section-padding-block-start, 0px);
          padding-block-end: var(--section-padding-block-end, 0px);
        }

        [data-block-spacing] {
          padding-block-start: var(--block-padding-block-start, 0px);
          padding-inline-end: var(--block-padding-inline-end, 0px);
          padding-block-end: var(--block-padding-block-end, 0px);
          padding-inline-start: var(--block-padding-inline-start, 0px);
        }

        @media screen and (max-width: 749px) {
          [data-section-spacing] {
            padding-block-start: var(--section-padding-block-start-mobile, var(--section-padding-block-start, 0px));
            padding-block-end: var(--section-padding-block-end-mobile, var(--section-padding-block-end, 0px));
          }

          [data-block-spacing] {
            padding-block-start: calc(var(--block-padding-block-start, 0px) * var(--block-padding-scale-mobile, 0.75));
            padding-inline-end: calc(var(--block-padding-inline-end, 0px) * var(--block-padding-scale-mobile, 0.75));
            padding-block-end: calc(var(--block-padding-block-end, 0px) * var(--block-padding-scale-mobile, 0.75));
            padding-inline-start: calc(var(--block-padding-inline-start, 0px) * var(--block-padding-scale-mobile, 0.75));
          }
        }
      }

      @layer components {
        .skip-to-content-link {
          position: absolute;
          inset-block-start: 0;
          inset-inline-start: 0;
          z-index: var(--z-skip-link);
          display: inline-block;
          padding: 1.2rem 2rem;
          background-color: var(--color-primary-button-background);
          color: var(--color-primary-button-text);
          text-decoration: none;
          transform: translateY(-101%);
        }

        .skip-to-content-link:focus {
          transform: translateY(0);
        }

        .media-loader {
          position: absolute;
          inset: 0;
          background-color: rgba(var(--color-text-rgb, 0 0 0) / 0.04);
          pointer-events: none;
          opacity: 1;
          transition: opacity var(--duration-base) var(--ease-out-expo);
        }
      }

      @layer utilities {
        .visually-hidden {
          position: absolute !important;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0 0 0 0);
          clip-path: inset(50%);
          white-space: nowrap;
          border: 0;
        }

        .visually-hidden:focus-within,
        .visually-hidden.is-revealed {
          position: static !important;
          width: auto;
          height: auto;
          margin: 0;
          overflow: visible;
          clip: auto;
          clip-path: none;
          white-space: normal;
        }

        html.no-js .no-js-hidden { display: none !important; }
        html:not(.no-js) .js-hidden { display: none !important; }
        [hidden] { display: none !important; }
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}


    {%- comment -%}
      ---------- ES module importmap ----------
      Exactly one importmap per document, declared before any module script.
      Mapping is resolution only — nothing is fetched until it is imported.
    {%- endcomment -%}
    <script type="importmap">
      {
        "imports": {
          "@theme/component":                "{{ 'component.js' | asset_url }}",
          "@theme/shadow-component":         "{{ 'shadow-component.js' | asset_url }}",
          "@theme/utilities":                "{{ 'utilities.js' | asset_url }}",
          "@theme/events":                   "{{ 'events.js' | asset_url }}",
          "@theme/morph":                    "{{ 'morph.js' | asset_url }}",
          "@theme/section-renderer":         "{{ 'section-renderer.js' | asset_url }}",

       "@theme/facet-dropdown": "{{ 'facet-dropdown.js' | asset_url }}",
        "@theme/carousel-pagination": "{{ 'carousel-pagination.js' | asset_url }}",
        "@theme/collection-tabs": "{{ 'collection-tabs.js' | asset_url }}",
        "@theme/announcement-bar": "{{ 'announcement-bar.js' | asset_url }}",

          "@theme/dialog":                   "{{ 'dialog.js' | asset_url }}",
          "@theme/toast":                    "{{ 'toast.js' | asset_url }}",
          "@theme/modules":                  "{{ 'modules.js' | asset_url }}",
          "@theme/form-validation":          "{{ 'form-validation.js' | asset_url }}",
          "@theme/motion-engine":            "{{ 'motion-engine.js' | asset_url }}",
          "@theme/motion-effect":            "{{ 'motion-effect.js' | asset_url }}",
          "@theme/scrollbar":                "{{ 'scrollbar.js' | asset_url }}",
          "@theme/lenis":                    "{{ 'lenis.js' | asset_url }}",
          "@theme/page-transition":          "{{ 'page-transition.js' | asset_url }}",

          "@theme/search":                   "{{ 'search.js' | asset_url }}",
          "@theme/results-list":             "{{ 'results-list.js' | asset_url }}",
          "@theme/localization":             "{{ 'localization.js' | asset_url }}",
          "@theme/facets":                   "{{ 'facets.js' | asset_url }}",

          "@theme/cart-drawer":              "{{ 'cart-drawer.js' | asset_url }}",
          "@theme/cart-items":               "{{ 'cart-items.js' | asset_url }}",
          "@theme/promo-code":            "{{ 'promo-code.js' | asset_url }}",
          "@theme/cart-selling-plans":       "{{ 'cart-selling-plans.js' | asset_url }}",
          "@theme/cart-shipping":            "{{ 'cart-shipping.js' | asset_url }}",
          "@theme/free-shipping-bar":        "{{ 'free-shipping-bar.js' | asset_url }}",

          "@theme/product-form":             "{{ 'product-form.js' | asset_url }}",
          "@theme/sticky-add-to-cart":       "{{ 'sticky-add-to-cart.js' | asset_url }}",
        "@theme/bundle-builder": "{{ 'bundle-builder.js' | asset_url }}",
          "@theme/variant-picker":           "{{ 'variant-picker.js' | asset_url }}",
          "@theme/variant-swatch":           "{{ 'variant-swatch.js' | asset_url }}",
        "@theme/back-in-stock": "{{ 'back-in-stock.js' | asset_url }}",
          "@theme/product-selling-plans":    "{{ 'product-selling-plans.js' | asset_url }}",
          "@theme/quantity-selector":        "{{ 'quantity-selector.js' | asset_url }}",
          "@theme/product-recommendations":  "{{ 'product-recommendations.js' | asset_url }}",
          "@theme/gift-card-recipient-form": "{{ 'gift-card-recipient-form.js' | asset_url }}",
          "@theme/carousel":                 "{{ 'carousel.js' | asset_url }}",
          "@theme/media-gallery":            "{{ 'media-gallery.js' | asset_url }}",
          "@theme/media-coordinator":        "{{ 'media-coordinator.js' | asset_url }}",
          "@theme/media-zoom":               "{{ 'media-zoom.js' | asset_url }}",

          "@theme/customer-addresses":       "{{ 'customer-addresses.js' | asset_url }}",
          "@theme/customer-orders":          "{{ 'customer-orders.js' | asset_url }}",

          "@theme/compare":                  "{{ 'compare.js' | asset_url }}",
          "@theme/recently-viewed":          "{{ 'recently-viewed.js' | asset_url }}",
          "@theme/promo-popup":              "{{ 'promo-popup.js' | asset_url }}",
          "@theme/store-locator":            "{{ 'store-locator.js' | asset_url }}"
        }
      }
    </script>

    {%- comment -%}
      ---------- Runtime contract ----------
      The single permitted global. Mutable by design: sections extend
      Theme.settings and Theme.strings at render time, and cart modules cache
      state on it during a navigation. Never frozen.
    {%- endcomment -%}
    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');

      window.Theme = window.Theme || {};

      window.Theme.routes = {
        root: {{ routes.root_url | json }},
        account: {{ routes.account_url | json }},
        accountLogin: {{ routes.account_login_url | json }},
        accountLogout: {{ routes.account_logout_url | json }},
        accountRegister: {{ routes.account_register_url | json }},
        accountAddresses: {{ routes.account_addresses_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        cartUpdate: {{ routes.cart_update_url | json }},
        cartClear: {{ routes.cart_clear_url | json }},
        collections: {{ routes.collections_url | json }},
        allProducts: {{ routes.all_products_collection_url | json }},
        search: {{ routes.search_url | json }},
        predictiveSearch: {{ routes.predictive_search_url | json }},
        productRecommendations: {{ routes.product_recommendations_url | json }}
      };

      window.Theme.shop = {
        id: {{ shop.id | json }},
        domain: {{ shop.permanent_domain | json }},
        name: {{ shop.name | json }},
        moneyFormat: {{ shop.money_format | json }},
        moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
        currency: {{ cart.currency.iso_code | json }},
        locale: {{ request.locale.iso_code | json }},
        direction: {{ text_direction | json }},
        cartCount: {{ cart.item_count | json }}
      };

      window.Theme.template = {
        name: {{ template.name | json }},
        suffix: {{ template.suffix | json }},
        pageType: {{ request.page_type | json }},
        designMode: {{ request.design_mode | json }}
      };

      window.Theme.settings = {
        cartType: {{ settings.cart_type | default: 'drawer' | json }},
        smoothScroll: {{ use_smooth_scroll | json }},
        pageTransitions: {{ use_page_transitions | json }},
        predictiveSearch: {{ settings.predictive_search_enabled | default: true | json }},
        predictiveSearchProducts: {{ settings.predictive_search_show_products | default: true | json }},
        predictiveSearchCollections: {{ settings.predictive_search_show_collections | default: true | json }},
        predictiveSearchArticles: {{ settings.predictive_search_show_articles | default: false | json }},
        predictiveSearchPages: {{ settings.predictive_search_show_pages | default: false | json }},
        predictiveSearchLimit: {{ settings.predictive_search_results_limit | default: 6 | json }},
        facetsLayout: {{ settings.facets_layout | default: 'sidebar' | json }},
        paginationType: {{ settings.pagination_type | default: 'load-more' | json }},
        quickView: {{ settings.enable_quick_view | default: true | json }},
        compare: {{ settings.enable_compare | default: false | json }},
        recentlyViewed: {{ settings.enable_recently_viewed | default: true | json }},
        freeShippingEnabled: {{ settings.free_shipping_enabled | default: false | json }},
        freeShippingThreshold: {{ settings.free_shipping_threshold | default: 0 | times: 100 | json }},
        showVendor: {{ settings.show_vendor | default: false | json }},
        swatchTrigger: {{ settings.swatch_trigger | default: 'click' | json }},
        preorderEnabled: {{ settings.enable_preorder | default: false | json }},
        filterImages: {{ settings.enable_filter_images | default: false | json }},
        filterImagesStrict: {{ settings.filter_images_strict | default: false | json }}
      };

      window.Theme.strings = {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        unavailableWithOption: {{ 'products.product.value_unavailable' | t: option_value: '[value]' | json }},
