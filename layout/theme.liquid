<!doctype html>

{%- liquid
 
  # --- Feature flags used by the shell --------------------------------------
  assign use_smooth_scroll = settings.enable_smooth_scroll | default: false
  assign use_page_transitions = settings.enable_page_transitions | default: false

  # --- Body classes ---------------------------------------------------------
  assign body_classes = 'template-' | append: template.name
  if template.suffix != blank
    assign body_classes = body_classes | append: ' template-suffix-' | append: template.suffix
  endif
  if settings.animations_reveal_on_scroll
    assign body_classes = body_classes | append: ' scroll-reveal-enabled'
  endif
-%}

<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  dir="{% render 'text-direction' %}"
  data-template="{{ template.name }}"
  {% if template.suffix != blank %}data-template-suffix="{{ template.suffix }}"{% endif %}
  data-direction="{% render 'text-direction' %}"
>

  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="format-detection" content="telephone=no">

    {%- if settings.browser_theme_color != blank -%}
      <meta name="theme-color" content="{{ settings.browser_theme_color }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">
    {%- comment -%}
      No preconnect to `cdn.shopify.com` here.
    
      Shopify already sends it as an HTTP `Link:` header, once plain and once
      with `crossorigin` - a Lighthouse report lists both under Preconnected
      origins, sourced from the response headers rather than from markup. A
      header hint arrives with the response, before a single byte of this
      document has been parsed, so it is strictly earlier than the tag that
      used to be here. The tag opened nothing new and spent one of the four
      preconnects a page is advised to keep.
    {%- endcomment -%}

    {%- comment -%} ---------- Favicons ---------- {%- endcomment -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- comment -%} ---------- Title & description ---------- {%- endcomment -%}
    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- comment -%}
      The meta description, with somewhere to fall back to.

      This used to render only when `page_description` was set, and that field is
      empty until someone fills it in - so a new store shipped no description on
      any page. With none, search results quote whatever text the crawler finds
      first, usually the announcement bar or the menu.

      The merchant's own words still win: the chain runs only when the SEO field
      is empty, and takes the next most specific text the page already has.
    {%- endcomment -%}
    {%- liquid
      assign meta_description = page_description

      if meta_description == blank
        case request.page_type
          when 'product'
            assign meta_description = product.description
          when 'collection'
            assign meta_description = collection.description
          when 'article'
            assign meta_description = article.excerpt_or_content
          when 'page'
            assign meta_description = page.content
          when 'blog'
            assign meta_description = blog.title
        endcase
      endif

      if meta_description == blank
        assign meta_description = shop.description
      endif

      if meta_description == blank
        assign meta_description = shop.name
      endif

      assign meta_description = meta_description | strip_html | strip_newlines | strip | truncate: 160
    -%}

    {%- if meta_description != blank -%}
      <meta name="description" content="{{ meta_description | escape }}">
    {%- endif -%}


    {%- if shop.published_locales.size > 1 -%}
      {%- liquid
        assign path_without_locale = request.path
        unless request.locale.root_url == '/'
          assign path_without_locale = request.path | remove_first: request.locale.root_url
        endunless
      -%}
      {%- for locale in shop.published_locales -%}
        {%- liquid
          if locale.root_url == '/'
            assign localized_path = path_without_locale
          else
            assign localized_path = locale.root_url | append: path_without_locale
          endif
        -%}
        <link rel="alternate" hreflang="{{ locale.iso_code }}" href="{{ request.origin }}{{ localized_path }}">
      {%- endfor -%}
      <link rel="alternate" hreflang="x-default" href="{{ request.origin }}{{ path_without_locale }}">
    {%- endif -%}

  
    {% render 'social-meta-tags' %}
    {% render 'structured-data' %}
    {% render 'fonts' %}
    {% render 'color-schemes' %}
    {% render 'css-variables' %}
    {% render 'critical-style' %}
    {%- render 'stylesheets' -%}
    {%- render 'scripts' -%}

    {{ content_for_header }}

    {%- comment -%}
      ---------- Merchant custom CSS ----------
    {%- endcomment -%}
    {%- if settings.custom_css != blank -%}
      {% style %}
        {{ settings.custom_css }}
      {% endstyle %}
    {%- endif -%}
  </head>

  <body class="{{ body_classes }}">
    {% render 'skip-to-content' %}

    {%- if use_smooth_scroll -%}
      <smooth-scrollbar
        data-lerp="{{ settings.smooth_scroll_lerp | default: 8 | divided_by: 100.0 }}"
        data-wheel-multiplier="{{ settings.smooth_scroll_wheel_multiplier | default: 10 | divided_by: 10.0 }}"
        data-touch-multiplier="{{ settings.smooth_scroll_touch_multiplier | default: 15 | divided_by: 10.0 }}"
      ></smooth-scrollbar>
    {%- endif -%}

    {%- if use_page_transitions -%}
      <page-transition
        data-mode="{{ settings.page_transition_style | default: 'fade' }}"
        aria-hidden="true"
      ></page-transition>
    {%- endif -%}

    {% sections 'header-group' %}

    <main
      id="MainContent"
      class="layout__main"
      role="main"
      tabindex="-1"
      data-page-type="{{ request.page_type }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% sections 'overlay-group' %}

    {% render 'scroll-to-top' %}

    {% render 'live-region' %}

    {%- comment -%}
      Country / province data required by <customer-address-form>. Loaded only
      where an address form can exist, and only as data — no behaviour.
    {%- endcomment -%}
    {%- if request.page_type == 'customers/addresses' -%}
      <script src="{{ 'country_option_tags.liquid' | shopify_asset_url }}" defer></script>
    {%- endif -%}
  </body>
</html>
