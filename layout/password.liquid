{% comment %}
  ---------------------------------------------------------------------------
  BOOST10 — layout/password.liquid
  ---------------------------------------------------------------------------
  Layout used only while the storefront is password protected.

  Deliberately minimal:
    - No header-group, footer-group or overlay-group (no navigation, no cart)
    - Reduced importmap: only modules a password page can legitimately reach
    - Same token pipeline and cascade layer order as theme.liquid, so the
      password page looks like the store rather than a fallback page
    - {{ powered_by_link }} is required by Shopify on password pages

  Module contract: global.js statically imports Tier 0 + Tier 1 only.
  Storefront modules (cart, search, facets, product) are dynamic imports gated
  on element presence, so the reduced importmap below can never be missed.

  Architecture reference: BOOST10_ARCHITECTURE_PLAN.md §5, §6, §13
  Zero hardcoded strings. Zero external requests.
  ---------------------------------------------------------------------------
{% endcomment %}

<!doctype html>

{%- liquid
  assign rtl_locales = 'ar,arc,ckb,dv,fa,ha,he,khw,ks,ku,ps,sd,ur,uz-AF,yi' | split: ','
  assign locale_root = request.locale.iso_code | split: '-' | first
  assign text_direction = 'ltr'
  if rtl_locales contains request.locale.iso_code or rtl_locales contains locale_root
    assign text_direction = 'rtl'
  endif
-%}

<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  dir="{{ text_direction }}"
  data-template="password"
  data-direction="{{ text_direction }}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="robots" content="noindex, nofollow">

    {%- if settings.browser_theme_color != blank -%}
      <meta name="theme-color" content="{{ settings.browser_theme_color }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>{{ 'general.password_page.title' | t }} &ndash; {{ shop.name }}</title>

    {%- assign password_description = shop.description | default: shop.name -%}
    <meta name="description" content="{{ password_description | escape }}">

    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:locale" content="{{ request.locale.iso_code }}">
    <meta property="og:description" content="{{ password_description | strip_html | truncatewords: 40 | escape }}">
    {%- if settings.share_image != blank -%}
      <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="{{ 1200 | divided_by: settings.share_image.aspect_ratio | round }}">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
    {%- endif -%}
    <meta name="twitter:title" content="{{ shop.name | escape }}">

    {%- comment -%} ---------- Fonts ---------- {%- endcomment -%}
    {%- liquid
      assign body_font = settings.type_body_font
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = body_font | font_modify: 'style', 'italic'
      assign heading_font = settings.type_header_font
      assign heading_font_bold = heading_font | font_modify: 'weight', 'bold'
    -%}

    <link rel="preload" as="font" href="{{ body_font | font_url }}" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="{{ heading_font | font_url }}" type="font/woff2" crossorigin>

    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ heading_font_bold | font_face: font_display: 'swap' }}
    {% endstyle %}

    {%- comment -%} ---------- Design tokens ---------- {%- endcomment -%}
    {% render 'color-schemes' %}
    {% render 'css-variables' %}

    {%- comment -%} ---------- Cascade layer order + critical CSS ---------- {%- endcomment -%}
    {% style %}
      @layer reset, tokens, base, layout, components, utilities;

      @layer tokens {
        :root {
          --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
          --font-body-style: {{ body_font.style }};
          --font-body-weight: {{ body_font.weight }};
          --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
          --font-heading-style: {{ heading_font.style }};
          --font-heading-weight: {{ heading_font.weight }};

          --font-size-base: calc(1.6rem * var(--font-body-scale));

          --container-max: {{ settings.page_width | default: 1440 }}px;
          --container-gutter: {{ settings.container_gutter | default: 20 }}px;
          --container-gutter-desktop: {{ settings.container_gutter_desktop | default: 40 }}px;

          --radius-button: {{ settings.buttons_radius | default: 4 }}px;
          --radius-input: {{ settings.inputs_radius | default: 4 }}px;
          --radius-card: {{ settings.card_radius | default: 8 }}px;

          --duration-fast: 150ms;
          --duration-base: 250ms;
          --duration-slow: 450ms;
          --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);

          --z-backdrop: 300;
          --z-modal: 500;
          --z-skip-link: 900;

          --viewport-height: 100vh;
        }

        @supports (height: 100dvh) {
          :root { --viewport-height: 100dvh; }
        }
      }

      @layer reset {
        *,
        *::before,
        *::after { box-sizing: border-box; }

        html {
          font-size: 62.5%;
          -webkit-text-size-adjust: 100%;
          text-size-adjust: 100%;
        }

        body,
        h1, h2, h3, h4, h5, h6,
        p, figure { margin: 0; }

        img, picture, svg { display: block; max-width: 100%; }
        img { height: auto; }

        input, button, textarea, select { font: inherit; color: inherit; }
        button { background: none; border: 0; cursor: pointer; }
        a { color: inherit; }

        :focus-visible {
          outline: 2px solid var(--color-link, currentColor);
          outline-offset: 3px;
          border-radius: 2px;
        }

        :focus:not(:focus-visible) { outline: none; }

        @media (prefers-reduced-motion: reduce) {
          *,
          *::before,
          *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
          }
        }
      }

      @layer base {
        body {
          margin: 0;
          min-height: var(--viewport-height);
          display: flex;
          flex-direction: column;
          font-family: var(--font-body-family);
          font-style: var(--font-body-style);
          font-weight: var(--font-body-weight);
          font-size: var(--font-size-base);
          line-height: 1.6;
          color: var(--color-text);
          background-color: var(--color-background);
          background-image: var(--gradient-background);
          -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4, h5, h6 {
          font-family: var(--font-heading-family);
          font-style: var(--font-heading-style);
          font-weight: var(--font-heading-weight);
          color: var(--color-heading);
          line-height: 1.2;
          text-wrap: balance;
        }
      }

      @layer layout {
        .password-layout {
          flex: 1 0 auto;
          display: flex;
          flex-direction: column;
          justify-content: center;
        }

        .password-layout__footer {
          flex: 0 0 auto;
          padding-block: 2.4rem;
          text-align: center;
        }

        .container {
          width: 100%;
          max-width: var(--container-max);
          margin-inline: auto;
          padding-inline: var(--container-gutter);
        }

        @media screen and (min-width: 990px) {
          .container { padding-inline: var(--container-gutter-desktop); }
        }
      }

      @layer components {
        .skip-to-content-link {
          position: absolute;
          inset-block-start: 0;
          inset-inline-start: 0;
          z-index: var(--z-skip-link);
          display: inline-block;
          padding: 1.2rem 2rem;
          background-color: var(--color-primary-button-background);
          color: var(--color-primary-button-text);
          text-decoration: none;
          transform: translateY(-101%);
        }

        .skip-to-content-link:focus { transform: translateY(0); }

        .password-layout__powered-by {
          font-size: 1.3rem;
          opacity: 0.75;
        }

        .password-layout__powered-by a { color: var(--color-link); }
      }

      @layer utilities {
        .visually-hidden {
          position: absolute !important;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0 0 0 0);
          clip-path: inset(50%);
          white-space: nowrap;
          border: 0;
        }

        html.no-js .no-js-hidden { display: none !important; }
        html:not(.no-js) .js-hidden { display: none !important; }
        [hidden] { display: none !important; }
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    {%- comment -%}
      ---------- Reduced ES module importmap ----------
      Only Tier 0, Tier 1 and localization are reachable from a password page.
    {%- endcomment -%}
    <script type="importmap">
      {
        "imports": {
          "@theme/component":        "{{ 'component.js' | asset_url }}",
          "@theme/shadow-component": "{{ 'shadow-component.js' | asset_url }}",
          "@theme/utilities":        "{{ 'utilities.js' | asset_url }}",
          "@theme/events":           "{{ 'events.js' | asset_url }}",
          "@theme/morph":            "{{ 'morph.js' | asset_url }}",
          "@theme/section-renderer": "{{ 'section-renderer.js' | asset_url }}",
          "@theme/dialog":           "{{ 'dialog.js' | asset_url }}",
          "@theme/modules":          "{{ 'modules.js' | asset_url }}",
          "@theme/motion-engine":    "{{ 'motion-engine.js' | asset_url }}",
          "@theme/motion-effect":    "{{ 'motion-effect.js' | asset_url }}",
          "@theme/scrollbar":        "{{ 'scrollbar.js' | asset_url }}",
          "@theme/lenis":            "{{ 'lenis.js' | asset_url }}",
          "@theme/page-transition":  "{{ 'page-transition.js' | asset_url }}",
          "@theme/localization":     "{{ 'localization.js' | asset_url }}"
        }
      }
    </script>

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');

      window.Theme = window.Theme || {};

      window.Theme.routes = {
        root: {{ routes.root_url | json }}
      };

      window.Theme.shop = {
        id: {{ shop.id | json }},
        domain: {{ shop.permanent_domain | json }},
        name: {{ shop.name | json }},
        moneyFormat: {{ shop.money_format | json }},
        currency: {{ cart.currency.iso_code | json }},
        locale: {{ request.locale.iso_code | json }},
        direction: {{ text_direction | json }}
      };

      window.Theme.template = {
        name: 'password',
        suffix: null,
        pageType: {{ request.page_type | json }},
        designMode: {{ request.design_mode | json }}
      };

      window.Theme.settings = {
        cartType: 'none',
        smoothScroll: false,
        pageTransitions: false
      };

      window.Theme.strings = {
        close: {{ 'accessibility.close' | t | json }},
        loading: {{ 'accessibility.loading' | t | json }},
        networkError: {{ 'general.errors.network' | t | json }},
        passwordError: {{ 'general.password_page.login_form_error' | t | json }}
      };

      window.Theme.storageKey = 'boost10:{{ shop.permanent_domain }}';
    </script>

    <link rel="modulepreload" href="{{ 'global.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'component.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'utilities.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'events.js' | asset_url }}">

    <script type="module" src="{{ 'global.js' | asset_url }}"></script>

    {{ content_for_header }}

    {%- if settings.custom_css != blank -%}
      {% style %}
        {{ settings.custom_css }}
      {% endstyle %}
    {%- endif -%}
  </head>

  <body class="template-password">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    <main
      id="MainContent"
      class="password-layout"
      role="main"
      tabindex="-1"
      data-page-type="password"
    >
      {{ content_for_layout }}
    </main>

    <footer class="password-layout__footer" role="contentinfo">
      <div class="container">
        <p class="password-layout__powered-by">{{ powered_by_link }}</p>
      </div>
    </footer>

    {% render 'live-region' %}
  </body>
</html>
