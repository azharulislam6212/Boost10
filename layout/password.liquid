<!doctype html>

<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  dir="{% render 'text-direction' %}"
  data-template="password"
>

  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="format-detection" content="telephone=no">
    <meta name="robots" content="noindex, nofollow">

    {%- if settings.browser_theme_color != blank -%}
      <meta name="theme-color" content="{{ settings.browser_theme_color }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">
    {%- comment -%}
      No preconnect to `cdn.shopify.com` here.
    
      Shopify already sends it as an HTTP `Link:` header, once plain and once
      with `crossorigin` - a Lighthouse report lists both under Preconnected
      origins, sourced from the response headers rather than from markup. A
      header hint arrives with the response, before a single byte of this
      document has been parsed, so it is strictly earlier than the tag that
      used to be here. The tag opened nothing new and spent one of the four
      preconnects a page is advised to keep.
    {%- endcomment -%}

    {%- comment -%} ---------- Favicons ---------- {%- endcomment -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- comment -%} ---------- Title & description ---------- {%- endcomment -%}
    <title>{{ 'general.password_page.title' | t }} &ndash; {{ shop.name }}</title>

    {%- if shop.description != blank -%}
      <meta name="description" content="{{ shop.description | escape }}">
    {%- else -%}
      <meta name="description" content="{{ shop.name | escape }}">
    {%- endif -%}

    {% render 'social-meta-tags' %}
    {% render 'fonts' %}
    {% render 'color-schemes' %}
    {% render 'css-variables' %}
    {% render 'critical-style' %}
    {%- render 'stylesheets' -%}
    {%- render 'scripts', context: 'password' -%}

    {{ content_for_header }}

    {%- comment -%}
      ---------- Merchant custom CSS ----------
    {%- endcomment -%}
    {%- if settings.custom_css != blank -%}
      {% style %}
        {{ settings.custom_css }}
      {% endstyle %}
    {%- endif -%}
  </head>

  <body class="template-password">
    {% render 'skip-to-content' %}

    <main
      id="MainContent"
      class="layout__main password-layout"
      role="main"
      tabindex="-1"
      data-page-type="password"
    >
      {{ content_for_layout }}
    </main>

    <footer class="password-layout__footer" role="contentinfo">
      <div class="container">
        <p class="password-layout__powered-by">{{ powered_by_link }}</p>
      </div>
    </footer>

    {% render 'live-region' %}
  </body>
</html>
